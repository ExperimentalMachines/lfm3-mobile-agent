#!/bin/bash
# Local: bootstrap a GPU Colab session and run jobs inside a blocking kernel cell
# (Colab reclaims VMs whose kernel is idle, so nohup'd background jobs get killed).
# Usage: COLAB_CONFIG=<cfg.json|empty> scripts/launch_gpu_jobs.sh <session> <jobs.json>
set -euo pipefail
SESS=$1; JOBS=$2
cd "$(dirname "$0")/.."
C() { "${COLAB_BIN:-$HOME/.local/bin/colab}" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} "$@" 2> >(grep -v "new version\|colab update\|silence this" >&2); }
COLAB_CONFIG=${COLAB_CONFIG:-} bash scripts/gpu_session.sh "$SESS" | tee "logs/${SESS}_bootstrap.log" | grep -E "NVIDIA|pip rc|versions|HF user|mismatch|failed"
grep -q "^versions" "logs/${SESS}_bootstrap.log" || { echo "BOOTSTRAP FAILED"; exit 1; }
C upload -s "$SESS" scripts/vm_blocking_jobs.py /content/work/vm_blocking_jobs.py | tail -1
C upload -s "$SESS" scripts/vm_eval.sh /content/work/vm_eval.sh | tail -1
C upload -s "$SESS" "$JOBS" /content/work/jobs.json | tail -1
echo 'import os;os.makedirs("/content/work/meta",exist_ok=True)' | C exec -s "$SESS" >/dev/null
C upload -s "$SESS" data/meta/splits.json /content/work/meta/splits.json | tail -1
C upload -s "$SESS" data/meta/androidcontrol_test_gt.jsonl /content/work/meta/androidcontrol_test_gt.jsonl | tail -1
C upload -s "$SESS" data/meta/androidcontrol_test_gt.manifest.json /content/work/meta/androidcontrol_test_gt.manifest.json | tail -1
echo "launching blocking jobs cell on $SESS at $(date +%T)"
nohup "${COLAB_BIN:-$HOME/.local/bin/colab}" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} exec -s "$SESS" --timeout 200000 -f scripts/vm_blocking_jobs.py \
  > "logs/${SESS}_jobs_cell.log" 2>&1 &
PID=$!
sleep 90
if grep -q heartbeat "logs/${SESS}_jobs_cell.log" && kill -0 $PID 2>/dev/null; then echo "cell client pid $PID — heartbeat confirmed"
else echo "LAUNCH NOT CONFIRMED: $(tail -c 300 logs/${SESS}_jobs_cell.log)"; exit 1; fi
"""Run ON the Colab VM via `colab exec -f` (with a large --timeout).

Colab only keeps a VM alive while its Jupyter kernel is busy, so long jobs must run
INSIDE a kernel cell: this script launches the job scripts listed in
/content/work/jobs.json as subprocesses (logs to files) and blocks until all exit,
printing a heartbeat every 60 s. Monitor from outside with `colab download` of the logs.

jobs.json: [{"name": "train", "script": "/content/work/vm_train.sh", "env": {...}, "log": "/content/runs/x.log"}, ...]
"""
import json
import os
import subprocess
import time

jobs = json.load(open("/content/work/jobs.json"))
procs = []
for j in jobs:
    env = dict(os.environ, **{k: str(v) for k, v in j.get("env", {}).items()})
    os.makedirs(os.path.dirname(j["log"]), exist_ok=True)
    p = subprocess.Popen(["bash", j["script"]], cwd="/content/work", env=env,
                         stdout=open(j["log"], "a"), stderr=subprocess.STDOUT)
    procs.append((j["name"], p))
    print(f"started {j['name']} pid={p.pid}", flush=True)
    time.sleep(j.get("stagger_s", 0))

t0 = time.time()
while True:
    alive = [(n, p) for n, p in procs if p.poll() is None]
    status = {n: ("running" if p.poll() is None else f"exit {p.returncode}") for n, p in procs}
    with open("/content/work/jobs_status.json", "w") as f:
        json.dump({"elapsed_s": round(time.time() - t0), "status": status}, f)
    print(f"[heartbeat {time.strftime('%H:%M:%S')}] {status}", flush=True)
    if not alive:
        break
    for _ in range(6):
        time.sleep(10)
        print(".", end="", flush=True)  # keep the exec websocket busy (idle drops seen ~30-40s)
failed = [n for n, p in procs if p.returncode != 0]
print("ALL JOBS FINISHED", "FAILED: " + ",".join(failed) if failed else "OK", flush=True)
if failed:
    raise SystemExit(1)
