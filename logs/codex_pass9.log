from jinja2.ext import Extension
class Generation(Extension):
    tags={'generation'}
    def parse(self,parser):
        tok=next(parser.stream);body=parser.parse_statements(['name:endgeneration'],drop_needle=True)
        return nodes.CallBlock(self.call_method('capture'),[],[],body).set_lineno(tok.lineno)
    def capture(self,caller):return caller()

def run_generator(argv):
    import shutil
    hub=Path(os.environ['HUB_DIR']) if os.environ.get('HUB_DIR') else None
    trace=Path(os.environ['TRACE']).with_suffix('.runtime.jsonl')
    def log(event,**data):
        with trace.open('a') as f:f.write(json.dumps({'event':event,**data})+'\n')

    class InputTensor(Tensor):
        def __init__(self,n,tail):super().__init__(n);self.tail=tail
        def __getitem__(self,k):return NSROW(self.tail)
    class NSROW:
        def __init__(self,tail):self.tail=tail
        def __getitem__(self,k):return self.tail
    class Processor:
        chat_template=(ROOT/'train/qwen35_chat_template_gen.jinja').read_text()
        def __init__(self):self.tokenizer=NS(pad_token='<pad>',padding_side='right',decode=lambda ids,**kw:ids)
        @classmethod
        def from_pretrained(cls,*a,**kw):return cls()
        def apply_chat_template(self,convs,**kw):
            texts=[Environment(extensions=[Generation,'jinja2.ext.loopcontrols']).from_string(self.chat_template).render(messages=c,add_generation_prompt=True,enable_thinking=kw.get('enable_thinking',True)) for c in convs]
            tail='<think>\n' if texts[0].rstrip().endswith('<think>') else texts[0][-40:]
            return Batch(input_ids=InputTensor(len(convs),tail),attention_mask=Tensor(len(convs)))
        def batch_decode(self,texts,**kw):return texts
    class Model:
        @classmethod
        def from_pretrained(cls,model,*a,**kw):
            self=cls();w=Path(model)/'model.safetensors'
            self.action='navigate_back' if w.exists() and w.read_bytes()==b'y' else 'wait'
            return self
        def to(self,*a):return self
        def eval(self):return self
        def generate(self,**kw):
            log('model_generate',action=self.action)
            txt=json.dumps({'action_type':self.action})
            if kw['input_ids'].tail.rstrip().endswith('<think>'):txt='Reasoning.</think>'+txt
            return Generated([txt]*kw['input_ids'].n)
    truth=[json.loads(l) for l in Path('meta/androidcontrol_test_gt.jsonl').read_text().splitlines()]
    rows=[{**r,'images':['stub'],'messages':[{'role':'system','content':af.SYSTEM_PROMPT},{'role':'user','content':'Goal: wait'}]} for r in truth]
    class Api:
        def repo_info(self,*a,**kw):
            if hub is None or not (hub/'HEAD').exists():raise FileNotFoundError('empty synthetic hub')
            rev=(hub/'HEAD').read_text();log('repo_info',revision=rev);return NS(sha=rev)
        def upload_file(self,**kw):
            if hub is None:return
