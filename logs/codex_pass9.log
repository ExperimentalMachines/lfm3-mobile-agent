        stage=hub/'staging'/filename;stage.parent.mkdir(parents=True,exist_ok=True)
        shutil.copyfile(src,stage);log('download',revision=revision,filename=filename);return str(stage)
    mods={'torch':module(bfloat16='stub',inference_mode=contextlib.nullcontext),'datasets':module(load_dataset=lambda *a,**kw:Dataset(rows),load_from_disk=lambda *a,**kw:Dataset(rows)),'transformers':module(AutoProcessor=Processor,AutoModelForImageTextToText=Model),'huggingface_hub':module(HfApi=Api,hf_hub_download=download)}
    with mock.patch.dict(sys.modules,mods),mock.patch.object(sys,'argv',argv):
