      python generate.py --model $m --data "$DEV_REPO@$sp${DEV_REV:+#$DEV_REV}" --out /content/eval/${n}_${sp}.jsonl --enable_thinking $th \
        --bs ${EVAL_BS:-32} --max_pixels ${MAX_PIXELS:-774400} \
