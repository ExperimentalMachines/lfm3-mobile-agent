def wilson(k,n):
    z=1.96; p=k/n; den=1+z*z/n; center=(p+z*z/(2*n))/den
    half=z*math.sqrt(p*(1-p)/n+z*z/(4*n*n))/den
    return [round(100*(center-half),2),round(100*(center+half),2)]
