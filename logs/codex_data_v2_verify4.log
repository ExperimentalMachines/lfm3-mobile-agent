@@ -0,0 +1,27 @@
+"""Reuse the prior independent every-row checks on exactly this audit's five files."""
+from data_v2_verify4_rules import ROOT, CACHE, PIN, ns, write_json
+import collections, json
+
+prior = (ROOT/'results/codex/data_v2_verify3_checks.py').read_text()
+assert prior.count("CACHE = BASE / 'verify3_836e401958'") == 1
+assert prior.count('[2,5,9,13]') == 1
+prior = prior.replace("CACHE = BASE / 'verify3_836e401958'", "CACHE = BASE / 'verify4_42f7f76364'").replace('[2,5,9,13]', '[2,13]')
+env = {'__file__': str(ROOT/'results/codex/data_v2_verify3_checks.py'), '__name__':'verify4_adapter'}
+exec(compile(prior, 'verify4-independent-checks', 'exec'), env)
+env['main']()
+rows = [json.loads(s) for s in (CACHE/'metadata.jsonl').read_text().splitlines()]
+class Rows:
+    def __init__(self, rows): self.rows = rows
+    def __getitem__(self, key): return [r[key] for r in self.rows]
+    def select_columns(self, keys): return [{k:r[k] for k in keys} for r in self.rows]
+splits = {s:Rows([r for r in rows if r['split']==s]) for s in {r['split'] for r in rows}}
+checks = ns['verify'](splits['train'], {s:v for s,v in splits.items() if s!='train'})
+maxima = {}
+for s, v in splits.items():
+    for src in {r['source'] for r in v.rows}:
+        c = collections.Counter(r['episode_id'] for r in v.rows if r['source']==src)
+        maxima[s+'/'+src] = max(c.values())
+        cap = 1 if s=='dev_odyssey' else 4 if s=='dev_amex' else 2 if src=='screenqa' else 3
+        if src!='androidcontrol': assert max(c.values())<=cap, (s,src,c)
+write_json('sample_builder_assertions.json', {'revision':PIN, 'actual_verify_function_passed':True,
+           'counters':checks,'observed_max_rows_per_episode':maxima})
diff --git a/results/codex/data_v2_verify4_download.py b/results/codex/data_v2_verify4_download.py
new file mode 100644
index 0000000000000000000000000000000000000000..d2f68f2d4e9afb11b06323d4d57794beaf46f975
--- /dev/null
+++ b/results/codex/data_v2_verify4_download.py
@@ -0,0 +1,43 @@
+"""Exactly two pinned train shards plus every dev; verify immutable blob hashes."""
+from data_v2_verify4_rules import BASE, CACHE, PIN, REPO, SHARDS, write_json
+from pathlib import Path
+from concurrent.futures import ThreadPoolExecutor
+import hashlib, json, requests
+
+token = Path('~/.cache/huggingface/token').expanduser().read_text().strip()
+headers = {'Authorization': 'Bearer ' + token}
+response = requests.get(f'https://huggingface.co/api/datasets/{REPO}/revision/{PIN}',
+                        params={'blobs': 'true'}, headers=headers, timeout=60)
+response.raise_for_status()
+inv = response.json()
+assert inv['sha'] == PIN
+write_json('inventory.json', inv)
+files = [f'data/train-{i:05d}-of-00016.parquet' for i in SHARDS]
+files += sorted(x['rfilename'] for x in inv['siblings'] if x['rfilename'].startswith('data/dev_'))
+files += ['stats/stats.json']
+
+def download(name):
+    item = next(x for x in inv['siblings'] if x['rfilename'] == name)
+    target = CACHE / 'v2' / name
+    target.parent.mkdir(parents=True, exist_ok=True)
+    if not target.exists() or target.stat().st_size != item['size']:
+        with requests.get(f'https://huggingface.co/datasets/{REPO}/resolve/{PIN}/{name}',
+                          headers=headers, stream=True, timeout=(30, 180)) as r:
+            r.raise_for_status()
+            part = target.with_suffix('.part')
+            with part.open('wb') as f:
+                for chunk in r.iter_content(2**20): f.write(chunk)
+            part.rename(target)
+    assert target.stat().st_size == item['size'], name
+    with target.open('rb') as f: digest = hashlib.file_digest(f, 'sha256').hexdigest()
+    if item.get('lfs'): assert digest == item['lfs']['sha256'], name
+    else:
+        data = target.read_bytes()
+        assert hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest() == item['blobId'], name
+    record = {'file': name, 'bytes': item['size'], 'sha256': digest, 'pinned_blob_verified': True}
+    print(json.dumps(record), flush=True)
+    return record
+
+with ThreadPoolExecutor(max_workers=4) as pool: records = list(pool.map(download, files))
+write_json('download_manifest.json', {'revision': PIN, 'train_shards': SHARDS,
+           'selection': 'Two preselected spread-out train shards, all dev splits; raw annotations reused.', 'files': records})
