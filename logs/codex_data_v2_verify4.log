+"""Exercise the actual current Odyssey/AMEX source loops, with image I/O stubbed."""
+from data_v2_verify4_rules import *
+from types import SimpleNamespace
+import tempfile
+
+REAL_SAMPLER = ns['sample_rows']
+
+def run_loop(source_name, documents, capture_all=True):
+    saved, candidates, stats, events = {}, [], {}, []
+    fn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == source_name)
+    step_loop = next(n for n in ast.walk(fn) if isinstance(n, ast.For) and
+                     isinstance(n.target, ast.Name) and n.target.id == 's')
+    sites = {n.lineno: type(n).__name__ for n in ast.walk(step_loop) if isinstance(n, (ast.Break, ast.Continue))}
+    lines = source.splitlines()
+    def trace(frame, event, arg):
+        if frame.f_code.co_filename != str(BUILDER) or frame.f_code.co_name != source_name: return None
+        if event == 'line' and frame.f_lineno in sites:
+            loc = frame.f_locals; s = loc['s']
+            events.append({'episode_id': str(loc['eid']), 'step': s.get('step', s.get('step_id')),
+                           'branch': sites[frame.f_lineno], 'line': frame.f_lineno,
+                           'context': lines[frame.f_lineno-3:frame.f_lineno],
+                           'action': loc.get('act'), 'kind': loc.get('kind'), 'raw': s})
+        return trace
+    def sample(rows, n, rng, **kw):
+        candidates.extend(rows)
+        return REAL_SAMPLER(rows, n, rng, **kw)
+    with tempfile.TemporaryDirectory(dir=CACHE) as td:
+        root = Path(td)
+        ns['args'] = SimpleNamespace(root=td, out=td, seed=0)
+        ns['sample_rows'] = sample
+        ns['save_stats'] = lambda name, st: stats.update({name: dict(st)})
+        ns['materialize'] = lambda rows, name, st: saved.update({name: rows})
+        if source_name == 'odyssey':
+            (root/'odyssey/splits').mkdir(parents=True)
+            (root/'odyssey/screenshots').mkdir()
+            ann = root/'odyssey_git/annotations'; ann.mkdir(parents=True)
+            split = json.loads((BASE/'sources/odyssey_split.json').read_text())
+            train_ids = {str(int(str(e).removesuffix('.json'))) for e in split['train']}
+            test_ids = {str(int(str(e).removesuffix('.json'))) for e in split['test']}
+            # Fixture IDs are intentionally assigned explicitly; real IDs retain official splits.
+            tr, dev = [], []
+            for d in documents:
+                e = str(d['episode_id'])
+                (dev if e == '2' or e.lstrip('0') in test_ids else tr).append(e)
+                assert e in ('1', '2') or e.lstrip('0') in train_ids | test_ids
+                (ann/(e+'.json')).write_text(json.dumps(d))
+            (root/'odyssey/splits/random_split.json').write_text(json.dumps({'train': tr, 'test': dev}))
+            zpath = root/'odyssey/screenshots/joined.zip'
+            names = {os.path.basename(s['screenshot']) for d in documents for s in d['steps']}
+        else:
+            ann = root/'amex/anno/instruction_anno'; ann.mkdir(parents=True)
+            (root/'amex/AMEX').mkdir()
+            for d in documents: (ann/(str(d['episode_id'])+'.json')).write_text(json.dumps(d))
+            zpath = root/'amex/AMEX/joined.zip'
+            names = {os.path.basename(s['image_path']) for d in documents for s in d['steps']}
+        with zipfile.ZipFile(zpath, 'w') as z:
+            for name in sorted(names): z.writestr(name, b'fixture: only source-loop filename membership is tested')
+        old_trace = sys.gettrace()
+        try:
+            sys.settrace(trace)
+            ns[source_name]()
+        finally:
+            sys.settrace(old_trace)
+            ns['sample_rows'] = REAL_SAMPLER
+    return candidates, events, stats, saved
+
+def od_documents(steps):
+    return [dict(episode_id=e, device_info={'device_name':'Pixel 7'},
+                 task_info={'instruction':'Search for Art', 'app':['Chrome']},
+                 steps=[dict(step=i, action=t, info=info, low_level_instruction=ins,
+                             screenshot=f'{e}_{i}.png') for i,(t,info,ins) in enumerate(steps)]) for e in ['1','2']]
+
+def am_documents(steps):
+    return [dict(episode_id='fixture',instruction='Search for Art',steps=[
+        dict(step_id=i+1,action=t,touch_coord=p or [0,0],lift_coord=lift or [0,0],
+             device_dim=[1000,2000],type_text='Art',image_path=f'{i}.png')
+        for i,(t,p,lift) in enumerate(steps)])]
+
+def fixtures():
+    typ = ('TEXT','Art','Type Art into the search field')
+    result = ('CLICK',[[500,300]],'Tap a result')
+    submit = ('CLICK',[[920,930]],'Tap the Search key on the keyboard')
+    cases = {
+      'odyssey_hide_keyboard': ('odyssey',od_documents([typ,('CLICK',[[500,950]],'Tap to hide the keyboard'),result]),[0]),
+      'odyssey_toolbar_above_keyboard': ('odyssey',od_documents([typ,('CLICK',[[686,499]],'Tap the icon in the toolbar above the keyboard'),result]),[0]),
+      'odyssey_keyboard_suggestion': ('odyssey',od_documents([typ,('CLICK',[[249,453]],'Tap the suggestion above the keyboard'),result]),[0]),
+      'odyssey_bottom_right_search': ('odyssey',od_documents([typ,submit,result]),[0,2]),
+      'odyssey_bottom_right_enter': ('odyssey',od_documents([typ,('CLICK',[[920,930]],'Press Enter on the keyboard'),result]),[0,2]),
+      'odyssey_negative_wording_overrides_corner': ('odyssey',od_documents([typ,('CLICK',[[920,930]],'Dismiss the keyboard'),result]),[0]),
+      'odyssey_second_submit_cuts': ('odyssey',od_documents([typ,submit,submit,result]),[0]),
+      'odyssey_ordinary_app_tap_kept': ('odyssey',od_documents([typ,result]),[0,1]),
+      'odyssey_control_drag_words': ('odyssey',od_documents([result,('SCROLL',[[500,700],[500,300]],'Swipe to adjust the slider'),result]),[0]),
+      'odyssey_selection_after_long_press': ('odyssey',od_documents([('LONG_PRESS',[[500,700]],'Long press text'),('SCROLL',[[500,700],[500,300]],'Swipe up'),result]),[0]),
+      'odyssey_page_scroll_kept': ('odyssey',od_documents([result,('SCROLL',[[500,700],[500,300]],'Scroll down the page'),result]),[0,1,2]),
+      'amex_soft_search': ('amex',am_documents([('TYPE',None,None),('TAP',[920,1860],None),('TAP',[500,600],None)]),[1,3]),
+      'amex_explicit_enter': ('amex',am_documents([('TYPE',None,None),('PRESS_ENTER',None,None),('TAP',[500,600],None)]),[1,3]),
+      'amex_second_submit_cuts': ('amex',am_documents([('TYPE',None,None),('TAP',[920,1860],None),('TAP',[920,1860],None),('TAP',[500,600],None)]),[1]),
+      'amex_short_drag_cuts': ('amex',am_documents([('TAP',[500,600],None),('SWIPE',[507,918],[389,936]),('TAP',[500,600],None)]),[1]),
+      'amex_diagonal_drag_cuts': ('amex',am_documents([('TAP',[500,600],None),('SWIPE',[291,1286],[580,1492]),('TAP',[500,600],None)]),[1]),
+      'amex_page_scroll_kept': ('amex',am_documents([('TAP',[500,600],None),('SWIPE',[500,1400],[500,600]),('TAP',[500,600],None)]),[1,2,3]),
+    }
+    out = {}
+    for name,(src,docs,expected) in cases.items():
+        rows,events,stats,_ = run_loop(src,docs)
+        rows = [r for r in rows if r['episode_id'] in ('1','fixture')]
+        got = sorted(r['step_idx'] for r in rows)
+        assert got == expected, (name,got,expected)
+        if 'bottom_right' in name or name in ('amex_soft_search','amex_explicit_enter'):
+            final = max(rows,key=lambda r:r['step_idx'])
+            assert len(final['history']) == 1 and json.loads(final['history'][0][1]) == {'action_type':'input_text','text':'Art'}
+        out[name] = {'pass': True,'retained_steps':got,'rows':rows,'events':events,'stats':stats}
+    raw_sample = [{'episode_id':'same','action':{'action_type':t}} for t in ['keyboard_enter']*4+['input_text']*4+['click']*4]
+    picked = REAL_SAMPLER(raw_sample,10,random.Random(0),per_episode=3,quotas=[
+        (lambda r:r['action']['action_type']=='keyboard_enter',5),(lambda r:r['action']['action_type']=='input_text',5)])
+    assert len(picked) == len({id(x) for x in picked}) == 3
+    write_json('actual_loop_fixtures.json', {'builder_sha256':hashlib.sha256(source.encode()).hexdigest(),
+               'fixtures':out,'quota_cap_fixture':{'selected':len(picked),'unique':len({id(x) for x in picked})}})
+    print('Actual-loop fixtures passed:',len(out),'plus cap fixture',flush=True)
+
+if __name__ == '__main__': fixtures()
diff --git a/results/codex/data_v2_verify4_replay.py b/results/codex/data_v2_verify4_replay.py
new file mode 100644
index 0000000000000000000000000000000000000000..173344085d5a12682d6b929ea8eb2022b97746d4
--- /dev/null
+++ b/results/codex/data_v2_verify4_replay.py
@@ -0,0 +1,137 @@
+"""Join bounded published rows to actual-loop outputs; select B1/B2 visual checks."""
+from data_v2_verify4_loops import *
+from concurrent.futures import ThreadPoolExecutor
+from data_v2_verify3_checks import parse_history
+import pyarrow.parquet as pq
+import requests, time
+
+KNOWN = {'5994133452263654':27,'4912446279173881':4,'6951686067814574':4,
+         '4394352513523177':22,'0173202679441530':21,'4143524179769456':4}
+inv=json.loads((CACHE/'inventory.json').read_text())
+files=[f'data/train-{i:05d}-of-00016.parquet' for i in SHARDS]
+files+=sorted(x['rfilename'] for x in inv['siblings'] if x['rfilename'].startswith('data/dev_'))
+rows=[]
+for file in files:
+    pf=pq.ParquetFile(CACHE/'v2'/file)
+    cols=[c for c in pf.schema_arrow.names if c!='images']
+    for i,r in enumerate(pf.read(columns=cols).to_pylist()):
+        r.update(file=file,row=i,id=f'{r["split"]}/{r["source"]}/{r["episode_id"]}/{r["step_idx"]}',action=json.loads(r['gt_action']))
+        r['goal'],r['history']=parse_history(r['messages'][1]['content'])
+        rows.append(r)
+eids={r['episode_id'] for r in rows if r['source']=='odyssey'}|set(KNOWN)
+srcdir=BASE/'sources/odyssey_annotations'
+missing=[e for e in eids if not (srcdir/(e.zfill(16)+'.json')).exists()]
+print('Odyssey annotations:',len(eids),'cached:',len(eids)-len(missing),'missing:',len(missing),flush=True)
+headers={'Authorization':'Bearer '+Path('~/.cache/huggingface/token').expanduser().read_text().strip()}
+def fetch(e):
+    p=srcdir/(e.zfill(16)+'.json')
+    if not p.exists():
+        for attempt in range(4):
+            r=requests.get('https://huggingface.co/datasets/hflqf88888/GUIOdyssey/resolve/61632d0f/annotations/'+p.name,
+                           headers=headers,timeout=60)
+            if r.status_code==429 and attempt<3: time.sleep(5); continue
+            r.raise_for_status();p.write_bytes(r.content);break
+    return e,json.loads(p.read_text())
+with ThreadPoolExecutor(max_workers=4) as pool: odraw=dict(pool.map(fetch,sorted(eids)))
+z=zipfile.ZipFile(BASE/'sources/amex_instructions.zip')
+ameids={r['episode_id'] for r in rows if r['source']=='amex'}
+amraw={}
+for n in z.namelist():
+    if n.endswith('.json'):
+        d=json.loads(z.read(n));e=str(d['episode_id'])
+        if e in ameids:amraw[e]=d
+assert set(amraw)==ameids
+raws={'odyssey':odraw,'amex':amraw}
+counts=collections.Counter();errors=collections.defaultdict(list);joined=[];all_events={};known={}
+for src,raw in raws.items():
+    candidate,events,stats,_=run_loop(src,list(raw.values()))
+    print(src,'actual-loop candidates:',len(candidate),flush=True)
+    lookup={(r['episode_id'],r['step_idx']):r for r in candidate}
+    ep_steps=collections.defaultdict(list);ep_events=collections.defaultdict(list)
+    for r in candidate:ep_steps[r['episode_id']].append(r['step_idx'])
+    for e in events:ep_events[e['episode_id']].append(e)
+    all_events[src]=events
+    for r in rows:
+        if r['source']!=src:continue
+        counts[src+'_rows_checked']+=1
+        x=lookup.get((r['episode_id'],r['step_idx']))
+        if x is None:errors['published_after_cutoff'].append(r['id']);continue
+        for k,want,got in [('action',x['action'],r['action']),('intent',x['intent'],r['messages'][-1]['reasoning_content']),
+                           ('history',af.user_text(x['goal'],x['history']),r['messages'][1]['content'])]:
+            if want!=got:errors[k+'_mismatch'].append(r['id'])
+        merged=[e for e in ep_events[r['episode_id']] if e['branch']=='Continue' and e['step']<r['step_idx']]
+        raw_steps=raw[r['episode_id']]['steps'];key='step' if src=='odyssey' else 'step_id'
+        current=next(s for s in raw_steps if int(s[key])==r['step_idx'])
+        entry=dict(r,merged_before=merged,raw=current,
+                   retained_source_steps=sorted(s for s in ep_steps[r['episode_id']] if s<r['step_idx'])[-8:])
+        for event in merged:
+            prev=next(s for s in raw_steps if int(s[key])==event['step']-1)
+            assert prev['action'] in ('TEXT','TYPE'),(r['id'],event)
+            if event['raw']['action'] in ('CLICK','TAP'):
+                a=event['action'];instr=event['raw'].get('low_level_instruction','')
+                assert ns['keyboard_tap_kind'](a['point_2d'],instr)=='submit'
+                assert a['point_2d'][0]>=780 and a['point_2d'][1]>=850
+        counts[src+'_rows_after_submit_merge']+=bool(merged)
+        if r['action']['action_type']=='scroll':
+            counts[src+'_scroll_rows_checked']+=1
+            if src=='odyssey':
+                p=ast.literal_eval(current['info']) if isinstance(current['info'],str) else current['info'];p=p[:2]
+            else:p=[af.px_to_norm(*current[k],*current['device_dim']) for k in ['touch_coord','lift_coord']]
+            entry['raw_path']=p
+            assert ns['swipe_dir'](*p[0],*p[1])==r['action']['direction']
+        joined.append(entry)
+    if src=='odyssey':
+        for e,bad_step in KNOWN.items():
+            retained=sorted(ep_steps[e]);ev=ep_events[e]
+            published=[r['step_idx'] for r in rows if r['source']=='odyssey' and r['episode_id']==e]
+            assert all(s<bad_step for s in retained+published),(e,retained,published)
+            known[e]={'reported_bad_step':bad_step,'actual_loop_retained_steps':retained,'events':ev,
+                      'published_steps_in_downloaded_splits':sorted(published),
+                      'entire_published_split_checked':e=='0173202679441530'}
+            if e in ['4394352513523177','0173202679441530','4143524179769456']:
+                s=next(s for s in raw[e]['steps'] if int(s['step'])==bad_step)
+                p=ast.literal_eval(s['info']) if isinstance(s['info'],str) else s['info']
+                assert ns['swipe_dir'](*p[0],*p[1]) is None
+                known[e]['reported_drag_rejected_by_geometry']=True
+
+# Preselected deterministic, distinct-episode rows immediately after the merged raw action.
+rng=random.Random(20261117)
+selected=[]
+groups=[('odyssey',None,10),('amex',None,10)]
+for src,kind,n in groups:
+    pool=sorted([r for r in joined if r['source']==src and r['merged_before'] and
+                 r['merged_before'][-1]['step']==r['step_idx']-1 and
+                 (kind is None or r['merged_before'][-1]['raw']['action']==kind)],key=lambda r:r['id'])
+    rng.shuffle(pool);seen=set();picked=[]
+    for r in pool:
+        if r['episode_id'] in seen:continue
+        seen.add(r['episode_id']);picked.append(r)
+        if len(picked)==n:break
+    assert len(picked)==n,(src,kind,len(picked))
+    for r in picked:selected.append(dict(r,visual_id=f'merge_{len(selected)+1:02d}'))
+# Stress the remaining scroll geometry, while requiring distinct episodes and images.
+for src in ['odyssey','amex']:
+    pool=[]
+    for r in joined:
+        if r['source']!=src or 'raw_path' not in r:continue
+        p=r['raw_path'];vertical=r['action']['direction'] in ('up','down')
+        displacement=max(abs(p[1][0]-p[0][0]),abs(p[1][1]-p[0][1]))
+        deviation=abs((p[0][0]+p[1][0])/2-500) if vertical else abs((p[0][1]+p[1][1])/2-500)
+        pool.append(dict(r,risk_score=deviation+max(0,500-displacement)))
+    pool.sort(key=lambda r:(-r['risk_score'],r['id']));seen=set();images=set();picked=[]
+    for r in pool:
+        if r['episode_id'] in seen or r['img_sha'] in images:continue
+        seen.add(r['episode_id']);images.add(r['img_sha']);picked.append(r)
+        if len(picked)==10:break
+    assert len(picked)==10
+    for i,r in enumerate(picked):selected.append(dict(r,visual_id=f'scroll_{src}_{i+1:02d}'))
+write_json('source_replay.json',{'revision':PIN,'counts':dict(counts),'errors':dict(errors),'known_cases':known,
+           'odyssey_annotation_files':len(odraw),'missing_annotations_fetched':len(missing),
+           'odyssey_source_revision':'61632d0f','odyssey_hashes':{e:hashlib.sha256((srcdir/(e.zfill(16)+'.json')).read_bytes()).hexdigest() for e in sorted(odraw)},
+           'amex_archive_sha256':hashlib.sha256((BASE/'sources/amex_instructions.zip').read_bytes()).hexdigest()})
+write_json('target_samples.json',{'selection_seed':20261117,'scroll_selection':'10 shortest/off-centre remaining paths per source, distinct episodes and image hashes',
+           'merge_selection':'10 Odyssey and 10 AMEX rows immediately following raw submit merges; distinct episodes per source; raw submit types are recorded',
+           'rows':selected})
+print(json.dumps({'counts':dict(counts),'errors':dict(errors),'visual_rows':len(selected),
+                 'known_published_steps':{e:v['published_steps_in_downloaded_splits'] for e,v in known.items()}},indent=2),flush=True)
+assert not errors,errors
diff --git a/results/codex/data_v2_verify4_rules.py b/results/codex/data_v2_verify4_rules.py
