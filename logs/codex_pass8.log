             "gt_bbox": None, "is_terminal": False, "subsplits": ["IDD"], "images": ["synthetic_image"],
             "messages": [{"role": "system", "content": af.SYSTEM_PROMPT}, {"role": "user", "content": "Goal: wait"}]}
            for i in range(n)]
