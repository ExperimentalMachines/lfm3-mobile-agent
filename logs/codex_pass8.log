original_command=command

def command(argv,**kw):
    env=kw.get('env',{})
    seed=env.get('TEST_SEED')
    if seed:
        d=Path(env['TRACE']).parent;content=d/'content';out=content/'runs'/env['RUN'];prefix=content/'eval'/env['RUN'];work=content/'work'
        if seed=='cached_done':Path(str(prefix)+'_ft_nothink_high.jsonl.done').touch()
        if seed.startswith('receipt_'):
            for sub in ('merged','lora'):(out/sub).mkdir(exist_ok=True)
            (out/'merged/model.safetensors').write_bytes(b'x')
            (out/'merged/config.json').write_text('{}')
            (out/'lora/adapter_model.safetensors').write_bytes(b'x')
            steps=int(env.get('MAX_STEPS','1500'))
            r={'args':{'model_id':env['MODEL'],'out':str(out),'max_steps':int(env.get('MAX_STEPS','-1')),'epochs':float(env.get('EPOCHS','1')),'max_agent_rows':int(env.get('MAX_AGENT_ROWS','0')),'lr':float(env.get('LR','2e-4')),'lora_r':int(env.get('LORA_R','64')),'bs':int(env.get('BS','8')),'grad_accum':int(env.get('GA','4'))},'global_step':steps,'max_steps':steps,'weights':{'model.safetensors':1}}
            if seed=='receipt_wrong_model':r['args']['model_id']='wrong/model'
            if seed=='receipt_wrong_out':r['args']['out']=str(out)+'-different'
            if seed=='receipt_wrong_target':r['max_steps']=1;r['args']['max_steps']=1;r['global_step']=1
            if seed=='receipt_changed_rows':r['args']['max_agent_rows']=1;r['max_steps']=1;r['global_step']=1
            if seed=='receipt_early':r['global_step']=1
            if seed=='receipt_missing_export':(out/'merged/model.safetensors').unlink()
            if seed=='receipt_missing_adapter':(out/'lora/adapter_model.safetensors').unlink()
            if seed=='receipt_wrong_size':(out/'merged/model.safetensors').write_bytes(b'xx')
            if seed=='receipt_zero_weight':r['weights']['model.safetensors']=0
            if seed=='receipt_missing_max_steps':r.pop('max_steps');r['global_step']=1
            if seed=='receipt_empty_weights':r['weights']={}
            for field in ('epochs','max_steps','max_agent_rows','lr','lora_r','bs','grad_accum'):
                if seed=='receipt_diff_'+field:r['args'][field]=r['args'][field]+1
            write_json(out/'train_receipt.json',r)
            if seed=='receipt_torn':(out/'train_receipt.json').write_text('{"args":')
        if seed.startswith('metrics_'):
            gt=work/'meta/androidcontrol_test_gt.jsonl'
            truth=[json.loads(l) for l in gt.read_text().splitlines()]
            for suffix in ('ft','base','ft_nothink_high'):
                model=env['MODEL'] if suffix=='base' else str(out/'merged')
                selected=truth[:1] if suffix=='ft_nothink_high' else truth
                pp=Path(str(prefix)+'_'+suffix+'.jsonl');mp=Path(str(pp)+'.manifest.json');metrics=pp.with_suffix('.metrics.json')
                rows=[{**r,'model':model,'config_hash':'good','output':r['gt_action']} for r in selected]
                pp.write_text(''.join(json.dumps(r)+'\n' for r in rows))
                manifest={'model':model,'config_hash':'good','n_rows':len(rows),'enable_thinking':0 if suffix!='ft' else 1,'max_pixels':774400,'min_pixels':65536}
                if seed=='metrics_wrong_policy':manifest['enable_thinking']=1 if suffix!='ft' else 0;manifest['max_pixels']=345600
                write_json(mp,manifest)
                scored=original_command([sys.executable,'-B',str(work/'score.py'),str(pp),'--gt',str(gt),'--out',str(metrics),*(['--modes','high'] if suffix=='ft_nothink_high' else [])])
                assert scored['exit']==0,scored
                m=json.loads(metrics.read_text())
                if seed=='metrics_incomplete':m['integrity']['complete']=False
                elif seed=='metrics_complete_only':m={'integrity':{'complete':True}}
                elif seed=='metrics_string_false':m['integrity']['complete']='false'
                elif seed=='metrics_wrong_model':m['integrity']['manifest']['model']='wrong/model'
                elif seed=='metrics_real_integrity_problem':
                    rows[0]['config_hash']='stale'
                    pp.write_text(''.join(json.dumps(r)+'\n' for r in rows))
                    scored=original_command([sys.executable,'-B',str(work/'score.py'),str(pp),'--gt',str(gt),'--out',str(metrics),'--allow_incomplete',*(['--modes','high'] if suffix=='ft_nothink_high' else [])])
                    assert scored['exit']==0,scored
                    m=json.loads(metrics.read_text());assert m['integrity']['problems'] and m['integrity']['complete']
                elif seed=='metrics_missing_predictions':pp.unlink()
                elif seed=='metrics_truncated_predictions':pp.write_text('')
                elif seed=='metrics_modified_predictions':
                    rows[0]['config_hash']='stale';pp.write_text(''.join(json.dumps(r)+'\n' for r in rows))
                elif seed=='metrics_missing_manifest':mp.unlink()
                elif seed not in ('metrics_good','metrics_wrong_policy','metrics_changed_gt','metrics_no_gt_manifest'):raise ValueError(seed)
                write_json(metrics,m)
            if seed=='metrics_changed_gt':gt.write_text(gt.read_text().replace('wait','navigate_back'))
            if seed=='metrics_no_gt_manifest':gt.with_suffix('.manifest.json').unlink()
    return original_command(argv,**kw)

RESULT={}
def run_pipeline(name,job,**kw):
    r=pipeline(name,job=job,**kw)
    calls=[e['argv'] for e in r['commands'] if e.get('argv')]
    r['train_calls']=sum(x[0]=='sft_vlm.py' for x in calls)
    r['generation_calls']=sum(x[0]=='generate.py' for x in calls)
    r['scorer_calls']=sum(x[0]=='score.py' for x in calls)
    r['matched_scorer_calls']=sum(x[0]=='score.py' and '--modes' in x and x[x.index('--modes')+1]=='high' for x in calls)
    RESULT[name]=r;write_json(OUT/(name+'_result.json'),r);write_json(OUT/'results.json',RESULT)
    print(name,'rc',r['exit'],'train',r['train_calls'],'gen',r['generation_calls'],'score',r['scorer_calls'],'matched',r['matched_scorer_calls'],flush=True)
    return r


for tag,job in [('qwen2b','qwen35_2b_l4'),('qwen08','qwen35_08b_l4')]:
    r=run_pipeline(tag+'_fresh',job)
    assert r['exit']==0 and r['train_calls']==1 and r['generation_calls']==3 and r['scorer_calls']==6 and r['matched_scorer_calls']==2 and r['matched_done_exists'],r
    m=json.loads(next((Path(r['fixture'])/'content/eval').glob('*_ft_nothink_high.metrics.json')).read_text())
    assert m['integrity']['complete'] and not m['integrity']['problems'] and m['integrity']['n_gt_rows']==1
    if tag=='qwen2b':assert any('experimentalmachines/LFM3-VL-2B-AndroidControl' in e.get('argv',[]) for e in r['commands'])
    for fail in ('upload','upload_merged','upload_evals','matched_score','matched_missing','score.py','generate.py','eval_general.py','training'):
        r=run_pipeline(tag+'_fail_'+fail.replace('.','_'),job,fail=fail)
        assert r['exit']==1,r
        if fail in ('matched_score','matched_missing'):assert not r['matched_done_exists'] and not r['matched_metrics_exist']
    for seed in ('empty_receipt','mismatched_receipt'):
        r=run_pipeline(tag+'_'+seed,job,seed=seed)
        assert r['exit']==0 and r['train_calls']==1,r
    receipt_seeds=['receipt_good','receipt_wrong_model','receipt_wrong_out','receipt_wrong_target','receipt_changed_rows','receipt_early','receipt_missing_export','receipt_missing_adapter','receipt_wrong_size','receipt_zero_weight','receipt_missing_max_steps','receipt_empty_weights','receipt_torn']
    receipt_seeds += ['receipt_diff_'+f for f in ('epochs','max_steps','max_agent_rows','lr','lora_r','bs','grad_accum')]
    for seed in receipt_seeds:
        r=run_pipeline(tag+'_'+seed,job,override={'TEST_SEED':seed})
        reuse=seed in ('receipt_good','receipt_missing_adapter')
        assert r['exit']==0 and r['train_calls']==(0 if reuse else 1),r
    for seed in ('cached_done','metrics_incomplete','metrics_complete_only','metrics_wrong_model','metrics_real_integrity_problem','metrics_missing_predictions','metrics_good','metrics_truncated_predictions','metrics_modified_predictions','metrics_missing_manifest','metrics_wrong_policy','metrics_changed_gt','metrics_no_gt_manifest','metrics_string_false'):
        r=run_pipeline(tag+'_'+seed,job,override={'TEST_SEED':seed})
        regenerate=seed in ('cached_done','metrics_real_integrity_problem','metrics_missing_predictions','metrics_truncated_predictions','metrics_modified_predictions','metrics_missing_manifest','metrics_changed_gt','metrics_no_gt_manifest')
        assert r['exit']==(1 if seed in ('metrics_changed_gt','metrics_no_gt_manifest') else 0) and r['scorer_calls']==(6 if regenerate else 3) and r['generation_calls']==(3 if regenerate else 0),r
    r=run_pipeline(tag+'_train_nonzero_with_receipt',job,fail='train_nonzero_with_receipt');assert r['exit']==0,r
RESULT['legacy_removed']=not(ROOT/'scripts/jobs/qwen35_train_l4.json').exists();assert RESULT['legacy_removed']
write_json(OUT/'results.json',RESULT)
print('RESULTS',OUT/'results.json',flush=True)

