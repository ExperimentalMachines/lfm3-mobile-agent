    73	def mcnemar(b, c):
    74	    n = b + c
    75	    if n == 0:
    76	        return 1.0
    77	    k = min(b, c)
    78	    return min(1.0, 2 * sum(comb(n, i) for i in range(k + 1)) / 2 ** n)
