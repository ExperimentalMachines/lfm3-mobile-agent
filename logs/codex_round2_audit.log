     1	"""Pre-registered held-out analysis (docs/PREREG_v4.md, "Analysis") for the sealed AndroidWorld arms.
     2	
     3	Arms: v4 (LFM3 final), guiowl (GUI-Owl matched), v1 (reference). Only the seeds given with --seeds are opened; run it
     4	only for seeds whose arms have ALL finished (it refuses otherwise). Score = full success (is_successful >= 1, exception =
     5	failure) per task template (n_task_combinations = 1, so one instance per template per seed).
     6	Primary: paired difference v4 - GUI-Owl over all held-out instances; template-clustered sign-flip permutation test
     7	(10,000 permutations, clusters = templates, seed 0); 95% CI by inverting that test; non-inferiority if the lower
     8	bound > -6.9 pp. Also: exact McNemar per seed, Wilson CIs, answer/action split, per difficulty, seed-varying templates.
     9	Usage: python scripts/sealed_analysis.py --seeds 7 --out results/sealed_analysis_seed7
    10	"""
    11	import argparse
    12	import glob
    13	import gzip
    14	import json
    15	import math
    16	import os
    17	import pickle
    18	import re
    19	from math import comb
    20	
    21	import numpy as np
    22	
    23	p = argparse.ArgumentParser()
    24	p.add_argument("--seeds", required=True, help="comma-separated held-out seeds (all arms must be complete)")
    25	p.add_argument("--out", required=True, help="output prefix (.json and .md are written)")
    26	p.add_argument("--perms", type=int, default=10000)
    27	a = p.parse_args()
    28	SEEDS = [int(s) for s in a.seeds.split(",")]
    29	ARMS = {"v4": "lfm3vl2b_v4_q4km", "guiowl": "guiowl15_2b_matched1img_apps_q4km", "v1": "lfm3vl2b_v1_q4km"}
    30	LABEL = {"v4": "LFM3 v4 (final)", "guiowl": "GUI-Owl-1.5-2B matched", "v1": "LFM3 v1 (reference)"}
    31	NI_MARGIN = -6.9
    32	ANSWER = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"])
    33	META = {m["task_name"]: m for m in json.load(open("android_world/android_world/task_metadata.json"))}
    34	
    35	
    36	def load(run_root, agent, expect=116, full=True):
    37	    runs = [d for d in glob.glob(os.path.join(run_root, "run_*")) if os.path.isdir(d)]  # not run_output.SEALED.log
    38	    if len(runs) != 1:
    39	        raise SystemExit(f"INPUT ERROR: {run_root} must contain exactly one run dir, found {len(runs)}")
    40	    files = glob.glob(os.path.join(runs[0], "*.pkl.gz"))
    41	    if expect is not None and len(files) != expect:
    42	        raise SystemExit(f"INPUT ERROR: {run_root} has {len(files)} episodes, expected {expect} (arm not finished?)")
    43	    ok, exc, goal, steps = {}, {}, {}, {}
    44	    for f in files:
    45	        ep = pickle.load(gzip.open(f))  # trusted: written by our own local AndroidWorld runs
    46	        if isinstance(ep, list):
    47	            if len(ep) != 1:
    48	                raise SystemExit(f"INPUT ERROR: {f} holds {len(ep)} episodes")
    49	            ep = ep[0]
    50	        t = os.path.basename(f).rsplit("_", 1)[0]
    51	        if t in ok or ep.get("task_template") != t:
    52	            raise SystemExit(f"INPUT ERROR: duplicate or mislabelled episode {f}")
    53	        if ep.get("agent_name") != agent:
    54	            raise SystemExit(f"INPUT ERROR: {f} agent_name {ep.get('agent_name')!r} != {agent!r}")
    55	        r = ep.get("is_successful")
    56	        e = bool(ep.get("exception_info"))
    57	        ok[t] = isinstance(r, (int, float)) and not math.isnan(r) and r >= 1 and not e
    58	        exc[t] = e
    59	        goal[t] = re.sub(r"\d{8}_\d{6}", "<ts>", ep.get("goal") or "")
    60	        steps[t] = ep.get("episode_length")
    61	    if full and set(ok) != set(META):
    62	        raise SystemExit(f"INPUT ERROR: {run_root} templates differ from task_metadata.json")
    63	    return ok, exc, goal, steps
    64	
    65	
    66	def wilson(k, n, z=1.959964):
    67	    ph = k / n
    68	    c = (ph + z * z / (2 * n)) / (1 + z * z / n)
    69	    h = z * math.sqrt(ph * (1 - ph) / n + z * z / (4 * n * n)) / (1 + z * z / n)
    70	    return [round(100 * (c - h), 1), round(100 * (c + h), 1)]
    71	
    72	
    73	def mcnemar(b, c):
    74	    n = b + c
    75	    if n == 0:
    76	        return 1.0
    77	    k = min(b, c)
    78	    return min(1.0, 2 * sum(comb(n, i) for i in range(k + 1)) / 2 ** n)
    79	
    80	
    81	def signflip(cluster_sums, n_inst, delta=0.0, perms=10000, seed=0):
    82	    """Two-sided p for H0: mean paired difference = delta, flipping signs of template-cluster sums of (d - delta)."""
    83	    x = np.array([s - delta * m for s, m in cluster_sums])
    84	    obs = abs(x.sum()) / n_inst
    85	    rng = np.random.default_rng(seed)
    86	    signs = rng.choice([-1.0, 1.0], size=(perms, len(x)))
    87	    stats = np.abs(signs @ x) / n_inst
    88	    return float((1 + np.sum(stats >= obs - 1e-12)) / (perms + 1))
    89	
    90	
    91	# ---- load (only the requested, complete seeds)
    92	data = {}
    93	for s in SEEDS:
    94	    for arm, agent in ARMS.items():
    95	        data[(arm, s)] = load(f"results/androidworld_sealed/{arm}_seed{s}", agent)
    96	# preregistered single re-run of infrastructure crashes before step 1: results/androidworld_sealed/<arm>_seed<s>_rerun
    97	# replaces an original episode only if that episode was an exception and the re-run's goal text is identical
    98	SUBST = []
    99	for s in SEEDS:
   100	    for arm, agent in ARMS.items():
   101	        rr = f"results/androidworld_sealed/{arm}_seed{s}_rerun"
   102	        if not os.path.isdir(rr):
   103	            continue
   104	        ok2, exc2, goal2, _ = load(rr, agent, expect=None, full=False)
   105	        ok, exc, goal, steps = data[(arm, s)]
   106	        for t in ok2:
   107	            if not exc[t]:
   108	                raise SystemExit(f"INPUT ERROR: re-run of {arm} seed {s} {t}, but the original was not an exception")
   109	            if goal2[t] != goal[t]:
