     1	#!/bin/bash
     2	# Runs ON a Colab GPU VM: serve GUI-Owl-1.5-2B on :8092 and MAI-UI-2B on :8093 (same llama.cpp commit and server flags
     3	# as GUI-Owl's AndroidWorld runs on the Mac, plus -ngl 99; MAI-UI GGUFs converted the same way: Q4_K_M + Q8_0 mmproj)
     4	# and expose them to a MobileWorld env host through a reverse SSH tunnel (remote 18092 / 18093).
     5	# The tunnel key is restricted on the EC2 side to `restrict,port-forwarding,permitlisten="localhost:18092",
     6	# permitlisten="localhost:18093",command="/bin/false"` (no shell, two ports). The env host firewall (AWS security group / GCP firewall) must allow this VM's public IP on port 22.
     7	# Files expected in /content: models/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf, models/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf,
     8	# models/MAI-UI-2B-Q4_K_M.gguf, models/mmproj-MAI-UI-2B-Q8_0.gguf, tunnel_key. Usage (on the VM): EC2_IP=<ip> nohup bash colab_mw_models.sh > /content/mw_models.log 2>&1 &
