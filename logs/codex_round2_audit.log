     1	"""Recording proxy for a phone reached only through a REMOTE adb server (Qualcomm Device Cloud: `ssh -L <port>:<host>:5037`).
     2	
     3	`adb forward` would open its listener on the remote adb server's host, not on this Mac, so each HTTP request is instead
     4	carried through `adb shell` into curl on the phone (`curl http://127.0.0.1:8080...`, request body on stdin, response
     5	on stdout). Same JSONL record as record_proxy.py (fsync per request): wall-clock latency (includes the tunnel), the
     6	request summary and the full response JSON with llama.cpp's on-phone `timings` (the primary speed numbers).
     7	Usage: python record_proxy_adb.py --listen 18301 --adb "adb -P 15037 -s SERIAL" --log out.jsonl --device D --model M
     8	"""
     9	import argparse
    10	import json
    11	import os
    12	import re
    13	import shlex
    14	import subprocess
    15	import threading
    16	import time
    17	from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    18	
    19	import record_proxy_common as common
    20	
    21	p = argparse.ArgumentParser()
    22	p.add_argument("--listen", type=int, required=True)
    23	p.add_argument("--adb", required=True)
    24	p.add_argument("--phone_port", type=int, default=8080)
    25	p.add_argument("--log", required=True)
    26	p.add_argument("--device", required=True)
    27	p.add_argument("--model", required=True)
    28	a = p.parse_args()
    29	ADB = shlex.split(a.adb)
    30	LOCK = threading.Lock()
    31	
    32	
    33	PATH_OK = re.compile(r"/(health|v1/[A-Za-z0-9/_.\-]+)")
    34	
    35	
    36	def phone_http(method: str, path: str, body: bytes | None):
    37	    """Run curl on the phone; returns (status, body bytes). The request path and method are interpolated into a
    38	    phone-side shell command, so both are allowlisted and the URL is shell-quoted (security review)."""
    39	    if method not in ("GET", "POST") or not PATH_OK.fullmatch(path):
    40	        return 400, json.dumps({"proxy_error": "method/path not allowed"}).encode()
    41	    url = shlex.quote(f"http://127.0.0.1:{int(a.phone_port)}{path}")
    42	    cmd = f"curl -s -m 1800 -o - -w '\\n%{{http_code}}' -X {method} -H 'Content-Type: application/json' "
    43	    cmd += ("--data-binary @- " if body else "") + url
    44	    r = subprocess.run(ADB + ["shell", "-T", cmd], input=body or b"", capture_output=True, timeout=2000)
    45	    out = r.stdout
    46	    head, _, code = out.rpartition(b"\n")
    47	    try:
    48	        return int(code.strip() or b"0"), head
    49	    except ValueError:
    50	        return 502, out
    51	
    52	
    53	class H(BaseHTTPRequestHandler):
    54	    def log_message(self, *args):
    55	        pass
    56	
    57	    def _handle(self, method):
    58	        n = int(self.headers.get("Content-Length") or 0)
    59	        data = self.rfile.read(n) if n else None
    60	        t0 = time.time()
    61	        try:
    62	            status, out = phone_http(method, self.path, data)
    63	        except Exception as e:
    64	            status, out = 502, json.dumps({"proxy_error": repr(e)}).encode()
    65	        t1 = time.time()
    66	        if self.path.startswith("/v1/chat/completions"):
    67	            try:
    68	                body = json.loads(data or b"{}")
    69	            except Exception:
    70	                body = {}
    71	            try:
    72	                resp = json.loads(out or b"{}")
    73	            except Exception:
    74	                resp = {"raw": out[:2000].decode(errors="replace")}
    75	            common.write(a.log, LOCK, {"t_start": t0, "t_end": t1, "latency_s": round(t1 - t0, 3), "device": a.device,
    76	                                       "model": a.model, "status": status, "transport": "adb-shell-curl",
    77	                                       "request": common.summarize(body), "response": resp})
    78	        self.send_response(status or 502)
    79	        self.send_header("Content-Type", "application/json")
    80	        self.send_header("Content-Length", str(len(out)))
    81	        self.end_headers()
    82	        self.wfile.write(out)
    83	
    84	    def do_POST(self):
    85	        self._handle("POST")
    86	
    87	    def do_GET(self):
    88	        self._handle("GET")
    89	
    90	
    91	ThreadingHTTPServer(("127.0.0.1", a.listen), H).serve_forever()
     1	"""Summarise the Qualcomm Device Cloud phone benchmark (SM8975 reference phone, Android 17, CPU, llama.cpp b12110).
     2	
     3	Round 1 (results/qdc/run_20261118_1554): v4 only completed (15 timed calls, default flash attention); GUI-Owl/MAI-UI calls
     4	never completed before the client gave up (MobileWorld client: 120 s timeout + re-sends); one MAI-UI Q4_K_M probe with
     5	-fa on (fa_probe/) took 1,176 s and produced a degenerate 2,048-token output.
     6	Round 2 (latest results/qdc/run_*_v6): identical settings for all three models within each part (-t 4 -np 1
     7	--cache-ram 0 -fa on, MAI-UI Q8_0, 3600 s client timeout without re-sends). Option 1 = each model's evaluation image
     8	budget, 2 screenshots; option 2 = all at 1,024 image tokens, 5 screenshots, pass 1 v4->GUI-Owl->MAI-UI, pass 2 reversed.
     9	The first request of each model in each part is the mirrored warm-up and is excluded. Phone-side times are llama.cpp's
    10	own timings; end-to-end = proxy wall time (includes the SSH/adb tunnel). Frequencies are sampled current frequencies.
    11	Usage: python scripts/qdc_report_v6.py  -> results/qdc/speed_qdc_v6.{json,md}
    12	"""
    13	import glob
    14	import json
    15	import os
    16	import statistics as st
    17	
    18	LAB = {"v4": "v4 (ours)", "guiowl": "GUI-Owl-1.5-2B", "maiui": "MAI-UI-2B"}
    19	R1 = "results/qdc/run_20261118_1554"
    20	R2 = sorted(glob.glob("results/qdc/run_*_v6"))[-1]
    21	
    22	
    23	def reqs(path):
    24	    if not os.path.exists(path):
    25	        return []
    26	    return [json.loads(l) for l in open(path)]
    27	
    28	
    29	def summ(rows, thermal=None):
    30	    rows = [r for r in rows if r.get("status") == 200 and "timings" in (r.get("response") or {})]
    31	    if not rows:
    32	        return None
    33	    T = [r["response"]["timings"] for r in rows]
    34	    lat = [r["latency_s"] for r in rows]
    35	    valid = sum(1 for r in rows if (r["response"]["choices"][0].get("finish_reason") == "stop"))
    36	    out = {"calls": len(rows), "e2e_median_s": round(st.median(lat), 1), "e2e_min_max_s": [round(min(lat), 1), round(max(lat), 1)],
    37	           "phone_median_s": round(st.median((t["prompt_ms"] + t["predicted_ms"]) / 1000 for t in T), 1),
    38	           "prompt_s_median": round(st.median(t["prompt_ms"] for t in T) / 1000, 1),
    39	           "prompt_tokens_median": int(st.median(t["prompt_n"] for t in T)),
    40	           "prompt_tok_s": round(sum(t["prompt_n"] for t in T) / (sum(t["prompt_ms"] for t in T) / 1000), 1),
    41	           "gen_tokens_median": int(st.median(t["predicted_n"] for t in T)),
    42	           "gen_tok_s_llamacpp_median": round(st.median(t["predicted_per_second"] for t in T), 1),
    43	           "finished_normally": f"{valid}/{len(rows)}"}
    44	    if thermal:
    45	        fq = []
    46	        for r in rows:
    47	            for p in thermal:
    48	                if r["t_start"] <= p["t"] <= r["t_end"]:
    49	                    f = p.get("cur_freq_khz", "").split()
    50	                    if len(f) >= 8:
    51	                        fq.append(max(map(int, f[3:])) / 1e6)
    52	        out["fastest_core_ghz_median_sampled"] = round(st.median(fq), 2) if fq else None
    53	    return out
    54	
    55	
    56	def part(d):
    57	    th = reqs(os.path.join(d, "thermal.jsonl"))
    58	    res = {}
    59	    for m in ("v4", "guiowl", "maiui"):
    60	        s = summ(reqs(os.path.join(d, f"requests_{m}.jsonl"))[1:], th)
    61	        if s:
    62	            res[m] = s
    63	    return res
    64	
    65	
    66	out = {"device": json.load(open(os.path.join(R1, "dev0", "device.json"))), "round1": {}, "round2_dir": R2}
    67	out["round1"]["v4"] = summ(reqs(os.path.join(R1, "dev0", "requests_v4.jsonl"))[1:])
    68	probe = reqs(os.path.join(R1, "fa_probe", "requests_maiui_fa.jsonl"))
    69	if probe:
    70	    t = probe[0]["response"]["timings"]
    71	    out["round1"]["maiui_q4_fa_probe"] = {"e2e_s": round(probe[0]["latency_s"], 1), "prompt_s": round(t["prompt_ms"] / 1000, 1),
    72	                                          "gen_tokens": t["predicted_n"], "finish_reason": probe[0]["response"]["choices"][0].get("finish_reason")}
    73	out["option1"] = part(os.path.join(R2, "opt1_eval"))
    74	out["option2"] = {"pass1": part(os.path.join(R2, "opt2_pass1")), "pass2": part(os.path.join(R2, "opt2_pass2"))}
    75	settings = {}
    76	for p in ("opt1_eval", "opt2_pass1", "opt2_pass2"):
