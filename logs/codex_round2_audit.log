   296	
   297	    resp: dict[str, Any] = {"device": device, "mode": mode, "path": str(local_path)}
   298	    if return_content:
   299	        try:
   300	            content = Path(local_path).read_text(encoding="utf-8", errors="ignore")
   301	        except Exception:
   302	            content = Path(local_path).read_text(errors="ignore")
   303	        resp["content"] = content
