 succeeded in 160ms:
     1	"""LFM3 screen agent (our v1-v4 format) for MobileWorld (github.com/Tongyi-MAI/MobileWorld), GUI-only tasks.
     2	
     3	Same model-side contract as the AndroidWorld agent (eval/androidworld/lfm_agent.py):
     4	  * one screenshot per step, resized with train/agent_format.resize_screenshot (MAX_PIXELS);
     5	  * system prompt agent_format.PROMPTS[prompt_version] and the user text from agent_format.user_text (goal + the last
     6	    HISTORY_STEPS (intent, action) pairs; v4 adds the installed-app list);
     7	  * llama-server /v1/chat/completions, temperature 0, thinking on, one parse retry; only the final action is parsed;
     8	  * point_2d on the 0-1000 grid -> screen pixels.
     9	Mapping to MobileWorld actions: status (complete or infeasible) -> `finished` (episode ends; MobileWorld scores the
    10	device/backend state), answer -> `answer` (MobileWorld ends the episode after an answer), everything else 1:1, except
    11	two actions whose AndroidWorld execution (the contract v4 was trained and evaluated on) MobileWorld implements
    12	differently (Codex audit results/codex/session_1118_audit, C1/C2; fixed 2026-11-18 for run v4_gui_en_r2):
    13	  * scroll: AndroidWorld swipes from the screen centre to the edge OPPOSITE the content direction (scroll down ->
    14	    finger to y=0; scroll right -> finger to x=0; actuation.py). MobileWorld's `scroll` reverses only up/down and uses
    15	    its own distance, so it is sent as an explicit `drag` with AndroidWorld's start/end points (MobileWorld's drag =
    16	    `input swipe ... 400` ms; AndroidWorld omits the duration, Android's default being 300 ms).
    17	  * input_text: AndroidWorld types and then presses Enter in one action; MobileWorld only types. The adapter sends the
    18	    text, and on the next step sends `keyboard_enter` WITHOUT querying the model (one extra environment step of the
    19	    50-step budget per text action; the model's history is unchanged, as in AndroidWorld).
    20	Installed apps for v4: the names MobileWorld's open_app resolves (runtime/utils/models.APP_DICT, English names).
    21	Load with: mw eval --agent_type <this file> ... (MobileWorld's registry loads agent classes from a .py path).
    22	Env: LFM3_PROMPT_VERSION (v4 default), LFM3_AGENT_FORMAT_DIR (dir holding agent_format.py).
    23	"""
    24	import base64
    25	import io
    26	import os
    27	import sys
    28	import time
    29	from typing import Any
    30	
    31	import requests
    32	from loguru import logger
    33	
    34	from mobile_world.agents.base import BaseAgent
    35	from mobile_world.runtime.utils.models import JSONAction
    36	
    37	sys.path.insert(0, os.environ.get("LFM3_AGENT_FORMAT_DIR", os.path.dirname(os.path.abspath(__file__))))
    38	import agent_format as af  # noqa: E402
    39	
    40	MW_APPS = ["Calendar", "Camera", "Chrome", "Clock", "Contacts", "Files", "Gallery", "Mail", "Maps", "Mastodon",
    41	           "Mattermost", "Settings", "SMS", "Taodian"]
    42	
    43	
    44	def _png_b64(img) -> str:
    45	    buf = io.BytesIO()
    46	    img.convert("RGB").save(buf, format="PNG")
    47	    return base64.b64encode(buf.getvalue()).decode()
    48	
    49	
    50	class LFM3MobileWorldAgent(BaseAgent):
    51	    def __init__(self, model_name: str = "local", llm_base_url: str = "http://127.0.0.1:8114", api_key: str = "",
    52	                 *args: Any, **kwargs: Any):
    53	        super().__init__()
    54	        base = (llm_base_url or "http://127.0.0.1:8114").rstrip("/")
    55	        self.server_url = base[:-3] if base.endswith("/v1") else base
    56	        self.model = model_name or "local"
    57	        self.prompt_version = os.environ.get("LFM3_PROMPT_VERSION", "v4")
    58	        assert self.prompt_version in af.PROMPTS, self.prompt_version
    59	        self.apps = MW_APPS if self.prompt_version == "v4" else None
    60	        self.history: list[tuple[str, str]] = []
    61	        self.max_parse_retries = 1
    62	        self._pending_enter = False
    63	
    64	    def initialize_hook(self, instruction: str) -> None:
    65	        self.history = []
    66	        self._pending_enter = False
    67	
    68	    def reset(self) -> None:
    69	        self.history = []
    70	        self._pending_enter = False
    71	
    72	    def _query(self, goal: str, img) -> dict:
    73	        payload = {
    74	            "model": self.model,
    75	            "messages": [
    76	                {"role": "system", "content": af.PROMPTS[self.prompt_version]},
    77	                {"role": "user", "content": [
    78	                    {"type": "image_url", "image_url": {"url": "data:image/png;base64," + _png_b64(img)}},
    79	                    {"type": "text", "text": af.user_text(goal, self.history, apps=self.apps)},
    80	                ]},
    81	            ],
    82	            "temperature": 0.0, "max_tokens": 512, "chat_template_kwargs": {"enable_thinking": True},
    83	        }
    84	        t0 = time.time()
    85	        r = requests.post(f"{self.server_url}/v1/chat/completions", json=payload, timeout=300)
    86	        r.raise_for_status()
    87	        out = r.json()
    88	        msg = out["choices"][0]["message"]
    89	        u = out.get("usage") or {}
    90	        self._total_prompt_tokens += u.get("prompt_tokens", 0) or 0
    91	        self._total_completion_tokens += u.get("completion_tokens", 0) or 0
    92	        return {"content": msg.get("content") or "", "reasoning": msg.get("reasoning_content") or "",
    93	                "latency_s": time.time() - t0}
    94	
    95	    def predict(self, observation: dict[str, Any]) -> tuple[str, JSONAction]:
    96	        if self._pending_enter:  # second half of AndroidWorld's input_text (type + Enter); no model call
    97	            self._pending_enter = False
    98	            return "(adapter) keyboard_enter completing the previous input_text", JSONAction(action_type="keyboard_enter")
    99	        shot = observation["screenshot"]
   100	        W, H = shot.size
   101	        img = af.resize_screenshot(shot, af.MAX_PIXELS)
   102	        resp, action = None, None
   103	        for _ in range(1 + self.max_parse_retries):
   104	            resp = self._query(self.instruction, img)
   105	            action = af.parse_action(resp["content"])
   106	            if action is not None:
   107	                break
   108	        raw = f"<think>{resp['reasoning']}</think>{resp['content']}  [latency {resp['latency_s']:.1f}s]"
   109	        if action is None:
   110	            self.history.append(("(invalid output)", resp["content"][:80]))
   111	            logger.warning(f"unparseable output: {resp['content'][:200]}")
   112	            return raw, JSONAction(action_type="wait")  # same as AW: an invalid step consumes budget, no device action
   113	        reasoning = resp["reasoning"].strip()
   114	        intent = reasoning.splitlines()[0][:200] if reasoning else ""
   115	        self.history.append((intent, af.action_to_str(action)))
   116	        t = action["action_type"]
   117	        if t == "status":
   118	            return raw, JSONAction(action_type="finished", goal_status=action.get("goal_status"))
   119	        if t in af.POINT_TYPES:
   120	            x, y = af.norm_to_px(action["point_2d"], W, H)
   121	            return raw, JSONAction(action_type=t, x=x, y=y)
   122	        if t == "answer":
   123	            return raw, JSONAction(action_type=t, text=action["text"])
   124	        if t == "input_text":
   125	            self._pending_enter = bool(action["text"])  # AndroidWorld skips both type and Enter for empty text
   126	            return raw, JSONAction(action_type=t, text=action["text"])
   127	        if t == "scroll":
   128	            end = {"down": (W // 2, 0), "up": (W // 2, H), "right": (0, H // 2), "left": (W, H // 2)}.get(action["direction"])
   129	            if end is None:
   130	                return raw, JSONAction(action_type="wait")
   131	            return raw, JSONAction(action_type="drag", start_x=W // 2, start_y=H // 2, end_x=end[0], end_y=end[1])
   132	        if t == "open_app":
   133	            return raw, JSONAction(action_type="open_app", app_name=action["app_name"])
   134	        return raw, JSONAction(action_type=t)  # navigate_back / navigate_home / keyboard_enter / wait
     1	"""Per-step speed of the three 2B agents on identical inputs, through the same agent code used for evaluation.
     2	
     3	  lfm3   : eval/mobileworld/lfm3_mw_agent.py (v4 prompt, one screenshot, af.MAX_PIXELS resize, thinking on)
     4	  guiowl : MobileWorld's official GUI-Owl-1.5 agent (history_n=1 default)
     5	  maiui  : MobileWorld's official MAI-UI agent with history_n=1 (eval/mobileworld/maiui_1img_agent.py)
     6	
     7	Each call is the first step of a fresh episode on one of N real 1080x2400 MobileWorld screenshots with that task's real
     8	goal; one warm-up call is excluded. End-to-end latency = agent.predict() wall time (prompt building, image encoding to
     9	base64, HTTP, model, parsing). Server-side prompt/generation timings are read afterwards from the llama-server log
    10	(scripts/bench_speed.sh). Usage (MobileWorld venv):
    11	  python bench_speed.py --agent lfm3 --url http://127.0.0.1:8114/v1 --shots ~/bench/shots --reps 3 --out res.json
    12	"""
    13	import argparse
    14	import glob
    15	import json
    16	import os
    17	import sys
    18	import time
    19	
    20	from PIL import Image, ImageOps
    21	
    22	p = argparse.ArgumentParser()
    23	p.add_argument("--agent", required=True, choices=["lfm3", "guiowl", "maiui"])
    24	p.add_argument("--url", required=True)
    25	p.add_argument("--shots", required=True)
    26	p.add_argument("--reps", type=int, default=3)
    27	p.add_argument("--out", required=True)
    28	p.add_argument("--jsonl", default="", help="also append each call to this file (fsync) as it completes")
    29	p.add_argument("--mirror_warmup", action="store_true",
    30	               help="warm up on a mirrored copy of the first screenshot so no timed call repeats the warm-up prompt")
    31	p.add_argument("--client_timeout", type=float, default=0,
    32	               help="if >0: OpenAI client timeout in seconds and max_retries=0 (slow phones; MobileWorld's default is 120 s with "
    33	                    "2 automatic re-sends, which queue duplicate requests on a single-slot server)")
    34	p.add_argument("--agent_dir", default="", help="directory holding lfm3_mw_agent.py / maiui_1img_agent.py / agent_format.py")
    35	a = p.parse_args()
    36	sys.path.insert(0, os.path.expanduser(a.agent_dir or "~/lfm3"))
    37	
    38	from mobile_world.tasks.registry import TaskRegistry  # noqa: E402
    39	
    40	reg = TaskRegistry()
    41	
    42	
    43	def make():
    44	    if a.agent == "lfm3":
    45	        from lfm3_mw_agent import LFM3MobileWorldAgent
    46	        return LFM3MobileWorldAgent(model_name="local", llm_base_url=a.url)
    47	    if a.agent == "guiowl":
    48	        from mobile_world.agents.implementations.gui_owl_1_5 import GUIOWL15AgentMCP
    49	        return GUIOWL15AgentMCP(model_name="GUI-Owl-1.5-2B", llm_base_url=a.url, tools=[])
    50	    from maiui_1img_agent import MAIUI1ImageAgent
    51	    return MAIUI1ImageAgent(llm_base_url=a.url, model_name="MAI-UI-2B")
    52	
    53	
    54	shots = sorted(glob.glob(os.path.join(os.path.expanduser(a.shots), "*.png")))
    55	cases = []
    56	for f in shots:
    57	    task = os.path.basename(f).split("-")[0]
    58	    cases.append((task, reg.get_task(task).goal, Image.open(f).convert("RGB")))
    59	rows = []
    60	for rep in range(a.reps + 1):  # rep 0 = warm-up (first case only)
    61	    for i, (task, goal, img) in enumerate(cases if rep else cases[:1]):
    62	        if rep == 0 and a.mirror_warmup:
    63	            img = ImageOps.mirror(img)
    64	        ag = make()
    65	        if a.client_timeout > 0 and getattr(ag, "openai_client", None) is not None:
    66	            ag.openai_client = ag.openai_client.with_options(timeout=a.client_timeout, max_retries=0)
    67	        ag.initialize(goal)
    68	        t0 = time.time()
    69	        res = ag.predict({"screenshot": img, "tool_call": None, "ask_user_response": None})
    70	        dt = time.time() - t0
    71	        action = res[-1]
    72	        raw = res[0] if isinstance(res[0], str) else str(res[0])
    73	        rows.append({"rep": rep, "task": task, "latency_s": round(dt, 3), "raw_chars": len(raw),
    74	                     "action": action.model_dump(exclude_none=True) if hasattr(action, "model_dump") else str(action)})
    75	        print(json.dumps(rows[-1])[:200], flush=True)
    76	        if a.jsonl:
    77	            with open(a.jsonl, "a") as fh:
    78	                fh.write(json.dumps({"agent": a.agent, "t": time.time(), **rows[-1]}) + "\n")
    79	                fh.flush()
    80	                os.fsync(fh.fileno())
    81	json.dump({"agent": a.agent, "rows": rows}, open(a.out, "w"), indent=1)
     1	# Speed: v4 vs GUI-Owl-1.5-2B vs MAI-UI-2B
     2	
     3	## CPU: Intel Xeon 2.8 GHz, 8 threads, idle GCP VM
     4	
     5	Same 5 real 1080×2400 screenshots and goals for every model, run through each model's actual evaluation agent code,
