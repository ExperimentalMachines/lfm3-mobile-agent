   110	def v4_app_list(key: str, required: list[str], pool: list[str]) -> list[str]:
   111	    """Training/offline-eval stand-in for a device's installed apps: the episode's own apps plus distractors from the
   112	    training app pool, 12-30 names, deterministic per episode key, sorted case-insensitively like the device list."""
   113	    rnd = random.Random(hashlib.sha256(key.encode()).hexdigest())
   114	    k = rnd.randint(12, 30)
   115	    apps = list(dict.fromkeys(a for a in required if a))
   116	    cand = sorted({p for p in pool if p and p not in apps})
   117	    rnd.shuffle(cand)
   118	    apps += cand[: max(0, k - len(apps))]
   119	    return sorted(apps, key=str.lower)
   120	
