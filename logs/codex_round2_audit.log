   102	    L += [f"**Headline (same phone, same clock):** v4's evaluation image budget is 1,024 tokens, so its option-2 runs are also its "
   103	          f"evaluation setting; they ran at the same sampled ~2.65 GHz as GUI-Owl's and MAI-UI's option-1 runs. As evaluated, one step takes "
   104	          f"**~{v4m} s for v4** vs {o1['guiowl']['e2e_median_s']:.0f} s for GUI-Owl and {o1['maiui']['e2e_median_s']:.0f} s for MAI-UI "
   105	          f"(~{o1['guiowl']['e2e_median_s'] / v4m:.0f}× and ~{o1['maiui']['e2e_median_s'] / v4m:.0f}×). At the same 1,024-token image budget "
   106	          f"for all three (option 2), GUI-Owl and MAI-UI take ~{o2['pass1']['guiowl']['e2e_median_s'] / v4m:.1f}× and "
   107	          f"~{o2['pass1']['maiui']['e2e_median_s'] / v4m:.1f}× v4's time. Option 1's v4 row ran earlier at the full 4.03 GHz, so it is not "
   108	          "the like-for-like number.", ""]
   109	L += ["**Option 1: each model at its evaluation image budget** (v4 1,024 image tokens; GUI-Owl and MAI-UI 2,600), flash "
   110	      "attention on for all, MAI-UI at Q8_0 (its Q4_K_M output degenerates), 2 screenshots after a warm-up call:", "", HDR]
   111	L[-1] = HDR.replace("| Finished normally |", "| Finished normally | Fastest core, sampled GHz |").replace("|---|---|---|---|---|---|---|---|---|", "|---|---|---|---|---|---|---|---|---|---|")
   112	for m, s in out["option1"].items():
