   166	def mcnemar(x, y):
   167	    b = sum(1 for t in x if x[t] and not y.get(t)); c = sum(1 for t in x if y.get(t) and not x[t]); n = b + c
   168	    p = min(1.0, 2 * sum(math.comb(n, k) for k in range(min(b, c) + 1)) / 2 ** n) if n else 1.0
   169	    return b, c, (f"{p:.1e}" if p < 0.001 else round(p, 3))
