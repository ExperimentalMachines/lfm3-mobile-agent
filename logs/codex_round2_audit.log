   114	L += ["", "**Option 2: all three at the same 1,024-token image budget** (a speed comparison at equal image size; GUI-Owl's and "
   115	      "MAI-UI's accuracy at this budget was not measured), 5 screenshots, pass 1 v4 → GUI-Owl → MAI-UI, pass 2 reversed:", "",
   116	      HDR.replace("| Model |", "| Model (pass) |").replace("| Finished normally |", "| Finished normally | Fastest core, sampled GHz |")
   117	      .replace("|---|---|---|---|---|---|---|---|---|", "|---|---|---|---|---|---|---|---|---|---|")]
   118	for pn in ("pass1", "pass2"):
   119	    for m, s in out["option2"][pn].items():
   120	        L.append(row(m, s, f" ({pn[-1]})") + f" {s.get('fastest_core_ghz_median_sampled')} |")
   121	if not out["option2"]["pass2"]:
