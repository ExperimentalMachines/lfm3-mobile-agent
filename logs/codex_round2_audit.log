   258	        command = ""
   259	
   260	        if app_name is not None and app_name.lower() in APP_LOWER_DICT:
   261	            command = f"adb -s {self.device} shell monkey -p {APP_LOWER_DICT[app_name.lower()]} -c android.intent.category.LAUNCHER 1"
   262	            ret = execute_adb(command)
   263	            if ret.success:
   264	                return ret
   265	        logger.warning(
   266	            f"Failed to launch the app: {app_name}. Available app list: {list(APP_LOWER_DICT.keys())}"
   267	        )
   268	        return AdbResponse(
   269	            success=False,
   270	            error=f"Failed to launch the app: {app_name}",
   271	            command=command,
   272	        )
