   213	    def swipe(
   214	        self,
   215	        x: int | None,
   216	        y: int | None,
   217	        direction: str,
   218	    ) -> AdbResponse:
   219	        if self.width is None or self.height is None:
   220	            # attempt to get device size again
   221	            self.width, self.height = self.get_device_size()
   222	        if x is None:
   223	            x = self.width // 2
   224	        if y is None:
   225	            y = self.height // 2
   226	
   227	        unit_dist = int(self.width / 10)
   228	        unit_dist *= 2
   229	        if direction == "up":
   230	            offset = 0, -2 * unit_dist
   231	        elif direction == "down":
   232	            offset = 0, 2 * unit_dist
   233	        elif direction == "left":
   234	            offset = -1 * unit_dist, 0
   235	        elif direction == "right":
   236	            offset = unit_dist, 0
   237	        else:
   238	            return AdbResponse(
   239	                success=False,
   240	                error=f"Invalid direction: {direction}. Must be one of: up, down, left, right",
   241	                command=f"adb -s {self.device} shell input swipe",
   242	            )
   243	        duration = 400
   244	        adb_command = f"adb -s {self.device} shell input swipe {x} {y} {x + offset[0]} {y + offset[1]} {duration}"
   245	        ret = execute_adb(adb_command)
   246	        return ret
   247	
   248	    def drag(
   249	        self, start_x: int, start_y: int, end_x: int, end_y: int, duration: int = 400
   250	    ) -> AdbResponse:
   251	        adb_command = (
   252	            f"adb -s {self.device} shell input swipe {start_x} {start_y} {end_x} {end_y} {duration}"
   253	        )
   254	        ret = execute_adb(adb_command)
   255	        return ret
