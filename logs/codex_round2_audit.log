    66	def wilson(k, n, z=1.959964):
    67	    ph = k / n
    68	    c = (ph + z * z / (2 * n)) / (1 + z * z / n)
    69	    h = z * math.sqrt(ph * (1 - ph) / n + z * z / (4 * n * n)) / (1 + z * z / n)
    70	    return [round(100 * (c - h), 1), round(100 * (c + h), 1)]
