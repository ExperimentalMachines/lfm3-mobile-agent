   192	def aw_speed(d):  # per-step model latency and token counts over every saved step of a run (partial runs allowed)
   193	    runs = sorted(glob.glob(f"{d}/run_*/"))
   194	    if not runs:
   195	        return None
   196	    L, P, G = [], [], []
   197	    files = glob.glob(runs[-1] + "*.pkl.gz")
   198	    n_eps = len(files)  # progress = episode files (exception episodes have no step data but still count)
   199	    for f in files:
   200	        e = pickle.loads(gzip.decompress(open(f, "rb").read()))[0]  # our own harness output (trusted)
   201	        dd = e.get("episode_data")
   202	        if not isinstance(dd, dict):
   203	            continue
   204	        L += [x for x in (dd.get("latency_s") or []) if isinstance(x, (int, float)) and x == x]
   205	        for u in dd.get("usage") or []:
   206	            if isinstance(u, dict) and u.get("prompt_tokens"):
   207	                P.append(u["prompt_tokens"]); G.append(u.get("completion_tokens", 0))
   208	    if not L:
   209	        return None
   210	    q = sorted(L)
   211	    return {"episodes": n_eps, "steps": len(L), "median_s": round(st.median(L), 2), "p10_s": round(q[len(q) // 10], 2),
   212	            "p90_s": round(q[9 * len(q) // 10], 2), "prompt_tokens_median": int(st.median(P)) if P else None,
   213	            "output_tokens_median": int(st.median(G)) if G else None, "run_dir": runs[-1]}
