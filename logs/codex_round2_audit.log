    t += "\n| Model | Pass | Calls | Seconds per step (median) | Prompt time (median) | Battery °C (median / max) | Max thermal status |\n|---|---|---|---|---|---|---|\n"
    for m, o in ph["models"].items():
        for pn, pp in o["passes"].items():
