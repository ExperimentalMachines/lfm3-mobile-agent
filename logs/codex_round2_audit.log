     1	"""Recording proxy for a phone reached only through a REMOTE adb server (Qualcomm Device Cloud: `ssh -L <port>:<host>:5037`).
     2	
     3	`adb forward` would open its listener on the remote adb server's host, not on this Mac, so each HTTP request is instead
     4	carried through `adb shell` into curl on the phone (`curl http://127.0.0.1:8080...`, request body on stdin, response
     5	on stdout). Same JSONL record as record_proxy.py (fsync per request): wall-clock latency (includes the tunnel), the
     6	request summary and the full response JSON with llama.cpp's on-phone `timings` (the primary speed numbers).
     7	Usage: python record_proxy_adb.py --listen 18301 --adb "adb -P 15037 -s SERIAL" --log out.jsonl --device D --model M
     8	"""
     9	import argparse
    10	import json
    11	import os
    12	import re
    13	import shlex
    14	import subprocess
    15	import threading
    16	import time
    17	from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    18	
    19	import record_proxy_common as common
    20	
    21	p = argparse.ArgumentParser()
    22	p.add_argument("--listen", type=int, required=True)
    23	p.add_argument("--adb", required=True)
    24	p.add_argument("--phone_port", type=int, default=8080)
    25	p.add_argument("--log", required=True)
    26	p.add_argument("--device", required=True)
    27	p.add_argument("--model", required=True)
    28	a = p.parse_args()
    29	ADB = shlex.split(a.adb)
    30	LOCK = threading.Lock()
    31	
    32	
    33	PATH_OK = re.compile(r"/(health|v1/[A-Za-z0-9/_.\-]+)")
    34	
    35	
    36	def phone_http(method: str, path: str, body: bytes | None):
    37	    """Run curl on the phone; returns (status, body bytes). The request path and method are interpolated into a
    38	    phone-side shell command, so both are allowlisted and the URL is shell-quoted (security review)."""
    39	    if method not in ("GET", "POST") or not PATH_OK.fullmatch(path):
    40	        return 400, json.dumps({"proxy_error": "method/path not allowed"}).encode()
    41	    url = shlex.quote(f"http://127.0.0.1:{int(a.phone_port)}{path}")
    42	    cmd = f"curl -s -m 1800 -o - -w '\\n%{{http_code}}' -X {method} -H 'Content-Type: application/json' "
    43	    cmd += ("--data-binary @- " if body else "") + url
    44	    r = subprocess.run(ADB + ["shell", "-T", cmd], input=body or b"", capture_output=True, timeout=2000)
    45	    out = r.stdout
    46	    head, _, code = out.rpartition(b"\n")
    47	    try:
    48	        return int(code.strip() or b"0"), head
    49	    except ValueError:
    50	        return 502, out
    51	
    52	
    53	class H(BaseHTTPRequestHandler):
    54	    def log_message(self, *args):
    55	        pass
    56	
    57	    def _handle(self, method):
    58	        n = int(self.headers.get("Content-Length") or 0)
    59	        data = self.rfile.read(n) if n else None
    60	        t0 = time.time()
    61	        try:
    62	            status, out = phone_http(method, self.path, data)
    63	        except Exception as e:
    64	            status, out = 502, json.dumps({"proxy_error": repr(e)}).encode()
    65	        t1 = time.time()
    66	        if self.path.startswith("/v1/chat/completions"):
    67	            try:
    68	                body = json.loads(data or b"{}")
    69	            except Exception:
    70	                body = {}
    71	            try:
    72	                resp = json.loads(out or b"{}")
    73	            except Exception:
    74	                resp = {"raw": out[:2000].decode(errors="replace")}
    75	            common.write(a.log, LOCK, {"t_start": t0, "t_end": t1, "latency_s": round(t1 - t0, 3), "device": a.device,
    76	                                       "model": a.model, "status": status, "transport": "adb-shell-curl",
    77	                                       "request": common.summarize(body), "response": resp})
    78	        self.send_response(status or 502)
    79	        self.send_header("Content-Type", "application/json")
    80	        self.send_header("Content-Length", str(len(out)))
    81	        self.end_headers()
    82	        self.wfile.write(out)
    83	
    84	    def do_POST(self):
    85	        self._handle("POST")
    86	
    87	    def do_GET(self):
    88	        self._handle("GET")
    89	
    90	
    91	ThreadingHTTPServer(("127.0.0.1", a.listen), H).serve_forever()
     1	"""Summarise the Qualcomm Device Cloud phone benchmark (SM8975 reference phone, Android 17, CPU, llama.cpp b12110).
