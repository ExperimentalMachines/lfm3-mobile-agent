(out/'changes.tsv').write_text(s)
rows=[l.split('\\t') for l in s.splitlines()]
renames={(r[1],r[2]) for r in rows if r[0].startswith('R')}
doc=Path('docs/repository.md').read_text()
appendix=doc.split('<summary>Every moved file (old → new)</summary>',1)[1].split('</details>',1)[0]
documented=set(re.findall(r'"'^'"\\| "'`([''^`]+)` '"\\| "'`([''^`]+)` '"\\|"'$'"',appendix,re.M))
cats=['analysis/','scripts/androidworld/','scripts/mobileworld/','scripts/training/jobs/','scripts/training/','scripts/speed/','scripts/publish/','docs/research/notes/','docs/research/','docs/','results/codex/']
counts=collections.Counter()
for old,new in renames:
 for c in cats:
  if new.startswith(c): counts[c]+=1; break
removed=doc.split('### Removed',1)[1].split('### Added',1)[0]
docremoved=re.findall(r'"'^'"\\| "'`([''^`]+)` '"\\|',removed,re.M)
deletions={r[1] for r in rows if r[0]=='D'}
result={'renames':len(renames),'appendix_entries':len(documented),'missing_from_appendix':sorted(renames-documented),'not_a_git_rename':sorted(documented-renames),'rename_counts_by_category':dict(counts),'removed_rows_not_deleted':sorted(set(docremoved)-deletions),'group_deletions':{p:len([n for n in deletions if n.startswith(p)]) for p in ['logs/','results/codex/datasets_scratch/','results/vm_backup/']},'status_counts':dict(collections.Counter(r[0][0] for r in rows))}
(out/'repository_tables.json').write_text(json.dumps(result,indent=2)+'\\n')
print(json.dumps(result,indent=2))
