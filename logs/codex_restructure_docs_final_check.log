  56: echo
  57: fail=0
  58: for f in "${OUTPUTS[@]}"; do git ls-files --error-unmatch -- "$f" > /dev/null 2>&1 || { echo "not committed: $f"; fail=1; }; done
  59: git diff --quiet HEAD -- "${OUTPUTS[@]}" || { echo "Differs from HEAD:"; git diff --stat HEAD -- "${OUTPUTS[@]}"; fail=1; }
  60: NEW=$(comm -13 <(echo "$BEFORE") <(untracked))
  61: [ -z "$NEW" ] || { echo "New files the scripts wrote under results/:"; echo "$NEW"; fail=1; }
  62: if [ $fail -eq 0 ]; then
  63:   echo "OK: all ${#OUTPUTS[@]} regenerated files are identical to the committed ones (HEAD), and no new file appeared."
  64: else
  65:   exit 1
  66: fi

FILE analysis/aw_dev_seed30.py
   1: """AndroidWorld development seed 30: score and in-run speed of every model, from the saved episode files.
   2: 
   3: Seed 30 was used to choose between versions (docs/PREREG_v4.md), so these are development numbers, not the held-out
   4: result (results/sealed_analysis_final.md). Per run: full successes (is_successful >= 1; exceptions count as failures),
   5: answer-task vs action-task successes (answer tasks: results/codex/v3_audit/answer_tasks.json), exceptions, median steps,
   6: and per-step model latency on the Apple M5 (llama.cpp Metal, measured inside the run while emulators and other servers
   7: were running) with median prompt/output tokens. Latest run directory of each model, as in the gate.
   8: (Moved here from the removed run-log generator, scripts/build_runs_registry.py, 2026-11-20; same computation.)
   9: Usage: .venv-aw/bin/python analysis/aw_dev_seed30.py  ->  results/androidworld/dev_seed30_summary.{json,md}
  10: """
  11: import glob
  12: import gzip
  13: import hashlib
  14: import json
  15: import pickle  # episode files are written by this repo's own AndroidWorld harness (trusted, not downloaded)
  16: import statistics as st
  17: 
  18: ANS = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"])
  19: TEMPLATES = {m["task_name"] for m in json.load(open("data/meta/androidworld_task_metadata.json"))}
  20: SUITE_SEED = 30
  21: 
  22: 
  23: def instance_seed(t, i=0):  # android_world suite_utils._get_instance_seed
  24:     return int(hashlib.sha256(f"{SUITE_SEED}_{t}_{i}".encode()).hexdigest(), 16) % (2 ** 32)
  25: RUNS = [  # (results/androidworld/<dir>, label, quantisation, expected agent_name)
  26:     ("lfm3vl2b_v4", "LFM3-VL-2B v4 (final)", "Q4_K_M", "lfm3vl2b_v4_q4km"),
  27:     ("maiui_2b_matched_q8_0", "MAI-UI-2B (1 screenshot)", "Q8_0", "maiui_2b_matched1img_q8_0"),
  28:     ("guiowl15_2b_matched", "GUI-Owl-1.5-2B (1 screenshot)", "Q4_K_M", "guiowl15_2b_matched1img_q4km"),
  29:     ("qwen35_2b_ft", "Qwen3.5-2B v1", "Q4_K_M", "qwen35_2b_ft_q4km"),
  30:     ("lfm3vl2b_ft", "LFM3-VL-2B v1", "Q4_K_M", "lfm3vl2b_ft_q4km"),
  31:     ("lfm3vl2b_v3", "LFM3-VL-2B v3", "Q4_K_M", "lfm3vl2b_v3_q4km"),
  32:     ("qwen35_08b_ft", "Qwen3.5-0.8B v1", "Q4_K_M", "qwen35_08b_ft_q4km"),
  33:     ("lfm3vl2b_ft_runtimefb", "LFM3-VL-2B v1 + runtime feedback (ablation)", "Q4_K_M", "lfm3vl2b_ft_q4km_runtimefb"),
  34:     ("lfm3vl2b_v2_forcethink", "LFM3-VL-2B v2 + forced intent (ablation)", "Q4_K_M", "lfm3vl2b_v2_q4km_forcethink"),
  35:     ("lfm3vl2b_v2", "LFM3-VL-2B v2", "Q4_K_M", "lfm3vl2b_v2_q4km"),
  36:     ("lfm25vl450m_ft", "LFM2.5-VL-450M v1", "Q4_K_M", "lfm25vl450m_ft_q4km"),
  37:     ("lfm3vl2b_base_nothink", "LFM3-VL-2B base (no thinking)", "Q4_K_M", "lfm3vl2b_base_nothink_q4km"),
  38:     ("lfm25vl450m_base", "LFM2.5-VL-450M base", "Q4_K_M", "lfm25vl450m_base_q4km"),
  39: ]
  40: 
  41: 
  42: def run(d, agent):
  43:     r = sorted(glob.glob(f"results/androidworld/{d}/run_*/"))[-1]
  44:     recs = [pickle.loads(gzip.decompress(open(f, "rb").read())) for f in sorted(glob.glob(r + "*.pkl.gz"))]
  45:     assert all(len(x) == 1 for x in recs), f"{d}: an episode file holds more than one record"
  46:     eps = [x[0] for x in recs]
  47:     # input checks: the 116 AndroidWorld templates once each, one agent, instance 0 of suite seed 30
  48:     names = [e["task_template"] for e in eps]
  49:     assert len(names) == len(set(names)) and set(names) == TEMPLATES, f"{d}: templates differ from task metadata"
  50:     assert {e.get("agent_name") for e in eps} == {agent}, f"{d}: agent is not {agent}"
  51:     for e in eps:
  52:         assert "instance_id" in e and e["instance_id"] == 0, f"{d}: {e['task_template']} is not instance 0"
  53:         # exception episodes store no seed; they are checked by template identity only
  54:         if e.get("exception_info") is None or "seed" in e:
  55:             assert e.get("seed") == instance_seed(e["task_template"]), f"{d}: {e['task_template']} not seed {SUITE_SEED}"
  56:     # success = checker score >= 1 and no exception (exceptions count as failures)
  57:     ok = lambda e: e.get("exception_info") is None and (lambda v: v is not None and v == v and v >= 1)(e.get("is_successful"))
  58:     lat, steps, P, G = [], [], [], []
  59:     for e in eps:
  60:         dd = e.get("episode_data")
  61:         if isinstance(dd, dict):
  62:             lat += [x for x in (dd.get("latency_s") or []) if isinstance(x, (int, float)) and x == x]
  63:             for u in dd.get("usage") or []:
  64:                 if isinstance(u, dict) and u.get("prompt_tokens"):
  65:                     P.append(u["prompt_tokens"]); G.append(u.get("completion_tokens", 0))
  66:         L = e.get("episode_length")
  67:         if isinstance(L, (int, float)) and L == L:
  68:             steps.append(L)
  69:     q = sorted(lat)
  70:     return {"run_dir": r, "agent": eps[0].get("agent_name"), "seed": eps[0].get("seed"), "episodes": len(eps),
  71:             "successes": sum(map(ok, eps)),
  72:             "answer_task_successes": sum(1 for e in eps if ok(e) and e["task_template"] in ANS),
  73:             "action_task_successes": sum(1 for e in eps if ok(e) and e["task_template"] not in ANS),
  74:             "exceptions": sum(1 for e in eps if e.get("exception_info") is not None),
  75:             "median_steps": int(st.median(steps)) if steps else None,
  76:             "steps_timed": len(lat), "step_latency_median_s": round(st.median(lat), 2) if lat else None,
  77:             "step_latency_p10_s": round(q[len(q) // 10], 2) if q else None,
  78:             "step_latency_p90_s": round(q[9 * len(q) // 10], 2) if q else None,
  79:             "prompt_tokens_median": int(st.median(P)) if P else None,
  80:             "output_tokens_median": int(st.median(G)) if G else None}
  81: 
  82: 
  83: rows = [{"id": d, "label": lab, "quant": qt, **run(d, ag)} for d, lab, qt, ag in RUNS]
  84: assert all(r["episodes"] == 116 for r in rows), [(r["id"], r["episodes"]) for r in rows if r["episodes"] != 116]
  85: json.dump(rows, open("results/androidworld/dev_seed30_summary.json", "w"), indent=1)
  86: L = ["# AndroidWorld development seed 30 (116 tasks; development numbers, not the held-out result)", "",
  87:      "| Model | Quant | Successes /116 | Answer tasks /25 | Action tasks /91 | Exceptions | Median steps | "
  88:      "M5 s/step, median (p10-p90) | Prompt tokens | Output tokens |",
  89:      "|---|---|---|---|---|---|---|---|---|---|"]
  90: for r in rows:
  91:     L.append(f"| {r['label']} | {r['quant']} | {r['successes']} | {r['answer_task_successes']} | "
  92:              f"{r['action_task_successes']} | {r['exceptions']} | {r['median_steps']} | {r['step_latency_median_s']} "
  93:              f"({r['step_latency_p10_s']}-{r['step_latency_p90_s']}) | {r['prompt_tokens_median']} | "
  94:              f"{r['output_tokens_median']} |")
  95: L += ["", "Full successes only (is_successful >= 1, no exception); exceptions count as failures. Latency = model time per step on an "
  96:       "Apple M5 (llama.cpp Metal), measured inside the run. Generated by analysis/aw_dev_seed30.py."]
  97: open("results/androidworld/dev_seed30_summary.md", "w").write("\n".join(L) + "\n")
  98: print("\n".join(L))

