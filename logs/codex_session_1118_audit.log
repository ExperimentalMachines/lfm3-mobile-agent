FILE eval/mobileworld/lfm3_mw_agent.py
   1: """LFM3 screen agent (our v1-v4 format) for MobileWorld (github.com/Tongyi-MAI/MobileWorld), GUI-only tasks.
   2: 
   3: Same model-side contract as the AndroidWorld agent (eval/androidworld/lfm_agent.py):
   4:   * one screenshot per step, resized with train/agent_format.resize_screenshot (MAX_PIXELS);
   5:   * system prompt agent_format.PROMPTS[prompt_version] and the user text from agent_format.user_text (goal + the last
   6:     HISTORY_STEPS (intent, action) pairs; v4 adds the installed-app list);
   7:   * llama-server /v1/chat/completions, temperature 0, thinking on, one parse retry; only the final action is parsed;
   8:   * point_2d on the 0-1000 grid -> screen pixels.
   9: Mapping to MobileWorld actions: status (complete or infeasible) -> `finished` (episode ends; MobileWorld scores the
  10: device/backend state), answer -> `answer` (MobileWorld ends the episode after an answer), everything else 1:1.
  11: Installed apps for v4: the names MobileWorld's open_app resolves (runtime/utils/models.APP_DICT, English names).
  12: Load with: mw eval --agent_type <this file> ... (MobileWorld's registry loads agent classes from a .py path).
  13: Env: LFM3_PROMPT_VERSION (v4 default), LFM3_AGENT_FORMAT_DIR (dir holding agent_format.py).
  14: """
  15: import base64
  16: import io
  17: import os
  18: import sys
  19: import time
  20: from typing import Any
  21: 
  22: import requests
  23: from loguru import logger
  24: 
  25: from mobile_world.agents.base import BaseAgent
  26: from mobile_world.runtime.utils.models import JSONAction
  27: 
  28: sys.path.insert(0, os.environ.get("LFM3_AGENT_FORMAT_DIR", os.path.dirname(os.path.abspath(__file__))))
  29: import agent_format as af  # noqa: E402
  30: 
  31: MW_APPS = ["Calendar", "Camera", "Chrome", "Clock", "Contacts", "Files", "Gallery", "Mail", "Maps", "Mastodon",
  32:            "Mattermost", "Settings", "SMS", "Taodian"]
  33: 
  34: 
  35: def _png_b64(img) -> str:
  36:     buf = io.BytesIO()
  37:     img.convert("RGB").save(buf, format="PNG")
  38:     return base64.b64encode(buf.getvalue()).decode()
  39: 
  40: 
  41: class LFM3MobileWorldAgent(BaseAgent):
  42:     def __init__(self, model_name: str = "local", llm_base_url: str = "http://127.0.0.1:8114", api_key: str = "",
  43:                  *args: Any, **kwargs: Any):
  44:         super().__init__()
  45:         base = (llm_base_url or "http://127.0.0.1:8114").rstrip("/")
  46:         self.server_url = base[:-3] if base.endswith("/v1") else base
  47:         self.model = model_name or "local"
  48:         self.prompt_version = os.environ.get("LFM3_PROMPT_VERSION", "v4")
  49:         assert self.prompt_version in af.PROMPTS, self.prompt_version
  50:         self.apps = MW_APPS if self.prompt_version == "v4" else None
  51:         self.history: list[tuple[str, str]] = []
  52:         self.max_parse_retries = 1
  53: 
  54:     def initialize_hook(self, instruction: str) -> None:
  55:         self.history = []
  56: 
  57:     def reset(self) -> None:
  58:         self.history = []
  59: 
  60:     def _query(self, goal: str, img) -> dict:
  61:         payload = {
  62:             "model": self.model,
  63:             "messages": [
  64:                 {"role": "system", "content": af.PROMPTS[self.prompt_version]},
  65:                 {"role": "user", "content": [
  66:                     {"type": "image_url", "image_url": {"url": "data:image/png;base64," + _png_b64(img)}},
  67:                     {"type": "text", "text": af.user_text(goal, self.history, apps=self.apps)},
  68:                 ]},
  69:             ],
  70:             "temperature": 0.0, "max_tokens": 512, "chat_template_kwargs": {"enable_thinking": True},
  71:         }
  72:         t0 = time.time()
  73:         r = requests.post(f"{self.server_url}/v1/chat/completions", json=payload, timeout=300)
  74:         r.raise_for_status()
  75:         out = r.json()
  76:         msg = out["choices"][0]["message"]
  77:         u = out.get("usage") or {}
  78:         self._total_prompt_tokens += u.get("prompt_tokens", 0) or 0
  79:         self._total_completion_tokens += u.get("completion_tokens", 0) or 0
  80:         return {"content": msg.get("content") or "", "reasoning": msg.get("reasoning_content") or "",
  81:                 "latency_s": time.time() - t0}
  82: 
  83:     def predict(self, observation: dict[str, Any]) -> tuple[str, JSONAction]:
  84:         shot = observation["screenshot"]
  85:         W, H = shot.size
  86:         img = af.resize_screenshot(shot, af.MAX_PIXELS)
  87:         resp, action = None, None
  88:         for _ in range(1 + self.max_parse_retries):
  89:             resp = self._query(self.instruction, img)
  90:             action = af.parse_action(resp["content"])
  91:             if action is not None:
  92:                 break
  93:         raw = f"<think>{resp['reasoning']}</think>{resp['content']}  [latency {resp['latency_s']:.1f}s]"
  94:         if action is None:
  95:             self.history.append(("(invalid output)", resp["content"][:80]))
  96:             logger.warning(f"unparseable output: {resp['content'][:200]}")
  97:             return raw, JSONAction(action_type="wait")  # same as AW: an invalid step consumes budget, no device action
  98:         reasoning = resp["reasoning"].strip()
  99:         intent = reasoning.splitlines()[0][:200] if reasoning else ""
 100:         self.history.append((intent, af.action_to_str(action)))
 101:         t = action["action_type"]
 102:         if t == "status":
 103:             return raw, JSONAction(action_type="finished", goal_status=action.get("goal_status"))
 104:         if t in af.POINT_TYPES:
 105:             x, y = af.norm_to_px(action["point_2d"], W, H)
 106:             return raw, JSONAction(action_type=t, x=x, y=y)
 107:         if t in ("input_text", "answer"):
 108:             return raw, JSONAction(action_type=t, text=action["text"])
 109:         if t == "scroll":
 110:             return raw, JSONAction(action_type="scroll", direction=action["direction"])
 111:         if t == "open_app":
 112:             return raw, JSONAction(action_type="open_app", app_name=action["app_name"])
 113:         return raw, JSONAction(action_type=t)  # navigate_back / navigate_home / keyboard_enter / wait

