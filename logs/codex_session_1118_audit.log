26: 
27: def _execute_single_task(
28:     env: AndroidEnvClient,
29:     agent: BaseAgent,
30:     task_name: str,
31:     max_step: int,
32:     traj_logger: TrajLogger,
33:     enable_mcp: bool = False,
34: ) -> tuple[int, float]:
35:     """Execute a single task and return the number of steps and score.
36: 
37:     Returns:
38:         tuple[int, float]: (number of steps, score)
39:     """
40: 
41:     logger.debug(f"max_step: {max_step}")
42: 
43:     if enable_mcp and not isinstance(agent, MCPAgent):
44:         logger.error(
45:             "MCP is enabled but agent type is not a MCP agent. Please use a MCP agent type."
46:         )
47: 
48:     if enable_mcp:
49:         traj_logger.log_tools(env.tools)
50:     task_goal = env.get_task_goal(task_type=task_name)
51: 
52:     logger.debug(f"task_goal: {task_goal}")
53: 
54:     step = 0
55:     obs = env.initialize_task(task_name=task_name)
56:     agent.initialize(task_goal)
57: 
58:     while True:
59:         step += 1
60: 
61:         logger.debug(f"Screenshot captured in step {step}")
62: 
63:         prediction, action = agent.predict(
64:             {
65:                 "screenshot": obs.screenshot,
66:                 "tool_call": obs.tool_call,
67:                 "ask_user_response": obs.ask_user_response,
68:             }
69:         )  # for backward compatibility
70:         traj_logger.log_traj(
71:             task_name,
72:             task_goal,
73:             step,
74:             prediction,
75:             action.model_dump(exclude_none=True),
76:             obs,
77:             agent.get_total_token_usage(),
78:         )
79:         if prediction is None:
80:             logger.warning(f"Agent prediction failed in step {step}")
81:             break
82: 
83:         terminate = False
84:         logger.debug(f"current step {step}")
85: 
86:         if action.action_type in [ENV_FAIL, FINISHED, UNKNOWN]:
87:             logger.debug(f"task terminated in step {step} with action {action.action_type}")
88:             terminate = True
89:         elif action.action_type in [ANSWER]:
90:             logger.debug(f"answer triggered, execution action {action}")
91:             obs = env.execute_action(action)
92:             terminate = True
93:         else:
94:             logger.debug(f"execution action {action}")
95:             obs = env.execute_action(action)
96:         if terminate:
97:             break
98: 
99:         if step >= max_step:
100:             logger.debug("task steps reach max step, terminate")
101:             break
102: 
103:     score, reason = env.get_task_score(task_type=task_name)
104:     logger.debug(f"task_score: {score}, reason: {reason}")
105:     traj_logger.log_score(score=score, reason=reason)
106: 
107:     res = env.tear_down_task(task_type=task_name)
108:     agent.done()
109:     logger.debug(f"tear_down_task response: {res}")
110: 
111:     return step, score
112: 
