   1: #!/bin/bash
   2: # Runs ON a Colab GPU VM: serve GUI-Owl-1.5-2B on :8092 and MAI-UI-2B on :8093 (same llama.cpp commit and server flags
   3: # as GUI-Owl's AndroidWorld runs on the Mac, plus -ngl 99; MAI-UI GGUFs converted the same way: Q4_K_M + Q8_0 mmproj)
   4: # and expose them to a MobileWorld env host through a reverse SSH tunnel (remote 18092 / 18093).
   5: # The tunnel key is restricted on the EC2 side to `restrict,port-forwarding,permitlisten="localhost:18092",
   6: # permitlisten="localhost:18093",command="/bin/false"` (no shell, two ports). The env host firewall (AWS security group / GCP firewall) must allow this VM's public IP on port 22.
   7: # Files expected in /content: models/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf, models/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf,
   8: # models/MAI-UI-2B-Q4_K_M.gguf, models/mmproj-MAI-UI-2B-Q8_0.gguf, tunnel_key. Usage (on the VM): EC2_IP=<ip> nohup bash colab_mw_models.sh > /content/mw_models.log 2>&1 &
   9: set -u
  10: cd /content
  11: EC2_IP=${EC2_IP:?}
  12: if [ ! -x llama.cpp/build/bin/llama-server ]; then
  13:   git clone -q --filter=blob:none https://github.com/ggml-org/llama.cpp.git && cd llama.cpp && git checkout -q cd959bae9 \
  14:     && cmake -B build -DGGML_CUDA=ON -DLLAMA_CURL=OFF -DCMAKE_CUDA_ARCHITECTURES=native > /dev/null \
  15:     && cmake --build build -j "$(nproc)" --target llama-server > build.log 2>&1; echo "BUILD_RC=$?"; cd /content
  16: fi
  17: nohup llama.cpp/build/bin/llama-server -m models/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf \
  18:   --mmproj models/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf -c 20480 -np 1 -ngl 99 --image-max-tokens 2600 --jinja \
  19:   --port 8092 --host 127.0.0.1 > guiowl_server.log 2>&1 &
  20: nohup llama.cpp/build/bin/llama-server -m models/MAI-UI-2B-Q4_K_M.gguf \
  21:   --mmproj models/mmproj-MAI-UI-2B-Q8_0.gguf -c 20480 -np 1 -ngl 99 --image-max-tokens 2600 --jinja \
  22:   --port 8093 --host 127.0.0.1 > maiui_server.log 2>&1 &
  23: until curl -s --max-time 5 127.0.0.1:8092/health | grep -q ok && curl -s --max-time 5 127.0.0.1:8093/health | grep -q ok; do sleep 3; done
  24: echo "[$(date +%T)] GUI-Owl (:8092) and MAI-UI (:8093) servers up"
  25: chmod 600 tunnel_key
  26: while true; do   # reconnect forever; the EC2 side only allows this one forward
  27:   ssh -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes -o BatchMode=yes -o ControlPath=none \
  28:       -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o ExitOnForwardFailure=yes \
  29:       -i tunnel_key -N -R 18092:127.0.0.1:8092 -R 18093:127.0.0.1:8093 "ubuntu@${EC2_IP}"
  30:   echo "[$(date +%T)] tunnel dropped (rc $?); reconnecting"; sleep 5
  31: done

