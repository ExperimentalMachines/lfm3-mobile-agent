  85: 
  86: def history_text(history: list[tuple[str, str]]) -> str:
  87:     """history: list of (intent, action_json_str), oldest first."""
  88:     if not history:
  89:         return "None"
  90:     start = max(0, len(history) - HISTORY_STEPS)
  91:     lines = []
  92:     for i, (intent, act) in enumerate(history[start:], start=start + 1):
  93:         lines.append(f"{i}. {intent} -> {act}" if intent else f"{i}. {act}")
  94:     return "\n".join(lines)
  95: 
  96: 
  97: def apps_line(apps: list[str]) -> str:
  98:     return "Installed apps: " + ", ".join(apps)
  99: 
 100: 
 101: def user_text(goal: str, history: list[tuple[str, str]], step_instruction: str | None = None,
 102:               apps: list[str] | None = None) -> str:
 103:     """apps=None -> v1-v3 format (no app line); apps=[...] -> v4 format (app line right after the goal)."""
 104:     s = f"Goal: {goal}\n" + (apps_line(apps) + "\n" if apps is not None else "") + f"Previous steps:\n{history_text(history)}"
 105:     if step_instruction:
 106:         s += f"\nCurrent step hint: {step_instruction}"
 107:     return s + "\nWhat is the next action?"
 108: 
 109: 
 110: def v4_app_list(key: str, required: list[str], pool: list[str]) -> list[str]:
 111:     """Training/offline-eval stand-in for a device's installed apps: the episode's own apps plus distractors from the
 112:     training app pool, 12-30 names, deterministic per episode key, sorted case-insensitively like the device list."""
 113:     rnd = random.Random(hashlib.sha256(key.encode()).hexdigest())
 114:     k = rnd.randint(12, 30)
 115:     apps = list(dict.fromkeys(a for a in required if a))
 116:     cand = sorted({p for p in pool if p and p not in apps})
 117:     rnd.shuffle(cand)
 118:     apps += cand[: max(0, k - len(apps))]
 119:     return sorted(apps, key=str.lower)
 120: 
 121: 
 122: def to_v4_messages(messages: list[dict], apps: list[str]) -> list[dict]:
 123:     """Rewrite stored v1-format [system, user, (assistant)] messages to the v4 prompt: SYSTEM_PROMPT_V4 and an
 124:     "Installed apps" line right after the goal line. Text-only contents (dataset rows)."""
 125:     sys_m, user_m = dict(messages[0]), dict(messages[1])
 126:     if sys_m["content"] != SYSTEM_PROMPT or not user_m["content"].startswith("Goal: ") or "\nInstalled apps: " in user_m["content"]:
 127:         raise ValueError("not a v1-format row")
 128:     goal_line, rest = user_m["content"].split("\n", 1)
 129:     if not rest.startswith("Previous steps:\n"):
 130:         raise ValueError("unexpected user text layout")
 131:     sys_m["content"] = SYSTEM_PROMPT_V4
 132:     user_m["content"] = goal_line + "\n" + apps_line(apps) + "\n" + rest
 133:     return [sys_m, user_m] + [dict(m) for m in messages[2:]]
