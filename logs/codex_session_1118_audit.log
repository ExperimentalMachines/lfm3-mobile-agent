338:                     api_key=api_key,
339:                     log_file_root=log_file_root,
340:                     max_step=max_step,
341:                     enable_mcp=enable_mcp,
342:                     **kwargs,
343:                 )
344:                 for task_name in pending_tasks
345:             )
346:         else:
347:             logger.info("Dry run mode, skipping task execution")
348:             task_results = []
349:             break
350: 
351:         # Identify failed tasks for potential retry
352:         failed_this_round = [
353:             task_name for task_name, task_result in zip(pending_tasks, task_results)
354:             if task_result is None
355:         ]
356: 
357:         logger.info(
358:             "Attempt {}/{} done: {} succeeded, {} failed/stale",
359:             attempt + 1, max_attempts,
360:             len(pending_tasks) - len(failed_this_round), len(failed_this_round),
361:         )
362: 
363:         if not failed_this_round or attempt >= max_attempts - 1:
364:             break
365: 
366:         logger.info("Auto-retrying {} failed tasks (retry {}/{})", len(failed_this_round), attempt + 1, auto_retry)
