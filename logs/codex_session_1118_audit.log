 101:   A shell "rm -f $D/$(basename $MF) $D/$(basename $PF)"
 102: done
 103: kill $SAMP 2>/dev/null
 104: log "WORKER DONE"

FILE scripts/qdc_chain.sh
   1: #!/bin/bash
   2: # QDC speed benchmark on one Snapdragon 8 Elite Extreme Gen 6 (SM8975) reference phone: pass 1 (v4, guiowl, maiui) then
   3: # pass 2 (maiui, guiowl, v4), 3 timed passes each, worker v5 (remote adb server via the SSH tunnel on $ADB_PORT).
   4: # Pulls leftovers and commits; the QDC session itself is left to the user. Usage: bash scripts/qdc_chain.sh <serial>
   5: cd "$(dirname "$0")/.."
   6: SER=$1; export ADB_PORT=${ADB_PORT:-15037}
   7: RUN=results/qdc/run_$(date +%Y%m%d_%H%M); mkdir -p $RUN; echo $RUN > logs/qdc_run.txt
   8: log() { echo "[$(date +%T)] $*"; }
   9: log "pass 1 (v4 guiowl maiui) -> $RUN/dev0"
  10: REPS=3 bash scripts/devstream_device_v5.sh "$SER" 0 $RUN/dev0 > $RUN/dev0_stdout.log 2>&1
  11: log "pass 2 (maiui guiowl v4) -> $RUN/dev0_pass2"
  12: REPS=3 ORDER_OVERRIDE="maiui guiowl v4" bash scripts/devstream_device_v5.sh "$SER" 0 $RUN/dev0_pass2 > $RUN/dev0_pass2_stdout.log 2>&1
  13: mkdir -p $RUN/phone_final; adb -P $ADB_PORT -s "$SER" shell "ls -la /data/local/tmp/lfm3bench" > $RUN/phone_final/ls.txt 2>&1
  14: for f in $(adb -P $ADB_PORT -s "$SER" shell "ls /data/local/tmp/lfm3bench/*.log" 2>/dev/null | tr -d '\r'); do adb -P $ADB_PORT -s "$SER" pull $f $RUN/phone_final/ > /dev/null 2>&1; done
  15: .venv-aw/bin/python scripts/devstream_report.py $RUN --md $RUN/speed_qdc.md --json $RUN/speed_qdc.json > /dev/null 2>&1
  16: git add $RUN; git commit -q -m "QDC speed benchmark (SM8975, Android 17; ABC/CBA, 3 timed passes each): $RUN
  17: 
  18: Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>" && log "committed $(git log --oneline -1)"
  19: log "QDC CHAIN DONE"

FILE scripts/qdc_tunnel_keeper.sh
   1: #!/bin/bash
   2: # Keep the QDC SSH tunnel (local 15037 -> the session's remote adb server 5037) alive while the benchmark runs; never
   3: # binds local 5037 (the shared adb server). Stops when logs/qdc_stop exists. Usage: bash scripts/qdc_tunnel_keeper.sh <key.pem> <remote-host>
   4: cd "$(dirname "$0")/.."
   5: K=$1; H=$2
   6: while [ ! -f logs/qdc_stop ]; do
   7:   if ! lsof -nP -iTCP:15037 -sTCP:LISTEN > /dev/null 2>&1; then
