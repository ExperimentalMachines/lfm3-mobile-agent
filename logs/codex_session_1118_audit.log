FILE eval/devicestream/record_proxy_adb.py
   1: """Recording proxy for a phone reached only through a REMOTE adb server (Qualcomm Device Cloud: `ssh -L <port>:<host>:5037`).
   2: 
   3: `adb forward` would open its listener on the remote adb server's host, not on this Mac, so each HTTP request is instead
   4: carried through `adb shell` into curl on the phone (`curl http://127.0.0.1:8080...`, request body on stdin, response
   5: on stdout). Same JSONL record as record_proxy.py (fsync per request): wall-clock latency (includes the tunnel), the
   6: request summary and the full response JSON with llama.cpp's on-phone `timings` (the primary speed numbers).
   7: Usage: python record_proxy_adb.py --listen 18301 --adb "adb -P 15037 -s SERIAL" --log out.jsonl --device D --model M
   8: """
   9: import argparse
  10: import json
  11: import os
  12: import re
  13: import shlex
  14: import subprocess
  15: import threading
  16: import time
  17: from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
  18: 
  19: import record_proxy_common as common
  20: 
  21: p = argparse.ArgumentParser()
  22: p.add_argument("--listen", type=int, required=True)
  23: p.add_argument("--adb", required=True)
  24: p.add_argument("--phone_port", type=int, default=8080)
  25: p.add_argument("--log", required=True)
  26: p.add_argument("--device", required=True)
  27: p.add_argument("--model", required=True)
  28: a = p.parse_args()
  29: ADB = shlex.split(a.adb)
  30: LOCK = threading.Lock()
  31: 
  32: 
  33: PATH_OK = re.compile(r"/(health|v1/[A-Za-z0-9/_.\-]+)")
  34: 
  35: 
  36: def phone_http(method: str, path: str, body: bytes | None):
  37:     """Run curl on the phone; returns (status, body bytes). The request path and method are interpolated into a
  38:     phone-side shell command, so both are allowlisted and the URL is shell-quoted (security review)."""
  39:     if method not in ("GET", "POST") or not PATH_OK.fullmatch(path):
  40:         return 400, json.dumps({"proxy_error": "method/path not allowed"}).encode()
  41:     url = shlex.quote(f"http://127.0.0.1:{int(a.phone_port)}{path}")
  42:     cmd = f"curl -s -m 1800 -o - -w '\\n%{{http_code}}' -X {method} -H 'Content-Type: application/json' "
  43:     cmd += ("--data-binary @- " if body else "") + url
  44:     r = subprocess.run(ADB + ["shell", "-T", cmd], input=body or b"", capture_output=True, timeout=2000)
  45:     out = r.stdout
  46:     head, _, code = out.rpartition(b"\n")
  47:     try:
  48:         return int(code.strip() or b"0"), head
  49:     except ValueError:
  50:         return 502, out
  51: 
  52: 
  53: class H(BaseHTTPRequestHandler):
  54:     def log_message(self, *args):
  55:         pass
  56: 
  57:     def _handle(self, method):
  58:         n = int(self.headers.get("Content-Length") or 0)
  59:         data = self.rfile.read(n) if n else None
  60:         t0 = time.time()
  61:         try:
  62:             status, out = phone_http(method, self.path, data)
  63:         except Exception as e:
  64:             status, out = 502, json.dumps({"proxy_error": repr(e)}).encode()
  65:         t1 = time.time()
  66:         if self.path.startswith("/v1/chat/completions"):
  67:             try:
  68:                 body = json.loads(data or b"{}")
  69:             except Exception:
  70:                 body = {}
  71:             try:
  72:                 resp = json.loads(out or b"{}")
  73:             except Exception:
  74:                 resp = {"raw": out[:2000].decode(errors="replace")}
  75:             common.write(a.log, LOCK, {"t_start": t0, "t_end": t1, "latency_s": round(t1 - t0, 3), "device": a.device,
  76:                                        "model": a.model, "status": status, "transport": "adb-shell-curl",
  77:                                        "request": common.summarize(body), "response": resp})
  78:         self.send_response(status or 502)
  79:         self.send_header("Content-Type", "application/json")
  80:         self.send_header("Content-Length", str(len(out)))
  81:         self.end_headers()
  82:         self.wfile.write(out)
  83: 
  84:     def do_POST(self):
  85:         self._handle("POST")
  86: 
  87:     def do_GET(self):
  88:         self._handle("GET")
  89: 
  90: 
  91: ThreadingHTTPServer(("127.0.0.1", a.listen), H).serve_forever()

FILE eval/devicestream/record_proxy_common.py
   1: """Shared pieces of the recording proxies: request summary (no image bytes; sha256 + size of each image) and fsync'ed
   2: JSONL append."""
   3: import base64
   4: import hashlib
   5: import io
   6: import json
   7: import os
   8: 
   9: 
  10: def summarize(body: dict) -> dict:
  11:     msgs = []
  12:     for m in body.get("messages", []):
  13:         parts = m["content"] if isinstance(m.get("content"), list) else [{"type": "text", "text": m.get("content") or ""}]
  14:         for c in parts:
  15:             if c.get("type") == "image_url":
  16:                 url = c["image_url"]["url"]
  17:                 raw = base64.b64decode(url.split(",", 1)[1]) if url.startswith("data:") else url.encode()
  18:                 try:
  19:                     from PIL import Image
  20:                     w, h = Image.open(io.BytesIO(raw)).size
  21:                 except Exception:
  22:                     w = h = None
  23:                 msgs.append({"role": m["role"], "image_sha256": hashlib.sha256(raw).hexdigest(), "bytes": len(raw), "w": w, "h": h})
  24:             else:
  25:                 t = c.get("text") or ""
  26:                 msgs.append({"role": m["role"], "text_len": len(t), "text_sha256": hashlib.sha256(t.encode()).hexdigest()[:16]})
  27:     return {"messages": msgs, **{k: v for k, v in body.items() if k != "messages"}}
  28: 
  29: 
  30: def write(path: str, lock, rec: dict):
  31:     line = json.dumps(rec) + "\n"
  32:     with lock:
  33:         with open(path, "a") as f:
  34:             f.write(line)
  35:             f.flush()
  36:             os.fsync(f.fileno())

FILE scripts/devstream_device_v5.sh
   1: #!/bin/bash
   2: # v5 (Qualcomm Device Cloud): the phone is reached through a REMOTE adb server (ssh -L 15037:<host>:5037), so every adb call
   3: # uses -P $ADB_PORT, and HTTP to the phone server goes through `adb shell` + curl on the phone (record_proxy_adb.py)
   4: # because `adb forward` would listen on the remote host. Otherwise identical to v4 (order, REPS, flags, data, checks).
   5: # One phone of the device-streaming speed benchmark (Firebase / Android Device Streaming, full crossover).
   6: # Phone IDX runs all three models in rotated order (IDX 0: v4, guiowl, maiui; IDX 1: guiowl, maiui, v4; IDX 2: maiui, v4,
   7: # guiowl), so every model is measured on every phone and in every position. Per model:
   8: #   files -> phone (signed GCS URL with curl/wget on the phone, else adb push) + sha256 check against the Mac's copy;
   9: #   llama.cpp b12110 Android arm64 `llama-server` ON THE PHONE (CPU, -t 4, -np 1, --cache-ram 0, model's eval flags);
  10: #   adb forward -> recording proxy (every request/response fsync'ed) -> eval/mobileworld/bench_speed.py (same agent code,
  11: #   same 5 screenshots/goals, 1 mirrored warm-up + 3 passes); server log pulled; files removed from the phone.
  12: # A thermal/CPU-frequency sampler logs the phone every 10 s. Nothing needed for the analysis stays only on the phone.
  13: # v3: the server is started by a Mac-side background `adb shell` (v1/v2 blocked forever: adb waits for the
  14: # phone process even with nohup &), closed after each model; llama.cpp setup skipped if already on the phone.
  15: # ORDER_OVERRIDE="maiui guiowl v4" sets the model order (pass 2 of the single-phone ABC/CBA design).
  16: # v4: REPS env (timed passes per model; default 3).
  17: # Usage: ADB_PORT=15037 bash scripts/devstream_device_v5.sh <adb-serial> <idx 0..2> <out-dir>
  18: set -u
  19: cd "$(dirname "$0")/.."
  20: SER=$1; IDX=$2; OUT=$3; mkdir -p "$OUT"
  21: ADB_PORT=${ADB_PORT:-15037}
  22: A() { adb -P "$ADB_PORT" -s "$SER" "$@"; }
  23: log() { echo "[$(date +%T)] dev$IDX $*" | tee -a "$OUT/worker.log"; }
  24: B=$(cat logs/devstream_bucket.txt); SA=lfm3-devstream-signer@voltaic-psyche-514908-s2.iam.gserviceaccount.com
  25: D=/data/local/tmp/lfm3bench
  26: SHOTS=/private/tmp/claude-501/-Users-alpha-lfm3-android/4efa3977-532d-411f-ad28-f4737438aa00/scratchpad/bench_shots
  27: AGENTS=eval/devicestream/agents
  28: PY=tools/MobileWorld/.venv/bin/python
  29: declare -a ORDER=(${ORDER_OVERRIDE:-v4 guiowl maiui})
  30: MODELS=(); for k in 0 1 2; do MODELS+=("${ORDER[$(( (IDX + k) % 3 ))]}"); done
  31: files_for() { case $1 in
  32:   v4) echo "models/lfm3vl2b_v4-GGUF/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf" ;;
  33:   guiowl) echo "models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf" ;;
  34:   maiui) echo "models/MAI-UI-2B-GGUF/MAI-UI-2B-Q4_K_M.gguf models/MAI-UI-2B-GGUF/mmproj-MAI-UI-2B-Q8_0.gguf" ;;
  35: esac; }
  36: flags_for() { case $1 in
  37:   v4) echo "-c 8192 --image-max-tokens 1024 --reasoning-format deepseek" ;;
  38:   *) echo "-c 20480 --image-max-tokens 2600 --jinja" ;;
  39: esac; }
  40: agent_for() { case $1 in v4) echo lfm3 ;; guiowl) echo guiowl ;; maiui) echo maiui ;; esac; }
  41: fetch() {  # local file -> $D/<basename>, verified
  42:   local f=$1 b; b=$(basename "$f")
  43:   local want; want=$(shasum -a 256 "$f" | cut -d' ' -f1)
  44:   local url; url=$(gcloud storage sign-url "$B/$b" --impersonate-service-account="$SA" --duration=2h --region=us-central1 --format="value(signed_url)" 2>/dev/null | tail -1)
  45:   if [ -n "$DL" ] && [ -n "$url" ]; then A shell "$DL '$D/$b' '$url'" > /dev/null 2>&1; fi
  46:   local got; got=$(A shell "sha256sum $D/$b 2>/dev/null" | cut -d' ' -f1)
  47:   if [ "$got" != "$want" ]; then
  48:     log "  $b: download ${DL:+failed/mismatch}${DL:-tool missing}; adb push"
  49:     A push "$f" "$D/$b" > /dev/null; got=$(A shell "sha256sum $D/$b" | cut -d' ' -f1)
  50:   fi
  51:   [ "$got" = "$want" ] || { log "  $b: SHA-256 MISMATCH on phone"; return 1; }
  52:   log "  $b verified ($want)"
  53: }
  54: # ---- phone metadata + runtime
  55: A shell "mkdir -p $D"
  56: { echo "{"; for k in ro.product.model ro.product.device ro.build.fingerprint ro.build.version.sdk ro.soc.model ro.soc.manufacturer; do
  57:     echo "\"$k\": \"$(A shell getprop $k | tr -d '\r')\","; done
  58:   echo "\"mem\": \"$(A shell 'grep MemTotal /proc/meminfo' | tr -s ' ' | tr -d '\r')\","
  59:   echo "\"cpus\": \"$(A shell 'cat /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq' | tr '\r\n' '  ')\","
  60:   echo "\"serial\": \"$SER\", \"idx\": $IDX, \"order\": \"${MODELS[*]}\"}"; } > "$OUT/device.json"
  61: log "phone: $(grep -o '"ro.product.model": "[^"]*"' "$OUT/device.json"), order ${MODELS[*]}"
  62: DL=""
  63: if A shell "command -v curl" | grep -q curl; then DL="curl -sfL -o"; elif A shell "command -v wget" | grep -q wget; then DL="wget -q -O"; fi
  64: log "on-phone downloader: ${DL:-none (adb push)}"
  65: if ! A shell "test -x $D/llama-b12110/llama-server && echo yes" | grep -q yes; then
  66:   fetch tools/llama-android/llama-b12110-bin-android-arm64.tar.gz || exit 1
  67:   A shell "cd $D && tar -xzf llama-b12110-bin-android-arm64.tar.gz && rm llama-b12110-bin-android-arm64.tar.gz && chmod 755 llama-b12110/*"
  68: fi
  69: A shell "cd $D/llama-b12110 && LD_LIBRARY_PATH=. ./llama-server --version" 2>&1 | tr -d '\r' | tee "$OUT/llama_version.txt" | tail -2
  70: grep -q cd959bae9 "$OUT/llama_version.txt" || { log "llama.cpp on the phone is not cd959bae9"; exit 1; }
  71: # ---- thermal / frequency sampler (Mac side; stops when the worker ends)
  72: ( while kill -0 $$ 2>/dev/null; do
  73:     t=$(date +%s); bt=$(A shell "dumpsys battery | grep temperature" 2>/dev/null | tr -dc '0-9')
  74:     ts=$(A shell "dumpsys thermalservice | grep -m1 'Thermal Status'" 2>/dev/null | tr -d '\r')
  75:     fq=$(A shell "cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq" 2>/dev/null | tr '\r\n' '  ')
  76:     echo "{\"t\": $t, \"battery_temp_dC\": \"$bt\", \"thermal\": \"$ts\", \"cur_freq_khz\": \"$fq\"}" >> "$OUT/thermal.jsonl"
  77:     sleep 10
  78:   done ) &
  79: SAMP=$!
  80: LPORT=$((18200 + IDX)); PPORT=$((18300 + IDX))
  81: for m in "${MODELS[@]}"; do
  82:   log "== $m"
  83:   set -- $(files_for $m); MF=$1; PF=$2
  84:   fetch "$MF" && fetch "$PF" || { log "$m: files not verified; skipping"; continue; }
  85:   A shell "cd $D/llama-b12110 && LD_LIBRARY_PATH=. exec ./llama-server -m $D/$(basename $MF) --mmproj $D/$(basename $PF) $(flags_for $m) -np 1 -t 4 --cache-ram 0 --host 127.0.0.1 --port 8080 > $D/server_$m.log 2>&1" < /dev/null > /dev/null 2>&1 &
  86:   SRVC=$!   # Mac-side adb client holding the phone server; ends when the server is killed below
  87:   t0=$(date +%s); ok=0
  88:   while [ $(( $(date +%s) - t0 )) -lt 600 ]; do A shell "curl -s -m 5 http://127.0.0.1:8080/health" 2>/dev/null | grep -q ok && { ok=1; break; }; sleep 3; done
  89:   [ $ok = 1 ] || { log "$m: server not healthy on the phone"; A pull $D/server_$m.log "$OUT/server_$m.log" > /dev/null 2>&1
  90:                    A shell "pkill -f llama-server" > /dev/null 2>&1; kill $SRVC 2>/dev/null; continue; }
  91:   log "$m: server up on the phone"
  92:   (cd eval/devicestream && ../../$PY record_proxy_adb.py --listen $PPORT --adb "adb -P $ADB_PORT -s $SER" --log "../../$OUT/requests_$m.jsonl" --device "qdc$IDX" --model $m) &
  93:   PROXY=$!; sleep 2
  94:   (cd tools/MobileWorld && .venv/bin/python ../../eval/mobileworld/bench_speed.py --agent $(agent_for $m) --url http://127.0.0.1:$PPORT/v1 \
  95:      --shots "$SHOTS" --reps ${REPS:-3} --out "../../$OUT/bench_$m.json" --jsonl "../../$OUT/bench_$m.jsonl" --mirror_warmup \
  96:      --agent_dir ../../$AGENTS) > "$OUT/client_$m.log" 2>&1
  97:   log "$m: bench exit $? ($(wc -l < "$OUT/requests_$m.jsonl" 2>/dev/null | tr -d ' ') recorded requests)"
  98:   A pull $D/server_$m.log "$OUT/server_$m.log" > /dev/null 2>&1
  99:   A shell "pkill -f llama-server" > /dev/null 2>&1; kill $PROXY 2>/dev/null; pkill -f "record_proxy_adb.py --listen $PPORT " 2>/dev/null
