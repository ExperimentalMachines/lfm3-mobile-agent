+def checked(p):
+    p = Path(p)
+    p = (ROOT / p if not p.is_absolute() else p).resolve()
+    assert not any(x == 'androidworld_sealed' or x == 'run_output.SEALED.log'
+                   or x.startswith(('aws_sealed_', 'local_sealed_', 'aw_sealed_')) for x in p.parts), p
+    return p
+
+
+def read(p):
+    p = checked(p)
