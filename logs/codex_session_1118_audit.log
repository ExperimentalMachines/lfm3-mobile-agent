86: class JSONAction(BaseModel):
87:     """Represents a parsed JSON action.
88: 
89:     Example:
90:         result_json = {'action_type': 'click', 'x': 100, 'y': 200}
91:         action = JSONAction(**result_json)
92: 
93:     Attributes:
94:         action_type: The action type.
95:         index: The index to click, if action is a click. Either an index or a <x, y>
96:             should be provided. See x, y attributes below.
97:         x: The x position to click, if the action is a click.
98:         y: The y position to click, if the action is a click.
99:         text: The text to type, if action is type.
100:         direction: The direction to scroll, if action is scroll.
101:         goal_status: If the status is a 'status' type, indicates the status of the goal.
102:         app_name: The app name to launch, if the action type is 'open_app'.
103:         keycode: Keycode actions are necessary for an agent to interact with complex
104:             UI elements (like large textareas) that can't be accessed or controlled by
105:             simply taping, ensuring precise control over navigation and selection in
106:             the interface.
107:         clear_text: Whether to clear the text field before typing.
108:         start_x: The x position to start drag, if the action is a drag.
109:         start_y: The y position to start drag, if the action is a drag.
110:         end_x: The x position to end drag, if the action is a drag.
111:         end_y: The y position to end drag, if the action is a drag.
112:     """
113: 
114:     action_type: str | None = None
115:     index: str | int | None = None
116:     x: int | None = None
117:     y: int | None = None
118:     text: str | None = None
119:     direction: str | None = None
120:     goal_status: str | None = None
121:     app_name: str | None = None
122:     keycode: str | None = None
123:     clear_text: bool | None = None
124:     start_x: int | None = None
125:     start_y: int | None = None
126:     end_x: int | None = None
127:     end_y: int | None = None
128:     action_name: str | None = None
129:     action_json: dict | None = None
130: 
131:     @field_validator("action_type")
132:     @classmethod
133:     def validate_action_type(cls, v: str | None) -> str | None:
134:         """Validate action type is valid."""
135:         if v is not None and v not in _ACTION_TYPES:
136:             raise ValueError(f"Invalid action type: {v}")
137:         return v
138: 
139:     @field_validator("index")
140:     @classmethod
141:     def validate_index(cls, v: str | int | None) -> int | None:
142:         """Convert index to int if needed."""
143:         if v is not None:
144:             return int(v)
145:         return v
146: 
147:     @field_validator("x", "y", mode="before")
148:     @classmethod
149:     def validate_coordinates(cls, v: int | float | None) -> int | None:
150:         """Convert float coordinates to int if needed."""
151:         if v is not None:
152:             return round(v)
153:         return v
154: 
155:     @field_validator("direction")
156:     @classmethod
157:     def validate_direction(cls, v: str | None) -> str | None:
158:         """Validate scroll direction is valid."""
159:         if v is not None and v not in _SCROLL_DIRECTIONS:
160:             raise ValueError(f"Invalid scroll direction: {v}")
161:         return v
162: 
163:     @field_validator("text", mode="before")
164:     @classmethod
165:     def validate_text(cls, v: Any) -> str | None:
166:         """Convert text to string if needed."""
167:         if v is not None and not isinstance(v, str):
168:             return str(v)
169:         return v
170: 
171:     @field_validator("keycode")
172:     @classmethod
173:     def validate_keycode(cls, v: str | None) -> str | None:
174:         """Validate keycode format."""
175:         if v is not None and not v.startswith("KEYCODE_"):
176:             raise ValueError(f"Invalid keycode: {v}")
177:         return v
178: 
179:     def model_post_init(self, __context: Any) -> None:
180:         """Additional validation after model initialization."""
181:         if self.index is not None:
182:             if self.x is not None or self.y is not None:
183:                 raise ValueError("Either an index or a <x, y> should be provided.")
184: 
185:     def __eq__(self, other: object) -> bool:
186:         """Compare two JSONActions."""
187:         if not isinstance(other, JSONAction):
188:             return False
189:         return _compare_actions(self, other)
190: 
191:     def __ne__(self, other: object) -> bool:
192:         """Check if two JSONActions are not equal."""
193:         return not self.__eq__(other)
194: 
195: 
196: def _compare_actions(a: JSONAction, b: JSONAction) -> bool:
197:     """Compares two JSONActions.
198: 
199:     Args:
200:         a: The first action.
201:         b: The second action.
202: 
203:     Returns:
204:         If the actions are equal.
205:     """
206:     # Ignore cases for app_name and text.
207:     if a.app_name is not None and b.app_name is not None:
208:         app_name_match = a.app_name.lower() == b.app_name.lower()
209:     else:
210:         app_name_match = a.app_name == b.app_name
211: 
212:     if a.text is not None and b.text is not None:
213:         text_match = a.text.lower() == b.text.lower()
214:     else:
215:         text_match = a.text == b.text
216: 
217:     # Compare the non-metadata fields.
218:     return (
219:         app_name_match
220:         and text_match
221:         and a.action_type == b.action_type
222:         and a.index == b.index
223:         and a.x == b.x
224:         and a.y == b.y
225:         and a.keycode == b.keycode
226:         and a.direction == b.direction
227:         and a.goal_status == b.goal_status
228:         and a.start_x == b.start_x
229:         and a.start_y == b.start_y
230:         and a.end_x == b.end_x
231:         and a.end_y == b.end_y
232:     )
