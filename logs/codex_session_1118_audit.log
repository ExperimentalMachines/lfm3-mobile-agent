 136: _APP_RE = re.compile(r'"app_name":"((?:[^"\\]|\\.)*)"')
 137: 
 138: 
 139: def apps_in_text(text: str) -> list[str]:
 140:     """open_app names mentioned in a history text (compact action JSON)."""
 141:     return [json.loads('"' + m + '"') for m in _APP_RE.findall(text or "")]
 142: 
