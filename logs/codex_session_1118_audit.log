+    READS[str(p)] = {'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}
+    return data
+
+
+def J(p):
+    return json.loads(read(p))
+
+
+def JL(p):
+    return [json.loads(x) for x in read(p).splitlines() if x.strip()]
