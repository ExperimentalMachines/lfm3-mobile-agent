 207:                 P.append(u["prompt_tokens"]); G.append(u.get("completion_tokens", 0))
 208:     if not L:
 209:         return None
 210:     q = sorted(L)
 211:     return {"episodes": n_eps, "steps": len(L), "median_s": round(st.median(L), 2), "p10_s": round(q[len(q) // 10], 2),
 212:             "p90_s": round(q[9 * len(q) // 10], 2), "prompt_tokens_median": int(st.median(P)) if P else None,
 213:             "output_tokens_median": int(st.median(G)) if G else None, "run_dir": runs[-1]}
