 165: 
 166: def parse_action(text: str, strict: bool = False) -> dict[str, Any] | None:
 167:     """Parse the model output (content after </think>, or the whole text) into an action dict.
 168:     Returns None when unparseable/invalid.
 169: 
 170:     strict=True : the answer must be exactly one JSON object with the documented keys
 171:                   (no aliases, no trailing junk, no coordinate clamping, explicit goal_status).
 172:     strict=False: lenient harness parsing used by the agent (first JSON object with an action,
 173:                   key aliases, clamping). Both are reported so leniency is visible."""
 174:     if text is None:
 175:         return None
 176:     if "</think>" in text:
 177:         text = text.split("</think>", 1)[1]
 178:     elif "<think>" in text:
 179:         return None  # unfinished reasoning: an action inside it is not a final answer
 180:     if strict:
 181:         def _no_dup(pairs):
 182:             keys = [k for k, _ in pairs]
 183:             if len(keys) != len(set(keys)):
 184:                 raise ValueError("duplicate key")
 185:             return dict(pairs)
 186: 
 187:         def _no_const(c):
 188:             raise ValueError("non-finite number")
 189:         try:
 190:             a = json.loads(text.strip(), object_pairs_hook=_no_dup, parse_constant=_no_const)
 191:         except Exception:
 192:             return None
 193:         if not isinstance(a, dict) or not isinstance(a.get("action_type"), str):
 194:             return None
 195:         return _validate_strict(a)
 196:     # first valid JSON object; tolerates trailing junk such as an extra "}" (common base-model quirk)
 197:     a = None
 198:     dec = json.JSONDecoder()
 199:     i = text.find("{")
 200:     while i != -1 and a is None:
 201:         try:
 202:             obj, _ = dec.raw_decode(text[i:])
 203:             if isinstance(obj, dict) and ("action_type" in obj or "action" in obj):
 204:                 a = obj
 205:         except json.JSONDecodeError:
 206:             pass
 207:         i = text.find("{", i + 1)
 208:     if not isinstance(a, dict):
 209:         return None
 210:     t = a.get("action_type") or a.get("action")
 211:     if not isinstance(t, str):
 212:         return None
 213:     if t == "type":
 214:         t = "input_text"
 215:     if t not in VALID_TYPES:
 216:         return None
 217:     a["action_type"] = t
 218:     if t in POINT_TYPES:
 219:         p = a.get("point_2d") or a.get("point") or a.get("coordinate")
 220:         if p is None and "x" in a and "y" in a:
 221:             p = [a["x"], a["y"]]
 222:         try:
 223:             p = [float(p[0]), float(p[1])]
 224:         except Exception:
 225:             return None
 226:         import math as _m
 227:         if not all(_m.isfinite(v) for v in p):
 228:             return None
 229:         a["point_2d"] = [min(max(p[0], 0), 1000), min(max(p[1], 0), 1000)]
 230:     elif t == "scroll":
 231:         if not isinstance(a.get("direction"), str) or a.get("direction") not in _DIRECTIONS:
 232:             return None
 233:     elif t in ("input_text", "answer"):
 234:         if not isinstance(a.get("text"), str):
 235:             return None
 236:     elif t == "open_app":
 237:         if not isinstance(a.get("app_name"), str):
 238:             alt = next((a[k] for k in ("label", "name", "text", "app") if isinstance(a.get(k), str)), None)
 239:             if alt is None:
 240:                 return None
 241:             a["app_name"] = alt  # lenient: base model sometimes puts the app in "label"
 242:     elif t == "status":
 243:         gs = a.get("goal_status")
 244:         if gs is not None and not isinstance(gs, str):
 245:             return None
 246:         if gs is None:
 247:             a["goal_status"] = "complete"  # lenient: omitted status means done
 248:         elif gs not in ("complete", "infeasible"):
 249:             return None
 250:     return a
