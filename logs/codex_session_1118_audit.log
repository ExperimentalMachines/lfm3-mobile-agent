125: def parsing_response_to_andoid_world_env_action(
126:     structured_response: dict, image_height: int, image_width: int
127: ) -> dict:
128:     """Convert a structured model response into an AndroidWorld environment action dict."""
129:     action_json = structured_response.get("action_json")
130:     action_type = action_json.get("action")
131: 
132:     result = {}
133: 
134:     if action_type == "type":
135:         result = {
136:             "action_type": GUIOWL2AW_ACTION_MAP["type"],
137:             "text": action_json.get("text", ""),
138:         }
139: 
140:     elif action_type == "swipe":
141:         start_box = action_json.get("coordinate")
142:         end_box = action_json.get("coordinate2")
143:         if start_box and end_box:
144:             x1, y1 = start_box
145:             x2, y2 = end_box
146:             result = {
147:                 "action_type": GUIOWL2AW_ACTION_MAP["swipe"],
148:                 "start_x": round(float(x1) * image_width),
149:                 "start_y": round(float(y1) * image_height),
150:                 "end_x": round(float(x2) * image_width),
151:                 "end_y": round(float(y2) * image_height),
152:             }
153:         else:
154:             raise ValueError("Invalid swipe: missing coordinate or coordinate2.")
155: 
156:     elif action_type in ("click", "long_press"):
157:         start_box = action_json.get("coordinate")
158:         if start_box:
159:             try:
160:                 if len(start_box) == 4:
161:                     x1, y1, x2, y2 = start_box
162:                 elif len(start_box) == 2:
163:                     x1, y1 = start_box
164:                     x2, y2 = x1, y1
165:                 else:
166:                     raise ValueError(f"Invalid coordinate format: {start_box}")
167:                 x = round(float((x1 + x2) / 2) * image_width)
168:                 y = round(float((y1 + y2) / 2) * image_height)
169:                 result = {
170:                     "action_type": GUIOWL2AW_ACTION_MAP[action_type],
171:                     "x": x,
172:                     "y": y,
173:                 }
174:             except Exception as e:
175:                 logger.error(f"Error parsing coordinates: {e}")
176:                 raise
177:         else:
178:             raise ValueError(f"Missing coordinate for action_type '{action_type}'.")
179: 
180:     elif action_type == "system_button":
181:         button = action_json.get("button", "").title()
182:         if button == "Home":
183:             result = {"action_type": GUIOWL2AW_ACTION_MAP["home"]}
184:         elif button == "Back":
185:             result = {"action_type": GUIOWL2AW_ACTION_MAP["back"]}
186:         elif button == "Enter":
187:             result = {"action_type": GUIOWL2AW_ACTION_MAP["enter"]}
188:         else:
189:             raise ValueError(f"Unsupported system_button: '{button}'.")
190: 
191:     elif action_type == "interact":
192:         result = {
193:             "action_type": GUIOWL2AW_ACTION_MAP["interact"],
194:             "text": action_json.get("text", ""),
195:         }
196: 
197:     elif action_type == "open":
198:         # Kept for backward compatibility; current prompt does not emit this action.
199:         result = {
200:             "action_type": "open_app",
201:             "app_name": action_json.get("text", ""),
202:         }
203: 
204:     elif action_type == "terminate":
205:         result = {
206:             "action_type": GUIOWL2AW_ACTION_MAP["terminate"],
207:             "text": action_json.get("status", ""),
208:         }
209: 
210:     elif action_type == "answer":
211:         result = {
212:             "action_type": GUIOWL2AW_ACTION_MAP["answer"],
213:             "text": action_json.get("text", ""),
214:         }
215: 
216:     elif action_type == "wait":
217:         result = {"action_type": GUIOWL2AW_ACTION_MAP["wait"]}
218: 
219:     else:
220:         raise ValueError(f"Unknown action_type: '{action_type}'.")
