 197:     files = glob.glob(runs[-1] + "*.pkl.gz")
 198:     n_eps = len(files)  # progress = episode files (exception episodes have no step data but still count)
 199:     for f in files:
 200:         e = pickle.loads(gzip.decompress(open(f, "rb").read()))[0]  # our own harness output (trusted)
 201:         dd = e.get("episode_data")
 202:         if not isinstance(dd, dict):
 203:             continue
 204:         L += [x for x in (dd.get("latency_s") or []) if isinstance(x, (int, float)) and x == x]
