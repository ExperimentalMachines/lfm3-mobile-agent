FILE eval/mobileworld/bench_speed.py
   1: """Per-step speed of the three 2B agents on identical inputs, through the same agent code used for evaluation.
   2: 
   3:   lfm3   : eval/mobileworld/lfm3_mw_agent.py (v4 prompt, one screenshot, af.MAX_PIXELS resize, thinking on)
   4:   guiowl : MobileWorld's official GUI-Owl-1.5 agent (history_n=1 default)
   5:   maiui  : MobileWorld's official MAI-UI agent with history_n=1 (eval/mobileworld/maiui_1img_agent.py)
   6: 
   7: Each call is the first step of a fresh episode on one of N real 1080x2400 MobileWorld screenshots with that task's real
   8: goal; one warm-up call is excluded. End-to-end latency = agent.predict() wall time (prompt building, image encoding to
   9: base64, HTTP, model, parsing). Server-side prompt/generation timings are read afterwards from the llama-server log
  10: (scripts/bench_speed.sh). Usage (MobileWorld venv):
  11:   python bench_speed.py --agent lfm3 --url http://127.0.0.1:8114/v1 --shots ~/bench/shots --reps 3 --out res.json
  12: """
  13: import argparse
  14: import glob
  15: import json
  16: import os
  17: import sys
  18: import time
  19: 
  20: from PIL import Image, ImageOps
  21: 
  22: p = argparse.ArgumentParser()
  23: p.add_argument("--agent", required=True, choices=["lfm3", "guiowl", "maiui"])
  24: p.add_argument("--url", required=True)
  25: p.add_argument("--shots", required=True)
  26: p.add_argument("--reps", type=int, default=3)
  27: p.add_argument("--out", required=True)
  28: p.add_argument("--jsonl", default="", help="also append each call to this file (fsync) as it completes")
  29: p.add_argument("--mirror_warmup", action="store_true",
  30:                help="warm up on a mirrored copy of the first screenshot so no timed call repeats the warm-up prompt")
  31: p.add_argument("--client_timeout", type=float, default=0,
  32:                help="if >0: OpenAI client timeout in seconds and max_retries=0 (slow phones; MobileWorld's default is 120 s with "
  33:                     "2 automatic re-sends, which queue duplicate requests on a single-slot server)")
  34: p.add_argument("--agent_dir", default="", help="directory holding lfm3_mw_agent.py / maiui_1img_agent.py / agent_format.py")
  35: a = p.parse_args()
  36: sys.path.insert(0, os.path.expanduser(a.agent_dir or "~/lfm3"))
  37: 
  38: from mobile_world.tasks.registry import TaskRegistry  # noqa: E402
  39: 
  40: reg = TaskRegistry()
  41: 
  42: 
  43: def make():
  44:     if a.agent == "lfm3":
  45:         from lfm3_mw_agent import LFM3MobileWorldAgent
  46:         return LFM3MobileWorldAgent(model_name="local", llm_base_url=a.url)
  47:     if a.agent == "guiowl":
  48:         from mobile_world.agents.implementations.gui_owl_1_5 import GUIOWL15AgentMCP
  49:         return GUIOWL15AgentMCP(model_name="GUI-Owl-1.5-2B", llm_base_url=a.url, tools=[])
  50:     from maiui_1img_agent import MAIUI1ImageAgent
  51:     return MAIUI1ImageAgent(llm_base_url=a.url, model_name="MAI-UI-2B")
  52: 
  53: 
  54: shots = sorted(glob.glob(os.path.join(os.path.expanduser(a.shots), "*.png")))
  55: cases = []
  56: for f in shots:
  57:     task = os.path.basename(f).split("-")[0]
  58:     cases.append((task, reg.get_task(task).goal, Image.open(f).convert("RGB")))
  59: rows = []
  60: for rep in range(a.reps + 1):  # rep 0 = warm-up (first case only)
  61:     for i, (task, goal, img) in enumerate(cases if rep else cases[:1]):
  62:         if rep == 0 and a.mirror_warmup:
  63:             img = ImageOps.mirror(img)
  64:         ag = make()
  65:         if a.client_timeout > 0 and getattr(ag, "openai_client", None) is not None:
  66:             ag.openai_client = ag.openai_client.with_options(timeout=a.client_timeout, max_retries=0)
  67:         ag.initialize(goal)
  68:         t0 = time.time()
  69:         res = ag.predict({"screenshot": img, "tool_call": None, "ask_user_response": None})
  70:         dt = time.time() - t0
  71:         action = res[-1]
  72:         raw = res[0] if isinstance(res[0], str) else str(res[0])
  73:         rows.append({"rep": rep, "task": task, "latency_s": round(dt, 3), "raw_chars": len(raw),
  74:                      "action": action.model_dump(exclude_none=True) if hasattr(action, "model_dump") else str(action)})
  75:         print(json.dumps(rows[-1])[:200], flush=True)
  76:         if a.jsonl:
  77:             with open(a.jsonl, "a") as fh:
  78:                 fh.write(json.dumps({"agent": a.agent, "t": time.time(), **rows[-1]}) + "\n")
  79:                 fh.flush()
  80:                 os.fsync(fh.fileno())
  81: json.dump({"agent": a.agent, "rows": rows}, open(a.out, "w"), indent=1)

FILE scripts/devstream_report.py
   1: """Summarise the device-streaming speed benchmark (one Pixel 9, Android 16; pass 1 = v4, guiowl, maiui x3 timed passes;
   2: pass 2 = maiui, guiowl, v4 x1). Source of truth = the recording proxy logs (requests_<model>.jsonl: phone-side llama.cpp
   3: timings per request); the first request of each model in each pass is the mirrored warm-up and is excluded.
   4: Usage: python scripts/devstream_report.py results/devstream/run_YYYYMMDD_HHMM [--md out.md] [--json out.json]"""
   5: import glob
   6: import json
   7: import os
   8: import statistics as st
   9: import sys
  10: 
  11: run = sys.argv[1]
  12: md = sys.argv[sys.argv.index("--md") + 1] if "--md" in sys.argv else None
  13: js = sys.argv[sys.argv.index("--json") + 1] if "--json" in sys.argv else None
  14: LAB = {"v4": "v4 (ours)", "guiowl": "GUI-Owl-1.5-2B", "maiui": "MAI-UI-2B"}
  15: FILES = {"v4": 1.30, "guiowl": 1.55, "maiui": 1.55}
  16: 
  17: 
  18: def rows(path):
  19:     out = [json.loads(l) for l in open(path)] if os.path.exists(path) else []
  20:     out = [r for r in out if r.get("status") == 200 and "timings" in (r.get("response") or {})]
  21:     return out[1:]  # drop the warm-up (mirrored screenshot)
  22: 
  23: 
  24: def thermal(passdir, t0, t1):
  25:     pts = [json.loads(l) for l in open(os.path.join(passdir, "thermal.jsonl"))] if os.path.exists(os.path.join(passdir, "thermal.jsonl")) else []
  26:     pts = [p for p in pts if t0 <= p["t"] <= t1]
  27:     temps = [int(p["battery_temp_dC"]) / 10 for p in pts if p.get("battery_temp_dC", "").isdigit()]
  28:     stat = [p["thermal"].split(":")[-1].strip() for p in pts if p.get("thermal")]
  29:     return {"battery_c_median": round(st.median(temps), 1) if temps else None, "battery_c_max": max(temps) if temps else None,
  30:             "thermal_status_max": max(stat) if stat else None}
  31: 
  32: 
  33: summary = {"run": run, "device": json.load(open(os.path.join(run, "dev0", "device.json"))) if os.path.exists(os.path.join(run, "dev0", "device.json")) else None,
  34:            "models": {}}
  35: for m in ("v4", "guiowl", "maiui"):
  36:     per = {}
  37:     allr = []
  38:     for pname, d in (("pass1", "dev0"), ("pass2", "dev0_pass2")):
  39:         rr = rows(os.path.join(run, d, f"requests_{m}.jsonl"))
  40:         if not rr:
  41:             continue
  42:         allr += rr
  43:         T = [r["response"]["timings"] for r in rr]
  44:         per[pname] = {"n": len(rr), "latency_median_s": round(st.median(r["latency_s"] for r in rr), 2),
  45:                       "prompt_s_median": round(st.median(t["prompt_ms"] for t in T) / 1000, 2),
  46:                       **thermal(os.path.join(run, d), rr[0]["t_start"], rr[-1]["t_end"])}
  47:     if not allr:
  48:         continue
  49:     T = [r["response"]["timings"] for r in allr]
  50:     lat = [r["latency_s"] for r in allr]
  51:     summary["models"][m] = {
  52:         "label": LAB[m], "n": len(allr), "latency_median_s": round(st.median(lat), 1),
  53:         "latency_min_max_s": [round(min(lat), 1), round(max(lat), 1)],
  54:         "prompt_tokens_median": int(st.median(t["prompt_n"] + t.get("cache_n", 0) for t in T)),
  55:         "prompt_processed_median": int(st.median(t["prompt_n"] for t in T)),
  56:         "prompt_s_median": round(st.median(t["prompt_ms"] for t in T) / 1000, 1),
  57:         "prompt_tok_per_s": round(sum(t["prompt_n"] for t in T) / (sum(t["prompt_ms"] for t in T) / 1000), 1),
  58:         "gen_tokens_median": int(st.median(t["predicted_n"] for t in T)),
  59:         "gen_tok_per_s": round(sum(t["predicted_n"] for t in T) / (sum(t["predicted_ms"] for t in T) / 1000), 1),
  60:         "files_gb": FILES[m], "passes": per}
  61: print(json.dumps(summary["models"], indent=1))
  62: if js:
  63:     json.dump(summary, open(js, "w"), indent=1)
  64: if md:
  65:     with open(md, "w") as f:
  66:         f.write("| Model | Seconds per step (median) | Prompt tokens | Prompt time | Prompt tokens/s | Output tokens | Output tokens/s | Model files |\n"
  67:                 "|---|---|---|---|---|---|---|---|\n")
  68:         for m, o in summary["models"].items():
  69:             b = "**" if m == "v4" else ""
  70:             f.write(f"| {b}{o['label']}{b} | {b}{o['latency_median_s']}{b} ({o['latency_min_max_s'][0]}–{o['latency_min_max_s'][1]}) | "
  71:                     f"{o['prompt_tokens_median']:,} | {o['prompt_s_median']} s | {o['prompt_tok_per_s']:.0f} | {o['gen_tokens_median']} | "
  72:                     f"{o['gen_tok_per_s']:.0f} | {o['files_gb']:.2f} GB |\n")
  73:         f.write("\nPer pass (pass 1 = v4 → GUI-Owl → MAI-UI, 3 timed passes; pass 2 = MAI-UI → GUI-Owl → v4, 1 timed pass):\n\n"
  74:                 "| Model | Pass | Calls | Seconds per step (median) | Prompt time (median) | Battery °C (median / max) | Max thermal status |\n|---|---|---|---|---|---|---|\n")
  75:         for m, o in summary["models"].items():
  76:             for pname, p in o["passes"].items():
  77:                 f.write(f"| {o['label']} | {pname} | {p['n']} | {p['latency_median_s']} | {p['prompt_s_median']} s | "
  78:                         f"{p['battery_c_median']} / {p['battery_c_max']} | {p['thermal_status_max']} |\n")

