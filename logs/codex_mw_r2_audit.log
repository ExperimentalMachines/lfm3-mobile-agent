   292	        for env_url in aw_urls
   293	    )
   294	
   295	    if len(tasks) != 0:
   296	        task_list = tasks
   297	    else:
   298	        task_list = envs[0].get_suite_task_list(enable_mcp=enable_mcp, enable_user_interaction=enable_user_interaction)
   299	
   300	    logger.info("Task list: {} ({} tasks)", task_list, len(task_list))
   301	
   302	    num_envs = len(envs)
   303	    max_attempts = min(1 + auto_retry, 10)  # Cap at 10 to prevent infinite loops
   304	
   305	    for attempt in range(max_attempts):
   306	        # Scan finished tasks each iteration (picks up results from previous attempts)
   307	        finished_task_list, finished_scores = scan_finished_tasks(log_file_root, task_list)
   308	        logger.info("Finished task list: {} ({} tasks)", finished_task_list, len(finished_task_list))
   309	
   310	        pending_tasks = [task for task in task_list if task not in finished_task_list]
   311	        logger.info(
   312	            "Attempt {}/{}: {} remaining tasks to execute",
   313	            attempt + 1, max_attempts, len(pending_tasks),
   314	        )
   315	
   316	        if not pending_tasks:
   317	            logger.info("All tasks finished, no retry needed")
   318	            break
   319	
   320	        env_queue = Queue[tuple[AndroidEnvClient, str | None]](maxsize=num_envs)
   321	        for i, env in enumerate(envs):
   322	            env_queue.put((env, container_names[i] if container_names else None))
   323	
   324	        if shuffle_tasks:
   325	            random.shuffle(pending_tasks)
   326	
   327	        if not dry_run:
   328	            task_results = Parallel(
   329	                n_jobs=min(max_concurrency if max_concurrency is not None else num_envs, num_envs),
   330	                backend="threading",
   331	            )(
   332	                delayed(_process_task_on_env)(
   333	                    task_name=task_name,
   334	                    env_queue=env_queue,
   335	                    agent_type=agent_type,
   336	                    model_name=model_name,
   337	                    llm_base_url=llm_base_url,
   338	                    api_key=api_key,
   339	                    log_file_root=log_file_root,
   340	                    max_step=max_step,
   341	                    enable_mcp=enable_mcp,
   342	                    **kwargs,
   343	                )
   344	                for task_name in pending_tasks
   345	            )
   346	        else:
   347	            logger.info("Dry run mode, skipping task execution")
   348	            task_results = []
   349	            break
   350	
   351	        # Identify failed tasks for potential retry
   352	        failed_this_round = [
   353	            task_name for task_name, task_result in zip(pending_tasks, task_results)
   354	            if task_result is None
   355	        ]
   356	
   357	        logger.info(
   358	            "Attempt {}/{} done: {} succeeded, {} failed/stale",
   359	            attempt + 1, max_attempts,
   360	            len(pending_tasks) - len(failed_this_round), len(failed_this_round),
   361	        )
   362	
   363	        if not failed_this_round or attempt >= max_attempts - 1:
   364	            break
   365	
   366	        logger.info("Auto-retrying {} failed tasks (retry {}/{})", len(failed_this_round), attempt + 1, auto_retry)
   367	
   368	    # Final scan to get all finished results (including from retries)
   369	    finished_task_list, finished_scores = scan_finished_tasks(log_file_root, task_list)
   370	    # Build final results from scan (authoritative source)
   371	    success_task_results = []
   372	    for task_name, score in zip(finished_task_list, finished_scores):
   373	        success_task_results.append({"task_name": task_name, "score": score})
   374	
   375	    task_list_with_no_results = [task for task in task_list if task not in finished_task_list]
   376	    logger.info(f"Final: {len(success_task_results)} tasks with results, {len(task_list_with_no_results)} with no results")
   377	
   378	    return (success_task_results, task_list_with_no_results)
