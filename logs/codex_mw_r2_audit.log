   144	def build_messages(goal, history, image=None, step_instruction=None, for_trl=False, prompt_version="v1", apps=None):
   145	    """Messages for apply_chat_template. With for_trl=True the image is NOT inlined
   146	    (TRL prepends the dataset's `images` column to the first user message)."""
   147	    if (prompt_version == "v4") != (apps is not None):
