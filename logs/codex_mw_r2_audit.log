   200	    def _hide_history_images(self, messages: list[dict]) -> list[dict]:
   201	        """
   202	        Limit the number of images sent to the model by removing older image messages.
   203	        Keep only the most recent history_n images.
   204	
   205	        Args:
   206	            messages: List of message dicts
   207	
   208	        Returns:
   209	            Modified messages with limited images
   210	        """
   211	        # Collect indices of messages that contain images (from back to front)
   212	        image_message_indices = []
   213	        for i in range(len(messages) - 1, -1, -1):
   214	            if (
   215	                messages[i]["role"] == "user"
   216	                and len(messages[i]["content"]) > 0
   217	                and messages[i]["content"][0]["type"] == "image_url"
   218	            ):
   219	                image_message_indices.append(i)
   220	
   221	        indices_to_remove = sorted(image_message_indices[self.history_n :], reverse=True)
   222	
   223	        for idx in indices_to_remove:
   224	            del messages[idx]
   225	
   226	        return messages
