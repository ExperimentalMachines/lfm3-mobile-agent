     1	"""Run IN the Colab MobileWorld model session (colab exec -s mwgpu < this file). Prepares MAI-UI-2B Q8_0 for its
     2	MobileWorld run: reassembles the uploaded 50 MB parts (/content/q8p/p_*), checks SHA-256 against the Mac's file, stops
     3	the two servers that are no longer needed (MAI-UI Q4_K_M on :8093 and v4 on :8094, matched by their exact model file;
     4	GUI-Owl on :8092 is left alone), and starts two identical MAI-UI Q8_0 servers on :8093 and :8094 with the flags of
     5	MAI-UI's AndroidWorld arm (scripts/local_maiui_aw.sh) plus --cache-ram 0 as on the GUI-Owl MobileWorld server.
     6	The existing reverse tunnel (tunnel_loop.sh) already forwards 18093 -> :8093 and 18094 -> :8094 on the env host.
     7	Set DRY = True to only print what would be stopped.
     8	"""
     9	import glob
    10	import hashlib
    11	import os
    12	import signal
    13	import subprocess
    14	import time
    15	import urllib.request
    16	
    17	DRY = False
    18	SHA = "5bc5ca6886c4b9ef1c76e9a911f1ac0b1ce807d12c1127c8c106c01fae363eaa"
    19	DST = "/content/models/MAI-UI-2B-Q8_0.gguf"
    20	os.chdir("/content")
    21	if not os.path.exists(DST):
    22	    parts = sorted(glob.glob("/content/q8p/p_*"))
    23	    print(len(parts), "parts")
    24	    with open(DST + ".tmp", "wb") as out:
    25	        for p in parts:
    26	            out.write(open(p, "rb").read())
    27	    os.rename(DST + ".tmp", DST)
    28	h = hashlib.sha256()
    29	with open(DST, "rb") as f:
    30	    for b in iter(lambda: f.read(1 << 24), b""):
    31	        h.update(b)
    32	assert h.hexdigest() == SHA, ("SHA-256 mismatch", h.hexdigest())
    33	print("Q8_0 file OK", os.path.getsize(DST))
    34	
    35	STOP = ("models/MAI-UI-2B-Q4_K_M.gguf", "models/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf")
    36	victims = []
    37	for p in glob.glob("/proc/[0-9]*/cmdline"):
    38	    try:
    39	        cmd = open(p, "rb").read().replace(b"\0", b" ").decode()
    40	    except OSError:
    41	        continue
    42	    if "llama-server" in cmd.split(" ")[0] and any(f"-m {m} " in cmd for m in STOP):
    43	        victims.append((int(p.split("/")[2]), cmd[:160]))
    44	print("stop:", victims)
    45	if DRY:
    46	    raise SystemExit
    47	for pid, _ in victims:
    48	    os.kill(pid, signal.SIGTERM)
    49	time.sleep(8)
    50	FLAGS = ["-m", "models/MAI-UI-2B-Q8_0.gguf", "--mmproj", "models/mmproj-MAI-UI-2B-Q8_0.gguf", "-c", "20480", "-np", "1",
    51	         "-ngl", "99", "--image-max-tokens", "2600", "--jinja", "--cache-ram", "0", "--host", "127.0.0.1"]
    52	for port in (8093, 8094):
    53	    subprocess.Popen(["llama.cpp/build/bin/llama-server", *FLAGS, "--port", str(port)],
    54	                     stdout=open(f"/content/maiui_q8_{port}.log", "w"), stderr=subprocess.STDOUT, start_new_session=True)
