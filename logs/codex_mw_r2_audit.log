    16	S() { ssh -o ConnectTimeout=15 -o BatchMode=yes -i "$PEM" "ubuntu@${IP}" "$@"; }
    17	status() { gcloud compute instances describe "$NAME" --zone "$ZONE" --format="value(status)" 2>/dev/null; }
    18	ctr() { [ "$1" = maiui_a ] && echo mobile_world_env_0 || echo lfmenv_0; }
    19	port() { [ "$1" = maiui_a ] && echo 18093 || echo 18094; }
    20	ep() { [ "$1" = maiui_a ] && echo mobile_world_env || echo lfmenv; }
    21	wait_ready() {  # $1 = half; container healthy + its model tunnel answering, up to 20 min
    22	  local t0=$(date +%s) c; c=$(ctr "$1")
    23	  until S "[ \"\$(sudo docker inspect -f '{{.State.Health.Status}}' $c)\" = healthy ] && curl -s -m 5 localhost:$(port "$1")/health | grep -q ok" 2>/dev/null; do
    24	    [ $(( $(date +%s) - t0 )) -gt 1200 ] && { log "$1: not ready after 20 min"; return 1; }
