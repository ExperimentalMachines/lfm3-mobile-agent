    99	            point_y = (y1 + y2) / 2
   100	        else:
   101	            raise ValueError(f"Unexpected coordinate length: {coordinates}")
   102	        action["coordinate"] = [point_x / SCALE_FACTOR, point_y / SCALE_FACTOR]
   103	
