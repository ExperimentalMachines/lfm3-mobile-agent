    55	def load_agent_from_file(file_path: str) -> type[BaseAgent]:
    56	    """Load an agent class from a Python file.
    57	
    58	    Args:
    59	        file_path: Path to the Python file containing the agent class
    60	
    61	    Returns:
    62	        The agent class that inherits from BaseAgent
    63	
    64	    Raises:
    65	        ValueError: If no agent class is found or multiple are found
    66	        FileNotFoundError: If the file doesn't exist
    67	    """
    68	    file_path = os.path.abspath(file_path)
    69	
    70	    if not os.path.exists(file_path):
    71	        raise FileNotFoundError(f"Agent file not found: {file_path}")
    72	
    73	    if not file_path.endswith(".py"):
    74	        raise ValueError(f"Agent file must be a Python file (.py): {file_path}")
    75	
    76	    # Load the module from file
    77	    module_name = Path(file_path).stem
    78	    spec = importlib.util.spec_from_file_location(module_name, file_path)
    79	
    80	    if spec is None or spec.loader is None:
    81	        raise ValueError(f"Could not load module from {file_path}")
    82	
    83	    module = importlib.util.module_from_spec(spec)
    84	    sys.modules[module_name] = module
    85	    spec.loader.exec_module(module)
    86	
    87	    # Find all classes that inherit from BaseAgent
    88	    agent_classes = []
    89	    for name, obj in inspect.getmembers(module, inspect.isclass):
    90	        # Check if it's a subclass of BaseAgent but not BaseAgent itself
    91	        if issubclass(obj, BaseAgent) and obj is not BaseAgent:
    92	            agent_classes.append((name, obj))
    93	
    94	    if len(agent_classes) == 0:
    95	        raise ValueError(f"No class inheriting from BaseAgent found in {file_path}")
    96	
    97	    if len(agent_classes) > 1:
    98	        class_names = [name for name, _ in agent_classes]
    99	        logger.warning(
   100	            f"Multiple agent classes found in {file_path}: {class_names}. Using the first one: {class_names[0]}"
   101	        )
   102	
   103	    agent_name, agent_class = agent_classes[0]
   104	    logger.info(f"Loaded agent class '{agent_name}' from {file_path}")
   105	
   106	    return agent_class
   107	
   108	
   109	def create_agent(
   110	    agent_type: str, model_name: str, llm_base_url: str, api_key: str = "empty", **kwargs
   111	):
   112	    """Create an agent instance based on the agent type.
   113	
   114	    Args:
   115	        agent_type: Either a registered agent type name or path to a Python file containing an agent class
   116	        model_name: Name of the model to use
   117	        llm_base_url: Base URL for the LLM service
   118	        api_key: API key for the LLM service
   119	        **kwargs: Additional keyword arguments to pass to the agent
   120	
   121	    Returns:
   122	        An instance of the agent
   123	    """
   124	    if agent_type.endswith(".py") or os.path.exists(agent_type):
   125	        agent_class = load_agent_from_file(agent_type)
   126	        try:
   127	            return agent_class(
   128	                model_name=model_name,
   129	                llm_base_url=llm_base_url,
   130	                api_key=api_key,
   131	                **kwargs,
   132	            )
   133	        except Exception as e:
   134	            raise ValueError(f"Error creating agent: {e}")
   135	
   136	    # Otherwise, use the registry
   137	    if agent_type not in AGENT_CONFIGS:
   138	        raise ValueError(f"Unsupported agent type: {agent_type}")
   139	
   140	    return AGENT_CONFIGS[agent_type]["class"](
   141	        model_name=model_name,
   142	        llm_base_url=llm_base_url,
   143	        tools=kwargs["env"].tools,
   144	        api_key=api_key,
   145	        **kwargs,
   146	    )
