    25	def parse_tagged_text(text: str) -> dict:
    26	    """
    27	    Parse model output text into structured components.
    28	
    29	    Expected format:
    30	        <thinking content>
    31	        Action: "<conclusion>"
    32	        <tool_call>
    33	        {"name": ..., "arguments": ...}
    34	        </tool_call>
    35	
    36	    Returns a dict with keys: thinking, conclusion, tool_call.
    37	    """
    38	    result = {"thinking": None, "conclusion": None, "tool_call": None}
    39	
    40	    action_parts = text.split("Action:")
    41	    if len(action_parts) > 1:
    42	        result["thinking"] = action_parts[0].strip()
    43	        action_content = action_parts[1]
    44	    else:
    45	        # No "Action:" tag found; treat entire text as action content
    46	        action_content = text
    47	
    48	    # Parse conclusion and tool_call from action content
    49	    tool_parts = action_content.split("<tool_call>")
    50	    if len(tool_parts) > 1:
    51	        conclusion_content = tool_parts[0].strip()
    52	        # Strip surrounding quotes if present
    53	        if conclusion_content.startswith('"') and conclusion_content.endswith('"'):
    54	            conclusion_content = conclusion_content[1:-1]
    55	        result["conclusion"] = conclusion_content
    56	
    57	        tool_call_raw = tool_parts[1].split("</tool_call>")[0].strip()
    58	        try:
    59	            result["tool_call"] = json.loads(tool_call_raw)
    60	        except json.JSONDecodeError as e:
    61	            raise ValueError(f"Failed to parse tool_call JSON: {e}")
    62	
    63	    return result
