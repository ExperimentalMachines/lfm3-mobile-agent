   233	class GUIOWL15AgentMCP(MCPAgent):
   234	    def __init__(
   235	        self,
   236	        model_name: str,
   237	        llm_base_url: str,
   238	        api_key: str = "empty",
   239	        observation_type: str = "screenshot",
   240	        runtime_conf: dict = {
   241	            "history_n": 1,
   242	            "max_tokens": 2048,
   243	            "temperature": 0.0,
   244	            "top_p": 1.0,
   245	        },
   246	        *args,
   247	        **kwargs,
   248	    ):
   249	        super().__init__(*args, **kwargs)
   250	        self.model_name = model_name
   251	        logger.info(f"Running Task with policy model name: {model_name}")
   252	        self.llm_base_url = llm_base_url
   253	        self.observation_type = observation_type
   254	        self.runtime_conf = runtime_conf
   255	        self.build_openai_client(self.llm_base_url, api_key)
   256	
   257	        # Per-task state (reset between tasks)
   258	        self.thoughts: list[str] = []
   259	        self.actions: list[dict] = []
   260	        self.conclusions: list[str] = []
   261	        self.history_images: list[str] = []          # base64-encoded strings
   262	        self.history_responses: list[str] = []       # raw assistant text (excludes current)
   263	        self.history_user_content: list[tuple] = []  # (encoded_string, tool_call, ask_user_response)
   264	
   265	        # Frequently used hyper-parameters
   266	        self.temperature = self.runtime_conf.pop("temperature", 0.0)
   267	        self.top_p = self.runtime_conf.pop("top_p", 1.0)
   268	        self.max_tokens = self.runtime_conf.pop("max_tokens", 2048)
   269	        self.history_n = self.runtime_conf.pop("history_n", 1)
   270	        self.is_memory_mode = self.runtime_conf.pop("is_memory_mode", False)
   271	
   272	    # ------------------------------------------------------------------
   273	    # Internal helpers
   274	    # ------------------------------------------------------------------
   275	
   276	    def _get_user_message(
   277	        self,
   278	        encoded_string: str,
   279	        tool_call_res: str | None,
   280	        ask_user_response_res: str | None,
   281	    ) -> dict:
   282	        """
   283	        Build an OpenAI user message that wraps a tool response and a screenshot.
   284	        """
   285	        user_content = [
   286	            {"type": "text", "text": "<tool_response>\n"},
   287	        ]
   288	
   289	        if tool_call_res is not None:
   290	            user_content.append({"type": "text", "text": str(tool_call_res)})
   291	        elif ask_user_response_res is not None:
   292	            user_content.append(
   293	                {
   294	                    "type": "text",
   295	                    "text": f"(Ask_user_response){ask_user_response_res}",
   296	                }
   297	            )
   298	        else:
   299	            user_content.append({"type": "text", "text": "None"})
   300	
   301	        user_content.append(_make_image_content(encoded_string))
   302	        user_content.append({"type": "text", "text": "\n</tool_response>"})
   303	
   304	        return {"role": "user", "content": user_content}
   305	
   306	    def _format_previous_steps(self, start_idx: int, end_idx: int) -> str:
   307	        """
   308	        Render history steps [start_idx, end_idx) as plain text.
   309	
   310	        Each line follows the pattern:
   311	            Step<N>: <conclusion>  Tool response: <tool_response>
   312	        """
   313	        previous_steps = []
   314	        for i in range(start_idx, end_idx):
   315	            step_num = i + 1
   316	            conclusion = add_period_robustly(self.conclusions[i])
   317	            step_info = f"Step{step_num}: {conclusion}"
   318	
   319	            tool_call_res = (
   320	                self.history_user_content[i][1]
   321	                if i < len(self.history_user_content)
   322	                else None
   323	            )
   324	            ask_user_res = (
   325	                self.history_user_content[i][2]
   326	                if i < len(self.history_user_content)
   327	                else None
   328	            )
   329	
   330	            if tool_call_res is not None:
   331	                step_info += f" Tool response: {tool_call_res}"
   332	            elif ask_user_res is not None:
   333	                step_info += f" Tool response: (Ask_user_response){ask_user_res}"
   334	            else:
   335	                step_info += " Tool response: None"
   336	
   337	            previous_steps.append(step_info)
   338	
   339	        return "\n".join(previous_steps)
   340	
   341	    # ------------------------------------------------------------------
   342	    # Main prediction method
   343	    # ------------------------------------------------------------------
   344	
   345	    def predict(
   346	        self, observation: dict[str, Any]
   347	    ) -> tuple[list, str, str, str, str, JSONAction]:
   348	        """Predict the next action based on the current observation."""
   349	
   350	        assert len(self.actions) == len(self.thoughts) == len(self.conclusions), (
   351	            "Mismatch between actions, thoughts, and conclusions counts."
   352	        )
   353	
   354	        # ── Encode current screenshot ──────────────────────────────────
   355	        obs_image = observation["screenshot"]
   356	        encoded_string: str = pil_to_base64(obs_image)
   357	
   358	        tool_call = observation.get("tool_call", None)
   359	        ask_user_response = observation.get("ask_user_response", None)
   360	
   361	        # Store current observation (encoded_string, tool_call, ask_user_response)
   362	        self.history_images.append(encoded_string)
   363	        self.history_user_content.append((encoded_string, tool_call, ask_user_response))
   364	
   365	        logger.debug(f"History images count:    {len(self.history_images)}")
   366	        logger.debug(f"History responses count: {len(self.history_responses)}")
   367	
   368	        assert len(self.history_images) == len(self.history_responses) + 1, (
   369	            "history_images should always be exactly one ahead of history_responses."
   370	        )
   371	
   372	        # ── System prompt ──────────────────────────────────────────────
   373	        system_prompt = GUI_OWL_1_5_SYSTEM_PROMPT_TEMPLATE.render(
   374	            tools="\n".join(
   375	                [json.dumps(tool, ensure_ascii=False) for tool in self.tools]
   376	            )
   377	        )
   378	
   379	        # ── History windowing ──────────────────────────────────────────
   380	        # total_history_count: number of completed assistant turns (excludes current)
   381	        total_history_count = len(self.history_responses)
   382	
   383	        # keep_as_messages: how many recent turns to keep as real user-assistant message pairs
   384	        # history_n includes the current observation, so pairs = history_n - 1
   385	        keep_as_messages = min(self.history_n - 1, total_history_count)
   386	
   387	        # text_history_count: older turns that are collapsed into plain text
   388	        text_history_count = total_history_count - keep_as_messages
   389	
   390	        # ── Build message list ─────────────────────────────────────────
   391	        messages = [
   392	            {
   393	                "role": "system",
   394	                "content": system_prompt,
   395	            }
   396	        ]
   397	
   398	        # ── First user message ─────────────────────────────────────────
   399	        first_user_content = []
   400	
   401	        if text_history_count > 0:
   402	            # Prepend collapsed history as plain text
   403	            previous_steps_text = self._format_previous_steps(0, text_history_count)
   404	            first_user_content.append(
   405	                {
   406	                    "type": "text",
   407	                    "text": GUI_OWL_1_5_USER_PROMPT_WITH_HISTSTEPS_TEMPLATE.format(
   408	                        instruction=self.instruction,
   409	                        previous_steps=previous_steps_text,
   410	                    ),
   411	                }
   412	            )
   413	        else:
   414	            first_user_content.append(
   415	                {
   416	                    "type": "text",
   417	                    "text": GUI_OWL_1_5_USER_PROMPT_TEMPLATE.format(
   418	                        instruction=self.instruction
   419	                    ),
   420	                }
   421	            )
   422	
   423	        # The first screenshot that is kept as an image is at index text_history_count.
   424	        # For the very first turn (text_history_count == 0) this is simply index 0.
   425	        # Note: the first observation in the kept window has no preceding tool response,
   426	        # so we only attach the screenshot here (tool_call / ask_user_response are
   427	        # carried by the *next* user message that follows the assistant reply).
   428	        first_img_encoded, _, _ = self.history_user_content[text_history_count]
   429	        first_user_content.append(_make_image_content(first_img_encoded))
   430	
   431	        messages.append({"role": "user", "content": first_user_content})
   432	
   433	        # ── Interleaved assistant / user messages ──────────────────────
   434	        # Iterate over the completed turns that we keep as real messages.
   435	        # Index i refers to the i-th completed assistant turn (0-based).
   436	        for i in range(text_history_count, total_history_count):
   437	            # Assistant reply for turn i
   438	            history_resp = self.history_responses[i]
   439	            messages.append(
   440	                {
   441	                    "role": "assistant",
   442	                    "content": [{"type": "text", "text": history_resp.strip()}],
   443	                }
   444	            )
   445	
   446	            # User message for turn i+1 (tool response + screenshot)
   447	            next_img_idx = i + 1
   448	            if next_img_idx < len(self.history_user_content):
   449	                next_encoded, tool_call_res, ask_user_response_res = (
   450	                    self.history_user_content[next_img_idx]
   451	                )
   452	                messages.append(
   453	                    self._get_user_message(
   454	                        next_encoded, tool_call_res, ask_user_response_res
   455	                    )
   456	                )
   457	
   458	        logger.debug(
   459	            f"Constructed messages: {keep_as_messages} user-assistant pair(s) "
   460	            f"with images, {text_history_count} text-only history step(s)."
   461	        )
   462	        pretty_print_messages(messages, max_messages=4)
   463	        logger.debug("*" * 100)
   464	
   465	        # ── LLM inference with retry ───────────────────────────────────
   466	        origin_h, origin_w = obs_image.height, obs_image.width
   467	        parsed_response = None
   468	        prediction = None
   469	        max_retries = 5
   470	
   471	        for attempt in range(1, max_retries + 1):
   472	            prediction = self.openai_chat_completions_create(
   473	                model=self.model_name,
   474	                messages=messages,
   475	                retry_times=3,
   476	                temperature=self.temperature,
   477	                top_p=self.top_p,
   478	                max_tokens=self.max_tokens,
   479	                **self.runtime_conf,
   480	            )
   481	            logger.info(f"Raw prediction (attempt {attempt}):\n{prediction}")
   482	
   483	            if prediction is None:
   484	                raise RuntimeError("Received None response from the LLM client.")
   485	
   486	            try:
