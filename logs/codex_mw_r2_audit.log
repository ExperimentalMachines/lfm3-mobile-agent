     2	# Pull MobileWorld run 2 (GUI-Owl and v4 on the GCP env host) to results/mobileworld/traj_r2/ (git-ignored):
     3	# every attempt folder (final, MobileWorld's own *_backup_* retries, and folders moved aside by mw_resume.sh), the retry
     4	# manifests and the start/end stamps. --full also copies screenshots (needed for the trajectory review; ~6 GB).
     5	# Usage: bash scripts/mw_pull_r2.sh [--full]
     6	set -eu
     7	cd "$(dirname "$0")/.."
     8	source logs/gcp_mw_instance.env
     9	DST=results/mobileworld/traj_r2
    10	mkdir -p "$DST"
    11	EX=(--exclude screenshots --exclude marked_screenshots)
    12	[ "${1:-}" = --full ] && EX=()
    13	rsync -a ${EX[@]+"${EX[@]}"} -e "ssh -o ConnectTimeout=15 -o BatchMode=yes -i $PEM" \
    14	  "ubuntu@${IP}:traj_logs/guiowl_gui_en_r2" "ubuntu@${IP}:traj_logs/v4_gui_en_r2" "ubuntu@${IP}:traj_logs/_interrupted" "$DST/"
    15	rsync -a -e "ssh -o ConnectTimeout=15 -o BatchMode=yes -i $PEM" \
    16	  --include '_retry_manifest_*.jsonl' --exclude '*' "ubuntu@${IP}:traj_logs/" "$DST/"
    17	for f in go_r2.start go_r2.end v4_r2.start v4_r2.end guiowl_resume.start v4_resume.start guiowl_complete v4_complete; do
    18	  scp -q -o BatchMode=yes -i "$PEM" "ubuntu@${IP}:$f" "$DST/$f" 2>/dev/null || true
