    69	def action_to_str(a: dict[str, Any]) -> str:
    70	    """Canonical compact JSON for an action (stable key order, no spaces)."""
    71	    t = a["action_type"]
    72	    out: dict[str, Any] = {"action_type": t}
    73	    if t in POINT_TYPES:
    74	        out["point_2d"] = [int(a["point_2d"][0]), int(a["point_2d"][1])]
    75	    elif t in ("input_text", "answer"):
    76	        out["text"] = a["text"]
    77	    elif t == "scroll":
    78	        out["direction"] = a["direction"]
    79	    elif t == "open_app":
    80	        out["app_name"] = a["app_name"]
    81	    elif t == "status":
    82	        out["goal_status"] = a.get("goal_status", "complete")
    83	    return json.dumps(out, ensure_ascii=False, separators=(",", ":"))
