+        'log':str(ROOT/f'results/mobileworld/traj_r2/{run}_gui_en_r2'),
+        'tasks':list(r['runs'][run]['tasks']),
+        'moved_root':str(ROOT/f'results/mobileworld/traj_r2/_interrupted/{run}')}
+    with contextlib.redirect_stdout(io.StringIO()) as cap:
+        exec(compile(ast.Module(body=planner_nodes,type_ignores=[]),'<dry planner AST>','exec'),ns)
+    plans[run]=json.loads(cap.getvalue())
+assert plans['v4']['todo']==[]
+assert plans['guiowl']['todo']==['ThanksgivingPrepTask']
+report['snapshot_resume_plan']=plans
+
+# Faithful isolated reproduction of the fail-open completion pipeline; no watcher run.
+line=next(x for x in resume_text.splitlines() if x.startswith('LEFT='))
+line=line.replace('bash "$0" "$RUN" --dry-run','failed_dry_run')
+sh='set -u\nfailed_dry_run() { return 2; }\n'+line+'\n[ "$LEFT" -eq 0 ] && printf "FALSE_COMPLETION\\n"\n'
+proc=subprocess.run(['/bin/bash','-c',sh],cwd=OUT,text=True,capture_output=True)
+assert proc.stdout.strip()=='FALSE_COMPLETION'
+report['failed_planner_pipeline']={'producer_exit':2,'pipeline_exit':proc.returncode,'output':proc.stdout.strip()}
+
+# Verify the checked-in per-half command regexes without calling pgrep.
+pattern_a=r'mw eval.*--env_prefix mobile_world_env --log_file_root /home/ubuntu/traj_logs/maiui_gui_en_r2'
+pattern_b=r'mw eval.*--env_prefix lfmenv --log_file_root /home/ubuntu/traj_logs/maiui_gui_en_r2'
+cmd_a='uv run mw eval --agent_type /home/ubuntu/lfm3/maiui_mw_agent.py --env_prefix mobile_world_env --log_file_root /home/ubuntu/traj_logs/maiui_gui_en_r2 --task taskA'
+cmd_b=cmd_a.replace('mobile_world_env --log_file_root','lfmenv --log_file_root')
+assert re.search(pattern_a,cmd_a) and not re.search(pattern_a,cmd_b)
+assert re.search(pattern_b,cmd_b) and not re.search(pattern_b,cmd_a)
+tasks=json.loads((ROOT/'results/mobileworld/mw_gui_en.json').read_text())
+assert not set(tasks[0::2]) & set(tasks[1::2])
+report['mai_split']={'halves':[len(tasks[0::2]),len(tasks[1::2])], 'disjoint':True,
+                     'regex_cross_matches':False, 'scan_filters_exact_task_names':True}
+
+# Swap predicate: the exact relative '-m' spelling is required by the current code.
+stop=('models/MAI-UI-2B-Q4_K_M.gguf','models/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf')
+def selected_for_stop(cmd):
+    return 'llama-server' in cmd.split(' ')[0] and any(f'-m {m} ' in cmd for m in stop)
+relative='llama.cpp/build/bin/llama-server -m models/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf --port 8094 '
+absolute=relative.replace('-m models/','-m /content/models/')
+longflag=relative.replace(' -m ',' --model ')
+assert selected_for_stop(relative) and not selected_for_stop(absolute) and not selected_for_stop(longflag)
+report['swap_identity_guard']={'relative_path_selected':True,'absolute_path_selected':False,
+    'long_model_flag_selected':False,'generic_old_model_health_passes':b'ok' in b'{"status":"ok"}',
+    'limit':'Demonstrates unguarded failure path; does not assert a live server mismatch.'}
+
+(OUT/'offline_checks.json').write_text(json.dumps(report,indent=2)+'\n')
+import hashlib
+source_paths=[ROOT/'scripts/mw_summarize_r2.py', ROOT/'scripts/gcp_mw_resume_vm.sh',
+              ROOT/'scripts/gcp_mw_resume_watch.sh', ROOT/'scripts/gcp_mw_maiui_watch.sh',
+              ROOT/'scripts/colab_mw_maiui_q8.py',ROOT/'scripts/colab_mw_models.sh',ROOT/'scripts/mw_pull_r2.sh',
+              ROOT/'eval/mobileworld/lfm3_mw_agent.py',ROOT/'eval/mobileworld/maiui_mw_agent.py',
+              ROOT/'train/agent_format.py',ROOT/'docs/PREREG_v4.md',
+              MW/'agents/base.py',MW/'agents/registry.py',MW/'agents/implementations/gui_owl_1_5.py',
+              MW/'agents/implementations/mai_ui_agent.py',MW/'core/runner.py',MW/'core/server.py',
+              MW/'core/subcommands/eval.py',MW/'runtime/client.py',MW/'runtime/controller.py',
+              MW/'runtime/utils/models.py',MW/'runtime/utils/trajectory_logger.py']
+(OUT/'source_manifest.json').write_text(json.dumps({str(p.relative_to(ROOT)):hashlib.sha256(p.read_bytes()).hexdigest()
+                                                 for p in source_paths},indent=2)+'\n')
+print(json.dumps(report,indent=2))
diff --git a/results/codex/mw_r2_audit/recompute.py b/results/codex/mw_r2_audit/recompute.py
new file mode 100644
index 0000000000000000000000000000000000000000..0181531106878d0e5fc6ae2a4ab6ac3a05d9c1c8
--- /dev/null
+++ b/results/codex/mw_r2_audit/recompute.py
@@ -0,0 +1,177 @@
+"""Offline audit: read only the specified MW snapshot; write only beside this file.
+
+No imports from the production summarizer or MobileWorld, no network/process control.
+Run: python3 -B results/codex/mw_r2_audit/recompute.py
+"""
+from pathlib import Path
+from collections import Counter
+from fractions import Fraction
+import csv
+import hashlib
+import json
+import math
+import re
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[2]
+RAW = ROOT / 'results/mobileworld/traj_r2'
+reads = {}
+
+def read(p):
+    data = p.read_bytes()
+    reads[str(p.relative_to(ROOT))] = {'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data)}
+    return data.decode(errors='replace')
+
+def get_score(folder):
+    p = folder / 'result.txt'
+    if not p.is_file():
+        return None
+    # Strict first-line parsing, independently of mw_summarize_r2.py's regex.
+    lines = read(p).splitlines()
+    assert len(lines) >= 2 and lines[0].startswith('score: '), str(p)
+    score = float(lines[0].removeprefix('score: '))
+    assert score in (0.0, 1.0), (str(p), score)
+    return score
+
+def error(folder):
+    files = sorted(folder.glob('*.log'))
+    text = ''.join(read(p) for p in files)
+    terminal = text.rpartition('Error executing task')[2]
+    if not terminal:
+        return 'interrupted', text
+    # End-of-attempt exception signatures, not earlier warning/error messages.
+    if 'Failed to initialize task' in terminal:
+        return 'setup_failed', text
+    if 'Failed to get task score' in terminal:
+        return 'scoring_failed', text
+    if 'Unknown action_type' in terminal:
+        return 'unsupported_action', text
+    if 'error_env' in terminal or 'Failed to parse tool_call' in terminal:
+        return 'invalid_model_output', text
+    if 'Step action failed' in terminal and 'API key' in terminal:
+        return 'ask_user_without_simulator', text
+    return 'other_error', text
+
+tasks = json.loads(read(ROOT / 'results/mobileworld/mw_gui_en.json'))
+assert len(tasks) == len(set(tasks)) == 105
+env_categories = {'setup_failed', 'scoring_failed'}
+rows, runs = [], {}
+for run in ('v4', 'guiowl'):
+    base = RAW / (run + '_gui_en_r2')
+    bytask = {}
+    assigned = set()
+    for t in tasks:
+        final = base / t
+        assert final.is_dir(), str(final)
+        backups = sorted(base.glob(t + '_backup_*'))
+        moved = sorted((RAW / '_interrupted' / run).glob(t + '_2*'))
+        attempts = []
+        for kind, folders in (('auto_retry', backups), ('moved', moved), ('final', [final])):
+            for folder in folders:
+                assigned.add(folder)
+                score = get_score(folder)
+                category, txt = error(folder)
+                category = 'result' if score is not None else category
+                trajpath = folder / 'traj.json'
+                traj = json.loads(read(trajpath)) if trajpath.exists() else {}
+                steps = traj.get('0', {}).get('traj', [])
+                inner = {p.name: json.loads(read(p)) for p in sorted(folder.glob('traj_backup_*.json'))}
+                assert all(x == {} for x in inner.values()), (folder, 'nonempty inner retry')
+                a = {'folder': str(folder.relative_to(ROOT)), 'kind': kind,
+                     'score': score, 'category': category, 'steps': len(steps),
+                     'last_action': steps[-1]['action'] if steps else None,
+                     'log_files': len(list(folder.glob('*.log'))),
+                     'terminal_error_markers': txt.count('Error executing task'),
+                     'device_unhealthy_retries': txt.count('Device is not healthy, retrying'),
+                     'internal_empty_trajectory_backups': list(inner),
+                     'non_200_step_responses': re.findall(r'execute_action response: \{\s*"status": (?!200)(\d+)', txt),
+                     'api_error_warnings': txt.count('Error calling OpenAI API:'),
+                     'timeout_markers': len(re.findall(r'Timeout|timed out|timedout', txt)),
+                     'synthetic_enters': sum(s['prediction'].startswith('(adapter) keyboard_enter') for s in steps),
+                     'input_texts': sum(s['action']['action_type'] == 'input_text' for s in steps),
+                     'drag_actions': sum(s['action']['action_type'] == 'drag' for s in steps),
+                     'invalid_output_waits': sum('unparseable output:' in line for line in txt.splitlines()),
+                     'action_counts': dict(Counter(s['action']['action_type'] for s in steps)),
+                     'token_usage': traj.get('0', {}).get('token_usage')}
+                attempts.append(a)
+        nonfinal = attempts[:-1]
+        f = attempts[-1]
+        bytask[t] = {'score': f['score'] or 0, 'has_result': f['score'] is not None,
+                     'final_category': f['category'], 'attempts': attempts}
+        rows.append({'run': run, 'task': t, 'score': f['score'] if f['score'] is not None else 0,
+                     'has_result': f['score'] is not None, 'category': f['category'],
+                     'attempts': len(attempts), 'steps': f['steps'], 'synthetic_enters': f['synthetic_enters'],
+                     'final_folder': f['folder']})
+    allfolders = {p for p in base.iterdir() if p.is_dir()}
+    allfolders |= {p for p in (RAW / '_interrupted' / run).glob('*') if p.is_dir()}
+    assert allfolders == assigned, sorted(str(p) for p in allfolders ^ assigned)
+    allatts = [a for t in bytask.values() for a in t['attempts']]
+    earlier = [a for a in allatts if a['kind'] != 'final']
+    successes = [t for t in tasks if bytask[t]['score'] == 1]
+    env_tasks = [t for t in tasks if any(a['category'] in env_categories for a in bytask[t]['attempts'])]
+    runs[run] = {'n_tasks': len(bytask), 'with_result': sum(x['has_result'] for x in bytask.values()),
+                 'successes': successes, 'success_rate': len(successes) / len(tasks),
+                 'no_result': {t: x['final_category'] for t, x in bytask.items() if not x['has_result']},
+                 'total_attempts': len(allatts), 'extra_attempts': len(earlier),
+                 'multi_attempt_tasks': [t for t, x in bytask.items() if len(x['attempts']) > 1],
+                 'earlier_categories': dict(Counter(a['category'] for a in earlier)),
+                 'all_error_categories': dict(Counter(a['category'] for a in allatts if a['score'] is None)),
+                 'env_error_tasks': env_tasks, 'successes_after_retry': [t for t in successes if len(bytask[t]['attempts']) > 1],
+                 'nonfinal_results': [a['folder'] for a in earlier if a['score'] is not None],
+                 'complete_marker': (RAW / (run + '_complete')).exists(),
+                 'tasks': bytask}
+
+g, v = runs['guiowl']['tasks'], runs['v4']['tasks']
+paired = Counter((int(v[t]['score']), int(g[t]['score'])) for t in tasks)
+b, c = paired[1, 0], paired[0, 1]
+p_exact = min(Fraction(1), Fraction(2 * sum(math.comb(b+c, i) for i in range(min(b,c)+1)), 2**(b+c)))
+envhit = sorted(set(runs['guiowl']['env_error_tasks']) | set(runs['v4']['env_error_tasks']))
+clean = [t for t in tasks if t not in envhit]
+health_tasks = {run: sorted(t for t, x in runs[run]['tasks'].items()
+                            if any(a['device_unhealthy_retries'] for a in x['attempts'])) for run in runs}
+all_envhit = sorted(set(envhit) | set(health_tasks['v4']) | set(health_tasks['guiowl']))
+broad_clean = [t for t in tasks if t not in all_envhit]
+comparison = {'n_tasks': len(tasks), 'v4_successes': len(runs['v4']['successes']),
+              'guiowl_successes': len(runs['guiowl']['successes']),
+              'both': paired[1,1], 'v4_only': b, 'guiowl_only': c, 'neither': paired[0,0],
+              'difference_pp_unrounded': 100 * (b-c)/len(tasks),
+              'mcnemar_exact_fraction': str(p_exact), 'mcnemar_exact_p': float(p_exact),
+              'environment_error_tasks': envhit,
+              'sensitivity': {'n_tasks': len(clean), 'v4': sum(v[t]['score'] for t in clean),
+                              'guiowl': sum(g[t]['score'] for t in clean)},
+              'health_retry_tasks': health_tasks,
+              'environment_error_tasks_including_internal_retries': all_envhit,
+              'sensitivity_including_internal_retries': {'n_tasks':len(broad_clean),
+                  'v4':sum(v[t]['score'] for t in broad_clean), 'guiowl':sum(g[t]['score'] for t in broad_clean)},
+              'task_split': {'a': len(tasks[0::2]), 'b': len(tasks[1::2]),
+                             'overlap': sorted(set(tasks[0::2]) & set(tasks[1::2]))}}
+
+mismatches=[]
+for run in runs:
+    saved=json.loads(read(ROOT/f'results/mobileworld/{run}_gui_en_r2_summary.json'))
+    for t, x in runs[run]['tasks'].items():
+        for k in ('score','has_result'):
+            if x[k] != saved['tasks'][t][k]:mismatches.append([run,t,k,x[k],saved['tasks'][t][k]])
+        if not x['has_result'] and x['final_category'] != saved['tasks'][t]['final_category']:
+            mismatches.append([run,t,'final_category'])
+    assert saved['successes']==len(runs[run]['successes'])
+    assert saved['earlier_attempt_outcomes']==runs[run]['earlier_categories']
+saved_cmp=json.loads(read(ROOT/'results/mobileworld/mw_r2_comparison.json'))
+for k in ('n_tasks','v4_successes','guiowl_successes','both','neither'):
+    assert saved_cmp[k]==comparison[k],k
+assert len(saved_cmp['v4_only'])==b and len(saved_cmp['guiowl_only'])==c
+assert saved_cmp['sensitivity_excluding_those_tasks']==comparison['sensitivity']
+assert saved_cmp['mcnemar_exact_p']==float(f'{float(p_exact):.3g}')
+assert not mismatches,mismatches
+assert {p.parent for p in RAW.rglob('result.txt')} == {
+    ROOT/a['folder'] for s in runs.values() for x in s['tasks'].values()
+    for a in x['attempts'] if a['score'] is not None}
+stamps={p.name:read(p).strip() for p in RAW.iterdir() if p.is_file() and (p.suffix in ('.start','.end','.jsonl') or p.name.endswith('_complete'))}
+result={'comparison':comparison,'saved_summary_mismatches':mismatches,'stamps':stamps,'runs':runs}
+(OUT/'recomputed.json').write_text(json.dumps(result,indent=2)+'\n')
+with (OUT/'task_inventory.csv').open('w',newline='') as f:
+    w=csv.DictWriter(f,fieldnames=list(rows[0]));w.writeheader();w.writerows(rows)
+(OUT/'read_manifest.json').write_text(json.dumps(reads,indent=2)+'\n')
+print(json.dumps(comparison,indent=2))
+for run,s in runs.items():
+    print(run,json.dumps({k:v for k,v in s.items() if k not in ('tasks','multi_attempt_tasks','env_error_tasks')},indent=2))
diff --git a/results/codex/mw_r2_audit/report.md b/results/codex/mw_r2_audit/report.md
new file mode 100644
index 0000000000000000000000000000000000000000..852becb8ee17666f650acf99706d14bf6dd7a7c5
--- /dev/null
+++ b/results/codex/mw_r2_audit/report.md
@@ -0,0 +1,133 @@
+Verdict: VALID WITH CAVEATS — the provisional 6/105 versus 22/105 scores and paired test are reproducible; environmental reporting needs correction, and the planned MAI-UI launch has two blocking correctness risks.
+
+1. **[P1 — launch blocker] A failed resume plan can mark an unrun MAI-UI half complete.**
+
+   **Evidence.** The resume script uses only `set -u`, reads the half-specific JSON without checking the planner's exit status, and continues after JSON parsing fails: [gcp_mw_resume_vm.sh:17](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:17), [task-file selection:32](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:32), [planner input:42](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:42), [unchecked output:94](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:94). Completion then means that `grep` found zero `->run`/`->rerun` strings, even if the dry-run producer failed: [completion pipeline:102](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:102). The MAI watcher also falls through into its launch loop when deployment fails, including failure to create the two task files: [gcp_mw_maiui_watch.sh:28](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:28), [deployment gate:41](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:41).
+
+   **Consequence.** Missing, truncated, or unreadable `mw_gui_en_maiui_a.json`/`b.json` can produce an empty `TODO`, no evaluation, and a `_complete` marker. The offline reproduction substituted a producer exiting 2 into the actual completion pipeline; it returned 0 and declared completion. This is a demonstrated failure path, **not an assertion that it happened to either existing arm**.
+
+   **Fix.** Stop the watcher iteration unless deployment succeeds. Validate both lists as unique, disjoint, and an exact 53/52 partition of the pinned 105-task manifest. Check planner exit status and JSON schema explicitly. Compute completion from a successfully parsed plan and the expected task inventory, not human-readable log text. Write a completion marker atomically only after that validation. Also validate `result.txt` contents before treating existence alone as completion ([current check:69](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:69)); all 206 existing result files passed validation in this audit.
+
+2. **[P1 — launch blocker] MAI-UI readiness does not establish that either endpoint serves MAI-UI Q8_0.**
+
+   **Evidence.** The watcher checks container health and whether the tunnel's `/health` contains `ok`, then launches the labeled MAI-UI evaluation: [gcp_mw_maiui_watch.sh:21](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:21), [launch:49](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:49). It has no dependency on a successful server-swap attestation. The swap script identifies old servers using the exact relative spelling `-m models/...`; equivalent absolute paths and `--model` are missed: [colab_mw_maiui_q8.py:35](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:35). It discards the new `Popen` handles and trusts generic health responses without checking that the new processes survived or own those ports: [server startup:50](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:50).
+
+   **Consequence.** Pre-swap MAI-UI Q4_K_M on 8093 and v4 on 8094 can satisfy readiness. A new server that exits because its port is occupied can also be reported as “up” using the old server's health response. The source explicitly identifies those old servers at [colab_mw_maiui_q8.py:3](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:3). Offline predicate checks confirm the absolute-path/long-flag misses. **No live endpoint was inspected, so this is a launch-integrity defect, not evidence that the swap has failed.**
+
+   **Fix.** Make successful, identity-checked server replacement a launch prerequisite. Retain and verify each new process, normalize executable/model paths when locating the old process, check listener ownership and served model identity/configuration, and bind each half to the expected weight/projector hashes and build. Publish a swap-ready manifest only after both checks pass; require it in the watcher. The current SHA check covers the main GGUF only ([hash:18](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:18), [verification:28](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:28)); include the projector. Require both GUI-Owl and v4 completion before reusing their containers; the watcher currently checks only GUI-Owl ([handoff:40](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:40)). The supplied snapshot already has v4 complete, so that last omission has not caused an observed conflict.
+
+3. **[P2 — observed reporting/statistical defect] “All attempts” and the environmental sensitivity omit retries inside task folders.**
+
+   **Evidence.** The summarizer enumerates final/backup/moved folders and returns immediately when a result exists: [mw_summarize_r2.py:25](/Users/alpha/lfm3-android/scripts/mw_summarize_r2.py:25), [attempt enumeration:66](/Users/alpha/lfm3-android/scripts/mw_summarize_r2.py:66), [environment tally:79](/Users/alpha/lfm3-android/scripts/mw_summarize_r2.py:79). MW has another retry layer: `Device is not healthy` causes task reinitialization inside the same folder, with `traj_backup_*.json`, and no terminal `Error executing task`: [runner.py:188](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/core/runner.py:188), [trajectory_logger.py:179](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/runtime/utils/trajectory_logger.py:179).
+
+   The raw snapshot has **15 such reinitializations for GUI-Owl and 2 for v4**. All 17 internal backup trajectories are empty: these failed before a policy action, rather than giving a model another completed navigation attempt. GUI-Owl's **SendWaiverTask succeeds after one**: [initialization failure and retry:11](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/guiowl_gui_en_r2/SendWaiverTask/thread_140161534165120.log:11), [result.txt:1](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/guiowl_gui_en_r2/SendWaiverTask/result.txt:1). v4 also has recovered initialization failures outside Thanksgiving, e.g. [ReadQwen3PaperTask1:10](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/v4_gui_en_r2/ReadQwen3PaperTask1/thread_131365845147776.log:10).
+
+   **Correction.** At the task-execution level, including those recovered failures:
+
+   | Quantity | v4 | GUI-Owl |
+   |---|---:|---:|
+   | Folder-level attempts currently enumerated | 112 | 129 |
+   | Additional internal reinitializations | 2 | 15 |
+   | Total task-execution starts | 114 | 144 |
+   | Tasks executed more than once | 3 | 21 |
+   | Failed setup/scoring executions, including recovery | 10 across 3 tasks | 27 across 18 tasks |
+
+   The reported **6 versus 22 of 97** is arithmetically correct for the *eight tasks with terminal folder-level setup/scoring failures*. It is not the stated exclusion of every task that hit a setup/scoring error. Including recovered initialization failures gives a union of **18 tasks**, leaving **v4 5/87 versus GUI-Owl 21/87**. The paired discordance remains 0 versus 16. This also qualifies “successes after an earlier failed attempt: none”: none followed a replaced **folder**, but GUI-Owl's SendWaiverTask followed an internal setup retry. The PREREG's claim that v4 had no environment failures except Thanksgiving also needs this qualification: [PREREG_v4.md:174](/Users/alpha/lfm3-android/docs/PREREG_v4.md:174).
+
+   **Fix.** Keep the completion classifier focused on the terminal disposition, but build reporting from all task-execution starts, internal reset events, and terminal outcomes. Report the narrow and broader sensitivity separately, with exact inclusion rules. Do not change scores or retroactively grant retries merely because the descriptive event inventory expands.
+
+4. **[P2 — observed adapter defect] The Enter repair is dropped when text input occupies the last step.**
+
+   **Evidence.** The adapter schedules Enter for its next `predict()` call: [lfm3_mw_agent.py:95](/Users/alpha/lfm3-android/eval/mobileworld/lfm3_mw_agent.py:95), [input_text:124](/Users/alpha/lfm3-android/eval/mobileworld/lfm3_mw_agent.py:124). MW stops and scores immediately after executing step 50: [runner.py:99](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/core/runner.py:99). Therefore a nonempty input at step 50 never completes the trained type-plus-Enter action.
+
+   This occurs in **MastodonAdjustTootsTask, MastodonUpdateContactsTask, and MattermostIncidentEscalationTask**. For example, [MastodonAdjustTootsTask/traj.json:523](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/v4_gui_en_r2/MastodonAdjustTootsTask/traj.json:523) ends with typing `bookmarks`; [MattermostIncidentEscalationTask log:480](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/v4_gui_en_r2/MattermostIncidentEscalationTask/thread_131365845147776.log:480) records typing, budget termination, and scoring without Enter. Across the run there are **141 text inputs but 138 synthetic Enters**. The three tasks scored zero; this does **not** establish that submitting the text would have solved them.
+
+   **Fix.** Complete the trained compound action before scoring or accepting another model decision, including at the budget boundary. Define explicitly whether the budget counts policy decisions or primitive device actions and implement that accounting consistently in a new comparison. Preserve run 2 as measured. Even away from the boundary, the current repair consumes additional budget: **37 of v4's 85 tasks reaching 50 steps contain synthetic Enters**, up to 16 in one task. The adapter documents that cost; “50 steps” should not be presented as 50 model decisions for v4.
+
+5. **[P2 — observed protocol mismatch] “ONE more attempt” is implemented as one invocation permitting four attempts.**
+
+   **Evidence.** The rule specifies one additional attempt after a fresh-container restart: [PREREG_v4.md:156](/Users/alpha/lfm3-android/docs/PREREG_v4.md:156). All resume branches retain `--auto_retry 3`: [gcp_mw_resume_vm.sh:23](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:23), [v4:28](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:28), [MAI-UI:35](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:35). MW interprets this as `1 + auto_retry` executions, not three total: [runner.py:303](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/core/runner.py:303).
+
+   The v4 manifest records one resume decision ([manifest:1](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/_retry_manifest_v4.jsonl:1)), but it produced **four** additional Thanksgiving executions starting at 19:51:16, 19:51:23, 19:51:30 and 19:51:37 UTC: [first:1](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/v4_gui_en_r2/ThanksgivingPrepTask_backup_20261118_195123/thread_125037903306880.log:1), [second:1](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/v4_gui_en_r2/ThanksgivingPrepTask_backup_20261118_195130/thread_125037903306880.log:1), [third:1](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/v4_gui_en_r2/ThanksgivingPrepTask_backup_20261118_195137/thread_125037903306880.log:1), [fourth:1](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/v4_gui_en_r2/ThanksgivingPrepTask/thread_125037903306880.log:1). Thus v4 has eight failed Thanksgiving executions, not four original plus one extra. Only the batch starts immediately after the container restart.
+
+   **Fix.** Record this as a deviation/clarification: the implemented allowance is one additional **invocation** with up to four executions. If the intended future rule is literally one execution, run the environment-retry queue with `--auto_retry 0` and handle never-started work separately. Do not silently alter only the pending GUI-Owl allowance after v4 received four: retain equal treatment for this comparison or label any change explicitly. The observed extra v4 attempts added no success.
+
+6. **[P2 — observed upstream harness bug] GUI-Owl's parse-failure sentinel is rejected before it can terminate and be scored.**
+
+   **Evidence.** After five failed parses, the official agent returns `JSONAction(action_type=ENV_FAIL)` ([gui_owl_1_5.py:497](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/gui_owl_1_5.py:497)); `ENV_FAIL` is `error_env`, but is absent from `_ACTION_TYPES`, so validation raises ([models.py:27](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/runtime/utils/models.py:27), [allowed values:34](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/runtime/utils/models.py:34), [validator:131](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/runtime/utils/models.py:131)). The runner already has a normal terminal branch for this sentinel ([runner.py:86](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/core/runner.py:86)), but construction fails first.
+
+   This is present in the raw failed attempts for **ReadQwen3PaperTask5** ([traceback:552](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/guiowl_gui_en_r2/ReadQwen3PaperTask5_backup_20261118_195606/thread_140161534165120.log:552)) and **MastodonCreateMemoTask** ([validation error:1719](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/guiowl_gui_en_r2/MastodonCreateMemoTask_backup_20261118_194824/thread_140161534165120.log:1719)). Both received another task execution instead of the intended terminal scoring. Both ultimately scored zero. This is more precise than attributing the whole exception to model output: malformed output triggered an additional harness defect.
+
+   **Fix.** For a separately versioned future harness, accept `ENV_FAIL` as a terminal action, or return a supported terminal sentinel and record the parse failure explicitly. Check the termination/scoring path without granting an extra task attempt. Keep the historical two retries in run 2's inventory; do not rewrite their outcomes or patch only one arm mid-comparison.
+
+7. **[P2 — reporting] The comparison MD/JSON discard GUI-Owl's provisional status.**
+
+   **Evidence.** The per-arm summary correctly says `complete: false` ([guiowl summary:9](/Users/alpha/lfm3-android/results/mobileworld/guiowl_gui_en_r2_summary.json:9)), and the PREREG explicitly says Thanksgiving's fresh-container allowance is pending ([PREREG_v4.md:186](/Users/alpha/lfm3-android/docs/PREREG_v4.md:186)). The comparison JSON contains no completion/pending field ([mw_r2_comparison.json:1](/Users/alpha/lfm3-android/results/mobileworld/mw_r2_comparison.json:1)), and the MD says the completion rule was applied without identifying the remaining task ([mw_r2_comparison.md:17](/Users/alpha/lfm3-android/results/mobileworld/mw_r2_comparison.md:17)).
+
+   **Fix.** Generate `provisional`, per-arm completion state, snapshot identity and pending eligible tasks into both comparison artifacts. Label every headline and paired statistic provisional until the pending allowance is resolved. With v4 fixed at six, the final GUI-Owl score can presently be **22 or 23/105**; the corresponding exact p-values are **1/32768** or **1/65536**. This uncertainty cannot reverse the observed ordering, but it prevents calling the present aggregate final.
+
+8. **[P3 — reporting precision] Correct the displayed percentage and distinguish adapter rejection from runtime support.**
+
+   **Evidence.** `22/105 = 20.95238%`, which rounds to **21.0%**, not the MD's 20.9%. The summarizer rounds the rate to four decimals and then rounds again for display: [mw_summarize_r2.py:89](/Users/alpha/lfm3-android/scripts/mw_summarize_r2.py:89), [display:129](/Users/alpha/lfm3-android/scripts/mw_summarize_r2.py:129), [MD:6](/Users/alpha/lfm3-android/results/mobileworld/mw_r2_comparison.md:6).
+
+   Also, “an action the runtime rejects (GUI-Owl's double_tap)” ([PREREG_v4.md:160](/Users/alpha/lfm3-android/docs/PREREG_v4.md:160)) misidentifies the layer. The model emitted `double_tap` ([CheckInvoiceTask2 log:124](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/guiowl_gui_en_r2/CheckInvoiceTask2/thread_140161534165120.log:124)), which GUI-Owl's adapter rejects ([gui_owl_1_5.py:219](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/gui_owl_1_5.py:219)); MW's runtime does implement double tap ([server.py:381](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/core/server.py:381)). This action is not in GUI-Owl's advertised action enum, so treating that model output as unsupported by its official adapter is reasonable.
+
+   **Fix.** Format percentages directly from integer counts. Say “rejected by the official GUI-Owl action adapter,” retaining the recorded failure. Describe Thanksgiving as a persistent task-specific initialization failure reproduced in both containers; the client-side HTTP-500 traces alone do not identify a task-code defect versus a shared dependency/data problem, as asserted at [PREREG_v4.md:171](/Users/alpha/lfm3-android/docs/PREREG_v4.md:171).
+
+**Independent numerical and inventory checks.** All paths in this report refer to the supplied local snapshot. The checked MW checkout is clean at `a026188705f4a494a12d14ddab3786a23fd2c537`. The task list contains 105 distinct names. Each has exactly one canonical folder per arm; every additional folder belongs to a named task's retry history. All **206 result.txt files** are in canonical final folders, parse as 0 or 1, and agree with their task logs' final `task_score`. There are **no result.txt files in MW backups or `_interrupted`**, no orphan result files, and no identified final result to discard. This verifies the saved checker outcomes; absent screenshots, it does not independently certify the UI/checker correctness of every success.
+
+| Recomputed quantity | v4 | GUI-Owl |
+|---|---:|---:|
+| Listed tasks / canonical folders | 105 | 105 |
+| Result files | 104 | 102 |
+| Successes | 6 | 22 |
+| Success rate | 5.714286% | 20.952381% |
+| No result, currently scored failure | 1 | 3 |
+| Completion marker in snapshot | Present | Absent |
+| Original-list elapsed seconds | 28,605 | 42,247 |
+
+v4's six successes are TakeSelfieTask, OpenFlightModeTask, CloseFlightModeTask, AdjustFontIconMinimumTask, SendWaiverTask and CheckRegistrationTask. GUI-Owl solved all six. The 2×2 table is:
+
+| | GUI-Owl success | GUI-Owl failure |
+|---|---:|---:|
+| v4 success | 6 | 0 |
+| v4 failure | 16 | 83 |
+
+The v4-minus-GUI-Owl difference is **−15.238095 percentage points**. The two-sided exact McNemar value is `2 × (1/2)^16 = 1/32768 = 0.000030517578125`; the saved `3.05e-05` is correct. The original 97-task sensitivity also reproduces under its narrower definition; finding 3 explains the reporting mismatch and broader calculation. Treat the p-value as conditional on this task-pair analysis, not a measurement of seed-to-seed uncertainty or a causal separation of model and harness effects. The artifacts already label the benchmark secondary/descriptive; no claim of a preregistered primary endpoint was found.
+
+**Retry policy and symmetry.** The two `classify()` implementations agree for every no-result folder among all **241 attempt folders**. Resume checks result existence outside its classifier, while the summarizer checks it inside; that is not a disagreement. Every current attempt folder has one thread log, so lexicographic concatenation of multiple thread logs causes no misclassification in this snapshot.
+
+The extracted dry planner returns no work for v4 and exactly ThanksgivingPrepTask for GUI-Owl. GUI-Owl's SendInterviewEmailTask and CheckInvoiceTask2 remain final failures. Only v4 has a moved folder and retry manifest in this snapshot; that matches GUI-Owl's explicitly pending resume, rather than proving unequal application of the rule. The manifest contains the executed `rerun` decision; the later dry completion check does not append a final-failure decision. Completion audit trails should retain that final disposition as well.
+
+MW's outer retry logic re-executes tasks returning `None`, not ordinary tasks scored zero ([runner.py:351](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/core/runner.py:351)); a valid result file is skipped on later scans ([client.py:418](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/runtime/client.py:418)). GUI-Owl's 24 replaced folders comprise 11 setup/scoring failures, 6 unavailable-simulator failures, 5 unsupported-action failures and 2 invalid-output/sentinel failures. Thus **13 replaced attempts followed output/simulator-related termination**. v4's seven replaced folders all concern Thanksgiving setup. **No success followed an outer folder replacement in either arm**; extra outer retries did not increase the observed 6-versus-22 numerator. The internal SendWaiver setup recovery is the separate exception described in finding 3.
+
+**Fairness and remaining interpretation limits.** The defensible comparison is between these configured agent pipelines. It does not isolate model weights under equal inference resources. The container asymmetry is real: even the narrow inventory has GUI-Owl environment failures on eight tasks versus one for v4; the broader inventory is 18 versus three. Excluding known errors cannot establish that all scored tasks on either container were unaffected. A future controlled comparison should rotate/randomize container assignment or repeat both arms on matched fresh environments; do not “correct” scored failures selectively using their observed results.
+
+| Setting | v4 | Official GUI-Owl | Planned MAI-UI wrapper |
+|---|---|---|---|
+| Image history | Current screenshot | Current screenshot (`history_n=1`) | Most recent one image (`history_n=1`) |
+| Text history | Last eight intent/action pairs | All previous step conclusions | All previous assistant responses |
+| Declared server image cap | 1024 | 2600 | 2600 |
+| Client-side image reduction | `MAX_PIXELS=880×880` | Full input screenshot | Full input screenshot |
+| Output cap | 512 tokens | 2048 tokens | 2048 tokens |
+| Parse attempts per prediction | Up to 2 | Up to 5 | One parse; error returns `UNKNOWN` |
+| Client request timeout | 300 seconds, `requests` | 120 seconds, OpenAI client | Same as GUI-Owl |
+| Explicit outer transport retries | No retry around a request exception | Up to 3 helper calls; SDK retry policy not explicitly disabled | Same as GUI-Owl |
+| Quantization | Q4_K_M | Q4_K_M | Q8_0 |
+| Step setting | 50 environment rounds, including synthetic Enter | 50 environment rounds | 50 environment rounds |
+
+Sources: [LFM query:72](/Users/alpha/lfm3-android/eval/mobileworld/lfm3_mw_agent.py:72), [format history:21](/Users/alpha/lfm3-android/train/agent_format.py:21), [resize budget:253](/Users/alpha/lfm3-android/train/agent_format.py:253), [GUI defaults:240](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/gui_owl_1_5.py:240), [GUI history:379](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/gui_owl_1_5.py:379), [GUI retries:465](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/gui_owl_1_5.py:465), [MAI defaults:133](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/mai_ui_agent.py:133), [MAI parse handling:286](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/mai_ui_agent.py:286), [common client:56](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/base.py:56), [transport helper:95](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/base.py:95). The server caps are declared experiment settings; live server flags, actual visual-token counts and server-side timing were not verified. In particular, 1024 is a cap, not proof that every v4 request contained 1024 visual tokens. No API-error or timeout markers were found in the supplied task logs, so there is no observed transport-timeout explanation for the score gap.
+
+`ask_user` is not usable in this deployment: seven GUI-Owl executions across four tasks hit the missing-key path; SendInterviewEmailTask still ends that way ([terminal exception:405](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/guiowl_gui_en_r2/SendInterviewEmailTask/thread_140161534165120.log:405)). GUI-Owl's `interact` is mapped to it ([agent_mapping.py:52](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/utils/agent_mapping.py:52)), and MAI-UI explicitly advertises it ([MAI prompt:29](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/utils/prompts/mai_ui.py:29)). v4 exposes no equivalent action. This is a disclosed pipeline limitation that can disadvantage the official agents, not evidence that those tasks inherently require a simulator. Maintain that disclosure and count the calls; any future simulator or deterministic “no additional information” policy should apply uniformly to new comparable arms, not just MAI-UI after seeing the other scores.
+
+**Adapter fixes and MAI-UI preflight checks that passed.** The current v4 adapter produces the AndroidWorld scroll endpoints for all four directions, and all **780 saved scroll-derived drags** agree with it. All **4,461 saved actions** replay through the current adapter with zero action-payload mismatches; 138 are synthetic Enters, leaving 4,323 model decisions. The intended scroll repair and ordinary type-then-Enter sequence are therefore present in run 2; finding 4 is the remaining boundary defect. MW's 400-ms drag timing still differs from the referenced AndroidWorld default, as the adapter already discloses ([lfm3_mw_agent.py:13](/Users/alpha/lfm3-android/eval/mobileworld/lfm3_mw_agent.py:13), [controller.py:248](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/runtime/controller.py:248)). No further coordinate, answer/finish or app-name translation mismatch was identified. `answer` is executed before terminal scoring for every agent ([runner.py:89](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/core/runner.py:89)).
+
+The checked MAI wrapper selects **MAIUIOneScreenshotAgent**, not the imported official class. It imports the official module as `_official`, which is not itself a class visible to the loader's subclass scan ([maiui_mw_agent.py:12](/Users/alpha/lfm3-android/eval/mobileworld/maiui_mw_agent.py:12), [registry.py:87](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/registry.py:87)). Registry-created agents get `tools=env.tools`; file-loaded agents do not automatically get it ([registry.py:124](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/registry.py:124), [registry path:140](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/registry.py:140)). The wrapper explicitly supplies it ([maiui_mw_agent.py:18](/Users/alpha/lfm3-android/eval/mobileworld/maiui_mw_agent.py:18)); the other constructor kwargs follow the same path. AST/stub checks found the same prompt, tools and default runtime configuration except `history_n: 3 → 1`, with all prediction/mapping methods inherited unchanged.
+
+For ordinary GUI observations, `history_n=1` does mean **current screenshot only**, while retaining previous assistant text. More exactly, it keeps the most recent **image-bearing message** ([mai_ui_agent.py:200](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/mai_ui_agent.py:200)); on a tool/user-response observation that contains only text, it retains the latest earlier image ([message choice:174](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/agents/implementations/mai_ui_agent.py:174)). “At most one most-recent image” is the precise general description. No successful simulator exchange occurs in the supplied configuration, so this qualification does not introduce a demonstrated run-2 screenshot-budget violation.
+
+The MAI split is **53/52, disjoint, and exhaustive** for the current manifest. Both completion planning and MW result scanning filter by the per-half task list. `TrajLogger` backs up only its own task directory ([trajectory_logger.py:77](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/runtime/utils/trajectory_logger.py:77)). The half-specific `pgrep` patterns include the environment prefix and correctly distinguish the generated commands ([resume guard:39](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:39), [watcher guard:46](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:46)); the watcher's bracket syntax also avoids matching the probing shell. No shared-root collision or cross-half result mixing follows from the checked commands. While the VM is running, the watcher restarts only the idle half's container. A VM stop interrupts both halves; its recovery branch starts both containers before the same per-half planning ([watcher:53](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:53)). There is no justification to call these correctly scoped paths bugs merely because the root is shared.
+
+There is no atomic run/container lock: the check-then-launch guards assume one watcher instance. A second concurrent copy can race before either starts its eval/resume process. Keep that operational constraint explicit or use a per-container/run lock before restart, planning and launching. The completion rule also caps moved interruption copies, so it is not an unlimited guarantee against repeated preemptions. Watchers have finite 16-/20-hour lifetimes ([resume watcher:31](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_watch.sh:31), [MAI watcher:35](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:35)); the PREREG's automatic-resume assurance assumes they are still alive when authentication returns. No live process state was checked.
+
+**Reproduction and scope.** Run `python3 -B results/codex/mw_r2_audit/recompute.py` and `python3 -B results/codex/mw_r2_audit/offline_checks.py` from the repository root. The first independently parses raw result files and inventories retries; the second executes only selected pure source definitions with inert stubs, an extracted dry planner, and a tiny local failing-producer shell pipeline. It does not import/run the MW application. Outputs are [recomputed.json](/Users/alpha/lfm3-android/results/codex/mw_r2_audit/recomputed.json), [task_inventory.csv](/Users/alpha/lfm3-android/results/codex/mw_r2_audit/task_inventory.csv), [offline_checks.json](/Users/alpha/lfm3-android/results/codex/mw_r2_audit/offline_checks.json), [read_manifest.json](/Users/alpha/lfm3-android/results/codex/mw_r2_audit/read_manifest.json) and [source_manifest.json](/Users/alpha/lfm3-android/results/codex/mw_r2_audit/source_manifest.json). Shell syntax checks passed for the three watchers/resume scripts and pull script. No MobileWorld evaluation, emulator, Docker, llama-server, adb, remote/cloud command or process signaling was performed. No sealed paths were opened. All audit writes are under `results/codex/mw_r2_audit/`; fixes above are recommendations, not source modifications.

