     1	"""Docker utility helpers for MobileWorld CLI.
     2	
     3	This module centralizes common Docker operations (run, ps, inspect, exec, rm)
     4	and a consistent command runner with improved error messaging.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	import json
    10	import os
    11	import subprocess
    12	import sys
    13	from collections.abc import Iterable
    14	from typing import Any
    15	
    16	from loguru import logger
    17	
    18	
    19	def run_command(
    20	    cmd: list[str],
    21	    capture: bool = True,
    22	    allowed_exit_codes: set[int] | None = None,
    23	) -> subprocess.CompletedProcess:
    24	    """Run a shell command, logging failures and exiting on error.
    25	
    26	    For Docker commands, provide a clearer message when permission errors occur.
    27	
    28	    Args:
    29	        cmd: Command to run as list of strings
    30	        capture: Whether to capture stdout/stderr
    31	        allowed_exit_codes: Set of exit codes to treat as success (in addition to 0)
    32	    """
    33	    try:
    34	        if capture:
    35	            result = subprocess.run(
    36	                cmd,
    37	                check=True,
    38	                capture_output=True,
    39	                text=True,
    40	            )
    41	        else:
    42	            result = subprocess.run(cmd, check=True)
    43	        return result
    44	    except subprocess.CalledProcessError as e:
    45	        # Check if this exit code is allowed
    46	        if allowed_exit_codes and e.returncode in allowed_exit_codes:
    47	            logger.debug(
    48	                "Command returned allowed exit code {}: {}",
    49	                e.returncode,
    50	                " ".join(cmd),
    51	            )
    52	            # Return a successful CompletedProcess with the actual exit code
    53	            return subprocess.CompletedProcess(
    54	                args=e.cmd,
    55	                returncode=e.returncode,
    56	                stdout=e.stdout,
    57	                stderr=e.stderr,
    58	            )
    59	
    60	        stderr_text = e.stderr or ""
    61	        logger.error("Command failed: {}", " ".join(cmd))
    62	        logger.error("Exit code: {}", e.returncode)
    63	        if stderr_text:
    64	            logger.error("Error output: {}", stderr_text)
    65	            if "permission denied" in stderr_text.lower() and "docker" in stderr_text.lower():
    66	                _log_docker_permission_help()
    67	        sys.exit(1)
    68	
    69	
    70	def _log_docker_permission_help() -> None:
    71	    logger.error("{}", "=" * 80)
    72	    logger.error("Docker Permission Error Detected")
    73	    logger.error("{}", "=" * 80)
    74	    logger.error("Your user doesn't have permission to access the Docker daemon.")
    75	    logger.error("To fix this issue, try one of the following:")
    76	    logger.error("  1. Add your user to the docker group:")
    77	    logger.error("     $ sudo usermod -aG docker $USER")
    78	    logger.error("     $ newgrp docker")
    79	    logger.error("  2. Run the command with sudo:")
    80	    logger.error("     $ sudo mobile-world env list")
    81	    logger.error("  3. Check Docker daemon is running:")
    82	    logger.error("     $ sudo systemctl status docker")
    83	
    84	
    85	def docker_ps(include_all: bool = False) -> list[dict[str, Any]]:
    86	    """Return a list of containers from `docker ps` as dicts."""
    87	    cmd = ["docker", "ps", "--format", "{{json .}}"]
    88	    if include_all:
    89	        cmd.insert(2, "-a")
    90	    result = run_command(cmd)
    91	    containers: list[dict[str, Any]] = []
    92	    for line in (result.stdout or "").strip().split("\n"):
    93	        if not line:
    94	            continue
    95	        try:
    96	            containers.append(json.loads(line))
    97	        except json.JSONDecodeError:
    98	            logger.debug("Skipping unparsable docker ps line: {}", line)
    99	    return containers
   100	
   101	
   102	def list_containers_by_image_substring(
   103	    image_substring: str, *, include_all: bool = False
   104	) -> list[dict[str, Any]]:
   105	    """Filter `docker ps` by image substring (case-insensitive)."""
   106	    substring = (image_substring or "").lower()
   107	    return [
   108	        c for c in docker_ps(include_all=include_all) if substring in (c.get("Image", "").lower())
   109	    ]
   110	
   111	
   112	def docker_inspect(container_name: str) -> dict[str, Any] | None:
   113	    """Return `docker inspect` result for a container or None if missing."""
   114	    result = run_command(["docker", "inspect", container_name])
   115	    try:
   116	        data = json.loads(result.stdout or "[]")
   117	        return data[0] if data else None
   118	    except json.JSONDecodeError:
   119	        logger.error("Failed to parse docker inspect output for {}", container_name)
   120	        return None
   121	
   122	
   123	def docker_rm(container_name: str, *, force: bool = True, volumes: bool = False) -> None:
   124	    """Remove a container by name."""
   125	    cmd = ["docker", "rm"]
   126	    if force:
   127	        cmd.append("-f")
   128	    if volumes:
   129	        cmd.append("-v")
   130	    cmd.append(container_name)
   131	    run_command(cmd)
   132	
   133	
   134	def build_run_command(
   135	    *,
   136	    name: str,
   137	    image: str,
   138	    port_mappings: Iterable[tuple[int, int]] | None = None,  # (host, container)
   139	    env_vars: dict[str, str] | None = None,
   140	    volumes: Iterable[tuple[str, str]] | None = None,  # (host, container)
   141	    detach: bool = True,
   142	    privileged: bool = True,
   143	    remove: bool = True,
   144	) -> list[str]:
   145	    """Construct a `docker run` command list with common flags."""
   146	    cmd: list[str] = [
   147	        "docker",
   148	        "run",
   149	    ]
   150	    if remove:
   151	        cmd.append("--rm")
   152	    if privileged:
   153	        cmd.append("--privileged")
   154	    cmd.extend(["--name", name])
