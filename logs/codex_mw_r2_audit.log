+"""Pure offline checks, AST-extracted functions/classes and local stubs only.
+
+Does NOT import or run MobileWorld, its CLI, a watcher, a model, or an environment.
+The only subprocess is a tiny local bash pipeline with a fake failing producer.
+All outputs go into this directory. Run with python3 -B.
+"""
+from pathlib import Path
+from types import SimpleNamespace, ModuleType
+from typing import Any
+import ast
+import glob
+import inspect
+import json
+import os
+import re
+import subprocess
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[2]
+MW = ROOT / 'tools/MobileWorld/src/mobile_world'
+report = {}
+
+def selected(source, names, ns):
+    tree = ast.parse(source)
+    nodes = [n for n in tree.body if isinstance(n, (ast.ClassDef, ast.FunctionDef)) and n.name in names]
+    assert len(nodes) == len(names), names
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), '<AST-selected offline code>', 'exec'), ns)
+    return ns
+
+class Log:
+    def __getattr__(self, name):
+        return lambda *a, **k: None
+
+class BaseStub:
+    def __init__(self, *args, **kw):
+        self.tools = kw.get('tools', [])
+    def build_openai_client(self, *args):
+        self.client_calls = args
+
+class ActionStub:
+    def __init__(self, **kw):
+        self.data = kw
+
+# File-loaded MAI wrapper: real class definitions with inert base/client/image stubs.
+official_ns = {'Any': Any, 'MCPAgent': BaseStub, 'logger': Log(), 'JSONAction': ActionStub, 'json':json,
+               'pil_to_base64': lambda image: image,
+               'MAI_MOBILE_SYS_PROMPT_ASK_USER_MCP': SimpleNamespace(render=lambda **kw: 'prompt:' + repr(kw))}
+selected((MW/'agents/implementations/mai_ui_agent.py').read_text(), ['MAIUINaivigationAgent'], official_ns)
+official = ModuleType('official_offline_stub')
+official.MAIUINaivigationAgent = official_ns['MAIUINaivigationAgent']
+wrapper = ModuleType('wrapper_offline_stub')
+wrapper.__dict__.update({'_official': official, 'Any': Any})
+selected((ROOT/'eval/mobileworld/maiui_mw_agent.py').read_text(), ['MAIUIOneScreenshotAgent'], wrapper.__dict__)
+candidates = [(n, c) for n,c in inspect.getmembers(wrapper, inspect.isclass)
+              if issubclass(c, BaseStub) and c is not BaseStub]
+assert [n for n,c in candidates] == ['MAIUIOneScreenshotAgent']
+tools = [{'test_tool': True}]
+env = SimpleNamespace(tools=tools)
+wrapped = candidates[0][1](llm_base_url='offline', model_name='MAI-UI-2B', env=env)
+native = official.MAIUINaivigationAgent(llm_base_url='offline', model_name='MAI-UI-2B', tools=tools, env=env)
+assert wrapped.tools is tools
+assert wrapped.runtime_conf == {**native.runtime_conf, 'history_n': 1}
+assert wrapped.system_prompt == native.system_prompt
+wrapped.instruction = native.instruction = 'test task'
+wrapped.history_images = native.history_images = [('old0',None,None),('old1',None,None),('current',None,None)]
+wrapped.history_responses = native.history_responses = [{'content':'action0'},{'content':'action1'}]
+def images(messages):
+    return [c['image_url']['url'] for m in messages if isinstance(m['content'],list)
+            for c in m['content'] if c['type']=='image_url']
+wmsg=wrapped._build_messages('current',None,None)
+nmsg=native._build_messages('current',None,None)
+assert images(wmsg)==['data:image/png;base64,current'] and len(images(nmsg))==3
+assert [m['content'] for m in wmsg if m['role']=='assistant']==['action0','action1']
+wrapped.history_images=[('old0',None,None),('old1',None,None),('current',None,'user reply')]
+nonvisual=wrapped._build_messages('current',None,'user reply')
+assert images(nonvisual)==['data:image/png;base64,old1']
+report['mai_wrapper']={'selected_classes':[n for n,c in candidates],
+    'only_default_changed': 'history_n: 3 -> 1', 'tools_forwarded': True,
+    'normal_gui_images': images(wmsg), 'text_history_retained': True,
+    'on_nonvisual_observation_latest_prior_image_is_kept': images(nonvisual)}
+
+# Replay every saved v4 final action through the current adapter's predict method.
+# af is a general local format helper; no MW module is imported. No images are opened.
+af = ModuleType('agent_format_offline')
+exec(compile((ROOT/'train/agent_format.py').read_text(), '<local format helper>', 'exec'), af.__dict__)
+af.resize_screenshot = lambda image, pixels: image
+lfm_ns={'Any':Any,'BaseAgent':BaseStub,'JSONAction':ActionStub,'logger':Log(),'af':af,'os':os,
+        'MW_APPS':['Calendar','Camera','Chrome','Clock','Contacts','Files','Gallery','Mail','Maps','Mastodon','Mattermost','Settings','SMS','Taodian']}
+selected((ROOT/'eval/mobileworld/lfm3_mw_agent.py').read_text(), ['LFM3MobileWorldAgent'], lfm_ns)
+replayed=0;queried=0;enters=0;drags=0;pending=[];mismatch=[]
+for p in sorted((ROOT/'results/mobileworld/traj_r2/v4_gui_en_r2').glob('*/traj.json')):
+    if '_backup_' in p.parent.name:
+        continue
+    steps=json.loads(p.read_text()).get('0',{}).get('traj',[])
+    obj=lfm_ns['LFM3MobileWorldAgent']()
+    obj.initialize_hook('test');obj.instruction='test'
+    for step in steps:
+        pred=step['prediction']
+        if pred.startswith('(adapter)'):
+            enters+=1
+            assert obj._pending_enter
+            def no_query(*args):raise AssertionError('synthetic Enter queried model')
+            obj._query=no_query
+        else:
+            queried+=1
+            m=re.fullmatch(r'<think>(.*?)</think>(.*?)  \[latency ([0-9.]+)s\]',pred,re.S)
+            assert m,(p,step['step'])
+            response={'reasoning':m[1],'content':m[2],'latency_s':float(m[3])}
+            obj._query=lambda *args,r=response:r
+        raw,action=obj.predict({'screenshot':SimpleNamespace(size=(1080,2400))})
+        if action.data!=step['action']:mismatch.append([str(p),step['step'],action.data,step['action']])
+        replayed+=1
+        drags+=action.data['action_type']=='drag'
+    if obj._pending_enter:pending.append(p.parent.name)
+assert not mismatch,mismatch[:2]
+assert len(pending)==3
+report['v4_replay']={'serialized_actions':replayed,'model_decisions':queried,'synthetic_enters':enters,
+                    'drags':drags,'mismatches':mismatch,'pending_enter_at_step_50':pending,
+                    'dimensions': [1080,2400], 'dimension_basis':'all 780 saved drag origins are (540,1200)'}
+
+# Extract the two classifiers; verify every snapshot folder, independently of recomputation.
+resume_text=(ROOT/'scripts/gcp_mw_resume_vm.sh').read_text()
+embedded=resume_text.split("<<'PY'\n",1)[1].split('\nPY\n',1)[0]
+resume_ns={'glob':glob,'os':os}
+selected(embedded,['classify'],resume_ns)
+summary_ns={'glob':glob,'os':os,'re':re}
+selected((ROOT/'scripts/mw_summarize_r2.py').read_text(),['classify'],summary_ns)
+r=json.loads((OUT/'recomputed.json').read_text())
+classifications=0
+for run,s in r['runs'].items():
+    for task,x in s['tasks'].items():
+        for a in x['attempts']:
+            path=str(ROOT/a['folder']);classifications+=1
+            outcome,cat=summary_ns['classify'](path)
+            if a['score'] is None:
+                assert outcome=='error' and cat==resume_ns['classify'](path)==a['category']
+            else:
+                assert outcome=='result' and cat==a['score']
+report['classifiers']={'folders_checked':classifications,'no_result_disagreements':0,
+                      'note':'Result existence is checked by resume outside classify().' }
+
+result_checks=0
+for run,s in r['runs'].items():
+    for task,x in s['tasks'].items():
+        folder=ROOT/x['attempts'][-1]['folder']
+        txt=''.join(p.read_text() for p in folder.glob('*.log'))
+        scores=re.findall(r'core.runner:_execute_single_task:104 .*task_score: ([0-9.]+), reason:',txt)
+        if x['has_result']:
+            assert len(scores)==1 and float(scores[0])==x['score']
+            result_checks+=1
+        steps=json.loads((folder/'traj.json').read_text()).get('0',{}).get('traj',[])
+        assert [s['step'] for s in steps]==list(range(1,len(steps)+1))
+        assert len(steps)<=50
+report['result_log_consistency']={'result_files_checked':result_checks,'score_disagreements':0,
+                                'step_discontinuities':0,'tasks_over_50_steps':0}
+
+models_tree=ast.parse((MW/'runtime/utils/models.py').read_text())
+constants=[n for n in models_tree.body if isinstance(n,ast.Assign) and n.lineno<86]
+constants_ns={}
+exec(compile(ast.Module(body=constants,type_ignores=[]),'<model constants only>','exec'),constants_ns)
+assert constants_ns['ENV_FAIL']=='error_env' and constants_ns['ENV_FAIL'] not in constants_ns['_ACTION_TYPES']
+report['guiowl_terminal_sentinel']={'ENV_FAIL':'error_env','accepted_by_JSONAction':False,
+                                  'observed_crash_tasks':['MastodonCreateMemoTask','ReadQwen3PaperTask5']}
+
+# Execute only the extracted dry-run planner on the snapshot. No mutating AST branch runs.
+planner_tree=ast.parse(embedded)
+planner_nodes=[n for n in planner_tree.body if getattr(n,'lineno',0)>=7]
+# The original node at embedded line 7 is ts=...; provide time, with dry=True below.
+import time
+import contextlib
+import io
+plans={}
+for run in ('v4','guiowl'):
+    ns={'glob':glob,'json':json,'os':os,'time':time,'run':run,'dry':True,
+        'log':str(ROOT/f'results/mobileworld/traj_r2/{run}_gui_en_r2'),
+        'tasks':list(r['runs'][run]['tasks']),
+        'moved_root':str(ROOT/f'results/mobileworld/traj_r2/_interrupted/{run}')}
+    with contextlib.redirect_stdout(io.StringIO()) as cap:
+        exec(compile(ast.Module(body=planner_nodes,type_ignores=[]),'<dry planner AST>','exec'),ns)
+    plans[run]=json.loads(cap.getvalue())
+assert plans['v4']['todo']==[]
+assert plans['guiowl']['todo']==['ThanksgivingPrepTask']
+report['snapshot_resume_plan']=plans
+
+# Faithful isolated reproduction of the fail-open completion pipeline; no watcher run.
+line=next(x for x in resume_text.splitlines() if x.startswith('LEFT='))
+line=line.replace('bash "$0" "$RUN" --dry-run','failed_dry_run')
+sh='set -u\nfailed_dry_run() { return 2; }\n'+line+'\n[ "$LEFT" -eq 0 ] && printf "FALSE_COMPLETION\\n"\n'
+proc=subprocess.run(['/bin/bash','-c',sh],cwd=OUT,text=True,capture_output=True)
+assert proc.stdout.strip()=='FALSE_COMPLETION'
+report['failed_planner_pipeline']={'producer_exit':2,'pipeline_exit':proc.returncode,'output':proc.stdout.strip()}
+
+# Verify the checked-in per-half command regexes without calling pgrep.
+pattern_a=r'mw eval.*--env_prefix mobile_world_env --log_file_root /home/ubuntu/traj_logs/maiui_gui_en_r2'
+pattern_b=r'mw eval.*--env_prefix lfmenv --log_file_root /home/ubuntu/traj_logs/maiui_gui_en_r2'
+cmd_a='uv run mw eval --agent_type /home/ubuntu/lfm3/maiui_mw_agent.py --env_prefix mobile_world_env --log_file_root /home/ubuntu/traj_logs/maiui_gui_en_r2 --task taskA'
+cmd_b=cmd_a.replace('mobile_world_env --log_file_root','lfmenv --log_file_root')
+assert re.search(pattern_a,cmd_a) and not re.search(pattern_a,cmd_b)
+assert re.search(pattern_b,cmd_b) and not re.search(pattern_b,cmd_a)
+tasks=json.loads((ROOT/'results/mobileworld/mw_gui_en.json').read_text())
+assert not set(tasks[0::2]) & set(tasks[1::2])
+report['mai_split']={'halves':[len(tasks[0::2]),len(tasks[1::2])], 'disjoint':True,
+                     'regex_cross_matches':False, 'scan_filters_exact_task_names':True}
+
+# Swap predicate: the exact relative '-m' spelling is required by the current code.
+stop=('models/MAI-UI-2B-Q4_K_M.gguf','models/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf')
+def selected_for_stop(cmd):
+    return 'llama-server' in cmd.split(' ')[0] and any(f'-m {m} ' in cmd for m in stop)
+relative='llama.cpp/build/bin/llama-server -m models/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf --port 8094 '
+absolute=relative.replace('-m models/','-m /content/models/')
+longflag=relative.replace(' -m ',' --model ')
+assert selected_for_stop(relative) and not selected_for_stop(absolute) and not selected_for_stop(longflag)
+report['swap_identity_guard']={'relative_path_selected':True,'absolute_path_selected':False,
+    'long_model_flag_selected':False,'generic_old_model_health_passes':b'ok' in b'{"status":"ok"}',
+    'limit':'Demonstrates unguarded failure path; does not assert a live server mismatch.'}
+
+(OUT/'offline_checks.json').write_text(json.dumps(report,indent=2)+'\n')
+import hashlib
+source_paths=[ROOT/'scripts/mw_summarize_r2.py', ROOT/'scripts/gcp_mw_resume_vm.sh',
+              ROOT/'scripts/gcp_mw_resume_watch.sh', ROOT/'scripts/gcp_mw_maiui_watch.sh',
+              ROOT/'scripts/colab_mw_maiui_q8.py',ROOT/'scripts/colab_mw_models.sh',ROOT/'scripts/mw_pull_r2.sh',
+              ROOT/'eval/mobileworld/lfm3_mw_agent.py',ROOT/'eval/mobileworld/maiui_mw_agent.py',
+              ROOT/'train/agent_format.py',ROOT/'docs/PREREG_v4.md',
+              MW/'agents/base.py',MW/'agents/registry.py',MW/'agents/implementations/gui_owl_1_5.py',
+              MW/'agents/implementations/mai_ui_agent.py',MW/'core/runner.py',MW/'core/server.py',
+              MW/'core/subcommands/eval.py',MW/'runtime/client.py',MW/'runtime/controller.py',
+              MW/'runtime/utils/models.py',MW/'runtime/utils/trajectory_logger.py']
+(OUT/'source_manifest.json').write_text(json.dumps({str(p.relative_to(ROOT)):hashlib.sha256(p.read_bytes()).hexdigest()
+                                                 for p in source_paths},indent=2)+'\n')
+print(json.dumps(report,indent=2))
diff --git a/results/codex/mw_r2_audit/recompute.py b/results/codex/mw_r2_audit/recompute.py
new file mode 100644
index 0000000000000000000000000000000000000000..0181531106878d0e5fc6ae2a4ab6ac3a05d9c1c8
--- /dev/null
+++ b/results/codex/mw_r2_audit/recompute.py
@@ -0,0 +1,177 @@
+"""Offline audit: read only the specified MW snapshot; write only beside this file.
+
+No imports from the production summarizer or MobileWorld, no network/process control.
+Run: python3 -B results/codex/mw_r2_audit/recompute.py
+"""
+from pathlib import Path
+from collections import Counter
+from fractions import Fraction
+import csv
+import hashlib
+import json
+import math
+import re
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[2]
+RAW = ROOT / 'results/mobileworld/traj_r2'
+reads = {}
+
+def read(p):
+    data = p.read_bytes()
+    reads[str(p.relative_to(ROOT))] = {'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data)}
+    return data.decode(errors='replace')
+
+def get_score(folder):
+    p = folder / 'result.txt'
+    if not p.is_file():
+        return None
+    # Strict first-line parsing, independently of mw_summarize_r2.py's regex.
+    lines = read(p).splitlines()
+    assert len(lines) >= 2 and lines[0].startswith('score: '), str(p)
+    score = float(lines[0].removeprefix('score: '))
+    assert score in (0.0, 1.0), (str(p), score)
+    return score
+
+def error(folder):
+    files = sorted(folder.glob('*.log'))
+    text = ''.join(read(p) for p in files)
+    terminal = text.rpartition('Error executing task')[2]
+    if not terminal:
+        return 'interrupted', text
+    # End-of-attempt exception signatures, not earlier warning/error messages.
+    if 'Failed to initialize task' in terminal:
+        return 'setup_failed', text
+    if 'Failed to get task score' in terminal:
+        return 'scoring_failed', text
+    if 'Unknown action_type' in terminal:
+        return 'unsupported_action', text
+    if 'error_env' in terminal or 'Failed to parse tool_call' in terminal:
+        return 'invalid_model_output', text
+    if 'Step action failed' in terminal and 'API key' in terminal:
+        return 'ask_user_without_simulator', text
+    return 'other_error', text
+
+tasks = json.loads(read(ROOT / 'results/mobileworld/mw_gui_en.json'))
+assert len(tasks) == len(set(tasks)) == 105
+env_categories = {'setup_failed', 'scoring_failed'}
+rows, runs = [], {}
+for run in ('v4', 'guiowl'):
+    base = RAW / (run + '_gui_en_r2')
+    bytask = {}
+    assigned = set()
+    for t in tasks:
+        final = base / t
+        assert final.is_dir(), str(final)
+        backups = sorted(base.glob(t + '_backup_*'))
+        moved = sorted((RAW / '_interrupted' / run).glob(t + '_2*'))
+        attempts = []
+        for kind, folders in (('auto_retry', backups), ('moved', moved), ('final', [final])):
+            for folder in folders:
+                assigned.add(folder)
+                score = get_score(folder)
+                category, txt = error(folder)
+                category = 'result' if score is not None else category
+                trajpath = folder / 'traj.json'
+                traj = json.loads(read(trajpath)) if trajpath.exists() else {}
+                steps = traj.get('0', {}).get('traj', [])
+                inner = {p.name: json.loads(read(p)) for p in sorted(folder.glob('traj_backup_*.json'))}
+                assert all(x == {} for x in inner.values()), (folder, 'nonempty inner retry')
+                a = {'folder': str(folder.relative_to(ROOT)), 'kind': kind,
+                     'score': score, 'category': category, 'steps': len(steps),
+                     'last_action': steps[-1]['action'] if steps else None,
+                     'log_files': len(list(folder.glob('*.log'))),
+                     'terminal_error_markers': txt.count('Error executing task'),
+                     'device_unhealthy_retries': txt.count('Device is not healthy, retrying'),
+                     'internal_empty_trajectory_backups': list(inner),
+                     'non_200_step_responses': re.findall(r'execute_action response: \{\s*"status": (?!200)(\d+)', txt),
+                     'api_error_warnings': txt.count('Error calling OpenAI API:'),
+                     'timeout_markers': len(re.findall(r'Timeout|timed out|timedout', txt)),
+                     'synthetic_enters': sum(s['prediction'].startswith('(adapter) keyboard_enter') for s in steps),
+                     'input_texts': sum(s['action']['action_type'] == 'input_text' for s in steps),
+                     'drag_actions': sum(s['action']['action_type'] == 'drag' for s in steps),
+                     'invalid_output_waits': sum('unparseable output:' in line for line in txt.splitlines()),
+                     'action_counts': dict(Counter(s['action']['action_type'] for s in steps)),
+                     'token_usage': traj.get('0', {}).get('token_usage')}
+                attempts.append(a)
+        nonfinal = attempts[:-1]
+        f = attempts[-1]
+        bytask[t] = {'score': f['score'] or 0, 'has_result': f['score'] is not None,
+                     'final_category': f['category'], 'attempts': attempts}
+        rows.append({'run': run, 'task': t, 'score': f['score'] if f['score'] is not None else 0,
+                     'has_result': f['score'] is not None, 'category': f['category'],
+                     'attempts': len(attempts), 'steps': f['steps'], 'synthetic_enters': f['synthetic_enters'],
+                     'final_folder': f['folder']})
+    allfolders = {p for p in base.iterdir() if p.is_dir()}
+    allfolders |= {p for p in (RAW / '_interrupted' / run).glob('*') if p.is_dir()}
+    assert allfolders == assigned, sorted(str(p) for p in allfolders ^ assigned)
+    allatts = [a for t in bytask.values() for a in t['attempts']]
+    earlier = [a for a in allatts if a['kind'] != 'final']
+    successes = [t for t in tasks if bytask[t]['score'] == 1]
+    env_tasks = [t for t in tasks if any(a['category'] in env_categories for a in bytask[t]['attempts'])]
+    runs[run] = {'n_tasks': len(bytask), 'with_result': sum(x['has_result'] for x in bytask.values()),
+                 'successes': successes, 'success_rate': len(successes) / len(tasks),
+                 'no_result': {t: x['final_category'] for t, x in bytask.items() if not x['has_result']},
+                 'total_attempts': len(allatts), 'extra_attempts': len(earlier),
+                 'multi_attempt_tasks': [t for t, x in bytask.items() if len(x['attempts']) > 1],
+                 'earlier_categories': dict(Counter(a['category'] for a in earlier)),
+                 'all_error_categories': dict(Counter(a['category'] for a in allatts if a['score'] is None)),
+                 'env_error_tasks': env_tasks, 'successes_after_retry': [t for t in successes if len(bytask[t]['attempts']) > 1],
+                 'nonfinal_results': [a['folder'] for a in earlier if a['score'] is not None],
+                 'complete_marker': (RAW / (run + '_complete')).exists(),
+                 'tasks': bytask}
+
+g, v = runs['guiowl']['tasks'], runs['v4']['tasks']
+paired = Counter((int(v[t]['score']), int(g[t]['score'])) for t in tasks)
+b, c = paired[1, 0], paired[0, 1]
+p_exact = min(Fraction(1), Fraction(2 * sum(math.comb(b+c, i) for i in range(min(b,c)+1)), 2**(b+c)))
+envhit = sorted(set(runs['guiowl']['env_error_tasks']) | set(runs['v4']['env_error_tasks']))
+clean = [t for t in tasks if t not in envhit]
+health_tasks = {run: sorted(t for t, x in runs[run]['tasks'].items()
+                            if any(a['device_unhealthy_retries'] for a in x['attempts'])) for run in runs}
+all_envhit = sorted(set(envhit) | set(health_tasks['v4']) | set(health_tasks['guiowl']))
+broad_clean = [t for t in tasks if t not in all_envhit]
+comparison = {'n_tasks': len(tasks), 'v4_successes': len(runs['v4']['successes']),
+              'guiowl_successes': len(runs['guiowl']['successes']),
+              'both': paired[1,1], 'v4_only': b, 'guiowl_only': c, 'neither': paired[0,0],
+              'difference_pp_unrounded': 100 * (b-c)/len(tasks),
+              'mcnemar_exact_fraction': str(p_exact), 'mcnemar_exact_p': float(p_exact),
+              'environment_error_tasks': envhit,
+              'sensitivity': {'n_tasks': len(clean), 'v4': sum(v[t]['score'] for t in clean),
+                              'guiowl': sum(g[t]['score'] for t in clean)},
+              'health_retry_tasks': health_tasks,
+              'environment_error_tasks_including_internal_retries': all_envhit,
+              'sensitivity_including_internal_retries': {'n_tasks':len(broad_clean),
+                  'v4':sum(v[t]['score'] for t in broad_clean), 'guiowl':sum(g[t]['score'] for t in broad_clean)},
+              'task_split': {'a': len(tasks[0::2]), 'b': len(tasks[1::2]),
+                             'overlap': sorted(set(tasks[0::2]) & set(tasks[1::2]))}}
+
+mismatches=[]
+for run in runs:
+    saved=json.loads(read(ROOT/f'results/mobileworld/{run}_gui_en_r2_summary.json'))
+    for t, x in runs[run]['tasks'].items():
+        for k in ('score','has_result'):
+            if x[k] != saved['tasks'][t][k]:mismatches.append([run,t,k,x[k],saved['tasks'][t][k]])
+        if not x['has_result'] and x['final_category'] != saved['tasks'][t]['final_category']:
+            mismatches.append([run,t,'final_category'])
+    assert saved['successes']==len(runs[run]['successes'])
+    assert saved['earlier_attempt_outcomes']==runs[run]['earlier_categories']
+saved_cmp=json.loads(read(ROOT/'results/mobileworld/mw_r2_comparison.json'))
+for k in ('n_tasks','v4_successes','guiowl_successes','both','neither'):
+    assert saved_cmp[k]==comparison[k],k
+assert len(saved_cmp['v4_only'])==b and len(saved_cmp['guiowl_only'])==c
+assert saved_cmp['sensitivity_excluding_those_tasks']==comparison['sensitivity']
+assert saved_cmp['mcnemar_exact_p']==float(f'{float(p_exact):.3g}')
+assert not mismatches,mismatches
+assert {p.parent for p in RAW.rglob('result.txt')} == {
+    ROOT/a['folder'] for s in runs.values() for x in s['tasks'].values()
+    for a in x['attempts'] if a['score'] is not None}
+stamps={p.name:read(p).strip() for p in RAW.iterdir() if p.is_file() and (p.suffix in ('.start','.end','.jsonl') or p.name.endswith('_complete'))}
+result={'comparison':comparison,'saved_summary_mismatches':mismatches,'stamps':stamps,'runs':runs}
+(OUT/'recomputed.json').write_text(json.dumps(result,indent=2)+'\n')
+with (OUT/'task_inventory.csv').open('w',newline='') as f:
+    w=csv.DictWriter(f,fieldnames=list(rows[0]));w.writeheader();w.writerows(rows)
+(OUT/'read_manifest.json').write_text(json.dumps(reads,indent=2)+'\n')
+print(json.dumps(comparison,indent=2))
+for run,s in runs.items():
+    print(run,json.dumps({k:v for k,v in s.items() if k not in ('tasks','multi_attempt_tasks','env_error_tasks')},indent=2))
diff --git a/results/codex/mw_r2_audit/report.md b/results/codex/mw_r2_audit/report.md
new file mode 100644
index 0000000000000000000000000000000000000000..7f9f3876ff1474b4743c2ddee670e1da41635d16
--- /dev/null
+++ b/results/codex/mw_r2_audit/report.md
@@ -0,0 +1,133 @@
+Verdict: VALID WITH CAVEATS — the provisional 6/105 versus 22/105 scores and paired test are reproducible; environmental reporting needs correction, and the planned MAI-UI launch has two blocking correctness risks.
+
+1. **[P1 — launch blocker] A failed resume plan can mark an unrun MAI-UI half complete.**
+
+   **Evidence.** The resume script uses only `set -u`, reads the half-specific JSON without checking the planner's exit status, and continues after JSON parsing fails: [gcp_mw_resume_vm.sh:17](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:17), [task-file selection:32](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:32), [planner input:42](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:42), [unchecked output:94](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:94). Completion then means that `grep` found zero `->run`/`->rerun` strings, even if the dry-run producer failed: [completion pipeline:102](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:102). The MAI watcher also falls through into its launch loop when deployment fails, including failure to create the two task files: [gcp_mw_maiui_watch.sh:28](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:28), [deployment gate:41](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:41).
+
+   **Consequence.** Missing, truncated, or unreadable `mw_gui_en_maiui_a.json`/`b.json` can produce an empty `TODO`, no evaluation, and a `_complete` marker. The offline reproduction substituted a producer exiting 2 into the actual completion pipeline; it returned 0 and declared completion. This is a demonstrated failure path, **not an assertion that it happened to either existing arm**.
+
+   **Fix.** Stop the watcher iteration unless deployment succeeds. Validate both lists as unique, disjoint, and an exact 53/52 partition of the pinned 105-task manifest. Check planner exit status and JSON schema explicitly. Compute completion from a successfully parsed plan and the expected task inventory, not human-readable log text. Write a completion marker atomically only after that validation. Also validate `result.txt` contents before treating existence alone as completion ([current check:69](/Users/alpha/lfm3-android/scripts/gcp_mw_resume_vm.sh:69)); all 206 existing result files passed validation in this audit.
+
+2. **[P1 — launch blocker] MAI-UI readiness does not establish that either endpoint serves MAI-UI Q8_0.**
+
+   **Evidence.** The watcher checks container health and whether the tunnel's `/health` contains `ok`, then launches the labeled MAI-UI evaluation: [gcp_mw_maiui_watch.sh:21](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:21), [launch:49](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:49). It has no dependency on a successful server-swap attestation. The swap script identifies old servers using the exact relative spelling `-m models/...`; equivalent absolute paths and `--model` are missed: [colab_mw_maiui_q8.py:35](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:35). It discards the new `Popen` handles and trusts generic health responses without checking that the new processes survived or own those ports: [server startup:50](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:50).
+
+   **Consequence.** Pre-swap MAI-UI Q4_K_M on 8093 and v4 on 8094 can satisfy readiness, including when the swap's hash assertion fails before stopping the old servers. A new server that exits because its port is occupied can also be reported as “up” using the old server's health response. The source explicitly identifies those old servers at [colab_mw_maiui_q8.py:3](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:3). Offline predicate checks confirm the absolute-path/long-flag misses. **No live endpoint was inspected, so this is a launch-integrity defect, not evidence that the swap has failed.**
+
+   **Fix.** Make successful, identity-checked server replacement a launch prerequisite. Retain and verify each new process, normalize executable/model paths when locating the old process, check listener ownership and served model identity/configuration, and bind each half to the expected weight/projector hashes and build. Publish a swap-ready manifest only after both checks pass; require it in the watcher. The current SHA check covers the main GGUF only ([hash:18](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:18), [verification:28](/Users/alpha/lfm3-android/scripts/colab_mw_maiui_q8.py:28)); include the projector. Require both GUI-Owl and v4 completion before reusing their containers; the watcher currently checks only GUI-Owl ([handoff:40](/Users/alpha/lfm3-android/scripts/gcp_mw_maiui_watch.sh:40)). The supplied snapshot already has v4 complete, so that last omission has not caused an observed conflict.
+
+3. **[P2 — observed reporting/statistical defect] “All attempts” and the environmental sensitivity omit retries inside task folders.**
+
+   **Evidence.** The summarizer enumerates final/backup/moved folders and returns immediately when a result exists: [mw_summarize_r2.py:25](/Users/alpha/lfm3-android/scripts/mw_summarize_r2.py:25), [attempt enumeration:66](/Users/alpha/lfm3-android/scripts/mw_summarize_r2.py:66), [environment tally:79](/Users/alpha/lfm3-android/scripts/mw_summarize_r2.py:79). MW has another retry layer: `Device is not healthy` causes task reinitialization inside the same folder, with `traj_backup_*.json`, and no terminal `Error executing task`: [runner.py:188](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/core/runner.py:188), [trajectory_logger.py:179](/Users/alpha/lfm3-android/tools/MobileWorld/src/mobile_world/runtime/utils/trajectory_logger.py:179).
+
+   The raw snapshot has **15 such reinitializations for GUI-Owl and 2 for v4**. All 17 internal backup trajectories are empty: these failed before a policy action, rather than giving a model another completed navigation attempt. GUI-Owl's **SendWaiverTask succeeds after one**: [initialization failure and retry:11](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/guiowl_gui_en_r2/SendWaiverTask/thread_140161534165120.log:11), [result.txt:1](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/guiowl_gui_en_r2/SendWaiverTask/result.txt:1). v4 also has recovered initialization failures outside Thanksgiving, e.g. [ReadQwen3PaperTask1:10](/Users/alpha/lfm3-android/results/mobileworld/traj_r2/v4_gui_en_r2/ReadQwen3PaperTask1/thread_131365845147776.log:10).
+
+   **Correction.** At the task-execution level, including those recovered failures:
+
+   | Quantity | v4 | GUI-Owl |
+   |---|---:|---:|
+   | Folder-level attempts currently enumerated | 112 | 129 |
+   | Additional internal reinitializations | 2 | 15 |
+   | Total task-execution starts | 114 | 144 |
+   | Tasks executed more than once | 3 | 21 |
+   | Failed setup/scoring executions, including recovery | 10 across 3 tasks | 27 across 18 tasks |
+
+   The reported **6 versus 22 of 97** is arithmetically correct for the *eight tasks with terminal folder-level setup/scoring failures*. It is not the stated exclusion of every task that hit a setup/scoring error. Including recovered initialization failures gives a union of **18 tasks**, leaving **v4 5/87 versus GUI-Owl 21/87**. The paired discordance remains 0 versus 16. This also qualifies “successes after an earlier failed attempt: none”: none followed a replaced **folder**, but GUI-Owl's SendWaiverTask followed an internal setup retry. The PREREG's claim that v4 had no environment failures except Thanksgiving also needs this qualification: [PREREG_v4.md:174](/Users/alpha/lfm3-android/docs/PREREG_v4.md:174).
+
+   **Fix.** Keep the completion classifier focused on the terminal disposition, but build reporting from all task-execution starts, internal reset events, and terminal outcomes. Report the narrow and broader sensitivity separately, with exact inclusion rules. Do not change scores or retroactively grant retries merely because the descriptive event inventory expands.
