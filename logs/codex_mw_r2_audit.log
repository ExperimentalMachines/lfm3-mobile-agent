   253	MAX_PIXELS = 880 * 880  # ~756 image tokens for a 1080x2400 phone screen (32px per token)
   254	MIN_PIXELS = 256 * 256
   255	RESIZE_FACTOR = 32  # 16px patch * 2x2 merge (LFM3-VL and Qwen3.5 alike)
   256	
   257	
   258	def smart_resize(height: int, width: int, factor: int = RESIZE_FACTOR,
   259	                 min_pixels: int = MIN_PIXELS, max_pixels: int = MAX_PIXELS) -> tuple[int, int]:
   260	    """Same algorithm as LFM3-VL's image processor (Qwen2-VL style). Returns (h, w)."""
   261	    import math
   262	    h_bar = round(height / factor) * factor
   263	    w_bar = round(width / factor) * factor
   264	    if h_bar * w_bar > max_pixels:
   265	        beta = math.sqrt((height * width) / max_pixels)
   266	        h_bar = max(factor, math.floor(height / beta / factor) * factor)
   267	        w_bar = max(factor, math.floor(width / beta / factor) * factor)
   268	    elif h_bar * w_bar < min_pixels:
   269	        beta = math.sqrt(min_pixels / (height * width))
   270	        h_bar = math.ceil(height * beta / factor) * factor
   271	        w_bar = math.ceil(width * beta / factor) * factor
   272	    return h_bar, w_bar
   273	
   274	
   275	def resize_screenshot(img, max_pixels: int = MAX_PIXELS):
   276	    """PIL image -> RGB PIL image resized exactly as the model will see it."""
   277	    from PIL import Image
   278	    img = img.convert("RGB")
   279	    h, w = smart_resize(img.height, img.width, max_pixels=max_pixels)
   280	    if (w, h) != img.size:
   281	        img = img.resize((w, h), Image.BICUBIC)
   282	    return img
   283	
