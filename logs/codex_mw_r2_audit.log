   285	def _validate_strict(a):
   286	    t = a["action_type"]
   287	    allowed = {"click": {"point_2d"}, "long_press": {"point_2d"}, "input_text": {"text"}, "answer": {"text"},
   288	               "scroll": {"direction"}, "open_app": {"app_name"}, "status": {"goal_status"},
   289	               "navigate_back": set(), "navigate_home": set(), "keyboard_enter": set(), "wait": set()}
   290	    if t not in allowed or set(a) - {"action_type"} != allowed[t]:
   291	        return None
   292	    if t in POINT_TYPES:
   293	        p = a["point_2d"]
   294	        if not (isinstance(p, list) and len(p) == 2 and all(isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 1000 for v in p)):
   295	            return None
   296	    elif t in ("input_text", "answer", "open_app"):
   297	        if not isinstance(a[next(iter(allowed[t]))], str):
   298	            return None
   299	    elif t == "scroll" and (not isinstance(a["direction"], str) or a["direction"] not in _DIRECTIONS):
   300	        return None
   301	    elif t == "status" and (not isinstance(a["goal_status"], str) or a["goal_status"] not in ("complete", "infeasible")):
   302	        return None
   303	    return a
   304	
