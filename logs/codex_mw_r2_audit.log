    73	    c, p = classify(d), prior(t)
    74	    env_retries = sum(x in ("setup_failed", "scoring_failed") for x in p)
    75	    if c in ("unsupported_action", "invalid_model_output", "ask_user_without_simulator", "other_error"):
    76	        act = "final_failure"   # model's own output ended the task (other_error: flagged for manual review, no re-run)
    77	    elif c in ("setup_failed", "scoring_failed"):
    78	        act = "rerun" if env_retries == 0 else "final_failure"
    79	    else:
    80	        act = "rerun" if len(p) < 2 else "final_failure"
