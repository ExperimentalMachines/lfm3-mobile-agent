     1	#!/bin/bash
     2	# Mac-side driver for the MAI-UI-2B MobileWorld run (docs/PREREG_v4.md, 2026-11-19 05:20 entry). Starts only after the
     3	# GUI-Owl run is complete (guiowl_complete on the VM) so neither container is shared. MAI-UI's 105 tasks are split
     4	# alternately into two halves run in parallel: maiui_a on mobile_world_env_0 (model server tunnel 18093) and maiui_b on
     5	# lfmenv_0 (identical server, tunnel 18094); both write traj_logs/maiui_gui_en_r2. Each half is launched and completed by
     6	# mw_resume2.sh (= scripts/gcp_mw_resume_vm.sh: same completion rule as GUI-Owl and v4).
     7	#  * VM RUNNING: for each half that is neither complete nor running, restart its container (fresh emulator and services),
     8	#    wait until healthy and its model server answers, then start mw_resume2.sh for it.
     9	#  * VM stopped (12-h max-run limit / preemption): start it, start both containers, then as above.
    10	#  * gcloud unusable (expired login): wait and log every 30 min; nothing is started.
    11	# Exits when maiui_a_complete and maiui_b_complete exist (or after 20 h). Log: logs/gcp_mw_maiui_watch.log
    12	set -u
    13	cd /Users/alpha/lfm3-android
    14	source logs/gcp_mw_instance.env
    15	log() { echo "[$(date +%T)] $*"; }
    16	S() { ssh -o ConnectTimeout=15 -o BatchMode=yes -i "$PEM" "ubuntu@${IP}" "$@"; }
    17	status() { gcloud compute instances describe "$NAME" --zone "$ZONE" --format="value(status)" 2>/dev/null; }
    18	ctr() { [ "$1" = maiui_a ] && echo mobile_world_env_0 || echo lfmenv_0; }
    19	port() { [ "$1" = maiui_a ] && echo 18093 || echo 18094; }
    20	ep() { [ "$1" = maiui_a ] && echo mobile_world_env || echo lfmenv; }
    21	wait_ready() {  # $1 = half; container healthy + its model tunnel answering, up to 20 min
    22	  local t0=$(date +%s) c; c=$(ctr "$1")
    23	  until S "[ \"\$(sudo docker inspect -f '{{.State.Health.Status}}' $c)\" = healthy ] && curl -s -m 5 localhost:$(port "$1")/health | grep -q ok" 2>/dev/null; do
    24	    [ $(( $(date +%s) - t0 )) -gt 1200 ] && { log "$1: not ready after 20 min"; return 1; }
    25	    sleep 20
    26	  done
    27	}
    28	deploy() {  # idempotent: agent wrapper, resume script, the two task halves
    29	  scp -q -o BatchMode=yes -i "$PEM" eval/mobileworld/maiui_mw_agent.py "ubuntu@${IP}:lfm3/maiui_mw_agent.py" &&
    30	  scp -q -o BatchMode=yes -i "$PEM" scripts/gcp_mw_resume_vm.sh "ubuntu@${IP}:mw_resume2.sh" &&
    31	  S "python3 -c \"import json; t=json.load(open('mw_gui_en.json')); json.dump(t[0::2], open('mw_gui_en_maiui_a.json','w')); json.dump(t[1::2], open('mw_gui_en_maiui_b.json','w')); print(len(t[0::2]), len(t[1::2]))\""
    32	}
    33	T0=$(date +%s); last_auth_log=0; deployed=0
    34	log "MAI-UI watcher up (pid $$)"
    35	while [ $(( $(date +%s) - T0 )) -lt 72000 ]; do
    36	  st=$(status)
    37	  if [ -z "$st" ]; then
    38	    [ $(( $(date +%s) - last_auth_log )) -ge 1800 ] && { log "gcloud status unavailable (login expired?); waiting"; last_auth_log=$(date +%s); }
    39	  elif [ "$st" = RUNNING ]; then
    40	    if ! S "test -f guiowl_complete" 2>/dev/null; then sleep 120; continue; fi
    41	    [ "$deployed" = 1 ] || { deploy && deployed=1 && log "deployed agent, mw_resume2.sh and task halves"; }
    42	    done_all=1
    43	    for r in maiui_a maiui_b; do
    44	      if S "test -f ${r}_complete" 2>/dev/null; then continue; fi
    45	      done_all=0
    46	      busy=$(S "if pgrep -f 'mw [e]val.*--env_prefix $(ep $r) --log_file_root /home/ubuntu/traj_logs/maiui_gui_en_r2' >/dev/null || pgrep -f 'mw_resume2[.]sh $r' >/dev/null; then echo busy; else echo idle; fi" 2>/dev/null)
    47	      [ "$busy" = idle ] || continue
    48	      log "$r: not complete and nothing running -> restart $(ctr $r), then mw_resume2.sh $r"
    49	      S "sudo docker restart $(ctr $r) > /dev/null" && wait_ready $r &&
    50	        S "nohup bash mw_resume2.sh $r > ${r}_resume_\$(date +%H%M).log 2>&1 < /dev/null &" && log "started mw_resume2.sh $r"
    51	    done
    52	    [ "$deployed" = 1 ] && [ "$done_all" = 1 ] && { log "both MAI-UI halves complete"; exit 0; }
    53	  elif [ "$st" = TERMINATED ] || [ "$st" = STOPPED ]; then
    54	    # the GUI-Owl watcher (gcp_mw_resume_watch.sh) restarts the VM while GUI-Owl is incomplete; after that, this one does
    55	    if pgrep -f "[g]cp_mw_resume_watch.sh" > /dev/null; then sleep 120; continue; fi
    56	    log "VM is $st -> starting it"
    57	    gcloud compute instances start "$NAME" --zone "$ZONE" --quiet > /dev/null 2>&1 || { log "start failed; retrying in 2 min"; sleep 120; continue; }
    58	    t0=$(date +%s); until S true 2>/dev/null; do sleep 10; [ $(( $(date +%s) - t0 )) -gt 900 ] && break; done
    59	    S "sudo docker start mobile_world_env_0 lfmenv_0 > /dev/null" && log "VM and containers started"
    60	    continue
    61	  fi
    62	  sleep 120
    63	done
