   326	    def _convert_to_json_action(
   327	        self, tool_name: str, action_json: dict, obs_image: Any
   328	    ) -> JSONAction:
   329	        if tool_name != "mobile_use":
   330	            return JSONAction(
   331	                action_type=MCP,
   332	                action_name=tool_name,
   333	                action_json=action_json,
   334	            )
   335	
   336	        action_type = action_json.get("action", UNKNOWN)
   337	
   338	        if action_type in ("click", "long_press", "double_click"):
   339	            coordinate = action_json.get("coordinate")
   340	            if not coordinate:
   341	                raise ValueError(f"Missing coordinate for {action_type}")
   342	            x, y = self._normalize_coord_to_pixel(coordinate, obs_image)
   343	            type_map = {"click": CLICK, "long_press": LONG_PRESS, "double_click": DOUBLE_TAP}
   344	            return JSONAction(action_type=type_map[action_type], x=x, y=y)
   345	
   346	        if action_type == "swipe":
   347	            direction = reverse_swipe_direction(action_json.get("direction", "up"))
   348	            coordinate = action_json.get("coordinate")
   349	            if coordinate:
   350	                x, y = self._normalize_coord_to_pixel(coordinate, obs_image)
   351	                return JSONAction(action_type=SCROLL, direction=direction, x=x, y=y)
   352	            return JSONAction(action_type=SCROLL, direction=direction)
   353	
   354	        if action_type == "drag":
   355	            start_coord = action_json.get("start_coordinate", [0, 0])
   356	            end_coord = action_json.get("end_coordinate", [0, 0])
   357	            start_x, start_y = self._normalize_coord_to_pixel(start_coord, obs_image)
   358	            end_x, end_y = self._normalize_coord_to_pixel(end_coord, obs_image)
   359	            return JSONAction(
   360	                action_type=DRAG,
   361	                start_x=start_x,
   362	                start_y=start_y,
   363	                end_x=end_x,
   364	                end_y=end_y,
   365	            )
   366	
   367	        if action_type == "system_button":
   368	            button = action_json.get("button", "").lower()
   369	            button_map = {"back": NAVIGATE_BACK, "home": NAVIGATE_HOME, "enter": KEYBOARD_ENTER}
   370	            if button in button_map:
   371	                return JSONAction(action_type=button_map[button])
   372	            return JSONAction(action_type=UNKNOWN, text=f"Unknown button: {button}")
   373	
   374	        if action_type == "type":
   375	            return JSONAction(action_type=INPUT_TEXT, text=action_json.get("text", ""))
   376	
   377	        if action_type == "open":
   378	            return JSONAction(action_type=OPEN_APP, app_name=action_json.get("text", ""))
   379	
   380	        if action_type == "terminate":
   381	            return JSONAction(action_type=FINISHED, text=action_json.get("status", "success"))
   382	
   383	        if action_type == "answer":
   384	            return JSONAction(action_type=ANSWER, text=action_json.get("text", ""))
   385	
   386	        if action_type == "ask_user":
   387	            return JSONAction(action_type=ASK_USER, text=action_json.get("text", ""))
   388	
   389	        if action_type == "wait":
   390	            return JSONAction(action_type=WAIT)
   391	
   392	        return JSONAction(action_type=UNKNOWN, text=f"Unknown action: {action_type}")
   393	
