    35	
    36	def parse_tagged_text(text: str) -> dict[str, Any]:
    37	    """Parse text containing XML-style tags to extract thinking and tool_call content."""
    38	    if "</think>" in text and "</thinking>" not in text:
    39	        text = text.replace("</think>", "</thinking>")
    40	        text = "<thinking>" + text
    41	
    42	    pattern = r"<thinking>(.*?)</thinking>.*?<tool_call>(.*?)</tool_call>"
    43	
    44	    result: dict[str, Any] = {
    45	        "thinking": None,
    46	        "tool_call": None,
    47	    }
    48	
    49	    match = re.search(pattern, text, re.DOTALL)
    50	    if match:
    51	        result = {
    52	            "thinking": match.group(1).strip().strip('"'),
    53	            "tool_call": match.group(2).strip().strip('"'),
    54	        }
    55	
    56	    if result["tool_call"]:
    57	        try:
    58	            result["tool_call"] = json.loads(result["tool_call"])
    59	        except json.JSONDecodeError as e:
    60	            raise ValueError(f"Invalid JSON in tool_call: {e}")
    61	
    62	    return result
    63	
    64	
    65	def parse_action_to_structure_output(text: str) -> dict[str, Any]:
    66	    """Parse model output text into structured action format with normalized coordinates."""
    67	    text = text.strip()
    68	
    69	    results = parse_tagged_text(text)
    70	    thinking = results["thinking"]
    71	    tool_call = results["tool_call"]
    72	
    73	    # Handle MCP tool calls (non-mobile_use)
    74	    tool_name = tool_call.get("name", "mobile_use")
    75	    if tool_name != "mobile_use":
    76	        return {
    77	            "thinking": thinking,
    78	            "tool_name": tool_name,
    79	            "action_json": tool_call.get("arguments", {}),
    80	        }
    81	
    82	    action = tool_call["arguments"]
    83	
    84	    for coord_field in ["coordinate", "start_coordinate", "end_coordinate"]:
    85	        if coord_field in action:
    86	            coordinates = action[coord_field]
    87	
    88	            if len(coordinates) == 2:
    89	                point_x, point_y = coordinates
    90	            elif len(coordinates) == 4:
    91	                x1, y1, x2, y2 = coordinates
    92	                point_x = (x1 + x2) / 2
    93	                point_y = (y1 + y2) / 2
    94	            else:
    95	                raise ValueError(
    96	                    f"Invalid coordinate format: expected 2 or 4 values, got {len(coordinates)}"
    97	                )
    98	
    99	            point_x = point_x / SCALE_FACTOR
   100	            point_y = point_y / SCALE_FACTOR
   101	
   102	            action[coord_field] = [point_x, point_y]
   103	
   104	    return {
   105	        "thinking": thinking,
   106	        "tool_name": "mobile_use",
   107	        "action_json": action,
   108	    }
