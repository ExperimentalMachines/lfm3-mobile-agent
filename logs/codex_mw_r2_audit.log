     1	#!/bin/bash
     2	# Runs ON the GCP MobileWorld VM. Completes one run-2 MobileWorld run with the SAME command and flags, under a rule fixed
     3	# on 2026-11-19 01:55 (before any re-run outcome) that applies to every model's run:
     4	#   never started (no task folder)                 -> run it (e.g. the VM stopped before reaching it)
     5	#   environment failure, no result.txt:
     6	#     task setup failed (/task/init 500, "Failed to initialize task") or scoring failed (/task/eval 500,
     7	#     "Failed to get task score")                  -> ONE more attempt in a fresh container
     8	#     interrupted with no error (VM stop/preemption) -> another attempt (at most 2 moved copies per task)
     9	#   the model's own output ended the task: an action the runtime rejects ("Unknown action_type") or output the official
    10	#   agent could not parse after its retries ("error_env") -> counted as a failure, not re-run
    11	#   the model called ask_user, whose simulated user needs an LLM API key this setup does not have ("Step action failed",
    12	#   401) -> counted as a failure, not re-run (temperature 0 repeats the call); disclosed
    13	#   any other error -> counted as a failure, not re-run, flagged for manual review
    14	# Each replaced folder is moved to traj_logs/_interrupted/<run>/<task>_<timestamp> (kept, never mixed into the run);
    15	# decisions are appended to traj_logs/_retry_manifest_<run>.jsonl. Writes <run>_complete when nothing is left to do.
    16	# Usage: bash mw_resume.sh guiowl|v4|maiui_a|maiui_b [--dry-run]   (deployed for MAI-UI as /home/ubuntu/mw_resume2.sh)
    17	set -u
    18	cd /home/ubuntu
    19	RUN=$1; DRY=${2:-}; TASKS=/home/ubuntu/mw_gui_en.json
    20	case $RUN in
    21	  guiowl) LOG=traj_logs/guiowl_gui_en_r2
    22	          CMD=(sudo /home/ubuntu/.local/bin/uv run mw eval --agent_type gui_owl_1_5 --model_name GUI-Owl-1.5-2B
    23	               --llm_base_url http://127.0.0.1:18092/v1 --max_round 50 --step_wait_time 3 --auto_retry 3
    24	               --env_prefix mobile_world_env --log_file_root /home/ubuntu/$LOG) ;;
    25	  v4)     LOG=traj_logs/v4_gui_en_r2
    26	          CMD=(sudo LFM3_PROMPT_VERSION=v4 LFM3_AGENT_FORMAT_DIR=/home/ubuntu/lfm3 /home/ubuntu/.local/bin/uv run mw eval
    27	               --agent_type /home/ubuntu/lfm3/lfm3_mw_agent.py --model_name local --llm_base_url http://127.0.0.1:18094/v1
    28	               --max_round 50 --step_wait_time 3 --auto_retry 3 --env_prefix lfmenv --log_file_root /home/ubuntu/$LOG) ;;
    29	  maiui_a|maiui_b)   # MAI-UI-2B Q8_0, official MobileWorld agent with one screenshot (eval/mobileworld/maiui_mw_agent.py);
    30	          # the 105 tasks are split alternately (mw_gui_en_maiui_a/b.json), half a on mobile_world_env_0 with the server on
    31	          # tunnel 18093, half b on lfmenv_0 with an identical server on 18094; one shared log root
    32	          LOG=traj_logs/maiui_gui_en_r2; TASKS=/home/ubuntu/mw_gui_en_$RUN.json
    33	          if [ $RUN = maiui_a ]; then EP=mobile_world_env; PORT=18093; else EP=lfmenv; PORT=18094; fi
    34	          CMD=(sudo /home/ubuntu/.local/bin/uv run mw eval --agent_type /home/ubuntu/lfm3/maiui_mw_agent.py --model_name MAI-UI-2B
    35	               --llm_base_url http://127.0.0.1:$PORT/v1 --max_round 50 --step_wait_time 3 --auto_retry 3 --env_prefix $EP
    36	               --log_file_root /home/ubuntu/$LOG) ;;
    37	  *) echo "usage: $0 guiowl|v4|maiui_a|maiui_b [--dry-run]"; exit 2 ;;
    38	esac
    39	PAT="mw eval.*--log_file_root /home/ubuntu/$LOG"
    40	case $RUN in maiui_*) PAT="mw eval.*--env_prefix $EP --log_file_root /home/ubuntu/$LOG" ;; esac   # the two halves share LOG
    41	[ "$DRY" != --dry-run ] && pgrep -f "$PAT" >/dev/null && { echo "[$(date +%T)] $RUN eval still running; refusing"; exit 1; }
    42	PLAN=$(sudo python3 - "$RUN" "$LOG" "$DRY" "$TASKS" <<'PY'
    43	import glob, json, os, shutil, sys, time
    44	run, log, dry = sys.argv[1], sys.argv[2], sys.argv[3] == "--dry-run"
    45	tasks = json.load(open(sys.argv[4]))
    46	moved_root = f"/home/ubuntu/traj_logs/_interrupted/{run}"
    47	man = f"/home/ubuntu/traj_logs/_retry_manifest_{run}.jsonl"
    48	ts = time.strftime("%Y%m%d_%H%M%S")
    49	def classify(d):
    50	    # judged on the text after the runner's LAST "Error executing task" (the attempt that ended the task)
    51	    txt = "".join(open(f, errors="ignore").read() for f in sorted(glob.glob(d + "/*.log")))
    52	    if "Error executing task" not in txt:
    53	        return "interrupted"
    54	    seg = txt[txt.rindex("Error executing task"):]
    55	    if "Failed to initialize task" in seg: return "setup_failed"
    56	    if "Failed to get task score" in seg: return "scoring_failed"
    57	    if "Unknown action_type" in seg: return "unsupported_action"
    58	    if "error_env" in seg or "Failed to parse tool_call" in seg: return "invalid_model_output"
    59	    if "Step action failed" in seg and "API key" in seg: return "ask_user_without_simulator"
    60	    return "other_error"
    61	def prior(t):
