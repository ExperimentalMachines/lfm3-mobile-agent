   262	    def predict(self, observation: dict[str, Any]) -> tuple[str, JSONAction]:
   263	        """
   264	        Generate the next action based on current observation.
   265	
   266	        Args:
   267	            observation: Observation containing screenshot, tool_call, ask_user_response
   268	
   269	        Returns:
   270	            Tuple of (raw_response, JSONAction)
   271	        """
   272	        obs_image = observation["screenshot"]
   273	        tool_call = observation.get("tool_call", None)
   274	        ask_user_response = observation.get("ask_user_response", None)
   275	
   276	        self.history_images.append((obs_image, tool_call, ask_user_response))
   277	
   278	        logger.debug(f"Current history images count: {len(self.history_images)}")
   279	        logger.debug(f"Current history responses count: {len(self.history_responses)}")
   280	
   281	        assert len(self.history_images) == len(self.history_responses) + 1
   282	
   283	        messages = self._build_messages(obs_image, tool_call, ask_user_response)
   284	        pretty_print_messages(messages, max_messages=10)
   285	        logger.debug("*" * 100)
   286	        prediction = self.openai_chat_completions_create(
   287	            model=self.model_name,
   288	            messages=messages,
   289	            retry_times=3,
   290	            max_tokens=self.max_tokens,
   291	            temperature=self.temperature,
   292	            top_p=self.top_p,
   293	        )
   294	
   295	        if prediction is None:
   296	            raise ValueError("Planner LLM failed")
   297	        logger.info(f"Raw LLM response:\n{prediction}")
   298	        try:
   299	            parsed_response = parse_action_to_structure_output(prediction)
   300	            thinking = parsed_response["thinking"]
   301	            tool_name = parsed_response.get("tool_name", "mobile_use")
   302	            action_json = parsed_response["action_json"]
   303	
   304	            logger.info(f"Parsed thinking: {thinking}")
   305	            logger.info(f"Parsed tool_name: {tool_name}")
   306	            logger.info(f"Parsed action: {action_json}")
   307	
   308	        except Exception as e:
   309	            logger.error(f"Error parsing LLM response: {e}")
   310	            traceback.print_exc()
   311	            return "Parsing error", JSONAction(action_type=UNKNOWN, text=str(e))
   312	        self.history_responses.append({"role": "assistant", "content": prediction})
   313	
   314	        json_action = self._convert_to_json_action(tool_name, action_json, obs_image)
   315	
   316	        return prediction, json_action
