   228	    def _build_messages(self, obs_image: Any, tool_call: Any, ask_user_response: Any) -> list[dict]:
   229	        """Build the message list for the LLM API call."""
   230	        messages = [
   231	            {
   232	                "role": "system",
   233	                "content": self.system_prompt,
   234	            },
   235	            {
   236	                "role": "user",
   237	                "content": [{"type": "text", "text": self.instruction}],
   238	            },
   239	            self._get_user_message(
   240	                self.history_images[0][0], self.history_images[0][1], self.history_images[0][2]
   241	            ),
   242	        ]
   243	
   244	        for i, history_resp in enumerate(self.history_responses):
   245	            history_img_data, tool_call_res, ask_user_response_res = self.history_images[i + 1]
   246	
   247	            user_message = self._get_user_message(
   248	                history_img_data, tool_call_res, ask_user_response_res
   249	            )
   250	
   251	            response_message = {
   252	                "role": "assistant",
   253	                "content": history_resp.get("content", ""),
   254	            }
   255	
   256	            messages.append(response_message)
   257	            messages.append(user_message)
   258	
   259	        messages = self._hide_history_images(messages)
   260	        return messages
