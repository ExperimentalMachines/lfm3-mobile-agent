   111	class MAIUINaivigationAgent(MCPAgent):
   112	    """Mobile automation agent using vision-language models."""
   113	
   114	    def __init__(
   115	        self,
   116	        llm_base_url: str,
   117	        model_name: str,
   118	        api_key: str = "empty",
   119	        runtime_conf: dict[str, Any] | None = {},
   120	        **kwargs,
   121	    ):
   122	        """
   123	        Initialize the MAIUINaivigationAgent.
   124	
   125	        Args:
   126	            llm_base_url: Base URL for the LLM API endpoint.
   127	            model_name: Name of the model to use.
   128	            api_key: API key for the LLM service.
   129	            runtime_conf: Optional configuration dictionary.
   130	        """
   131	        super().__init__(**kwargs)
   132	
   133	        # Set default configuration
   134	        default_conf = {
   135	            "history_n": 3,
   136	            "temperature": 0.0,
   137	            "top_k": -1,
   138	            "top_p": 1.0,
   139	            "max_tokens": 2048,
   140	        }
   141	        self.runtime_conf = {**default_conf, **runtime_conf}
   142	
   143	        self.llm_base_url = llm_base_url
   144	        self.model_name = model_name
   145	        self.api_key = api_key
   146	        self.build_openai_client(self.llm_base_url, self.api_key)
   147	
   148	        # Extract frequently used config values
   149	        self.temperature = self.runtime_conf["temperature"]
   150	        self.top_k = self.runtime_conf["top_k"]
   151	        self.top_p = self.runtime_conf["top_p"]
   152	        self.max_tokens = self.runtime_conf["max_tokens"]
   153	        self.history_n = self.runtime_conf["history_n"]
   154	
   155	        # History tracking
   156	        self.history_images: list[
   157	            tuple[Any, Any, Any]
   158	        ] = []  # (image, tool_call, ask_user_response)
   159	        self.history_responses: list[dict] = []
   160	
   161	    @property
   162	    def system_prompt(self) -> str:
   163	        """Generate the system prompt based on available MCP tools."""
   164	        mcp_tools_str = None
   165	        if self.tools:
   166	            mcp_tools_str = "\n".join([json.dumps(tool, ensure_ascii=False) for tool in self.tools])
   167	        return MAI_MOBILE_SYS_PROMPT_ASK_USER_MCP.render(tools=mcp_tools_str)
   168	
   169	    def initialize_hook(self, instruction: str) -> None:
   170	        """Hook for initializing the agent with instruction."""
   171	        logger.info(f"Initializing MAI UI agent with instruction: {instruction}")
   172	        self.reset()
   173	
   174	    def _get_user_message(
   175	        self, img_data: Any, tool_call_res: Any, ask_user_response_res: Any
   176	    ) -> dict:
   177	        """Build user message based on available data."""
   178	        if tool_call_res is not None:
   179	            return {
   180	                "role": "user",
   181	                "content": [{"type": "text", "text": f"Tool call result: {tool_call_res}"}],
   182	            }
   183	        elif ask_user_response_res is not None:
   184	            return {
   185	                "role": "user",
   186	                "content": [{"type": "text", "text": ask_user_response_res}],
   187	            }
   188	        else:
   189	            encoded_string = pil_to_base64(img_data)
   190	            return {
   191	                "role": "user",
   192	                "content": [
   193	                    {
   194	                        "type": "image_url",
   195	                        "image_url": {"url": f"data:image/png;base64,{encoded_string}"},
   196	                    }
   197	                ],
   198	            }
   199	
   200	    def _hide_history_images(self, messages: list[dict]) -> list[dict]:
   201	        """
   202	        Limit the number of images sent to the model by removing older image messages.
   203	        Keep only the most recent history_n images.
   204	
   205	        Args:
   206	            messages: List of message dicts
   207	
   208	        Returns:
   209	            Modified messages with limited images
   210	        """
   211	        # Collect indices of messages that contain images (from back to front)
   212	        image_message_indices = []
   213	        for i in range(len(messages) - 1, -1, -1):
   214	            if (
   215	                messages[i]["role"] == "user"
   216	                and len(messages[i]["content"]) > 0
   217	                and messages[i]["content"][0]["type"] == "image_url"
   218	            ):
   219	                image_message_indices.append(i)
   220	
   221	        indices_to_remove = sorted(image_message_indices[self.history_n :], reverse=True)
   222	
   223	        for idx in indices_to_remove:
   224	            del messages[idx]
   225	
   226	        return messages
   227	
   228	    def _build_messages(self, obs_image: Any, tool_call: Any, ask_user_response: Any) -> list[dict]:
   229	        """Build the message list for the LLM API call."""
   230	        messages = [
   231	            {
   232	                "role": "system",
   233	                "content": self.system_prompt,
   234	            },
   235	            {
   236	                "role": "user",
   237	                "content": [{"type": "text", "text": self.instruction}],
   238	            },
   239	            self._get_user_message(
   240	                self.history_images[0][0], self.history_images[0][1], self.history_images[0][2]
   241	            ),
   242	        ]
   243	
   244	        for i, history_resp in enumerate(self.history_responses):
   245	            history_img_data, tool_call_res, ask_user_response_res = self.history_images[i + 1]
   246	
   247	            user_message = self._get_user_message(
   248	                history_img_data, tool_call_res, ask_user_response_res
   249	            )
   250	
   251	            response_message = {
   252	                "role": "assistant",
   253	                "content": history_resp.get("content", ""),
   254	            }
   255	
   256	            messages.append(response_message)
   257	            messages.append(user_message)
   258	
   259	        messages = self._hide_history_images(messages)
   260	        return messages
   261	
   262	    def predict(self, observation: dict[str, Any]) -> tuple[str, JSONAction]:
   263	        """
   264	        Generate the next action based on current observation.
   265	
   266	        Args:
   267	            observation: Observation containing screenshot, tool_call, ask_user_response
   268	
   269	        Returns:
   270	            Tuple of (raw_response, JSONAction)
   271	        """
   272	        obs_image = observation["screenshot"]
   273	        tool_call = observation.get("tool_call", None)
   274	        ask_user_response = observation.get("ask_user_response", None)
   275	
   276	        self.history_images.append((obs_image, tool_call, ask_user_response))
   277	
   278	        logger.debug(f"Current history images count: {len(self.history_images)}")
   279	        logger.debug(f"Current history responses count: {len(self.history_responses)}")
   280	
