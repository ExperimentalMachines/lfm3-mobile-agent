   252	    shuffle_tasks: bool = False,
   253	    auto_retry: int = 10,
   254	    **kwargs,
   255	) -> list[dict]:
   256	    """Run the agent and return the evaluation results.
   257	
   258	    Args:
   259	        agent_type: Type of agent to use
   260	        model_name: Model name for the agent
   261	        llm_base_url: LLM service base URL
   262	        log_file_root: Root directory for log files
   263	        tasks: List of task names to execute (empty list for all tasks)
   264	        max_step: Maximum steps for task execution
   265	        aw_urls: List of Android World backend URLs. If None, auto-discover from containers
   266	        api_key: API key for LLM service
   267	        device: Android device ID
   268	        step_wait_time: Wait time after each step
   269	        suite_family: Suite family to use
   270	        **kwargs: Additional kwargs for agent creation
   271	
   272	    Returns:
   273	        list[dict]: The evaluation results for each task, containing task_name, success, score, steps, duration_seconds, env_url
   274	    """
   275	
   276	    container_names = None
   277	    if aw_urls is None or len(aw_urls) == 0:
