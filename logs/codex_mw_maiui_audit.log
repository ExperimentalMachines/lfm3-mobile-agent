     1	#!/bin/bash
     2	# Runs ON the GCP MobileWorld VM. Completes one run-2 MobileWorld run with the SAME command and flags, under a rule fixed
     3	# on 2026-11-19 01:55 (before any re-run outcome) that applies to every model's run:
     4	#   never started (no task folder)                 -> run it (e.g. the VM stopped before reaching it)
     5	#   environment failure, no result.txt:
     6	#     task setup failed (/task/init 500, "Failed to initialize task") or scoring failed (/task/eval 500,
     7	#     "Failed to get task score")                  -> ONE more attempt in a fresh container
     8	#     interrupted with no error (VM stop/preemption) -> another attempt (at most 2 moved copies per task)
     9	#   the model's own output ended the task: an action the runtime rejects ("Unknown action_type") or output the official
    10	#   agent could not parse after its retries ("error_env") -> counted as a failure, not re-run
    11	#   the model called ask_user, whose simulated user needs an LLM API key this setup does not have ("Step action failed",
    12	#   401) -> counted as a failure, not re-run (temperature 0 repeats the call); disclosed
    13	#   any other error -> counted as a failure, not re-run, flagged for manual review
    14	#   model server unreachable (agent's LLM call failed after its retries with a connection-type error: "Planner LLM
    15	#   failed" + Connection error/refused/timed out/HTTP 502-504) -> infrastructure, handled like "interrupted" (added
    16	#   2026-11-19 10:20 before any MAI-UI task ran; never occurred in the GUI-Owl or v4 runs, so their decisions are unchanged)
    17	# Each replaced folder is moved to traj_logs/_interrupted/<run>/<task>_<timestamp> (kept, never mixed into the run);
    18	# decisions are appended to traj_logs/_retry_manifest_<run>.jsonl. Task lists are validated; <run>_complete is written
    19	# (atomically, with every final disposition logged) only when a successfully parsed fresh plan has nothing left to attempt.
    20	# "ONE more attempt" = one more mw eval invocation, inside which MobileWorld's --auto_retry 3 allows up to 4 executions
    21	# (as v4 received for ThanksgivingPrepTask); the same for every model (PREREG 2026-11-19 05:45).
    22	# Usage: bash mw_resume.sh guiowl|v4|maiui_a|maiui_b [--dry-run]   (deployed for MAI-UI as /home/ubuntu/mw_resume2.sh)
    23	set -u
    24	cd /home/ubuntu
    25	RUN=$1; DRY=${2:-}; TASKS=/home/ubuntu/mw_gui_en.json
    26	case $RUN in
    27	  guiowl) LOG=traj_logs/guiowl_gui_en_r2
    28	          CMD=(sudo /home/ubuntu/.local/bin/uv run mw eval --agent_type gui_owl_1_5 --model_name GUI-Owl-1.5-2B
    29	               --llm_base_url http://127.0.0.1:18092/v1 --max_round 50 --step_wait_time 3 --auto_retry 3
    30	               --env_prefix mobile_world_env --log_file_root /home/ubuntu/$LOG) ;;
    31	  v4)     LOG=traj_logs/v4_gui_en_r2
    32	          CMD=(sudo LFM3_PROMPT_VERSION=v4 LFM3_AGENT_FORMAT_DIR=/home/ubuntu/lfm3 /home/ubuntu/.local/bin/uv run mw eval
    33	               --agent_type /home/ubuntu/lfm3/lfm3_mw_agent.py --model_name local --llm_base_url http://127.0.0.1:18094/v1
    34	               --max_round 50 --step_wait_time 3 --auto_retry 3 --env_prefix lfmenv --log_file_root /home/ubuntu/$LOG) ;;
    35	  maiui_a|maiui_b)   # MAI-UI-2B Q8_0, official MobileWorld agent with one screenshot (eval/mobileworld/maiui_mw_agent.py);
    36	          # the 105 tasks are split alternately (mw_gui_en_maiui_a/b.json), half a on mobile_world_env_0 with the server on
    37	          # tunnel 18093, half b on lfmenv_0 with an identical server on 18094; one shared log root
    38	          LOG=traj_logs/maiui_gui_en_r2; TASKS=/home/ubuntu/mw_gui_en_$RUN.json
    39	          if [ $RUN = maiui_a ]; then EP=mobile_world_env; PORT=18093; else EP=lfmenv; PORT=18094; fi
    40	          CMD=(sudo /home/ubuntu/.local/bin/uv run mw eval --agent_type /home/ubuntu/lfm3/maiui_mw_agent.py --model_name MAI-UI-2B
    41	               --llm_base_url http://127.0.0.1:$PORT/v1 --max_round 50 --step_wait_time 3 --auto_retry 3 --env_prefix $EP
    42	               --log_file_root /home/ubuntu/$LOG) ;;
    43	  *) echo "usage: $0 guiowl|v4|maiui_a|maiui_b [--dry-run]"; exit 2 ;;
    44	esac
    45	PAT="mw eval.*--log_file_root /home/ubuntu/$LOG"
    46	case $RUN in maiui_*) PAT="mw eval.*--env_prefix $EP --log_file_root /home/ubuntu/$LOG" ;; esac   # the two halves share LOG
    47	[ "$DRY" != --dry-run ] && pgrep -f "$PAT" >/dev/null && { echo "[$(date +%T)] $RUN eval still running; refusing"; exit 1; }
