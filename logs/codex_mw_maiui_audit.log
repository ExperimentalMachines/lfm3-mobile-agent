    49	sudo python3 - "$RUN" "$LOG" "$1" "$TASKS" <<'PY'
    50	import glob, json, os, re, shutil, sys, time
    51	run, log, dry, tf = sys.argv[1], sys.argv[2], sys.argv[3] == "--dry-run", sys.argv[4]
    52	manifest = json.load(open("/home/ubuntu/mw_gui_en.json"))
    53	assert len(manifest) == 105 and len(set(manifest)) == 105, "task manifest is not 105 unique tasks"
    54	tasks = json.load(open(tf))
    55	assert isinstance(tasks, list) and tasks and all(isinstance(t, str) for t in tasks), "bad task file " + tf
    56	if run.startswith("maiui_"):   # the two halves must be exactly the alternate split of the manifest (53 + 52, disjoint)
    57	    a = json.load(open("/home/ubuntu/mw_gui_en_maiui_a.json")); b = json.load(open("/home/ubuntu/mw_gui_en_maiui_b.json"))
    58	    assert a == manifest[0::2] and b == manifest[1::2], "MAI-UI halves are not the alternate split of the manifest"
    59	else:
    60	    assert tasks == manifest, "task file differs from the manifest"
    61	moved_root = f"/home/ubuntu/traj_logs/_interrupted/{run}"
    62	man = f"/home/ubuntu/traj_logs/_retry_manifest_{run}.jsonl"
    63	ts = time.strftime("%Y%m%d_%H%M%S")
    64	def has_result(d):
    65	    f = os.path.join(d, "result.txt")
    66	    return os.path.isfile(f) and re.search(r"score:\s*[0-9.]+", open(f, errors="ignore").read()) is not None
    67	def classify(d):
    68	    # judged on the text after the runner's LAST "Error executing task" (the attempt that ended the task)
    69	    txt = "".join(open(f, errors="ignore").read() for f in sorted(glob.glob(d + "/*.log")))
    70	    if "Error executing task" not in txt:
    71	        return "interrupted"
    72	    i = txt.rindex("Error executing task")
    73	    seg, pre = txt[i:], txt[max(0, i - 6000):i]
    74	    if "Failed to initialize task" in seg: return "setup_failed"
    75	    if "Failed to get task score" in seg: return "scoring_failed"
    76	    # the model server itself was unreachable (e.g. the GPU session ended): the agent's LLM call failed after its
    77	    # retries with a connection-type error, so the model never answered -> infrastructure, handled like "interrupted".
    78	    # The agent logs its 3 "Error calling OpenAI API: <error>" warnings immediately BEFORE the runner's
    79	    # "Error executing task" (raised as "Planner LLM failed"), so they are read from `pre`.
    80	    # Other API errors (e.g. HTTP 400) stay other_error (final failure, manual review).
    81	    if "Planner LLM failed" in seg and any(s in pre for s in ("Error calling OpenAI API: Connection error",
    82	            "Error calling OpenAI API: Request timed out", "Connection refused",
    83	            "Error calling OpenAI API: Error code: 502", "Error calling OpenAI API: Error code: 503",
    84	            "Error calling OpenAI API: Error code: 504")):
    85	        return "model_server_unreachable"
    86	    if "Unknown action_type" in seg: return "unsupported_action"
    87	    if "error_env" in seg or "Failed to parse tool_call" in seg: return "invalid_model_output"
    88	    if "Step action failed" in seg and "API key" in seg: return "ask_user_without_simulator"
    89	    return "other_error"
    90	def prior(t):
    91	    return [classify(f) for f in sorted(glob.glob(os.path.join(moved_root, t + "_2*")))]
    92	todo, decisions, n_res = [], [], 0
    93	for t in tasks:
    94	    d = os.path.join(log, t)
    95	    if has_result(d):
    96	        n_res += 1; continue
    97	    if not os.path.isdir(d):
    98	        todo.append(t); decisions.append({"task": t, "category": "never_started", "action": "run"}); continue
    99	    c, p = classify(d), prior(t)
   100	    env_retries = sum(x in ("setup_failed", "scoring_failed") for x in p)
   101	    if c in ("unsupported_action", "invalid_model_output", "ask_user_without_simulator", "other_error"):
   102	        act = "final_failure"   # model's own output ended the task (other_error: flagged for manual review, no re-run)
   103	    elif c in ("setup_failed", "scoring_failed"):
   104	        act = "rerun" if env_retries == 0 else "final_failure"
   105	    else:
   106	        act = "rerun" if len(p) < 2 else "final_failure"
   107	    decisions.append({"task": t, "category": c, "prior_attempts_moved": p, "action": act})
   108	    if act == "rerun":
   109	        todo.append(t)
   110	        if not dry:
   111	            os.makedirs(moved_root, exist_ok=True)
   112	            shutil.move(d, os.path.join(moved_root, f"{t}_{ts}"))
   113	assert n_res + len(decisions) == len(tasks)
   114	if not dry:
   115	    with open(man, "a") as f:
   116	        for x in decisions:
   117	            f.write(json.dumps({"time": ts, **x}) + "\n")
   118	print(json.dumps({"todo": todo, "decisions": decisions, "n_tasks": len(tasks), "with_result": n_res}))
   119	PY
   120	}
   121	field() { python3 -c "import json,sys; d=json.load(sys.stdin); $1"; }
   122	PLAN=$(plan "$DRY") || { echo "[$(date +%T)] $RUN: planning FAILED (task files / planner); nothing run, not complete"; exit 1; }
   123	TODO=$(echo "$PLAN" | field "print(','.join(d['todo']))") || { echo "[$(date +%T)] $RUN: unreadable plan; stopping"; exit 1; }
   124	echo "[$(date +%T)] $RUN plan: $(echo "$PLAN" | field "print('; '.join(x['task']+':'+x['category']+'->'+x['action'] for x in d['decisions']) or 'nothing')")"
