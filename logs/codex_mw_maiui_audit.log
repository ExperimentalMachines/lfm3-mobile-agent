   126	if [ -n "$TODO" ]; then
   127	  date +%s >> ${RUN}_resume.start
   128	  (cd MobileWorld && "${CMD[@]}" --task "$TODO")
   129	fi
   130	# complete only if a fresh, successfully parsed plan has nothing left to attempt and accounts for every task
   131	P2=$(plan --dry-run) || { echo "[$(date +%T)] $RUN: completion check FAILED; not complete"; exit 1; }
   132	LEFT=$(echo "$P2" | field "assert d['with_result'] + len(d['decisions']) == d['n_tasks']; print(len(d['todo']))") || { echo "[$(date +%T)] $RUN: bad completion plan"; exit 1; }
   133	if [ "$LEFT" = 0 ]; then
   134	  echo "$P2" | field "import time; t=time.strftime('%Y%m%d_%H%M%S'); [print(json.dumps({'time': t, 'final_disposition': True, **x})) for x in d['decisions']]" | sudo tee -a traj_logs/_retry_manifest_$RUN.jsonl > /dev/null
   135	  date +%s > ${RUN}_complete.tmp && mv ${RUN}_complete.tmp ${RUN}_complete && echo "[$(date +%T)] $RUN complete"
   136	else
   137	  echo "[$(date +%T)] $RUN: $LEFT tasks still need an attempt"
   138	fi
     1	#!/bin/bash
     2	# Mac-side driver for the MAI-UI-2B MobileWorld run (docs/PREREG_v4.md, 2026-11-19 05:20 entry). Starts only after the
     3	# GUI-Owl and v4 runs are complete (guiowl_complete, v4_complete on the VM) so neither container is shared. A half is
     4	# launched only after its container is healthy AND check_maiui_server.py confirms its tunnel serves MAI-UI Q8_0. MAI-UI's 105 tasks are split
     5	# alternately into two halves run in parallel: maiui_a on mobile_world_env_0 (model server tunnel 18093) and maiui_b on
     6	# lfmenv_0 (identical server, tunnel 18094); both write traj_logs/maiui_gui_en_r2. Each half is launched and completed by
     7	# mw_resume2.sh (= scripts/gcp_mw_resume_vm.sh: same completion rule as GUI-Owl and v4).
     8	#  * VM RUNNING: for each half that is neither complete nor running, restart its container (fresh emulator and services),
     9	#    wait until healthy and its model server answers, then start mw_resume2.sh for it.
    10	#  * VM stopped (12-h max-run limit / preemption): start it, start both containers, then as above.
    11	#  * gcloud unusable (expired login): wait and log every 30 min; nothing is started.
    12	#  * model-server guard (2026-11-19 10:20): a half is (re)launched only while its tunnel serves MAI-UI Q8_0; a running
    13	#    half whose server fails two checks 20 s apart has its mw eval stopped (no completion marker is written while any
    14	#    task still needs an attempt); its unfinished tasks are re-run once the server is back.
    15	# Exits when maiui_a_complete and maiui_b_complete exist (or after 20 h). Log: logs/gcp_mw_maiui_watch.log
    16	set -u
    17	cd /Users/alpha/lfm3-android
    18	source logs/gcp_mw_instance.env
    19	log() { echo "[$(date +%T)] $*"; }
    20	S() { ssh -o ConnectTimeout=15 -o BatchMode=yes -i "$PEM" "ubuntu@${IP}" "$@"; }
    21	status() { gcloud compute instances describe "$NAME" --zone "$ZONE" --format="value(status)" 2>/dev/null; }
    22	ctr() { [ "$1" = maiui_a ] && echo mobile_world_env_0 || echo lfmenv_0; }
    23	port() { [ "$1" = maiui_a ] && echo 18093 || echo 18094; }
    24	ep() { [ "$1" = maiui_a ] && echo mobile_world_env || echo lfmenv; }
    25	wait_ready() {  # $1 = half; container healthy + its model tunnel answering, up to 20 min
    26	  local t0=$(date +%s) c; c=$(ctr "$1")
    27	  # container healthy AND the tunnel's server is MAI-UI-2B Q8_0 / cd959bae9 / n_ctx 20480 (not just any /health "ok")
    28	  until S "[ \"\$(sudo docker inspect -f '{{.State.Health.Status}}' $c)\" = healthy ] && python3 check_maiui_server.py $(port "$1")" > /dev/null 2>&1; do
    29	    [ $(( $(date +%s) - t0 )) -gt 1200 ] && { log "$1: not ready after 20 min"; return 1; }
    30	    sleep 20
    31	  done
    32	}
    33	mkctr() {  # $1 = container. `mw env run` starts containers with `docker run --rm`, so a VM stop/preemption deletes them
    34	  # (seen 10:04 and after the 12:42 preemption). If missing, recreate it with its original command (same image/name/ports).
    35	  local args="--count 1 --launch-interval 20"
    36	  [ "$1" = lfmenv_0 ] && args="--count 1 --name-prefix lfmenv --backend-start-port 6810 --viewer-start-port 7870 --vnc-start-port 5810 --adb-start-port 5566 --launch-interval 20"
    37	  S "sudo docker inspect $1 > /dev/null 2>&1 || { cd MobileWorld && sudo /home/ubuntu/.local/bin/uv run mw env run $args > ../envrun_$1_\$(date +%H%M).log 2>&1; sudo docker inspect $1 > /dev/null 2>&1; }" &&
    38	    return 0
    39	  log "$1: missing and could not be recreated"; return 1
    40	}
    41	restart_ctr() {  # $1 = container. A plain `docker restart` can SIGKILL the emulator and leave the AVD's
    42	  # multiinstance.lock / hardware-qemu.ini.lock, after which the emulator refuses to start ("Running multiple emulators
