   318	    def _get_image_size(self, obs_image: Any) -> tuple[int, int]:
   319	        assert isinstance(obs_image, Image.Image)
   320	        return obs_image.size
   321	
   322	    def _normalize_coord_to_pixel(self, coord: list[float], obs_image: Any) -> tuple[int, int]:
   323	        width, height = self._get_image_size(obs_image)
   324	        return int(coord[0] * width), int(coord[1] * height)
