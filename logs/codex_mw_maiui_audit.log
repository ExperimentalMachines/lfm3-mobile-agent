   114	def _process_task_on_env(
   115	    task_name: str,
   116	    env_queue: Queue,
   117	    agent_type: str,
   118	    model_name: str,
   119	    llm_base_url: str,
   120	    api_key: str | None,
   121	    log_file_root: str,
   122	    max_step: int,
   123	    retry_on_device_unhealthy: int = 2,
   124	    enable_mcp: bool = False,
   125	    **kwargs,
   126	) -> dict:
   127	    """Process a single task on a specific environment.
   128	
   129	    Args:
   130	        task_name: Name of the task to execute
   131	        env_url: URL of the environment to use
   132	        agent_type: Type of agent to create
   133	        model_name: Model name for the agent
   134	        llm_base_url: LLM service base URL
   135	        api_key: API key for LLM service
   136	        log_file_root: Root directory for log files
   137	        max_step: Maximum steps for task execution
   138	        **kwargs: Additional kwargs for agent creation
   139	
   140	    Returns:
   141	        dict: Task result containing task_name, success, score, steps, duration_seconds
   142	    """
   143	    # Create thread-specific log file
   144	    thread_id = threading.current_thread().ident
   145	    thread_log_file = os.path.join(log_file_root, task_name, f"thread_{thread_id}.log")
   146	    os.makedirs(os.path.dirname(thread_log_file), exist_ok=True)
   147	    traj_logger = TrajLogger(log_file_root, task_name)
   148	
   149	    def thread_filter(record):
   150	        return record["extra"].get("thread_id") == thread_id
   151	
   152	    thread_handler_id = logger.add(
   153	        thread_log_file,
   154	        format="{time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} | container: {extra[container_name]} | {message}",
   155	        level="DEBUG",
   156	        enqueue=True,
   157	        filter=thread_filter,
   158	    )
   159	    env, container_name = env_queue.get()
   160	
   161	    try:
   162	        with logger.contextualize(thread_id=thread_id, container_name=container_name):
   163	            logger.info("Processing task '{}' on environment {}", task_name, env.base_url)
   164	            if enable_mcp:
   165	                assert isinstance(env, AndroidMCPEnvClient), (
   166	                    f"env must be a AndroidMCPEnvClient, but got {type(env)}"
   167	                )
   168	                try:
   169	                    env.reset_tools(task_type=task_name)
   170	                except Exception as e:
   171	                    logger.exception(f"Error resetting tools for task {task_name}: {e}")
   172	                    return None
   173	
   174	            agent = create_agent(agent_type, model_name, llm_base_url, api_key, env=env, **kwargs)
   175	
   176	            task_start_time = time.time()
   177	            while True:
   178	                try:
   179	                    task_steps, task_score = _execute_single_task(
   180	                        env,
   181	                        agent,
   182	                        task_name,
   183	                        max_step,
   184	                        traj_logger=traj_logger,
   185	                        enable_mcp=enable_mcp,
   186	                    )
   187	                    break
   188	                except Exception as e:
   189	                    if "Device is not healthy" in str(e) and retry_on_device_unhealthy > 0:
   190	                        logger.warning("Device is not healthy, retrying...")
   191	                        time.sleep(20)
   192	                        retry_on_device_unhealthy -= 1
   193	                        traj_logger.reset_traj()
   194	                        continue
   195	                    else:
   196	                        logger.exception(f"Error executing task {task_name}")
   197	                        return None
   198	
   199	            task_duration = time.time() - task_start_time
   200	            task_success = task_score > 0.0
   201	
   202	            logger.info(
   203	                "Task '{}' completed on {}: success={}, score={}, steps={}, duration={:.1f}s",
   204	                task_name,
   205	                env.base_url,
   206	                task_success,
   207	                task_score,
   208	                task_steps,
   209	                task_duration,
   210	            )
   211	
   212	            return {
   213	                "task_name": task_name,
   214	                "score": task_score,
   215	            }
   216	    finally:
   217	        # Remove the thread-specific handler
   218	        logger.remove(thread_handler_id)
   219	        env_queue.put((env, container_name))
   220	
