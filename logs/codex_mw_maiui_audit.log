   222	def _init_env(
   223	    env_url: str, device: str, step_wait_time: float, suite_family: str, enable_mcp: bool
   224	) -> AndroidEnvClient:
   225	    """Initialize the environment."""
   226	    if enable_mcp:
   227	        env = AndroidMCPEnvClient(env_url, device, step_wait_time=step_wait_time)
   228	    else:
   229	        env = AndroidEnvClient(env_url, device, step_wait_time=step_wait_time)
   230	    env.switch_suite_family(suite_family)
   231	    return env
