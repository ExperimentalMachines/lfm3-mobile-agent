@@ -0,0 +1,108 @@
+import sys
+sys.dont_write_bytecode = True
+from pathlib import Path
+import json, os, subprocess, time, signal
+
+BASE = Path('/private/tmp/codex-pass10-on8gfqqf')
+ROOT = Path('/Users/alpha/lfm3-android')
+ns = {'__name__': 'chain_helpers'}
+exec(compile((BASE/'verify_chain.py').read_text().split('RESULT={}')[0], str(BASE/'verify_chain.py'), 'exec'), ns)
+stub = ns['COLAB_STUB']
+start = stub.index("if op=='download':")
+end = stub.index("if op=='upload':", start)
+stub = stub[:start] + '''if op=='download':
+    src=Path(os.environ['REAL_STATUS'])
+    shutil.copyfile(src,a[-1])
+    try: status=json.loads(Path(a[-1]).read_text())
+    except json.JSONDecodeError: status={'torn_read':True}
+    with trace.open('a') as f:f.write(json.dumps({'argv':['observe'],'downloaded_status':status})+'\\n')
+    print('downloaded');sys.exit(0)
+''' + stub[end:]
+ns['COLAB_STUB'] = stub
+os.environ['CHAIN_TEST_TIMEOUT'] = '4'
+results = {}
+
+def wait_for(fn, seconds=3):
+    end = time.monotonic()+seconds
+    while time.monotonic()<end:
+        if fn(): return
+        time.sleep(.01)
+    raise AssertionError('timed out waiting for real runner fixture')
+
+def stop(p):
+    if p and p.poll() is None:
+        os.killpg(p.pid, signal.SIGKILL)
+        p.wait(timeout=3)
+
+for tag, job in [('qwen2b','qwen35_2b_l4'), ('qwen08','qwen35_08b_l4')]:
+    for scenario in ('old_exit0', 'old_exit7', 'old_running_after_crash'):
+        d = BASE/(tag+'_'+scenario)
+        work = d/'content/work'
+        work.mkdir(parents=True)
+        runner = work/'vm_blocking_jobs.py'
+        # Preserve status/control logic; remap paths and shorten only heartbeat waits.
+        runner.write_text((ROOT/'scripts/vm_blocking_jobs.py').read_text().replace('/content',str(d/'content')).replace('time.sleep(10)', 'time.sleep(0.02)'))
+        jobs = work/'jobs.json'
+        status = work/'jobs_status.json'
+        previous = work/'previous.sh'
+        crashed = scenario == 'old_running_after_crash'
+        previous.write_text('exec sleep 60\n' if crashed else ('exit 7\n' if scenario == 'old_exit7' else 'exit 0\n'))
+        jobs.write_text(json.dumps([{'name':'predecessor','script':str(previous),'log':str(d/'previous.log'),'stagger_s':0 if crashed else .1}]))
+        prior_log = (d/'previous_runner.log').open('w')
+        prior = subprocess.Popen([sys.executable,'-B',str(runner)],stdout=prior_log,stderr=subprocess.STDOUT,start_new_session=True)
+        current = None
+        current_log = None
+        try:
+            wait_for(lambda: status.exists() and status.stat().st_size>0)
+            if crashed:
+                old = json.loads(status.read_text())
+                assert old['status']=={'predecessor':'running'}
+                stop(prior)
+            else:
+                prior.wait(timeout=3)
+                old = json.loads(status.read_text())
+                assert old['status']=={'predecessor':'exit 7' if scenario=='old_exit7' else 'exit 0'}
+            prior_log.close()
+            child = work/'current.sh'
+            child.write_text('echo $$ > '+str(d/'current.pid')+'\nsleep 1.3\nexit '+('7' if scenario=='old_exit7' else '0')+'\n')
+            jobs.write_text(json.dumps([{'name':'predecessor','script':str(child),'log':str(d/'current.log'),'stagger_s':.7}]))
+            current_log = (d/'current_runner.log').open('w')
+            current = subprocess.Popen([sys.executable,'-B',str(runner)],stdout=current_log,stderr=subprocess.STDOUT,start_new_session=True)
+            wait_for(lambda: (d/'current.pid').exists())
+            assert json.loads(status.read_text())==old
+            os.environ['REAL_STATUS'] = str(status)
+            rec = ns['chain_case'](tag+'_'+scenario, 'real_status', job)
+            current.wait(timeout=3)
+            terminal = json.loads(status.read_text())
+            observations = [e['downloaded_status'] for e in rec['commands'] if 'downloaded_status' in e]
+            assert observations[0] == old, observations
+            assert old['run_id'] != terminal['run_id']
+            assert terminal['status']['predecessor'].startswith('exit ')
+            assert any(x.get('run_id')==terminal['run_id'] and x.get('status')=={'predecessor':'running'} for x in observations)
+            if crashed:
+                assert rec['timed_out'] and not rec['launched_blocking']
+                assert sum(x==terminal for x in observations)>=3
+            else:
+                assert rec['exit']==0 and rec['launched_blocking'] and rec['heartbeat_confirmed']
+                assert rec['predecessor_warning'] == (scenario=='old_exit7')
+            results[tag+'_'+scenario] = {
+                'exit':rec['exit'], 'timed_out':rec['timed_out'],
+                'successor_launched':rec['launched_blocking'],
+                'heartbeat_confirmed':rec['heartbeat_confirmed'],
+                'predecessor_warning':rec['predecessor_warning'],
+                'old_status':old, 'current_terminal_status':terminal,
+                'terminal_downloads':sum(x==terminal for x in observations),
+                'observations':observations,
+                'old_runner_exit':prior.returncode,'current_runner_exit':current.returncode,
+                'fixture':rec['fixture'],'runner_fixture':str(d),
+                'stdout':rec['stdout'],'stderr':rec['stderr'],
+                'status_files_hand_authored':False,
+            }
+            (BASE/'status_lifecycle_results.json').write_text(json.dumps(results,indent=2))
+            print(tag,scenario,'exit',rec['exit'],'timeout',rec['timed_out'],'launched',rec['launched_blocking'],flush=True)
+        finally:
+            stop(prior); stop(current)
+            if not prior_log.closed: prior_log.close()
+            if current_log: current_log.close()
+            os.environ.pop('REAL_STATUS',None)
+print('RESULTS',BASE/'status_lifecycle_results.json')
