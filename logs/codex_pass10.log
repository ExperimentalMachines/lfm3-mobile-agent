+                'successor_launched':rec['launched_blocking'],
+                'heartbeat_confirmed':rec['heartbeat_confirmed'],
+                'predecessor_warning':rec['predecessor_warning'],
+                'old_status':old, 'current_terminal_status':terminal,
+                'terminal_downloads':sum(x==terminal for x in observations),
+                'observations':observations,
+                'old_runner_exit':prior.returncode,'current_runner_exit':current.returncode,
+                'fixture':rec['fixture'],'runner_fixture':str(d),
+                'stdout':rec['stdout'],'stderr':rec['stderr'],
+                'status_files_hand_authored':False,
+            }
+            (BASE/'status_lifecycle_results.json').write_text(json.dumps(results,indent=2))
+            print(tag,scenario,'exit',rec['exit'],'timeout',rec['timed_out'],'launched',rec['launched_blocking'],flush=True)
+        finally:
