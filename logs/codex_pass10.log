@@ -0,0 +1,24 @@
+"""Repeat the final CPU suites in a fresh evidence directory; no repository writes."""
+from pathlib import Path
+import subprocess, sys, tempfile
+
+source = Path(__file__).resolve().parent
+dest = Path(tempfile.mkdtemp(prefix='codex-pass10-repeat-', dir='/private/tmp'))
+files = [
+    'verify_generation_score.py', 'verify_aw.py', 'verify_shell.py',
+    'verify_chain.py', 'verify_recovery.py', 'verify_general_recovery.py',
+    'verify_replacement_pipeline.py', 'verify_identity_edges.py',
+    'verify_status_lifecycle.py', 'generation_runtime_hub.py',
+    'general_runtime_single.py',
+]
+for name in files:
+    (dest/name).write_text((source/name).read_text().replace(str(source),str(dest)))
+print('Evidence:',dest,flush=True)
+for name in files:
+    if not name.startswith('verify_'):
+        continue
+    with (dest/(name.removesuffix('.py')+'.log')).open('w') as log:
+        result = subprocess.run([sys.executable,'-B',str(dest/name)],stdout=log,stderr=subprocess.STDOUT)
+    print(name,'exit',result.returncode,flush=True)
+    if result.returncode:
+        raise SystemExit(result.returncode)
