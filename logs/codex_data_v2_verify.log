"""Deterministic random visual audit; exact-coordinate overlays, no generated pixels."""
from pathlib import Path
import io
import json
import random
import sys
import textwrap
from PIL import Image, ImageDraw, ImageFont

ROOT=Path(__file__).resolve().parents[2]
CACHE=ROOT/'results/codex/data_v2_cache'
sys.path[:0]=[str(CACHE/'python'),str(ROOT/'train')]
import pyarrow.parquet as pq
import agent_format as af

def main():
    rows=[json.loads(s) for s in (CACHE/'metadata.jsonl').read_text().splitlines()]
    selected=[]
    for j,source in enumerate(['odyssey','amex','screenqa']):
        pool=sorted([r for r in rows if r['source']==source and r['split']=='train'],key=lambda r:r['id'])
        sample=random.Random(20261117+j).sample(pool,40)
        for i,r in enumerate(sample):
            r['visual_id']=f'{source}_{i+1:02d}'
        selected+=sample
    (CACHE/'visual_samples.json').write_text(json.dumps(selected,indent=2,ensure_ascii=False))
    want={(r['file'],r['row']):r for r in selected}
    pics={}
    for f in sorted({r['file'] for r in selected}):
        pos=0
        for batch in pq.ParquetFile(CACHE/'v2'/f).iter_batches(batch_size=64,columns=['images']):
            for r in batch.to_pylist():
                if (f,pos) in want:
                    m=want[(f,pos)]
                    im=Image.open(io.BytesIO(r['images'][0]['bytes'])).convert('RGB')
                    if m['action']['action_type'] in af.POINT_TYPES:
                        x,y=af.norm_to_px(m['action']['point_2d'],im.width,im.height)
                        d=ImageDraw.Draw(im);d.ellipse((x-13,y-13,x+13,y+13),outline='red',width=3)
                        d.line((x-20,y,x+20,y),fill='red',width=2);d.line((x,y-20,x,y+20),fill='red',width=2)
                    pics[m['visual_id']]=im
                pos+=1
    out=CACHE/'visual';out.mkdir(exist_ok=True)
    font=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial.ttf',15)
    title=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial Bold.ttf',19)
    for source in ['odyssey','amex','screenqa']:
        samples=[r for r in selected if r['source']==source]
        for page in range(5):
            sheet=Image.new('RGB',(1536,2300),'#eeeeee');draw=ImageDraw.Draw(sheet)
            for slot,r in enumerate(samples[page*8:(page+1)*8]):
                x=(slot%4)*384;y=(slot//4)*1150
                draw.rectangle((x+1,y+1,x+382,y+1149),fill='white',outline='#777777')
                draw.text((x+6,y+4),r['visual_id']+' / '+r['action']['action_type'],font=title,fill='black')
                im=pics[r['visual_id']].copy();im.thumbnail((374,835))
                sheet.paste(im,(x+(384-im.width)//2,y+30))
                pics[r['visual_id']].save(out/(r['visual_id']+'.png'))
                text='Goal: '+r['goal']+'\nIntent: '+r['messages'][-1]['reasoning_content']+'\nLabel: '+r['messages'][-1]['content']
                wrapped='\n'.join(textwrap.fill(line,width=47) for line in text.splitlines())
                draw.multiline_text((x+7,y+870),wrapped,font=font,fill='black',spacing=2)
            sheet.save(out/f'{source}_sheet_{page+1}.jpg',quality=95)
    print('120 random training rows; 15 contact sheets; visual_samples.json',flush=True)

if __name__=='__main__': main()
"""Character-level template verification, not a live GPU/token-mask test.

Uses the actual local served GGUF template and the checked-in Qwen template,
plus a verbatim excerpt of TRL 1.16's multimodal preparation helper.
"""
import importlib.util
import json
from pathlib import Path
import sys
from jinja2 import Environment, nodes
from jinja2.ext import Extension
from reference_trl_multimodal import prepare_multimodal_messages

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0,str(ROOT / "train"))
import agent_format


class CaptureGeneration(Extension):
    tags = {"generation"}

    def parse(self, parser):
        start = next(parser.stream)
        body = parser.parse_statements(["name:endgeneration"],drop_needle=True)
        return nodes.CallBlock(self.call_method("capture"),[],[],body).set_lineno(start.lineno)

    def capture(self, caller):
        content = caller()
        self.environment.captured.append(content)
        return content


def main():
    goal, intent = "Open Settings", "Tap the Settings icon."
    action = '{"action_type":"click","point_2d":[500,500]}'
    data_messages = agent_format.build_messages(goal,[],for_trl=True)
    data_messages.append({"role":"assistant","content":action,"reasoning_content":intent})
    train_messages = prepare_multimodal_messages(data_messages,images=["placeholder"])
    inference_messages = agent_format.build_messages(goal,[],image="placeholder")
    assert train_messages[:-1] == inference_messages
    rows = []
    for path in (ROOT / "results/codex/served_gguf_chat_template.jinja",ROOT / "train/qwen35_chat_template_gen.jinja"):
        env = Environment(extensions=[CaptureGeneration,"jinja2.ext.loopcontrols"])
        env.captured = []
        template = env.from_string(path.read_text())
        training = template.render(messages=train_messages,add_generation_prompt=False)
        assistant_spans = list(env.captured)
        assert len(assistant_spans)==1 and intent in assistant_spans[0] and action in assistant_spans[0]
        assert "<think>" in assistant_spans[0] and "</think>" in assistant_spans[0] and "<|im_end|>" in assistant_spans[0]
        assert goal not in assistant_spans[0]
        for thinking in (True,False):
            env.captured=[]
            prompt=template.render(messages=inference_messages,add_generation_prompt=True,enable_thinking=thinking)
            assert not env.captured
            if thinking:
                assert training.startswith(prompt)
            rows.append({"template":str(path.relative_to(ROOT)),"enable_thinking":thinking,
                         "training_starts_with_inference_prompt":training.startswith(prompt),
                         "inference_suffix":prompt[-85:],"generation_span":assistant_spans[0]})
    (ROOT / "results/codex/template_render_checks.json").write_text(json.dumps({
        "trl_prepared_prompt_equals_offline_prompt":True,"cases":rows,
        "scope":"Character spans only. Does not verify tokenizer-level assistant_masks, GPU execution, or the training VM revision."
    },indent=2)+"\n")
    print(json.dumps(rows,indent=2))


if __name__=="__main__":
    main()

