+    vertical=r['action']['direction'] in ('up','down')
+    deviation=abs((p[0][0]+p[1][0])/2-500) if vertical else abs((p[0][1]+p[1][1])/2-500)
+    distance=abs(p[1][1]-p[0][1]) if vertical else abs(p[1][0]-p[0][0])
