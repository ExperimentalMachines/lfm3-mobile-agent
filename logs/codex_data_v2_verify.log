+for r in ledger:lines.append(f'| [{r["visual_id"]}]({r["image"]}) | `{r["id"]}` | {r["verdict"]} | {r["note"].replace("|","/")} |')
+(CACHE/'visual_review.md').write_text('\n'.join(lines)+'\n')
