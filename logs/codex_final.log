def process_file(path):
    import zlib
    rng = random.Random(zlib.crc32(os.path.basename(path).encode()) ^ args.seed)
    out = {"train": [], "validation": [], "test": []}
    st = Counter()
    scroll_checks = []
    pf = pq.ParquetFile(path)
    for rg in range(pf.num_row_groups):
        tbl = pf.read_row_group(rg).to_pylist()
        for row in tbl:
            eid = int(row["episode_id"])
            split = id2split.get(eid)
            if split is None:
                st["no_official_split"] += 1
                continue
            goal = (row["goal"] or "").strip()
            acts = row["actions"]
            instrs = row["step_instructions"] or [""] * len(acts)
            screens = row["screenshots_b64"]
            if not acts or len(screens) < len(acts):
                st["malformed"] += 1
                continue
            if split == "train" and (AW_RE.search(goal) or any(
                    a.get("action_type") == "open_app" and (AW_RE.search(a.get("app_name") or "") or (a.get("app_name") or "").strip().lower() == "tasks")
                    for a in acts)):
                st["train_dropped_aw_app"] += 1
                continue
            imgs = [Image.open(io.BytesIO(base64.b64decode(s))) for s in screens]
            sizes = [im.size for im in imgs]
            jpgs = [to_jpeg(af.resize_screenshot(im, args.max_pixels)) for im in imgs]
            history = []
            ok = True
            recs = []
            for i, a in enumerate(acts):
                W, H = sizes[i]
                ga = convert_action(a, W, H)
                if ga is None:
                    st["unknown_action_" + str(a.get("action_type"))] += 1
                    ok = False
                    break
                if ga["action_type"] == "scroll" and len(scroll_checks) < 40 and ga["direction"] in ("up", "down") and i + 1 < len(imgs):
                    scroll_checks.append((ga["direction"], vshift(imgs[i], imgs[i + 1])))
                instr = (instrs[i] or "").strip()
                bb = bbox.get((eid, i)) if split == "test" else None
                gt_bbox = None
                if bb:
                    x1, y1, x2, y2 = bb[0]
                    gt_bbox = af.px_to_norm(x1, y1, W, H) + af.px_to_norm(x2, y2, W, H)
                base = {"episode_id": eid, "step_idx": i, "goal": goal, "history": list(history),
                        "instruction": instr, "jpg": jpgs[i], "gt_action": ga, "gt_bbox": gt_bbox,
                        "subsplits": id2subs.get(eid, []), "is_terminal": False, "app": None,
                        "orig_size": [W, H]}
                if split == "train":
                    recs.append({**base, "mode": "high"})
                    if rng.random() < LOWLEVEL_FRAC and instr:
                        recs.append({**base, "mode": "low"})
                elif split == "validation":
                    recs.append({**base, "mode": "high"})
                else:
                    recs.append({**base, "mode": "high"})
                    if instr:
                        recs.append({**base, "mode": "low"})
                history.append((instr, af.action_to_str(ga)))
            if not ok:
                continue
            if len(screens) >= len(acts) + 1:
                W, H = sizes[len(acts)]
                recs.append({"episode_id": eid, "step_idx": len(acts), "goal": goal, "history": list(history),
                             "instruction": TERMINAL_INTENT, "jpg": jpgs[len(acts)],
                             "gt_action": {"action_type": "status", "goal_status": "complete"}, "gt_bbox": None,
                             "subsplits": id2subs.get(eid, []), "is_terminal": True, "mode": "high", "app": None,
                             "orig_size": [W, H]})
            else:
                st["no_final_screen"] += 1
            out[split].extend(recs)
            st["episodes_" + split] += 1
        flush_parts(out, f"{os.path.basename(path)}.rg{rg}", st)
        del tbl
    if args.delete_raw:
        os.remove(path)
p.add_argument("--replay", nargs="*", default=[], help="general-data replay datasets (save_to_disk dirs) mixed in to limit forgetting")
p.add_argument("--inline_think", action="store_true", help="put intent as <think>..</think> inside content (templates without reasoning_content)")
p.add_argument("--trust_remote_code", action="store_true", default=True)
args = p.parse_args()

os.makedirs(f"{args.out}/logs", exist_ok=True)
os.environ.setdefault("TENSORBOARD_LOGGING_DIR", f"{args.out}/logs/tb")
def _provenance():
    prov = {}
    try:
        from huggingface_hub import HfApi
        api = HfApi()
        prov["model_sha"] = api.model_info(args.model_id).sha if not os.path.isdir(args.model_id) else "local"
        for t in args.train + ([args.val] if args.val else []):
            if not os.path.isdir(t):
                prov[f"dataset_sha:{t}"] = api.dataset_info(t.partition("@")[0]).sha
    except Exception as e:
        prov["error"] = repr(e)
    import importlib.metadata as md
    prov["versions"] = {k: md.version(k) for k in ("torch", "transformers", "trl", "peft", "datasets", "accelerate")}
    return prov


json.dump({**vars(args), "provenance": _provenance()}, open(f"{args.out}/logs/run_config.json", "w"), indent=2)


def load_any(path):
    """local save_to_disk dir, or 'org/repo@split' on the Hub."""
    if os.path.isdir(path):
        return load_from_disk(path)
    repo, _, split = path.partition("@")
    split = split or "train"
    return load_dataset(repo, data_files={split: f"data/{split}/*.parquet"}, split=split)


train_ds = concatenate_datasets([load_any(t) for t in args.train]).shuffle(seed=args.seed)
if args.max_agent_rows:
    train_ds = train_ds.select(range(min(args.max_agent_rows, len(train_ds))))
n_agent = len(train_ds)
if args.replay:
    rep = concatenate_datasets([load_any(r) for r in args.replay])
    rep = rep.remove_columns([c for c in rep.column_names if c not in ("images", "messages")])
    train_ds = train_ds.remove_columns([c for c in train_ds.column_names if c not in ("images", "messages")])
    rep = rep.cast(train_ds.features)
    train_ds = concatenate_datasets([train_ds, rep]).shuffle(seed=args.seed)
    print(f"mixed replay: agent={n_agent} replay={len(rep)} ({len(rep) / len(train_ds):.1%})", flush=True)


def _inline(msgs):
    out = []
    for m in msgs:
        m = dict(m)
        if m["role"] == "assistant" and m.get("reasoning_content"):
            m["content"] = f"<think>{m['reasoning_content']}</think>{m['content']}"
        m["reasoning_content"] = None
        out.append(m)
    return out

    push_to_hub=bool(args.hub_repo),
    hub_model_id=args.hub_repo,
    hub_private_repo=True,
    hub_strategy="checkpoint" if args.hub_repo else "every_save",
)

trainer = SFTTrainer(
    model=model, args=cfg, train_dataset=train_ds, eval_dataset=val_ds,
    processing_class=processor, peft_config=peft_config,
    callbacks=[JsonlLogger(f"{args.out}/logs/train_log.jsonl")],
)
trainer.model.print_trainable_parameters()
resume = None
ckpts = [d for d in os.listdir(args.out) if d.startswith("checkpoint-")] if os.path.isdir(args.out) else []
if not ckpts and args.hub_repo:
    # VM was reclaimed? pull the last checkpoint pushed by hub_strategy="checkpoint"
    try:
        from huggingface_hub import HfApi, snapshot_download
        files = HfApi().list_repo_files(args.hub_repo)
        if "last-checkpoint/trainer_state.json" in files:
            snapshot_download(args.hub_repo, allow_patterns=["last-checkpoint/*"], local_dir=args.out)
            st = json.load(open(f"{args.out}/last-checkpoint/trainer_state.json"))
            bad = []
            if st.get("train_batch_size") not in (None, args.bs):
                bad.append(f"train_batch_size {st.get('train_batch_size')} != {args.bs}")
            if args.max_steps > 0 and st.get("max_steps") not in (None, args.max_steps):
                bad.append(f"max_steps {st.get('max_steps')} != {args.max_steps}")
            if bad:
                raise SystemExit("incompatible hub checkpoint, refusing to resume: " + "; ".join(bad))
            dst = f"{args.out}/checkpoint-{st['global_step']}"
            os.rename(f"{args.out}/last-checkpoint", dst)
            ckpts = [os.path.basename(dst)]
            print(f"restored {dst} from hub", flush=True)
    except SystemExit:
        raise
    except Exception as e:
        print("hub resume failed:", e, flush=True)
if ckpts:
    resume = True
    print("resuming from latest checkpoint", flush=True)
t0 = time.time()
result = trainer.train(resume_from_checkpoint=resume)
summary = {**result.metrics, "wall_s": time.time() - t0,
           "peak_gpu_mem_gb": torch.cuda.max_memory_allocated() / 1e9,
           "train_rows": len(train_ds)}
if val_ds is not None:
    summary.update(trainer.evaluate())
json.dump(summary, open(f"{args.out}/logs/train_summary.json", "w"), indent=2)
json.dump(trainer.state.log_history, open(f"{args.out}/logs/log_history.json", "w"), indent=2)
print("SUMMARY", json.dumps(summary), flush=True)

"""AndroidWorld runner for the LFM screenshot agent (fork of android_world/run.py).

Differences from upstream run.py: adb path default fixed for Homebrew, configurable
gRPC port (another emulator owns 5554/8554 on this machine), and our agent.

Example:
  python eval/androidworld/run_aw.py --console_port=5556 --grpc_port=8556 \
      --server_url=http://127.0.0.1:8080 --agent_label=lfm3vl2b_ft \
      --output_path=results/androidworld
"""

import os
import sys
from pathlib import Path

from absl import app, flags

sys.path.insert(0, str(Path(__file__).resolve().parent))

from android_world import checkpointer as checkpointer_lib  # noqa: E402
from android_world import registry, suite_utils  # noqa: E402
from android_world.env import env_launcher  # noqa: E402

from lfm_agent import LFMScreenAgent  # noqa: E402
from guiowl_agent import GUIOwlAgent  # noqa: E402

os.environ.setdefault("GRPC_VERBOSITY", "ERROR")

F = flags.FLAGS
flags.DEFINE_string("adb_path", "/opt/homebrew/bin/adb", "adb binary")
flags.DEFINE_boolean("perform_emulator_setup", False, "first-time app install/setup")
flags.DEFINE_integer("console_port", 5556, "emulator console port")
flags.DEFINE_integer("grpc_port", 8556, "emulator gRPC port")
flags.DEFINE_string("suite_family", "android_world", "suite family")
flags.DEFINE_integer("task_random_seed", 30, "seed for task params")
flags.DEFINE_list("tasks", None, "subset of tasks")
flags.DEFINE_integer("n_task_combinations", 1, "instances per task")
flags.DEFINE_string("checkpoint_dir", "", "resume dir")
flags.DEFINE_string("output_path", "results/androidworld", "output root")
flags.DEFINE_string("agent_label", "lfm_screen_agent", "name stored in results")
flags.DEFINE_string("server_url", "http://127.0.0.1:8080", "OpenAI-compatible server")
flags.DEFINE_boolean("enable_thinking", True, "chat_template enable_thinking")
flags.DEFINE_integer("max_pixels", 880 * 880, "screenshot pixel budget")
flags.DEFINE_boolean("fixed_task_seed", False, "identical params across combos")
flags.DEFINE_string("agent", "lfm", "lfm | guiowl")
flags.DEFINE_integer("guiowl_images", 5, "GUI-Owl screenshots kept in context")
flags.DEFINE_integer("guiowl_max_pixels", 0, "0 = full resolution (native)")


def main(argv):
    del argv
    env = env_launcher.load_and_setup_env(
        console_port=F.console_port, emulator_setup=F.perform_emulator_setup,
        adb_path=F.adb_path, grpc_port=F.grpc_port,
    )
    if F.perform_emulator_setup and not F.tasks:
        print("Emulator setup done.")
        env.close()
        return
    suite = suite_utils.create_suite(
        registry.TaskRegistry().get_registry(family=F.suite_family),
        n_task_combinations=F.n_task_combinations, seed=F.task_random_seed,
        tasks=F.tasks, use_identical_params=F.fixed_task_seed,
    )
    suite.suite_family = F.suite_family
    if F.agent == "guiowl":
        agent = GUIOwlAgent(env, server_url=F.server_url, name=F.agent_label, n_images=F.guiowl_images,
                            max_pixels=F.guiowl_max_pixels)
    else:
        agent = LFMScreenAgent(env, server_url=F.server_url, name=F.agent_label,
                               enable_thinking=F.enable_thinking, max_pixels=F.max_pixels)
    agent.transition_pause = None
    ckpt = F.checkpoint_dir or checkpointer_lib.create_run_directory(F.output_path)
    print(f"Writing to {ckpt}", flush=True)
    suite_utils.run(suite, agent, checkpointer=checkpointer_lib.IncrementalCheckpointer(ckpt), demo_mode=False)
    print(f"Done. Results in {ckpt}", flush=True)
    env.close()


if __name__ == "__main__":
    app.run(main)

