diff --git a/results/codex/final_data_audit.py b/results/codex/final_data_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..ddbde101725004006eba82d1ebee0a3d3be92912
--- /dev/null
+++ b/results/codex/final_data_audit.py
@@ -0,0 +1,53 @@
+"""Read only non-image Parquet columns at the recorded training dataset revision."""
+import collections, concurrent.futures, hashlib, json, pathlib
+import pyarrow.parquet as pq
+from huggingface_hub import HfFileSystem
+
+ROOT=pathlib.Path(__file__).resolve().parents[2]; OUT=ROOT/'results/codex'
+inv=json.loads((OUT/'final_data_inventory.json').read_text())
+columns=['episode_id','step_idx','mode','is_terminal','gt_action','gt_bbox','subsplits']
+def read_one(f):
+    remote=f"datasets/{inv['repo']}@{inv['revision']}/{f['path']}"
+    fs=HfFileSystem()
+    with fs.open(remote,'rb',block_size=65536,cache_type='bytes') as fh:
+        pf=pq.ParquetFile(fh)
+        rows=pf.read(columns=columns).to_pylist()
+    dest=OUT/'final_data_columns'/f['path'].replace('.parquet','.jsonl')
+    dest.parent.mkdir(parents=True,exist_ok=True)
+    with dest.open('x') as out:
+        for r in rows:out.write(json.dumps(r,ensure_ascii=False)+'\n')
+    print(f['path'],len(rows),flush=True)
+    return f['path'],rows
+
+files=[f for f in inv['files'] if f['path'].endswith('.parquet')]
+splits=collections.defaultdict(list)
+with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
+    for path,rows in pool.map(read_one,files):splits[path.split('/')[1]].extend(rows)
+official=json.loads((ROOT/'data/meta/splits.json').read_text())
+official={('val' if k=='validation' else k):set(map(int,v)) for k,v in official.items()}
+info={}; allids={}; rowkeys=lambda r:(r['episode_id'],r['step_idx'],r['mode'])
+for split,rows in splits.items():
+    ids={r['episode_id'] for r in rows};allids[split]=ids
+    info[split]={'n_rows':len(rows),'n_episodes':len(ids),'outside_official_split':sorted(ids-official[split]),
+        'missing_official_episodes':sorted(official[split]-ids),
+        'duplicate_keys':len(rows)-len({rowkeys(r) for r in rows}),
+        'modes_terminals':dict(collections.Counter(f"{r['mode']}/terminal={r['is_terminal']}" for r in rows)),
+        'action_counts':dict(collections.Counter(json.loads(r['gt_action'])['action_type'] for r in rows))}
+gt=[json.loads(l) for l in (ROOT/'data/meta/androidcontrol_test_gt.jsonl').read_text().splitlines()]
+idx={rowkeys(r):r for r in splits['test']}; gx={rowkeys(r):r for r in gt}
+fields=['episode_id','step_idx','mode','is_terminal','gt_action','gt_bbox','subsplits']
+mismatches=[]
+for k in idx.keys()&gx.keys():
+    for f in fields:
+        a,b=idx[k][f],gx[k][f]
+        if f=='subsplits':a,b=sorted(a),sorted(b)
+        if f in ['gt_action','gt_bbox']:
+            a=json.loads(a) if isinstance(a,str) and a else a
+            b=json.loads(b) if isinstance(b,str) and b else b
+        if a!=b:mismatches.append([list(k),f])
+result={'dataset':inv['repo'],'revision':inv['revision'],'splits':info,
+    'intersections':{f'{a}/{b}':len(allids[a]&allids[b]) for a in allids for b in allids if a<b},
+    'frozen_gt_missing':len(gx.keys()-idx.keys()),'frozen_gt_extra':len(idx.keys()-gx.keys()),
+    'frozen_gt_field_mismatches':mismatches}
+(OUT/'final_data_audit.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps(result,indent=2),flush=True)
diff --git a/results/codex/final_extract_aw.py b/results/codex/final_extract_aw.py
new file mode 100644
index 0000000000000000000000000000000000000000..9fe902dc6f1fc20822577cc023e7d737453bd87d
--- /dev/null
+++ b/results/codex/final_extract_aw.py
@@ -0,0 +1,38 @@
+"""Extract trusted local AndroidWorld pickles at the frozen file-list cutoff."""
+import collections, gzip, hashlib, importlib.util, json, math, pathlib, pickle
+
+ROOT=pathlib.Path(__file__).resolve().parents[2]
+OUT=ROOT/'results/codex'
+manifest=json.loads((OUT/'final_snapshot_manifest.json').read_text())
+spec=importlib.util.spec_from_file_location('audited_failure_modes',ROOT/'eval/androidworld/failure_modes.py')
+fm=importlib.util.module_from_spec(spec); spec.loader.exec_module(fm)
+
+def clean(v):
+    if isinstance(v,dict): return {str(k):clean(x) for k,x in v.items()}
+    if isinstance(v,(list,tuple)): return [clean(x) for x in v]
+    if isinstance(v,float) and not math.isfinite(v): return None
+    if v is None or isinstance(v,(str,int,float,bool)): return v
+    return str(v)
+
+result={}
+for name,run in manifest['androidworld'].items():
+    rows=[]
+    for rel in run['files']:
+        p=ROOT/rel
+        raw=p.read_bytes()
+        obj=pickle.loads(gzip.decompress(raw))
+        eps=obj if isinstance(obj,list) else [obj]
+        assert len(eps)==1,(rel,len(eps))
+        ep=eps[0]
+        ed=ep['episode_data'] if isinstance(ep.get('episode_data'),dict) else {}
+        row={k:clean(v) for k,v in ep.items() if k!='episode_data'}
+        row['file']=rel; row['sha256']=hashlib.sha256(raw).hexdigest(); row['bytes']=len(raw)
+        row['episode_data']={k:clean(v) for k,v in ed.items() if k!='screenshot_thumb_jpg'}
+        row['n_screenshots']=len(ed.get('screenshot_thumb_jpg') or [])
+        row['current_classifier']=fm.classify(ep)
+        names=[a.get('app_name') for a in ed.get('parsed_action',[]) if isinstance(a,dict) and a.get('action_type')=='open_app']
+        row['app_activity_mapping']={str(s):fm.adb_utils.get_adb_activity(str(s or '')) for s in names}
+        rows.append(row)
+    result[name]={'run_dir':run['run_dir'],'episodes':rows}
+    print(name,len(rows),dict(collections.Counter(r['is_successful'] for r in rows)),flush=True)
+(OUT/'final_aw_raw_extract.json').write_text(json.dumps(result,indent=2,allow_nan=False)+'\n')
diff --git a/results/codex/final_fetch.py b/results/codex/final_fetch.py
new file mode 100644
index 0000000000000000000000000000000000000000..aef4c313e9ab90b7ac2598f32785049c4b81aadc
--- /dev/null
+++ b/results/codex/final_fetch.py
@@ -0,0 +1,32 @@
+"""Download frozen Hub eval artifacts, never model weights."""
+import hashlib, json, pathlib, re
+from huggingface_hub import HfApi, hf_hub_download
+ROOT=pathlib.Path(__file__).resolve().parents[2]
+OUT=ROOT/'results/codex'
+inventory=json.loads((OUT/'final_hub_inventory.json').read_text())
+receipt=[]
+for info in inventory:
+    name=info['repo'].split('/')[-1]
+    for meta in info['files']:
+        f=meta['path']
+        is_pred=bool(re.fullmatch(r'eval/.*(?:_ft|_base|_ft_nothink_high)\.jsonl(?:\.manifest\.json)?',f))
+        is_evidence=(f in ['README.md','config.json','lora_adapter/adapter_config.json','processor_config.json','chat_template.jinja']
+            or (f.startswith('training_logs/') and f.endswith(('.json','.jsonl'))))
+        if not (is_pred or is_evidence): continue
+        dest=OUT/('final_preds' if is_pred else 'final_hub_evidence')/name
+        assert not (dest/f).exists(), dest/f
+        p=pathlib.Path(hf_hub_download(info['repo'],f,revision=info['sha'],local_dir=dest))
+        b=p.read_bytes()
+        receipt.append({'repo':info['repo'],'revision':info['sha'],'hub_path':f,
+                        'path':str(p.relative_to(ROOT)),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})
+        print(name,f,len(b),flush=True)
+(OUT/'final_download_receipt.json').write_text(json.dumps(receipt,indent=2)+'\n')
+datarepo='experimentalmachines/AndroidControl-screen-agent-sft'
+rev='1c49e7d117bd109eebd976b04deefa708b0e2007'
+di=HfApi().dataset_info(datarepo,revision=rev,files_metadata=True)
+dinv={'repo':datarepo,'revision':di.sha,'files':[{'path':f.rfilename,'size':f.size} for f in di.siblings]}
+(OUT/'final_data_inventory.json').write_text(json.dumps(dinv,indent=2)+'\n')
+for f in di.siblings:
+    if f.rfilename=='README.md' or f.rfilename.startswith('stats/'):
+        p=hf_hub_download(datarepo,f.rfilename,repo_type='dataset',revision=rev,local_dir=OUT/'final_data_evidence')
+        print(p,flush=True)
diff --git a/results/codex/final_mirror_audit.py b/results/codex/final_mirror_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..774d06b67551bd02ba1c3ebd1245dcd9877f8876
--- /dev/null
+++ b/results/codex/final_mirror_audit.py
@@ -0,0 +1,27 @@
+"""Recompute the model cards' 1,238 leaked official-test episodes in mirror train."""
+import concurrent.futures, json, pathlib
+import pyarrow.parquet as pq
