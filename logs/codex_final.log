     3	usage: python eval/androidworld/failure_modes.py <run_dir> [--out file.json]
     4	Each episode gets the first matching label (priority order below); every episode also gets a set of flags.
     5	"""
     6	import argparse
     7	import collections
     8	import glob
     9	import gzip
    10	import json
    11	import os
    12	import pickle
    13	
    14	from android_world.env import adb_utils
    15	
    16	
    17	def act_key(a):
    18	    if not isinstance(a, dict):
    19	        return None
    20	    t = a.get("action_type")
    21	    p = a.get("point_2d")
    22	    if isinstance(p, (list, tuple)) and len(p) == 2:
    23	        p = (round(p[0] / 25), round(p[1] / 25))  # 2.5% grid tolerance
    24	    return (t, p, a.get("text"), a.get("direction"), a.get("app_name"), a.get("goal_status"))
    25	
    26	
    27	def max_run(xs):
    28	    best, cur, prev = 0, 0, object()
    29	    for x in xs:
    30	        cur = cur + 1 if x == prev and x is not None else 1
    31	        best, prev = max(best, cur), x
    32	    return best
    33	
    34	
    35	def classify(ep):
    36	    ed = ep["episode_data"] if isinstance(ep.get("episode_data"), dict) else {}  # NaN when the episode raised
    37	    acts = ed.get("parsed_action") or []
    38	    types = [a.get("action_type") if isinstance(a, dict) else None for a in acts]
    39	    flags = set()
    40	    bad_apps = [a.get("app_name") for a in acts if isinstance(a, dict) and a.get("action_type") == "open_app"
    41	                and adb_utils.get_adb_activity(str(a.get("app_name") or "")) is None]
    42	    if bad_apps:
    43	        flags.add("unknown_app_name")
    44	    if max_run(types) >= 3 and "wait" in [t for t in types]:
    45	        if max_run([t if t == "wait" else None for t in types]) >= 3:
    46	            flags.add("wait_loop")
    47	    if max_run([act_key(a) for a in acts if isinstance(a, dict) and a.get("action_type") != "wait"]) >= 3:
    48	        flags.add("repeated_action_loop")
    49	    if any(a is None for a in acts):
    50	        flags.add("unparseable_step")
    51	    last = types[-1] if types else None
    52	    terminated = last in ("status", "answer")
    53	    if ep.get("exception_info") or not ed:
    54	        label = "exception"
    55	    elif (ep["is_successful"] or 0) > 0:
    56	        label = "success"
    57	    elif last == "status" and (acts[-1] or {}).get("goal_status") == "infeasible":
    58	        label = "declared_infeasible"
    59	    elif last == "status":
    60	        label = "premature_or_wrong_complete"
    61	    elif last == "answer":
    62	        label = "wrong_answer"
    63	    elif "unknown_app_name" in flags and len(acts) and types[0] == "open_app" and bad_apps and bad_apps[0] == acts[0].get("app_name"):
    64	        label = "stuck_after_unknown_app"
    65	    elif flags & {"wait_loop", "repeated_action_loop"}:
    66	        label = "loop_until_step_limit"
    67	    else:
    68	        label = "step_limit_no_termination" if not terminated else "other"
    69	    return label, sorted(flags), bad_apps
    70	
    71	
    72	def main():
    73	    ap = argparse.ArgumentParser()
    74	    ap.add_argument("run_dir")
    75	    ap.add_argument("--out")
    76	    a = ap.parse_args()
    77	    rows = []
