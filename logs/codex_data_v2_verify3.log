                    except Exception:  # noqa: BLE001
                        act = None
            elif a == "SCROLL":
                try:
                    (x1, y1), (x2, y2) = (ast.literal_eval(info) if isinstance(info, str) else info)[:2]
                    dr = swipe_dir(x1, y1, x2, y2)
