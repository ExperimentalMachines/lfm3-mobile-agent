from jinja2.ext import Extension
class Generation(Extension):
    tags={'generation'}
    def parse(self,parser):
        tok=next(parser.stream);body=parser.parse_statements(['name:endgeneration'],drop_needle=True)
        return nodes.CallBlock(self.call_method('capture'),[],[],body).set_lineno(tok.lineno)
    def capture(self,caller):return caller()

def run_generator(argv):
    class InputTensor(Tensor):
        def __init__(self,n,tail):super().__init__(n);self.tail=tail
        def __getitem__(self,k):return NSROW(self.tail)
    class NSROW:
        def __init__(self,tail):self.tail=tail
        def __getitem__(self,k):return self.tail
    class Processor:
        chat_template=(ROOT/'train/qwen35_chat_template_gen.jinja').read_text()
        def __init__(self):self.tokenizer=NS(pad_token='<pad>',padding_side='right',decode=lambda ids,**kw:ids)
        @classmethod
        def from_pretrained(cls,*a,**kw):return cls()
