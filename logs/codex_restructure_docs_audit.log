}     1	"""Select AndroidControl train episodes to turn into navigate-then-answer episodes for v4 (runs locally, CPU only).
     2	
     3	Input: v3 training metadata (no images) written by the v4 build prep: data/v4work/v3_train_meta.parquet
     4	Output: data/v4work/v4_candidates.json  [{key, shard, row_in_shard (final screen), goal, kind, split, n_steps, ...}]
     5	
     6	Rules (all recorded in the output's "rules" block):
     7	  * AndroidControl only: the only source here whose episodes keep a final `status complete` row (its screenshot is the
     8	    screen after the last action). Rows are step samples of each episode (2,971 selected episodes miss some steps,
     9	    176 have only the final row); every row carries the 8-step rolling text history used at inference. GUI-Odyssey/AMEX
    10	    keep ~3 sampled rows per episode and no reliable final screen.
    11	  * last row = status complete at step >= 1, and its text history must number up to that step (rows are step samples
    12	    of the episode; the final row's prompt carries the full history, so it represents the whole navigation).
    13	  * contamination guard: drop episodes whose goal or any open_app name mentions an AndroidWorld app or app type
    14	    (names below, plus every launcher name AndroidWorld can resolve); conservative on purpose.
    15	  * kind = "question" if the original goal is information-seeking (check/view/find/...), else "compound"
    16	    (the original task stays in the goal and a question about the final screen is appended).
    17	  * dev split: 200 episodes held out from v4 training entirely (their original action version is removed too), and
    18	    their screenshots must not occur anywhere else in the training data (screen-disjoint by img_sha).
    19	"""
    20	import collections
    21	import json
    22	import random
    23	import re
    24	
    25	import pyarrow.parquet as pq
    26	
    27	SEED = 4
    28	N_TOTAL = 3800
    29	N_DEV = 200
    30	AW_TERMS = ["android world", "markor", "joplin", "broccoli", "recipe", "expense", "opentracks", "open tracks",
    31	            "osmand", "vlc", "retro", "music player", "audio recorder", "voice recorder", "recorder", "calendar",
    32	            "clock", "alarm", "timer", "stopwatch", "contact", "dialer", "phone app", "sms", "message", "messenger",
    33	            "files", "file manager", "gallery", "photos", "camera", "draw", "tasks", "to-do", "todo", "note", "notes",
    34	            "chrome", "browser", "settings", "wifi", "wi-fi", "bluetooth", "brightness"]
    35	AW_RE = re.compile("|".join(re.escape(t) for t in AW_TERMS), re.I)
    36	INFO_RE = re.compile(r"^\s*(please\s+)?(check|show|find|view|see|look|search|what|how|tell|get|display|read|know|"
    37	                     r"open\b.{0,60}\b(to|and)\s+(see|check|view|find|look|know|read))", re.I)
    38	
    39	
    40	def goal_of(msgs):
    41	    return msgs[1]["content"].split("\n", 1)[0].removeprefix("Goal: ").strip()
    42	
    43	
    44	def main():
    45	    rows = pq.read_table("data/v4work/v3_train_meta.parquet").to_pylist()
    46	    by = collections.defaultdict(list)
    47	    sha_count = collections.Counter(r["img_sha"] for r in rows)
    48	    for r in rows:
    49	        by[(r["source"], r["episode_id"])].append(r)
    50	    st = collections.Counter()
    51	    pool = []
    52	    for (src, eid), rs in by.items():
    53	        if src != "androidcontrol":
    54	            continue
    55	        rs.sort(key=lambda r: r["step_idx"])
    56	        st["ac_episodes"] += 1
    57	        acts = [json.loads(r["gt_action"]) for r in rs]
    58	        if rs[-1]["step_idx"] < 1:
    59	            st["drop_too_short"] += 1
    60	            continue
    61	        # rows are step samples, but every row's prompt carries the full text history of the earlier steps, so the
    62	        # final row alone represents the whole navigation; check that its history really covers the episode
    63	        hist = rs[-1]["messages"][1]["content"].split("Previous steps:\n", 1)[1].rsplit("\nWhat is the next action?", 1)[0]
    64	        nums = [int(m) for m in re.findall(r"^(\d+)\. ", hist, re.M)]
    65	        if not nums or nums[-1] != rs[-1]["step_idx"]:
    66	            st["drop_history_mismatch"] += 1
    67	            continue
    68	        if acts[-1]["action_type"] != "status" or acts[-1].get("goal_status") != "complete":
    69	            st["drop_no_terminal"] += 1
    70	            continue
    71	        g = goal_of(rs[0]["messages"])
    72	        apps = [a["app_name"] for a in acts if a["action_type"] == "open_app"]
    73	        if AW_RE.search(g) or any(AW_RE.search(x) for x in apps):
    74	            st["drop_aw_app_guard"] += 1
    75	            continue
    76	        if any(goal_of(r["messages"]) != g for r in rs):
    77	            st["drop_goal_varies"] += 1
    78	            continue
    79	        last = rs[-1]
    80	        pool.append({"key": f"{src}/{eid}", "source": src, "episode_id": eid, "shard": last["shard"],
    81	                     "row_in_shard": last["row_in_shard"], "img_sha": last["img_sha"], "goal": g,
    82	                     "kind": "question" if INFO_RE.search(g) else "compound", "n_steps": rs[-1]["step_idx"] + 1,
    83	                     "rows_present": len(rs), "apps": apps,
    84	                     "episode_shas": [r["img_sha"] for r in rs]})
    85	    st["pool"] = len(pool)
    86	    st["pool_question"] = sum(c["kind"] == "question" for c in pool)
    87	    rnd = random.Random(SEED)
    88	    q = [c for c in pool if c["kind"] == "question"]
    89	    o = [c for c in pool if c["kind"] == "compound"]
    90	    rnd.shuffle(q)
    91	    rnd.shuffle(o)
    92	    chosen = q + o[: max(0, N_TOTAL - len(q))]
    93	    rnd.shuffle(chosen)
    94	    # dev: screens of the episode must be unique to that episode in the whole training set
    95	    dev, train = [], []
    96	    for c in chosen:
    97	        own = collections.Counter(c["episode_shas"])
    98	        disjoint = all(sha_count[s] == own[s] for s in own)
    99	        if len(dev) < N_DEV and disjoint:
   100	            c["split"] = "dev"
   101	            dev.append(c)
   102	        else:
   103	            c["split"] = "train"
   104	            train.append(c)
   105	    st["dev"], st["train"] = len(dev), len(train)
   106	    st["dev_question"] = sum(c["kind"] == "question" for c in dev)
   107	    for c in chosen:
   108	        del c["episode_shas"]
   109	    out = {"rules": __doc__, "seed": SEED, "stats": dict(st), "candidates": chosen}
   110	    json.dump(out, open("data/v4work/v4_candidates.json", "w"), indent=0)
   111	    print(json.dumps(dict(st)))
   112	
   113	
   114	if __name__ == "__main__":
   115	    main()
