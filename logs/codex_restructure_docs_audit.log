+        out={'n':n,'base_acc':sum(bb[k] for k in keys)/n,'ft_acc':sum(ff[k] for k in keys)/n,'delta':(c-b)/n,'mcnemar_p':mc(b,c)}
+        assert all(abs(v-stored[kind][k])<1e-12 for k,v in out.items())
+        audit['general'][name][kind]=out
