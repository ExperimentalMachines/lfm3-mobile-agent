  "a_dev_answer_gate_delta>=+0.05": false,
  "b_dev_complete_false_answer<=0.03": true,
  "c_ac_high_step_sr_delta>=-0.02": false
 },
 "offline_pass": false,
 "note": "offline part only; (d) AndroidWorld seed 30 is required as well"
}
