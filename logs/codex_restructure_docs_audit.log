     1	"""Score offline predictions (JSONL from generate.py). Pure python, runs anywhere.
     2	
     3	Protocol (AndroidControl / AITW convention):
     4	  type_match : predicted action_type == gt action_type
     5	  step_sr    : type_match AND argument match:
     6	      click/long_press : point inside GT element bbox (if known) OR within 14% of screen
     7	                         (euclidean distance in normalized [0,1] coords) of GT point
     8	      input_text/answer: normalized exact match OR token-F1 >= 0.5
     9	      scroll           : same direction
    10	      open_app         : case-insensitive equal / containment
    11	      others           : type match suffices
    12	  episode_sr : all steps of an episode correct (offline task completion proxy)
    13	Unparseable outputs count as wrong.
    14	
    15	Usage: python score.py preds.jsonl [--out metrics.json] [--by split_tag]
    16	"""
    17	
    18	import argparse
    19	import hashlib
    20	import os
    21	import json
    22	import math
    23	import re
    24	import sys
    25	from collections import Counter, defaultdict
    26	from pathlib import Path
    27	
    28	sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "train"))
    29	import agent_format as af  # noqa: E402
    30	
    31	CLICK_DIST = 0.14
    32	
    33	
    34	def _norm_text(s):
    35	    return re.sub(r"\s+", " ", re.sub(r"[^\w\s]", " ", (s or "").lower())).strip()
    36	
    37	
    38	def _f1(a, b):
    39	    ta, tb = _norm_text(a).split(), _norm_text(b).split()
    40	    if not ta and not tb:
    41	        return 1.0
    42	    common = sum((Counter(ta) & Counter(tb)).values())
    43	    if common == 0:
    44	        return 0.0
    45	    p, r = common / len(ta), common / len(tb)
    46	    return 2 * p * r / (p + r)
    47	
    48	
    49	def match(pred, gt, gt_bbox=None):
    50	    """pred/gt: action dicts in agent_format (point_2d in 0-1000). gt_bbox: [x1,y1,x2,y2] in 0-1000 or None."""
    51	    if pred is None:
    52	        return False, False
    53	    t = gt["action_type"]
    54	    if pred["action_type"] != t:
    55	        return False, False
    56	    if t in af.POINT_TYPES:
    57	        px, py = pred["point_2d"]
    58	        gx, gy = gt["point_2d"]
    59	        if gt_bbox is not None and gt_bbox[0] <= px <= gt_bbox[2] and gt_bbox[1] <= py <= gt_bbox[3]:
    60	            return True, True
    61	        d = math.hypot((px - gx) / 1000, (py - gy) / 1000)
    62	        return True, d <= CLICK_DIST
    63	    if t in ("input_text", "answer"):
    64	        a, b = _norm_text(pred.get("text")), _norm_text(gt.get("text"))
    65	        return True, a == b or _f1(a, b) >= 0.5
    66	    if t == "scroll":
    67	        return True, pred.get("direction") == gt.get("direction")
    68	    if t == "open_app":
    69	        a, b = _norm_text(pred.get("app_name")), _norm_text(gt.get("app_name"))
    70	        return True, bool(a) and (a == b or a in b or b in a)
    71	    if t == "status":
    72	        return True, pred.get("goal_status", "complete") == gt.get("goal_status", "complete")
    73	    return True, True
    74	
    75	
    76	def score_rows(rows, strict=False):
    77	    n = len(rows)
    78	    tm = sr = parse_ok = 0
    79	    per_type = defaultdict(lambda: [0, 0, 0])  # n, type_match, sr
    80	    episodes = defaultdict(list)
    81	    for r in rows:
    82	        gt = r["gt_action"] if isinstance(r["gt_action"], dict) else json.loads(r["gt_action"])
    83	        bbox = r.get("gt_bbox")
    84	        if isinstance(bbox, str):
    85	            bbox = json.loads(bbox) if bbox else None
    86	        pred = af.parse_action(r["output"], strict=strict)
    87	        parse_ok += pred is not None
    88	        t_ok, s_ok = match(pred, gt, bbox)
    89	        tm += t_ok
    90	        sr += s_ok
    91	        pt = per_type[gt["action_type"]]
    92	        pt[0] += 1
    93	        pt[1] += t_ok
    94	        pt[2] += s_ok
    95	        episodes[r["episode_id"]].append(s_ok)
    96	    ep_sr = sum(all(v) for v in episodes.values()) / max(1, len(episodes))
    97	    return {
    98	        "n_steps": n,
    99	        "n_episodes": len(episodes),
   100	        "parse_rate": parse_ok / max(1, n),
   101	        "type_match": tm / max(1, n),
   102	        "step_sr": sr / max(1, n),
   103	        "episode_sr": ep_sr,
   104	        "per_type": {k: {"n": v[0], "type_match": v[1] / v[0], "step_sr": v[2] / v[0]} for k, v in sorted(per_type.items())},
   105	    }
   106	
   107	
   108	def main():
   109	    ap = argparse.ArgumentParser()
   110	    ap.add_argument("preds")
   111	    ap.add_argument("--out")
   112	    _here = Path(__file__).resolve()
   113	    _cands = [os.environ.get("AC_TEST_GT", ""), str(_here.parents[2] / "data/meta/androidcontrol_test_gt.jsonl") if len(_here.parents) > 2 else "",
   114	              str(_here.parent / "meta/androidcontrol_test_gt.jsonl")]
   115	    ap.add_argument("--gt", default=next((c for c in _cands if c and os.path.exists(c)), _cands[-1]))
   116	    ap.add_argument("--expect", default="", help="comma list key=value that the generation manifest must match")
   117	    ap.add_argument("--modes", default="high,low", help="expected modes, e.g. 'high' for a high-only certified subset")
   118	    ap.add_argument("--allow_incomplete", action="store_true")
   119	    a = ap.parse_args()
   120	    preds = [json.loads(l) for l in open(a.preds)]
   121	    # --- integrity: score against the FROZEN ground truth, never the prediction file's own labels ---
   122	    gt_bytes = open(a.gt, "rb").read()
   123	    gt_man = Path(a.gt).with_suffix(".manifest.json")
   124	    if not gt_man.exists():
   125	        print(f"INTEGRITY PROBLEM: frozen GT manifest missing ({gt_man})", file=sys.stderr)
   126	        raise SystemExit(2)
   127	    if json.load(open(gt_man))["sha256"] != hashlib.sha256(gt_bytes).hexdigest():
   128	        print("INTEGRITY PROBLEM: frozen GT file does not match its manifest sha256", file=sys.stderr)
   129	        raise SystemExit(2)
   130	    modes = set(a.modes.split(","))
   131	    gt_rows = [json.loads(l) for l in gt_bytes.decode().splitlines() if l.strip()]
   132	    gt = {(r["episode_id"], r["step_idx"], r["mode"]): r for r in gt_rows if r["mode"] in modes}
   133	    pk = [(r["episode_id"], r["step_idx"], r.get("mode", "high")) for r in preds]
   134	    dups = len(pk) - len(set(pk))
   135	    mpath = a.preds + ".manifest.json"
   136	    manifest = json.load(open(mpath)) if Path(mpath).exists() else None
   137	    row_models = sorted({str(r.get("model")) for r in preds})
   138	    problems = []
   139	    if dups:
   140	        problems.append(f"{dups} duplicate keys")
   141	    missing = set(gt) - set(pk)
   142	    extra = set(pk) - set(gt)
   143	    if missing:
   144	        problems.append(f"{len(missing)} GT rows missing")
   145	    if extra:
   146	        problems.append(f"{len(extra)} prediction keys not in frozen GT")
   147	    if manifest is None:
   148	        problems.append("no generation manifest")
   149	    elif row_models != [manifest["model"]]:
   150	        problems.append(f"row models {row_models} != manifest model {manifest['model']}")
   151	    elif not manifest.get("config_hash") or {r.get("config_hash") for r in preds} != {manifest["config_hash"]}:
   152	        problems.append("row config_hash differs from manifest config_hash")
   153	    for kv in filter(None, a.expect.split(",")):
   154	        k, _, v = kv.partition("=")
   155	        if manifest is not None and str(manifest.get(k)) != v:
   156	            problems.append(f"manifest {k}={manifest.get(k)!r} != expected {v!r}")
   157	    integrity = {"n_pred_rows": len(preds), "n_gt_rows": len(gt), "duplicate_keys": dups, "missing": len(missing),
   158	                 "extra": len(extra), "row_models": row_models, "manifest": manifest, "gt_file": a.gt,
   159	                 "complete": not missing and not extra and not dups, "problems": problems}
   160	    if problems:
   161	        print("INTEGRITY PROBLEM:", problems, file=sys.stderr)
   162	        if not a.allow_incomplete:
   163	            raise SystemExit(2)
   164	    rows = []
   165	    for r in preds:
   166	        k = (r["episode_id"], r["step_idx"], r.get("mode", "high"))
   167	        if k in gt:
   168	            g = gt[k]
   169	            rows.append({**g, "output": r["output"]})
   170	    steps = [r for r in rows if not r.get("is_terminal")]
   171	    term = [r for r in rows if r.get("is_terminal")]
   172	    res = {}
   173	    for mode in sorted({r.get("mode", "high") for r in steps}):
   174	        mrows = [r for r in steps if r.get("mode", "high") == mode]
   175	        block = {"overall": score_rows(mrows), "overall_strict_parse": score_rows(mrows, strict=True)}
     1	"""Score generate.py output on a v2 dev split (gt_action is stored on every row; no external GT file needed).
     2	
     3	usage: python score_dev.py preds.jsonl --expect_n N --out metrics.json
     4	Uses score.match / score.score_rows unchanged (click within 0.14 of the GT point; text/answer: normalized exact or
     5	token-F1 >= 0.5; scroll/status exact). Also reports mean token-F1 for `answer` rows (ScreenQA-style).
     6	"""
     7	import argparse
     8	import json
     9	import sys
    10	import os
    11	
    12	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    13	import score  # noqa: E402
    14	import agent_format as af  # noqa: E402
    15	
    16	ap = argparse.ArgumentParser()
    17	ap.add_argument("preds")
    18	ap.add_argument("--expect_n", type=int, required=True)
    19	ap.add_argument("--out", required=True)
    20	a = ap.parse_args()
    21	rows = [json.loads(l) for l in open(a.preds)]
    22	seen = {(r["episode_id"], r["step_idx"]) for r in rows}
    23	complete = len(seen) == a.expect_n == len(rows)
    24	m = score.score_rows(rows)
    25	f1 = [score._f1((af.parse_action(r["output"]) or {}).get("text") if (af.parse_action(r["output"]) or {}).get("action_type") == "answer" else "",
    26	                json.loads(r["gt_action"])["text"]) for r in rows if json.loads(r["gt_action"])["action_type"] == "answer"]
    27	m["answer_mean_f1"] = sum(f1) / len(f1) if f1 else None
    28	m["integrity"] = {"complete": complete, "n_rows": len(rows), "expected": a.expect_n, "model": rows[0].get("model") if rows else None}
    29	json.dump(m, open(a.out, "w"), indent=1)
    30	print(json.dumps({k: m[k] for k in ("n_steps", "parse_rate", "type_match", "step_sr", "answer_mean_f1")}))
    31	sys.exit(0 if complete else 1)
     1	"""Shared prompt + action format for the LFM3-VL Android agent.
     2	
     3	Used identically by: training-data builder, offline AndroidControl eval, and the
     4	AndroidWorld agent, so train/test prompts can never drift apart.
     5	
     6	Design (on-device first):
     7	  * one screenshot per step (current screen only) -> bounded prefill cost on phones
     8	  * text history of previous step intents + actions (last HISTORY_STEPS)
     9	  * coordinates are integers normalized to [0, 1000] (LFM3-VL's native point_2d grid)
    10	  * assistant output = short intent in the <think> block + one compact JSON action
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import hashlib
    16	import json
    17	import random
    18	import re
    19	from typing import Any
    20	
    21	HISTORY_STEPS = 8
    22	
    23	SYSTEM_PROMPT = """You are a phone-use agent operating an Android phone to complete the user's goal.
    24	Each turn you see the goal, your previous steps, and the current screenshot. Reply with ONE next action as JSON.
    25	Coordinates are integers normalized to 0-1000 (x from left, y from top) of the screenshot.
    26	Actions:
    27	{"action_type":"click","point_2d":[x,y]}
    28	{"action_type":"long_press","point_2d":[x,y]}
    29	{"action_type":"input_text","text":"..."}  (types into the focused field)
    30	{"action_type":"scroll","direction":"up|down|left|right"}  (down = reveal content below)
    31	{"action_type":"open_app","app_name":"..."}
    32	{"action_type":"navigate_back"}
    33	{"action_type":"navigate_home"}
    34	{"action_type":"keyboard_enter"}
    35	{"action_type":"wait"}
    36	{"action_type":"answer","text":"..."}  (reply to a question about the screen)
    37	{"action_type":"status","goal_status":"complete|infeasible"}  (finish the task)"""
    38	
    39	# v4 (2026-11-18): AndroidWorld analysis showed the agent never answers questions - it navigated to the right screen and
    40	# then declared `complete`, partly because v1-v3 described `answer` as a "reply to a question about the screen".
    41	# v4 states when to answer vs complete and lists the installed apps (fixes invented names such as "Marker" for Markor).
    42	# Models v1-v3 keep SYSTEM_PROMPT; v4 data and the v4 AndroidWorld agent use SYSTEM_PROMPT_V4 + an "Installed apps" line.
    43	SYSTEM_PROMPT_V4 = """You are a phone-use agent operating an Android phone to complete the user's goal.
    44	Each turn you see the goal, the installed apps, your previous steps, and the current screenshot. Reply with ONE next action as JSON.
    45	Coordinates are integers normalized to 0-1000 (x from left, y from top) of the screenshot.
    46	Actions:
    47	{"action_type":"click","point_2d":[x,y]}
    48	{"action_type":"long_press","point_2d":[x,y]}
    49	{"action_type":"input_text","text":"..."}  (types into the focused field)
    50	{"action_type":"scroll","direction":"up|down|left|right"}  (down = reveal content below)
    51	{"action_type":"open_app","app_name":"..."}  (app_name must be one of the installed apps)
    52	{"action_type":"navigate_back"}
    53	{"action_type":"navigate_home"}
    54	{"action_type":"keyboard_enter"}
    55	{"action_type":"wait"}
    56	{"action_type":"answer","text":"..."}  (if the goal asks a question: the final reply, as short as possible and in the requested format; ends the task)
    57	{"action_type":"status","goal_status":"complete|infeasible"}  (finish a goal that asks for no information; never use it instead of answering a question)"""
    58	
    59	PROMPTS = {"v1": SYSTEM_PROMPT, "v4": SYSTEM_PROMPT_V4}
    60	
    61	VALID_TYPES = {
    62	    "click", "long_press", "input_text", "scroll", "open_app", "navigate_back",
    63	    "navigate_home", "keyboard_enter", "wait", "answer", "status",
    64	}
    65	POINT_TYPES = {"click", "long_press"}
    66	_DIRECTIONS = {"up", "down", "left", "right"}
    67	
    68	
    69	def action_to_str(a: dict[str, Any]) -> str:
    70	    """Canonical compact JSON for an action (stable key order, no spaces)."""
    71	    t = a["action_type"]
    72	    out: dict[str, Any] = {"action_type": t}
    73	    if t in POINT_TYPES:
    74	        out["point_2d"] = [int(a["point_2d"][0]), int(a["point_2d"][1])]
    75	    elif t in ("input_text", "answer"):
    76	        out["text"] = a["text"]
    77	    elif t == "scroll":
    78	        out["direction"] = a["direction"]
    79	    elif t == "open_app":
    80	        out["app_name"] = a["app_name"]
    81	    elif t == "status":
    82	        out["goal_status"] = a.get("goal_status", "complete")
    83	    return json.dumps(out, ensure_ascii=False, separators=(",", ":"))
    84	
    85	
    86	def history_text(history: list[tuple[str, str]]) -> str:
    87	    """history: list of (intent, action_json_str), oldest first."""
    88	    if not history:
    89	        return "None"
    90	    start = max(0, len(history) - HISTORY_STEPS)
    91	    lines = []
    92	    for i, (intent, act) in enumerate(history[start:], start=start + 1):
    93	        lines.append(f"{i}. {intent} -> {act}" if intent else f"{i}. {act}")
    94	    return "\n".join(lines)
    95	
    96	
    97	def apps_line(apps: list[str]) -> str:
    98	    return "Installed apps: " + ", ".join(apps)
    99	
   100	
   101	def user_text(goal: str, history: list[tuple[str, str]], step_instruction: str | None = None,
   102	              apps: list[str] | None = None) -> str:
   103	    """apps=None -> v1-v3 format (no app line); apps=[...] -> v4 format (app line right after the goal)."""
   104	    s = f"Goal: {goal}\n" + (apps_line(apps) + "\n" if apps is not None else "") + f"Previous steps:\n{history_text(history)}"
   105	    if step_instruction:
   106	        s += f"\nCurrent step hint: {step_instruction}"
   107	    return s + "\nWhat is the next action?"
   108	
   109	
   110	def v4_app_list(key: str, required: list[str], pool: list[str]) -> list[str]:
   111	    """Training/offline-eval stand-in for a device's installed apps: the episode's own apps plus distractors from the
   112	    training app pool, 12-30 names, deterministic per episode key, sorted case-insensitively like the device list."""
   113	    rnd = random.Random(hashlib.sha256(key.encode()).hexdigest())
   114	    k = rnd.randint(12, 30)
   115	    apps = list(dict.fromkeys(a for a in required if a))
   116	    cand = sorted({p for p in pool if p and p not in apps})
   117	    rnd.shuffle(cand)
   118	    apps += cand[: max(0, k - len(apps))]
   119	    return sorted(apps, key=str.lower)
   120	

