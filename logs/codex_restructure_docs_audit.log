    ("Qwen3.5-2B base", "qwen35-2b-ac-lora_base", "qwen35_2b_base", None),
    ("Qwen3.5-2B v1", "qwen35-2b-ac-lora_ft", "qwen35_2b_v1", "qwen35_2b"),
    ("**Qwen3.5-2B v2**", "qwen35-2b-v2mix-lora_ft", "qwen35_2b_v2", "qwen35_2b_v2")]:
    h, l, t = ac(acn)
