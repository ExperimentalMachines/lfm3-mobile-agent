     2	# Launch a GCP VM with nested virtualization (KVM) for MobileWorld Android emulators (2026-11-18; credits project).
     3	#   - n2-standard-16 (16 vCPU / 64 GB) SPOT in us-west1 (Oregon, next to AWS us-west-2), Ubuntu 24.04, 200 GB pd-balanced
     4	#   - its own VPC "lfm3-mw": only SSH (22) from this Mac's public IP (more sources added explicitly, e.g. a Colab VM)
     5	#   - cost guard: --max-run-duration (default 12 h) then STOP; spot preemption also STOPs (disk kept; delete when done)
     6	#   - writes REGION/ZONE/NAME/IP/PEM to $STATE so scripts/mobileworld/aws_mw_setup.sh can bootstrap MobileWorld unchanged
     7	# Usage: bash scripts/mobileworld/gcp_mw_launch.sh    (env: NAME, TYPE, ZONE, MAX_H, STATE)
     8	set -euo pipefail
     9	cd "$(dirname "$0")/../.."
    10	P=${PROJECT:-voltaic-psyche-514908-s2}; ZONE=${ZONE:-us-west1-b}; REGION=${ZONE%-*}; TYPE=${TYPE:-n2-standard-16}
    11	NAME=${NAME:-lfm3-mw-gcp-1}; MAX_H=${MAX_H:-12}; STATE=${STATE:-logs/gcp_mw_instance.env}; NET=lfm3-mw
    12	PEM=$HOME/.ssh/lfm3-gcp
    13	G() { gcloud --project "$P" --quiet "$@"; }
    14	[ -s "$PEM" ] || ssh-keygen -q -t ed25519 -N "" -C lfm3-gcp -f "$PEM"
    15	MYIP=$(curl -s https://checkip.amazonaws.com | tr -d '\n')
    16	G compute networks describe $NET >/dev/null 2>&1 || G compute networks create $NET --subnet-mode=auto >/dev/null
    17	G compute firewall-rules describe $NET-ssh-mac >/dev/null 2>&1 || \
    18	  G compute firewall-rules create $NET-ssh-mac --network $NET --allow tcp:22 --source-ranges "$MYIP/32" >/dev/null
    19	cat > /tmp/lfm3_gcp_startup.sh <<'EOF'
    20	#!/bin/bash
    21	[ -f /home/ubuntu/bootstrap_done ] && exit 0
    22	apt-get update -y && apt-get install -y docker.io cpu-checker git curl
    23	usermod -aG docker ubuntu
    24	curl -LsSf https://astral.sh/uv/install.sh | sudo -u ubuntu sh
    25	(kvm-ok; ls -l /dev/kvm) > /home/ubuntu/kvm_check.txt 2>&1
    26	touch /home/ubuntu/bootstrap_done
    27	EOF
    28	G compute instances create "$NAME" --zone "$ZONE" --machine-type "$TYPE" --network "$NET" \
    29	  --enable-nested-virtualization --provisioning-model=SPOT --instance-termination-action=STOP \
    30	  --max-run-duration="${MAX_H}h" \
    31	  --image-family=ubuntu-2404-lts-amd64 --image-project=ubuntu-os-cloud --boot-disk-size=200GB --boot-disk-type=pd-balanced \
    32	  --metadata-from-file=startup-script=/tmp/lfm3_gcp_startup.sh --metadata="ssh-keys=ubuntu:$(cat "$PEM.pub")" \
    33	  --labels=project=lfm3-android >/dev/null
    34	IP=$(G compute instances describe "$NAME" --zone "$ZONE" --format="value(networkInterfaces[0].accessConfigs[0].natIP)")
    35	printf "REGION=%s\nZONE=%s\nNAME=%s\nIP=%s\nPEM=%s\nTYPE=%s\nPROJECT=%s\n" "$REGION" "$ZONE" "$NAME" "$IP" "$PEM" "$TYPE" "$P" > "$STATE"
    36	echo "launched $NAME ($TYPE spot, $ZONE) at $IP; stops after ${MAX_H} h"
     1	#!/bin/bash
     2	# Launch one EC2 instance with nested virtualization (KVM) for MobileWorld Android emulators (smoke test, 2026-11-18).
     3	#   - c8i.4xlarge (16 vCPU / 32 GiB; fits the account's 16-vCPU on-demand quota), us-west-2, Ubuntu 24.04, 200 GB gp3
     4	#   - SSH only from this machine's current public IP; key kept in ~/.ssh (never in the repo)
     5	#   - cost guard: the instance powers itself off after MAX_H hours (shutdown behaviour = stop, so the disk is kept)
     6	# Usage: bash scripts/mobileworld/aws_mw_launch.sh            (prints the instance id and public IP; state in logs/aws_mw_instance.env)
     7	#        SPOT=1 NAME=lfm3-mobileworld-2 STATE=logs/aws_mw_instance2.env bash scripts/mobileworld/aws_mw_launch.sh   (spot, second instance)
     8	set -euo pipefail
     9	cd "$(dirname "$0")/../.."
    10	R=${REGION:-us-west-2}; TYPE=${TYPE:-c8i.4xlarge}; KEY=lfm3-mw; SG_NAME=lfm3-mw-ssh; MAX_H=${MAX_H:-12}; NAME=${NAME:-lfm3-mobileworld-smoke}; STATE=${STATE:-logs/aws_mw_instance.env}
    11	MARKET=(); [ "${SPOT:-0}" = 1 ] && MARKET=(--instance-market-options "MarketType=spot,SpotOptions={SpotInstanceType=one-time,InstanceInterruptionBehavior=terminate}")
    12	PEM=$HOME/.ssh/$KEY.pem
    13	A() { aws --region "$R" "$@"; }
    14	if [ ! -s "$PEM" ]; then
    15	  A ec2 create-key-pair --key-name $KEY --key-type ed25519 --query KeyMaterial --output text > "$PEM"; chmod 600 "$PEM"
    16	fi
    17	MYIP=$(curl -s https://checkip.amazonaws.com | tr -d '\n')
    18	VPC=$(A ec2 describe-vpcs --filters Name=isDefault,Values=true --query 'Vpcs[0].VpcId' --output text)
    19	SG=$(A ec2 describe-security-groups --filters Name=group-name,Values=$SG_NAME Name=vpc-id,Values=$VPC --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null || true)
    20	if [ -z "$SG" ] || [ "$SG" = None ]; then
    21	  SG=$(A ec2 create-security-group --group-name $SG_NAME --description "SSH from the lfm3-android Mac only" --vpc-id "$VPC" --query GroupId --output text)
    22	fi
    23	A ec2 authorize-security-group-ingress --group-id "$SG" --protocol tcp --port 22 --cidr "$MYIP/32" >/dev/null 2>&1 || true
    24	AMI=$(A ssm get-parameter --name /aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id --query Parameter.Value --output text)
    25	cat > /tmp/lfm3_mw_userdata.sh <<EOF
    26	#!/bin/bash
    27	shutdown -h +$((MAX_H * 60)) "lfm3-mw cost guard"
    28	apt-get update -y && apt-get install -y docker.io cpu-checker git curl
    29	usermod -aG docker ubuntu
    30	curl -LsSf https://astral.sh/uv/install.sh | sudo -u ubuntu sh
    31	(kvm-ok; ls -l /dev/kvm) > /home/ubuntu/kvm_check.txt 2>&1
    32	touch /home/ubuntu/bootstrap_done
    33	EOF
    34	IID=$(A ec2 run-instances --image-id "$AMI" --instance-type "$TYPE" --key-name $KEY --security-group-ids "$SG" \
    35	  --cpu-options "NestedVirtualization=enabled" ${MARKET[@]+"${MARKET[@]}"} \
    36	  --instance-initiated-shutdown-behavior $([ "${SPOT:-0}" = 1 ] && echo terminate || echo stop) \
    37	  --block-device-mappings '[{"DeviceName":"/dev/sda1","Ebs":{"VolumeSize":200,"VolumeType":"gp3","DeleteOnTermination":true}}]' \
    38	  --user-data file:///tmp/lfm3_mw_userdata.sh \
    39	  --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=$NAME},{Key=project,Value=lfm3-android}]" \
    40	  --query 'Instances[0].InstanceId' --output text)
    41	A ec2 wait instance-running --instance-ids "$IID"
    42	IP=$(A ec2 describe-instances --instance-ids "$IID" --query 'Reservations[0].Instances[0].PublicIpAddress' --output text)
    43	printf "REGION=%s\nIID=%s\nIP=%s\nPEM=%s\nTYPE=%s\n" "$R" "$IID" "$IP" "$PEM" "$TYPE" > "$STATE"
    44	echo "launched $IID ($TYPE, $R) at $IP; auto power-off in ${MAX_H} h"
