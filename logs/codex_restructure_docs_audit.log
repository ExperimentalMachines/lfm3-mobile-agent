"""AndroidWorld development seed 30: score and in-run speed of every model, from the saved episode files.

Seed 30 was used to choose between versions (docs/PREREG_v4.md), so these are development numbers, not the held-out
result (results/sealed_analysis_final.md). Per run: full successes (is_successful >= 1; exceptions count as failures),
answer-task vs action-task successes (answer tasks: results/codex/v3_audit/answer_tasks.json), exceptions, median steps,
and per-step model latency on the Apple M5 (llama.cpp Metal, measured inside the run while emulators and other servers
were running) with median prompt/output tokens. Latest run directory of each model, as in the gate.
(Moved here from the removed run-log generator, scripts/build_runs_registry.py, 2026-11-20; same computation.)
Usage: .venv-aw/bin/python analysis/aw_dev_seed30.py  ->  results/androidworld/dev_seed30_summary.{json,md}
"""
import glob
import gzip
import json
import pickle  # episode files are written by this repo's own AndroidWorld harness (trusted, not downloaded)
import statistics as st

ANS = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"])
RUNS = [  # (results/androidworld/<dir>, label, quantisation)
    ("lfm3vl2b_v4", "LFM3-VL-2B v4 (final)", "Q4_K_M"),
    ("maiui_2b_matched_q8_0", "MAI-UI-2B (1 screenshot)", "Q8_0"),
    ("guiowl15_2b_matched", "GUI-Owl-1.5-2B (1 screenshot)", "Q4_K_M"),
    ("qwen35_2b_ft", "Qwen3.5-2B v1", "Q4_K_M"),
    ("lfm3vl2b_ft", "LFM3-VL-2B v1", "Q4_K_M"),
    ("lfm3vl2b_v3", "LFM3-VL-2B v3", "Q4_K_M"),
    ("qwen35_08b_ft", "Qwen3.5-0.8B v1", "Q4_K_M"),
    ("lfm3vl2b_ft_runtimefb", "LFM3-VL-2B v1 + runtime feedback (ablation)", "Q4_K_M"),
    ("lfm3vl2b_v2_forcethink", "LFM3-VL-2B v2 + forced intent (ablation)", "Q4_K_M"),
    ("lfm3vl2b_v2", "LFM3-VL-2B v2", "Q4_K_M"),
    ("lfm25vl450m_ft", "LFM2.5-VL-450M v1", "Q4_K_M"),
    ("lfm3vl2b_base_nothink", "LFM3-VL-2B base (no thinking)", "Q4_K_M"),
    ("lfm25vl450m_base", "LFM2.5-VL-450M base", "Q4_K_M"),
]


def run(d):
    r = sorted(glob.glob(f"results/androidworld/{d}/run_*/"))[-1]
    eps = [pickle.loads(gzip.decompress(open(f, "rb").read()))[0] for f in sorted(glob.glob(r + "*.pkl.gz"))]
    ok = lambda e: (lambda v: v is not None and v == v and v >= 1)(e.get("is_successful"))
    lat, steps, P, G = [], [], [], []
    for e in eps:
        dd = e.get("episode_data")
        if isinstance(dd, dict):
            lat += [x for x in (dd.get("latency_s") or []) if isinstance(x, (int, float)) and x == x]
            for u in dd.get("usage") or []:
                if isinstance(u, dict) and u.get("prompt_tokens"):
                    P.append(u["prompt_tokens"]); G.append(u.get("completion_tokens", 0))
        L = e.get("episode_length")
        if isinstance(L, (int, float)) and L == L:
            steps.append(L)
    q = sorted(lat)
    return {"run_dir": r, "agent": eps[0].get("agent_name"), "seed": eps[0].get("seed"), "episodes": len(eps),
            "successes": sum(map(ok, eps)),
            "answer_task_successes": sum(1 for e in eps if ok(e) and e["task_template"] in ANS),
            "action_task_successes": sum(1 for e in eps if ok(e) and e["task_template"] not in ANS),
            "exceptions": sum(1 for e in eps if e.get("exception_info") is not None),
            "median_steps": int(st.median(steps)) if steps else None,
            "steps_timed": len(lat), "step_latency_median_s": round(st.median(lat), 2) if lat else None,
            "step_latency_p10_s": round(q[len(q) // 10], 2) if q else None,
            "step_latency_p90_s": round(q[9 * len(q) // 10], 2) if q else None,
            "prompt_tokens_median": int(st.median(P)) if P else None,
            "output_tokens_median": int(st.median(G)) if G else None}


rows = [{"id": d, "label": lab, "quant": qt, **run(d)} for d, lab, qt in RUNS]
assert all(r["episodes"] == 116 for r in rows), [(r["id"], r["episodes"]) for r in rows if r["episodes"] != 116]
json.dump(rows, open("results/androidworld/dev_seed30_summary.json", "w"), indent=1)
L = ["# AndroidWorld development seed 30 (116 tasks; development numbers, not the held-out result)", "",
     "| Model | Quant | Successes /116 | Answer tasks /25 | Action tasks /91 | Exceptions | Median steps | "
     "M5 s/step, median (p10-p90) | Prompt tokens | Output tokens |",
     "|---|---|---|---|---|---|---|---|---|---|"]
for r in rows:
    L.append(f"| {r['label']} | {r['quant']} | {r['successes']} | {r['answer_task_successes']} | "
             f"{r['action_task_successes']} | {r['exceptions']} | {r['median_steps']} | {r['step_latency_median_s']} "
             f"({r['step_latency_p10_s']}-{r['step_latency_p90_s']}) | {r['prompt_tokens_median']} | "
             f"{r['output_tokens_median']} |")
L += ["", "Full successes only (is_successful >= 1); exceptions count as failures. Latency = model time per step on an "
      "Apple M5 (llama.cpp Metal), measured inside the run. Generated by analysis/aw_dev_seed30.py."]
open("results/androidworld/dev_seed30_summary.md", "w").write("\n".join(L) + "\n")
print("\n".join(L))
"""Sensitivity analyses for the final held-out AndroidWorld result (docs/PREREG_v4.md, 2026-11-19 13:40 and 16:20).

Not preregistered. Reuses analysis/sealed_analysis.py unchanged (loaded with runpy, so its input checks, its re-run
substitution and its template-clustered sign-flip test + test-inversion CI are exactly the primary ones) and varies only
which paired instances enter, or how one set of episodes is scored:
  A. primary (reproduced);
  B. drop every (seed, template) pair in which v4 or GUI-Owl still ends in an exception (scoring-phase / after-step-1
     exceptions counted as failures in the primary, and re-runs that crashed again);
  B3. drop the three templates named in the 13:40 entry (BrowserDraw, SimpleSmsReplyMostRecent,
     SimpleSmsSendReceivedAddress) on every seed, as that entry literally promised;
  C. v4 seed 1234's 113 re-run episodes counted as failures (as if the re-run rule had not been applied);
  D. seed 1234 excluded entirely (seeds 7 and 2026, clusters = templates across those two seeds).
Usage: .venv-aw/bin/python analysis/sealed_sensitivity.py  ->  results/sealed_sensitivity_final.{json,md}
"""
import json
import math
import os
import runpy
import sys
import tempfile

tmp = tempfile.mkdtemp()
sys.argv = ["sealed_analysis.py", "--seeds", "7,1234,2026", "--out", os.path.join(tmp, "a")]
G = runpy.run_path("analysis/sealed_analysis.py")
data, META, signflip, signflip_ci, SUBST = G["data"], G["META"], G["signflip"], G["signflip_ci"], G["SUBST"]
NI = G["NI_MARGIN"]


def paired(x, y, seeds, keep=lambda s, t: True, ok=lambda arm, s, t: data[(arm, s)][0][t]):
    clusters, diffs, n_x, n_y = [], [], 0, 0
    for t in sorted(META):
        ds = [int(ok(x, s, t)) - int(ok(y, s, t)) for s in seeds if keep(s, t)]
        n_x += sum(int(ok(x, s, t)) for s in seeds if keep(s, t))
        n_y += sum(int(ok(y, s, t)) for s in seeds if keep(s, t))
        if ds:
            clusters.append((sum(ds), len(ds)))
            diffs += ds
    n = len(diffs)
    ex = signflip_ci(clusters, n)
    ci = [math.floor(1000 * ex[0] + 1e-9) / 10, math.ceil(1000 * ex[1] - 1e-9) / 10] if ex else None
    return {"n_instances": n, "n_clusters": len(clusters), f"{x}_successes": n_x, f"{y}_successes": n_y,
            "mean_diff_pp": round(100 * sum(diffs) / n, 1), "signflip_p_two_sided": round(signflip(clusters, n), 4),
            "ci95_pp_test_inversion": ci, "non_inferior_vs_margin": bool(ex and 100 * ex[0] > NI)}


S = [7, 1234, 2026]
exc = lambda arm, s, t: data[(arm, s)][1][t]
dropped = sorted((s, t) for s in S for t in META if exc("v4", s, t) or exc("guiowl", s, t))
rerun113 = {r["task"] for r in SUBST if r["arm"] == "v4" and r["seed"] == 1234}
out = {
    "A_primary": paired("v4", "guiowl", S),
    "B_drop_pairs_with_remaining_exceptions": dict(paired("v4", "guiowl", S, keep=lambda s, t: (s, t) not in dropped),
                                                   dropped=[f"seed {s} {t}" for s, t in dropped]),
    "B3_drop_three_templates_named_1340": paired("v4", "guiowl", S, keep=lambda s, t: t not in {
        "BrowserDraw", "SimpleSmsReplyMostRecent", "SimpleSmsSendReceivedAddress"}),
    "C_v4_seed1234_reruns_counted_as_failures": dict(paired("v4", "guiowl", S, ok=lambda arm, s, t: False if (
        arm == "v4" and s == 1234 and t in rerun113) else data[(arm, s)][0][t]), n_reruns=len(rerun113)),
    "D_seed1234_excluded": paired("v4", "guiowl", [7, 2026]),
    "notes": ["Not preregistered; the primary analysis is results/sealed_analysis_final.md.",
              f"Non-inferiority margin {NI} pp on the lower bound of the 95% sign-flip test-inversion interval."],
}
json.dump(out, open("results/sealed_sensitivity_final.json", "w"), indent=1)
L = ["# Held-out AndroidWorld: sensitivity analyses (v4 - GUI-Owl, not preregistered)", "",
     "| Variant | Paired instances (templates) | v4 | GUI-Owl | Difference (pp) | 95% CI | p | Non-inferior (-6.9 pp) |",
     "|---|---|---|---|---|---|---|---|"]
for k, v in out.items():
    if k == "notes":
        continue
    L.append(f"| {k} | {v['n_instances']} ({v['n_clusters']}) | {v['v4_successes']} | {v['guiowl_successes']} | "
             f"{v['mean_diff_pp']} | {v['ci95_pp_test_inversion']} | {v['signflip_p_two_sided']} | "
             f"{'yes' if v['non_inferior_vs_margin'] else 'no'} |")
L += ["", "Dropped in B: " + ", ".join(out["B_drop_pairs_with_remaining_exceptions"]["dropped"])] + [""] + out["notes"]
open("results/sealed_sensitivity_final.md", "w").write("\n".join(L) + "\n")
print("\n".join(L))
"""Pre-registered held-out analysis (docs/PREREG_v4.md, "Analysis") for the sealed AndroidWorld arms.

Arms: v4 (LFM3 final), guiowl (GUI-Owl matched), v1 (reference). Only the seeds given with --seeds are opened; run it
only for seeds whose arms have ALL finished (it refuses otherwise). Score = full success (is_successful >= 1, exception =
failure) per task template (n_task_combinations = 1, so one instance per template per seed).
Primary: paired difference v4 - GUI-Owl over all held-out instances; template-clustered sign-flip permutation test
(10,000 permutations, clusters = templates, seed 0); 95% CI by inverting that test; non-inferiority if the lower
bound > -6.9 pp. Also: exact McNemar per seed, Wilson CIs, answer/action split, per difficulty, templates whose goal text
can vary with the seed (source-checked manifest results/aw_template_manifest.json, 78 templates).
CI endpoints are the exact endpoints of the accepted set of the inverted test for the fixed 10,000 sign draws (found at
the test's breakpoints), reported rounded outward to 0.1 pp; the non-inferiority decision uses the unrounded bound.
Sensitivity: successes disputed by the per-success trajectory review (results/aw_checker_disputes.json) counted as
failures; the primary score is never rewritten.
Usage: python analysis/sealed_analysis.py --seeds 7 --out results/sealed_analysis_seed7
"""
import argparse
import glob
import gzip
import hashlib
import json
import math
import os
import pickle
import re
from math import comb

import numpy as np

p = argparse.ArgumentParser()
p.add_argument("--seeds", required=True, help="comma-separated held-out seeds (all arms must be complete)")
p.add_argument("--out", required=True, help="output prefix (.json and .md are written)")
p.add_argument("--perms", type=int, default=10000)
a = p.parse_args()
SEEDS = [int(s) for s in a.seeds.split(",")]
ARMS = {"v4": "lfm3vl2b_v4_q4km", "guiowl": "guiowl15_2b_matched1img_apps_q4km", "v1": "lfm3vl2b_v1_q4km"}
LABEL = {"v4": "LFM3 v4 (final)", "guiowl": "GUI-Owl-1.5-2B matched", "v1": "LFM3 v1 (reference)"}
NI_MARGIN = -6.9
ANSWER = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"])
META = {m["task_name"]: m for m in json.load(open("android_world/android_world/task_metadata.json"))}
VARY = set(json.load(open("results/aw_template_manifest.json"))["goal_text_can_vary"])
assert len(VARY) == 78 and VARY <= set(META)
DISPUTES = json.load(open("results/aw_checker_disputes.json"))["disputes"]
SETUP = {}  # (run_root, template) -> True if the exception's last traceback is task setup (_run_task -> initialize_task)


def instance_seed(suite_seed, t, i=0):  # android_world suite_utils.create_suite._get_instance_seed
    return int(hashlib.sha256(f"{suite_seed}_{t}_{i}".encode()).hexdigest(), 16) % (2 ** 32)


def load(run_root, agent, expect=116, full=True):
    runs = [d for d in glob.glob(os.path.join(run_root, "run_*")) if os.path.isdir(d)]  # not run_output.SEALED.log
    if len(runs) != 1:
        raise SystemExit(f"INPUT ERROR: {run_root} must contain exactly one run dir, found {len(runs)}")
    files = glob.glob(os.path.join(runs[0], "*.pkl.gz"))
    if expect is not None and len(files) != expect:
        raise SystemExit(f"INPUT ERROR: {run_root} has {len(files)} episodes, expected {expect} (arm not finished?)")
    ok, exc, goal, steps = {}, {}, {}, {}
    for f in files:
        ep = pickle.load(gzip.open(f))  # trusted: written by our own local AndroidWorld runs
        if isinstance(ep, list):
            if len(ep) != 1:
                raise SystemExit(f"INPUT ERROR: {f} holds {len(ep)} episodes")
            ep = ep[0]
        t = os.path.basename(f).rsplit("_", 1)[0]
        if t in ok or ep.get("task_template") != t:
            raise SystemExit(f"INPUT ERROR: duplicate or mislabelled episode {f}")
        if ep.get("agent_name") != agent:
            raise SystemExit(f"INPUT ERROR: {f} agent_name {ep.get('agent_name')!r} != {agent!r}")
        r = ep.get("is_successful")
        e = bool(ep.get("exception_info"))
        # instance identity (Codex final audit P3-1): instance 0 of this template under this run's suite seed. Episodes
        # that crashed in setup do not store the seed; every other episode must.
        if ep.get("instance_id") != 0:
            raise SystemExit(f"INPUT ERROR: {f} instance_id {ep.get('instance_id')!r} != 0")
        if "seed" in ep or not e:
            if ep.get("seed") != instance_seed(int(re.search(r"_seed(\d+)", run_root).group(1)), t):
                raise SystemExit(f"INPUT ERROR: {f} stored seed {ep.get('seed')!r} is not this suite seed's instance seed")
        if e:
            frames = re.findall(r'File "[^"]+", line \d+, in (\w+)', str(ep["exception_info"]).split(
                "Traceback (most recent call last):")[-1])
            SETUP[(run_root, t)] = frames[:2] == ["_run_task", "initialize_task"]
        ok[t] = isinstance(r, (int, float)) and not math.isnan(r) and r >= 1 and not e
        exc[t] = e
        goal[t] = re.sub(r"\d{8}_\d{6}", "<ts>", ep.get("goal") or "")
        steps[t] = ep.get("episode_length")
    if full and set(ok) != set(META):
        raise SystemExit(f"INPUT ERROR: {run_root} templates differ from task_metadata.json")
    return ok, exc, goal, steps


def wilson(k, n, z=1.959964):
    ph = k / n
    c = (ph + z * z / (2 * n)) / (1 + z * z / n)
    h = z * math.sqrt(ph * (1 - ph) / n + z * z / (4 * n * n)) / (1 + z * z / n)
    return [round(100 * (c - h), 1), round(100 * (c + h), 1)]


def mcnemar(b, c):
    n = b + c
    if n == 0:
        return 1.0
    k = min(b, c)
    return min(1.0, 2 * sum(comb(n, i) for i in range(k + 1)) / 2 ** n)


def signflip(cluster_sums, n_inst, delta=0.0, perms=10000, seed=0):
    """Two-sided p for H0: mean paired difference = delta, flipping signs of template-cluster sums of (d - delta)."""
    x = np.array([s - delta * m for s, m in cluster_sums])
    obs = abs(x.sum()) / n_inst
    rng = np.random.default_rng(seed)
    signs = rng.choice([-1.0, 1.0], size=(perms, len(x)))
    stats = np.abs(signs @ x) / n_inst
    return float((1 + np.sum(stats >= obs - 1e-12)) / (perms + 1))


def signflip_ci(cluster_sums, n_inst, perms=10000, seed=0, alpha=0.05):
    """Exact endpoints of {delta: signflip(delta) >= alpha} for the same sign draws as signflip(). For draw j the
    extremeness indicator |A_j - delta*B_j| >= |A0 - delta*B0| changes only where A_j - delta*B_j = +-(A0 - delta*B0), and
    it holds with equality there, so the accepted set's endpoints are among these breakpoints (plus the point estimate)."""
    x = np.array([s for s, m in cluster_sums], float)
    w = np.array([m for s, m in cluster_sums], float)
    rng = np.random.default_rng(seed)
    signs = rng.choice([-1.0, 1.0], size=(perms, len(x)))
    A, B, A0, B0 = signs @ x, signs @ w, x.sum(), w.sum()
    with np.errstate(divide="ignore", invalid="ignore"):
        cand = np.concatenate([(A - A0) / (B - B0), (A + A0) / (B + B0), [A0 / B0]])
    cand = np.unique(cand[np.isfinite(cand) & (cand >= -1) & (cand <= 1)])
    acc = []
    for i in range(0, len(cand), 400):
        d = cand[i:i + 400][:, None]
        cnt = np.sum(np.abs(A[None, :] - d * B[None, :]) >= np.abs(A0 - d * B0) - 1e-9, axis=1)
        acc += list(cand[i:i + 400][(1 + cnt) / (perms + 1) >= alpha])
    return (float(min(acc)), float(max(acc))) if acc else None


# ---- load (only the requested, complete seeds)
data = {}
for s in SEEDS:
    for arm, agent in ARMS.items():
        data[(arm, s)] = load(f"results/androidworld_sealed/{arm}_seed{s}", agent)
# preregistered single re-run of infrastructure crashes before step 1: results/androidworld_sealed/<arm>_seed<s>_rerun
# replaces an original episode only if that episode was an exception and the re-run's goal text is identical.
# Exception (2026-11-19 16:20 entry in docs/PREREG_v4.md): information-retrieval templates reword their date parameter
# ("October 22 2023" -> "this Sunday") inside initialize_task AFTER the device setup (android_world/.../information_retrieval
# .py:85), so an episode that crashed in setup records the raw date. Such a re-run is accepted only if its goal equals
# the goal of EVERY other arm on the same seed and template (i.e. it is the same paired instance).
SUBST = []
for s in SEEDS:
    for arm, agent in ARMS.items():
        rr = f"results/androidworld_sealed/{arm}_seed{s}_rerun"
        if not os.path.isdir(rr):
            continue
        ok2, exc2, goal2, _ = load(rr, agent, expect=None, full=False)
        ok, exc, goal, steps = data[(arm, s)]
        for t in ok2:
            if not exc[t]:
                raise SystemExit(f"INPUT ERROR: re-run of {arm} seed {s} {t}, but the original was not an exception")
            if not SETUP[(f"results/androidworld_sealed/{arm}_seed{s}", t)]:
                raise SystemExit(f"INPUT ERROR: re-run of {arm} seed {s} {t}, but the original crashed after task setup")
            matched = "original"
            if goal2[t] != goal[t]:
                if {data[(a, s)][2][t] for a in ARMS if a != arm} != {goal2[t]}:
                    raise SystemExit(f"INPUT ERROR: re-run goal differs for {arm} seed {s} {t} (and from the other arms)")
                matched = "other_arms (original crashed before the date rewording)"
            SUBST.append({"arm": arm, "seed": s, "task": t, "rerun_success": ok2[t], "rerun_exception": exc2[t],
                          "goal_matched": matched})
            ok[t], exc[t] = ok2[t], exc2[t]
# seed-varying templates: goal text differs between dev seed 30 and each held-out seed (GUI-Owl matched runs)
dev = {}
for f in glob.glob("results/androidworld/guiowl15_2b_matched/run_*/*.pkl.gz"):
    ep = pickle.load(gzip.open(f))  # trusted: written by our own local AndroidWorld runs (seed-30 development data)
    ep = ep[0] if isinstance(ep, list) else ep
    dev[os.path.basename(f).rsplit("_", 1)[0]] = re.sub(r"\d{8}_\d{6}", "<ts>", ep.get("goal") or "")
observed_changes = {s: sorted(t for t in META if dev.get(t) != data[("guiowl", s)][2][t]) for s in SEEDS}
if any(not set(v) <= VARY for v in observed_changes.values()):
    raise SystemExit("INPUT ERROR: a goal changed for a template outside results/aw_template_manifest.json")
varying = {s: sorted(VARY) for s in SEEDS}

res = {"seeds": SEEDS, "arms": {}, "comparisons": {}, "notes": [], "goal_can_vary_templates": len(VARY),
       "observed_goal_changes_vs_seed30": {s: len(v) for s, v in observed_changes.items()},
       "reruns_applied": SUBST}
pending = [f"{arm} seed {s}: {sorted(t for t in data[(arm, s)][1] if data[(arm, s)][1][t])}" for s in SEEDS for arm in ARMS
           if any(data[(arm, s)][1].values()) and not os.path.isdir(f"results/androidworld_sealed/{arm}_seed{s}_rerun")]
if pending:
    res["notes"].append("Exceptions with no re-run (counted as failures; eligibility per docs/PREREG_v4.md, e.g. the 13:40 entry): " + "; ".join(pending))
if len(SEEDS) == 1:
    res["notes"].append("One held-out seed only: PRELIMINARY (preregistered label; detectable gap ~14 tasks).")
for arm in ARMS:
    per = {}
    for s in SEEDS:
        ok, exc, _, steps = data[(arm, s)]
        k = sum(ok.values())
        per[s] = {"successes": k, "of": 116, "pct": round(100 * k / 116, 1), "wilson95": wilson(k, 116),
                  "answer_tasks": f"{sum(ok[t] for t in ANSWER)}/{len(ANSWER)}",
                  "action_tasks": f"{sum(ok[t] for t in META if t not in ANSWER)}/{116 - len(ANSWER)}",
                  "goal_can_vary": f"{sum(ok[t] for t in varying[s])}/{len(varying[s])}",
                  "exceptions": sum(exc.values()), "exception_templates": sorted(t for t in exc if exc[t]),
                  "by_difficulty": {d: f"{sum(ok[t] for t in META if META[t]['difficulty'] == d)}/{sum(1 for t in META if META[t]['difficulty'] == d)}"
                                    for d in ("easy", "medium", "hard")}}
