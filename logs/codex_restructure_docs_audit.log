index 0000000000000000000000000000000000000000..f6155ae72600fa3f8f3aed3a4b9d017d78d546af
--- /dev/null
+++ b/results/codex/restructure_docs_audit/additional_evidence.py
@@ -0,0 +1,62 @@
+import collections, json, math, pathlib, re, subprocess
+
+O = pathlib.Path(__file__).resolve().parent
+R = pathlib.Path('results/mobileworld/traj_r2')
+tasks = json.load(open('results/mobileworld/mw_gui_en.json'))
+def pvalue(b,c):
+    return min(1., 2*sum(math.comb(b+c,i) for i in range(min(b,c)+1))/2**(b+c))
+all_scores = {}; mw = {}
+for arm in ['v4','guiowl','maiui']:
+    base = R/f'{arm}_gui_en_r2'
+    scores = {}; attempts = []; errors = collections.Counter(); env = set(); reinits = set()
+    for task in tasks:
+        folders = list(base.glob(task+'_backup_*'))
+        folders += list((R/'_interrupted').glob(('maiui_*' if arm=='maiui' else arm)+'/'+task+'_2*'))
+        folders += [base/task]
+        for folder in folders:
+            text = '\n'.join(p.read_text(errors='replace') for p in sorted(folder.glob('*.log'),key=lambda p:p.stat().st_mtime))
+            nre = text.count('Device is not healthy, retrying')
+            if nre: reinits.add(task)
+            result = folder/'result.txt'
+            if result.exists():
+                match = re.search(r'score:\s*([0-9.]+)',result.read_text())
+                score = float(match[1]) if match else 0
+                category = 'result'
+            else:
+                score = 0
+                tail = text.rsplit('Error executing task',1)[-1]
+                category = ('setup_failed' if 'Failed to initialize task' in tail else
+                            'scoring_failed' if 'Failed to get task score' in tail else 'other_no_result')
+            if category in ['setup_failed','scoring_failed']: env.add(task)
+            if folder==base/task:
+                scores[task]=score>=1
+                errors[category]+=1
+            attempts.append({'task':task,'category':category,'reinits':nre})
+    committed=json.load(open(f'results/mobileworld/{arm}_gui_en_r2_summary.json'))
+    assert all(scores[t] == (committed['tasks'][t]['score']>=1) for t in tasks)
+    assert len(attempts)+sum(x['reinits'] for x in attempts)==committed['task_executions']
+    assert env==set(committed['tasks_with_folder_level_environment_error'])
+    assert reinits==set(committed['tasks_with_device_unhealthy_reinit'])
+    mw[arm]={'n':len(scores),'successes':sum(scores.values()),'final_categories':dict(errors),
+             'executions':len(attempts)+sum(x['reinits'] for x in attempts),
+             'env_tasks':sorted(env),'reinit_tasks':sorted(reinits)}
+    all_scores[arm]=scores
+def pair(a,b,excluded=()):
+    keep=set(tasks)-set(excluded); A=all_scores[a]; B=all_scores[b]
+    ab=sum(A[t] and not B[t] for t in keep); ba=sum(B[t] and not A[t] for t in keep)
+    return {'n':len(keep),a:sum(A[t] for t in keep),b:sum(B[t] for t in keep),'a_only':ab,'b_only':ba,'p':pvalue(ab,ba)}
+mw['pairs']={f'{a}-{b}':pair(a,b) for a,b in [('v4','guiowl'),('maiui','v4'),('maiui','guiowl')]}
+narrow=set(mw['v4']['env_tasks'])|set(mw['guiowl']['env_tasks'])
+broad=narrow|set(mw['v4']['reinit_tasks'])|set(mw['guiowl']['reinit_tasks'])
+mw['sensitivity_narrow']=pair('v4','guiowl',narrow)
+mw['sensitivity_broad']=pair('v4','guiowl',broad)
+setup=[t for t,x in json.load(open('results/mobileworld/maiui_gui_en_r2_summary.json'))['tasks'].items() if x['final_category']=='setup_failed']
+mw['exclude_maiui_final_setup']={f'maiui-{b}':pair('maiui',b,setup) for b in ['v4','guiowl']}
+(O/'mobileworld_independent.json').write_text(json.dumps(mw,indent=2)+'\n')
+print(json.dumps({k:v for k,v in mw.items() if k not in ['v4','guiowl','maiui']},indent=2))
+history=[]
+for old,new in re.findall(r'^\| ([0-9a-f]{7}) \| ([0-9a-f]{7}) \|',pathlib.Path('docs/history-rewrites.md').read_text(),re.M):
+    files=subprocess.check_output(['git','diff','--name-only',old,new]).decode().splitlines()
+    history.append({'old':old,'new':new,'changed_paths':files})
+(O/'history_mapping_checks.json').write_text(json.dumps(history,indent=2)+'\n')
+print('history mappings checked:',len(history),'unique paths:',sorted({p for r in history for p in r['changed_paths']}))
diff --git a/results/codex/restructure_docs_audit/credential_assignment_scan.py b/results/codex/restructure_docs_audit/credential_assignment_scan.py
new file mode 100644
index 0000000000000000000000000000000000000000..61ddcde9e25e2eca7c7b018759306f132e1f003b
--- /dev/null
+++ b/results/codex/restructure_docs_audit/credential_assignment_scan.py
@@ -0,0 +1,39 @@
+"""Supplementary offline scan; never serialize credential values."""
+import collections, gzip, hashlib, json, pathlib, re, subprocess, time, zlib
+
+out = pathlib.Path(__file__).resolve().parent
+refs = ['restructure', 'origin/main', 'archive/pre-restructure-2026-11-20']
+rows = subprocess.check_output(['git', 'rev-list', '--objects', *refs]).decode().splitlines()
+objects = dict(row.split(' ', 1) if ' ' in row else (row, '') for row in rows)
+p = subprocess.Popen(['git', 'cat-file', '--batch-check=%(objectname) %(objecttype)'], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
+metadata, _ = p.communicate(('\n'.join(objects)+'\n').encode())
+blobs = [row.split()[0] for row in metadata.decode().splitlines() if row.endswith(' blob')]
+quoted = re.compile(rb'''(?im)(?<![a-z0-9_])["']?((?:[a-z0-9_]{0,64}(?:password|passwd|passphrase|secret|api_key|access_key|private_key|credential)[a-z0-9_]{0,32})|key|auth|authorization)["']?\s*[:=]\s*["']([^\r\n"']{1,300})["']''')
+bare = re.compile(rb'''(?im)(?<![a-z0-9_])["']?((?:[a-z0-9_]{0,64}(?:password|passwd|passphrase|secret|api_key|access_key|private_key|credential)[a-z0-9_]{0,32})|key|auth|authorization)["']?\s*[:=]\s*([^\s"'\x00]{1,200})''')
+ssh = re.compile(rb'''(?im)\b(sshpass\s+-p|ssh-keygen[^\r\n]{0,120}?\s+-[NP])\s+["']?([^\s"'\r\n]{1,200})''')
+hits = {}; count = collections.Counter(); started = time.time()
+def scan(data, oid, encoding):
+    for pattern in (quoted, bare, ssh):
+        for m in pattern.finditer(data):
+            key, val = m.groups()
+            digest = hashlib.sha256(val).hexdigest()
+            hit = {'blob': oid, 'path': objects[oid], 'encoding': encoding,
+                   'line': data.count(b'\n', 0, m.start())+1,
+                   'pattern': key.decode('ascii', 'replace'),
+                   'masked_prefix': val[:6].decode('ascii', 'replace')+'…',
+                   'value_sha256': digest, 'length': len(val)}
+            hits[(oid, encoding, hit['line'], key, digest)] = hit
+p = subprocess.Popen(['git', 'cat-file', '--batch'], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
+for i, oid in enumerate(blobs):
+    p.stdin.write((oid+'\n').encode()); p.stdin.flush()
+    header = p.stdout.readline().split(); data = p.stdout.read(int(header[2])); p.stdout.read(1)
+    scan(data, oid, 'raw'); count['blobs'] += 1
+    if data.startswith(b'\x1f\x8b'):
+        try: inflated = gzip.decompress(data)
+        except EOFError: inflated = zlib.decompressobj(16+zlib.MAX_WBITS).decompress(data)
+        scan(inflated, oid, 'gzip'); count['gzip_or_partial'] += 1
+    if i and i % 2000 == 0: print(json.dumps({'scanned': i, 'seconds': round(time.time()-started)}), flush=True)
+p.stdin.close(); p.wait()
+result = {'counts': dict(count), 'hits': list(hits.values()), 'seconds': round(time.time()-started)}
+(out/'credential_assignment_scan.json').write_text(json.dumps(result, indent=2)+'\n')
+print(json.dumps({'counts': result['counts'], 'hits': len(hits), 'seconds': result['seconds']}), flush=True)
diff --git a/results/codex/restructure_docs_audit/history_scan.py b/results/codex/restructure_docs_audit/history_scan.py
new file mode 100644
index 0000000000000000000000000000000000000000..572fdea5c2c6d87eaf5c235ade2d15e05928251d
--- /dev/null
+++ b/results/codex/restructure_docs_audit/history_scan.py
@@ -0,0 +1,83 @@
+"""Offline reachable-blob scan. Output contains locations and masked prefixes only."""
+import collections, gzip, hashlib, json, pathlib, re, subprocess, time
+
+OUT = pathlib.Path(__file__).resolve().parent
+REFS = ['restructure', 'origin/main', 'archive/pre-restructure-2026-11-20']
+def git(*args):
+    return subprocess.check_output(['git', *args])
+objects = {}
+for line in git('rev-list', '--objects', *REFS).decode().splitlines():
+    oid, _, path = line.partition(' ')
+    objects[oid] = path
+p = subprocess.Popen(['git','cat-file','--batch-check=%(objectname) %(objecttype) %(objectsize)'],stdin=subprocess.PIPE,stdout=subprocess.PIPE)
+raw, _ = p.communicate(('\n'.join(objects)+'\n').encode())
+blobs = [(a,int(c),objects[a]) for a,b,c in (s.split() for s in raw.decode().splitlines()) if b=='blob']
+print(json.dumps({'blobs':len(blobs),'stored_bytes':sum(n for _,n,_ in blobs),'largest':max(n for _,n,_ in blobs)}),flush=True)
+owners = set()
+try:
+    mail = git('config','user.email').strip()
+    if b'@' in mail: owners.add(mail.lower())
+except subprocess.CalledProcessError: pass
+for row in git('log',*REFS,'--format=%an%x09%ae').splitlines():
+    name, _, mail = row.partition(b'\t')
+    if b'alpha' in name.lower() or b'romer' in name.lower(): owners.add(mail.lower())
+PATTERNS = {
+    'AWS access key': rb'\b(?:AKIA|ASIA|AIDA|AROA)[A-Z0-9]{16}\b',
+    'HuggingFace token': rb'\bhf_[A-Za-z0-9]{20,}\b',
+    'OpenAI/Anthropic token': rb'\bsk-(?:ant-[A-Za-z0-9_-]+|proj-[A-Za-z0-9_-]+|[A-Za-z0-9_-]{20,})',
+    'GitHub token': rb'\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{30,})\b',
+    'Google API/OAuth key': rb'\b(?:AIza[A-Za-z0-9_-]{30,}|ya29\.[A-Za-z0-9_.-]{20,})',
+    'Modal credential': rb'\b(?:ak|as)-[A-Za-z0-9]{20,}\b',
+    'JWT': rb'\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b',
+    'Private key': rb'-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----',
+    'Slack token': rb'\bxox[baprs]-[A-Za-z0-9-]{16,}',
+    'Credential URL': rb'[a-z]{3,9}://[^\s/:<>]{1,80}:([^\s/@<>]{3,100})@',
+}
+patterns = {k:re.compile(v) for k,v in PATTERNS.items()}
+assignment = re.compile(rb'''(?ix)(?:["']?)([A-Z0-9_]*(?:PASSWORD|PASSWD|PASSPHRASE|TOKEN|SECRET|API_KEY|ACCESS_KEY|PRIVATE_KEY|AUTHORIZATION|CREDENTIAL)[A-Z0-9_]*)(?:["']?)\s*[:=]\s*(?:[brf]{0,2})?["']([^\r\n"']{1,300})["']''')
+unquoted = re.compile(rb'''(?im)\b([A-Z0-9_]*(?:PASSWORD|PASSWD|PASSPHRASE|TOKEN|SECRET|API_KEY|ACCESS_KEY)[A-Z0-9_]*)\s*=\s*([^\s"'\x00]{3,200})''')
+literal_skip = re.compile(rb'(?i)(redacted|placeholder|example|your[_ -]|dummy|fake|test|none|null|false|true|bearer|os\.|environ|\.get\(|getenv|secret\(|tokenizer|token_id|path|filename|localhost|request|response|huggingface|api_key|access_token|hf_token)')
+hits=[]; counts=collections.Counter(); errors=[]
+def add(kind, value, oid, path, line, encoding, classification='candidate'):
+    hits.append({'pattern':kind,'path':path,'blob':oid,'line':line,'encoding':encoding,
+                 'masked_prefix':value[:6].decode('ascii','replace')+'…','value_sha256':hashlib.sha256(value).hexdigest(),
+                 'classification':classification})
+def scan(data, oid, path, encoding):
+    for kind, pat in patterns.items():
+        for m in pat.finditer(data):
+            value=m.group(1) if kind=='Credential URL' else m.group(0)
+            add(kind,value,oid,path,data.count(b'\n',0,m.start())+1,encoding)
+    lower=data.lower()
+    for owner in owners:
+        pos=lower.find(owner)
+        if pos>=0: add('Owner personal email',owner,oid,path,data.count(b'\n',0,pos)+1,encoding)
+    for pat in (assignment,unquoted):
+        for m in pat.finditer(data):
+            key,val=m.groups()
+            if len(val)<4 or val[:1] in b'$<({[/' or literal_skip.search(val): continue
+            if val.isdigit() or len(val)>180: continue
+            if not (re.search(rb'[A-Za-z]',val) and re.search(rb'[0-9_+=/-]',val)): continue
+            add('Literal assignment '+key.decode('ascii','replace'),val,oid,path,data.count(b'\n',0,m.start())+1,encoding)
+
+p=subprocess.Popen(['git','cat-file','--batch'],stdin=subprocess.PIPE,stdout=subprocess.PIPE)
+t=time.time()
+for i,(oid,n,path) in enumerate(blobs):
+    p.stdin.write((oid+'\n').encode());p.stdin.flush()
+    head=p.stdout.readline().split();data=p.stdout.read(int(head[2]));p.stdout.read(1)
+    counts['blobs']+=1;counts['stored_bytes']+=len(data)
+    scan(data,oid,path,'raw')
+    if data[:2]==b'\x1f\x8b':
+        try:
+            inflated=gzip.decompress(data)
+            scan(inflated,oid,path,'gzip')
+            counts['gzip_blobs']+=1;counts['inflated_bytes']+=len(inflated)
+        except Exception as e: errors.append({'blob':oid,'path':path,'error_type':type(e).__name__})
+    if i and i%2000==0: print(json.dumps({'scanned':i,'seconds':round(time.time()-t),'hits':len(hits)}),flush=True)
+p.stdin.close();p.wait()
+unique={tuple((h[k] for k in ['pattern','blob','line','encoding','value_sha256'])):h for h in hits}
+hits=list(unique.values())
+result={'refs':{r:git('rev-parse',r).decode().strip() for r in REFS},'counts':dict(counts),'errors':errors,
+        'owner_identities_checked':len(owners),'elapsed_seconds':round(time.time()-t,1),'hits':hits}
+(OUT/'history_scan.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps({k:v for k,v in result.items() if k!='hits'}),flush=True)
+print(json.dumps({'candidate_patterns':dict(collections.Counter(h['pattern'] for h in hits))}),flush=True)
diff --git a/results/codex/restructure_docs_audit/recompute_evidence.py b/results/codex/restructure_docs_audit/recompute_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..7b346d9f4722b86849eeacb2abd40823ed1213f6
--- /dev/null
+++ b/results/codex/restructure_docs_audit/recompute_evidence.py
@@ -0,0 +1,103 @@
+"""Read-only independent counts; output only to this audit folder."""
+import collections, gzip, hashlib, importlib.util, json, math, pathlib, pickle, re, statistics, sys
+import numpy as np
+ROOT=pathlib.Path.cwd();OUT=pathlib.Path(__file__).resolve().parent
+def j(p): return json.loads(pathlib.Path(p).read_text())
+def rows(p): return [json.loads(l) for l in pathlib.Path(p).read_text().splitlines() if l.strip()]
+def mc(a,b):
+    n=a+b
+    return min(1.,2*sum(math.comb(n,k) for k in range(min(a,b)+1))/2**n) if n else 1.
+def eps(path):
+    found={}
+    for p in pathlib.Path(path).glob('run_*/*.pkl.gz'):
+        v=pickle.loads(gzip.decompress(p.read_bytes()))
+        assert isinstance(v,list) and len(v)==1
+        e=v[0];t=e['task_template'];assert t not in found
+        found[t]=e
+    return found
+def ok(e):
+    return isinstance(e.get('is_successful'),(int,float)) and e['is_successful']>=1 and not e.get('exception_info')
+answer=set(j('results/codex/v3_audit/answer_tasks.json')['answer_tasks'])
+vary=set(j('results/aw_template_manifest.json')['goal_text_can_vary'])
+data={};audit={'heldout':{},'reruns':{},'seed30':[],'general':{},'offline':{},'datasets':{},'training':[]}
+for arm in ['v4','guiowl','v1']:
+    for seed in [7,1234,2026]:
+        key=f'{arm}_seed{seed}';orig=eps('results/androidworld_sealed/'+key)
+        rerun=eps('results/androidworld_sealed/'+key+'_rerun')
+        assert len(orig)==116
+        audit['reruns'][key]={'n':len(rerun),'successes':sum(ok(e) for e in rerun.values()),'remaining_exceptions':sum(bool(e.get('exception_info')) for e in rerun.values())}
+        for t,e in rerun.items():
+            assert orig[t].get('exception_info')
+            frames=re.findall(r'File "[^"]+", line \d+, in (\w+)',str(orig[t]['exception_info']).split('Traceback (most recent call last):')[-1])
+            assert frames[:2]==['_run_task','initialize_task']
+            assert e.get('instance_id')==0
+        orig.update(rerun)
+        for t,e in orig.items():
+            if 'seed' in e:assert e['seed']==int(hashlib.sha256(f'{seed}_{t}_0'.encode()).hexdigest(),16)%2**32
+        data[(arm,seed)]=orig
+        audit['heldout'][key]={'n':len(orig),'successes':sum(ok(e) for e in orig.values()),'answer':sum(ok(e) for t,e in orig.items() if t in answer),
+          'action':sum(ok(e) for t,e in orig.items() if t not in answer),'exceptions':sum(bool(e.get('exception_info')) for e in orig.values()),
+          'varying_successes':sum(ok(e) for t,e in orig.items() if t in vary)}
+tasks=sorted(data[('v4',7)])
+def contrast(a,b,selected=tasks):
+    byseed={};diff=[]
+    for s in [7,1234,2026]:
+        wins=sum(ok(data[(a,s)][t]) and not ok(data[(b,s)][t]) for t in selected)
+        losses=sum(ok(data[(b,s)][t]) and not ok(data[(a,s)][t]) for t in selected)
+        byseed[str(s)]={'only_first':wins,'only_second':losses,'p':mc(wins,losses)}
+    sums=np.array([sum(int(ok(data[(a,s)][t]))-int(ok(data[(b,s)][t])) for s in [7,1234,2026]) for t in selected])
+    signs=np.random.default_rng(0).choice([-1.,1.],size=(10000,len(selected)))
+    p=(1+int(np.count_nonzero(np.abs(signs@sums)>=abs(sums.sum())-1e-12)))/10001
+    return {'difference_pp':100*float(sums.sum())/(3*len(selected)),'p':p,'per_seed':byseed,'clusters':len(selected)}
+audit['comparisons']={a+'-'+b:contrast(a,b) for a,b in [('v4','guiowl'),('v4','v1'),('v1','guiowl')]}
+audit['varying_contrast']=contrast('v4','guiowl',sorted(vary))
+for r in j('results/androidworld/dev_seed30_summary.json'):
+    e=eps(str(pathlib.Path(r['run_dir']).parent));assert len(e)==116
+    lat=[v for ep in e.values() if isinstance(ep.get('episode_data'),dict) for v in ep['episode_data'].get('latency_s',[]) if isinstance(v,(float,int)) and math.isfinite(v)]
+    assert sum(ok(ep) for ep in e.values())==r['successes']
+    assert round(statistics.median(lat),2)==r['step_latency_median_s']
+    invalid=[t for t,ep in e.items() if ep.get('exception_info') and isinstance(ep.get('is_successful'),(int,float)) and ep['is_successful']>=1]
+    audit['seed30'].append({'model':r['id'],'successes':sum(ok(ep) for ep in e.values()),'n':len(e),'steps_timed':len(lat),
+       'median_s':statistics.median(lat),'success_with_exception':invalid,
+       'suite_seed_30_identity':all(ep.get('seed')==int(hashlib.sha256(f'30_{t}_0'.encode()).hexdigest(),16)%2**32 for t,ep in e.items() if 'seed' in ep)})
+# Re-score all available canonical AndroidControl prediction files against the committed frozen GT.
+sys.path.insert(0,str(ROOT/'eval/androidcontrol'));import score
+gt={(r['episode_id'],r['step_idx'],r['mode']):r for r in rows('data/meta/androidcontrol_test_gt.jsonl')}
+preds=list(pathlib.Path('results/androidcontrol').glob('*.jsonl'))+[pathlib.Path('results/v4_dev/hub/eval/lfm3vl2b-v4bmix-lora_ft.jsonl'),pathlib.Path('results/v4rl_dev/lfm3vl2b-v4rl_ft.jsonl')]
+for p in preds:
+    if 'nothink' in p.name:continue
+    rr=rows(p);bound=[]
+    for r in rr:
+        key=(r['episode_id'],r['step_idx'],r.get('mode','high'));assert key in gt
+        bound.append({**gt[key],'output':r['output']})
+    scores={}
+    for mode in ['high','low']:
+        subset=[r for r in bound if r.get('mode')==mode and not r.get('is_terminal')]
+        if subset:scores[mode]=score.score_rows(subset)['step_sr']
+    term=[r for r in bound if r.get('is_terminal')]
+    if term:scores['terminal']=score.score_rows(term)['step_sr']
+    audit['offline'][str(p)]={'rows':len(rr),'scores':scores}
+for p in pathlib.Path('results/general').glob('*_retention_logprob.json'):
+    stored=j(p);name=p.name.removesuffix('_retention_logprob.json')
+    mapping={'lfm3vl2b':'lfm3vl2b-ac-lora','lfm25vl450m':'lfm25vl450m-ac-lora','qwen35_2b':'qwen35-2b-ac-lora','qwen35_08b':'qwen35-08b-ac-lora',
+     'lfm3vl2b_v2':'lfm3vl2b-v2mix-lora','lfm3vl2b_v3':'lfm3vl2b-v3mix-lora','qwen35_2b_v2':'qwen35-2b-v2mix-lora'}
+    stem=mapping[name];base=stem.replace('-v2mix','-ac').replace('-v3mix','-ac')
+    bb={(r['kind'],str(r['id'])):bool(r['correct']) for r in rows(f'results/general/{base}_base_general_logprob.jsonl')}
+    ff={(r['kind'],str(r['id'])):bool(r['correct']) for r in rows(f'results/general/{stem}_ft_general_logprob.jsonl')}
+    assert bb.keys()==ff.keys()
+    audit['general'][name]={}
+    for kind in ['mmstar','mmlu']:
