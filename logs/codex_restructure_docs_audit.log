    17	    log = open(f"{d}/server_{name}.log").read().splitlines()
    18	    pe = [(float(m.group(1)), int(m.group(2))) for l in log for m in [PE.search(l)] if m]
    19	    ev = [(float(m.group(1)), int(m.group(2))) for l in log for m in [EV.search(l)] if m and "prompt" not in l]
    20	    assert len(pe) == len(ev) >= len(rows), (name, len(pe), len(ev), len(rows))
    21	    # extra server requests (an agent's parse retry) would break the pairing: require exactly one request per call
    22	    assert len(pe) == len(rows), f"{name}: {len(pe)} server requests for {len(rows)} calls (retries?)"
    23	    # rep 0 = warm-up on case 0; the first timed call (rep 1, case 0) repeats that exact prompt and hits llama-server's
    24	    # prompt cache (GUI-Owl: 2 s vs ~58 s), so it is excluded for every model alike
    25	    first = next(i for i, r in enumerate(rows) if r["rep"] == 1)
    26	    keep = [i for i, r in enumerate(rows) if r["rep"] >= 1 and i != first]
    27	    # llama-server (cd959bae9) also keeps a RAM prompt cache (--cache-ram, 8 GB default): a repeated screenshot+goal is
    28	    # served from it (1 prompt token processed). Keep only calls whose prompt was actually processed (>= 100 tokens).
    29	    hits = [i for i in keep if pe[i][1] < 100]
    30	    keep = [i for i in keep if pe[i][1] >= 100]
    31	    lat = [rows[i]["latency_s"] for i in keep]
    32	    ptok = [pe[i][1] for i in keep]; pms = [pe[i][0] for i in keep]
    33	    gtok = [ev[i][1] for i in keep]; gms = [ev[i][0] for i in keep]
    34	    out.append({
    35	        "model": label, "n": len(keep), "excluded_cache_hits": len(hits),
    36	        "latency_median_s": round(st.median(lat), 2), "latency_mean_s": round(st.mean(lat), 2),
    37	        "latency_min_max_s": [round(min(lat), 2), round(max(lat), 2)],
    38	        "prompt_tokens_median": int(st.median(ptok)), "prompt_s_median": round(st.median(pms) / 1000, 2),
    39	        "prompt_tok_per_s": round(sum(ptok) / (sum(pms) / 1000), 1),
    40	        "gen_tokens_median": int(st.median(gtok)), "gen_s_median": round(st.median(gms) / 1000, 2),
    41	        "gen_tok_per_s": round(sum(gtok) / (sum(gms) / 1000), 1),
    42	        "server_rss_mb": int(rss.get(name, 0)),
    43	    })
    44	print(json.dumps(out, indent=1))
    45	if md:
    46	    with open(md, "w") as f:
    47	        f.write("| model | n | step latency median (min-max) | prompt tokens | prompt time | prompt tok/s | output tokens | "
    48	                "output time | output tok/s | server RSS |\n|---|---|---|---|---|---|---|---|---|---|\n")
    49	        for o in out:
    50	            f.write(f"| {o['model']} | {o['n']} | {o['latency_median_s']} s ({o['latency_min_max_s'][0]}-{o['latency_min_max_s'][1]}) | "
    51	                    f"{o['prompt_tokens_median']} | {o['prompt_s_median']} s | {o['prompt_tok_per_s']} | {o['gen_tokens_median']} | "
    52	                    f"{o['gen_s_median']} s | {o['gen_tok_per_s']} | {o['server_rss_mb']} MB |\n")

