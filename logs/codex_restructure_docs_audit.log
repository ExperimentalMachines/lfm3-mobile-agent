    38	
    39	| Environment | Used for |
    40	|---|---|
    41	| Python 3 + numpy | Everything in `analysis/` |
    42	| `.venv-aw` (Python 3.11 + AndroidWorld's requirements) | AndroidWorld runs |
    43	| Colab / Modal images pinned in [`scripts/training/colab_bootstrap.py`](../scripts/training/colab_bootstrap.py) and [`scripts/training/modal_app.py`](../scripts/training/modal_app.py) | Training and offline evals (torch 2.14.1, transformers 5.20.2, TRL 1.16.0, PEFT 0.21.2) |
     1	#!/bin/bash
     2	# Recompute every reported number from the committed raw results, then list what changed (expected: nothing).
     3	# Needs Python 3.10+ with numpy. MobileWorld is skipped unless its raw trajectories (not in git) are present.
     4	# Usage: bash analysis/reproduce.sh            (PY=/path/to/python to choose the interpreter)
     5	set -euo pipefail
     6	cd "$(dirname "$0")/.."
     7	PY=${PY:-python3}
     8	E=results/v4_dev/hub/eval
     9	D=results/devstream/run_20261118_1519
    10	run() { echo "· $*"; "$@" > /dev/null; }
    11	
    12	echo "AndroidWorld, held-out (primary) + sensitivity"
    13	run "$PY" analysis/sealed_analysis.py --seeds 7,1234,2026 --out results/sealed_analysis_final
    14	run "$PY" analysis/sealed_sensitivity.py
    15	echo "AndroidWorld, development seed 30 + v4 gate"
    16	run "$PY" analysis/aw_dev_seed30.py
    17	echo "· analysis/v4_gate.py > results/v4_gate_seed30.txt"
    18	"$PY" analysis/v4_gate.py --v4 results/androidworld/lfm3vl2b_v4 --v4_agent lfm3vl2b_v4_q4km \
    19	  --dev_answer $E/lfm3_v4_dev_answer.jsonl --dev_complete $E/lfm3_v4_dev_complete.jsonl > results/v4_gate_seed30.txt
    20	echo "Offline evaluations"
    21	run "$PY" analysis/strict_dev_metrics.py --answer $E/lfm3_v4_dev_answer.jsonl --complete $E/lfm3_v4_dev_complete.jsonl \
    22	  --out results/v4_dev/lfm3_v4_strict.json
    23	run "$PY" analysis/v4rl_promotion.py --v4_dir $E --rl_dir results/v4rl_dev --out results/v4rl_promotion_offline.json
    24	run "$PY" analysis/build_report.py
    25	echo "· analysis/v2_compare.py > results/V2_COMPARISON.md"
    26	"$PY" analysis/v2_compare.py > results/V2_COMPARISON.md
    27	echo "Speed"
    28	run "$PY" analysis/bench_speed_report.py results/speed/results_t8 --md results/speed/speed_t8.md
    29	run "$PY" analysis/qdc_report_v6.py
    30	run "$PY" analysis/devstream_report.py $D --md $D/speed_phone_partial.md --json $D/speed_phone_partial.json
    31	echo "MobileWorld"
    32	if [ -d results/mobileworld/traj_r2 ]; then
    33	  run "$PY" analysis/mw_summarize_r2.py
    34	else
    35	  echo "· skipped: raw trajectories (results/mobileworld/traj_r2, 8.6 GB) are not in git"
    36	fi
    37	find analysis -name __pycache__ -type d -prune -exec rm -rf {} +
    38	echo
    39	if git diff --quiet -- results; then
    40	  echo "OK: every regenerated file is identical to the committed one."
    41	else
    42	  echo "Changed files:"; git diff --stat -- results; exit 1
    43	fi

