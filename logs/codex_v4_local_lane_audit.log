     1	"""Check that a merged checkpoint copied off the training VM is exactly base + the hub LoRA adapter.
     2	
     3	2026-11-18: the merged v4 upload to the hub failed (private storage limit), so the merged weights were copied from the
     4	Colab VM with `colab download`. Before exporting them, verify against independent copies on the hub:
     5	  * same tensor names/shapes/dtypes as the base model;
     6	  * every tensor the adapter does not touch is bit-identical to the base;
     7	  * every LoRA-targeted weight equals base + (alpha/r) * B @ A up to bf16 rounding, and differs from the base.
     8	A truncated or wrong file fails here instead of silently producing a different model.
     9	Usage: python scripts/check_local_merge.py <merged_dir> <base_safetensors> <adapter_dir>
    10	"""
    11	import json, os, sys
    12	
    13	import torch
    14	from safetensors import safe_open
    15	
    16	merged_dir, base_path, adapter_dir = sys.argv[1:4]
    17	cfg = json.load(open(os.path.join(adapter_dir, "adapter_config.json")))
    18	scale = cfg["lora_alpha"] / cfg["r"]
    19	assert not cfg.get("use_dora") and not cfg.get("use_rslora") and not cfg.get("rank_pattern") and not cfg.get("alpha_pattern")
    20	
    21	M = safe_open(os.path.join(merged_dir, "model.safetensors"), "pt")
    22	B = safe_open(base_path, "pt")
    23	A = safe_open(os.path.join(adapter_dir, "adapter_model.safetensors"), "pt")
    24	mk, bk = set(M.keys()), set(B.keys())
    25	assert mk == bk, f"key sets differ: only merged {sorted(mk - bk)[:5]}, only base {sorted(bk - mk)[:5]}"
    26	
    27	pairs = {}
    28	for k in A.keys():
    29	    mod, kind = k.removeprefix("base_model.model.").rsplit(".lora_", 1)
    30	    pairs.setdefault(mod + ".weight", {})[kind.split(".")[0]] = k
    31	missing = [w for w in pairs if w not in bk]
    32	assert not missing, f"adapter targets not in base: {missing[:5]}"
    33	assert all(set(v) == {"A", "B"} for v in pairs.values())
    34	
    35	n_same = n_lora = 0
    36	worst = 0.0
    37	for k in sorted(bk):
    38	    m, b = M.get_tensor(k), B.get_tensor(k)
    39	    assert m.shape == b.shape and m.dtype == b.dtype, (k, m.shape, b.shape, m.dtype, b.dtype)
    40	    if k not in pairs:
    41	        assert torch.equal(m, b), f"untargeted tensor changed: {k}"
    42	        n_same += 1
    43	        continue
    44	    a_ = A.get_tensor(pairs[k]["A"]).float()
    45	    b_ = A.get_tensor(pairs[k]["B"]).float()
    46	    delta = scale * (b_ @ a_)
    47	    got = m.float() - b.float()
    48	    assert got.abs().max() > 0, f"targeted tensor unchanged: {k}"
    49	    rel = ((got - delta).norm() / delta.norm()).item()
    50	    worst = max(worst, rel)
    51	    assert rel < 0.05, f"{k}: merged - base differs from scale*B@A (rel err {rel:.4f})"
    52	    n_lora += 1
    53	print(json.dumps({"ok": True, "tensors": len(bk), "untargeted_identical": n_same, "lora_merged": n_lora,
    54	                  "lora_pairs": len(pairs), "worst_rel_err": round(worst, 5), "scale": scale}))
    55	assert n_lora == len(pairs)

