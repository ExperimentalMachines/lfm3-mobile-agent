   106	def create_suite(
   107	    task_registry: dict[str, Type[task_eval.TaskEval]],
   108	    n_task_combinations: int = 1,
   109	    seed: int | None = None,
   110	    tasks: list[str] | None = None,
   111	    use_identical_params: bool = False,
   112	    env: interface.AsyncEnv | None = None,
   113	) -> Suite:
   114	  """Creates task suite.
   115	
   116	  A task suite is a set of tasks. Each task is instantiated
   117	  `n_task_combinations` times using new parameters. For example a task suite
   118	  could look like:
   119	
   120	  ```python
   121	  {
   122	      'GoogleSearchTask': [
   123	          GoogleSearchTask({'term': 'cute cats'}),
   124	          GoogleSearchTask({'term': 'comfy pillows'}),
   125	      ],
   126	      'WifiDisable': [  # No params for WiFi task.
   127	          WifiDisable({}),
   128	          WifiDisable({}),
   129	      ],
   130	  }
   131	  ```
   132	
   133	  Args:
   134	    task_registry: Maps task names to their TaskEvals.
   135	    n_task_combinations: Number of instances to create per task. Each instance
   136	      will have unique param combinations.
   137	    seed: Seed for the random number generator. Setting the seed will result in
   138	      the same sequence of params for task instantiation per each task.
   139	    tasks: List of task types that should be in the suite. If value is `None`
   140	      all task types and associated instances will be created.
   141	    use_identical_params: If True, each instance of a task, for a total of
   142	      `n_task_combinations`, will have the same params.
   143	    env: The environment that will be run on.
   144	
   145	  Returns:
   146	    A mapping of task name to instances of the task.
   147	  """
   148	
   149	  def _get_instance_seed(name: str, i: int) -> int:
   150	    unique_seed_str = f'{seed}_{name}_{i}'
   151	    return int(hashlib.sha256(unique_seed_str.encode()).hexdigest(), 16) % (
   152	        2**32
   153	    )
   154	
   155	  suite = {}
   156	  for name, task_type in task_registry.items():
   157	    current = []
   158	    for i in range(n_task_combinations):
   159	      if use_identical_params:
   160	        instance_seed = (
   161	            _get_instance_seed(name, 0) if seed is not None else _FIXED_SEED
   162	        )
   163	      elif seed is not None:
   164	        instance_seed = _get_instance_seed(name, i)
   165	      else:
   166	        instance_seed = None
   167	      current.append(_instantiate_task(task_type, seed=instance_seed, env=env))
   168	    suite[name] = current
   169	  suite = _filter_tasks(suite, task_registry, tasks)
   170	
   171	  # Sort suite alphabetically by task name.
   172	  return Suite(sorted(suite.items()))
