     1	#!/bin/bash
     2	# v2 models: wait for the merged model on the Hub -> Q4_K_M GGUF (+ mmproj) -> llama-server -> AndroidWorld 116 once the
     3	# emulator's previous job has logged its completion marker. The server is stopped afterwards (frees ~2 GB).
     4	# Usage: scripts/local_v2_to_aw.sh <repo> <name> <kind lfm3|qwen> <port> <console_port> <grpc_port> <done_log>:<marker> <label>
     5	set -u
     6	cd /Users/alpha/lfm3-android
     7	REPO=$1; NAME=$2; KIND=$3; PORT=$4; CP=$5; GP=$6; DONE=$7; LABEL=$8
     8	DLOG=${DONE%%:*}; DMARK=${DONE#*:}
     9	OUT=models/$NAME-GGUF
    10	until uvx --from huggingface_hub python -c "
    11	from huggingface_hub import HfApi; import sys
    12	sys.exit(0 if 'config.json' in HfApi().list_repo_files('$REPO') else 1)" 2>/dev/null; do sleep 180; done
    13	echo "[$(date +%T)] merged $REPO on hub; exporting ($KIND)"
    14	if [ "$KIND" = lfm3 ]; then
    15	  bash scripts/local_export_gguf.sh $REPO $OUT || { echo "EXPORT FAILED"; exit 1; }
    16	  GG=$OUT/$(basename $REPO)-Q4_K_M.gguf
    17	  MM=models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf   # LoRA is LM-only: the vision tower is the base model's
    18	else
    19	  mkdir -p $OUT
    20	  uvx --from huggingface_hub hf download $REPO --local-dir $OUT/hf --exclude "lora_adapter/*" --exclude "eval/*" --exclude "training_logs/*" > /dev/null || { echo "DOWNLOAD FAILED"; exit 1; }
    21	  .venv-convert/bin/python tools/llama.cpp/convert_hf_to_gguf.py $OUT/hf --outtype f16 --outfile $OUT/$NAME-F16.gguf 2>&1 | tail -1
    22	  .venv-convert/bin/python tools/llama.cpp/convert_hf_to_gguf.py $OUT/hf --mmproj --outtype f16 --outfile $OUT/mmproj-$NAME-F16.gguf 2>&1 | tail -1
    23	  llama-quantize $OUT/$NAME-F16.gguf $OUT/$NAME-Q4_K_M.gguf Q4_K_M 2>&1 | tail -1
    24	  rm -rf $OUT/hf $OUT/$NAME-F16.gguf
    25	  GG=$OUT/$NAME-Q4_K_M.gguf; MM=$OUT/mmproj-$NAME-F16.gguf
    26	fi
    27	[ -s "$GG" ] && [ -s "$MM" ] || { echo "EXPORT FAILED"; exit 1; }
    28	ls -la $OUT
    29	echo "[$(date +%T)] exported; waiting for emulator $CP ('$DMARK' in $DLOG)"
    30	until grep -q "$DMARK" "$DLOG" 2>/dev/null && ! pgrep -f "[r]un_aw.py.*console_port=$CP" >/dev/null; do sleep 60; done
    31	nohup llama-server -m $GG --mmproj $MM -c 8192 -np 1 -ngl 99 --image-max-tokens 1024 \
    32	  --reasoning-format deepseek --port $PORT --host 127.0.0.1 > logs/llama_server_$NAME.log 2>&1 &
    33	until curl -s 127.0.0.1:$PORT/health | grep -q ok; do sleep 3; done
    34	echo "[$(date +%T)] server :$PORT up; starting $LABEL AndroidWorld on emulator $CP"
    35	.venv-aw/bin/python eval/androidworld/run_aw.py --console_port=$CP --grpc_port=$GP --server_url=http://127.0.0.1:$PORT \
    36	  --agent_label=$LABEL --enable_thinking=true --output_path=results/androidworld/$NAME 2>&1 \
    37	  | grep --line-buffered -v "_os_env_vars\|FD from fork\|fork_posix" > logs/aw_run_$NAME.log
    38	pkill -f "[l]lama-server.*--port $PORT "
    39	echo "[$(date +%T)] $LABEL AndroidWorld finished"

