   431	def run(
   432	    suite: Suite,
   433	    agent: base_agent.EnvironmentInteractingAgent,
   434	    checkpointer: checkpointer_lib.Checkpointer = checkpointer_lib.NullCheckpointer(),
   435	    demo_mode: bool = False,
   436	    return_full_episode_data: bool = False,
   437	    process_episodes_fn=None,
   438	    check_episode_fn: Callable[[dict[str, Any]], bool] | None = None,
   439	) -> list[dict[str, Any]]:
   440	  """Create suite and runs eval suite.
   441	
   442	  Args:
   443	    suite: The suite of tasks to run on.
   444	    agent: An agent that interacts on the environment.
   445	    checkpointer: Checkpointer that loads from existing run and resumes from
   446	      there. NOTE: It will resume from the last fully completed task template.
   447	      Relatedly, data for a task template will not be saved until all instances
   448	      are executed.
   449	    demo_mode: Whether to run in demo mode, which displays a scoreboard and the
   450	      task instruction as a notification.
   451	    return_full_episode_data: Whether to return full episode data instead of
   452	      just metadata.
   453	    process_episodes_fn: The function to process episode data. Usually to
   454	      compute metrics. Deafaults to process_episodes from this file.
   455	    check_episode_fn: The function to check episode data.
   456	
   457	  Returns:
   458	    Step-by-step data from each episode.
   459	  """
   460	
   461	  def run_episode(task: task_eval.TaskEval) -> episode_runner.EpisodeResult:
   462	    if demo_mode:
   463	      _display_goal(agent.env, task)
   464	    return episode_runner.run_episode(
   465	        goal=task.goal,
   466	        agent=agent,
   467	        max_n_steps=_allocate_step_budget(task.complexity),
   468	        start_on_home_screen=task.start_on_home_screen,
   469	        termination_fn=(
   470	            miniwob_base.is_episode_terminated
   471	            if task.name.lower().startswith('miniwob')
   472	            else None
   473	        ),
   474	    )
   475	
   476	  if demo_mode:
   477	    adb_utils.send_android_intent(
   478	        'broadcast',
   479	        'com.example.ACTION_UPDATE_SCOREBOARD',
   480	        agent.env.controller,
   481	        extras={'player_name': agent.name, 'scoreboard_value': '00/00'},
   482	    )
   483	
   484	  results = _run_task_suite(
   485	      suite,
   486	      run_episode,
   487	      agent.env,
   488	      checkpointer=checkpointer,
   489	      demo_mode=demo_mode,
   490	      agent_name=agent.name,
   491	      return_full_episode_data=return_full_episode_data,
   492	      process_episodes_fn=process_episodes_fn,
   493	      check_episode_fn=check_episode_fn,
   494	  )
   495	
   496	  return results
