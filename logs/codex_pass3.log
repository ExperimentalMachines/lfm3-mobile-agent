+    assert cases["tampered_gt_sha"]["metrics"]["high"]["overall"]["step_sr"] == 1
+    gt = ROOT / "data/meta/androidcontrol_test_gt.jsonl"
+    rows = [json.loads(l) for l in gt.read_text().splitlines()]
+    from collections import Counter
