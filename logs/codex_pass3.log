   237	def norm_to_px(point_2d, width: int, height: int) -> tuple[int, int]:
   238	    x = round(point_2d[0] / 1000 * (width - 1))
   239	    y = round(point_2d[1] / 1000 * (height - 1))
   240	    return x, y
