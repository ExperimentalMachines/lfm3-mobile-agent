   216	def _validate_strict(a):
   217	    t = a["action_type"]
   218	    allowed = {"click": {"point_2d"}, "long_press": {"point_2d"}, "input_text": {"text"}, "answer": {"text"},
   219	               "scroll": {"direction"}, "open_app": {"app_name"}, "status": {"goal_status"},
   220	               "navigate_back": set(), "navigate_home": set(), "keyboard_enter": set(), "wait": set()}
   221	    if t not in allowed or set(a) - {"action_type"} != allowed[t]:
   222	        return None
   223	    if t in POINT_TYPES:
   224	        p = a["point_2d"]
   225	        if not (isinstance(p, list) and len(p) == 2 and all(isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 1000 for v in p)):
   226	            return None
   227	    elif t in ("input_text", "answer", "open_app"):
   228	        if not isinstance(a[next(iter(allowed[t]))], str):
   229	            return None
   230	    elif t == "scroll" and a["direction"] not in _DIRECTIONS:
   231	        return None
   232	    elif t == "status" and a["goal_status"] not in ("complete", "infeasible"):
   233	        return None
   234	    return a
