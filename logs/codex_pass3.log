    99	def parse_action(text: str, strict: bool = False) -> dict[str, Any] | None:
   100	    """Parse the model output (content after </think>, or the whole text) into an action dict.
   101	    Returns None when unparseable/invalid.
   102	
   103	    strict=True : the answer must be exactly one JSON object with the documented keys
   104	                  (no aliases, no trailing junk, no coordinate clamping, explicit goal_status).
   105	    strict=False: lenient harness parsing used by the agent (first JSON object with an action,
   106	                  key aliases, clamping). Both are reported so leniency is visible."""
   107	    if text is None:
   108	        return None
   109	    if "</think>" in text:
   110	        text = text.split("</think>", 1)[1]
   111	    elif "<think>" in text:
   112	        return None  # unfinished reasoning: an action inside it is not a final answer
