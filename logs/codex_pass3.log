   142	        return None
   143	    t = a.get("action_type") or a.get("action")
   144	    if not isinstance(t, str):
   145	        return None
   146	    if t == "type":
   147	        t = "input_text"
   148	    if t not in VALID_TYPES:
   149	        return None
   150	    a["action_type"] = t
   151	    if t in POINT_TYPES:
   152	        p = a.get("point_2d") or a.get("point") or a.get("coordinate")
   153	        if p is None and "x" in a and "y" in a:
   154	            p = [a["x"], a["y"]]
   155	        try:
   156	            p = [float(p[0]), float(p[1])]
   157	        except Exception:
   158	            return None
   159	        import math as _m
   160	        if not all(_m.isfinite(v) for v in p):
   161	            return None
