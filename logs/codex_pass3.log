+        w.writeheader(); w.writerow({"index": "one", "image": base64.b64encode(img.getvalue()).decode(), "question": "A. a B. b C. c D. d", "answer": "C", "category": "synthetic"})
+    cases = {}
+    for name in ("base", "ft", "crash_after_mmstar"):
