   163	    elif t == "scroll":
   164	        if a.get("direction") not in _DIRECTIONS:
   165	            return None
   166	    elif t in ("input_text", "answer"):
   167	        if not isinstance(a.get("text"), str):
   168	            return None
   169	    elif t == "open_app":
   170	        if not isinstance(a.get("app_name"), str):
   171	            alt = next((a[k] for k in ("label", "name", "text", "app") if isinstance(a.get(k), str)), None)
   172	            if alt is None:
   173	                return None
   174	            a["app_name"] = alt  # lenient: base model sometimes puts the app in "label"
   175	    elif t == "status":
   176	        gs = a.get("goal_status")
   177	        if gs is None:
   178	            a["goal_status"] = "complete"  # lenient: omitted status means done
   179	        elif gs not in ("complete", "infeasible"):
