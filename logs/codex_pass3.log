+        cases[name] = rec
+    assert cases["base"]["ids"] == cases["ft"]["ids"]
+    assert not cases["crash_after_mmstar"]["jsonl_exists"]
+    n = 1000; z = 1.959963984540054; p = .5
+    center = (p + z*z/(2*n))/(1+z*z/n); half = z*((p*(1-p)/n+z*z/(4*n*n))**.5)/(1+z*z/n)
