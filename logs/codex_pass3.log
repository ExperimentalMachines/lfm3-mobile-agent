   182	
   183	
   184	MAX_PIXELS = 880 * 880  # ~756 image tokens for a 1080x2400 phone screen (32px per token)
   185	MIN_PIXELS = 256 * 256
   186	RESIZE_FACTOR = 32  # 16px patch * 2x2 merge (LFM3-VL and Qwen3.5 alike)
   187	
   188	
   189	def smart_resize(height: int, width: int, factor: int = RESIZE_FACTOR,
   190	                 min_pixels: int = MIN_PIXELS, max_pixels: int = MAX_PIXELS) -> tuple[int, int]:
   191	    """Same algorithm as LFM3-VL's image processor (Qwen2-VL style). Returns (h, w)."""
   192	    import math
   193	    h_bar = round(height / factor) * factor
   194	    w_bar = round(width / factor) * factor
   195	    if h_bar * w_bar > max_pixels:
   196	        beta = math.sqrt((height * width) / max_pixels)
   197	        h_bar = max(factor, math.floor(height / beta / factor) * factor)
   198	        w_bar = max(factor, math.floor(width / beta / factor) * factor)
   199	    elif h_bar * w_bar < min_pixels:
   200	        beta = math.sqrt(min_pixels / (height * width))
   201	        h_bar = math.ceil(height * beta / factor) * factor
   202	        w_bar = math.ceil(width * beta / factor) * factor
   203	    return h_bar, w_bar
   204	
   205	
   206	def resize_screenshot(img, max_pixels: int = MAX_PIXELS):
   207	    """PIL image -> RGB PIL image resized exactly as the model will see it."""
   208	    from PIL import Image
   209	    img = img.convert("RGB")
   210	    h, w = smart_resize(img.height, img.width, max_pixels=max_pixels)
   211	    if (w, h) != img.size:
   212	        img = img.resize((w, h), Image.BICUBIC)
   213	    return img
