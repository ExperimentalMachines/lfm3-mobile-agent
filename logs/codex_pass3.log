     1	"""Summarize an AndroidWorld run directory (episode .pkl.gz files) into JSON + CSV.
     2	
     3	Differences vs upstream's printed table: episodes that raised an exception are counted as
     4	FAILURES (upstream drops them as NaN, inflating success), and we add on-device-relevant
     5	stats (per-step model latency, prompt tokens, parse failures).
     6	
     7	Usage: python summarize_aw.py <run_dir> --out results/androidworld/<name>.summary.json
     8	"""
     9	import argparse
    10	import csv
    11	import gzip
    12	import json
    13	import math
    14	import pickle
    15	import statistics as stats
    16	import sys
    17	from collections import defaultdict
