+    agent = ns["LFMScreenAgent"](NS(execute_action=lambda act: calls.append(act)), "http://unused", max_parse_retries=0)
+    agent._query = lambda *a: {"content": "", "reasoning": '{"action_type":"wait"}', "latency_s": 1, "usage": {}, "timings": {}}
+    res = agent.step("Wait")
