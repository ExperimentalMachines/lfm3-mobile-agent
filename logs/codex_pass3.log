    37	first_strict = first_lenient = n_attempts = 0
    38	for f in sorted(Path(a.run_dir).glob("*.pkl.gz")):
    39	    # pickles are written locally by our own AndroidWorld runs (trusted input)
    40	    ep = pickle.load(gzip.open(f))
    41	    ep = ep[0] if isinstance(ep, list) else ep
    42	    succ = ep.get("is_successful")
