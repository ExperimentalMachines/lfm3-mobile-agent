    19	
    20	ap = argparse.ArgumentParser()
    21	ap.add_argument("run_dir")
    22	ap.add_argument("--out", required=True)
    23	ap.add_argument("--expected", type=int, default=116, help="scheduled task instances; missing ones count as failures")
    24	a = ap.parse_args()
    25	
    26	# difficulty labels from AndroidWorld's own task_metadata.json (task_name -> easy/medium/hard)
    27	_md = Path(__file__).resolve().parents[2] / "android_world" / "android_world" / "task_metadata.json"
    28	DIFF = {r["task_name"]: r["difficulty"] for r in json.loads(_md.read_text())} if _md.exists() else {}
    29	
    30	
