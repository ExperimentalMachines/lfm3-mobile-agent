     1	#!/bin/bash
     2	# Wait for the current blocking-cell job on <session> to finish, then launch <next_jobs.json> on the same
     3	# session (fresh code re-uploaded first). If the session is gone, allocate a new L4 and bootstrap it.
     4	# Usage: COLAB_BIN=... COLAB_CONFIG=... HF_TOKEN_FILE=... scripts/chain_next_job.sh <session> <next_jobs.json>
     5	set -u
     6	SESS=$1; NEXT=$2
     7	cd "$(dirname "$0")/.."
     8	CB=${COLAB_BIN:-$HOME/.local/bin/colab}
     9	C() { "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} "$@" < /dev/null 2> >(grep -v "new version\|colab update\|silence this" >&2); }
    10	ST=$(mktemp)
    11	echo "[$(date +%T)] waiting for current job on $SESS"
    12	while true; do
    13	  if C download -s "$SESS" /content/work/jobs_status.json "$ST" 2>&1 | grep -q "lost\|not found\|404"; then
    14	    echo "[$(date +%T)] session $SESS gone"; GONE=1; break
    15	  fi
    16	  if grep -q '"exit' "$ST" 2>/dev/null && ! grep -q '"running"' "$ST"; then echo "[$(date +%T)] job finished: $(cat $ST)"; GONE=0; break; fi
    17	  sleep 120
    18	done
    19	if [ "$GONE" = 1 ]; then
    20	  export COLAB_CLI_REQUEST_TIMEOUT=900
    21	  for i in 1 2 3 4 5; do C new -s "$SESS" --gpu L4 && break; sleep 60; done
    22	  bash scripts/launch_gpu_jobs.sh "$SESS" "$NEXT"
    23	else
    24	  for f in train/sft_vlm.py train/agent_format.py train/qwen35_chat_template_gen.jinja eval/androidcontrol/generate.py \
    25	           eval/androidcontrol/score.py eval/general/eval_general.py data/build_general_replay.py scripts/vm_model_pipeline.sh \
    26	           scripts/vm_blocking_jobs.py scripts/vm_eval.sh scripts/vm_train.sh scripts/colab_bootstrap.py data/meta/androidcontrol_test_gt.jsonl; do
    27	    dst="/content/work/$(basename "$f")"; [[ "$f" == data/meta/* ]] && dst="/content/work/meta/$(basename "$f")"
    28	    [ -f "$f" ] && C upload -s "$SESS" "$f" "$dst" | tail -1
    29	  done
    30	  C upload -s "$SESS" "$NEXT" /content/work/jobs.json | tail -1
    31	  nohup "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} exec -s "$SESS" --timeout 200000 -f scripts/vm_blocking_jobs.py \
    32	    > "logs/${SESS}_jobs_cell_next.log" 2>&1 < /dev/null &
