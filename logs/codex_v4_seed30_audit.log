    39	  echo "[$(date +%T)] resuming 450M base"
    40	  .venv-aw/bin/python eval/androidworld/run_aw.py --console_port=5558 --grpc_port=8558 --server_url=http://127.0.0.1:8095 \
    41	    --agent_label=lfm25vl450m_base_q4km --enable_thinking=false \
    42	    --checkpoint_dir=results/androidworld/lfm25vl450m_base/run_20261117T062246232259 2>&1 \
    43	    | grep --line-buffered -v "$FILTER" >> logs/aw_run_450m_base.log
    44	  stop_server 8095; echo "[$(date +%T)] 450M base finished; starting runtime-feedback ablation"
