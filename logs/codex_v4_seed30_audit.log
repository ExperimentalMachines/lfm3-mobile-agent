+            ep = obj[0]
+            task = ep["task_template"]
+            assert path.name == task + "_0.pkl.gz" and task not in episodes, path
+            ep = dict(ep, _file=str(path.relative_to(ROOT)), _sha256=hashlib.sha256(raw).hexdigest())
+            episodes[task] = ep
+        out[arm] = episodes
+    return out
