classes={}
for p in Path('android_world/android_world/task_evals').rglob('*.py'):
 if p.name.endswith('_test.py'):continue
 for n in ast.walk(ast.parse(p.read_text())):
  if not isinstance(n,ast.ClassDef):continue
  c=None
  for x in n.body:
   if isinstance(x,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='complexity' for t in x.targets):
    try:c=ast.literal_eval(x.value)
    except ValueError:pass
  if c is not None or n.name not in classes:classes[n.name]=(c,[ast.unparse(b).split('.')[-1] for b in n.bases])
def complexity(t,visited=None):
 visited=set(visited or [])
 if t in visited:return None
 visited.add(t)
 c,bases=classes.get(t,(None,[]))
 if c is not None:return c
 for b in bases:
  c=complexity(b,visited)
  if c is not None:return c
proto=Path('android_world/android_world/task_evals/information_retrieval/proto/tasks.textproto').read_text()
qa={t:float(c) for t,c in re.findall(r'"'^  name: "([''^"]+)".*?''^  complexity: ([0-9.]+)'"',proto,re.M|re.S)}
assert set(qa)==audit.ANS
records=json.load(open(audit.OUT/'episodes.json')); missing=[]
for r in records:
 c=qa.get(r['task'],complexity(r['task']))
 if c is None:missing.append(r['task']);continue
 r['budget']=int(10*c)
 r['early_stop']=r['bucket'] in ['false_complete','incorrect_answer','early_infeasible'] and r['steps']<r['budget']
 if r['bucket']=='nonterminal_budget_end':assert r['steps']==r['budget'],r
 if r['success']:assert r['episode_length']==r['steps']>=1 and audit.action_type(r['final_action']) in ['status','answer','terminate']
for arm in audit.ARMS:
 rs=[r for r in records if r['arm']==arm]
 print(arm,'early_false_complete',sum(r['bucket']=='false_complete' and r.get('early_stop',False) for r in rs),'early_incorrect_answer',sum(r['bucket']=='incorrect_answer' and r.get('early_stop',False) for r in rs),'raw_scores',dict(collections.Counter(r['raw_score'] for r in rs)),'agents', sorted({r['agent'] for r in rs}))
print('missing budget',sorted(set(missing)))
audit.dump('episodes.json',records)
