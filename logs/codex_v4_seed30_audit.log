     1	#!/bin/bash
     2	# Resume one emulator "lane" of the AndroidWorld queue after a host reboot (all local processes die on reboot).
     3	# lane1 (5556): GUI-Owl matched reference (resume).  lane2 (5558): 450M base (resume) -> LFM3 FT + runtime_feedback ablation.
     4	# Qwen hand-offs (local_qwen_to_aw.sh) wait on "^bash scripts/local_aw_lane.sh <lane>" + the emulator being free.
     5	# Usage: bash scripts/local_aw_lane.sh lane1|lane2
     6	set -u
     7	cd /Users/alpha/lfm3-android
     8	export ANDROID_SDK_ROOT=/opt/homebrew/share/android-commandlinetools ANDROID_HOME=/opt/homebrew/share/android-commandlinetools \
     9	       JAVA_HOME=/opt/homebrew/opt/openjdk@17
    10	EMU=$ANDROID_SDK_ROOT/emulator/emulator
    11	FILTER="_os_env_vars\|FD from fork\|fork_posix"
    12	boot() {  # avd console grpc log [extra args]
    13	  adb devices | grep -q "emulator-$2" || nohup $EMU -avd "$1" -port "$2" -grpc "$3" -no-snapshot -no-window -no-audio \
    14	      -no-boot-anim -gpu swiftshader_indirect ${5:-} > "$4" 2>&1 < /dev/null &
    15	  until [ "$(adb -s emulator-$2 shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; do sleep 5; done
    16	  sleep 20; echo "[$(date +%T)] emulator-$2 booted"
    17	}
    18	serve() {  # port log args...
    19	  local port=$1 log=$2; shift 2
    20	  curl -s 127.0.0.1:$port/health | grep -q ok || nohup llama-server "$@" --port $port --host 127.0.0.1 > "$log" 2>&1 < /dev/null &
    21	  until curl -s 127.0.0.1:$port/health | grep -q ok; do sleep 3; done; echo "[$(date +%T)] server :$port up"
    22	}
    23	stop_server() { pkill -f "[l]lama-server.*--port $1 " ; true; }
    24	case "$1" in
    25	lane1)
    26	  boot AndroidWorldAvd 5556 8556 logs/emulator_aw.log "-partition-size 3072"
    27	  serve 8092 logs/llama_server_guiowl.log -m models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf \
    28	    --mmproj models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf -c 20480 -np 1 -ngl 99 --image-max-tokens 2600 --jinja
    29	  echo "[$(date +%T)] resuming GUI-Owl matched reference"
    30	  .venv-aw/bin/python eval/androidworld/run_aw.py --agent=guiowl --guiowl_images=1 --guiowl_max_pixels=1048576 --console_port=5556 \
    31	    --grpc_port=8556 --server_url=http://127.0.0.1:8092 --agent_label=guiowl15_2b_matched1img_q4km \
    32	    --checkpoint_dir=results/androidworld/guiowl15_2b_matched/run_20261116T231457945810 2>&1 \
    33	    | grep --line-buffered -v "$FILTER" >> logs/aw_run_guiowl_matched.log
    34	  stop_server 8092; echo "[$(date +%T)] GUI-Owl reference run finished" ;;
    35	lane2)
    36	  boot AndroidWorldAvd2 5558 8558 logs/emulator_aw2.log
    37	  serve 8095 logs/llama_server_450m_base.log -m models/LFM2.5-VL-450M-GGUF/LFM2.5-VL-450M-Q4_K_M.gguf \
