from pathlib import Path
import re, collections, json
summary={}
for arm,f in [('v4','aw_run_lfm3vl2b_v4.log'),('v3','aw_run_lfm3vl2b_v3.log'),('v1','aw_run_lfm3_ft.log'),('guiowl','aw_run_guiowl_matched.log')]:
 p=Path('logs')/f;lines=p.read_text(errors='replace').splitlines()
 selected=[(i+1,l) for i,l in enumerate(lines) if 'Logging exception and skipping task.' in l or 'Writing to ' in l or 'Retrying failed' in l or 'Resuming from' in l or 'completed tasks' in l or 'failed tasks' in l]
 skips=collections.Counter(re.findall(r'"'^SKIPPING ('"\\w+)\\.', '\\n'.join(lines), re.M))
 runs=collections.Counter(re.findall(r'Running task (\\w+) with goal', '\\n'.join(lines)))
 obj={'lines':len(lines),'selected':selected,'skip_prints':dict(skips),'repeated_running_prints':{k:v for k,v in runs.items() if v>2},'running_tasks':len(runs)}
 summary[arm]=obj
 print(arm,json.dumps(obj,indent=1))
Path('results/codex/v4_seed30_audit/development_log_evidence.json').write_text(json.dumps(summary,indent=2)+'\\n')
