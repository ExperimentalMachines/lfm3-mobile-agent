    30	def verify_playlist(
    31	    device_playlist_rows: list[sqlite_schema_utils.PlaylistInfo],
    32	    candidate_playlist_name: str,
    33	    candidate_files: list[str],
    34	) -> bool:
    35	  """Verifies if the playlist on the device matches the expected name, files, and their order.
    36	
    37	  Args:
    38	    device_playlist_rows: The playlist rows queried from the device.
    39	    candidate_playlist_name: The expected name of the playlist.
    40	    candidate_files: The list of expected media file names in the playlist.
    41	
    42	  Returns:
    43	    True if the actual playlist matches the expected criteria, False otherwise.
    44	  """
    45	  total = sum(
    46	      1
    47	      for actual_item in device_playlist_rows
    48	      if fuzzy_match_lib.fuzzy_match(
    49	          actual_item.playlist_name, candidate_playlist_name, ignore_case=True
    50	      )
    51	  )
    52	
    53	  if total != len(candidate_files):
    54	    return False
    55	
    56	  matched_files = 0
    57	  for index, expected_file in enumerate(candidate_files):
    58	    if any(
    59	        fuzzy_match_lib.fuzzy_match(
    60	            actual_item.playlist_name, candidate_playlist_name, ignore_case=True
    61	        )
    62	        and actual_item.media_file_name == expected_file
    63	        and (actual_item.order_in_playlist == index)
    64	        for actual_item in device_playlist_rows
    65	    ):
    66	      matched_files += 1
    67	    else:
    68	      return False
    69	
    70	  return matched_files == len(candidate_files)
    71	
    72	
    73	def validate_rows_removal_integrity(
    74	    before: list[sqlite_schema_utils.RowType],
    75	    after: list[sqlite_schema_utils.RowType],
    76	    ids: list[int],
    77	    id_name: str,
    78	) -> bool:
    79	  """Validates that specified rows have been removed correctly from the rows list and that the remaining rows are unaltered.
    80	
    81	  This function checks that all rows with IDs in `ids` are not present
    82	  in the `after` state and that all other rows from the `before` state remain
    83	  unchanged. It also ensures that no new rows have been inadvertently added.
    84	
    85	  Args:
    86	    before: State of the rows before removal.
    87	    after: State of the rows after attempted removal.
    88	    ids: IDs of the rows expected to be removed.
    89	    id_name: The name of the ID column in the database.
    90	
    91	  Returns:
    92	    True if specified rows are removed and the integrity of the rows list is
    93	    maintained; False if any specified rows are not removed, if any
    94	    non-specified rows are missing, or if new rows have been added.
    95	  """
    96	  for row_id in ids:
    97	    if not any(row for row in before if getattr(row, id_name) == row_id):
    98	      raise ValueError(f"row ID {row_id} not present in before.")
    99	
   100	  # Validate the removal and intactness of other rows
   101	  for row in before:
   102	    # If the row ID is in the list of removed row IDs
   103	    if getattr(row, id_name) in ids:
   104	      if row in after:
   105	        return False
   106	    elif row not in after:
   107	      # Make sure we didn't remove other rows.
   108	      return False
   109	
