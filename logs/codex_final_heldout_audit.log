+dump('execution_logs.json', logs)
+
+port_by_dir={str(Path(x['path']).parent):x['ports'] for x in logs if 'results/' in x['path']}
+timeline=[]
+for e in inv:
+    directory=str(Path(e['path']).parent.parent)
