    37	
    38	  def initialize_task(self, env: interface.AsyncEnv) -> None:
    39	    super().initialize_task(env)
    40	    contacts_utils.clear_contacts(env.controller)
    41	
    42	  def _has_contact(self, contacts: list[contacts_utils.Contact]) -> bool:
    43	    return (
    44	        contacts_utils.Contact(
    45	            self.params['name'],
    46	            contacts_utils.clean_phone_number(self.params['number']),
    47	        )
    48	        in contacts
    49	    )
    50	
    51	  def is_successful(self, env: interface.AsyncEnv) -> float:
    52	    contact_found = self._has_contact(
    53	        contacts_utils.list_contacts(env.controller)
    54	    )
    55	    return super().is_successful(env) if contact_found else 0.0
    56	
