   200	        c = sum(1 for t in META if D[(y, s)][0][t] and not D[(x, s)][0][t])
   201	        both = sum(1 for t in META if D[(x, s)][0][t] and D[(y, s)][0][t])
   202	        per_seed[s] = {f"{x}_only": b, f"{y}_only": c, "both": both, "mcnemar_exact_p": round(mcnemar(b, c), 4)}
   203	    mean = 100 * sum(diffs) / n_inst
   204	    pval = signflip(clusters, n_inst, 0.0, a.perms)
   205	    ex = signflip_ci(clusters, n_inst, a.perms)
