    35	def _contact_info_is_entered(
    36	    first: str,
    37	    last: str,
    38	    phone: str,
    39	    phone_label: str,
    40	    ui_elements: list[representation_utils.UIElement],
    41	) -> bool:
    42	  """Checks if UI elements contain requested contact info.
    43	
    44	  Specifically, it checks if current screen is the new contact screen and if the
    45	  screen shows the function arguments filled out for the contacts.
    46	
    47	  Args:
    48	    first: First name.
    49	    last: Last name.
    50	    phone: Phone number.
    51	    phone_label: Label for phone number.
    52	    ui_elements: UI elements on screen.
    53	
    54	  Returns:
    55	    True if contact form is filled out.
    56	  """
    57	  first_name_element = None
    58	  last_name_element = None
    59	  phone_element = None
    60	  phone_label_element = None
    61	
    62	  # Mobile can appear twice on the screen, making this is a difficult edge case.
    63	  # Do not use this input.
    64	  assert phone_label != "Mobile"
    65	
    66	  for element in ui_elements:
    67	    if (
    68	        element.text
    69	        and fuzzy_match_lib.fuzzy_match(element.text, first)
    70	        and element.hint_text == "First name"
    71	    ):
    72	      first_name_element = element
    73	    elif (
    74	        element.text
    75	        and fuzzy_match_lib.fuzzy_match(element.text, last)
    76	        and element.hint_text == "Last name"
    77	    ):
    78	      last_name_element = element
    79	    elif element.text and (
    80	        re.sub(r"\D", "", element.text) == re.sub(r"\D", "", phone)
    81	        and element.hint_text == "Phone"
    82	    ):
    83	      phone_element = element
    84	    elif (
    85	        element.text == phone_label
    86	        and element.content_description == phone_label + " Phone"
    87	    ):
    88	      phone_label_element = element
    89	
    90	  # Content description may not be set properly, so we try to find the phone
    91	  # label element by its text and its position if it is not found above
    92	  if phone_element and phone_label_element is None:
    93	    phone_label_element = _find_phone_label_element(
    94	        phone_element, phone_label, ui_elements
    95	    )
    96	  if (
    97	      first_name_element is None
    98	      or last_name_element is None
    99	      or phone_element is None
   100	      or phone_label_element is None
   101	  ):
   102	    if first_name_element is None:
   103	      logging.info("Missing 'first' UI element")
   104	    if last_name_element is None:
   105	      logging.info("Missing 'last' UI element")
   106	    if phone_element is None:
   107	      logging.info("Missing 'phone' UI element")
   108	    if phone_label_element is None:
   109	      logging.info("Missing 'phone_label' UI element")
   110	    return False
   111	
   112	  return True
