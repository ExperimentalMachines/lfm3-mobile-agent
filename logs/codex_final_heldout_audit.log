     1	#!/bin/bash
     2	# Run one SEALED AndroidWorld arm on a held-out seed (docs/PREREG_v4.md): results go to results/androidworld_sealed/,
     3	# per-task outcome lines are dropped from the log so nobody reads results before every arm on the seed has finished.
     4	# Usage: bash scripts/local_sealed_aw.sh <arm> <seed> <console_port> <grpc_port> <server_port>
     5	#   arm = v1 | v3 | v4 | guiowl
     6	set -u
     7	cd /Users/alpha/lfm3-android
     8	ARM=$1; SEED=$2; CP=$3; GP=$4; PORT=$5
     9	NAME=${ARM}_seed${SEED}
    10	OUT=results/androidworld_sealed/$NAME
    11	LOG=logs/aw_sealed_$NAME.log
    12	mkdir -p "$OUT"
    13	# outcome lines (suite_utils prints "Task Successful/Failed") and android_env fork noise are not written to the log
    14	FILTER="Task Successful\|Task Failed\|_os_env_vars\|FD from fork\|fork_posix"
    15	case "$ARM" in
    16	  v1) SRV=(-m models/LFM3-VL-2B-AndroidControl-GGUF/LFM3-VL-2B-AndroidControl-Q4_K_M.gguf
    17	           --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
    18	      RUN=(--agent=lfm --enable_thinking=true --agent_label=lfm3vl2b_v1_q4km) ;;
    19	  v3) SRV=(-m models/lfm3vl2b_v3-GGUF/LFM3-VL-2B-AndroidAgent-v3-Q4_K_M.gguf
    20	           --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
    21	      RUN=(--agent=lfm --enable_thinking=true --agent_label=lfm3vl2b_v3_q4km) ;;
    22	  v4) SRV=(-m models/lfm3vl2b_v4-GGUF/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf
    23	           --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
    24	      RUN=(--agent=lfm --enable_thinking=true --prompt_version=v4 --agent_label=lfm3vl2b_v4_q4km) ;;
    25	  guiowl) SRV=(-m models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf
    26	               --mmproj models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf -c 20480 --image-max-tokens 2600 --jinja)
    27	      RUN=(--agent=guiowl --guiowl_images=1 --guiowl_max_pixels=1048576 --installed_apps=true
    28	           --agent_label=guiowl15_2b_matched1img_apps_q4km) ;;
    29	  *) echo "unknown arm $ARM"; exit 2 ;;
    30	esac
    31	for f in "${SRV[1]}" "${SRV[3]}"; do [ -s "$f" ] || { echo "missing $f"; exit 1; }; done
    32	curl -s 127.0.0.1:$PORT/health | grep -q ok && { echo "port $PORT already serving; refusing"; exit 1; }
    33	nohup llama-server "${SRV[@]}" -np 1 -ngl 99 --port $PORT --host 127.0.0.1 > logs/llama_server_$NAME.log 2>&1 < /dev/null &
    34	until curl -s 127.0.0.1:$PORT/health | grep -q ok; do sleep 3; done
    35	echo "[$(date +%T)] server :$PORT up; starting SEALED $NAME (seed $SEED) on emulator $CP"
    36	.venv-aw/bin/python eval/androidworld/run_aw.py --console_port=$CP --grpc_port=$GP --server_url=http://127.0.0.1:$PORT \
    37	  --task_random_seed=$SEED --n_task_combinations=1 --output_path=$OUT "${RUN[@]}" 2>&1 \
    38	  | grep --line-buffered -v "$FILTER" > "$LOG"
    39	pkill -f "[l]lama-server.*--port $PORT "
    40	echo "[$(date +%T)] SEALED $NAME AndroidWorld finished"
