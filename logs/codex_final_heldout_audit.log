     1	#!/bin/bash
     2	# Queue AndroidWorld jobs on one emulator after <wait_pid> exits. Items (fields separated by "|"):
     3	#   arm|<arm>|<seed>|<server_port>                         -> full SEALED arm via scripts/local_sealed_aw_v3.sh (skipped if 116 done)
     4	#   rerun|<arm>|<seed>|<server_port>|<out_dir>|<tasks>|[label] -> preregistered single re-run via scripts/local_aw_rerun.sh
     5	# This log holds only start/end lines and episode-file counts (no outcomes).
     6	# Usage: nohup bash scripts/local_aw_queue_v2.sh <wait_pid> <console_port> <grpc_port> '<item>' ... > logs/x.log 2>&1 &
     7	set -u
     8	cd /Users/alpha/lfm3-android
     9	W=$1; CP=$2; GP=$3; shift 3
    10	log() { echo "[$(date +%T)] $*"; }
    11	count() { local d; d=$(ls -d "$1"/run_*/ 2>/dev/null | tail -1); [ -n "$d" ] && ls "$d"*.pkl.gz 2>/dev/null | wc -l | tr -d ' ' || echo 0; }
    12	log "queue on emulator $CP ($# items), waiting for PID $W"
    13	while kill -0 "$W" 2>/dev/null; do sleep 30; done
    14	for item in "$@"; do
    15	  IFS='|' read -r KIND ARM SEED PORT ODIR TASKS LABEL <<< "$item"
    16	  if [ "$KIND" = arm ]; then
    17	    D=results/androidworld_sealed/${ARM}_seed${SEED}
    18	    [ "$(count $D)" -ge 116 ] && { log "${ARM}_seed${SEED} already complete; skipping"; continue; }
    19	    log "start sealed ${ARM}_seed${SEED} (server :$PORT)"
    20	    bash scripts/local_sealed_aw_v3.sh "$ARM" "$SEED" "$CP" "$GP" "$PORT" >> logs/local_sealed_${ARM}_seed${SEED}.log 2>&1 < /dev/null
    21	    log "${ARM}_seed${SEED} ended: $(tail -1 logs/local_sealed_${ARM}_seed${SEED}.log | cut -c1-100) ($(count $D) episodes)"
    22	  else
    23	    log "start re-run ${ARM} seed ${SEED}: $TASKS -> $ODIR"
    24	    bash scripts/local_aw_rerun.sh "$ARM" "$SEED" "$CP" "$GP" "$PORT" "$ODIR" "$TASKS" "$LABEL" >> logs/local_aw_rerun_${ARM}_seed${SEED}.log 2>&1 < /dev/null
    25	    log "re-run ${ARM} seed ${SEED} ended: $(tail -1 logs/local_aw_rerun_${ARM}_seed${SEED}.log | cut -c1-100)"
    26	  fi
    27	done
    28	log "QUEUE DONE"
     1	#!/bin/bash
     2	# Emulator guard for the preregistered single re-runs (docs/PREREG_v4.md 2026-11-19 13:40). An emulator whose guest
     3	# stops answering `adb shell` makes every following AndroidWorld episode crash in setup after adb's 120-s timeouts
     4	# (emulator 2, 2026-11-19 00:35-08:06: 113 setup crashes in v4 seed 1234). Because a re-run is allowed only once, this
     5	# guard probes the emulator every 20 s (15-s bound per probe, read-only `adb shell echo`; the shared adb server is never
     6	# restarted) and, after two consecutive failed probes, kills that emulator's run_aw.py BEFORE a crashed episode can be
     7	# recorded. The interrupted episode leaves no episode file; the remaining tasks are resumed in the same run directory
     8	# after the emulator is restarted (disclosed). Exits when <watch_pid> (the queue/wrapper) is gone.
     9	# Usage: nohup bash scripts/aw_emu_guard.sh <console_port> <watch_pid> >> logs/aw_emu_guard_<port>.log 2>&1 &
    10	set -u
    11	CP=$1; W=$2; fails=0
    12	log() { echo "[$(date +%T)] $*"; }
    13	log "guard up for emulator-$CP (watching pid $W)"
    14	while kill -0 "$W" 2>/dev/null; do
    15	  if [ "$(perl -e 'alarm 15; exec @ARGV' adb -P 5037 -s emulator-$CP shell echo ok 2>/dev/null | tr -d '\r')" = ok ]; then
    16	    fails=0
    17	  else
    18	    fails=$((fails + 1)); log "emulator-$CP probe failed ($fails)"
    19	    if [ $fails -ge 2 ]; then
    20	      log "emulator-$CP unresponsive: killing run_aw.py --console_port=$CP"
    21	      pkill -f "[r]un_aw.py --console_port=$CP " ; exit 0
    22	    fi
    23	  fi
    24	  sleep 20
    25	done
    26	log "watched pid $W gone; guard exiting"

