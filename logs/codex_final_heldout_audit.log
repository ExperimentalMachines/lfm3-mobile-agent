     1	"""Deployment-style `open_app` resolution (opt-in runtime component, Codex final-audit recommendation #1).
     2	
     3	A phone runtime knows the launcher labels of installed apps. When the model's app name does not resolve, map it to the
     4	best *lexically* matching installed label (token prefix / near-spelling only — no hand-written synonyms, so e.g.
     5	"Stopwatch" is NOT mapped to Clock). If nothing matches, the action is not executed and the failure is reported back in
     6	the action history. Installed labels = android_world's own name table restricted to packages present on the device.
     7	"""
     8	import difflib
     9	import re
    10	
    11	from android_world.env import adb_utils
    12	
    13	
    14	_GENERIC = {"google", "simple", "pro", "app", "the", "my", "android"}  # carry no app identity
    15	
    16	
    17	def _tokens(s):
    18	    return [t for t in re.sub(r"[^a-z0-9]+", " ", str(s).lower()).split() if t not in _GENERIC]
    19	
    20	
    21	def _tok_match(a, b):
    22	    if a == b:
    23	        return True
    24	    if min(len(a), len(b)) >= 4 and (a.startswith(b) or b.startswith(a)):
    25	        return True  # file/files, contact/contacts
    26	    return min(len(a), len(b)) >= 5 and difflib.SequenceMatcher(None, a, b).ratio() >= 0.8  # marker/markor
    27	
    28	
    29	def score(query, label):
    30	    q, l = _tokens(query), _tokens(label)
    31	    if not q or not l:
    32	        return 0.0
    33	    hit = sum(any(_tok_match(a, b) for b in l) for a in q)
    34	    return hit / len(q)
    35	
    36	
    37	def resolves_natively(name):
    38	    name = str(name or "")
    39	    return name in adb_utils._DEFAULT_URIS or adb_utils.get_adb_activity(name) is not None
    40	
    41	
    42	def installed_labels(env):
    43	    """First alternative of each android_world name pattern whose package is installed on this device."""
    44	    try:
    45	        out = adb_utils.issue_generic_request(["shell", "pm", "list", "packages"], env).generic.output.decode()
    46	    except Exception:
    47	        return []
    48	    pkgs = {ln.split(":", 1)[1].strip() for ln in out.splitlines() if ln.startswith("package:")}
    49	    labels = []
    50	    for pat, act in adb_utils._PATTERN_TO_ACTIVITY.items():
    51	        if act.split("/")[0] in pkgs:
    52	            labels.append(pat.split("|")[0])
    53	    return labels
    54	
    55	
    56	def resolve(name, labels, threshold=0.5):
    57	    """-> (label or None, score). >= half of the query's identity tokens must match a label token; ties -> shortest label."""
    58	    best = max(((score(name, l), -len(l), l) for l in labels), default=(0.0, 0, None))
    59	    return (best[2], best[0]) if best[0] >= threshold else (None, best[0])
    60	
    61	
    62	# --- v4 installed-app list (prompt input; same list for the LFM3 v4 and GUI-Owl matched arms) ---------------------------
    63	# Display names for android_world's launchable apps: what a phone launcher would show. Each must resolve natively through
    64	# android_world's own get_adb_activity to the same activity as its pattern (checked by tests in check_app_names()).
    65	_INFRA = {"android world", "miniwob", "clipper", "caa"}  # benchmark infrastructure, not user apps
    66	_DISPLAY = {
    67	    "google chrome": "Chrome", "settings": "Settings", "youtube": "YouTube", "google play": "Google Play",
    68	    "gmail": "Gmail", "google maps": "Maps", "google photos": "Photos", "google calendar": "Google Calendar",
    69	    "camera": "Camera", "audio recorder": "Audio Recorder", "google drive": "Drive", "clock": "Clock",
    70	    "google search": "Google", "contacts": "Contacts", "files": "Files", "markor": "Markor", "messages": "Messages",
    71	    "simple sms messenger": "Simple SMS Messenger", "dialer": "Phone", "simple calendar pro": "Simple Calendar Pro",
    72	    "simple gallery pro": "Simple Gallery Pro", "simple draw pro": "Simple Draw Pro", "pro expense": "Pro Expense",
    73	    "broccoli": "Broccoli", "osmand": "OsmAnd", "tasks": "Tasks", "open tracks sports tracker": "OpenTracks",
    74	    "joplin": "Joplin", "vlc": "VLC", "retro music": "Retro Music",
    75	}
    76	
    77	
    78	def display_names(labels):
    79	    """android_world labels (first pattern alternatives) -> launcher-style names, infrastructure apps removed, sorted."""
    80	    return sorted({_DISPLAY.get(l, l.title()) for l in labels if l not in _INFRA}, key=str.lower)
    81	
    82	
    83	def device_app_names(env):
    84	    return display_names(installed_labels(env))
    85	
    86	
    87	def check_app_names():
    88	    """Every display name must launch the same activity as its android_world pattern."""
    89	    for pat, act in adb_utils._PATTERN_TO_ACTIVITY.items():
    90	        first = pat.split("|")[0]
    91	        if first in _DISPLAY:
    92	            got = adb_utils.get_adb_activity(_DISPLAY[first])
    93	            assert got == act, (first, _DISPLAY[first], got, act)
    94	    return True
