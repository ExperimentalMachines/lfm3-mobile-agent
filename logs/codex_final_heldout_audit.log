+"""Read-only checks of existing artifacts; all outputs remain in this directory.
+No AndroidWorld, emulator, adb, server, or process-control imports/calls.
+"""
+from pathlib import Path
+from collections import Counter
+from statistics import NormalDist
+import ast, datetime, glob, gzip, hashlib, json, math, os, pickle, re
+
+OUT = Path(__file__).resolve().parent
+def dump(name, obj):
+    (OUT / name).write_text(json.dumps(obj, indent=2, default=str) + '\n')
+def read(name):
+    return json.loads((OUT / name).read_text())
+
+inv = read('inventory.json')
+reruns = read('rerun_identity.json')
+logpaths = sorted(Path('results/androidworld_sealed').glob('*/run_output*.log'))
+logpaths += [Path(f'logs/aw_sealed_{a}_seed7.log') for a in ('v1', 'guiowl')]
+logs = []
+for path in logpaths:
+    # Never reproduce environment dumps embedded in the source logs.
+    starts, writes, snapshots, fetches, dates, terminals, ports = [], [], [], [], [], [], set()
+    for line_no, line in enumerate(path.open(errors='replace'), 1):
+        if '_os_env_vars' in line:
+            continue
+        loc = dict(line=line_no)
+        m = re.search(r'[IWEF](\d{4}) (\d\d:\d\d:\d\d\.\d+)', line)
+        if m:
+            loc['time'] = f'2026-{m[1][:2]}-{m[1][2:]} {m[2]}'
+        else:
+            continue  # Ignore duplicate stdout prints; use timestamped records.
+        m = re.search(r'suite_utils.py:\d+\] Running task: (\w+)\s*$', line)
+        if m: starts.append(dict(loc, task=m[1]))
+        m = re.search(r'Wrote task episodes for (\w+)_0 to', line)
+        if m: writes.append(dict(loc, task=m[1]))
+        m = re.search(r'Skipping app snapshot loading : (.*)', line)
+        if m: snapshots.append(dict(loc, reason=m[1]))
+        m = re.search(r'Fetched after ([.\d]+) seconds', line)
+        if m: fetches.append(dict(loc, seconds=float(m[1])))
+        m = re.search(r'shell date ([\d.]+)\]', line)
+        if m: dates.append(dict(loc, date_command=m[1]))
+        m = re.search(r"device_name='emulator-(\d+)'", line)
+        if m: ports.add(m[1])
+        if 'Agent indicates done' in line: terminals.append(loc)
+    starts_n, writes_n = Counter(x['task'] for x in starts), Counter(x['task'] for x in writes)
+    row = dict(path=str(path), ports=sorted(ports), starts=starts, writes=writes,
+               duplicate_starts={t:n for t,n in starts_n.items() if n>1},
+               duplicate_writes={t:n for t,n in writes_n.items() if n>1},
+               snapshot_skip_count=len(snapshots), snapshot_skips=snapshots,
+               fetch_count=len(fetches), max_fetch_seconds=max((f['seconds'] for f in fetches), default=None),
+               date_commands=dict(Counter(x['date_command'] for x in dates)))
+    if '_rerun/' in str(path):
+        expected = {r['task'] for r in reruns if str(Path(r['rerun']).parent.parent)==str(path.parent)}
+        assert set(starts_n)==expected and set(writes_n)==expected, path
+        assert all(n==1 for n in starts_n.values()) and all(n==1 for n in writes_n.values()), path
+        row['one_start_one_write_per_rerun_verified']=True
+    if path.parent.name=='v4_seed1234':
+        row['fetches_before_hang']=fetches
+    logs.append(row)
+dump('execution_logs.json', logs)
+
+port_by_dir={str(Path(x['path']).parent):x['ports'] for x in logs if 'results/' in x['path']}
+timeline=[]
+for e in inv:
+    directory=str(Path(e['path']).parent.parent)
+    if port_by_dir.get(directory)==['5558'] and e['finish']>='2026-11-19 00:00' and e['start']<'2026-11-19 10:05':
+        timeline.append(e)
+dump('emulator2_overnight_episodes.json', sorted(timeline, key=lambda x:x['start']))
+
+# Independently calculated values versus EVERY numeric output field in supplied JSONs.
+stats=read('independent_statistics.json')
+checks=[]
+def same(label, got, expected):
+    assert got==expected, (label,got,expected)
+    checks.append(label)
+def outward(ci):
+    return [math.floor(ci[0]*10+1e-9)/10, math.ceil(ci[1]*10-1e-9)/10]
+def check_cmp(label, p, c, x='v4', y='guiowl'):
+    for key, val in [('mean_diff_pp',round(c['mean_diff_pp'],1)), ('signflip_p_two_sided',round(c['p_mc'],4)),
+                     ('ci95_pp_test_inversion',outward(c['ci95_pp'])),
+                     ('n_instances',c['n_instances']),('n_clusters',c['n_clusters'])]:
+        same(label+'.'+key,p[key],val)
+    if 'ci95_pp_exact_endpoints' in p:
+        same(label+'.exact_ci',p['ci95_pp_exact_endpoints'],[round(v,6) for v in c['ci95_pp']])
+    if 'non_inferior_vs_margin' in p:
+        same(label+'.NI',p['non_inferior_vs_margin'],c['non_inferior'])
+    if 'non_inferior' in p:
+        same(label+'.NI',p['non_inferior'],c['non_inferior'])
+        same(label+'.margin',p['non_inferiority_margin_pp'],-6.9)
+    if 'per_seed' in p:
+        for s,v in p['per_seed'].items():
+            d=c['per_seed'][s]
+            for k,k2 in [(f'{x}_only','first_only'),(f'{y}_only','second_only'),('both','both')]:
+                same(label+'.'+s+'.'+k,v[k],d[k2])
+            same(label+'.'+s+'.mcnemar',v['mcnemar_exact_p'],round(d['mcnemar_p'],4))
+
+for name, seedset, compkey in [('final',[7,1234,2026],'comparisons'),('seed7',[7],'seed7')]:
+    p=json.loads(Path(f'results/sealed_analysis_{name}.json').read_text())
+    same(name+'.seeds',p['seeds'],seedset)
+    for a,pa in p['arms'].items():
+        for s,ps in pa['per_seed'].items():
+            c=stats['arms'][a][s]
+            for key,value in [('successes',c['successes']),('of',c['n']),('pct',round(c['percent'],1)),
+                              ('wilson95',[round(v,1) for v in c['wilson95']]),('exceptions',c['exceptions'])]:
+                same(f'{name}.{a}.{s}.{key}',ps[key],value)
+            for key,split in [('answer_tasks','answer'),('action_tasks','action'),('goal_can_vary','varying')]:
+                same(f'{name}.{a}.{s}.{key}',ps[key],'/'.join(map(str,c['splits'][split])))
+            for d in ('easy','medium','hard'):
+                same(f'{name}.{a}.{s}.{d}',ps['by_difficulty'][d],'/'.join(map(str,c['splits'][d])))
+            k,n=c['secondary']
+            same(f'{name}.{a}.{s}.official',ps['official_rule_exceptions_dropped'],f'{k}/{n} = {round(100*k/n,1)}%')
+        c=stats['arms'][a]['pooled' if name=='final' else '7']
+        same(f'{name}.{a}.total',pa['total'],f"{c['successes']}/{c['n']}")
+        same(f'{name}.{a}.pct',pa['pct'],round(c['percent'],1))
+        same(f'{name}.{a}.wilson',pa['wilson95'],[round(v,1) for v in c['wilson95']])
+    for key,pc in p['comparisons'].items():
+        if '_minus_' not in key:
+            for s,v in pc.items():
+                c=stats['sensitivities']['B']['per_seed'][s]
+                for k,k2 in [('pairs_without_exceptions','n'),('v4_only','first_only'),('guiowl_only','second_only')]:
+                    same(f'{name}.secondary.{s}.{k}',v[k],c[k2])
+                same(f'{name}.secondary.{s}.mcnemar',v['mcnemar_exact_p'],round(c['mcnemar_p'],4))
+            continue
+        key=key.split(' ')[0]
+        x,y=key.split('_minus_')
+        check_cmp(name+'.'+key,pc,stats[compkey][key],x,y)
+    for seed,count in p['observed_goal_changes_vs_seed30'].items():
+        same(f'{name}.observed_goal_changes.{seed}',count,stats['observed_goal_changes_vs_seed30'][seed])
+    same(name+'.varying_templates',p['goal_can_vary_templates'],78)
+    c=stats['dispute' if name=='final' else 'seed7_dispute']
+    check_cmp(name+'.dispute',p['sensitivity_checker_disputes'],c)
+    for a in ('v4','guiowl','v1'):
+        value=c['totals'].get(a,stats['arms'][a]['pooled' if name=='final' else '7']['successes'])
+        same(name+'.dispute.total.'+a,p['sensitivity_checker_disputes']['totals'][a],value)
+    expected={(r['arm'],r['seed'],r['task']):r for r in reruns if r['seed'] in seedset}
+    same(name+'.rerun_count',len(p['reruns_applied']),len(expected))
+    for r in p['reruns_applied']:
+        c=expected[r['arm'],r['seed'],r['task']]
+        same(f"{name}.rerun.{r['arm']}.{r['seed']}.{r['task']}.success",r['rerun_success'],c['success'])
+        same(f"{name}.rerun.{r['arm']}.{r['seed']}.{r['task']}.exception",r['rerun_exception'],c['rerun_phase']!='none')
+        if 'goal_matched' in r:
+            same(f"{name}.rerun.{r['arm']}.{r['seed']}.{r['task']}.goal",r['goal_matched'],
+                 'original' if c['goal_equal'] else 'other_arms (original crashed before the date rewording)')
+
+p=json.loads(Path('results/sealed_sensitivity_final.json').read_text())
+for name,c in [('A_primary',stats['comparisons']['v4_minus_guiowl'])]+[(name,stats['sensitivities'][name[0]]) for name in p if name[0] in 'BCD']:
+    check_cmp(name,p[name],c)
+    same(name+'.v4',p[name]['v4_successes'],c['totals']['v4'])
+    same(name+'.guiowl',p[name]['guiowl_successes'],c['totals']['guiowl'])
+same('C.rerun_count',p['C_v4_seed1234_reruns_counted_as_failures']['n_reruns'],113)
+dump('published_numeric_checks.json',dict(passed=len(checks),checks=checks))
+
+# Explicit normal-approximation planning calculation, not a claim of exact power.
+nd=NormalDist(); se=stats['comparisons']['v4_minus_guiowl']['cluster_se_pp']
+z=nd.inv_cdf(.975)
+power=dict(method='Normal approximation at the observed cluster variance held fixed; not exact sign-flip power or post-hoc evidence.',
+           cluster_se_pp=se, n_templates=116, n_paired_instances=348,
+           superiority_80pct_mde_pp=(z+nd.inv_cdf(.8))*se,
+           superiority_power_at_6_9pp=nd.cdf(6.9/se-z)+nd.cdf(-6.9/se-z),
+           noninferiority_power_true_difference_0=nd.cdf(6.9/se-z),
+           nominal_margin_pp=-6.9,
+           planned_rule='Lower endpoint of two-sided 95% interval > -6.9 pp (one-sided alpha 0.025).')
+dump('power_approximation.json',power)
+
+# Validator-only counterexample: wrong instance metadata survives the actual load()
+# and new goal predicate. Extract ONLY that function; never run the analysis module.
+tree=ast.parse(Path('scripts/sealed_analysis.py').read_text())
+fn=next(x for x in tree.body if isinstance(x,ast.FunctionDef) and x.name=='load')
+g=dict(glob=glob,os=os,pickle=pickle,gzip=gzip,math=math,re=re)
+exec(compile(ast.Module(body=[fn],type_ignores=[]),'load_function_only','exec'),g)
+r=next(r for r in reruns if not r['goal_equal'])
+with gzip.open(r['rerun'],'rb') as f: ep=pickle.load(f)
+if isinstance(ep,list): ep=ep[0]
+real_seed=ep['seed']; ep=dict(ep,seed=(real_seed+1)%2**32,instance_id=99)
+scratch=OUT/'validator_fixture'/'run_fixture'; scratch.mkdir(parents=True,exist_ok=True)
+with gzip.open(scratch/(r['task']+'_0.pkl.gz'),'wb') as f: pickle.dump(ep,f)
+_,_,goal,_=g['load'](str(scratch.parent),ep['agent_name'],expect=1,full=False)
+accepted=set(r['other_arm_goals'].values())=={goal[r['task']]}
+assert accepted
+dump('validator_counterexample.json',dict(kind='Synthetic validator-only test, NOT an observed wrong instance.',
+     source=r['rerun'], task=r['task'], correct_seed=real_seed, injected_wrong_seed=ep['seed'],
+     injected_wrong_instance_id=99, load_accepted=True, changed_goal_fallback_accepted=accepted,
+     fixture=str(scratch/(r['task']+'_0.pkl.gz'))))
+print(json.dumps(dict(numeric_checks=len(checks), rerun_logs_checked=sum('one_start_one_write_per_rerun_verified' in x for x in logs),
+                     emulator2_overnight_episodes=len(timeline),power=power),indent=2))
diff --git a/results/codex/final_heldout_audit/recompute.py b/results/codex/final_heldout_audit/recompute.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e1a4bd5999ce5e8fa5b86ae52792153829d91ce
--- /dev/null
+++ b/results/codex/final_heldout_audit/recompute.py
@@ -0,0 +1,227 @@
+"""Offline artifact audit. Does not import/run AndroidWorld or either published analysis.
+Run from repository root: .venv-aw/bin/python -B results/codex/final_heldout_audit/recompute.py
+All writes stay beside this file. Pickles are the locally generated evaluation artifacts.
+"""
+from pathlib import Path
+from collections import Counter
+from statistics import NormalDist
+import datetime, gzip, hashlib, io, json, math, pickle, re
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+OUT = Path(__file__).resolve().parent
+ROOT = Path.cwd()
+SEEDS = (7, 1234, 2026)
+ARMS = ('v4', 'guiowl', 'v1')
+META = {x['task_name']: x for x in json.loads(Path('android_world/android_world/task_metadata.json').read_text())}
+TASKS = sorted(META)
+ANSWER = set(json.loads(Path('results/codex/v3_audit/answer_tasks.json').read_text())['answer_tasks'])
+VARY = set(json.loads(Path('results/aw_template_manifest.json').read_text())['goal_text_can_vary'])
+LABELS = dict(v4='lfm3vl2b_v4_q4km', guiowl='guiowl15_2b_matched1img_apps_q4km', v1='lfm3vl2b_v1_q4km')
+
+def dump(name, data):
+    (OUT/name).write_text(json.dumps(data, indent=2, default=str)+'\n')
+
+def load(f):
+    with gzip.open(f,'rb') as g:
+        e = pickle.load(g)
+    if isinstance(e, list):
+        assert len(e)==1, f
+        e=e[0]
+    return e
+
+def goal(e):
+    # Only MarkorCreateFolder has a host-time-dependent name.
+    return re.sub(r'\d{8}_\d{6}', '<ts>', e['goal']) if e['task_template']=='MarkorCreateFolder' else e['goal']
+
+def success(e):
+    return isinstance(e.get('is_successful'), (int,float)) and e['is_successful']>=1 and not e.get('exception_info')
+
+def phase(e):
+    x=e.get('exception_info') or ''
+    # Outermost run_task frame, not nested/chained traceback vocabulary.
+    m=re.findall(r'File "[^\n]*suite_utils.py", line \d+, in _run_task\n\s+([^\n]+)', x)
+    if not m:
+        return 'none' if not x else 'unclassified'
+    if 'initialize_task' in m[-1]: return 'setup'
+    if 'is_successful' in m[-1]: return 'scoring'
+    # run_episode includes reset BEFORE its first agent.step, so inspect that frame.
+    return 'reset_before_step1' if 'agent.reset(start_on_home_screen)' in x else 'agent'
+
+ORIG, FINAL, RERUNS = {}, {}, []
+inventory, exceptions, identity, successes = [], [], [], []
+for s in SEEDS:
+    for a in ARMS:
+        base=Path(f'results/androidworld_sealed/{a}_seed{s}')
+        files=sorted(base.glob('run_*/*.pkl.gz'))
+        assert len(files)==116, (base,len(files))
+        assert len({f.parent for f in files})==1
+        episodes={}
+        for f in files:
+            e=load(f); t=f.name.rsplit('_',1)[0]
+            assert t==e['task_template'] and t not in episodes
+            assert e['agent_name']==LABELS[a]
+            episodes[t]=(e,str(f))
+        assert set(episodes)==set(TASKS)
+        ORIG[a,s]=episodes
+        FINAL[a,s]=dict(episodes)
+        rr=Path(str(base)+'_rerun')
+        for f in sorted(rr.glob('run_*/*.pkl.gz')):
+            e=load(f); t=e['task_template']; old,oldpath=episodes[t]
+            assert old.get('exception_info') and phase(old)=='setup', (a,s,t,phase(old))
+            assert e['agent_name']==LABELS[a]
+            row=dict(arm=a,seed=s,task=t,original=oldpath,rerun=str(f),original_phase=phase(old),
+                     rerun_phase=phase(e),original_goal=old['goal'],rerun_goal=e['goal'],
+                     goal_equal=goal(e)==goal(old),original_instance_seed=old.get('seed'),
+                     rerun_instance_seed=e.get('seed'),success=success(e),finish=e['finish_dtime'])
+            RERUNS.append(row)
+            FINAL[a,s][t]=(e,str(f))
+        for f in files+sorted(rr.glob('run_*/*.pkl.gz')):
+            e=load(f); t=e['task_template']
+            expected=int(hashlib.sha256(f'{s}_{t}_0'.encode()).hexdigest(),16) % 2**32
+            if e.get('seed') is not None:
+                assert e['seed']==expected, (f,e['seed'],expected)
+            assert e.get('instance_id')==0
+            row=dict(arm=a,seed=s,task=t,path=str(f),success=success(e),exception=bool(e.get('exception_info')),
+                     phase=phase(e),length=e.get('episode_length'),start=e['finish_dtime']-datetime.timedelta(seconds=e['run_time']),
+                     finish=e['finish_dtime'],run_time=e['run_time'],instance_seed=e.get('seed'),expected_seed=expected,
+                     aux_data=e.get('aux_data'),sha256=hashlib.sha256(f.read_bytes()).hexdigest())
+            inventory.append(row)
+            if e.get('exception_info'):
+                exceptions.append(dict(row,exception_info=e['exception_info']))
+for r in RERUNS:
+    if not r['goal_equal']:
+        other={a:goal(ORIG[a,r['seed']][r['task']][0]) for a in ARMS if a!=r['arm']}
+        r['other_arm_goals']=other
+        r['matches_all_other_arms']=all(x==goal(FINAL[r['arm'],r['seed']][r['task']][0]) for x in other.values())
+        assert r['matches_all_other_arms']
+for s in SEEDS:
+    for t in TASKS:
+        gs={a:goal(FINAL[a,s][t][0]) for a in ARMS}
+        if len(set(gs.values()))>1:
+            identity.append(dict(seed=s,task=t,goals=gs))
+dump('inventory.json',inventory)
+dump('exceptions.json',exceptions)
+dump('rerun_identity.json',RERUNS)
+dump('cross_arm_goal_differences.json',identity)
+
+def wilson(k,n):
+    z=NormalDist().inv_cdf(.975); den=n+z*z
+    center=(k+z*z/2)/den
+    half=z*math.sqrt(k*(n-k)/n+z*z/4)/den
+    return [100*(center-half),100*(center+half)]
+
+def mcnemar(b,c):
+    n=b+c
+    return min(1.,math.ldexp(2*sum(math.comb(n,i) for i in range(min(b,c)+1)),-n)) if n else 1.
+
+def sf(sums,weights):
+    """Independent interval-coverage inversion (order statistics of draw intervals).
+    Each sign draw accepts delta between its two crossings. Their intervals all
+    contain the observed mean. The 500th left/right endpoint gives the 95% set.
+    Also compute the EXACT unshifted random-sign p via integer convolution.
+    """
+    sums=np.asarray(sums,float); weights=np.asarray(weights,float)
+    n=weights.sum(); total=sums.sum(); mean=total/n
+    flips=2*np.random.default_rng(0).integers(0,2,size=(10000,len(sums)))-1
+    aa=flips@sums; bb=flips@weights
+    p=(1+int(np.count_nonzero(np.abs(aa)>=abs(total))))/10001
+    # For every nonconstant sign vector N>|B|.
+    assert np.all(np.abs(bb)<n)
+    r1=(total-aa)/(n-bb); r2=(total+aa)/(n+bb)
+    left=np.minimum(r1,r2); right=np.maximum(r1,r2)
+    threshold=math.ceil(.05*10001-1)
+    ci=[float(np.sort(left)[threshold-1]),float(np.sort(right)[-threshold])]
+    distribution=Counter({0:1})
+    for value in sums.astype(int):
+        nxt=Counter()
+        for v,c in distribution.items():
+            nxt[v+int(value)]+=c; nxt[v-int(value)]+=c
+        distribution=nxt
+    exact=sum(c for v,c in distribution.items() if abs(v)>=abs(total))/2**len(sums)
+    sample=sums/weights
+    se=math.sqrt(len(sums)/(len(sums)-1)*sum((sums-mean*weights)**2))/n
+    return dict(mean_diff_pp=100*mean,ci95_pp=[100*x for x in ci],p_mc=p,p_exact_zero=exact,
+                n_instances=int(n),n_clusters=len(sums),non_inferior=100*ci[0]>-6.9,
+                cluster_se_pp=100*se,cluster_sum_histogram=dict(Counter(sums.astype(int).tolist())))
+
+def compare(x='v4',y='guiowl',seeds=SEEDS,keep=lambda s,t:True,score=None):
+    score=score or (lambda a,s,t: success(FINAL[a,s][t][0]))
+    sums=[]; weights=[]; totals={x:0,y:0}; per={}
+    for s in seeds:
+        rows=[(int(score(x,s,t)),int(score(y,s,t))) for t in TASKS if keep(s,t)]
+        b=sum(i and not j for i,j in rows); c=sum(j and not i for i,j in rows)
+        per[s]=dict(n=len(rows),first_only=b,second_only=c,both=sum(i*j for i,j in rows),mcnemar_p=mcnemar(b,c))
+        for a,pos in ((x,0),(y,1)):totals[a]+=sum(r[pos] for r in rows)
+    for t in TASKS:
+        rows=[int(score(x,s,t))-int(score(y,s,t)) for s in seeds if keep(s,t)]
+        if rows:sums.append(sum(rows));weights.append(len(rows))
+    return dict(sf(sums,weights),totals=totals,per_seed=per)
+
+armstats={}
+for a in ARMS:
+    armstats[a]={}
+    for ss,key in [(SEEDS,'pooled')]+[((s,),str(s)) for s in SEEDS]:
+        eps=[(s,t,FINAL[a,s][t][0]) for s in ss for t in TASKS]
+        k=sum(success(e) for s,t,e in eps); n=len(eps)
+        splits={}
+        for name,pred in [('answer',lambda t:t in ANSWER),('action',lambda t:t not in ANSWER),
+                          ('varying',lambda t:t in VARY)]+[(d,lambda t,d=d:META[t]['difficulty']==d) for d in ('easy','medium','hard')]:
+            sub=[e for s,t,e in eps if pred(t)]
+            splits[name]=[sum(success(e) for e in sub),len(sub)]
+        armstats[a][key]=dict(successes=k,n=n,percent=100*k/n,wilson95=wilson(k,n),splits=splits,
+                             exceptions=sum(bool(e.get('exception_info')) for s,t,e in eps),
+                             secondary=[k,sum(not e.get('exception_info') for s,t,e in eps)])
+disputes=json.loads(Path('results/aw_checker_disputes.json').read_text())['disputes']
+ds={(d['arm'],d['seed'],d['task']) for d in disputes}
+score_dispute=lambda a,s,t:success(FINAL[a,s][t][0]) and (a,s,t) not in ds
+rr113={r['task'] for r in RERUNS if r['arm']=='v4' and r['seed']==1234}
+score_c=lambda a,s,t:success(FINAL[a,s][t][0]) and not (a=='v4' and s==1234 and t in rr113)
+keep_b=lambda s,t:not any(FINAL[a,s][t][0].get('exception_info') for a in ('v4','guiowl'))
+stats=dict(arms=armstats,comparisons={f'{x}_minus_{y}':compare(x,y) for x,y in [('v4','guiowl'),('v1','guiowl'),('v4','v1')]},
+           seed7={f'{x}_minus_{y}':compare(x,y,seeds=(7,)) for x,y in [('v4','guiowl'),('v1','guiowl'),('v4','v1')]},
+           dispute=compare(score=score_dispute),seed7_dispute=compare(seeds=(7,),score=score_dispute),
+           sensitivities=dict(B=compare(keep=keep_b),C=compare(score=score_c),D=compare(seeds=(7,2026))),
+           varying_only=compare(keep=lambda s,t:t in VARY),
+           drop_three_named_templates=compare(keep=lambda s,t:t not in {'BrowserDraw','SimpleSmsReplyMostRecent','SimpleSmsSendReceivedAddress'}))
+score_proposed=lambda a,s,t:success(FINAL[a,s][t][0]) and (a,s,t)!=('v1',2026,'OpenAppTaskEval')
+stats['proposed_dispute_reference_sensitivity']={
+    'v4_minus_v1':compare('v4','v1',score=score_proposed),
+    'v1_minus_guiowl':compare('v1','guiowl',score=score_proposed)}
+dev={f.name.rsplit('_',1)[0]:goal(load(f)) for f in Path('results/androidworld/guiowl15_2b_matched').glob('run_*/*.pkl.gz')}
+stats['observed_goal_changes_vs_seed30']={s:sum(goal(ORIG['guiowl',s][t][0])!=dev[t] for t in TASKS) for s in SEEDS}
+dump('independent_statistics.json',stats)
+
+# Extract all success trajectories and the two pre-hang AudioRecorder failures.
+transcripts=[]; montage=[]
+for s in (1234,2026):
+    for a in ARMS:
+        for t in TASKS:
+            e,path=FINAL[a,s][t]
+            if not success(e):continue
+            ed=e['episode_data']; n=e['episode_length']
+            row=dict(arm=a,seed=s,task=t,path=path,goal=e['goal'],length=n,finish=e['finish_dtime'],steps=[],
+                     sparse_fields={k:v for k,v in ed.items() if len(v)!=n})
+            for i in range(n):
+                step={k:v[i] for k,v in ed.items() if k!='screenshot_thumb_jpg' and len(v)==n}
+                row['steps'].append(step)
+            last=row['steps'][-1]; act=last.get('parsed_action') or {}
+            terminal=act.get('action_type')=='status' or act.get('action')=='terminate' or (
+                (act.get('action_type')=='answer' or act.get('action')=='answer') and 'answer' in ed.get('ended_by',[]))
+            row['terminal_verified']=terminal
+            assert terminal,(a,s,t,last)
+            row['review_id']=len(transcripts)+1
+            transcripts.append(row)
+            montage.append((row,ed['screenshot_thumb_jpg'][-1]))
+dump('success_trajectories.json',transcripts)
+for start in range(0,len(montage),8):
+    page=Image.new('RGB',(1440,1720),'white'); draw=ImageDraw.Draw(page)
+    for idx,(row,jpg) in enumerate(montage[start:start+8]):
+        x=(idx%4)*360;y=(idx//4)*860
+        title=f"#{row['review_id']} {row['arm']} s{row['seed']}\n{row['task']}\nlast input screen; {row['length']} steps"
+        draw.text((x+3,y+3),title,fill='black')
+        page.paste(Image.open(io.BytesIO(jpg)),(x,y+60))
+    page.save(OUT/f'final_screens_{start//8+1:02d}.jpg',quality=95)
+print(json.dumps({'inventory':len(inventory),'reruns':len(RERUNS),'exceptions_by_phase':Counter(e['phase'] for e in exceptions),
+                  'goal_differences':identity,'successes_review':len(transcripts),'primary':stats['comparisons']['v4_minus_guiowl'],
+                  'sensitivities':stats['sensitivities']},indent=2,default=str))
