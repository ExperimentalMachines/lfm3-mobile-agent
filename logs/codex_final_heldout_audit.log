    74	def wilson(k, n, z=1.959964):
    75	    ph = k / n
    76	    c = (ph + z * z / (2 * n)) / (1 + z * z / n)
    77	    h = z * math.sqrt(ph * (1 - ph) / n + z * z / (4 * n * n)) / (1 + z * z / n)
