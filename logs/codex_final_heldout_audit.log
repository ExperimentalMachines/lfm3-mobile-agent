    89	def signflip(cluster_sums, n_inst, delta=0.0, perms=10000, seed=0):
    90	    """Two-sided p for H0: mean paired difference = delta, flipping signs of template-cluster sums of (d - delta)."""
    91	    x = np.array([s - delta * m for s, m in cluster_sums])
    92	    obs = abs(x.sum()) / n_inst
    93	    rng = np.random.default_rng(seed)
    94	    signs = rng.choice([-1.0, 1.0], size=(perms, len(x)))
    95	    stats = np.abs(signs @ x) / n_inst
    96	    return float((1 + np.sum(stats >= obs - 1e-12)) / (perms + 1))
    97	
    98	
    99	def signflip_ci(cluster_sums, n_inst, perms=10000, seed=0, alpha=0.05):
   100	    """Exact endpoints of {delta: signflip(delta) >= alpha} for the same sign draws as signflip(). For draw j the
   101	    extremeness indicator |A_j - delta*B_j| >= |A0 - delta*B0| changes only where A_j - delta*B_j = +-(A0 - delta*B0), and
   102	    it holds with equality there, so the accepted set's endpoints are among these breakpoints (plus the point estimate)."""
   103	    x = np.array([s for s, m in cluster_sums], float)
   104	    w = np.array([m for s, m in cluster_sums], float)
   105	    rng = np.random.default_rng(seed)
   106	    signs = rng.choice([-1.0, 1.0], size=(perms, len(x)))
   107	    A, B, A0, B0 = signs @ x, signs @ w, x.sum(), w.sum()
   108	    with np.errstate(divide="ignore", invalid="ignore"):
   109	        cand = np.concatenate([(A - A0) / (B - B0), (A + A0) / (B + B0), [A0 / B0]])
   110	    cand = np.unique(cand[np.isfinite(cand) & (cand >= -1) & (cand <= 1)])
   111	    acc = []
   112	    for i in range(0, len(cand), 400):
   113	        d = cand[i:i + 400][:, None]
   114	        cnt = np.sum(np.abs(A[None, :] - d * B[None, :]) >= np.abs(A0 - d * B0) - 1e-9, axis=1)
   115	        acc += list(cand[i:i + 400][(1 + cnt) / (perms + 1) >= alpha])
   116	    return (float(min(acc)), float(max(acc))) if acc else None
