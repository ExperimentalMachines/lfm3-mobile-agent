   114	
   115	def _find_phone_label_element(
   116	    phone_element: representation_utils.UIElement,
   117	    phone_label: str,
   118	    ui_elements: list[representation_utils.UIElement],
   119	) -> None | representation_utils.UIElement:
   120	  for element in ui_elements:
   121	    if element.text == phone_label and _vertically_adjacent(
   122	        phone_element, element
   123	    ):
   124	      return element
   125	  return None
   126	
   127	
   128	def _vertically_adjacent(
   129	    element1: representation_utils.UIElement,
   130	    element2: representation_utils.UIElement,
   131	) -> bool:
   132	  if not element1.bbox_pixels or not element2.bbox_pixels:
   133	    return False
   134	  return (
   135	      element1.bbox_pixels.y_max
   136	      <= element2.bbox_pixels.y_min
   137	      <= element1.bbox_pixels.y_max + element1.bbox_pixels.height
   138	  )
