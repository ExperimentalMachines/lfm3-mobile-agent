  to set a specific date and time, ensuring consistency across repeated runs of
  the same task.

  Args:
    env: AndroidEnv instance.
    dt: The datetime to set the device to.
  """
  adb_utils.set_root_if_needed(env)
  _set_datetime(env, dt)




