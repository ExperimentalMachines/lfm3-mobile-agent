    81	def mcnemar(b, c):
    82	    n = b + c
    83	    if n == 0:
    84	        return 1.0
    85	    k = min(b, c)
    86	    return min(1.0, 2 * sum(comb(n, i) for i in range(k + 1)) / 2 ** n)
