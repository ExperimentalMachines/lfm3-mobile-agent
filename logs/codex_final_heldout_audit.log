"""Evaluators for information retrieval tasks."""

import abc
from typing import Any
from android_world.env import interface
from android_world.task_evals import task_eval
from android_world.task_evals.information_retrieval import activity_app_utils
from android_world.task_evals.information_retrieval import calendar_utils as calendar_utils_ir
from android_world.task_evals.information_retrieval import datetime_utils as datetime_utils_ir
from android_world.task_evals.information_retrieval import joplin_app_utils
from android_world.task_evals.information_retrieval import proto_utils
from android_world.task_evals.information_retrieval import task_app_utils
from android_world.task_evals.information_retrieval.proto import task_pb2
from android_world.task_evals.single.calendar import calendar_utils


class InformationRetrieval(task_eval.TaskEval, abc.ABC):
  """Task for information retrieval.

  Each information retrieval task is dynamically generated using the task
  parameters and success criteria are tailored to the specific requirements of
  the task. The class supports initializing tasks with app-specific states and
  handling conditional task logic based on the initial state's app context.
  """
  template = ''
  schema = {}
  app_names = ()
  complexity = 1.0  # Overridden in the registry.

  @property
  @abc.abstractmethod
  def task_template(self) -> task_pb2.Task:
    """The Task proto defining this Information Retrieval task."""

  @property
  def task(self) -> task_pb2.Task:
    return self._task

  def is_calendar_task(self) -> bool:
    return self.task.relevant_state.state.HasField('calendar')

  def is_tasks_task(self) -> bool:
    return self.task.relevant_state.state.HasField('tasks_app')

  def is_sports_task(self) -> bool:
    return self.task.relevant_state.state.HasField('sports_activity_app')

  def is_notes_task(self) -> bool:
    return self.task.relevant_state.state.HasField('notes_app')

  def __init__(self, params: dict[str, Any]):
    super().__init__(params)
    self._task = task_pb2.Task()
    self._task.CopyFrom(self.task_template)
    self.template = self.task.prompt
    self.complexity = self.task.complexity

    # Set app names based on task type
    if self.is_calendar_task():
      self.app_names = (self.task.relevant_state.state.calendar.app_name,)
    if self.is_tasks_task():
      self.app_names = ('tasks',)
    if self.is_sports_task():
      self.app_names = ('open tracks sports tracker',)
    if self.is_notes_task():
      self.app_names = ('joplin',)

  def initialize_task(self, env: interface.AsyncEnv) -> None:
    super().initialize_task(env)
    proto_utils.initialize_proto(self.task, self.params)
    _maybe_replace_date(self.params)

    # Initialize app-specific state
    relevant_state = self.task.relevant_state.state
    exclusions = list(self.task.relevant_state.exclusion_conditions)

    if (
        self.is_calendar_task()
        and relevant_state.calendar.app_name == 'simple calendar pro'
    ):
      calendar_utils_ir.setup_task_state(
          relevant_state.calendar, exclusions, env
      )
    if self.is_tasks_task():
      task_app_utils.setup_task_state(relevant_state.tasks_app, exclusions, env)
    if self.is_sports_task():
      activity_app_utils.setup_task_state(
          relevant_state.sports_activity_app, exclusions, env
      )
    if self.is_notes_task():
      joplin_app_utils.setup_task_state(
          relevant_state.notes_app, exclusions, env
      )

  def is_successful(self, env: interface.AsyncEnv) -> float:
    super().is_successful(env)
    if not env.interaction_cache:
      return 0.0
    try:
      answers_are_equal = proto_utils.check_agent_answer(
          env.interaction_cache, self.task
      )
      return 1.0 if answers_are_equal else 0.0
    except ValueError:
      return 0.0

  def tear_down(self, env: interface.AsyncEnv) -> None:
    if self.is_calendar_task():
      calendar_utils.clear_calendar_db(env)
    if self.is_tasks_task():
      task_app_utils.clear_task_db(env)
    if self.is_sports_task():
      activity_app_utils.clear_db(env)
    if self.is_notes_task():
      joplin_app_utils.clear_dbs(env)
    super().tear_down(env)


def _maybe_replace_date(params: dict[str, Any]) -> None:
  """Maybe replaces date parameters with a natural language equivalent."""
  for param_name, param_value in params.items():
    if param_name == 'seed':
      continue
    if not isinstance(param_value, str):
      continue
    try:
      if not param_value:
        continue
      params[param_name] = datetime_utils_ir.generate_reworded_date(param_value)
    except ValueError:
      pass  # Skip if there's no date parameter.
"""Screenshot-only AndroidWorld agent backed by an OpenAI-compatible server
(llama.cpp `llama-server` running the GGUF we would ship to phones).

Uses the exact prompt/action format from train/agent_format.py.
"""

from __future__ import annotations

import base64
import io
import json
import sys
import time
from pathlib import Path

import numpy as np
import requests
from PIL import Image

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "train"))
import agent_format as af  # noqa: E402
import app_resolver  # noqa: E402

from android_world.agents import base_agent  # noqa: E402
from android_world.env import interface, json_action  # noqa: E402


def _png_b64(img: Image.Image) -> str:
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    return base64.b64encode(buf.getvalue()).decode()


class LFMScreenAgent(base_agent.EnvironmentInteractingAgent):
    def __init__(self, env: interface.AsyncEnv, server_url: str, model: str = "local",
                 name: str = "lfm_screen_agent", enable_thinking: bool = True,
                 max_pixels: int = af.MAX_PIXELS, max_tokens: int = 512,
                 temperature: float = 0.0, wait_after_action: float = 1.0,
                 max_parse_retries: int = 1, runtime_feedback: bool = False, force_think: bool = False,
                 prompt_version: str = "v1"):
        super().__init__(env, name)
        self.server_url = server_url.rstrip("/")
        self.model = model
        self.enable_thinking = enable_thinking
        self.max_pixels = max_pixels
        self.max_tokens = max_tokens
        self.temperature = temperature
        self.wait_after_action = wait_after_action
        self.max_parse_retries = max_parse_retries
        self.history: list[tuple[str, str]] = []
        self._screen_size = None
        # runtime_feedback (opt-in, default off = the reported baseline harness): resolve open_app names against
        # installed apps lexically and annotate failed / no-visible-change actions in the action history.
        self.runtime_feedback = runtime_feedback
        self._labels = None
        self._prev_small = None
        self._prev_type = None
        # force_think (opt-in ablation): if the reply's intent (<think>) is empty, generate a one-line intent with the
        # end-of-think token banned, then re-ask for the action with that intent prefilled as the reasoning.
        self.force_think = force_think
        self._think_end_id = None
        # prompt_version "v4": SYSTEM_PROMPT_V4 + the device's installed-app list (read once per episode in reset()).
        assert prompt_version in af.PROMPTS, prompt_version
        self.prompt_version = prompt_version
        self.apps = None
        if force_think:
            ids = requests.post(f"{self.server_url}/tokenize", json={"content": "</think>"}, timeout=30).json()["tokens"]
            assert len(ids) == 1, f"</think> is not a single token: {ids}"
            self._think_end_id = ids[0]

    def reset(self, go_home_on_reset: bool = False):
        super().reset(go_home_on_reset)
        self.env.hide_automation_ui()
        self.history = []
        self._prev_small, self._prev_type = None, None
        if self.prompt_version == "v4":
            self.apps = app_resolver.device_app_names(self.env.controller)
            assert self.apps, "installed-app list is empty"

    def _query(self, goal: str, img: Image.Image, extra_messages=None, **overrides) -> dict:
        text = af.user_text(goal, self.history, apps=self.apps if self.prompt_version == "v4" else None)
        payload = {
            "model": self.model,
            "messages": [
                {"role": "system", "content": af.PROMPTS[self.prompt_version]},
                {"role": "user", "content": [
                    {"type": "image_url", "image_url": {"url": "data:image/png;base64," + _png_b64(img)}},
                    {"type": "text", "text": text},
                ]},
            ] + list(extra_messages or []),
            "temperature": self.temperature,
            "max_tokens": self.max_tokens,
            "chat_template_kwargs": {"enable_thinking": self.enable_thinking},
            **overrides,
        }
        t0 = time.time()
        r = requests.post(f"{self.server_url}/v1/chat/completions", json=payload, timeout=300)
        r.raise_for_status()
        out = r.json()
        msg = out["choices"][0]["message"]
        return {
            "content": msg.get("content") or "",
            "reasoning": msg.get("reasoning_content") or "",
            "latency_s": time.time() - t0,
            "usage": out.get("usage", {}),
            "timings": out.get("timings", {}),
        }

    def step(self, goal: str) -> base_agent.AgentInteractionResult:
        state = self.get_post_transition_state()
        pixels = state.pixels
        H, W = pixels.shape[:2]
        img = af.resize_screenshot(Image.fromarray(pixels), self.max_pixels)
        small = np.asarray(Image.fromarray(pixels).convert("L").resize((72, 160)), dtype=np.float32)
        if (self.runtime_feedback and self.history and self._prev_small is not None
                and self._prev_type not in ("wait", "status", "answer", None)
                and float(np.abs(small - self._prev_small).mean()) < 1.0):
            i, a = self.history[-1]
            if not a.endswith("]"):  # action JSON ends with "}"; a trailing "]" means already annotated
                self.history[-1] = (i, a + " [no visible change]")
        self._prev_small = small

        resp, action, attempts = None, None, []
        for _ in range(1 + self.max_parse_retries):
            resp = self._query(goal, img)
            action = af.parse_action(resp["content"])  # final answer only; never mine the reasoning
            attempts.append({"content": resp["content"], "reasoning": resp["reasoning"], "latency_s": resp["latency_s"],
                             "usage": resp["usage"], "lenient_ok": action is not None,
                             "strict_ok": af.parse_action(resp["content"], strict=True) is not None})
            if action is not None:
                break

        forced = None
        if self.force_think and not (resp["reasoning"] or "").strip():
            r1 = self._query(goal, img, max_tokens=40, stop=["\n", "{", ". "], logit_bias=[[self._think_end_id, False]])
            intent = ((r1["reasoning"] or "") + (r1["content"] or "")).replace("<think>", "").strip()
            intent = intent.splitlines()[0].strip().split(". ")[0].rstrip(".") + "." if intent else ""  # one sentence
            if intent:
                r2 = self._query(goal, img, extra_messages=[{"role": "assistant", "content": "", "reasoning_content": intent}],
                                 max_tokens=128)
                a2 = af.parse_action(r2["content"])
                forced = {"intent": intent, "content": r2["content"], "ok": a2 is not None,
                          "latency_s": r1["latency_s"] + r2["latency_s"]}
                attempts.append({"content": r2["content"], "reasoning": intent, "latency_s": forced["latency_s"],
                                 "usage": r2["usage"], "lenient_ok": a2 is not None, "forced_intent": True,
                                 "strict_ok": af.parse_action(r2["content"], strict=True) is not None})
                if a2 is not None:
                    action = a2
                    resp = {**r2, "reasoning": intent, "latency_s": forced["latency_s"]}

        thumb = io.BytesIO()
        Image.fromarray(pixels).convert("RGB").resize((360, 800)).save(thumb, format="JPEG", quality=70)
        data = {
            "screenshot_thumb_jpg": thumb.getvalue(),  # full-res frames would blow the local disk budget
            "model_content": resp["content"],
            "model_reasoning": resp["reasoning"],
            "latency_s": sum(x["latency_s"] for x in attempts),  # all attempts, incl. retries
            "attempts": attempts,
            "first_attempt_strict_ok": attempts[0]["strict_ok"],
            "first_attempt_lenient_ok": attempts[0]["lenient_ok"],
            "usage": resp["usage"],
            "timings": resp["timings"],
            "parsed_action": action,
            "forced_intent": forced,
        }
        if action is None:
            self.history.append(("(invalid output)", resp["content"][:80]))
            data["error"] = "unparseable"
            self._prev_type = None
            return base_agent.AgentInteractionResult(False, data)

        reasoning = resp["reasoning"] or ""
        if not reasoning.strip() and "</think>" in resp["content"]:  # inline-think models (LFM2.5): intent lives in content
            reasoning = resp["content"].split("</think>", 1)[0].replace("<think>", "")
        intent = reasoning.strip().splitlines()[0][:200] if reasoning.strip() else ""
        self.history.append((intent, af.action_to_str(action)))

        t = action["action_type"]
        if t == "status":
            return base_agent.AgentInteractionResult(True, data)

        kw = {"action_type": t}
        if t in af.POINT_TYPES:
            x, y = af.norm_to_px(action["point_2d"], W, H)
            kw.update(x=x, y=y)
        elif t in ("input_text", "answer"):
            kw["text"] = action["text"]
        elif t == "scroll":
            kw["direction"] = action["direction"]
        elif t == "open_app":
            kw["app_name"] = action["app_name"]
            if self.runtime_feedback and not app_resolver.resolves_natively(action["app_name"]):
                if self._labels is None:
                    self._labels = app_resolver.installed_labels(self.env.controller)
                label, sc = app_resolver.resolve(action["app_name"], self._labels)
                data["app_resolution"] = {"asked": action["app_name"], "resolved": label, "score": sc}
                if label is None:
                    i, a = self.history[-1]
                    self.history[-1] = (i, a + " [failed: no installed app with that name]")
                    data["error"] = "unknown_app"
                    self._prev_type = t
                    time.sleep(self.wait_after_action)
                    return base_agent.AgentInteractionResult(False, data)
                kw["app_name"] = label
        self._prev_type = t
        try:
            self.env.execute_action(json_action.JSONAction(**kw))
        except Exception as e:  # keep going; the model sees the unchanged screen
            data["error"] = f"execute_failed: {e}"
            if self.runtime_feedback:
                i, a = self.history[-1]
                self.history[-1] = (i, a + " [failed to execute]")
        time.sleep(self.wait_after_action)
        if t == "answer" and "error" not in data:
            # The answer is stored in env.interaction_cache by execute_action; end the episode here so it is
            # judged (same rule as GUI-Owl's harness, which forces terminate after answer).
            data["ended_by"] = "answer"
            return base_agent.AgentInteractionResult(True, data)
        return base_agent.AgentInteractionResult(False, data)
            args = call["arguments"] if isinstance(call["arguments"], dict) else json.loads(call["arguments"])
            args["action"] = args["action"].replace("tap", "click")
            return args
        except Exception:
            return None

    def step(self, goal: str) -> base_agent.AgentInteractionResult:
        pixels = self.get_post_transition_state().pixels
        H, W = pixels.shape[:2]
        cur = self._prep(pixels)
        payload = {"messages": self._messages(goal, cur), "temperature": self.temperature, "max_tokens": self.max_tokens}
        t0 = time.time()
        r = requests.post(f"{self.server_url}/v1/chat/completions", json=payload, timeout=900)
        r.raise_for_status()
        out = r.json()
        reply = out["choices"][0]["message"].get("content") or ""
        lat = time.time() - t0
        thumb = io.BytesIO()
        Image.fromarray(pixels).convert("RGB").resize((360, 800)).save(thumb, format="JPEG", quality=70)
        args = self._parse(reply)
        data = {"screenshot_thumb_jpg": thumb.getvalue(), "model_content": reply, "latency_s": lat,
                "usage": out.get("usage", {}), "timings": out.get("timings", {}), "parsed_action": args,
                "first_attempt_strict_ok": args is not None, "first_attempt_lenient_ok": args is not None}
        self.turns.append((cur, reply))
        if args is None:
            data["error"] = "unparseable"
            return base_agent.AgentInteractionResult(False, data)
        a = args["action"]
        sx = lambda p: round(p[0] / 1000 * (W - 1))  # noqa: E731  (their harness: x*W/999)
        sy = lambda p: round(p[1] / 1000 * (H - 1))  # noqa: E731
        try:
            if a == "terminate":
                return base_agent.AgentInteractionResult(True, data)
            if a == "answer":
                self.env.execute_action(json_action.JSONAction(action_type="answer", text=str(args.get("text", ""))))
                data["ended_by"] = "answer"
                return base_agent.AgentInteractionResult(True, data)
            if a in ("click", "long_press"):
                p = args["coordinate"]
                self.env.execute_action(json_action.JSONAction(action_type=a, x=sx(p), y=sy(p)))
            elif a == "swipe":
                p, q = args["coordinate"], args["coordinate2"]
                adb_utils.issue_generic_request(adb_utils.generate_swipe_command(sx(p), sy(p), sx(q), sy(q), 500),
                                                self.env.controller)
            elif a == "type":
                self.env.execute_action(json_action.JSONAction(action_type="input_text", text=str(args.get("text", ""))))
            elif a == "open":
                self.env.execute_action(json_action.JSONAction(action_type="open_app", app_name=str(args.get("text", ""))))
            elif a == "system_button":
                m = {"Back": "navigate_back", "Home": "navigate_home", "Enter": "keyboard_enter"}.get(args.get("button"))
                if m:
                    self.env.execute_action(json_action.JSONAction(action_type=m))
                else:
                    data["error"] = f"unsupported button {args.get('button')}"
            elif a == "wait":
                time.sleep(float(args.get("time", 1)))
            else:
                data["error"] = f"unsupported action {a}"
        except Exception as e:  # keep going like the reference harness
            data["error"] = f"execute_failed: {e}"
        time.sleep(self.wait)
        return base_agent.AgentInteractionResult(False, data)

