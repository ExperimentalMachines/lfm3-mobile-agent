    12	while true; do
    13	  if C download -s "$SESS" /content/work/jobs_status.json "$ST" 2>&1 | grep -q "lost\|not found\|404"; then
    14	    echo "[$(date +%T)] session $SESS gone"; GONE=1; break
    15	  fi
    16	  if grep -q '"exit' "$ST" 2>/dev/null && ! grep -q '"running"' "$ST"; then
    17	    echo "[$(date +%T)] job finished: $(cat $ST)"
    18	    grep -qE '"exit [1-9]' "$ST" && echo "WARNING: predecessor job FAILED; launching the next (independent) model anyway"
    19	    GONE=0; break
    20	  fi
    21	  sleep 120
    22	done
    23	if [ "$GONE" = 1 ]; then
    24	  export COLAB_CLI_REQUEST_TIMEOUT=900
