def chain_case(tag,mode,job):
    d=OUT/(tag+'_'+mode);local=d/'local';local.mkdir(parents=True)
    files=[p for top in ('scripts','train','eval') for p in (ROOT/top).rglob('*') if p.is_file() and p.suffix in ('.py','.sh','.json','.jinja')]
    files += [ROOT/'data/build_general_replay.py',ROOT/'data/meta/androidcontrol_test_gt.jsonl',ROOT/'data/meta/androidcontrol_test_gt.manifest.json',ROOT/'data/meta/splits.json']
    for src in files:
        dest=local/src.relative_to(ROOT);dest.parent.mkdir(parents=True,exist_ok=True)
        if src.name in ('chain_next_job.sh','launch_gpu_jobs.sh','gpu_session.sh'):
            s=src.read_text();f=' 2> >(grep -v \"new version\\\\|colab update\\\\|silence this\" >&2)';assert s.count(f)==1
            dest.write_text(s.replace(f,''))
        else:shutil.copyfile(src,dest)
    (local/'logs').mkdir();(d/'tmp').mkdir();(d/'token').write_text('SYNTHETIC-NOT-A-TOKEN')
    (d/'remote/content/work').mkdir(parents=True)
    bins=d/'bin';bins.mkdir()
    # Advance the shell's 90-second startup wait using a bounded local 0.5-second wait.
    # Keep the stub client alive until after the production kill -0 check.
    executable(bins/'sleep',\"import time\\ntime.sleep(.5)\\n\")
    cb=d/'colab';executable(cb,COLAB_STUB);trace=d/'commands.jsonl'
    env={'COLAB_BIN':str(cb),'COLAB_CONFIG':'','HF_TOKEN_FILE':str(d/'token'),'TMPDIR':str(d/'tmp'),'TRACE':str(trace),'CHAIN_MODE':mode,'PATH':str(bins)+os.pathsep+os.environ['PATH']}
    rec=command(['bash',str(local/'scripts/chain_next_job.sh'),'synthetic-session','scripts/jobs/'+job+'.json'],env=env,cwd=local)
    for _ in range(100):
        events=[json.loads(l) for l in trace.read_text().splitlines()] if trace.exists() else []
        if (d/'client_pid.txt').exists() or 'upload failed' in rec['stdout'] or 'BOOTSTRAP' in rec['stdout'] or mode=='gone_bootstrap_failure':break
        time.sleep(.01)
    pidfile=d/'client_pid.txt'
    if pidfile.exists():
        try:os.kill(int(pidfile.read_text()),signal.SIGTERM)
        except ProcessLookupError:pass
    rec['commands']=events;rec['fixture']=str(d)
    rec['launched_blocking']=any(e['argv'][0]=='exec' and '-f' in e['argv'] and e['argv'][-1].endswith('vm_blocking_jobs.py') for e in events)
    rec['gt_manifest_uploaded']=any(e['argv'][0]=='upload' and e['argv'][-2].endswith('androidcontrol_test_gt.manifest.json') for e in events)
    rec['creates_meta_directory']=any('/content/work/meta' in e.get('stdin','') for e in events)
    rec['heartbeat_confirmed']='heartbeat confirmed' in rec['stdout']
    rec['predecessor_warning']='WARNING: predecessor job FAILED' in rec['stdout']
    rec['remote_jobs_exist']=(d/'remote/content/work/jobs.json').exists()
    rec['remote_gt_exists']=(d/'remote/content/work/meta/androidcontrol_test_gt.jsonl').exists()
    rec['background_exit']=(d/'background_exit.txt').read_text() if (d/'background_exit.txt').exists() else None
    log=local/'logs/synthetic-session_jobs_cell.log'
    if log.exists():rec['replacement_client_log']=log.read_text()
    write_json(d/'result.json',rec)
    print(tag,mode,'rc',rec['exit'],'launch',rec['launched_blocking'],'confirmed',rec['heartbeat_confirmed'],'jobs',rec['remote_jobs_exist'],flush=True)
    return rec

