                    p=next(BASE.glob('generation_score_*/score_wrong_hash_allow_incomplete/metrics.json'));m=json.loads(p.read_text())
                else:raise ValueError(seed)
                write_json(str(prefix)+'_'+suffix+'.metrics.json',m)
    return original_command(argv,**kw)

RESULT={}
def run_pipeline(name,job,**kw):
    r=pipeline(name,job=job,**kw)
    calls=[e['argv'] for e in r['commands'] if e.get('argv')]
    r['train_calls']=sum(x[0]=='sft_vlm.py' for x in calls)
    r['generation_calls']=sum(x[0]=='generate.py' for x in calls)
    r['scorer_calls']=sum(x[0]=='score.py' for x in calls)
    r['matched_scorer_calls']=sum(x[0]=='score.py' and '--modes' in x and x[x.index('--modes')+1]=='high' for x in calls)
    RESULT[name]=r;write_json(OUT/(name+'_result.json'),r)
    print(name,'rc',r['exit'],'train',r['train_calls'],'gen',r['generation_calls'],'score',r['scorer_calls'],'matched',r['matched_scorer_calls'],flush=True)
    return r

for tag,job in [('qwen2b','qwen35_2b_l4'),('qwen08','qwen35_08b_l4')]:
    r=run_pipeline(tag+'_fresh',job)
    assert r['exit']==0 and r['train_calls']==1 and r['generation_calls']==3 and r['scorer_calls']==3 and r['matched_scorer_calls']==1 and r['matched_done_exists'],r
    m=json.loads(next((Path(r['fixture'])/'content/eval').glob('*_ft_nothink_high.metrics.json')).read_text())
    assert m['integrity']['complete'] and not m['integrity']['problems'] and m['integrity']['n_gt_rows']==1
    if tag=='qwen2b':assert any('experimentalmachines/LFM3-VL-2B-AndroidControl' in e.get('argv',[]) for e in r['commands'])
    for fail in ('upload','upload_merged','upload_evals','matched_score','matched_missing','score.py','generate.py','eval_general.py','training'):
        r=run_pipeline(tag+'_fail_'+fail.replace('.','_'),job,fail=fail)
        assert r['exit']==1,r
        if fail in ('matched_score','matched_missing'):assert not r['matched_done_exists'] and not r['matched_metrics_exist']
    for seed in ('empty_receipt','mismatched_receipt'):
        r=run_pipeline(tag+'_'+seed,job,seed=seed)
        assert r['exit']==0 and r['train_calls']==1,r
    for seed in ('cached_done','metrics_incomplete','receipt_zero_weight'):
        r=run_pipeline(tag+'_'+seed,job,override={'TEST_SEED':seed})
        assert r['exit']==0 and r['scorer_calls']==3,r
        if seed=='receipt_zero_weight':assert r['train_calls']==1
    for seed in ('receipt_good','receipt_wrong_model','receipt_wrong_target','receipt_missing_export','receipt_missing_max_steps'):
        r=run_pipeline(tag+'_'+seed,job,override={'TEST_SEED':seed})
        assert r['exit']==0 and r['train_calls']==0,r
    r=run_pipeline(tag+'_receipt_early',job,override={'TEST_SEED':'receipt_early'})
    assert r['exit']==0 and r['train_calls']==(1 if tag=='qwen2b' else 0),r
    for seed in ('metrics_complete_only','metrics_real_integrity_problem','metrics_string_false'):
        r=run_pipeline(tag+'_'+seed,job,override={'TEST_SEED':seed})
        assert r['exit']==0 and r['generation_calls']==0 and r['scorer_calls']==0 and not r['matched_done_exists'],r
    r=run_pipeline(tag+'_train_nonzero_with_receipt',job,fail='train_nonzero_with_receipt')
    assert r['exit']==0,r
RESULT['legacy_removed']=not(ROOT/'scripts/jobs/qwen35_train_l4.json').exists();assert RESULT['legacy_removed']
write_json(OUT/'results.json',RESULT)
print('RESULTS',OUT/'results.json',flush=True)
