     4	# Usage: COLAB_BIN=... COLAB_CONFIG=... HF_TOKEN_FILE=... scripts/chain_next_job.sh <session> <next_jobs.json>
     5	set -u
     6	SESS=$1; NEXT=$2
     7	cd "$(dirname "$0")/.."
     8	CB=${COLAB_BIN:-$HOME/.local/bin/colab}
     9	C() { "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} "$@" < /dev/null 2> >(grep -v "new version\|colab update\|silence this" >&2); }
