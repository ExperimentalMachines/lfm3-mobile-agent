     1	"""Score generate.py output on a v2 dev split (gt_action is stored on every row; no external GT file needed).
     2	
     3	usage: python score_dev.py preds.jsonl --expect_n N --out metrics.json
     4	Uses score.match / score.score_rows unchanged (click within 0.14 of the GT point; text/answer: normalized exact or
     5	token-F1 >= 0.5; scroll/status exact). Also reports mean token-F1 for `answer` rows (ScreenQA-style).
     6	"""
     7	import argparse
     8	import json
     9	import sys
    10	import os
    11	
    12	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    13	import score  # noqa: E402
    14	import agent_format as af  # noqa: E402
    15	
    16	ap = argparse.ArgumentParser()
    17	ap.add_argument("preds")
    18	ap.add_argument("--expect_n", type=int, required=True)
    19	ap.add_argument("--out", required=True)
    20	a = ap.parse_args()
    21	rows = [json.loads(l) for l in open(a.preds)]
    22	seen = {(r["episode_id"], r["step_idx"]) for r in rows}
    23	complete = len(seen) == a.expect_n == len(rows)
    24	m = score.score_rows(rows)
    25	f1 = [score._f1((af.parse_action(r["output"]) or {}).get("text") if (af.parse_action(r["output"]) or {}).get("action_type") == "answer" else "",
    26	                json.loads(r["gt_action"])["text"]) for r in rows if json.loads(r["gt_action"])["action_type"] == "answer"]
    27	m["answer_mean_f1"] = sum(f1) / len(f1) if f1 else None
    28	m["integrity"] = {"complete": complete, "n_rows": len(rows), "expected": a.expect_n, "model": rows[0].get("model") if rows else None}
    29	json.dump(m, open(a.out, "w"), indent=1)
    30	print(json.dumps({k: m[k] for k in ("n_steps", "parse_rate", "type_match", "step_sr", "answer_mean_f1")}))
    31	sys.exit(0 if complete else 1)

