   259	        state.store.add(s)
   260	
   261	    def on_sess_started(sid):
   262	        s.session_id = sid
   263	        state.store.add(s)
   264	
   265	    runtime = ColabRuntime(
   266	        s.url,
   267	        s.token,
   268	        kernel_id=s.kernel_id,
   269	        session_id=s.session_id,
   270	        on_kernel_started=on_started,
   271	        on_session_started=on_sess_started,
   272	    )
   273	
   274	    try:
   275	        runtime.restart()
   276	    finally:
   277	        runtime.stop()
