scripts/v4_gate.py
     1	"""v4 development gate (docs/PREREG_v4.md), computed from raw AndroidWorld episodes + offline dev metrics.
     2	
     3	Gate (all must hold to freeze v4 and run it on sealed held-out seeds):
     4	  (1) dev_answer: "clearly above 0" := strict typed answer match (v4_answer_check.same_answer) >= 0.20, and `answer`
     5	      emitted on >= 50% of rows;
     6	  (2) dev_complete: `answer` on <= 3% of action-goal final rows;
     7	  (3) AndroidWorld seed 30: >= 3 answer-task successes AND action-task successes >= v3's - 3.
     8	usage: python scripts/v4_gate.py --v4 results/androidworld/lfm3vl2b_v4 --v3 results/androidworld/lfm3vl2b_v3 \
     9	         --v4_agent lfm3vl2b_v4_q4km --dev_answer <lfm3_v4_dev_answer.jsonl> --dev_complete <lfm3_v4_dev_complete.jsonl>
    10	Input integrity: one run dir per arm, the same 116 tasks with identical goal text + instance seed as the v3 seed-30 run,
    11	agent_name checked; dev predictions must cover exactly the pinned dev splits (results/v4_dev_reference.json) from the
    12	expected model.
    13	"""
    14	import argparse
    15	import glob
    16	import gzip
    17	import json
    18	import math
    19	import os
    20	import pickle
    21	import re
    22	import sys
    23	
    24	sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "train"))
    25	import agent_format as af  # noqa: E402
    26	sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "data"))
    27	from v4_answer_check import same_answer  # noqa: E402
    28	
    29	p = argparse.ArgumentParser()
    30	p.add_argument("--v4", required=True)
    31	p.add_argument("--v3", default="results/androidworld/lfm3vl2b_v3")
    32	p.add_argument("--dev_answer", required=True, help="predictions jsonl of the v4 model on dev_answer")
    33	p.add_argument("--dev_complete", required=True, help="predictions jsonl of the v4 model on dev_complete")
    34	p.add_argument("--v4_agent", required=True, help="agent_name every v4 episode must carry (e.g. lfm3vl2b_v4_q4km)")
    35	p.add_argument("--v3_agent", default="lfm3vl2b_v3_q4km")
    36	p.add_argument("--dev_model", default="/content/runs/lfm3vl2b-v4bmix-lora/merged", help="`model` field of the dev predictions")
    37	p.add_argument("--dev_ref", default="results/v4_dev_reference.json",
    38	               help="(episode_id, step_idx, gt_action) of the v4 dataset's dev splits, read from the hub at the pinned sha")
    39	a = p.parse_args()
    40	REF = json.load(open(a.dev_ref))
    41	ANSWER_TASKS = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"])
    42	
    43	
    44	def aw(run_root, agent):
    45	    runs = glob.glob(os.path.join(run_root, "run_*"))
    46	    if len(runs) != 1:
    47	        raise SystemExit(f"GATE INPUT ERROR: {run_root} must contain exactly one run dir, found {len(runs)}")
    48	    out, ident = {}, {}
    49	    for f in glob.glob(os.path.join(runs[0], "*.pkl.gz")):
    50	        ep = pickle.load(gzip.open(f))  # trusted: written by our own local AndroidWorld runs
    51	        ep = ep[0] if isinstance(ep, list) else ep
    52	        r = ep.get("is_successful")
    53	        ok = isinstance(r, (int, float)) and not math.isnan(r) and r >= 1 and not ep.get("exception_info")
    54	        if ep.get("agent_name") != agent:
    55	            raise SystemExit(f"GATE INPUT ERROR: {f} agent_name {ep.get('agent_name')!r} != {agent!r}")
    56	        t = os.path.basename(f).rsplit("_", 1)[0]
    57	        if t in out or ep.get("task_template") != t:
    58	            raise SystemExit(f"GATE INPUT ERROR: duplicate or mislabelled episode {f}")
    59	        out[t] = ok
    60	        ident[t] = (re.sub(r"\d{8}_\d{6}", "<run timestamp>", ep.get("goal") or ""), ep.get("seed"))
    61	    return out, ident
    62	
    63	
    64	def preds(path, split):
    65	    rows = [json.loads(l) for l in open(path)]
    66	    want = sorted((str(e), int(i), g) for e, i, g in REF["splits"][split])
    67	    got = sorted((str(r["episode_id"]), int(r["step_idx"]), r["gt_action"]) for r in rows)
    68	    if got != want or len(set(got)) != len(got):
    69	        raise SystemExit(f"GATE INPUT ERROR: {path}: (episode_id, step_idx, gt_action) != {split} of {REF['repo']}@{REF['revision']}")
    70	    bad = [r for r in rows if r.get("model") != a.dev_model or r.get("split", split) != split]
    71	    if bad:
    72	        raise SystemExit(f"GATE INPUT ERROR: {path}: {len(bad)} rows from another model/split ({bad[0].get('model')})")
    73	    acts = [af.parse_action(r["output"], strict=True) for r in rows]  # same strict parser as the RL reward/metrics
    74	    return rows, acts
    75	
    76	
    77	(v4, id4), (v3, id3) = aw(a.v4, a.v4_agent), aw(a.v3, a.v3_agent)
    78	ALL_TASKS = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"]) | set(v3)
    79	if len(v4) != 116 or len(v3) != 116 or set(v4) != set(v3):
    80	    raise SystemExit(f"GATE INPUT ERROR: need the same 116 tasks in both runs (v4 {len(v4)}, v3 {len(v3)})")
    81	diff = sorted(t for t in v3 if id4[t][0] != id3[t][0]
    82	              or (id4[t][1] is not None and id3[t][1] is not None and id4[t][1] != id3[t][1]))
    83	if diff:  # same seed (30) => same task instance (goal text + instance seed) as the v3 run
    84	    raise SystemExit(f"GATE INPUT ERROR: {len(diff)} tasks differ in goal/seed from the v3 seed-30 run, e.g. {diff[:3]}")
    85	ans4 = sum(v for t, v in v4.items() if t in ANSWER_TASKS)
    86	act4 = sum(v for t, v in v4.items() if t not in ANSWER_TASKS)
    87	act3 = sum(v for t, v in v3.items() if t not in ANSWER_TASKS)
    88	rows, acts = preds(a.dev_answer, "dev_answer")
    89	emitted = sum(1 for x in acts if x and x["action_type"] == "answer") / max(1, len(acts))
    90	correct = sum(1 for r, x in zip(rows, acts) if x and x["action_type"] == "answer"
    91	              and same_answer(x["text"], json.loads(r["gt_action"])["text"])) / max(1, len(rows))
    92	rows_c, acts_c = preds(a.dev_complete, "dev_complete")
    93	false_ans = sum(1 for x in acts_c if x and x["action_type"] == "answer") / max(1, len(acts_c))
    94	complete = sum(1 for x in acts_c if x and x["action_type"] == "status" and x.get("goal_status") == "complete") / max(1, len(acts_c))
    95	g = {"aw_episodes_v4": len(v4), "aw_answer_task_successes_v4": ans4, "aw_action_task_successes_v4": act4,
    96	     "aw_action_task_successes_v3": act3, "dev_answer_emitted": round(emitted, 3), "dev_answer_exact": round(correct, 3),
    97	     "dev_complete_false_answer": round(false_ans, 3), "dev_complete_status": round(complete, 3)}
    98	g["gate"] = {"1_answers": emitted >= 0.5 and correct >= 0.20, "2_no_false_answers": false_ans <= 0.03,
    99	             "3_aw": len(v4) == 116 and ans4 >= 3 and act4 >= act3 - 3}
   100	g["PASS"] = all(g["gate"].values())
   101	print(json.dumps(g, indent=1))
   102	sys.exit(0 if g["PASS"] else 3)

scripts/vm_rl_hook.sh
     1	#!/bin/bash
     2	# Runs next to the v4 pipeline inside the same blocking cell. Lets a later-uploaded RL job start on this VM without
     3	# restarting the kernel (which would kill training): runs /content/work/rl_go.sh as soon as it is uploaded.
     4	# Exits without doing anything once the v4 pipeline has ended AND /content/work/rl_hold has been removed.
     5	cd /content/work
     6	while true; do
     7	  if [ -f /content/work/rl_go.sh ]; then echo "[$(date +%T)] rl_go.sh found; running"; bash /content/work/rl_go.sh; exit $?; fi
     8	  if grep -q "PIPELINE DONE\|PIPELINE FINISHED WITH FAILURES\|TRAINING FAILED" /content/runs/lfm3_v4_pipeline.log 2>/dev/null \
     9	     && [ ! -f /content/work/rl_hold ]; then echo "[$(date +%T)] pipeline ended and no hold; exiting"; exit 0; fi
    10	  sleep 30
    11	done

scripts/vm_rl_go.sh
     1	#!/bin/bash
     2	# RL pilot job (uploaded as /content/work/rl_go.sh; started by vm_rl_hook.sh next to the v4 pipeline, no kernel restart).
     3	#   1. smoke: 4 GRPO steps on the BASE model with the real pool -> code path, memory, s/step (no v4 needed yet)
     4	#   2. wait for the v4 pipeline to finish (merged weights + evals; avoids GPU contention / OOM)
     5	#   3. main GRPO from merged v4: steps = min(MAX_STEPS, budget / measured s/step)
     6	#   4. push merged + adapter, then offline evals on the v4 dev splits + AndroidControl test (v4 prompt)
     7	# Env set below by the launcher (sed): RL_DATA DEV_REPO DEV_REV
     8	set -uo pipefail
     9	export HF_TOKEN=$(cat /content/.hf_token) TOKENIZERS_PARALLELISM=false
    10	cd /content/work
    11	RL_DATA=__RL_DATA__; DEV_REPO=__DEV_REPO__; DEV_REV=__DEV_REV__; SKIP_SMOKE=${SKIP_SMOKE:-__SKIP_SMOKE__}
    12	MAX_STEPS=${MAX_STEPS:-200}; BUDGET_S=${BUDGET_S:-16200}   # 4.5 h for the main optimisation
    13	V4=/content/runs/__V4_RUN__/merged
    14	OUT=/content/runs/v4rl; FINAL=alpharomercoma/LFM3-VL-2B-AndroidAgent-v4-RL
    15	log() { echo "[$(date +%T)] rl: $*"; }
    16	FAILS=0; fail() { log "FAILED: $*"; FAILS=$((FAILS+1)); }
    17	if [ "${SKIP_SMOKE:-0}" = 1 ] && grep -q "RL DONE" /content/runs/rl_smoke.log 2>/dev/null; then
    18	  log "smoke already passed earlier on this VM; skipping"
    19	else
    20	  log "smoke on base model"
    21	  python grpo_vlm.py --model LiquidAI/LFM3-VL-2B --data $RL_DATA --out /content/runs/rl_smoke --smoke > /content/runs/rl_smoke.log 2>&1
    22	  grep -q "RL DONE" /content/runs/rl_smoke.log || { log "SMOKE FAILED"; tail -40 /content/runs/rl_smoke.log; exit 1; }
    23	fi
    24	SPS=$(python - <<'PY'
    25	import json
    26	L = [json.loads(l) for l in open("/content/runs/rl_smoke/rl_log.jsonl")]
    27	L = [x for x in L if x.get("step", 0) >= 1]
    28	print(round((L[-1]["elapsed_s"] - L[0]["elapsed_s"]) / max(1, L[-1]["step"] - L[0]["step"]), 1) if len(L) > 1 else 120)
    29	PY
    30	)
    31	log "smoke timing ${SPS} s/step (measured next to SFT; an upper bound)"
    32	log "waiting for the v4 pipeline to finish"
    33	until grep -q "PIPELINE DONE\|PIPELINE FINISHED WITH FAILURES" /content/runs/lfm3_v4_pipeline.log 2>/dev/null; do
    34	  grep -q "TRAINING FAILED" /content/runs/lfm3_v4_pipeline.log 2>/dev/null && { log "v4 training failed; no RL"; exit 1; }
    35	  sleep 60
    36	done
    37	[ -f $V4/config.json ] || { log "no merged v4 at $V4"; exit 1; }
    38	STEPS=$(python -c "print(max(10, min($MAX_STEPS, int($BUDGET_S / max(1.0, 1.15 * $SPS)))))")
    39	log "main GRPO from v4: $STEPS steps"
    40	python grpo_vlm.py --model $V4 --data $RL_DATA --out $OUT --max_steps $STEPS --hub_repo ${FINAL}-ckpt > /content/runs/v4rl_train.log 2>&1
    41	grep -q "RL DONE" /content/runs/v4rl_train.log || { log "RL TRAINING FAILED"; tail -40 /content/runs/v4rl_train.log; exit 1; }
    42	python - <<PY || fail "upload merged"
    43	from huggingface_hub import HfApi
    44	api = HfApi(); api.create_repo("$FINAL", private=True, exist_ok=True)
    45	api.upload_folder(folder_path="$OUT/merged", repo_id="$FINAL", commit_message="v4 + static GRPO (merged)")
    46	api.upload_folder(folder_path="$OUT/lora", path_in_repo="lora_adapter", repo_id="$FINAL")
    47	api.upload_file(path_or_fileobj="$OUT/rl_log.jsonl", path_in_repo="training_logs/rl_log.jsonl", repo_id="$FINAL")
    48	PY
    49	log "offline evals"
    50	for sp in dev_answer dev_complete dev_screenqa dev_odyssey dev_amex; do
    51	  N=$(python -c "from datasets import load_dataset; from huggingface_hub import HfApi; fs=HfApi().list_repo_files('$DEV_REPO', repo_type='dataset', revision='$DEV_REV'); print(len(load_dataset('$DEV_REPO', data_files={'$sp': [f for f in fs if f.startswith('data/$sp-')]}, split='$sp', revision='$DEV_REV')))")
    52	  python generate.py --model $OUT/merged --data "$DEV_REPO@$sp#$DEV_REV" --out /content/eval/lfm3_v4rl_$sp.jsonl --enable_thinking 1 \
    53	    --bs 32 --max_pixels 774400 --prompt_v4_pool /content/work/meta/app_pool.json \
    54	    && python score_dev.py /content/eval/lfm3_v4rl_$sp.jsonl --expect_n $N --out /content/eval/lfm3_v4rl_$sp.metrics.json || fail "dev $sp"
    55	done
    56	python generate.py --model $OUT/merged --data experimentalmachines/AndroidControl-screen-agent-sft@test --out /content/eval/lfm3vl2b-v4rl_ft.jsonl \
    57	  --enable_thinking 1 --bs 32 --max_pixels 774400 --prompt_v4_pool /content/work/meta/app_pool.json \
    58	  && python score.py /content/eval/lfm3vl2b-v4rl_ft.jsonl --gt /content/work/meta/androidcontrol_test_gt.jsonl \
    59	     --expect model=$OUT/merged,max_pixels=774400,enable_thinking=1 --out /content/eval/lfm3vl2b-v4rl_ft.metrics.json || fail "AC test"
    60	python strict_dev_metrics.py --answer /content/eval/lfm3_v4rl_dev_answer.jsonl --complete /content/eval/lfm3_v4rl_dev_complete.jsonl \
    61	  --out /content/eval/lfm3_v4rl_strict.json || fail "strict metrics"
    62	python strict_dev_metrics.py --answer /content/eval/lfm3_v4_dev_answer.jsonl --complete /content/eval/lfm3_v4_dev_complete.jsonl \
    63	  --out /content/eval/lfm3_v4_strict.json || fail "strict metrics v4"
    64	python - <<PY || fail "upload evals"
    65	import glob, os
    66	from huggingface_hub import HfApi
    67	api = HfApi()
    68	for f in glob.glob("/content/eval/lfm3*v4rl*") + glob.glob("/content/eval/lfm3_v4_strict.json"):
    69	    api.upload_file(path_or_fileobj=f, path_in_repo=f"eval/{os.path.basename(f)}", repo_id="$FINAL")
    70	PY
    71	if [ "$FAILS" = 0 ]; then log "RL PIPELINE DONE"; else log "RL PIPELINE FINISHED WITH $FAILS FAILURES"; exit 1; fi

