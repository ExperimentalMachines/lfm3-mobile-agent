scripts/v4_relaunch.sh
     1	#!/bin/bash
     2	# After a Colab VM loss: bootstrap an already-provisioned session, restore the v4 + RL files, and relaunch the v4 job
     3	# (SFT resumes from the hub checkpoint in CKPT_REPO; pipeline steps whose outputs exist are skipped).
     4	# Usage: bash scripts/v4_relaunch.sh <session>
     5	set -u; set -o pipefail
     6	S=$1
     7	cd "$(dirname "$0")/.."
     8	TMP=${TMPDIR:-/tmp}/v4_relaunch_$$; mkdir -p "$TMP"
     9	C() { ~/.local/bin/colab "$@" < /dev/null 2>&1 | grep -v "new version\|colab update\|silence"; }
    10	SFT_SHA=337553984ee970a767dceb21adc6343f3d613602
    11	RL_SHA=9ba36d90abe9bdbaa0c578879336472ab054cc2c
    12	echo "[$(date +%T)] bootstrap $S"
    13	bash scripts/gpu_session.sh "$S" 2>&1 | grep -E "NVIDIA|pip rc|versions|HF user|mismatch|failed|Error|dirs ok" | tail -8
    14	echo 'import os;os.makedirs("/content/work/meta",exist_ok=True);print("meta ok")' | ~/.local/bin/colab exec -s "$S" 2>/dev/null \
    15	  | grep -q "meta ok" || { echo "RELAUNCH FAILED: kernel unreachable"; exit 1; }
    16	up() { C upload -s "$S" "$1" "$2" | grep -q Uploaded || { echo "RELAUNCH FAILED: upload $1"; exit 1; }; }
    17	up data/v4work/app_pool.json /content/work/meta/app_pool.json
    18	for f in train/rl_reward.py train/grpo_vlm.py data/v4_answer_check.py scripts/vm_rl_hook.sh scripts/strict_dev_metrics.py; do
    19	  up "$f" "/content/work/$(basename "$f")"
    20	done
    21	if [ "${NO_RL:-0}" = 1 ]; then   # e.g. an interim L4: SFT only (no concurrent GRPO smoke on 24 GB); RL can be uploaded later
    22	  echo "[$(date +%T)] NO_RL=1: rl_go.sh / rl_hold not uploaded"
    23	else
    24	echo hold > "$TMP/rl_hold"; up "$TMP/rl_hold" /content/work/rl_hold
    25	sed -e "s#__RL_DATA__#alpharomercoma/AndroidAgent-RL-v4@$RL_SHA#" -e 's#__DEV_REPO__#alpharomercoma/AndroidAgent-SFT-v4#' \
    26	    -e "s#__DEV_REV__#$SFT_SHA#" -e 's#__V4_RUN__#lfm3vl2b-v4bmix-lora#' -e 's#__SKIP_SMOKE__#1#' scripts/vm_rl_go.sh > "$TMP/rl_go.sh"
