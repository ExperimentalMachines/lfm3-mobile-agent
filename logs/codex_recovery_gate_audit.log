scripts/colab_watchdog.sh
     1	#!/bin/bash
     2	# Local watchdog for the overnight Colab v4 (+RL) job. Every 120 s:
     3	#  (a) session gone (VM pruned) -> re-provision (G4 > A100 > H100 > L4 last) and relaunch with scripts/v4_relaunch.sh
     4	#      (SFT resumes from the hub checkpoint), at most MAX_RELAUNCH times;
     5	#  (b) no local client attached to the kernel -> attach a queued keepalive cell (2026-11-18: the VM was pruned ~20 min
     6	#      after the jobs cell's websocket dropped, while training was still running);
     7	#  (c) every job on the VM has exited -> download the run logs, wait GRACE_S (touch logs/.keep_vm_<session> to keep the
     8	#      VM), then stop it (an idle VM still burns compute units).
     9	# Usage: nohup bash scripts/colab_watchdog.sh lfm3v4 > logs/colab_watchdog_lfm3v4.log 2>&1 &
    10	set -u
    11	S=$1; MAX_RELAUNCH=${MAX_RELAUNCH:-3}; GRACE_S=${GRACE_S:-1200}; n=0
    12	cd "$(dirname "$0")/.."
    13	CB=$HOME/.local/bin/colab
    14	C() { "$CB" "$@" < /dev/null 2>&1 | grep -v "new version\|colab update\|silence"; }
    15	log() { echo "[$(date +%T)] $*"; }
    16	TMP=${TMPDIR:-/tmp}/colab_wd_$S; mkdir -p "$TMP"
    17	alive() { C sessions | grep -q "$S"; }
    18	log "watchdog start for $S (pid $$)"
    19	while true; do
    20	  if ! alive; then
    21	    sleep 30; alive && continue   # one transient API failure is not a loss
    22	    [ $n -ge "$MAX_RELAUNCH" ] && { log "VM LOST; relaunch limit ($MAX_RELAUNCH) reached"; exit 1; }
    23	    n=$((n+1)); log "VM LOST; re-provision + relaunch #$n"
    24	    if bash scripts/colab_get_gpu.sh "$S" 6 >> "logs/colab_get_gpu_${S}_wd.log" 2>&1; then
    25	      tail -1 "logs/colab_get_gpu_${S}_wd.log"
    26	      bash scripts/v4_relaunch.sh "$S" 2>&1 | tail -5
    27	    else
    28	      log "no GPU this round"; sleep 300
    29	    fi
    30	    continue
    31	  fi
    32	  rm -f "$TMP/st.json"
    33	  if C download -s "$S" /content/work/jobs_status.json "$TMP/st.json" > /dev/null 2>&1 && [ -s "$TMP/st.json" ] && \
    34	     python3 -c "import json,sys; s=json.load(open('$TMP/st.json'))['status']; sys.exit(0 if s and all(v!='running' for v in s.values()) else 1)"; then
    35	    log "all jobs exited: $(cat "$TMP/st.json")"
    36	    for f in /content/runs/lfm3_v4_pipeline.log /content/runs/rl_hook.log /content/runs/v4rl_train.log /content/runs/rl_smoke.log; do
    37	      C download -s "$S" "$f" "logs/vm_${S}_$(basename "$f")" > /dev/null
    38	    done
    39	    log "logs saved; stopping the VM in ${GRACE_S}s unless logs/.keep_vm_$S exists"
    40	    sleep "$GRACE_S"
    41	    if [ -f "logs/.keep_vm_$S" ]; then log "keep file present; not stopping"; exit 0; fi
    42	    C stop -s "$S" | tail -1; log "VM stopped"; exit 0
    43	  fi
    44	  if ! pgrep -f "[e]xec -s $S" > /dev/null; then
    45	    log "no client attached; attaching a queued keepalive cell"
    46	    echo "print('keepalive')" | nohup "$CB" exec -s "$S" --timeout 200000 >> "logs/colab_keepalive_$S.log" 2>&1 &
    47	  fi
    48	  sleep 120
    49	done

scripts/colab_poll_fast_gpu.sh
     1	#!/bin/bash
     2	# Keep asking for a fast GPU (G4, then A100; never L4) under session <name> until one is granted or MAX_H hours pass.
     3	# Usage: bash scripts/colab_poll_fast_gpu.sh <session> [max_hours]   -> "GOT <gpu>" exit 0 | "GAVE UP" exit 1
     4	S=$1; MAX_H=${2:-6}; END=$(( $(date +%s) + MAX_H*3600 ))
     5	C() { ~/.local/bin/colab "$@" < /dev/null 2>&1 | grep -v "new version\|colab update\|silence"; }
     6	while [ $(date +%s) -lt $END ]; do
     7	  for g in G4 A100; do
     8	    out=$(C new -s "$S" --gpu $g | tail -1)
     9	    if C sessions | grep -q "$S" ; then echo "[$(date +%T)] GOT $g"; C sessions | grep "$S"; exit 0; fi
    10	    echo "[$(date +%T)] $g: ${out:0:140}"
    11	    sleep 30
    12	  done
    13	done
    14	echo "[$(date +%T)] GAVE UP"; exit 1

scripts/launch_on_session.sh
     1	#!/bin/bash
     2	# Stop whatever runs in <session>'s kernel, then launch <jobs.json> there (fresh code), confirm heartbeat.
     3	# Usage: COLAB_BIN=... COLAB_CONFIG=... scripts/launch_on_session.sh <session> <jobs.json>
     4	set -u; set -o pipefail
     5	SESS=$1; NEXT=$2
     6	cd "$(dirname "$0")/.."
     7	CB=${COLAB_BIN:-$HOME/.local/bin/colab}
     8	C() { "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} "$@" < /dev/null 2> >(grep -v "new version\|colab update\|silence this" >&2); }
     9	C restart-kernel -s "$SESS" | tail -1
    10	# bracketed patterns so pkill -f cannot match (and kill) the very shell running these commands
    11	echo 'import subprocess,os;print(subprocess.run("pkill -f [s]ft_vlm.py; pkill -f [v]m_train_eval_push; pkill -f [v]m_model_pipeline; pkill -f [g]enerate.py; pkill -f [e]val_general.py; sleep 3; ps aux | grep -cE \"[s]ft_vlm|[g]enerate.py\"",shell=True,capture_output=True,text=True).stdout.strip(), "killed"); os.makedirs("/content/work/meta",exist_ok=True); print("meta", "ok" if os.path.isdir("/content/work/meta") else "MISSING")' \
    12	  | "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} exec -s "$SESS" 2>/dev/null | grep -q "meta ok" || { echo "kernel unreachable"; exit 1; }
    13	for f in train/sft_vlm.py train/agent_format.py train/qwen35_chat_template_gen.jinja eval/androidcontrol/generate.py \
    14	         eval/androidcontrol/score.py eval/androidcontrol/score_dev.py eval/general/eval_general.py data/build_general_replay.py scripts/vm_model_pipeline.sh scripts/vm_logprob_only.sh data/vm_v3_intents.py scripts/vm_v3_intents.sh \
    15	         scripts/vm_blocking_jobs.py data/meta/androidcontrol_test_gt.jsonl data/meta/androidcontrol_test_gt.manifest.json; do
    16	  dst="/content/work/$(basename "$f")"; [[ "$f" == data/meta/* ]] && dst="/content/work/meta/$(basename "$f")"
    17	  C upload -s "$SESS" "$f" "$dst" | grep -q Uploaded || { echo "upload failed: $f"; exit 1; }
    18	done
    19	C upload -s "$SESS" "$NEXT" /content/work/jobs.json | grep -q Uploaded || { echo "upload failed: jobs.json"; exit 1; }
    20	nohup "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} exec -s "$SESS" --timeout 200000 -f scripts/vm_blocking_jobs.py \
    21	  > "logs/${SESS}_jobs_cell_$(basename "$NEXT" .json).log" 2>&1 < /dev/null &
    22	PID=$!; sleep 90
    23	if grep -q heartbeat "logs/${SESS}_jobs_cell_$(basename "$NEXT" .json).log" && kill -0 $PID 2>/dev/null; then echo "[$(date +%T)] launched $NEXT on $SESS — heartbeat confirmed"
    24	else echo "LAUNCH NOT CONFIRMED"; exit 1; fi

scripts/gpu_session.sh
     1	#!/bin/bash
     2	# Local helper: push code to the GPU Colab session and bootstrap it.
     3	# Usage: scripts/gpu_session.sh <session_name>
     4	set -euo pipefail
     5	SESS=${1:-lfm3g4}
     6	cd "$(dirname "$0")/.."
     7	C() { "${COLAB_BIN:-$HOME/.local/bin/colab}" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} "$@" 2> >(grep -v "new version\|colab update\|silence this" >&2); }
     8	echo 'import os;[os.makedirs(d,exist_ok=True) for d in ("/content/work","/content/runs","/content/eval")];print("dirs ok")' | C exec -s "$SESS"
     9	for f in train/sft_vlm.py train/agent_format.py train/qwen35_chat_template_gen.jinja scripts/vm_train_eval_push.sh \
    10	         eval/androidcontrol/generate.py eval/androidcontrol/score.py eval/general/eval_general.py data/build_general_replay.py scripts/vm_450m_pipeline.sh scripts/vm_model_pipeline.sh \
    11	         scripts/vm_train.sh scripts/colab_bootstrap.py; do
    12	  [ -f "$f" ] || { echo "skip missing $f"; continue; }
    13	  C upload -s "$SESS" "$f" "/content/work/$(basename "$f")" | tail -1
    14	done
    15	C upload -s "$SESS" "${HF_TOKEN_FILE:-$HOME/.cache/huggingface/token}" /content/.hf_token | tail -1
    16	C exec -s "$SESS" --timeout 900 -f scripts/colab_bootstrap.py

scripts/colab_get_gpu.sh
     1	#!/bin/bash
     2	# Get a Colab GPU session, preference G4 > A100 > H100 > L4 (L4 only after the others failed for a whole round x ROUNDS).
     3	# Usage: bash scripts/colab_get_gpu.sh <session> [rounds]   -> prints "GOT <gpu>" and exits 0, or "NO GPU" exit 1
     4	S=$1; ROUNDS=${2:-6}
     5	C() { ~/.local/bin/colab "$@" < /dev/null 2>&1 | grep -v "new version\|colab update\|silence"; }
     6	have() { C sessions | grep -q "$S"; }
     7	have && { echo "GOT existing session $S"; exit 0; }
     8	for r in $(seq 1 $ROUNDS); do
     9	  for g in G4 A100 H100; do
    10	    out=$(C new -s "$S" --gpu $g | tail -1)
    11	    if have; then echo "[$(date +%T)] GOT $g"; exit 0; fi
    12	    echo "[$(date +%T)] round $r $g: ${out:0:120}"
    13	    sleep 20
    14	  done
    15	done
    16	echo "[$(date +%T)] G4/A100/H100 unavailable for $ROUNDS rounds; trying L4"
    17	C new -s "$S" --gpu L4 | tail -1
    18	have && { echo "[$(date +%T)] GOT L4"; exit 0; }
    19	echo "NO GPU"; exit 1

scripts/vm_blocking_jobs.py
     1	"""Run ON the Colab VM via `colab exec -f` (with a large --timeout).
     2	
     3	Colab only keeps a VM alive while its Jupyter kernel is busy, so long jobs must run
     4	INSIDE a kernel cell: this script launches the job scripts listed in
     5	/content/work/jobs.json as subprocesses (logs to files) and blocks until all exit,
     6	printing a heartbeat every 60 s. Monitor from outside with `colab download` of the logs.
     7	
     8	jobs.json: [{"name": "train", "script": "/content/work/vm_train.sh", "env": {...}, "log": "/content/runs/x.log"}, ...]
     9	"""
    10	import json
    11	import os
    12	import subprocess
    13	import time
    14	
    15	jobs = json.load(open("/content/work/jobs.json"))
    16	import uuid
    17	RUN_ID = uuid.uuid4().hex[:12]  # lets watchers tie an exit status to the run they saw start
    18	procs = []
    19	for j in jobs:
    20	    env = dict(os.environ, **{k: str(v) for k, v in j.get("env", {}).items()})
    21	    os.makedirs(os.path.dirname(j["log"]), exist_ok=True)
    22	    p = subprocess.Popen(["bash", j["script"]], cwd="/content/work", env=env,
    23	                         stdout=open(j["log"], "a"), stderr=subprocess.STDOUT)
    24	    procs.append((j["name"], p))
    25	    print(f"started {j['name']} pid={p.pid}", flush=True)
    26	    time.sleep(j.get("stagger_s", 0))
    27	
    28	t0 = time.time()
    29	while True:
    30	    alive = [(n, p) for n, p in procs if p.poll() is None]
    31	    status = {n: ("running" if p.poll() is None else f"exit {p.returncode}") for n, p in procs}
    32	    with open("/content/work/jobs_status.json", "w") as f:
    33	        json.dump({"run_id": RUN_ID, "elapsed_s": round(time.time() - t0), "status": status}, f)
    34	    print(f"[heartbeat {time.strftime('%H:%M:%S')}] {status}", flush=True)
    35	    if not alive:
    36	        break
    37	    for _ in range(6):
    38	        time.sleep(10)
    39	        print(".", end="", flush=True)  # keep the exec websocket busy (idle drops seen ~30-40s)
    40	failed = [n for n, p in procs if p.returncode != 0]
    41	print("ALL JOBS FINISHED", "FAILED: " + ",".join(failed) if failed else "OK", flush=True)
    42	if failed:
    43	    raise SystemExit(1)

