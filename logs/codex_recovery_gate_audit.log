   307	def _print_status_for(s: SessionState) -> None:
   308	    """Print one session's status line plus optional last-execution detail."""
   309	    status = f"BUSY ({s.running})" if s.running else "IDLE"
   310	    typer.echo(
   311	        _format_session_line(
   312	            name=s.name,
   313	            endpoint=s.endpoint,
   314	            accelerator=s.accelerator,
   315	            variant=s.variant,
   316	            status=status,
   317	            machine_shape=s.machine_shape,
   318	        )
   319	    )
   320	    if s.last_execution:
   321	        exec_file, exec_cell, exec_time = s.last_execution
   322	        cell_str = f" | Cell: {exec_cell}" if exec_cell else ""
   323	        typer.echo(f"  Last Execution: {exec_file}{cell_str} at {exec_time}")
   324	
   325	
   326	def status(
   327	    session: Annotated[
   328	        Optional[str], typer.Option("-s", "--session", help="Session name")
   329	    ] = None,
   330	):
   331	    """Show session status"""
   332	    from colab_cli.common import state
   333	
   334	    local_sessions, _ = state.sync_sessions()
   335	    if session:
   336	        s = state.store.get(session)
   337	        if s:
   338	            _print_status_for(s)
   339	        else:
   340	            typer.echo(f"[colab] Session '{session}' not found.")
   341	        return
   342	
   343	    if not local_sessions:
   344	        typer.echo("[colab] No active sessions.")
   345	        return
   346	    for s in local_sessions.values():
   347	        _print_status_for(s)
