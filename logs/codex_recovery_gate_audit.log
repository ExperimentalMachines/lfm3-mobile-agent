+tree = ast.parse((ROOT / "eval/androidcontrol/generate.py").read_text())
+fn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "_fingerprint")
+ns = dict(os=os, _glob=glob, hashlib=hashlib)
+exec(compile(ast.Module(body=[fn], type_ignores=[]), "eval/androidcontrol/generate.py", "exec"), ns)
+fingerprints = []
+for label, wall_s in (("original", 5000), ("restored", 60)):
+    run = OUT / label
+    (run / "merged").mkdir(parents=True)
+    (run / "merged/model.safetensors").write_bytes(b"identical-weights")
+    (run / "train_receipt.json").write_text(json.dumps({"global_step": 1250, "summary": {"wall_s": wall_s}}))
+    fingerprints.append(ns["_fingerprint"](str(run / "merged")))
+result["same_weights_different_receipt_timing"] = {"fingerprints": fingerprints, "different": fingerprints[0] != fingerprints[1]}
+
+# The actual RL train() call is unconditional and has no resume kwargs.
+tree = ast.parse((ROOT / "train/grpo_vlm.py").read_text())
+node = next(n for n in tree.body if isinstance(n, ast.Expr) and isinstance(n.value, ast.Call)
+            and isinstance(n.value.func, ast.Attribute) and n.value.func.attr == "train")
+calls = []
+class Trainer:
+    def train(self, *args, **kwargs):
+        calls.append({"args": args, "kwargs": kwargs})
+exec(compile(ast.Module(body=[node], type_ignores=[]), "train/grpo_vlm.py", "exec"), {"trainer": Trainer()})
+result["rl_train_call"] = calls
+
+shells = ["v4_relaunch.sh", "colab_watchdog.sh", "colab_poll_fast_gpu.sh", "launch_on_session.sh", "gpu_session.sh",
+          "colab_get_gpu.sh", "vm_model_pipeline.sh", "vm_rl_hook.sh", "vm_rl_go.sh"]
+result["bash_version"] = subprocess.run(["/bin/bash", "--version"], capture_output=True, text=True).stdout.splitlines()[0]
+result["bash_syntax_returncodes"] = {s: subprocess.run(["/bin/bash", "-n", str(ROOT / "scripts" / s)],
+                                                      capture_output=True).returncode for s in shells}
+(OUT / "summary.json").write_text(json.dumps(result, indent=2))
+print(json.dumps({"scratch": str(OUT), "results": result}, indent=2))
diff --git a/results/codex/recovery_gate_audit/audit_gate.py b/results/codex/recovery_gate_audit/audit_gate.py
new file mode 100644
index 0000000000000000000000000000000000000000..715c5d2e0a875e36b12dbfb605215b8625a99dc1
--- /dev/null
+++ b/results/codex/recovery_gate_audit/audit_gate.py
@@ -0,0 +1,150 @@
+"""Read real development runs; write adversarial fixtures only inside this directory.
+
+Run: PYTHONDONTWRITEBYTECODE=1 python3 results/codex/recovery_gate_audit/audit_gate.py
+Synthetic offline predictions are oracle controls, NOT evidence of model quality.
+No sealed runs, services, emulators, or processes are touched.
+"""
+import ast
+import collections
+import copy
+import glob
+import gzip
+import json
+import math
+import os
+from pathlib import Path
+import pickle
+import re
+import subprocess
+import sys
+import tempfile
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = Path(__file__).resolve().parent
+OUT = Path(tempfile.mkdtemp(prefix="gate_", dir=BASE))
+REF = json.loads((ROOT / "results/v4_dev_reference.json").read_text())
+MODEL = "/content/runs/lfm3vl2b-v4bmix-lora/merged"
+ENV = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
+RESULTS = {}
+
+def predictions(label, transform=lambda x: x):
+    paths = []
+    for split in ("dev_answer", "dev_complete"):
+        rows = [dict(episode_id=e, step_idx=i, gt_action=g, output=g, model=MODEL,
+                     split=split) for e, i, g in REF["splits"][split]]
+        path = OUT / (label + "_" + split + ".jsonl")
+        path.write_text("".join(json.dumps(transform(r)) + "\n" for r in rows))
+        paths.append(path)
+    return paths
+
+oracle = predictions("oracle")
+
+def gate(label, root, agent, preds=oracle, v3=None, ref=None):
+    cmd = [sys.executable, "-B", str(ROOT / "scripts/v4_gate.py"), "--v4", str(root),
+           "--v4_agent", agent, "--v3", str(v3 or ROOT / "results/androidworld/lfm3vl2b_v3"),
+           "--dev_answer", str(preds[0]), "--dev_complete", str(preds[1])]
+    if ref is not None:
+        cmd += ["--dev_ref", str(ref)]
+    p = subprocess.run(cmd, cwd=ROOT, env=ENV, text=True, capture_output=True)
+    result = {"returncode": p.returncode, "stdout": p.stdout, "stderr": p.stderr}
+    (OUT / (label + ".json")).write_text(json.dumps(result, indent=2))
+    RESULTS[label] = result
+    return result
+
+def episodes(root):
+    out = {}
+    for f in sorted(root.glob("run_*/*.pkl.gz")):
+        with gzip.open(f, "rb") as stream:
+            e = pickle.load(stream)
+        e = e[0] if isinstance(e, list) else e
+        out[e["task_template"]] = e
+    return out
+
+reference = episodes(ROOT / "results/androidworld/lfm3vl2b_v3")
+real = []
+for arm in sorted((ROOT / "results/androidworld").iterdir()):
+    if not arm.is_dir() or arm.name.startswith("_"):
+        continue
+    es = episodes(arm)
+    if not es:
+        continue
+    agents = set(e["agent_name"] for e in es.values())
+    assert len(agents) == 1
+    r = gate("real_" + arm.name, arm, next(iter(agents)))
+    real.append({"arm": arm.name, "episodes": len(es), "returncode": r["returncode"],
+                 "exception_episodes": sum(bool(e.get("exception_info")) for e in es.values()),
+                 "seed_none": sum(e.get("seed") is None for e in es.values()),
+                 "half_credit": sum(isinstance(e.get("is_successful"), (float, int))
+                                    and 0 < e["is_successful"] < 1 for e in es.values()),
+                 "result": json.loads(r["stdout"]) if r["stdout"].startswith("{") else r["stderr"].strip()})
+
+def fabricated(label, transform=lambda e: e, omit=None, duplicate=False, v3=False):
+    parent = OUT / label
+    run = parent / "run_synthetic"
+    run.mkdir(parents=True)
+    for t, original in reference.items():
+        if t == omit:
+            continue
+        e = {"task_template": t, "goal": original["goal"], "seed": original.get("seed"),
+             "agent_name": "lfm3vl2b_v3_q4km" if v3 else "lfm3vl2b_v4_q4km",
+             "is_successful": 0.0 if v3 else 1.0, "exception_info": None,
+             "episode_data": [], "episode_length": 0, "instance_id": 999}
+        value = transform(e)
+        with gzip.open(run / (t + "_0.pkl.gz"), "wb") as stream:
+            pickle.dump(value, stream)
+    if duplicate:
+        t = next(iter(reference))
+        (run / (t + "_1.pkl.gz")).write_bytes((run / (t + "_0.pkl.gz")).read_bytes())
+    return parent
+
+fake = fabricated("fake_successes")
+gate("fabricated_empty_episodes", fake, "lfm3vl2b_v4_q4km")
+gate("wrong_agent_rejected", fake, "another_model")
+gate("missing_episode_rejected", fabricated("missing", omit=next(iter(reference))), "lfm3vl2b_v4_q4km")
+gate("duplicate_files_rejected", fabricated("duplicate", duplicate=True), "lfm3vl2b_v4_q4km")
+gate("extra_episodes_inside_pickle_ignored", fabricated("multi", lambda e: [e, dict(e, is_successful=0)]), "lfm3vl2b_v4_q4km")
+gate("missing_seed_accepted", fabricated("seed_none", lambda e: dict(e, seed=None)), "lfm3vl2b_v4_q4km")
+gate("wrong_nonnull_seed_rejected", fabricated("seed_wrong", lambda e: dict(e, seed=7)), "lfm3vl2b_v4_q4km")
+wrong4 = fabricated("wrong_pair_v4", lambda e: dict(e, seed=7, goal="wrong seed goal for " + e["task_template"]))
+wrong3 = fabricated("wrong_pair_v3", lambda e: dict(e, seed=7, goal="wrong seed goal for " + e["task_template"]), v3=True)
+gate("both_arms_wrong_seed_accepted", wrong4, "lfm3vl2b_v4_q4km", v3=wrong3)
+forged_preds = predictions("wrong_provenance", lambda r: dict(r, data="other/repo@train#badrevision",
+                            revision="badrevision", config_hash="wrong", model_fingerprint="wrong-model"))
+for path in forged_preds:
+    Path(str(path) + ".manifest.json").write_text(json.dumps({"model": "wrong-model", "data": "wrong-revision"}))
+gate("wrong_manifest_revision_and_fingerprint_ignored", fake, "lfm3vl2b_v4_q4km", preds=forged_preds)
+wrong_model = predictions("wrong_model", lambda r: dict(r, model="LiquidAI/LFM3-VL-2B"))
+gate("wrong_model_label_rejected", fake, "lfm3vl2b_v4_q4km", preds=wrong_model)
+partial = [OUT / "partial_answer.jsonl", oracle[1]]
+partial[0].write_text("\n".join(oracle[0].read_text().splitlines()[:-1]) + "\n")
+gate("partial_predictions_rejected", fake, "lfm3vl2b_v4_q4km", preds=partial)
+tiny_ref = OUT / "tiny_reference.json"
+tiny_ref.write_text(json.dumps(dict(repo="unrelated/repo", revision="not-pinned",
+                                   splits={k: v[:1] for k, v in REF["splits"].items()})))
+tiny_preds = []
+for path in oracle:
+    p = OUT / ("tiny_" + path.name)
+    p.write_text(path.read_text().splitlines()[0] + "\n")
+    tiny_preds.append(p)
+gate("custom_reference_one_row_accepted", fake, "lfm3vl2b_v4_q4km", preds=tiny_preds, ref=tiny_ref)
+
+# Execute the actual aw() definition to confirm the preregistered scoring edge cases.
+tree = ast.parse((ROOT / "scripts/v4_gate.py").read_text())
+fn = next(x for x in tree.body if isinstance(x, ast.FunctionDef) and x.name == "aw")
+ns = dict(glob=glob, os=os, pickle=pickle, gzip=gzip, math=math, re=re)
+exec(compile(ast.Module(body=[fn], type_ignores=[]), "scripts/v4_gate.py", "exec"), ns)
+edges = {}
+for label, update in [("half_credit", {"is_successful": .5}),
+                      ("exception", {"exception_info": "real failure"}),
+                      ("infinity", {"is_successful": float("inf")})]:
+    arm = fabricated("edge_" + label, lambda e, u=update: dict(e, **u))
+    scores, _ = ns["aw"](str(arm), "lfm3vl2b_v4_q4km")
+    edges[label] = sum(scores.values())
+
+summary = {"real_runs_with_synthetic_oracle_dev_predictions": real,
+           "adversarial_returncodes": {k: v["returncode"] for k, v in RESULTS.items() if not k.startswith("real_")},
+           "edge_success_counts": edges, "v4_run_exists": (ROOT / "results/androidworld/lfm3vl2b_v4").exists(),
+           "scratch": str(OUT)}
+(OUT / "summary.json").write_text(json.dumps(summary, indent=2))
+print(json.dumps(summary, indent=2))
diff --git a/results/codex/recovery_gate_audit/audit_recovery.py b/results/codex/recovery_gate_audit/audit_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..520ca52430cfcb1fc295305d26c95adc4834ed99
--- /dev/null
+++ b/results/codex/recovery_gate_audit/audit_recovery.py
@@ -0,0 +1,195 @@
+"""Run copied recovery shells under macOS /bin/bash with a wholly fake Colab.
+
+Run: PYTHONDONTWRITEBYTECODE=1 python3 results/codex/recovery_gate_audit/audit_recovery.py
+Every filesystem write stays under a new directory beside this script. No real
+Colab command, process signal, emulator, network, or model execution is used.
+Watchdog loops are bounded to three observations; waits are stubbed. Paths and
+external actions are replaced in scratch copies only, not repository sources.
+"""
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = Path(__file__).resolve().parent
+OUT = Path(tempfile.mkdtemp(prefix="recovery_", dir=BASE))
+RESULTS = {}
+
+STUB = r'''
+import json, os, pathlib, re, shutil, sys
+case = pathlib.Path(os.environ["AUDIT_CASE"])
+mode = os.environ["AUDIT_MODE"]
+tool = pathlib.Path(sys.argv[0]).name
+args = sys.argv[1:]
+with (case / "calls.jsonl").open("a") as stream:
+    stream.write(json.dumps([tool, args]) + "\n")
+if tool == "sleep":
+    if mode == "status_changes_during_grace" and args == ["7"]:
+        (case / "new_job_running").write_text("yes")
+    raise SystemExit(0)
+if tool == "pgrep":
+    commands = "colab exec -s lfm3v4a --timeout 200000" if mode == "prefix_alias" else ""
+    match = bool(re.search(args[-1], commands))
+    if match:
+        print("12345")
+    raise SystemExit(0 if match else 1)
+cmd = args[0]
+session = args[args.index("-s") + 1] if "-s" in args else ""
+if cmd == "new":
+    f = case / "allocations.json"
+    allocations = json.loads(f.read_text()) if f.exists() else []
+    allocations.append(session)
+    f.write_text(json.dumps(allocations))
+    print("[colab] Session READY.")
+elif cmd == "sessions":
+    if mode == "prefix_alias":
+        print("[lfm3v4a] endpoint-a | Hardware: A100 | Variant: GPU")
+    elif mode in ("relaunch_failed", "intentional_stop") and not (case / "allocations.json").exists():
+        print("[colab] No active sessions found on server.")
+    elif mode == "poll" and not (case / "allocations.json").exists():
+        print("[colab] No active sessions found on server.")
+    elif mode == "poll":
+        print("[lfm3v4a] new-endpoint | Hardware: G4 | Variant: GPU")
+    else:
+        print("[lfm3v4] endpoint-l | Hardware: L4 | Variant: GPU")
+elif cmd == "download":
+    remote, dst = args[-2:]
+    if remote.endswith("jobs_status.json"):
+        if mode in ("prefix_alias", "missing_status", "relaunch_failed"):
+            print("not found"); raise SystemExit(1)
+        status = {"lfm3_v4": "exit 1" if mode == "failed_jobs" else "exit 0", "rl_hook": "exit 0"}
+        if mode == "intentional_stop":
+            status = {"lfm3_v4": "running", "rl_hook": "running"}
+        pathlib.Path(dst).write_text(json.dumps({"run_id": "old-run", "status": status}))
+        print("Downloaded")
+    else:
+        print("download failed"); raise SystemExit(1)
+elif cmd == "stop":
+    if mode == "stop_fails":
+        print("Service Unavailable"); raise SystemExit(1)
+    (case / "stopped").write_text("new-job-running" if (case / "new_job_running").exists() else "old-job")
+    print("Stopped")
+elif cmd == "upload":
+    src, remote = args[-2:]
+    dst = case / "remote" / session / remote.lstrip("/")
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(src, dst)
+    print("Uploaded")
+elif cmd == "exec":
+    sys.stdin.read()  # Never execute the supplied code.
+    print("meta ok")
+else:
+    raise SystemExit("unexpected stub command: " + repr(args))
+'''
+
+def write(path, text, executable=False):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text)
+    if executable:
+        path.chmod(0o700)
+
+def setup(name, mode):
+    case = OUT / name
+    for d in ("scripts/jobs", "logs", "tmp", "bin"):
+        (case / d).mkdir(parents=True, exist_ok=True)
+    for name in ("colab", "sleep", "pgrep"):
+        write(case / "bin" / name, "#!" + sys.executable + "\n" + STUB, True)
+    (case / "bin/python").symlink_to(sys.executable)
+    write(case / "bin/nohup", '#!/bin/bash\nexec "$@"\n', True)
+    for name in ("colab_watchdog.sh", "colab_get_gpu.sh", "colab_poll_fast_gpu.sh", "v4_relaunch.sh"):
+        source = (ROOT / "scripts" / name).read_text()
+        source = source.replace("~/.local/bin/colab", shlex.quote(str(case / "bin/colab")))
+        source = source.replace("$HOME/.local/bin/colab", str(case / "bin/colab"))
+        source = source.replace("${TMPDIR:-/tmp}", str(case / "tmp"))
+        if name == "colab_watchdog.sh":
+            source = source.replace("while true; do", "for AUDIT_TICK in 1 2 3; do", 1) + "\nwait\n"
+        write(case / "scripts" / name, source)
+    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", AUDIT_CASE=str(case), AUDIT_MODE=mode,
+               PATH=str(case / "bin") + os.pathsep + os.environ["PATH"], GRACE_S="7")
+    return case, env
+
+def run(case, env, script, *args):
+    p = subprocess.run(["/bin/bash", str(case / "scripts" / script), *args], cwd=case, env=env,
+                       text=True, capture_output=True)
+    calls = [json.loads(s) for s in (case / "calls.jsonl").read_text().splitlines()] if (case / "calls.jsonl").exists() else []
+    return dict(returncode=p.returncode, stdout=p.stdout, stderr=p.stderr, calls=calls,
+                stopped=(case / "stopped").read_text() if (case / "stopped").exists() else False)
+
+for mode in ("failed_jobs", "status_changes_during_grace", "stop_fails", "prefix_alias", "missing_status",
+             "relaunch_failed", "intentional_stop"):
+    case, env = setup(mode, mode)
+    write(case / "scripts/v4_relaunch.sh", '#!/bin/bash\necho "STUB relaunched $1"\nexit ' + ("1" if mode == "relaunch_failed" else "0") + "\n")
+    RESULTS[mode] = run(case, env, "colab_watchdog.sh", "lfm3v4")
+
+case, env = setup("get_gpu_prefix", "prefix_alias")
+RESULTS["get_gpu_prefix"] = run(case, env, "colab_get_gpu.sh", "lfm3v4", "1")
+case, env = setup("poll_idle_and_repeated_allocation", "poll")
+RESULTS["poll_allocated_idle"] = run(case, env, "colab_poll_fast_gpu.sh", "lfm3v4a", "1")
+RESULTS["poll_existing_session_again"] = run(case, env, "colab_poll_fast_gpu.sh", "lfm3v4a", "1")
+RESULTS["poll_existing_session_again"]["allocation_count"] = len(json.loads((case / "allocations.json").read_text()))
+
+case, env = setup("dual_relaunch", "relaunch")
+for name in ("train/rl_reward.py", "train/grpo_vlm.py", "data/v4_answer_check.py", "scripts/vm_rl_hook.sh",
+             "scripts/strict_dev_metrics.py", "scripts/vm_rl_go.sh", "scripts/make_v4_train_job.py", "data/v4work/app_pool.json"):
+    write(case / name, (ROOT / name).read_text())
+write(case / "scripts/gpu_session.sh", '#!/bin/bash\necho "dirs ok"\n')
+write(case / "scripts/launch_on_session.sh", '''#!/bin/bash
+python3 - "$1" "$2" <<'PY'
+import json,sys
+with open("launches.jsonl", "a") as f:
+    f.write(json.dumps({"session":sys.argv[1],"jobs":json.load(open(sys.argv[2]))})+"\\n")
+print("heartbeat confirmed (stub only)")
+PY
+''')
+RESULTS["l4_relaunch"] = run(case, dict(env, NO_RL="1"), "v4_relaunch.sh", "lfm3v4")
+RESULTS["a100_relaunch"] = run(case, dict(env, NO_RL="0"), "v4_relaunch.sh", "lfm3v4a")
+launches = [json.loads(l) for l in (case / "launches.jsonl").read_text().splitlines()]
+RESULTS["dual_writers"] = [{"session": x["session"], "ckpt_repo": x["jobs"][0]["env"]["CKPT_REPO"],
+                            "run": x["jobs"][0]["env"]["RUN"]} for x in launches]
+RESULTS["no_rl_on_existing_vm"] = run(case, dict(env, NO_RL="1"), "v4_relaunch.sh", "lfm3v4a")
+RESULTS["no_rl_on_existing_vm"]["rl_go_still_exists"] = (case / "remote/lfm3v4a/content/work/rl_go.sh").exists()
+RESULTS["no_rl_on_existing_vm"]["rl_hold_still_exists"] = (case / "remote/lfm3v4a/content/work/rl_hold").exists()
+
+# Hook/run tests remap /content to isolated files and replace only sleeps with a
+# normal exit at the first wait. This exposes wait branches without killing jobs.
+for mode in ("no_rl_pipeline_finished", "stale_done_log", "no_terminal_marker", "hold_without_go", "fresh_skip_smoke"):
+    case = OUT / mode
+    content = case / "content"
+    (content / "work").mkdir(parents=True)
+    (content / "runs").mkdir()
+    (case / "bin").mkdir()
+    (content / ".hf_token").write_text("audit-dummy-not-a-credential")
+    log = content / "runs/lfm3_v4_pipeline.log"
+    log.write_text("old PIPELINE DONE\nnew train starting\n" if mode == "stale_done_log" else
+                   "PIPELINE DONE\n" if mode in ("no_rl_pipeline_finished", "hold_without_go") else "train starting\n")
+    if mode == "hold_without_go":
+        (content / "work/rl_hold").write_text("hold")
+    source = (ROOT / "scripts" / ("vm_rl_go.sh" if mode == "fresh_skip_smoke" else "vm_rl_hook.sh")).read_text()
+    source = source.replace("/content", str(content))
+    if mode == "fresh_skip_smoke":
+        source = source.replace("__SKIP_SMOKE__", "1").replace("__RL_DATA__", "dummy/rl@revision")
+        source = source.replace("__DEV_REPO__", "dummy/dev").replace("__DEV_REV__", "revision").replace("__V4_RUN__", "v4")
+        # Stop the scratch copy normally on its first SFT wait; do not run GRPO.
+        source = source.replace("sleep 60", "echo AUDIT_WAIT_FOR_PIPELINE; exit 91")
+        write(case / "bin/python", '#!/bin/bash\nif [ "$1" = grpo_vlm.py ]; then echo "AUDIT_SMOKE_WHILE_SFT_RUNNING"; echo "RL DONE"; else cat >/dev/null; echo 120; fi\n', True)
+    else:
+        source = source.replace("sleep 30", "echo AUDIT_STILL_WAITING; exit 91")
+    script = case / "check.sh"
+    write(script, source)
+    p = subprocess.run(["/bin/bash", str(script)], cwd=case,
+                       env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1", PATH=str(case / "bin") + os.pathsep + os.environ["PATH"]),
+                       text=True, capture_output=True)
+    RESULTS[mode] = dict(returncode=p.returncode, stdout=p.stdout, stderr=p.stderr)
+    if mode == "fresh_skip_smoke":
+        RESULTS[mode]["smoke_log"] = (content / "runs/rl_smoke.log").read_text()
+
+(OUT / "summary.json").write_text(json.dumps(RESULTS, indent=2))
+print(json.dumps({"scratch": str(OUT), "summary": {k: {a: b for a, b in v.items() if a != "calls"}
+                  if isinstance(v, dict) else v for k, v in RESULTS.items()}}, indent=2))
diff --git a/results/codex/recovery_gate_audit/audit_resume.py b/results/codex/recovery_gate_audit/audit_resume.py
new file mode 100644
index 0000000000000000000000000000000000000000..06532067d057a1446a28bc446ded93cfbfaf14bd
--- /dev/null
