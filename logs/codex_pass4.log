"""Offline step-level generation on a held-out split (runs on the Colab GPU).

Reads an eval dataset built by data/build_sft_data.py (columns: images, messages,
episode_id, step_idx, gt_action, gt_bbox, split_tag, ...), re-renders the prompt from
messages[:-1] (system+user), generates with HF transformers, and writes one JSONL row
per step with the RAW model output. Scoring happens separately in score.py.
"""

import argparse
import json
import os
import time

import torch
from datasets import load_dataset, load_from_disk
from transformers import AutoModelForImageTextToText, AutoProcessor

p = argparse.ArgumentParser()
p.add_argument("--model", required=True)
p.add_argument("--data", required=True)
p.add_argument("--out", required=True)
p.add_argument("--limit", type=int, default=0)
p.add_argument("--bs", type=int, default=32)
p.add_argument("--max_new_tokens", type=int, default=256)
p.add_argument("--enable_thinking", type=int, default=1)
p.add_argument("--max_pixels", type=int, default=880 * 880)
p.add_argument("--min_pixels", type=int, default=256 * 256)
p.add_argument("--filter_mode", default=None, help="only rows with this mode (high/low)")
p.add_argument("--subsample_episodes", type=int, default=0, help="deterministic episode subsample")
args = p.parse_args()

if os.path.isdir(args.data):
    ds = load_from_disk(args.data)
else:
    _repo, _, _split = args.data.partition("@")
    _split = _split or "test"
    ds = load_dataset(_repo, data_files={_split: f"data/{_split}/*.parquet"}, split=_split)
if args.filter_mode:
    ds = ds.filter(lambda m: m == args.filter_mode, input_columns="mode")
if args.subsample_episodes:
    import random as _r
    eps = sorted(set(ds["episode_id"]))
    keep = set(_r.Random(0).sample(eps, min(args.subsample_episodes, len(eps))))
    ds = ds.filter(lambda e: e in keep, input_columns="episode_id")
if args.limit:
    ds = ds.select(range(min(args.limit, len(ds))))
_pk = {"size": {"shortest_edge": args.min_pixels, "longest_edge": args.max_pixels}} if args.max_pixels > 0 else {}
processor = AutoProcessor.from_pretrained(args.model, trust_remote_code=True, **_pk)
processor.tokenizer.padding_side = "left"
model = AutoModelForImageTextToText.from_pretrained(
    args.model, dtype=torch.bfloat16, trust_remote_code=True).to("cuda").eval()

manifest = {"model": args.model, "data": args.data, "n_rows": len(ds), "enable_thinking": args.enable_thinking,
            "max_pixels": args.max_pixels, "filter_mode": args.filter_mode, "subsample_episodes": args.subsample_episodes,
            "limit": args.limit, "max_new_tokens": args.max_new_tokens, "do_sample": False, "min_pixels": args.min_pixels}
import hashlib
cfg_hash = hashlib.sha256(json.dumps(manifest, sort_keys=True).encode()).hexdigest()[:16]
manifest["config_hash"] = cfg_hash
mpath = args.out + ".manifest.json"
push_repo = os.environ.get("EVAL_PUSH_REPO")
if push_repo and not os.path.exists(args.out) and not os.path.exists(mpath):
    # VM was lost? restore the prediction/manifest PAIR from one hub revision; never one without the other
    try:
        from huggingface_hub import HfApi, hf_hub_download
        rev = HfApi().repo_info(push_repo).sha
        stage = "/tmp/_restore"
        got = [hf_hub_download(push_repo, f"eval/{os.path.basename(f)}", revision=rev, local_dir=stage) for f in (mpath, args.out)]
        if json.load(open(got[0])) == manifest:
            os.replace(got[0], mpath)
            os.replace(got[1], args.out)
            print(f"restored partial predictions from hub @ {rev[:8]}", flush=True)
        else:
            print("hub partial has a different manifest; starting fresh", flush=True)
    except Exception as e:
        print("no complete hub partial to restore:", type(e).__name__, flush=True)
if os.path.exists(args.out) and not os.path.exists(mpath):
    raise SystemExit(f"refusing to reuse {args.out}: predictions exist without a manifest (unknown identity)")
if os.path.exists(mpath):
    old_m = json.load(open(mpath))
    if old_m != manifest:
        raise SystemExit(f"refusing to resume {args.out}: manifest differs\nold={old_m}\nnew={manifest}")
else:
    json.dump(manifest, open(mpath, "w"), indent=1)


def _push_partial():
    if not push_repo:
        return
    try:
        from huggingface_hub import HfApi
        api = HfApi()
        for f in (args.out, mpath):
            api.upload_file(path_or_fileobj=f, path_in_repo=f"eval/{os.path.basename(f)}", repo_id=push_repo)
    except Exception as e:
        print("partial push failed:", e, flush=True)


done = set()
if os.path.exists(args.out):
    for line in open(args.out):
        r = json.loads(line)
        if r.get("config_hash") != cfg_hash:
            raise SystemExit(f"refusing to resume {args.out}: row config_hash {r.get('config_hash')} != {cfg_hash}")
        done.add((r["episode_id"], r["step_idx"], r.get("mode", "high")))
fout = open(args.out, "a")


def to_mm(messages, image):
    sys_m, user_m = messages[0], messages[1]
    return [
        {"role": "system", "content": [{"type": "text", "text": sys_m["content"]}]},
        {"role": "user", "content": [{"type": "image", "image": image}, {"type": "text", "text": user_m["content"]}]},
    ]


_e, _s, _m = ds["episode_id"], ds["step_idx"], ds["mode"]
idx = [i for i in range(len(ds)) if (_e[i], _s[i], _m[i]) not in done]
print(f"to generate: {len(idx)} / {len(ds)}", flush=True)
t0 = time.time()
n_tok_in = 0
for b in range(0, len(idx), args.bs):
    rows = [ds[i] for i in idx[b:b + args.bs]]
    convs = [to_mm(r["messages"], r["images"][0]) for r in rows]
    _kw = {"enable_thinking": bool(args.enable_thinking)} if "enable_thinking" in (processor.chat_template or "") else {}
    inputs = processor.apply_chat_template(
        convs, add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors="pt",
        padding=True, processor_kwargs={"padding": True}, **_kw,
    ).to("cuda")
    n_tok_in += int(inputs["attention_mask"].sum())
    with torch.inference_mode():
        out = model.generate(**inputs, max_new_tokens=args.max_new_tokens, do_sample=False,
                             repetition_penalty=1.0)
    gen = out[:, inputs["input_ids"].shape[1]:]
    texts = processor.batch_decode(gen, skip_special_tokens=False)
    # if the prompt itself opened a think block (template prefill), keep it so an unclosed
    # thought can never be mistaken for a final action by the parser
    _tail = processor.tokenizer.decode(inputs["input_ids"][0][-4:], skip_special_tokens=False)
    if _tail.rstrip().endswith("<think>"):
        texts = ["<think>" + t for t in texts]
    for r, t in zip(rows, texts):
        t = t.replace(processor.tokenizer.pad_token, "")
        for eos in ("<|im_end|>", "<|endoftext|>"):
            t = t.split(eos)[0]
        rec = {k: r[k] for k in r.keys() if k not in ("images", "messages")}
        rec["output"] = t
        rec["model"] = args.model
        rec["config_hash"] = cfg_hash
        fout.write(json.dumps(rec, ensure_ascii=False) + "\n")
    fout.flush()
    el = time.time() - t0
    print(f"{b + len(rows)}/{len(idx)} {el:.0f}s avg_prompt_tok={n_tok_in / (b + len(rows)):.0f}", flush=True)
    if (b // args.bs) % 40 == 39:
        _push_partial()
fout.close()
_push_partial()
print("DONE", time.time() - t0, flush=True)
"""Score offline predictions (JSONL from generate.py). Pure python, runs anywhere.

Protocol (AndroidControl / AITW convention):
  type_match : predicted action_type == gt action_type
  step_sr    : type_match AND argument match:
      click/long_press : point inside GT element bbox (if known) OR within 14% of screen
                         (euclidean distance in normalized [0,1] coords) of GT point
      input_text/answer: normalized exact match OR token-F1 >= 0.5
      scroll           : same direction
      open_app         : case-insensitive equal / containment
      others           : type match suffices
  episode_sr : all steps of an episode correct (offline task completion proxy)
Unparseable outputs count as wrong.

Usage: python score.py preds.jsonl [--out metrics.json] [--by split_tag]
"""

import argparse
import hashlib
import os
import json
import math
import re
import sys
from collections import Counter, defaultdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "train"))
import agent_format as af  # noqa: E402

CLICK_DIST = 0.14


def _norm_text(s):
    return re.sub(r"\s+", " ", re.sub(r"[^\w\s]", " ", (s or "").lower())).strip()


def _f1(a, b):
    ta, tb = _norm_text(a).split(), _norm_text(b).split()
    if not ta and not tb:
        return 1.0
    common = sum((Counter(ta) & Counter(tb)).values())
    if common == 0:
        return 0.0
    p, r = common / len(ta), common / len(tb)
    return 2 * p * r / (p + r)


def match(pred, gt, gt_bbox=None):
    """pred/gt: action dicts in agent_format (point_2d in 0-1000). gt_bbox: [x1,y1,x2,y2] in 0-1000 or None."""
    if pred is None:
        return False, False
    t = gt["action_type"]
    if pred["action_type"] != t:
        return False, False
    if t in af.POINT_TYPES:
        px, py = pred["point_2d"]
        gx, gy = gt["point_2d"]
        if gt_bbox is not None and gt_bbox[0] <= px <= gt_bbox[2] and gt_bbox[1] <= py <= gt_bbox[3]:
            return True, True
        d = math.hypot((px - gx) / 1000, (py - gy) / 1000)
        return True, d <= CLICK_DIST
    if t in ("input_text", "answer"):
        a, b = _norm_text(pred.get("text")), _norm_text(gt.get("text"))
        return True, a == b or _f1(a, b) >= 0.5
    if t == "scroll":
        return True, pred.get("direction") == gt.get("direction")
    if t == "open_app":
        a, b = _norm_text(pred.get("app_name")), _norm_text(gt.get("app_name"))
        return True, bool(a) and (a == b or a in b or b in a)
    if t == "status":
        return True, pred.get("goal_status", "complete") == gt.get("goal_status", "complete")
    return True, True


def score_rows(rows, strict=False):
    n = len(rows)
    tm = sr = parse_ok = 0
    per_type = defaultdict(lambda: [0, 0, 0])  # n, type_match, sr
    episodes = defaultdict(list)
    for r in rows:
        gt = r["gt_action"] if isinstance(r["gt_action"], dict) else json.loads(r["gt_action"])
        bbox = r.get("gt_bbox")
        if isinstance(bbox, str):
            bbox = json.loads(bbox) if bbox else None
        pred = af.parse_action(r["output"], strict=strict)
        parse_ok += pred is not None
        t_ok, s_ok = match(pred, gt, bbox)
        tm += t_ok
        sr += s_ok
        pt = per_type[gt["action_type"]]
        pt[0] += 1
        pt[1] += t_ok
        pt[2] += s_ok
        episodes[r["episode_id"]].append(s_ok)
    ep_sr = sum(all(v) for v in episodes.values()) / max(1, len(episodes))
    return {
        "n_steps": n,
        "n_episodes": len(episodes),
        "parse_rate": parse_ok / max(1, n),
        "type_match": tm / max(1, n),
        "step_sr": sr / max(1, n),
        "episode_sr": ep_sr,
        "per_type": {k: {"n": v[0], "type_match": v[1] / v[0], "step_sr": v[2] / v[0]} for k, v in sorted(per_type.items())},
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("preds")
    ap.add_argument("--out")
    _here = Path(__file__).resolve()
    _cands = [os.environ.get("AC_TEST_GT", ""), str(_here.parents[2] / "data/meta/androidcontrol_test_gt.jsonl") if len(_here.parents) > 2 else "",
              str(_here.parent / "meta/androidcontrol_test_gt.jsonl")]
    ap.add_argument("--gt", default=next((c for c in _cands if c and os.path.exists(c)), _cands[-1]))
    ap.add_argument("--modes", default="high,low", help="expected modes, e.g. 'high' for a high-only certified subset")
    ap.add_argument("--allow_incomplete", action="store_true")
    a = ap.parse_args()
    preds = [json.loads(l) for l in open(a.preds)]
    # --- integrity: score against the FROZEN ground truth, never the prediction file's own labels ---
    gt_bytes = open(a.gt, "rb").read()
    gt_man = Path(a.gt).with_suffix(".manifest.json")
    if gt_man.exists() and json.load(open(gt_man))["sha256"] != hashlib.sha256(gt_bytes).hexdigest():
        print("INTEGRITY PROBLEM: frozen GT file does not match its manifest sha256", file=sys.stderr)
        raise SystemExit(2)
    modes = set(a.modes.split(","))
    gt_rows = [json.loads(l) for l in gt_bytes.decode().splitlines() if l.strip()]
    gt = {(r["episode_id"], r["step_idx"], r["mode"]): r for r in gt_rows if r["mode"] in modes}
    pk = [(r["episode_id"], r["step_idx"], r.get("mode", "high")) for r in preds]
    dups = len(pk) - len(set(pk))
    mpath = a.preds + ".manifest.json"
    manifest = json.load(open(mpath)) if Path(mpath).exists() else None
    row_models = sorted({str(r.get("model")) for r in preds})
    problems = []
    if dups:
        problems.append(f"{dups} duplicate keys")
    missing = set(gt) - set(pk)
    extra = set(pk) - set(gt)
    if missing:
        problems.append(f"{len(missing)} GT rows missing")
    if extra:
        problems.append(f"{len(extra)} prediction keys not in frozen GT")
    if manifest is None:
        problems.append("no generation manifest")
    elif row_models != [manifest["model"]]:
        problems.append(f"row models {row_models} != manifest model {manifest['model']}")
    integrity = {"n_pred_rows": len(preds), "n_gt_rows": len(gt), "duplicate_keys": dups, "missing": len(missing),
                 "extra": len(extra), "row_models": row_models, "manifest": manifest, "gt_file": a.gt,
                 "complete": not missing and not extra and not dups, "problems": problems}
    if problems:
        print("INTEGRITY PROBLEM:", problems, file=sys.stderr)
        if not a.allow_incomplete:
            raise SystemExit(2)
    rows = []
    for r in preds:
        k = (r["episode_id"], r["step_idx"], r.get("mode", "high"))
        if k in gt:
            g = gt[k]
            rows.append({**g, "output": r["output"]})
    steps = [r for r in rows if not r.get("is_terminal")]
    term = [r for r in rows if r.get("is_terminal")]
    res = {}
    for mode in sorted({r.get("mode", "high") for r in steps}):
        mrows = [r for r in steps if r.get("mode", "high") == mode]
        block = {"overall": score_rows(mrows), "overall_strict_parse": score_rows(mrows, strict=True)}
        subs = sorted({s for r in mrows for s in (r.get("subsplits") or [])})
        if subs:
            block["by_subsplit"] = {s: score_rows([r for r in mrows if s in (r.get("subsplits") or [])]) for s in subs}
        # strict element-hit accuracy for clicks where a curated bbox exists
        hit = tot = 0
        for r in mrows:
            gt = json.loads(r["gt_action"]) if isinstance(r["gt_action"], str) else r["gt_action"]
            bb = json.loads(r["gt_bbox"]) if r.get("gt_bbox") else None
            if gt["action_type"] in af.POINT_TYPES and bb:
                pred = af.parse_action(r["output"])
                tot += 1
                if pred and pred["action_type"] == gt["action_type"]:
                    x, y = pred["point_2d"]
                    hit += bb[0] <= x <= bb[2] and bb[1] <= y <= bb[3]
        block["click_bbox_hit_strict"] = {"n": tot, "acc": hit / max(1, tot)}
        res[mode] = block
    if term:
        res["terminal_complete"] = score_rows(term)
    res["integrity"] = integrity
    s = json.dumps(res, indent=2)
    print(s)
    if a.out:
        Path(a.out).write_text(s)


if __name__ == "__main__":
    main()

