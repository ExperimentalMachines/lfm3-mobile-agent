     1	#!/bin/bash
     2	# Export a merged HF model to the phone-format GGUF (language model) used in AndroidWorld.
     3	# The vision tower/projector are untouched by our LoRA (language-model-only), so the base model's
     4	# mmproj GGUF is reused unchanged.
     5	# Usage: scripts/local_export_gguf.sh <hf_repo_or_dir> <out_dir> [quant=Q4_K_M]
     6	set -euo pipefail
     7	SRC=$1; OUT=$2; Q=${3:-Q4_K_M}
     8	cd "$(dirname "$0")/.."
     9	mkdir -p "$OUT"
    10	if [ -d "$SRC" ]; then M="$SRC"; else
    11	  M="$OUT/hf"; uvx --from huggingface_hub hf download "$SRC" --local-dir "$M" --exclude "lora_adapter/*" --exclude "eval/*" --exclude "training_logs/*" > /dev/null
    12	fi
    13	[ -d .venv-convert ] || { uv venv -q -p 3.12 .venv-convert && uv pip install -q -p .venv-convert/bin/python -r tools/llama.cpp/requirements/requirements-convert_hf_to_gguf.txt; }
    14	NAME=$(basename "$SRC")
    15	.venv-convert/bin/python tools/llama.cpp/convert_hf_to_gguf.py "$M" --outtype f16 --outfile "$OUT/$NAME-F16.gguf" 2>&1 | tail -2
    16	llama-quantize "$OUT/$NAME-F16.gguf" "$OUT/$NAME-$Q.gguf" "$Q" 2>&1 | tail -1
    17	rm -f "$OUT/$NAME-F16.gguf"
    18	[ -d "$SRC" ] || rm -rf "$M"   # keep disk lean
    19	ls -la "$OUT"/*.gguf
