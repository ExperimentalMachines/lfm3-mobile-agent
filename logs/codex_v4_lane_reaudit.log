   304	def _get_task_info(
   305	    episodes: list[dict[str, Any]],
   306	) -> tuple[dict[str, list[dict[str, Any]]], dict[str, list[dict[str, Any]]]]:
   307	  """Gets task info from episodes.
   308	
   309	  Args:
   310	    episodes: Episodes to get info from.
   311	
   312	  Returns:
   313	    A tuple of completed and failed task lookup tables.
   314	  """
   315	
   316	  completed = collections.defaultdict(list)
   317	  failed = collections.defaultdict(list)
   318	  for episode in episodes:
   319	    instance_name = (
   320	        episode[constants.EpisodeConstants.TASK_TEMPLATE]
   321	        + checkpointer_lib.INSTANCE_SEPARATOR
   322	        + str(episode[constants.EpisodeConstants.INSTANCE_ID])
   323	    )
   324	    if episode.get(constants.EpisodeConstants.EXCEPTION_INFO) is not None:
   325	      failed[instance_name].append(episode)
   326	    else:
   327	      completed[instance_name].append(episode)
   328	  return completed, failed
