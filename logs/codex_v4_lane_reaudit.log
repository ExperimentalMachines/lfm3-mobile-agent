    45	def main():
    46	    ap = argparse.ArgumentParser()
    47	    ap.add_argument("a")
    48	    ap.add_argument("b")
    49	    ap.add_argument("--expected", type=int, default=116)
    50	    ap.add_argument("--out")
    51	    a = ap.parse_args()
    52	    A, B = load(a.a), load(a.b)
    53	    pairs, excluded = [], []
    54	    for k in sorted(set(A) & set(B)):
    55	        if A[k]["seed"] == B[k]["seed"] and A[k]["goal"] == B[k]["goal"]:
    56	            pairs.append((k, A[k]["ok"], B[k]["ok"]))
    57	        else:
    58	            excluded.append(k[0])
    59	    both = sum(x and y for _, x, y in pairs)
    60	    a_only = sum(x and not y for _, x, y in pairs)
    61	    b_only = sum(y and not x for _, x, y in pairs)
    62	    ka, kb = sum(v["ok"] for v in A.values()), sum(v["ok"] for v in B.values())
    63	    res = {
    64	        "A": {"run": a.a, "successes": ka, "n_recorded": len(A), "rate_over_expected": ka / a.expected,
    65	              "wilson95": wilson(ka, a.expected)},
    66	        "B": {"run": a.b, "successes": kb, "n_recorded": len(B), "rate_over_expected": kb / a.expected,
    67	              "wilson95": wilson(kb, a.expected)},
    68	        "paired": {"n_pairs": len(pairs), "both": both, "A_only": a_only, "B_only": b_only,
    69	                   "neither": len(pairs) - both - a_only - b_only, "mcnemar_exact_p": mcnemar_exact(a_only, b_only),
    70	                   "excluded_goal_or_seed_mismatch": excluded,
    71	                   "B_only_tasks": [k[0] for k, x, y in pairs if y and not x],
    72	                   "A_only_tasks": [k[0] for k, x, y in pairs if x and not y]},
    73	    }
    74	    if a.out:
