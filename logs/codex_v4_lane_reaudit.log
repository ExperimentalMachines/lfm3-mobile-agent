     1	#!/bin/bash
     2	# Local watchdog for the overnight Colab v4 (+RL) job (v2, after Codex's recovery audit). Every 120 s:
     3	#  (a) session gone (VM pruned) -> if NO other Colab session exists (a second VM could write the same checkpoint repo),
     4	#      re-provision (G4 > A100 > H100 > L4 last) and relaunch with scripts/v4_relaunch.sh (NO_RL on L4), at most
     5	#      MAX_RELAUNCH times; sft_vlm.py refuses to start from scratch if the hub checkpoint cannot be restored;
     6	#  (b) no local client attached to the kernel -> attach a queued keepalive cell;
     7	#  (c) every job on the VM has exited -> back up /content/eval/* and the run logs locally, wait GRACE_S (FAIL_GRACE_S if a
     8	#      job failed or a download failed; touch logs/.keep_vm_<session> to keep the VM), re-check that the same run is
     9	#      still finished, then stop the VM and verify it is gone.
    10	# Session names are matched exactly ("[name]" in `colab sessions`, "exec -s name --" for clients).
    11	# Usage: nohup bash scripts/colab_watchdog_v2.sh lfm3v4a > logs/colab_watchdog_lfm3v4a.log 2>&1 &
    12	set -u
    13	S=$1; MAX_RELAUNCH=${MAX_RELAUNCH:-3}; GRACE_S=${GRACE_S:-1200}; FAIL_GRACE_S=${FAIL_GRACE_S:-5400}; n=0
    14	cd "$(dirname "$0")/.."
    15	CB=$HOME/.local/bin/colab
    16	C() { "$CB" "$@" < /dev/null 2>&1 | grep -v "new version\|colab update\|silence"; }
    17	log() { echo "[$(date +%T)] $*"; }
    18	TMP=${TMPDIR:-/tmp}/colab_wd2_$S; mkdir -p "$TMP"
    19	BK=results/vm_backup/$S; mkdir -p "$BK/eval"
    20	sessions() { C sessions; }
    21	alive() { sessions | grep -q "^\[$S\] "; }
    22	others() { sessions | grep "^\[" | grep -v "^\[$S\] "; }
    23	status_done() {  # prints run_id and exits 0 iff jobs_status.json exists and no job is running
    24	  rm -f "$TMP/st.json"
    25	  C download -s "$S" /content/work/jobs_status.json "$TMP/st.json" > /dev/null 2>&1 && [ -s "$TMP/st.json" ] && \
    26	    python3 -c "import json,sys; d=json.load(open('$TMP/st.json')); s=d['status']; print(d['run_id'], 'ok' if all(v=='exit 0' for v in s.values()) else 'failed'); sys.exit(0 if s and all(v!='running' for v in s.values()) else 1)"
    27	}
    28	log "watchdog v2 start for $S (pid $$)"
    29	while true; do
    30	  if ! alive; then
    31	    sleep 30; alive && continue   # one transient API failure is not a loss
    32	    if [ -n "$(others)" ]; then log "VM $S gone but other sessions exist; not provisioning (possible second writer): $(others | tr '\n' ' ')"; sleep 300; continue; fi
    33	    [ $n -ge "$MAX_RELAUNCH" ] && { log "VM LOST; relaunch limit ($MAX_RELAUNCH) reached"; exit 1; }
    34	    n=$((n+1)); log "VM LOST; re-provision + relaunch #$n"
    35	    if bash scripts/colab_get_gpu.sh "$S" 6 >> "logs/colab_get_gpu_${S}_wd.log" 2>&1; then
    36	      tail -1 "logs/colab_get_gpu_${S}_wd.log"
    37	      nr=${NO_RL:-0}; tail -1 "logs/colab_get_gpu_${S}_wd.log" | grep -q "GOT L4" && nr=1   # no GRPO smoke next to SFT on 24 GB
    38	      NO_RL=$nr bash scripts/v4_relaunch.sh "$S" 2>&1 | tail -5
    39	    else
    40	      log "no GPU this round"; sleep 300
    41	    fi
    42	    continue
    43	  fi
    44	  if R1=$(status_done); then
    45	    log "all jobs exited: $R1 $(cat "$TMP/st.json")"
    46	    bad=0; case "$R1" in *failed) bad=1 ;; esac
    47	    for f in $(C ls -s "$S" content/eval | grep -v "/$"); do
    48	      C download -s "$S" "/content/eval/$f" "$BK/eval/$f" > /dev/null 2>&1 && [ -s "$BK/eval/$f" ] || { log "backup failed: $f"; bad=1; }
    49	    done
    50	    for f in /content/runs/lfm3_v4_pipeline.log /content/runs/rl_hook.log /content/runs/v4rl_train.log /content/runs/rl_smoke.log; do
    51	      C download -s "$S" "$f" "$BK/$(basename "$f")" > /dev/null 2>&1 || log "log download failed: $f"
    52	    done
    53	    g=$GRACE_S; [ $bad = 1 ] && g=$FAIL_GRACE_S
    54	    log "backup in $BK ($(ls "$BK/eval" | wc -l | tr -d ' ') eval files); stopping in ${g}s unless logs/.keep_vm_$S exists"
    55	    sleep "$g"
    56	    [ -f "logs/.keep_vm_$S" ] && { log "keep file present; not stopping"; exit 0; }
    57	    R2=$(status_done) || { log "jobs running again after the grace period; continuing to watch"; continue; }
    58	    [ "${R1%% *}" = "${R2%% *}" ] || { log "a new run ($R2) started during the grace period; continuing to watch"; continue; }
    59	    C stop -s "$S" | tail -1; sleep 10
    60	    if alive; then log "STOP FAILED; retrying"; C stop -s "$S" | tail -1; sleep 10; alive && { log "STOP FAILED twice"; exit 1; }; fi
    61	    log "VM stopped (verified)"; exit 0
    62	  fi
    63	  if ! pgrep -f "[e]xec -s $S --" > /dev/null; then
    64	    log "no client attached; attaching a queued keepalive cell"
    65	    echo "print('keepalive')" | nohup "$CB" exec -s "$S" --timeout 200000 >> "logs/colab_keepalive_$S.log" 2>&1 &
    66	  fi
    67	  sleep 120
    68	done

