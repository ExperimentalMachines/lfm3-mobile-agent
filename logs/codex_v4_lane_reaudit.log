    26	def wilson(k, n, z=1.96):
    27	    if n == 0:
    28	        return (0.0, 0.0)
    29	    p = k / n
    30	    d = 1 + z * z / n
    31	    c = (p + z * z / (2 * n)) / d
    32	    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
    33	    return (max(0.0, c - h), min(1.0, c + h))
    34	
    35	
    36	def mcnemar_exact(b, c):
    37	    n = b + c
    38	    if n == 0:
    39	        return 1.0
    40	    k = min(b, c)
    41	    p = sum(math.comb(n, i) for i in range(k + 1)) / 2 ** n
    42	    return min(1.0, 2 * p)
    43	
