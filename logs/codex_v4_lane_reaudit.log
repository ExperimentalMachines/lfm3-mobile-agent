    91	class Checkpointer(abc.ABC):
    92	  """Saves and loads the results of an evaluation run."""
    93	
    94	  @abc.abstractmethod
    95	  def save_episodes(self, task_episodes: list[Episode], task_name: str) -> None:
    96	    """Saves a task's episodes to disk."""
    97	
    98	  @abc.abstractmethod
    99	  def load(self, fields: list[str] | None = None) -> list[Episode]:
   100	    """Loads all episodes from disk."""
   101	
   102	
   103	class IncrementalCheckpointer(Checkpointer):
   104	  """Saves and loads the results of an evaluation run.
   105	
   106	  Designed for incremental saving of episodes for each task, enabling the
   107	  checkpointer to save the results of an evaluation run task by task, rather
   108	  than saving the entire dataset at once.
   109	
   110	  Attributes:
   111	      directory: The directory to store the task data.
   112	  """
   113	
   114	  def __init__(self, directory: str) -> None:
   115	    self.directory = directory
   116	    os.makedirs(directory, exist_ok=True)
   117	
   118	  def save_episodes(self, task_episodes: list[Episode], task_name: str):
   119	    """Saves a task group to disk.
   120	
   121	    Args:
   122	        task_episodes: The task's episodes to save.
   123	        task_name: The unique identifier for the task group.
   124	    """
   125	    filename = os.path.join(self.directory, f'{task_name}.pkl.gz')
   126	    with open(filename, 'wb') as f:
   127	      compressed = _gzip_pickle(task_episodes)
   128	      f.write(compressed)
   129	    logging.info('Wrote task episodes for %s to %s', task_name, filename)
   130	
   131	  def load(self, fields: list[str] | None = None) -> list[Episode]:
   132	    """Loads all task groups from disk."""
   133	    # Keep same order as runtime.
   134	    directories = os.listdir(self.directory)
   135	    directories.sort(key=sort_key)
   136	
   137	    data = []
   138	    for filename in directories:
   139	      if filename.endswith('.pkl.gz'):
   140	        try:
   141	          task_group_id = filename[:-7]  # Remove ".pkl.gz" extension
   142	          task_group = self._load_task_group(task_group_id)
   143	          if fields is not None:
   144	            task_group = [
   145	                {field: episode[field] for field in fields}
   146	                for episode in task_group
   147	            ]
   148	          data.extend(task_group)
   149	        except Exception as e:  # pylint: disable=broad-exception-caught
   150	          logging.info('Unable to load %s with exception: %s', filename, e)
   151	    return data
   152	
   153	  def _load_task_group(self, task_group_id: str) -> list[Episode]:
   154	    """Loads a single task group from disk."""
   155	    filename = os.path.join(self.directory, f'{task_group_id}.pkl.gz')
   156	    try:
   157	      return _unzip_and_read_pickle(filename)
   158	    except FileNotFoundError:
   159	      logging.info(
   160	          'File not readable: %s. It may not exist. Starting from empty state.',
   161	          filename,
   162	      )
   163	      return []
   164	
   165	
   166	class NullCheckpointer(Checkpointer):
   167	  """Checkpointer that does nothing."""
   168	
   169	  def __init__(self) -> None:
   170	    """Constructor."""
   171	
   172	  def save_episodes(self, task_episodes: list[Episode], task_name: str):
   173	    pass
   174	
   175	  def load(self, fields: list[str] | None = None) -> list[Episode]:
   176	    del fields
   177	    return []
   178	
   179	
   180	def create_run_directory(location: str) -> str:
   181	  """Creates the UUID directory name to save run results.
   182	
   183	  Args:
   184	    location: Location to write the directory.
   185	
   186	  Returns:
   187	    A UUID directory name.
   188	  """
   189	  timestamp = datetime.datetime.now().strftime('%Y%m%dT%H%M%S%f')
   190	  return os.path.join(location, f'run_{timestamp}')
   191	
   192	
   193	class DeprecatedCheckpointer:
   194	  """Saves and loads the results of an evaluation run.
   195	
   196	  Attributes:
   197	    filename: The name of the file to write.
   198	  """
   199	
   200	  def __init__(self, filename: str) -> None:
   201	    self.filename = filename
   202	
   203	  def save(self, data: list[Episode], completed_tasks: list[str]) -> None:
   204	    """Saves the results of an evaluation run.
   205	
   206	    Args:
   207	      data: The data for the run.
   208	      completed_tasks: Metadata containing the tuple of completed tasks.
   209	    """
   210	    with open(self.filename, 'wb') as f:
   211	      compressed = _gzip_pickle((data, completed_tasks))
   212	      f.write(compressed)
   213	    logging.info('Wrote to %s', self.filename)
   214	
   215	  def load(
   216	      self, fields: list[str] | None = None
   217	  ) -> tuple[list[Episode], list[str]]:
   218	    """Loads the results of an evaluation run."""
   219	    del fields
   220	    try:
   221	      return _unzip_and_read_pickle(self.filename)
   222	    except FileNotFoundError:
   223	      logging.info(
   224	          'File not readable: %s. It may not exist. Starting from empty state.',
   225	          self.filename,
   226	      )
   227	      return [], []

