    18	        ep = pickle.load(gzip.open(f))  # trusted: written by our own local android_world run, never downloaded
    19	        ep = ep[0] if isinstance(ep, list) else ep
    20	        r = ep.get("is_successful")
    21	        ok = isinstance(r, (int, float)) and not math.isnan(r) and r >= 1 and not ep.get("exception_info")  # full success only (composite tasks can give 0.5)
    22	        out[(ep["task_template"], ep.get("instance_id"))] = {"seed": ep.get("seed"), "goal": ep.get("goal"), "ok": bool(ok)}
    23	    return out
    24	
