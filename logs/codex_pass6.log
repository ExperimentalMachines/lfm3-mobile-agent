def selected(path, ns, names, cls=None):
    tree=ast.parse(Path(path).read_text());body=tree.body
    if cls:body=next(n.body for n in body if isinstance(n,ast.ClassDef) and n.name==cls)
    nodes=[n for n in body if isinstance(n,(ast.ClassDef,ast.FunctionDef)) and n.name in names]
    assert len(nodes)==len(names)
    exec(compile(ast.Module(body=ast.parse('from __future__ import annotations').body+nodes,type_ignores=[]),str(path),'exec'),ns)
    return ns

