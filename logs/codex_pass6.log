def score(name,pred_rows=None,mode=None,gt_mode='valid',flat=False,manifest_kind='valid',extra=()):
    d=OUT/name;d.mkdir();gt=d/'androidcontrol_test_gt.jsonl';gt.write_text(''.join(json.dumps(x)+'\n' for x in truth))
    if gt_mode!='missing':write_json(gt.with_suffix('.manifest.json'),{'sha256':sha(gt) if gt_mode=='valid' else 'bad'})
    preds=pred_rows if pred_rows is not None else [{**x,'model':'synthetic-model','config_hash':'good','output':x['gt_action']} for x in truth]
    pp=d/'preds.jsonl';pp.write_text(''.join(json.dumps(x)+'\n' for x in preds));write_json(str(pp)+'.manifest.json',{'model':'synthetic-model','config_hash':'good','n_rows':len(preds)})
    
    if manifest_kind=='absent': Path(str(pp)+'.manifest.json').unlink()
    elif manifest_kind in ('missing_hash','blank_hash'):
        mm=json.loads(Path(str(pp)+'.manifest.json').read_text()); mm.pop('config_hash')
        if manifest_kind=='blank_hash':mm['config_hash']=''
        write_json(str(pp)+'.manifest.json',mm)
    script=ROOT/'eval/androidcontrol/score.py';args=['--gt',str(gt),*extra]
    if flat:
        work=d/'content/work';(work/'meta').mkdir(parents=True)
        shutil.copyfile(script,work/'score.py');shutil.copyfile(ROOT/'train/agent_format.py',work/'agent_format.py')
        shutil.copyfile(gt,work/'meta'/gt.name);shutil.copyfile(gt.with_suffix('.manifest.json'),work/'meta'/gt.with_suffix('.manifest.json').name)
        script=work/'score.py';args=[]
    if mode:args+=['--modes',mode]
    metrics=d/'metrics.json'
    rec=command([sys.executable,'-B',str(script),str(pp),*args,'--out',str(metrics)],env={'AC_TEST_GT':''})
    if metrics.exists():rec['metrics']=json.loads(metrics.read_text())
    write_json(d/'result.json',rec);return rec

