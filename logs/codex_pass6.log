+            (out/'merged/model.safetensors').write_bytes(b'x')
+            (out/'merged/config.json').write_text('{}')
+            (out/'lora/adapter_model.safetensors').write_bytes(b'x')
+            steps=int(env.get('MAX_STEPS','1500'))
+            r={'args':{'model_id':env['MODEL'],'out':str(out),'max_steps':int(env.get('MAX_STEPS','-1')),'epochs':float(env.get('EPOCHS','1')),'max_agent_rows':int(env.get('MAX_AGENT_ROWS','0'))},'global_step':steps,'max_steps':steps,'weights':{'model.safetensors':1}}
