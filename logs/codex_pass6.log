     1	#!/bin/bash
     2	# Wait for the current blocking-cell job on <session> to finish, then launch <next_jobs.json> on the same
     3	# session (fresh code re-uploaded first). If the session is gone, allocate a new L4 and bootstrap it.
     4	# Usage: COLAB_BIN=... COLAB_CONFIG=... HF_TOKEN_FILE=... scripts/chain_next_job.sh <session> <next_jobs.json>
     5	set -u
     6	set -o pipefail
     7	SESS=$1; NEXT=$2
     8	cd "$(dirname "$0")/.."
     9	CB=${COLAB_BIN:-$HOME/.local/bin/colab}
    10	C() { "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} "$@" < /dev/null 2> >(grep -v "new version\|colab update\|silence this" >&2); }
    11	ST=$(mktemp)
    12	echo "[$(date +%T)] waiting for current job on $SESS"
    13	while true; do
    14	  if C download -s "$SESS" /content/work/jobs_status.json "$ST" 2>&1 | grep -q "lost\|not found\|404"; then
    15	    echo "[$(date +%T)] session $SESS gone"; GONE=1; break
    16	  fi
    17	  if grep -q '"exit' "$ST" 2>/dev/null && ! grep -q '"running"' "$ST"; then
    18	    echo "[$(date +%T)] job finished: $(cat $ST)"
    19	    grep -qE '"exit [1-9]' "$ST" && echo "WARNING: predecessor job FAILED; launching the next (independent) model anyway"
    20	    GONE=0; break
    21	  fi
    22	  sleep 120
    23	done
    24	if [ "$GONE" = 1 ]; then
    25	  export COLAB_CLI_REQUEST_TIMEOUT=900
    26	  for i in 1 2 3 4 5; do C new -s "$SESS" --gpu L4 && break; sleep 60; done
    27	  bash scripts/launch_gpu_jobs.sh "$SESS" "$NEXT"
    28	else
    29	  echo 'import os;os.makedirs("/content/work/meta",exist_ok=True);print("meta ok")' | "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} exec -s "$SESS" 2>/dev/null | grep -q "meta ok" || { echo "cannot reach $SESS kernel"; exit 1; }
    30	  for f in train/sft_vlm.py train/agent_format.py train/qwen35_chat_template_gen.jinja eval/androidcontrol/generate.py \
    31	           eval/androidcontrol/score.py eval/general/eval_general.py data/build_general_replay.py scripts/vm_model_pipeline.sh \
    32	           scripts/vm_blocking_jobs.py scripts/vm_eval.sh scripts/vm_train.sh scripts/colab_bootstrap.py data/meta/androidcontrol_test_gt.jsonl data/meta/androidcontrol_test_gt.manifest.json; do
    33	    dst="/content/work/$(basename "$f")"; [[ "$f" == data/meta/* ]] && dst="/content/work/meta/$(basename "$f")"
    34	    [ -f "$f" ] || { echo "missing $f"; exit 1; }
    35	    C upload -s "$SESS" "$f" "$dst" | grep -q Uploaded || { echo "upload failed: $f"; exit 1; }
    36	  done
    37	  C upload -s "$SESS" "$NEXT" /content/work/jobs.json | grep -q Uploaded || { echo "upload failed: jobs.json"; exit 1; }
    38	  nohup "$CB" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} exec -s "$SESS" --timeout 200000 -f scripts/vm_blocking_jobs.py \
    39	    > "logs/${SESS}_jobs_cell_next.log" 2>&1 < /dev/null &
    40	  PID=$!
    41	  sleep 90
    42	  if grep -q "heartbeat" "logs/${SESS}_jobs_cell_next.log" && kill -0 $PID 2>/dev/null; then
    43	    echo "[$(date +%T)] launched $NEXT on $SESS (pid $PID) — heartbeat confirmed"
    44	  else
    45	    echo "[$(date +%T)] LAUNCH NOT CONFIRMED: $(tail -c 300 logs/${SESS}_jobs_cell_next.log)"; exit 1
    46	  fi
    47	fi
