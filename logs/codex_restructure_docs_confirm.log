+    cases.append(record)
+add('no_matches', processes={})
+add('no_matches_dry_run', processes={},dry=True)
+add('server_only',processes={'910003':BASE['910003']})
+add('normal_pause')
+add('launcher_only',processes={'910001':BASE['910001']})
