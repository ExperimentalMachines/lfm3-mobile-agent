9: #   2. pause the arm (allowlisted pause script), remember its run dir
10: #   3. after "v4 AndroidWorld seed-30 finished" and no run_aw.py on emulator 2, resume the arm from that dir
11: # Usage: nohup bash scripts/androidworld/local_emu2_fill_v2.sh >> logs/local_emu2_fill.log 2>&1 &
12: set -u
