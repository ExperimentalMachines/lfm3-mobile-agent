#!/bin/bash
# Regenerate the summary files listed in OUTPUTS below from the committed inputs (episode files, request logs, predictions and
# per-run metric files), then check each output against the committed version (expected: no change, nothing new).
# Not covered: re-scoring raw AndroidControl / general-knowledge predictions into their metric files (eval/ scorers),
# training logs, dataset statistics, and the hand-written docs. MobileWorld is skipped unless its raw trajectories
# (not in git) are present. Needs Python 3.10+ with numpy.
# Usage: bash analysis/reproduce.sh            (PY=/path/to/python to choose the interpreter)
set -euo pipefail
cd "$(dirname "$0")/.."
PY=${PY:-python3}
E=results/v4_dev/hub/eval
D=results/devstream/run_20261118_1519
run() { echo "· $*"; "$@" > /dev/null; }
OUTPUTS=(results/sealed_analysis_final.json results/sealed_analysis_final.md results/sealed_sensitivity_final.json
  results/sealed_sensitivity_final.md results/androidworld/dev_seed30_summary.json results/androidworld/dev_seed30_summary.md
  results/v4_gate_seed30.txt results/v4_dev/lfm3_v4_strict.json results/v4rl_promotion_offline.json
  results/general/lfm3vl2b_v4_retention_logprob.json results/SUMMARY.md results/V2_COMPARISON.md
  results/speed/speed_t8.json results/speed/speed_t8.md results/qdc/speed_qdc_v6.json results/qdc/speed_qdc_v6.md
  $D/speed_phone_partial.json $D/speed_phone_partial.md)
MW_OUTPUTS=(results/mobileworld/mw_r2_comparison.json results/mobileworld/mw_r2_comparison.md
  results/mobileworld/v4_gui_en_r2_summary.json results/mobileworld/guiowl_gui_en_r2_summary.json
  results/mobileworld/maiui_gui_en_r2_summary.json)
untracked() { git ls-files --others --exclude-standard -- results | sort; }
BEFORE=$(untracked)

echo "AndroidWorld, held-out (primary) + sensitivity"
run "$PY" analysis/sealed_analysis.py --seeds 7,1234,2026 --out results/sealed_analysis_final
run "$PY" analysis/sealed_sensitivity.py
echo "AndroidWorld, development seed 30 + v4 gate"
run "$PY" analysis/aw_dev_seed30.py
echo "· analysis/v4_gate.py > results/v4_gate_seed30.txt"
"$PY" analysis/v4_gate.py --v4 results/androidworld/lfm3vl2b_v4 --v4_agent lfm3vl2b_v4_q4km \
  --dev_answer $E/lfm3_v4_dev_answer.jsonl --dev_complete $E/lfm3_v4_dev_complete.jsonl > results/v4_gate_seed30.txt
echo "Offline evaluations"
run "$PY" analysis/strict_dev_metrics.py --answer $E/lfm3_v4_dev_answer.jsonl --complete $E/lfm3_v4_dev_complete.jsonl \
  --out results/v4_dev/lfm3_v4_strict.json
run "$PY" analysis/v4rl_promotion.py --v4_dir $E --rl_dir results/v4rl_dev --out results/v4rl_promotion_offline.json
run "$PY" eval/general/paired_retention.py results/general/lfm3vl2b-ac-lora_base_general_logprob.jsonl \
  $E/lfm3vl2b-v4bmix-lora_ft_general_logprob.jsonl results/general/lfm3vl2b_v4_retention_logprob.json
run "$PY" analysis/build_report.py
echo "· analysis/v2_compare.py > results/V2_COMPARISON.md"
"$PY" analysis/v2_compare.py > results/V2_COMPARISON.md
echo "Speed"
echo "· analysis/bench_speed_report.py > results/speed/speed_t8.json (+ .md)"
"$PY" analysis/bench_speed_report.py results/speed/results_t8 --md results/speed/speed_t8.md > results/speed/speed_t8.json
run "$PY" analysis/qdc_report_v6.py
run "$PY" analysis/devstream_report.py $D --md $D/speed_phone_partial.md --json $D/speed_phone_partial.json
echo "MobileWorld"
if [ -d results/mobileworld/traj_r2 ]; then
  run "$PY" analysis/mw_summarize_r2.py
  OUTPUTS+=("${MW_OUTPUTS[@]}")
else
  echo "· skipped: raw trajectories (results/mobileworld/traj_r2, 8.6 GB) are not in git"
fi
find analysis -name __pycache__ -type d -prune -exec rm -rf {} +
echo
fail=0
for f in "${OUTPUTS[@]}"; do git ls-files --error-unmatch -- "$f" > /dev/null 2>&1 || { echo "not committed: $f"; fail=1; }; done
git diff --quiet HEAD -- "${OUTPUTS[@]}" || { echo "Differs from HEAD:"; git diff --stat HEAD -- "${OUTPUTS[@]}"; fail=1; }
NEW=$(comm -13 <(echo "$BEFORE") <(untracked))
[ -z "$NEW" ] || { echo "New files the scripts wrote under results/:"; echo "$NEW"; fail=1; }
if [ $fail -eq 0 ]; then
  echo "OK: all ${#OUTPUTS[@]} regenerated files are identical to the committed ones (HEAD), and no new file appeared."
else
  exit 1
fi
# Reproduce

## Regenerate the result summaries (minutes, no GPU)

```bash
git clone git@github.com:alpharomercoma/lfm3-android-runs.git && cd lfm3-android-runs
bash analysis/reproduce.sh          # needs Python 3.10+ with numpy; PY=... to pick the interpreter
```

The script re-runs the scripts in [`analysis/`](../analysis/) and checks each output it lists against the committed version.

| Covered | Not covered |
|---|---|
| The 18 summary files listed in the script (23 with MobileWorld), from episode files, request logs, predictions and per-run metric files | Re-scoring raw AndroidControl / general-knowledge predictions into those metric files (use the `eval/` scorers) |
| AndroidWorld analyses without an AndroidWorld install (task metadata is pinned in `data/meta/`) | Training logs, dataset statistics, the numbers typed into the docs, and older runs whose raw predictions were not kept |

| What is regenerated | From |
|---|---|
| AndroidWorld held-out and seed-30 scores, tests, sensitivity, M5 speed | Episode files (`*.pkl.gz`) in `results/androidworld_sealed/` and `results/androidworld/` |
| v4 gate, v4-RL promotion, offline tables | Prediction and metric files in `results/v4_dev/`, `results/v4rl_dev/`, `results/androidcontrol/`, `results/general/` |
| Speed (CPU, phones) | Raw request logs in `results/speed/`, `results/qdc/`, `results/devstream/` |
| MobileWorld | **Skipped** unless `results/mobileworld/traj_r2/` exists: the 8.6 GB of raw trajectories are not in git; the per-task summaries are |

The episode files are Python pickles written by this project's own AndroidWorld harness. Load them only from this
repository.

## Re-run the experiments

These need hardware and accounts the analysis does not:

| Experiment | Needs | Entry point |
|---|---|---|
| Training (SFT) | One GPU (peak use ~11.5 GB; runs used Colab A100 / L4 / G4 and Modal A100 / H100); Hugging Face access to the datasets | [`train/sft_vlm.py`](../train/sft_vlm.py); job configs in [`scripts/training/jobs/`](../scripts/training/jobs/) |
| AndroidControl offline eval | GPU | [`eval/androidcontrol/generate.py`](../eval/androidcontrol/generate.py) → [`score.py`](../eval/androidcontrol/score.py) |
| AndroidWorld | AndroidWorld @ `55ddaf5` cloned to `android_world/` + the two patches in `eval/androidworld/`; Android SDK emulator (API 33); llama.cpp | [`scripts/androidworld/local_sealed_aw_v3.sh`](../scripts/androidworld/local_sealed_aw_v3.sh) `<arm> <seed> <console port> <grpc port> <server port>` |
| MobileWorld | A Linux host with KVM; MobileWorld @ `a026188`; a GPU host for the model server | [`scripts/mobileworld/`](../scripts/mobileworld/) |
| Speed | llama.cpp `cd959bae9` (b12110); the GGUF files | [`scripts/speed/bench_speed.sh`](../scripts/speed/bench_speed.sh) |

Model files (GGUF) live in the Hugging Face repositories listed in [models.md](models.md#released-artifacts).
Local paths in the scripts (`models/`, `tools/`, `android_world/`) are git-ignored.

## Python environments used

| Environment | Used for |
|---|---|
| Python 3 + numpy | Everything in `analysis/` |
| `.venv-aw` (Python 3.11 + AndroidWorld's requirements) | AndroidWorld runs |
| Colab / Modal images pinned in [`scripts/training/colab_bootstrap.py`](../scripts/training/colab_bootstrap.py) and [`scripts/training/modal_app.py`](../scripts/training/modal_app.py) | Training and offline evals (torch 2.14.1, transformers 5.20.2, TRL 1.16.0, PEFT 0.21.2) |
#!/bin/bash
# Run one SEALED AndroidWorld arm on a held-out seed (docs/PREREG_v4.md): results go to results/androidworld_sealed/,
# the runner's full output is written only inside the sealed dir; progress = episode-file counts; nobody reads results
# before every arm on the seed has finished. Exit status and the 116-episode inventory decide "finished" vs "FAILED".
# v3 (2026-11-18, Codex audit results/codex/emu2_v3_promo_audit/report.md P2-1): server startup is bounded (600 s,
# 5 s per health request), tied to the launched PID, and fails with a non-zero exit instead of hanging, so a filler can
# go on (e.g. resume a paused arm). Otherwise identical to local_sealed_aw_v2.sh.
# Usage: bash scripts/androidworld/local_sealed_aw_v3.sh <arm> <seed> <console_port> <grpc_port> <server_port> [resume_run_dir]
#   arm = v1 | v3 | v4 | guiowl
set -u
cd "$(dirname "$0")/../.." || exit 1
ARM=$1; SEED=$2; CP=$3; GP=$4; PORT=$5; RESUME=${6:-}
NAME=${ARM}_seed${SEED}
OUT=results/androidworld_sealed/$NAME
LOG=$OUT/run_output.SEALED.log   # full runner output stays inside the sealed dir (AW prints per-episode result tables)
mkdir -p "$OUT"
# outcome lines (suite_utils prints "Task Successful/Failed") and android_env fork noise are not written to the log
FILTER="Task Successful\|Task Failed\|_os_env_vars\|FD from fork\|fork_posix"
case "$ARM" in
  v1) SRV=(-m models/LFM3-VL-2B-AndroidControl-GGUF/LFM3-VL-2B-AndroidControl-Q4_K_M.gguf
           --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
      RUN=(--agent=lfm --enable_thinking=true --agent_label=lfm3vl2b_v1_q4km) ;;
  v3) SRV=(-m models/lfm3vl2b_v3-GGUF/LFM3-VL-2B-AndroidAgent-v3-Q4_K_M.gguf
           --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
      RUN=(--agent=lfm --enable_thinking=true --agent_label=lfm3vl2b_v3_q4km) ;;
  v4) SRV=(-m models/lfm3vl2b_v4-GGUF/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf
           --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
      RUN=(--agent=lfm --enable_thinking=true --prompt_version=v4 --agent_label=lfm3vl2b_v4_q4km) ;;
  guiowl) SRV=(-m models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf
               --mmproj models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf -c 20480 --image-max-tokens 2600 --jinja)
      RUN=(--agent=guiowl --guiowl_images=1 --guiowl_max_pixels=1048576 --installed_apps=true
           --agent_label=guiowl15_2b_matched1img_apps_q4km) ;;
  *) echo "unknown arm $ARM"; exit 2 ;;
esac
for f in "${SRV[1]}" "${SRV[3]}"; do [ -s "$f" ] || { echo "missing $f"; exit 1; }; done
lsof -nP -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1 && { echo "port $PORT already in use; refusing"; exit 1; }
nohup llama-server "${SRV[@]}" -np 1 -ngl 99 --port $PORT --host 127.0.0.1 > logs/llama_server_$NAME.log 2>&1 < /dev/null &
SP=$!; t0=$(date +%s)
until curl -s --max-time 5 127.0.0.1:$PORT/health | grep -q ok; do
  kill -0 $SP 2>/dev/null || { echo "[$(date +%T)] llama-server exited during startup (logs/llama_server_$NAME.log)"; exit 1; }
  [ $(( $(date +%s) - t0 )) -gt 600 ] && { kill $SP; echo "[$(date +%T)] llama-server not healthy after 600 s"; exit 1; }
  sleep 3
done
OWNER=$(lsof -nP -t -iTCP:$PORT -sTCP:LISTEN 2>/dev/null | head -1)
[ "$OWNER" = "$SP" ] || { kill $SP; echo "[$(date +%T)] port $PORT is served by pid ${OWNER:-none}, not the launched $SP; refusing"; exit 1; }
echo "[$(date +%T)] server :$PORT up; starting SEALED $NAME (seed $SEED) on emulator $CP"
.venv-aw/bin/python eval/androidworld/run_aw.py --console_port=$CP --grpc_port=$GP --server_url=http://127.0.0.1:$PORT \
  --task_random_seed=$SEED --n_task_combinations=1 --output_path=$OUT ${RESUME:+--checkpoint_dir=$RESUME} "${RUN[@]}" \
  >> "$LOG" 2>&1
RC=$?
kill $SP 2>/dev/null
N=$(ls -d $OUT/run_*/ 2>/dev/null | tail -1 | xargs -I{} sh -c 'ls {}*.pkl.gz 2>/dev/null | wc -l' | tr -d ' ')
if [ "$RC" = 0 ] && [ "${N:-0}" = 116 ]; then echo "[$(date +%T)] SEALED $NAME AndroidWorld finished"
else echo "[$(date +%T)] SEALED $NAME AndroidWorld FAILED (exit $RC, ${N:-0}/116 episodes)"; exit 1; fi

