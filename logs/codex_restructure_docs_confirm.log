+    env = {'PATH': str(BIN), 'BASH_ENV': str(BASH_ENV), 'MOCK_STATE': str(state_path),
+           'LC_ALL': 'C', 'PYTHONDONTWRITEBYTECODE': '1', 'TMPDIR': str(case)}
+    command = ['/bin/bash', str(scripts / ('local_emu2_fill_v2.sh' if filler else 'pause_sealed_arm.sh'))]
