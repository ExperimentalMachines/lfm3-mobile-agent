+    for script in ('pause_sealed_arm.sh', 'local_emu2_fill_v2.sh'):
+        (scripts / script).write_text(SOURCES[script])
+    (scripts / 'local_sealed_aw_v3.sh').write_text(f'#!/bin/bash\n{helper} resume "$@"\n')
