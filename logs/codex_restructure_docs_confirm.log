+for pid, label in (('910001','launcher'),('910002','runner'),('910003','server')):
+    add('failed_kill_'+label,modes={pid:{'mode':'fail_alive'}})
+    add('surviving_'+label,modes={pid:{'mode':'stubborn'}})
+for delay in (3,29,30):
