   124	        try:
   125	            obj, _ = dec.raw_decode(text[i:])
   126	            if isinstance(obj, dict) and ("action_type" in obj or "action" in obj):
   127	                a = obj
   128	        except json.JSONDecodeError:
   129	            pass
   130	        i = text.find("{", i + 1)
   131	    if not isinstance(a, dict):
   132	        return None
   133	    t = a.get("action_type") or a.get("action")
   134	    if not isinstance(t, str):
   135	        return None
