    22	        `list[dict[str, Any]]`: A new list of messages where every `"content"` value is a list of structured
    23	        content blocks, and all `"image"` placeholders are populated with the corresponding image objects. If the
    24	        assistant turns contains `"tool_calls"`, then the `"content"` might be empty.
    25	
    26	    Notes:
    27	        - When the input `messages` isn't already in the structured format, (i.e., all `"content"` values are strings),
    28	          the function transforms them into the structured format by wrapping text in `{"type": "text", "text": ...}`
    29	          and inserting `{"type": "image"}` placeholders for the images *before* the first user message.
    30	          If the number of placeholders does not match the number of provided images, an error is raised.
    31	        - Existing image blocks that already include an `"image"` payload are preserved as-is. Only unfilled image
    32	          placeholders are counted and populated from `images`.
    33	
    34	    Example:
    35	    ```python
    36	    # Input
    37	    [
    38	        {"role": "user", "content": "What's in this image?"},
    39	        {"role": "assistant", "content": "It looks like a cat."},
    40	    ]
    41	
    42	    # Output, one image provided
    43	    [
    44	        {"role": "user", "content": [{"type": "image", "image": <PIL.Image.Image>}, {"type": "text", "text": "What's in this image?"}]},
    45	        {"role": "assistant", "content": [{"type": "text", "text": "It looks like a cat."}]},
    46	    ]
    47	    ```
    48	    """
    49	    images = images or []
    50	
    51	    # First, convert all messages to the structured format if needed, and insert image placeholders if needed.
    52	    # Build new message dicts only when transforming string content to avoid modifying the originals.
    53	    new_messages = []
    54	    images_included = False
    55	    for message in messages:
    56	        if message["role"] == "user":
    57	            if isinstance(message["content"], str) and not images_included:
    58	                image_entries = [{"type": "image"} for _ in range(len(images))]
    59	                message = {**message, "content": [*image_entries, {"type": "text", "text": message["content"]}]}
    60	                images_included = True
    61	            elif isinstance(message["content"], str):
    62	                message = {**message, "content": [{"type": "text", "text": message["content"]}]}
    63	        elif message["role"] in {"assistant", "system", "tool"}:
    64	            if isinstance(message.get("content"), str):
    65	                message = {**message, "content": [{"type": "text", "text": message["content"]}]}
    66	        else:
    67	            raise ValueError(
    68	                f"Invalid role in message: {message['role']}. Expected 'system', 'user', 'assistant', or 'tool'."
    69	            )
    70	        new_messages.append(message)
    71	
    72	    # Then, check that the number of image placeholders matches the number of images provided
    73	    num_placeholders = sum(
    74	        sum(1 for part in message["content"] if part["type"] == "image" and "image" not in part)
    75	        for message in new_messages
    76	        if message.get("content") and message["role"] != "tool"
    77	    )
    78	    if num_placeholders != len(images):
    79	        raise ValueError(
    80	            f"Number of images provided ({len(images)}) does not match number of image placeholders ({num_placeholders})."
    81	        )
    82	
    83	    # Then, fill in the actual images in the placeholders
    84	    if images:
    85	        img_idx = 0
    86	        for i, message in enumerate(new_messages):
    87	            if not message.get("content") or message["role"] == "tool":
    88	                continue
    89	            new_content = []
    90	            for part in message["content"]:
    91	                if part["type"] == "image" and "image" not in part:
    92	                    new_content.append({**part, "image": images[img_idx]})
    93	                    img_idx += 1
    94	                else:
    95	                    new_content.append(part)
    96	            new_messages[i] = {**message, "content": new_content}
    97	
    98	    return new_messages
    99	
