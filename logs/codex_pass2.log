+def score_case(name, rows, manifest=None, extra=()):
+    path = OUT / (name + ".jsonl")
+    path.write_text("".join(json.dumps(r) + "\n" for r in rows))
+    if manifest is not None:
+        Path(str(path) + ".manifest.json").write_text(json.dumps(manifest))
