   171	MAX_PIXELS = 880 * 880  # ~756 image tokens for a 1080x2400 phone screen (32px per token)
   172	MIN_PIXELS = 256 * 256
   173	RESIZE_FACTOR = 32  # 16px patch * 2x2 merge (LFM3-VL and Qwen3.5 alike)
   174	
   175	
   176	def smart_resize(height: int, width: int, factor: int = RESIZE_FACTOR,
   177	                 min_pixels: int = MIN_PIXELS, max_pixels: int = MAX_PIXELS) -> tuple[int, int]:
   178	    """Same algorithm as LFM3-VL's image processor (Qwen2-VL style). Returns (h, w)."""
   179	    import math
   180	    h_bar = round(height / factor) * factor
   181	    w_bar = round(width / factor) * factor
   182	    if h_bar * w_bar > max_pixels:
   183	        beta = math.sqrt((height * width) / max_pixels)
   184	        h_bar = max(factor, math.floor(height / beta / factor) * factor)
   185	        w_bar = max(factor, math.floor(width / beta / factor) * factor)
   186	    elif h_bar * w_bar < min_pixels:
   187	        beta = math.sqrt(min_pixels / (height * width))
   188	        h_bar = math.ceil(height * beta / factor) * factor
   189	        w_bar = math.ceil(width * beta / factor) * factor
   190	    return h_bar, w_bar
   191	
   192	
   193	def resize_screenshot(img, max_pixels: int = MAX_PIXELS):
   194	    """PIL image -> RGB PIL image resized exactly as the model will see it."""
   195	    from PIL import Image
   196	    img = img.convert("RGB")
   197	    h, w = smart_resize(img.height, img.width, max_pixels=max_pixels)
   198	    if (w, h) != img.size:
   199	        img = img.resize((w, h), Image.BICUBIC)
   200	    return img
