+        "mixed_models_rejected": score_case("mixed", [row(1), row(2, model="other")], {"n_rows": 2}),
+        "explicit_partial_subset": score_case("partial_subset", [row()], {"n_rows": 1, "limit": 1})}
+    src = ROOT / "eval/androidcontrol/generate.py"
