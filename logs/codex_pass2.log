    61	                {"role": "system", "content": af.SYSTEM_PROMPT},
    62	                {"role": "user", "content": [
    63	                    {"type": "image_url", "image_url": {"url": "data:image/png;base64," + _png_b64(img)}},
    64	                    {"type": "text", "text": text},
    65	                ]},
    66	            ],
    67	            "temperature": self.temperature,
    68	            "max_tokens": self.max_tokens,
    69	            "chat_template_kwargs": {"enable_thinking": self.enable_thinking},
    70	        }
    71	        t0 = time.time()
    72	        r = requests.post(f"{self.server_url}/v1/chat/completions", json=payload, timeout=300)
    73	        r.raise_for_status()
    74	        out = r.json()
    75	        msg = out["choices"][0]["message"]
    76	        return {
    77	            "content": msg.get("content") or "",
    78	            "reasoning": msg.get("reasoning_content") or "",
    79	            "latency_s": time.time() - t0,
    80	            "usage": out.get("usage", {}),
    81	            "timings": out.get("timings", {}),
    82	        }
    83	
    84	    def step(self, goal: str) -> base_agent.AgentInteractionResult:
    85	        state = self.get_post_transition_state()
    86	        pixels = state.pixels
    87	        H, W = pixels.shape[:2]
    88	        img = af.resize_screenshot(Image.fromarray(pixels), self.max_pixels)
    89	
    90	        resp, action, attempts = None, None, []
    91	        for _ in range(1 + self.max_parse_retries):
    92	            resp = self._query(goal, img)
    93	            action = af.parse_action(resp["content"]) or af.parse_action(resp["reasoning"] + resp["content"])
    94	            attempts.append({"content": resp["content"], "reasoning": resp["reasoning"], "latency_s": resp["latency_s"],
    95	                             "usage": resp["usage"], "lenient_ok": action is not None,
    96	                             "strict_ok": af.parse_action(resp["content"], strict=True) is not None})
    97	            if action is not None:
    98	                break
    99	
   100	        thumb = io.BytesIO()
   101	        Image.fromarray(pixels).convert("RGB").resize((360, 800)).save(thumb, format="JPEG", quality=70)
   102	        data = {
   103	            "screenshot_thumb_jpg": thumb.getvalue(),  # full-res frames would blow the local disk budget
   104	            "model_content": resp["content"],
   105	            "model_reasoning": resp["reasoning"],
   106	            "latency_s": sum(x["latency_s"] for x in attempts),  # all attempts, incl. retries
   107	            "attempts": attempts,
   108	            "first_attempt_strict_ok": attempts[0]["strict_ok"],
   109	            "first_attempt_lenient_ok": attempts[0]["lenient_ok"],
   110	            "usage": resp["usage"],
   111	            "timings": resp["timings"],
   112	            "parsed_action": action,
   113	        }
   114	        if action is None:
   115	            self.history.append(("(invalid output)", resp["content"][:80]))
   116	            data["error"] = "unparseable"
   117	            return base_agent.AgentInteractionResult(False, data)
   118	
   119	        intent = (resp["reasoning"] or "").strip().splitlines()[0][:200] if resp["reasoning"].strip() else ""
   120	        self.history.append((intent, af.action_to_str(action)))
   121	
   122	        t = action["action_type"]
   123	        if t == "status":
   124	            return base_agent.AgentInteractionResult(True, data)
   125	
   126	        kw = {"action_type": t}
   127	        if t in af.POINT_TYPES:
   128	            x, y = af.norm_to_px(action["point_2d"], W, H)
   129	            kw.update(x=x, y=y)
   130	        elif t in ("input_text", "answer"):
   131	            kw["text"] = action["text"]
   132	        elif t == "scroll":
   133	            kw["direction"] = action["direction"]
   134	        elif t == "open_app":
   135	            kw["app_name"] = action["app_name"]
   136	        try:
   137	            self.env.execute_action(json_action.JSONAction(**kw))
   138	        except Exception as e:  # keep going; the model sees the unchanged screen
   139	            data["error"] = f"execute_failed: {e}"
   140	        if t == "answer":
   141	            # answering ends information-retrieval tasks in AndroidWorld's protocol only via status;
   142	            # the model is expected to emit status complete next.
   143	            pass
   144	        time.sleep(self.wait_after_action)
   145	        return base_agent.AgentInteractionResult(False, data)
     1	"""Summarize an AndroidWorld run directory (episode .pkl.gz files) into JSON + CSV.
     2	
     3	Differences vs upstream's printed table: episodes that raised an exception are counted as
     4	FAILURES (upstream drops them as NaN, inflating success), and we add on-device-relevant
     5	stats (per-step model latency, prompt tokens, parse failures).
     6	
     7	Usage: python summarize_aw.py <run_dir> --out results/androidworld/<name>.summary.json
     8	"""
     9	import argparse
    10	import csv
    11	import gzip
    12	import json
    13	import math
    14	import pickle
    15	import statistics as stats
    16	import sys
    17	from collections import defaultdict
    18	from pathlib import Path
    19	
    20	ap = argparse.ArgumentParser()
    21	ap.add_argument("run_dir")
    22	ap.add_argument("--out", required=True)
    23	a = ap.parse_args()
    24	
    25	# difficulty labels from AndroidWorld's own task_metadata.json (task_name -> easy/medium/hard)
    26	_md = Path(__file__).resolve().parents[2] / "android_world" / "android_world" / "task_metadata.json"
    27	DIFF = {r["task_name"]: r["difficulty"] for r in json.loads(_md.read_text())} if _md.exists() else {}
    28	
    29	
    30	def difficulty(task):
    31	    return DIFF.get(task, "unknown")
    32	
    33	
    34	rows = []
    35	lat, ptok, parse_fail, nsteps_total = [], [], 0, 0
    36	first_strict = first_lenient = n_attempts = 0
    37	for f in sorted(Path(a.run_dir).glob("*.pkl.gz")):
    38	    # pickles are written locally by our own AndroidWorld runs (trusted input)
    39	    ep = pickle.load(gzip.open(f))
    40	    ep = ep[0] if isinstance(ep, list) else ep
    41	    succ = ep.get("is_successful")
    42	    exc = ep.get("exception_info")
    43	    if succ is None or (isinstance(succ, float) and math.isnan(succ)):
    44	        succ = 0.0
    45	    ed = ep.get("episode_data")
    46	    if not isinstance(ed, dict):  # upstream failed-result records store NaN here
    47	        ed = {}
    48	    l = [x for x in (ed.get("latency_s") or []) if isinstance(x, (int, float))]
    49	    u = [x.get("prompt_tokens") for x in (ed.get("usage") or []) if isinstance(x, dict) and x.get("prompt_tokens")]
    50	    pa = ed.get("parsed_action") or []
    51	    first_strict += sum(1 for x in (ed.get("first_attempt_strict_ok") or []) if x is True)
    52	    first_lenient += sum(1 for x in (ed.get("first_attempt_lenient_ok") or []) if x is True)
    53	    n_attempts += sum(len(x) for x in (ed.get("attempts") or []) if isinstance(x, list))
    54	    lat += l
    55	    ptok += u
    56	    parse_fail += sum(1 for x in pa if x is None)
    57	    nsteps_total += len(pa)
    58	    acts = [x.get("action_type") for x in pa if isinstance(x, dict)]
    59	    task = ep.get("task_template") or f.name.rsplit("_", 1)[0]
    60	    rows.append({
    61	        "task": task, "file": f.name, "success": float(succ), "exception": bool(exc),
    62	        "steps": ep.get("episode_length"), "runtime_s": round(ep.get("run_time") or 0, 1),
    63	        "difficulty": difficulty(task),
    64	        "exception_info": (str(exc)[:300] if exc else None),
    65	        "ended_with_status": bool(acts) and acts[-1] == "status",
    66	        "n_answer_actions": acts.count("answer"),
    67	    })
    68	
    69	by_diff = defaultdict(list)
    70	for r in rows:
    71	    by_diff[r["difficulty"]].append(r["success"])
    72	summary = {
    73	    "run_dir": a.run_dir,
    74	    "n_episodes": len(rows),
    75	    "success_rate": sum(r["success"] for r in rows) / max(1, len(rows)),
    76	    "success_rate_by_difficulty": {k: {"n": len(v), "sr": sum(v) / len(v)} for k, v in sorted(by_diff.items())},
    77	    "n_exceptions_counted_as_fail": sum(r["exception"] for r in rows),
    78	    "frac_episodes_self_terminated": sum(r["ended_with_status"] for r in rows) / max(1, len(rows)),
    79	    "mean_steps": stats.mean([r["steps"] or 0 for r in rows]) if rows else None,
    80	    "model_latency_s": {"mean": stats.mean(lat), "p50": stats.median(lat), "p90": sorted(lat)[int(.9 * len(lat)) - 1]} if lat else None,
    81	    "prompt_tokens_mean": stats.mean(ptok) if ptok else None,
    82	    "parse_failure_rate": parse_fail / max(1, nsteps_total),
    83	    "n_steps_total": nsteps_total,
    84	    "first_attempt_strict_valid_rate": first_strict / max(1, nsteps_total),
    85	    "first_attempt_lenient_valid_rate": first_lenient / max(1, nsteps_total),
    86	    "n_model_calls_incl_retries": n_attempts,
    87	}
    88	Path(a.out).parent.mkdir(parents=True, exist_ok=True)
    89	Path(a.out).write_text(json.dumps({"summary": summary, "episodes": rows}, indent=1))
    90	with open(str(a.out).replace(".json", ".csv"), "w", newline="") as fh:
    91	    w = csv.DictWriter(fh, fieldnames=list(rows[0].keys()) if rows else ["task"])
    92	    w.writeheader()
    93	    w.writerows(rows)
    94	print(json.dumps(summary, indent=1))

