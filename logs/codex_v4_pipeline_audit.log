    43	    """First alternative of each android_world name pattern whose package is installed on this device."""
    44	    try:
    45	        out = adb_utils.issue_generic_request(["shell", "pm", "list", "packages"], env).generic.output.decode()
    46	    except Exception:
    47	        return []
    48	    pkgs = {ln.split(":", 1)[1].strip() for ln in out.splitlines() if ln.startswith("package:")}
    49	    labels = []
    50	    for pat, act in adb_utils._PATTERN_TO_ACTIVITY.items():
    51	        if act.split("/")[0] in pkgs:
    52	            labels.append(pat.split("|")[0])
