    54	
    55	
    56	def resolve(name, labels, threshold=0.5):
    57	    """-> (label or None, score). >= half of the query's identity tokens must match a label token; ties -> shortest label."""
    58	    best = max(((score(name, l), -len(l), l) for l in labels), default=(0.0, 0, None))
    59	    return (best[2], best[0]) if best[0] >= threshold else (None, best[0])
