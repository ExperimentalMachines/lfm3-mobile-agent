    61	
    62	# --- v4 installed-app list (prompt input; same list for the LFM3 v4 and GUI-Owl matched arms) ---------------------------
    63	# Display names for android_world's launchable apps: what a phone launcher would show. Each must resolve natively through
    64	# android_world's own get_adb_activity to the same activity as its pattern (checked by tests in check_app_names()).
    65	_INFRA = {"android world", "miniwob", "clipper", "caa"}  # benchmark infrastructure, not user apps
    66	_DISPLAY = {
    67	    "google chrome": "Chrome", "settings": "Settings", "youtube": "YouTube", "google play": "Google Play",
    68	    "gmail": "Gmail", "google maps": "Maps", "google photos": "Photos", "google calendar": "Google Calendar",
    69	    "camera": "Camera", "audio recorder": "Audio Recorder", "google drive": "Drive", "clock": "Clock",
    70	    "google search": "Google", "contacts": "Contacts", "files": "Files", "markor": "Markor", "messages": "Messages",
    71	    "simple sms messenger": "Simple SMS Messenger", "dialer": "Phone", "simple calendar pro": "Simple Calendar Pro",
    72	    "simple gallery pro": "Simple Gallery Pro", "simple draw pro": "Simple Draw Pro", "pro expense": "Pro Expense",
    73	    "broccoli": "Broccoli", "osmand": "OsmAnd", "tasks": "Tasks", "open tracks sports tracker": "OpenTracks",
    74	    "joplin": "Joplin", "vlc": "VLC", "retro music": "Retro Music",
    75	}
    76	
    77	
    78	def display_names(labels):
    79	    """android_world labels (first pattern alternatives) -> launcher-style names, infrastructure apps removed, sorted."""
    80	    return sorted({_DISPLAY.get(l, l.title()) for l in labels if l not in _INFRA}, key=str.lower)
    81	
    82	
    83	def device_app_names(env):
    84	    return display_names(installed_labels(env))
    85	
    86	
    87	def check_app_names():
    88	    """Every display name must launch the same activity as its android_world pattern."""
    89	    for pat, act in adb_utils._PATTERN_TO_ACTIVITY.items():
    90	        first = pat.split("|")[0]
    91	        if first in _DISPLAY:
    92	            got = adb_utils.get_adb_activity(_DISPLAY[first])
    93	            assert got == act, (first, _DISPLAY[first], got, act)
    94	    return True
     1	"""GUI-Owl-1.5 agent for our AndroidWorld harness, faithful to X-PLUG/MobileAgent
     2	(Mobile-Agent-v3.5/android_world_v3.5/android_world/agents/gui_owl.py @ the cloned revision):
     3	same system prompt, `Action: ...` + <tool_call>{json}</tool_call> output, 0-1000 coordinate grid,
     4	multi-turn messages keeping the last K screenshots (older steps collapsed to "Step j: <Action sentence>"),
     5	`answer` -> store answer and end, `terminate` -> end, coordinate swipes executed exactly via adb.
     6	
     7	Two configs for a fair comparison with our LFM agent:
     8	  native : K=5 images at full resolution (their deployment; ~2.5k image tokens each)
     9	  matched: K=1 image at <= max_pixels (compute-matched to our ~1k-token prompt)
    10	"""
    11	from __future__ import annotations
    12	
    13	import base64
    14	import io
    15	import json
    16	import re
    17	import sys
    18	import time
    19	from pathlib import Path
    20	
    21	import requests
    22	from PIL import Image
    23	
    24	sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "train"))
    25	import agent_format as af  # noqa: E402  (smart_resize only)
    26	
    27	from android_world.agents import base_agent  # noqa: E402
    28	from android_world.env import adb_utils, interface, json_action  # noqa: E402
    29	import app_resolver  # noqa: E402
    30	
    31	SYSTEM_PROMPT = (Path(__file__).parent / "guiowl_system_prompt.txt").read_text()
    32	FIRST_USER = ("Please generate the next move according to the UI screenshot, instruction and previous actions.\n\n"
    33	              "Instruction: {goal}\n\nPrevious actions:\n{history}")
    34	
    35	
    36	def _b64(img: Image.Image) -> str:
    37	    b = io.BytesIO()
    38	    img.save(b, format="PNG")
    39	    return "data:image/png;base64," + base64.b64encode(b.getvalue()).decode()
    40	
    41	
    42	class GUIOwlAgent(base_agent.EnvironmentInteractingAgent):
    43	    def __init__(self, env: interface.AsyncEnv, server_url: str, name: str = "guiowl15_2b",
    44	                 n_images: int = 5, max_pixels: int = 0, temperature: float = 0.0, max_tokens: int = 256,
    45	                 wait_after_action: float = 1.0, installed_apps: bool = False):
    46	        super().__init__(env, name)
    47	        self.server_url = server_url.rstrip("/")
    48	        self.n_images, self.max_pixels = n_images, max_pixels
    49	        self.temperature, self.max_tokens, self.wait = temperature, max_tokens, wait_after_action
    50	        self.turns: list[tuple[Image.Image, str]] = []  # (screenshot sent, assistant reply)
    51	        # installed_apps (fairness mirror of the LFM3 v4 input): the device's app list is appended to the instruction
    52	        self.installed_apps = installed_apps
    53	        self.apps = None
    54	
    55	    def reset(self, go_home_on_reset: bool = False):
    56	        super().reset(go_home_on_reset)
    57	        self.env.hide_automation_ui()
    58	        self.turns = []
    59	        if self.installed_apps:
    60	            self.apps = app_resolver.device_app_names(self.env.controller)
    61	            assert self.apps, "installed-app list is empty"
    62	
    63	    def _prep(self, pixels) -> Image.Image:
    64	        img = Image.fromarray(pixels).convert("RGB")
    65	        if self.max_pixels > 0:
    66	            h, w = af.smart_resize(img.height, img.width, max_pixels=self.max_pixels)
    67	            img = img.resize((w, h), Image.BICUBIC)
    68	        return img
    69	
    70	    def _messages(self, goal: str, cur: Image.Image):
    71	        keep = self.turns[-(self.n_images - 1):] if self.n_images > 1 else []
    72	        older = self.turns[: len(self.turns) - len(keep)]
    73	        hist = "\n".join(f"Step{j + 1}: {self._action_line(r)}" for j, (_, r) in enumerate(older)) or "No previous action."
    74	        msgs = [{"role": "system", "content": [{"type": "text", "text": SYSTEM_PROMPT}]}]
    75	        imgs = [t[0] for t in keep] + [cur]
    76	        replies = [t[1] for t in keep]
    77	        instr = goal + (f"\nInstalled apps: {', '.join(self.apps)}" if self.installed_apps else "")
    78	        msgs.append({"role": "user", "content": [{"type": "text", "text": FIRST_USER.format(goal=instr, history=hist)},
    79	                                                 {"type": "image_url", "image_url": {"url": _b64(imgs[0])}}]})
    80	        for i, rep in enumerate(replies):
    81	            msgs.append({"role": "assistant", "content": [{"type": "text", "text": rep}]})
    82	            msgs.append({"role": "user", "content": [{"type": "image_url", "image_url": {"url": _b64(imgs[i + 1])}}]})
    83	        return msgs
    84	
    85	    @staticmethod
    86	    def _action_line(reply: str) -> str:
    87	        m = re.search(r"Action:\s*(.+)", reply)
    88	        return m.group(1).strip().split("<tool_call>")[0].strip() if m else reply.strip()[:120]
    89	
    90	    @staticmethod
    91	    def _parse(reply: str):
    92	        try:
    93	            blob = reply.split("<tool_call>")[-1].split("</tool_call>")[0].strip()
    94	            call = json.loads(blob)
    95	            args = call["arguments"] if isinstance(call["arguments"], dict) else json.loads(call["arguments"])
    96	            args["action"] = args["action"].replace("tap", "click")
    97	            return args
    98	        except Exception:
    99	            return None
   100	
   101	    def step(self, goal: str) -> base_agent.AgentInteractionResult:
   102	        pixels = self.get_post_transition_state().pixels
   103	        H, W = pixels.shape[:2]
   104	        cur = self._prep(pixels)
   105	        payload = {"messages": self._messages(goal, cur), "temperature": self.temperature, "max_tokens": self.max_tokens}
   106	        t0 = time.time()
   107	        r = requests.post(f"{self.server_url}/v1/chat/completions", json=payload, timeout=900)
   108	        r.raise_for_status()
   109	        out = r.json()
   110	        reply = out["choices"][0]["message"].get("content") or ""
   111	        lat = time.time() - t0
   112	        thumb = io.BytesIO()
   113	        Image.fromarray(pixels).convert("RGB").resize((360, 800)).save(thumb, format="JPEG", quality=70)
   114	        args = self._parse(reply)
   115	        data = {"screenshot_thumb_jpg": thumb.getvalue(), "model_content": reply, "latency_s": lat,
   116	                "usage": out.get("usage", {}), "timings": out.get("timings", {}), "parsed_action": args,
   117	                "first_attempt_strict_ok": args is not None, "first_attempt_lenient_ok": args is not None}
   118	        self.turns.append((cur, reply))
   119	        if args is None:
   120	            data["error"] = "unparseable"
   121	            return base_agent.AgentInteractionResult(False, data)
   122	        a = args["action"]
   123	        sx = lambda p: round(p[0] / 1000 * (W - 1))  # noqa: E731  (their harness: x*W/999)
   124	        sy = lambda p: round(p[1] / 1000 * (H - 1))  # noqa: E731
   125	        try:
   126	            if a == "terminate":
   127	                return base_agent.AgentInteractionResult(True, data)
   128	            if a == "answer":
   129	                self.env.execute_action(json_action.JSONAction(action_type="answer", text=str(args.get("text", ""))))
   130	                data["ended_by"] = "answer"
   131	                return base_agent.AgentInteractionResult(True, data)
   132	            if a in ("click", "long_press"):
   133	                p = args["coordinate"]
   134	                self.env.execute_action(json_action.JSONAction(action_type=a, x=sx(p), y=sy(p)))
   135	            elif a == "swipe":
   136	                p, q = args["coordinate"], args["coordinate2"]
   137	                adb_utils.issue_generic_request(adb_utils.generate_swipe_command(sx(p), sy(p), sx(q), sy(q), 500),
   138	                                                self.env.controller)
   139	            elif a == "type":
   140	                self.env.execute_action(json_action.JSONAction(action_type="input_text", text=str(args.get("text", ""))))
   141	            elif a == "open":
   142	                self.env.execute_action(json_action.JSONAction(action_type="open_app", app_name=str(args.get("text", ""))))
   143	            elif a == "system_button":
   144	                m = {"Back": "navigate_back", "Home": "navigate_home", "Enter": "keyboard_enter"}.get(args.get("button"))
   145	                if m:
   146	                    self.env.execute_action(json_action.JSONAction(action_type=m))
   147	                else:
   148	                    data["error"] = f"unsupported button {args.get('button')}"
   149	            elif a == "wait":
   150	                time.sleep(float(args.get("time", 1)))
   151	            else:
   152	                data["error"] = f"unsupported action {a}"
   153	        except Exception as e:  # keep going like the reference harness
   154	            data["error"] = f"execute_failed: {e}"
   155	        time.sleep(self.wait)
   156	        return base_agent.AgentInteractionResult(False, data)

