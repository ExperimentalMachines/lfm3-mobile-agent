     1	#!/bin/bash
     2	# Export a merged HF model to the phone-format GGUF (language model) used in AndroidWorld.
     3	# The vision tower/projector are untouched by our LoRA (language-model-only), so the base model's
     4	# mmproj GGUF is reused unchanged.
     5	# Usage: scripts/local_export_gguf.sh <hf_repo_or_dir> <out_dir> [quant=Q4_K_M]
     6	set -euo pipefail
     7	SRC=$1; OUT=$2; Q=${3:-Q4_K_M}
     8	cd "$(dirname "$0")/.."
     9	mkdir -p "$OUT"
    10	if [ -d "$SRC" ]; then M="$SRC"; else
    11	  M="$OUT/hf"; uvx --from huggingface_hub hf download "$SRC" --local-dir "$M" --exclude "lora_adapter/*" --exclude "eval/*" --exclude "training_logs/*" > /dev/null
    12	fi
    13	[ -d .venv-convert ] || { uv venv -q -p 3.12 .venv-convert && uv pip install -q -p .venv-convert/bin/python -r tools/llama.cpp/requirements/requirements-convert_hf_to_gguf.txt; }
    14	NAME=$(basename "$SRC")
    15	.venv-convert/bin/python tools/llama.cpp/convert_hf_to_gguf.py "$M" --outtype f16 --outfile "$OUT/$NAME-F16.gguf" 2>&1 | tail -2
    16	llama-quantize "$OUT/$NAME-F16.gguf" "$OUT/$NAME-$Q.gguf" "$Q" 2>&1 | tail -1
    17	rm -f "$OUT/$NAME-F16.gguf"
    18	[ -d "$SRC" ] || rm -rf "$M"   # keep disk lean
    19	ls -la "$OUT"/*.gguf
     1	"""AndroidWorld runner for the LFM screenshot agent (fork of android_world/run.py).
     2	
     3	Differences from upstream run.py: adb path default fixed for Homebrew, configurable
     4	gRPC port (another emulator owns 5554/8554 on this machine), and our agent.
     5	
     6	Example:
     7	  python eval/androidworld/run_aw.py --console_port=5556 --grpc_port=8556 \
     8	      --server_url=http://127.0.0.1:8080 --agent_label=lfm3vl2b_ft \
     9	      --output_path=results/androidworld
    10	"""
    11	
    12	import os
    13	import sys
    14	from pathlib import Path
    15	
    16	from absl import app, flags
    17	
    18	sys.path.insert(0, str(Path(__file__).resolve().parent))
    19	
    20	from android_world import checkpointer as checkpointer_lib  # noqa: E402
    21	from android_world import registry, suite_utils  # noqa: E402
    22	from android_world.env import env_launcher  # noqa: E402
    23	
    24	from lfm_agent import LFMScreenAgent  # noqa: E402
    25	from guiowl_agent import GUIOwlAgent  # noqa: E402
    26	
    27	os.environ.setdefault("GRPC_VERBOSITY", "ERROR")
    28	
    29	F = flags.FLAGS
    30	flags.DEFINE_string("adb_path", "/opt/homebrew/bin/adb", "adb binary")
    31	flags.DEFINE_boolean("perform_emulator_setup", False, "first-time app install/setup")
    32	flags.DEFINE_integer("console_port", 5556, "emulator console port")
    33	flags.DEFINE_integer("grpc_port", 8556, "emulator gRPC port")
    34	flags.DEFINE_string("suite_family", "android_world", "suite family")
    35	flags.DEFINE_integer("task_random_seed", 30, "seed for task params")
    36	flags.DEFINE_list("tasks", None, "subset of tasks")
    37	flags.DEFINE_integer("n_task_combinations", 1, "instances per task")
    38	flags.DEFINE_string("checkpoint_dir", "", "resume dir")
    39	flags.DEFINE_string("output_path", "results/androidworld", "output root")
    40	flags.DEFINE_string("agent_label", "lfm_screen_agent", "name stored in results")
    41	flags.DEFINE_string("server_url", "http://127.0.0.1:8080", "OpenAI-compatible server")
    42	flags.DEFINE_boolean("enable_thinking", True, "chat_template enable_thinking")
    43	flags.DEFINE_integer("max_pixels", 880 * 880, "screenshot pixel budget")
    44	flags.DEFINE_boolean("fixed_task_seed", False, "identical params across combos")
    45	flags.DEFINE_string("agent", "lfm", "lfm | guiowl")
    46	flags.DEFINE_boolean("runtime_feedback", False, "LFM agent: lexical open_app resolution + failure/no-change notes in history (ablation)")
    47	flags.DEFINE_boolean("force_think", False, "LFM agent: if the intent is empty, force a one-line intent (</think> banned) and re-ask for the action (ablation)")
    48	flags.DEFINE_integer("guiowl_images", 5, "GUI-Owl screenshots kept in context")
    49	flags.DEFINE_string("prompt_version", "v1", "LFM agent: v1 (models v1-v3) | v4 (answer/complete rules + installed-app list)")
    50	flags.DEFINE_boolean("installed_apps", False, "GUI-Owl agent: append the device's installed-app list (mirrors LFM3 v4)")
    51	flags.DEFINE_integer("guiowl_max_pixels", 0, "0 = full resolution (native)")
    52	
    53	
    54	def main(argv):
    55	    del argv
    56	    env = env_launcher.load_and_setup_env(
    57	        console_port=F.console_port, emulator_setup=F.perform_emulator_setup,
