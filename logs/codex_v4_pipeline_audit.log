     1	"""Strict, type-aware answer comparison for v4 teacher labels (replaces the permissive agree() used at generation time).
     2	
     3	Codex research (results/codex/codex_overnight_research.md) found false agreements in the generation-time check:
     4	1.5/15, -2/2, 1:30/130, York/New York, "no alerts"/alerts. Rules here:
     5	  * normalise: lower-case, collapse whitespace, strip surrounding quotes and a trailing period;
     6	  * numeric answers: the ordered list of number tokens (sign, decimals, thousands separators, times like 1:30 kept
     7	    intact) must be identical; remaining words of the shorter answer must be a whole-word subset of the longer one
     8	    ("382 followers" ~ "382", but "1.5" != "15", "-2" != "2", "1:30" != "130");
     9	  * non-numeric answers: exact equality after normalisation (no substring matches: "york" != "new york");
    10	  * negation guard: if either side contains a negation word the other lacks, reject.
    11	"""
    12	import re
    13	
    14	NUM = re.compile(r"[-+]?\d[\d,]*(?:\.\d+)?(?::\d+)*")
    15	NEG = {"no", "not", "none", "never", "nothing", "without", "zero", "isn't", "aren't", "doesn't", "don't", "can't", "cannot"}
    16	
    17	
    18	def norm(s):
    19	    s = re.sub(r"\s+", " ", str(s or "").strip().lower())
    20	    s = s.strip("\"'`“”‘’ ")
    21	    return s[:-1] if s.endswith(".") and not re.search(r"\d\.$", s) else s
    22	
    23	
    24	def nums(s):
    25	    return [n.replace(",", "") for n in NUM.findall(s)]
    26	
    27	
    28	def words(s):
    29	    return set(re.findall(r"[a-z]+(?:'[a-z]+)?", NUM.sub(" ", s)))
    30	
    31	
    32	def same_answer(a, b):
    33	    a, b = norm(a), norm(b)
    34	    if not a or not b or "none" in (a, b):
    35	        return False
    36	    if (words(a) & NEG) != (words(b) & NEG):
    37	        return False
    38	    na, nb = nums(a), nums(b)
    39	    if na or nb:
    40	        if na != nb:
    41	            return False
    42	        short, long_ = sorted((a, b), key=len)
    43	        return words(short) <= words(long_)
    44	    return a == b
    45	
    46	
    47	def preferred(answer, verify):
    48	    """The shorter of two agreeing answers when it only drops unit/filler words (e.g. '382 Followers' -> '382')."""
    49	    a, v = str(answer or "").strip(), str(verify or "").strip()
    50	    if v and len(v) < len(a) and same_answer(a, v) and nums(norm(a)) == nums(norm(v)) and nums(norm(a)):
    51	        return v
    52	    return a
    53	
    54	
    55	def safe_short(long_answer, short):
    56	    """ScreenQA shortening is accepted only if it keeps every number and negation of the original and is a substring."""
    57	    L, S = norm(long_answer), norm(short)
    58	    if not S or S not in L or len(S) >= len(L):
    59	        return False
    60	    if (words(L) & NEG) - (words(S) & NEG):
    61	        return False
    62	    return all(n in nums(S) for n in nums(L))
    63	
    64	
    65	if __name__ == "__main__":
    66	    bad = [("1.5", "15"), ("-2", "2"), ("1:30", "130"), ("York", "New York"), ("no alerts", "alerts")]
    67	    good = [("382 Followers", "382"), ("C$43.00", "C$43.00"), ("6:16 AM", "6:16 am"), ("4.2", "4.2."), ("Sun", "sun"),
    68	            ("410,000+ results", "410,000+"), ("₹614", "₹614")]
    69	    for x, y in bad:
    70	        assert not same_answer(x, y), (x, y)
    71	    for x, y in good:
    72	        assert same_answer(x, y), (x, y)
    73	    assert preferred("382 Followers", "382") == "382" and preferred("York", "New York") == "York"
    74	    assert safe_short("The temperature today is 51°.", "51°") and not safe_short("There are no alerts", "alerts")
    75	    assert not safe_short("3 of 5 stars", "3") and safe_short("Wednesday, Feb 1st, 2017", "Feb 1st, 2017")
    76	    print("answer-check tests pass")
