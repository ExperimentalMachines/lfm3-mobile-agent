     1	"""Select AndroidControl train episodes to turn into navigate-then-answer episodes for v4 (runs locally, CPU only).
     2	
     3	Input: v3 training metadata (no images) written by the v4 build prep: data/v4work/v3_train_meta.parquet
     4	Output: data/v4work/v4_candidates.json  [{key, shard, row_in_shard (final screen), goal, kind, split, n_steps, ...}]
     5	
     6	Rules (all recorded in the output's "rules" block):
     7	  * AndroidControl only: the only source here with complete, contiguous episodes ending on a final screen
     8	    (a `status complete` row whose screenshot is the screen after the last action). GUI-Odyssey/AMEX rows are
     9	    step samples (~3 per episode) and cannot form a navigation prefix.
    10	  * last row = status complete at step >= 1, and its text history must number up to that step (rows are step samples
    11	    of the episode; the final row's prompt carries the full history, so it represents the whole navigation).
    12	  * contamination guard: drop episodes whose goal or any open_app name mentions an AndroidWorld app or app type
    13	    (names below, plus every launcher name AndroidWorld can resolve); conservative on purpose.
    14	  * kind = "question" if the original goal is information-seeking (check/view/find/...), else "compound"
    15	    (the original task stays in the goal and a question about the final screen is appended).
    16	  * dev split: 200 episodes held out from v4 training entirely (their original action version is removed too), and
    17	    their screenshots must not occur anywhere else in the training data (screen-disjoint by img_sha).
    18	"""
    19	import collections
    20	import json
    21	import random
    22	import re
    23	
    24	import pyarrow.parquet as pq
    25	
    26	SEED = 4
    27	N_TOTAL = 3800
    28	N_DEV = 200
    29	AW_TERMS = ["android world", "markor", "joplin", "broccoli", "recipe", "expense", "opentracks", "open tracks",
    30	            "osmand", "vlc", "retro", "music player", "audio recorder", "voice recorder", "recorder", "calendar",
    31	            "clock", "alarm", "timer", "stopwatch", "contact", "dialer", "phone app", "sms", "message", "messenger",
    32	            "files", "file manager", "gallery", "photos", "camera", "draw", "tasks", "to-do", "todo", "note", "notes",
    33	            "chrome", "browser", "settings", "wifi", "wi-fi", "bluetooth", "brightness"]
    34	AW_RE = re.compile("|".join(re.escape(t) for t in AW_TERMS), re.I)
    35	INFO_RE = re.compile(r"^\s*(please\s+)?(check|show|find|view|see|look|search|what|how|tell|get|display|read|know|"
    36	                     r"open\b.{0,60}\b(to|and)\s+(see|check|view|find|look|know|read))", re.I)
    37	
    38	
    39	def goal_of(msgs):
    40	    return msgs[1]["content"].split("\n", 1)[0].removeprefix("Goal: ").strip()
    41	
    42	
    43	def main():
    44	    rows = pq.read_table("data/v4work/v3_train_meta.parquet").to_pylist()
    45	    by = collections.defaultdict(list)
    46	    sha_count = collections.Counter(r["img_sha"] for r in rows)
    47	    for r in rows:
    48	        by[(r["source"], r["episode_id"])].append(r)
    49	    st = collections.Counter()
    50	    pool = []
    51	    for (src, eid), rs in by.items():
    52	        if src != "androidcontrol":
    53	            continue
    54	        rs.sort(key=lambda r: r["step_idx"])
    55	        st["ac_episodes"] += 1
    56	        acts = [json.loads(r["gt_action"]) for r in rs]
    57	        if rs[-1]["step_idx"] < 1:
    58	            st["drop_too_short"] += 1
    59	            continue
    60	        # rows are step samples, but every row's prompt carries the full text history of the earlier steps, so the
    61	        # final row alone represents the whole navigation; check that its history really covers the episode
    62	        hist = rs[-1]["messages"][1]["content"].split("Previous steps:\n", 1)[1].rsplit("\nWhat is the next action?", 1)[0]
    63	        nums = [int(m) for m in re.findall(r"^(\d+)\. ", hist, re.M)]
    64	        if not nums or nums[-1] != rs[-1]["step_idx"]:
    65	            st["drop_history_mismatch"] += 1
    66	            continue
    67	        if acts[-1]["action_type"] != "status" or acts[-1].get("goal_status") != "complete":
    68	            st["drop_no_terminal"] += 1
    69	            continue
    70	        g = goal_of(rs[0]["messages"])
    71	        apps = [a["app_name"] for a in acts if a["action_type"] == "open_app"]
    72	        if AW_RE.search(g) or any(AW_RE.search(x) for x in apps):
    73	            st["drop_aw_app_guard"] += 1
    74	            continue
    75	        if any(goal_of(r["messages"]) != g for r in rs):
    76	            st["drop_goal_varies"] += 1
    77	            continue
    78	        last = rs[-1]
    79	        pool.append({"key": f"{src}/{eid}", "source": src, "episode_id": eid, "shard": last["shard"],
    80	                     "row_in_shard": last["row_in_shard"], "img_sha": last["img_sha"], "goal": g,
    81	                     "kind": "question" if INFO_RE.search(g) else "compound", "n_steps": rs[-1]["step_idx"] + 1,
    82	                     "rows_present": len(rs), "apps": apps,
    83	                     "episode_shas": [r["img_sha"] for r in rs]})
    84	    st["pool"] = len(pool)
    85	    st["pool_question"] = sum(c["kind"] == "question" for c in pool)
    86	    rnd = random.Random(SEED)
    87	    q = [c for c in pool if c["kind"] == "question"]
    88	    o = [c for c in pool if c["kind"] == "compound"]
    89	    rnd.shuffle(q)
    90	    rnd.shuffle(o)
    91	    chosen = q + o[: max(0, N_TOTAL - len(q))]
    92	    rnd.shuffle(chosen)
    93	    # dev: screens of the episode must be unique to that episode in the whole training set
    94	    dev, train = [], []
    95	    for c in chosen:
    96	        own = collections.Counter(c["episode_shas"])
    97	        disjoint = all(sha_count[s] == own[s] for s in own)
    98	        if len(dev) < N_DEV and disjoint:
    99	            c["split"] = "dev"
   100	            dev.append(c)
   101	        else:
   102	            c["split"] = "train"
   103	            train.append(c)
   104	    st["dev"], st["train"] = len(dev), len(train)
