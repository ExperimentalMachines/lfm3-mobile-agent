     1	"""GUI-Owl-1.5 agent for our AndroidWorld harness, faithful to X-PLUG/MobileAgent
     2	(Mobile-Agent-v3.5/android_world_v3.5/android_world/agents/gui_owl.py @ the cloned revision):
     3	same system prompt, `Action: ...` + <tool_call>{json}</tool_call> output, 0-1000 coordinate grid,
     4	multi-turn messages keeping the last K screenshots (older steps collapsed to "Step j: <Action sentence>"),
     5	`answer` -> store answer and end, `terminate` -> end, coordinate swipes executed exactly via adb.
     6	
     7	Two configs for a fair comparison with our LFM agent:
     8	  native : K=5 images at full resolution (their deployment; ~2.5k image tokens each)
     9	  matched: K=1 image at <= max_pixels (compute-matched to our ~1k-token prompt)
    10	"""
    11	from __future__ import annotations
    12	
    13	import base64
    14	import io
    15	import json
    16	import re
    17	import sys
    18	import time
    19	from pathlib import Path
    20	
    21	import requests
    22	from PIL import Image
    23	
    24	sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "train"))
