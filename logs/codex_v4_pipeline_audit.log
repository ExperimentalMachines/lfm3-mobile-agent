+    os.environ[k]=str(OUT/'cache'/k)
+    Path(os.environ[k]).mkdir(parents=True,exist_ok=True)
+os.environ.update(HF_HUB_OFFLINE='1',HF_DATASETS_OFFLINE='1',PYTHONDONTWRITEBYTECODE='1',CUDA_VISIBLE_DEVICES='')
