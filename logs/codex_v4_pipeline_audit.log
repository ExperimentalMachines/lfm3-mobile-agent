     1	"""Deployment-style `open_app` resolution (opt-in runtime component, Codex final-audit recommendation #1).
     2	
     3	A phone runtime knows the launcher labels of installed apps. When the model's app name does not resolve, map it to the
     4	best *lexically* matching installed label (token prefix / near-spelling only — no hand-written synonyms, so e.g.
     5	"Stopwatch" is NOT mapped to Clock). If nothing matches, the action is not executed and the failure is reported back in
     6	the action history. Installed labels = android_world's own name table restricted to packages present on the device.
     7	"""
     8	import difflib
     9	import re
    10	
    11	from android_world.env import adb_utils
    12	
    13	
    14	_GENERIC = {"google", "simple", "pro", "app", "the", "my", "android"}  # carry no app identity
    15	
    16	
    17	def _tokens(s):
    18	    return [t for t in re.sub(r"[^a-z0-9]+", " ", str(s).lower()).split() if t not in _GENERIC]
    19	
    20	
    21	def _tok_match(a, b):
    22	    if a == b:
    23	        return True
    24	    if min(len(a), len(b)) >= 4 and (a.startswith(b) or b.startswith(a)):
    25	        return True  # file/files, contact/contacts
    26	    return min(len(a), len(b)) >= 5 and difflib.SequenceMatcher(None, a, b).ratio() >= 0.8  # marker/markor
    27	
    28	
    29	def score(query, label):
    30	    q, l = _tokens(query), _tokens(label)
    31	    if not q or not l:
    32	        return 0.0
    33	    hit = sum(any(_tok_match(a, b) for b in l) for a in q)
    34	    return hit / len(q)
    35	
    36	
    37	def resolves_natively(name):
    38	    name = str(name or "")
    39	    return name in adb_utils._DEFAULT_URIS or adb_utils.get_adb_activity(name) is not None
    40	
