    31	SYSTEM_PROMPT = (Path(__file__).parent / "guiowl_system_prompt.txt").read_text()
    32	FIRST_USER = ("Please generate the next move according to the UI screenshot, instruction and previous actions.\n\n"
    33	              "Instruction: {goal}\n\nPrevious actions:\n{history}")
    34	
    35	
    36	def _b64(img: Image.Image) -> str:
    37	    b = io.BytesIO()
    38	    img.save(b, format="PNG")
    39	    return "data:image/png;base64," + base64.b64encode(b.getvalue()).decode()
    40	
    41	
    42	class GUIOwlAgent(base_agent.EnvironmentInteractingAgent):
    43	    def __init__(self, env: interface.AsyncEnv, server_url: str, name: str = "guiowl15_2b",
    44	                 n_images: int = 5, max_pixels: int = 0, temperature: float = 0.0, max_tokens: int = 256,
    45	                 wait_after_action: float = 1.0, installed_apps: bool = False):
    46	        super().__init__(env, name)
    47	        self.server_url = server_url.rstrip("/")
    48	        self.n_images, self.max_pixels = n_images, max_pixels
    49	        self.temperature, self.max_tokens, self.wait = temperature, max_tokens, wait_after_action
    50	        self.turns: list[tuple[Image.Image, str]] = []  # (screenshot sent, assistant reply)
    51	        # installed_apps (fairness mirror of the LFM3 v4 input): the device's app list is appended to the instruction
    52	        self.installed_apps = installed_apps
    53	        self.apps = None
    54	
    55	    def reset(self, go_home_on_reset: bool = False):
    56	        super().reset(go_home_on_reset)
    57	        self.env.hide_automation_ui()
    58	        self.turns = []
    59	        if self.installed_apps:
    60	            self.apps = app_resolver.device_app_names(self.env.controller)
    61	            assert self.apps, "installed-app list is empty"
    62	
    63	    def _prep(self, pixels) -> Image.Image:
    64	        img = Image.fromarray(pixels).convert("RGB")
    65	        if self.max_pixels > 0:
    66	            h, w = af.smart_resize(img.height, img.width, max_pixels=self.max_pixels)
    67	            img = img.resize((w, h), Image.BICUBIC)
    68	        return img
    69	
