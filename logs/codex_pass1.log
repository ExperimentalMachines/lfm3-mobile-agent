    31	
    32	def sort_key(filename: str) -> tuple[str, int|str]:
    33	  """Returns the sort key for a filenames.
    34	
    35	  Attempts to sort by the filename and then by the instance number. However,
    36	  if the instance number is not an integer, it will be sorted as a string.
    37	
    38	  Args:
    39	    filename: The filename to sort.
    40	  """
    41	  parts = filename.split(INSTANCE_SEPARATOR, maxsplit=1)
    42	  if len(parts) == 1:
    43	    # When there is no instance number, sort by filename.
    44	    return (parts[0], 0)
    45	  name, num = parts
    46	  try:
    47	    num = int(num)
    48	  except ValueError:
    49	    num = 0
    50	  return (name, num)
