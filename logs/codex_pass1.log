    60	
    61	
    62	def history_text(history: list[tuple[str, str]]) -> str:
    63	    """history: list of (intent, action_json_str), oldest first."""
    64	    if not history:
    65	        return "None"
    66	    start = max(0, len(history) - HISTORY_STEPS)
