    86	def convert_action(a, W, H):
    87	    t = a["action_type"]
    88	    if t in ("click", "long_press"):
    89	        return {"action_type": t, "point_2d": af.px_to_norm(a["x"], a["y"], W, H)}
    90	    if t == "input_text":
    91	        return {"action_type": "input_text", "text": a.get("text") or ""}
    92	    if t == "scroll":
    93	        return {"action_type": "scroll", "direction": a["direction"]}
    94	    if t == "open_app":
    95	        return {"action_type": "open_app", "app_name": a.get("app_name") or ""}
    96	    if t in ("navigate_back", "navigate_home", "wait"):
    97	        return {"action_type": t}
    98	    return None
