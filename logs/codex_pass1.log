   180	def create_run_directory(location: str) -> str:
   181	  """Creates the UUID directory name to save run results.
   182	
   183	  Args:
   184	    location: Location to write the directory.
   185	
   186	  Returns:
   187	    A UUID directory name.
   188	  """
   189	  timestamp = datetime.datetime.now().strftime('%Y%m%dT%H%M%S%f')
   190	  return os.path.join(location, f'run_{timestamp}')
