   491	def _allocate_step_budget(task_complexity: float) -> int:
   492	  """Allocates number of steps dynamically based on the complexity score.
   493	
   494	  Args:
   495	    task_complexity: Complexity score of the task.
   496	
   497	  Returns:
   498	    Allocated number of steps for the task.
   499	  """
   500	  if task_complexity is None:
   501	    raise ValueError('Task complexity must be provided.')
   502	  return int(10 * (task_complexity))
