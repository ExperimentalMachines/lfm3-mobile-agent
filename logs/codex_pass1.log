   229	def to_row(r):
   230	    hint = r["instruction"] if r["mode"] == "low" else None
   231	    msgs = af.build_messages(r["goal"], [tuple(h) for h in r["history"]], step_instruction=hint, for_trl=True)
   232	    msgs.append({"role": "assistant", "content": af.action_to_str(r["gt_action"]),
   233	                 "reasoning_content": r["instruction"] or ""})
   234	    return {
   235	        "images": [{"bytes": r["jpg"], "path": None}],
   236	        "messages": msgs,
   237	        "episode_id": r["episode_id"], "step_idx": r["step_idx"], "mode": r["mode"],
   238	        "gt_action": json.dumps(r["gt_action"], ensure_ascii=False),
   239	        "gt_bbox": json.dumps(r["gt_bbox"]) if r["gt_bbox"] else "",
   240	        "subsplits": r["subsplits"], "is_terminal": r["is_terminal"],
   241	        "orig_w": r["orig_size"][0], "orig_h": r["orig_size"][1],
   242	    }
