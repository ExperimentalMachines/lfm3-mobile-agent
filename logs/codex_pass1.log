   589	def _extract_task_metadata() -> pd.DataFrame:
   590	  """Extracts metadata from task_metadata.json."""
   657	  # Output:
   658	  # | task_template               |   n_trials |   average_success_rate |
   659	  # |:----------------------------|-----------:|-----------------------:|
   660	  # | ClockStopWatchPausedVerify  |          2 |                   0.5  |
   661	  # | ClockStopWatchRunning       |          2 |                   1    |
   662	  # | ==========Average========== |          2 |                   0.75 |
   663	
   664	  Args:
   665	    episodes: Results from running `run_task_suite`.
   666	    print_summary: Whether to print the dataframe with a summary row.
   667	
   668	  Returns:
   669	    A dataframe aggregating results of run.
   670	  """
   671	
   672	  df = pd.DataFrame(list(episodes))
   673	
   674	  # Add exeception info for backwards compatibility.
   675	  df = df.assign(**{
   676	      constants.EpisodeConstants.EXCEPTION_INFO: df.get(
   677	          constants.EpisodeConstants.EXCEPTION_INFO, np.nan
   678	      )
   679	  })
   680	
   681	  result_df = df.groupby(
   682	      constants.EpisodeConstants.TASK_TEMPLATE, dropna=True
   683	  ).agg({
   684	      constants.EpisodeConstants.IS_SUCCESSFUL: ['count', 'mean'],
   685	      constants.EpisodeConstants.EPISODE_LENGTH: 'mean',
   686	      constants.EpisodeConstants.RUN_TIME: 'sum',
   687	      constants.EpisodeConstants.EXCEPTION_INFO: [
   688	          ('none_count', lambda x: x.notnull().sum())
   689	      ],
   690	  })
   691	  result_df = result_df.sort_index()
   692	  result_df.columns = [
   693	      'num_complete_trials',
   694	      'mean_success_rate',
   695	      'mean_episode_length',
   696	      'total_runtime_s',
   697	      'num_fail_trials',
   698	  ]
   699	  result_df['total_runtime_s'] = result_df['total_runtime_s'].map(
   700	      lambda x: float('{:.1f}'.format(x))
