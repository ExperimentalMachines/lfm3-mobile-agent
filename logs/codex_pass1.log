    17	from typing import Any
    18	
    19	HISTORY_STEPS = 8
    20	
    21	SYSTEM_PROMPT = """You are a phone-use agent operating an Android phone to complete the user's goal.
    22	Each turn you see the goal, your previous steps, and the current screenshot. Reply with ONE next action as JSON.
    23	Coordinates are integers normalized to 0-1000 (x from left, y from top) of the screenshot.
    24	Actions:
    25	{"action_type":"click","point_2d":[x,y]}
    26	{"action_type":"long_press","point_2d":[x,y]}
    27	{"action_type":"input_text","text":"..."}  (types into the focused field)
    28	{"action_type":"scroll","direction":"up|down|left|right"}  (down = reveal content below)
    29	{"action_type":"open_app","app_name":"..."}
    30	{"action_type":"navigate_back"}
    31	{"action_type":"navigate_home"}
    32	{"action_type":"keyboard_enter"}
    33	{"action_type":"wait"}
    34	{"action_type":"answer","text":"..."}  (reply to a question about the screen)
    35	{"action_type":"status","goal_status":"complete|infeasible"}  (finish the task)"""
    36	
    37	VALID_TYPES = {
    38	    "click", "long_press", "input_text", "scroll", "open_app", "navigate_back",
    39	    "navigate_home", "keyboard_enter", "wait", "answer", "status",
    40	}
    41	POINT_TYPES = {"click", "long_press"}
