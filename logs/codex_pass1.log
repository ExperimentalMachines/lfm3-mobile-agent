     1	"""Summarize an AndroidWorld run directory (episode .pkl.gz files) into JSON + CSV.
     2	
     3	Differences vs upstream's printed table: episodes that raised an exception are counted as
     4	FAILURES (upstream drops them as NaN, inflating success), and we add on-device-relevant
     5	stats (per-step model latency, prompt tokens, parse failures).
     6	
     7	Usage: python summarize_aw.py <run_dir> --out results/androidworld/<name>.summary.json
     8	"""
     9	import argparse
    10	import csv
    11	import gzip
    12	import json
    13	import math
    14	import pickle
    15	import statistics as stats
    16	import sys
    17	from collections import defaultdict
    18	from pathlib import Path
    19	
    20	ap = argparse.ArgumentParser()
    21	ap.add_argument("run_dir")
    22	ap.add_argument("--out", required=True)
    23	a = ap.parse_args()
    24	
    25	# difficulty labels from AndroidWorld's own task_metadata.json (task_name -> easy/medium/hard)
    26	_md = Path(__file__).resolve().parents[2] / "android_world" / "android_world" / "task_metadata.json"
    27	DIFF = {r["task_name"]: r["difficulty"] for r in json.loads(_md.read_text())} if _md.exists() else {}
    28	
    29	
    30	def difficulty(task):
    31	    return DIFF.get(task, "unknown")
    32	
    33	
    34	rows = []
    35	lat, ptok, parse_fail, nsteps_total = [], [], 0, 0
    36	for f in sorted(Path(a.run_dir).glob("*.pkl.gz")):
    37	    # pickles are written locally by our own AndroidWorld runs (trusted input)
    38	    ep = pickle.load(gzip.open(f))
    39	    ep = ep[0] if isinstance(ep, list) else ep
    40	    succ = ep.get("is_successful")
    41	    exc = ep.get("exception_info")
    42	    if succ is None or (isinstance(succ, float) and math.isnan(succ)):
    43	        succ = 0.0
    44	    ed = ep.get("episode_data") or {}
    45	    l = [x for x in (ed.get("latency_s") or []) if isinstance(x, (int, float))]
    46	    u = [x.get("prompt_tokens") for x in (ed.get("usage") or []) if isinstance(x, dict) and x.get("prompt_tokens")]
    47	    pa = ed.get("parsed_action") or []
    48	    lat += l
    49	    ptok += u
    50	    parse_fail += sum(1 for x in pa if x is None)
    51	    nsteps_total += len(pa)
    52	    acts = [x.get("action_type") for x in pa if isinstance(x, dict)]
    53	    task = ep.get("task_template") or f.name.rsplit("_", 1)[0]
    54	    rows.append({
    55	        "task": task, "file": f.name, "success": float(succ), "exception": bool(exc),
    56	        "steps": ep.get("episode_length"), "runtime_s": round(ep.get("run_time") or 0, 1),
    57	        "difficulty": difficulty(task),
    58	        "ended_with_status": bool(acts) and acts[-1] == "status",
    59	        "n_answer_actions": acts.count("answer"),
    60	    })
    61	
    62	by_diff = defaultdict(list)
    63	for r in rows:
    64	    by_diff[r["difficulty"]].append(r["success"])
    65	summary = {
    66	    "run_dir": a.run_dir,
    67	    "n_episodes": len(rows),
    68	    "success_rate": sum(r["success"] for r in rows) / max(1, len(rows)),
    69	    "success_rate_by_difficulty": {k: {"n": len(v), "sr": sum(v) / len(v)} for k, v in sorted(by_diff.items())},
    70	    "n_exceptions_counted_as_fail": sum(r["exception"] for r in rows),
    71	    "frac_episodes_self_terminated": sum(r["ended_with_status"] for r in rows) / max(1, len(rows)),
    72	    "mean_steps": stats.mean([r["steps"] or 0 for r in rows]) if rows else None,
    73	    "model_latency_s": {"mean": stats.mean(lat), "p50": stats.median(lat), "p90": sorted(lat)[int(.9 * len(lat)) - 1]} if lat else None,
    74	    "prompt_tokens_mean": stats.mean(ptok) if ptok else None,
    75	    "parse_failure_rate": parse_fail / max(1, nsteps_total),
    76	    "n_steps_total": nsteps_total,
    77	}
    78	Path(a.out).parent.mkdir(parents=True, exist_ok=True)
    79	Path(a.out).write_text(json.dumps({"summary": summary, "episodes": rows}, indent=1))
    80	with open(str(a.out).replace(".json", ".csv"), "w", newline="") as fh:
    81	    w = csv.DictWriter(fh, fieldnames=list(rows[0].keys()) if rows else ["task"])
    82	    w.writeheader()
    83	    w.writerows(rows)
    84	print(json.dumps(summary, indent=1))

