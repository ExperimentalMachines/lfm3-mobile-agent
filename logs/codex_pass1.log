     1	"""Score offline predictions (JSONL from generate.py). Pure python, runs anywhere.
     2	
     3	Protocol (AndroidControl / AITW convention):
     4	  type_match : predicted action_type == gt action_type
     5	  step_sr    : type_match AND argument match:
     6	      click/long_press : point inside GT element bbox (if known) OR within 14% of screen
     7	                         (euclidean distance in normalized [0,1] coords) of GT point
     8	      input_text/answer: normalized exact match OR token-F1 >= 0.5
     9	      scroll           : same direction
    10	      open_app         : case-insensitive equal / containment
    11	      others           : type match suffices
    12	  episode_sr : all steps of an episode correct (offline task completion proxy)
    13	Unparseable outputs count as wrong.
    14	
    15	Usage: python score.py preds.jsonl [--out metrics.json] [--by split_tag]
    16	"""
    17	
    18	import argparse
    19	import json
    20	import math
    21	import re
    22	import sys
    23	from collections import Counter, defaultdict
    24	from pathlib import Path
    25	
    26	sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "train"))
    27	import agent_format as af  # noqa: E402
    28	
    29	CLICK_DIST = 0.14
    30	
    31	
    32	def _norm_text(s):
    33	    return re.sub(r"\s+", " ", re.sub(r"[^\w\s]", " ", (s or "").lower())).strip()
    34	
    35	
    36	def _f1(a, b):
    37	    ta, tb = _norm_text(a).split(), _norm_text(b).split()
    38	    if not ta and not tb:
    39	        return 1.0
    40	    common = sum((Counter(ta) & Counter(tb)).values())
    41	    if common == 0:
    42	        return 0.0
    43	    p, r = common / len(ta), common / len(tb)
    44	    return 2 * p * r / (p + r)
    45	
    46	
    47	def match(pred, gt, gt_bbox=None):
    48	    """pred/gt: action dicts in agent_format (point_2d in 0-1000). gt_bbox: [x1,y1,x2,y2] in 0-1000 or None."""
    49	    if pred is None:
    50	        return False, False
    51	    t = gt["action_type"]
    52	    if pred["action_type"] != t:
    53	        return False, False
    54	    if t in af.POINT_TYPES:
    55	        px, py = pred["point_2d"]
    56	        gx, gy = gt["point_2d"]
    57	        if gt_bbox is not None and gt_bbox[0] <= px <= gt_bbox[2] and gt_bbox[1] <= py <= gt_bbox[3]:
    58	            return True, True
    59	        d = math.hypot((px - gx) / 1000, (py - gy) / 1000)
    60	        return True, d <= CLICK_DIST
    61	    if t in ("input_text", "answer"):
    62	        a, b = _norm_text(pred.get("text")), _norm_text(gt.get("text"))
    63	        return True, a == b or _f1(a, b) >= 0.5
    64	    if t == "scroll":
    65	        return True, pred.get("direction") == gt.get("direction")
    66	    if t == "open_app":
    67	        a, b = _norm_text(pred.get("app_name")), _norm_text(gt.get("app_name"))
    68	        return True, bool(a) and (a == b or a in b or b in a)
