   119	FEATS = Features({
   120	    "images": Sequence(DImage()),
   121	    "messages": [{"role": Value("string"), "content": Value("string"), "reasoning_content": Value("string")}],
   122	    "episode_id": Value("int64"), "step_idx": Value("int32"), "mode": Value("string"),
   123	    "gt_action": Value("string"), "gt_bbox": Value("string"), "subsplits": Sequence(Value("string")),
   124	    "is_terminal": Value("bool"), "orig_w": Value("int32"), "orig_h": Value("int32"),
