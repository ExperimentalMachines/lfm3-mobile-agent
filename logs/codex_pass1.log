   262	            print(f"[{k + 1}/{len(files)}] {time.time() - t0:.0f}s {dict(stats)}", flush=True)
   263	    # scroll convention: AndroidWorld 'down' = content moves up (positive shift)
   264	    agree = sum((d == "down" and s > 2) or (d == "up" and s < -2) for d, s in checks)
   265	    oppose = sum((d == "down" and s < -2) or (d == "up" and s > 2) for d, s in checks)
   266	    stats["scroll_checks_agree_aw"] = agree
   267	    stats["scroll_checks_oppose_aw"] = oppose
   268	    print("scroll convention check (agree, oppose):", agree, oppose, checks[:20], flush=True)
   269	    import shutil
   270	    if files:
   271	        prev = Counter(json.load(open(os.path.join(args.out, "proc_stats.json")))) if os.path.exists(os.path.join(args.out, "proc_stats.json")) else Counter()
   272	        prev.update(stats)
   273	        json.dump(dict(prev), open(os.path.join(args.out, "proc_stats.json"), "w"), indent=2)
   274	    for name in ("train", "val", "test"):
   275	        pdir = os.path.join(args.out, "_parts", name)
   276	        parts = sorted(glob.glob(os.path.join(pdir, "*")))
   277	        if not parts:
   278	            print("empty split", name, flush=True)
   279	            continue
   280	        ds = concatenate_datasets([load_from_disk(x) for x in parts])
   281	        if name != "train":
   282	            ds = ds.sort(["episode_id", "step_idx", "mode"])
   283	        ds.save_to_disk(os.path.join(args.out, name), num_shards=max(1, len(ds) // 5000))
   284	        print(name, len(ds), flush=True)
   285	        if args.push_parquet:
   286	            from huggingface_hub import HfApi
   287	            api = HfApi()
   288	            api.create_repo(args.push_parquet, repo_type="dataset", private=True, exist_ok=True)
   289	            pq_dir = os.path.join(args.out, "_pq", name)
   290	            os.makedirs(pq_dir, exist_ok=True)
   291	            n_sh = max(1, len(ds) // 3000)
   292	            for i in range(n_sh):
   293	                ds.shard(n_sh, i, contiguous=True).to_parquet(os.path.join(pq_dir, f"{args.tag}-{i:03d}.parquet"))
   294	            api.upload_folder(folder_path=pq_dir, path_in_repo=f"data/{name}", repo_id=args.push_parquet, repo_type="dataset")
   295	            print("pushed", name, n_sh, "shards", flush=True)
   296	        del ds
   297	        shutil.rmtree(pdir)
   298	    stats_path = os.path.join(args.out, f"stats-{args.tag}.json")
   299	    if args.merge_only and os.path.exists(os.path.join(args.out, "proc_stats.json")):
   300	        stats.update(json.load(open(os.path.join(args.out, "proc_stats.json"))))
   301	    json.dump(dict(stats), open(stats_path, "w"), indent=2)
   302	    if args.push_parquet:
   303	        from huggingface_hub import HfApi
   304	        HfApi().upload_file(path_or_fileobj=stats_path, path_in_repo=f"stats/stats-{args.tag}.json", repo_id=args.push_parquet, repo_type="dataset")
   305	    print("DONE", time.time() - t0, json.dumps(dict(stats)), flush=True)
     1	"""Shared prompt + action format for the LFM3-VL Android agent.
     2	
     3	Used identically by: training-data builder, offline AndroidControl eval, and the
     4	AndroidWorld agent, so train/test prompts can never drift apart.
     5	
     6	Design (on-device first):
     7	  * one screenshot per step (current screen only) -> bounded prefill cost on phones
     8	  * text history of previous step intents + actions (last HISTORY_STEPS)
     9	  * coordinates are integers normalized to [0, 1000] (LFM3-VL's native point_2d grid)
    10	  * assistant output = short intent in the <think> block + one compact JSON action
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import json
    16	import re
    17	from typing import Any
    18	
    19	HISTORY_STEPS = 8
    20	
    21	SYSTEM_PROMPT = """You are a phone-use agent operating an Android phone to complete the user's goal.
    22	Each turn you see the goal, your previous steps, and the current screenshot. Reply with ONE next action as JSON.
    23	Coordinates are integers normalized to 0-1000 (x from left, y from top) of the screenshot.
    24	Actions:
    25	{"action_type":"click","point_2d":[x,y]}
    26	{"action_type":"long_press","point_2d":[x,y]}
    27	{"action_type":"input_text","text":"..."}  (types into the focused field)
    28	{"action_type":"scroll","direction":"up|down|left|right"}  (down = reveal content below)
    29	{"action_type":"open_app","app_name":"..."}
    30	{"action_type":"navigate_back"}
    31	{"action_type":"navigate_home"}
    32	{"action_type":"keyboard_enter"}
    33	{"action_type":"wait"}
    34	{"action_type":"answer","text":"..."}  (reply to a question about the screen)
    35	{"action_type":"status","goal_status":"complete|infeasible"}  (finish the task)"""
    36	
    37	VALID_TYPES = {
    38	    "click", "long_press", "input_text", "scroll", "open_app", "navigate_back",
    39	    "navigate_home", "keyboard_enter", "wait", "answer", "status",
    40	}
    41	POINT_TYPES = {"click", "long_press"}
    42	_DIRECTIONS = {"up", "down", "left", "right"}
    43	
    44	
    45	def action_to_str(a: dict[str, Any]) -> str:
    46	    """Canonical compact JSON for an action (stable key order, no spaces)."""
    47	    t = a["action_type"]
    48	    out: dict[str, Any] = {"action_type": t}
    49	    if t in POINT_TYPES:
    50	        out["point_2d"] = [int(a["point_2d"][0]), int(a["point_2d"][1])]
    51	    elif t in ("input_text", "answer"):
    52	        out["text"] = a["text"]
    53	    elif t == "scroll":
    54	        out["direction"] = a["direction"]
    55	    elif t == "open_app":
    56	        out["app_name"] = a["app_name"]
    57	    elif t == "status":
    58	        out["goal_status"] = a.get("goal_status", "complete")
    59	    return json.dumps(out, ensure_ascii=False, separators=(",", ":"))
    60	
    61	
    62	def history_text(history: list[tuple[str, str]]) -> str:
    63	    """history: list of (intent, action_json_str), oldest first."""
    64	    if not history:
    65	        return "None"
    66	    start = max(0, len(history) - HISTORY_STEPS)
    67	    lines = []
    68	    for i, (intent, act) in enumerate(history[start:], start=start + 1):
    69	        lines.append(f"{i}. {intent} -> {act}" if intent else f"{i}. {act}")
    70	    return "\n".join(lines)
    71	
    72	
    73	def user_text(goal: str, history: list[tuple[str, str]], step_instruction: str | None = None) -> str:
    74	    s = f"Goal: {goal}\nPrevious steps:\n{history_text(history)}"
    75	    if step_instruction:
    76	        s += f"\nCurrent step hint: {step_instruction}"
    77	    return s + "\nWhat is the next action?"
    78	
    79	
    80	def build_messages(goal, history, image=None, step_instruction=None, for_trl=False):
    81	    """Messages for apply_chat_template. With for_trl=True the image is NOT inlined
    82	    (TRL prepends the dataset's `images` column to the first user message)."""
    83	    text = user_text(goal, history, step_instruction)
    84	    if for_trl:
    85	        return [
    86	            {"role": "system", "content": SYSTEM_PROMPT},
    87	            {"role": "user", "content": text},
    88	        ]
    89	    content = ([{"type": "image", "image": image}] if image is not None else []) + [{"type": "text", "text": text}]
    90	    return [
    91	        {"role": "system", "content": [{"type": "text", "text": SYSTEM_PROMPT}]},
    92	        {"role": "user", "content": content},
    93	    ]
    94	
    95	
    96	_JSON_RE = re.compile(r"\{.*\}", re.S)
    97	
    98	
    99	def parse_action(text: str) -> dict[str, Any] | None:
   100	    """Parse the model output (content after </think>, or the whole text) into an action dict.
   101	    Returns None when unparseable/invalid."""
   102	    if text is None:
   103	        return None
   104	    if "</think>" in text:
   105	        text = text.split("</think>", 1)[1]
   106	    # first valid JSON object; tolerates trailing junk such as an extra "}" (common base-model quirk)
   107	    a = None
   108	    dec = json.JSONDecoder()
   109	    i = text.find("{")
   110	    while i != -1 and a is None:
   111	        try:
   112	            obj, _ = dec.raw_decode(text[i:])
   113	            if isinstance(obj, dict) and ("action_type" in obj or "action" in obj):
   114	                a = obj
   115	        except json.JSONDecodeError:
   116	            pass
   117	        i = text.find("{", i + 1)
   118	    if not isinstance(a, dict):
   119	        return None
   120	    t = a.get("action_type") or a.get("action")
   121	    if not isinstance(t, str):
   122	        return None
   123	    if t == "type":
   124	        t = "input_text"
   125	    if t not in VALID_TYPES:
   126	        return None
   127	    a["action_type"] = t
   128	    if t in POINT_TYPES:
   129	        p = a.get("point_2d") or a.get("point") or a.get("coordinate")
   130	        if p is None and "x" in a and "y" in a:
   131	            p = [a["x"], a["y"]]
   132	        try:
   133	            p = [float(p[0]), float(p[1])]
   134	        except Exception:
   135	            return None
   136	        a["point_2d"] = [min(max(p[0], 0), 1000), min(max(p[1], 0), 1000)]
   137	    elif t == "scroll":
   138	        if a.get("direction") not in _DIRECTIONS:
   139	            return None
   140	    elif t in ("input_text", "answer"):
   141	        if not isinstance(a.get("text"), str):
   142	            return None
   143	    elif t == "open_app":
   144	        if not isinstance(a.get("app_name"), str):
   145	            alt = next((a[k] for k in ("label", "name", "text", "app") if isinstance(a.get(k), str)), None)
   146	            if alt is None:
   147	                return None
   148	            a["app_name"] = alt  # lenient: base model sometimes puts the app in "label"
   149	    elif t == "status":
   150	        if a.get("goal_status") not in ("complete", "infeasible"):
   151	            a["goal_status"] = "complete"
   152	    return a
