   247	    interaction_results = run_episode(task)
   248	    task_successful = task.is_successful(env)
   249	  except Exception as e:  # pylint: disable=broad-exception-caught
   250	    _log_and_print('%s\nSKIPPING %s.', '~' * 80, task.name)
   251	    logging.exception(
   252	        'Logging exception and skipping task. Will keep running. Task: %s: %s',
   253	        task.name,
   254	        e,
   255	    )
   256	    traceback.print_exc()
   257	    return _create_failed_result(
   258	        task.name, task.goal, traceback.format_exc(), time.time() - start
   259	    )
   260	  else:
   261	    agent_successful = task_successful if interaction_results.done else 0.0
   262	    _log_and_print(
   263	        '%s; %s',
   264	        'Task Successful ✅' if agent_successful > 0.5 else 'Task Failed ❌',
   265	        f' {task.goal}',
   266	    )
   267	
   268	    if demo_mode:
   269	      _display_success_overlay(env.controller, agent_successful)
   270	
   271	    result = {
   335	    env: The environment e2e system runs on.
   336	    checkpointer: See docstring from `run`.
   337	    demo_mode: Whether to display the scoreboard.
   338	    agent_name: The name of the agent.
   339	    return_full_episode_data: Whether to return full episode data instead of
   340	      just metadata.
   341	    process_episodes_fn: The function to process episode data. Usually to
   342	      compute metrics. Deafaults to process_episodes from this file.
   343	    check_episode_fn: The function to check episode data.
   344	
   345	  Returns:
   346	    Metadata for each episode, including the scripted reward.
   347	  """
   348	  metadata_fields = [
   349	      constants.EpisodeConstants.GOAL,
   350	      constants.EpisodeConstants.TASK_TEMPLATE,
   351	      constants.EpisodeConstants.INSTANCE_ID,
   352	      constants.EpisodeConstants.IS_SUCCESSFUL,
   353	      constants.EpisodeConstants.EPISODE_LENGTH,
   354	      constants.EpisodeConstants.RUN_TIME,
   355	      constants.EpisodeConstants.EXCEPTION_INFO,
   356	      constants.EpisodeConstants.AUX_DATA,
   357	  ]
   358	  completed_tasks, failed_tasks = _get_task_info(
   359	      checkpointer.load(fields=metadata_fields)
   360	  )
   361	  if process_episodes_fn is None:
   362	    process_episodes_fn = process_episodes
   363	
   364	  if (completed_tasks or failed_tasks) and return_full_episode_data:
   365	    raise ValueError(
   366	        'Cannot return full episode data when resuming from a checkpoint.'
   367	    )
   368	  episodes_metadata: list[dict[str, Any]] = []
   369	  full_episode_data = []
   370	  correct, total = 0, 0
   371	  for name, instances in suite.items():
   372	    msg = 'Running task: ' + name
   373	    _log_and_print(msg + '\n' + '=' * len(msg))
   374	
   375	    for i, instance in enumerate(instances):
   376	      instance_name = (
   377	          instance.name + checkpointer_lib.INSTANCE_SEPARATOR + str(i)
   378	      )
   379	      # Transferring from old checkpoint.
   380	      if instance_name in completed_tasks:
   381	        completed_episodes: list[dict[str, Any]] = completed_tasks[
   382	            instance_name
   383	        ]
   384	        episodes_metadata.extend(completed_episodes)
   385	      if instance_name in failed_tasks:
   386	        episodes_metadata.extend(failed_tasks[instance_name])
   387	      already_processed = (
   388	          instance_name in completed_tasks and instance_name not in failed_tasks
   389	      )
   390	      if already_processed:
   391	        _log_and_print('Skipping already processed task %s', instance_name)
   392	        continue
   393	
   394	      episode = _run_task(instance, run_episode, env, demo_mode=demo_mode)
   395	      if (
   396	          episode.get(constants.EpisodeConstants.EXCEPTION_INFO) is None
   397	          and check_episode_fn is not None
   398	      ):
   399	        if not check_episode_fn(episode):
   400	          continue
   401	      episode[constants.EpisodeConstants.AGENT_NAME] = agent_name
   402	      episode[constants.EpisodeConstants.INSTANCE_ID] = i
   403	      checkpointer.save_episodes([episode], instance_name)
   404	
   405	      if return_full_episode_data:
   406	        full_episode_data.append(episode)
   407	
   408	      episodes_metadata.append({k: episode[k] for k in metadata_fields})
   409	      process_episodes_fn(episodes_metadata, print_summary=True)
   410	
   411	      if episode[constants.EpisodeConstants.EXCEPTION_INFO] is not None:
   412	        # Don't include episode in tally if execution/eval logic errored out.
   413	        continue
   414	      correct += episode[constants.EpisodeConstants.IS_SUCCESSFUL]
   415	      total += 1
   416	      if demo_mode:
   417	        _update_scoreboard(correct, total, env.controller)
   418	    print()
   419	
   420	  return full_episode_data if return_full_episode_data else episodes_metadata
   450	    Step-by-step data from each episode.
   451	  """
   452	
   453	  def run_episode(task: task_eval.TaskEval) -> episode_runner.EpisodeResult:
   454	    if demo_mode:
   455	      _display_goal(agent.env, task)
   456	    return episode_runner.run_episode(
   457	        goal=task.goal,
   458	        agent=agent,
   459	        max_n_steps=_allocate_step_budget(task.complexity),
   460	        start_on_home_screen=task.start_on_home_screen,
   461	        termination_fn=(
   462	            miniwob_base.is_episode_terminated
   463	            if task.name.lower().startswith('miniwob')
   464	            else None
   465	        ),
   466	    )
   467	
   468	  if demo_mode:
   469	    adb_utils.send_android_intent(
   470	        'broadcast',
   471	        'com.example.ACTION_UPDATE_SCOREBOARD',
   472	        agent.env.controller,
   473	        extras={'player_name': agent.name, 'scoreboard_value': '00/00'},
   474	    )
   475	
   476	  results = _run_task_suite(
   477	      suite,
   478	      run_episode,
   479	      agent.env,
   480	      checkpointer=checkpointer,
   481	      demo_mode=demo_mode,
   482	      agent_name=agent.name,
   483	      return_full_episode_data=return_full_episode_data,
   484	      process_episodes_fn=process_episodes_fn,
   485	      check_episode_fn=check_episode_fn,
   486	  )
   487	
   488	  return results
