   101	def vshift(img_a, img_b):
   102	    """Estimated vertical content shift (px, + = content moved up) between two screenshots
   103	    using 1-D cross-correlation of row means on the middle band."""
   104	    A = np.asarray(img_a.convert("L").resize((108, 240)), dtype=np.float32)
   105	    B = np.asarray(img_b.convert("L").resize((108, 240)), dtype=np.float32)
   106	    a, b = A[40:200].mean(1), B[40:200].mean(1)
   107	    a, b = a - a.mean(), b - b.mean()
   108	    best, arg = -1e18, 0
   109	    for s in range(-60, 61):
   110	        if s >= 0:
   111	            v = float(np.dot(a[s:], b[: len(b) - s])) / (len(b) - s)
   112	        else:
   113	            v = float(np.dot(a[: len(a) + s], b[-s:])) / (len(a) + s)
   114	        if v > best:
   115	            best, arg = v, s
   116	    return arg  # positive: row i of A matches row i-s of B -> content moved up by s
   117	
