   108	def _transpose_lod_to_dol(data: list[dict[str, Any]]) -> dict[str, list[Any]]:
   109	  """Transposes a list of dictionaries to a dictionary of lists.
   110	
   111	  Args:
   112	    data: A list of dictionaries.
   113	
   114	  Returns:
   115	    A dictionary where each key is from the input dictionaries and each value is
   116	    a list of values for that key.
   117	  """
   118	  result = {}
   119	  for d in data:
   120	    for key, value in d.items():
   121	      if key not in result:
   122	        result[key] = []
   123	      result[key].append(value)
   124	  return result
