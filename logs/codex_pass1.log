scripts/gpu_session.sh
     1	#!/bin/bash
     2	# Local helper: push code to the GPU Colab session and bootstrap it.
     3	# Usage: scripts/gpu_session.sh <session_name>
     4	set -euo pipefail
     5	SESS=${1:-lfm3g4}
     6	cd "$(dirname "$0")/.."
     7	C() { "$HOME/.local/bin/colab" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} "$@" 2> >(grep -v "new version\|colab update\|silence this" >&2); }
     8	echo 'import os;[os.makedirs(d,exist_ok=True) for d in ("/content/work","/content/runs","/content/eval")];print("dirs ok")' | C exec -s "$SESS"
     9	for f in train/sft_vlm.py train/agent_format.py train/qwen35_chat_template_gen.jinja \
    10	         eval/androidcontrol/generate.py eval/androidcontrol/score.py \
    11	         scripts/vm_train.sh scripts/colab_bootstrap.py; do
    12	  C upload -s "$SESS" "$f" "/content/work/$(basename "$f")" | tail -1
    13	done
    14	C upload -s "$SESS" "$HOME/.cache/huggingface/token" /content/.hf_token | tail -1
    15	C exec -s "$SESS" -f scripts/colab_bootstrap.py

scripts/launch_gpu_jobs.sh
     1	#!/bin/bash
     2	# Local: bootstrap a GPU Colab session and run jobs inside a blocking kernel cell
     3	# (Colab reclaims VMs whose kernel is idle, so nohup'd background jobs get killed).
     4	# Usage: COLAB_CONFIG=<cfg.json|empty> scripts/launch_gpu_jobs.sh <session> <jobs.json>
     5	set -euo pipefail
     6	SESS=$1; JOBS=$2
     7	cd "$(dirname "$0")/.."
     8	C() { "$HOME/.local/bin/colab" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} "$@" 2> >(grep -v "new version\|colab update\|silence this" >&2); }
     9	COLAB_CONFIG=${COLAB_CONFIG:-} bash scripts/gpu_session.sh "$SESS" | grep -E "NVIDIA|pip rc|versions|HF user" || true
    10	C upload -s "$SESS" scripts/vm_blocking_jobs.py /content/work/vm_blocking_jobs.py | tail -1
    11	C upload -s "$SESS" scripts/vm_eval.sh /content/work/vm_eval.sh | tail -1
    12	C upload -s "$SESS" "$JOBS" /content/work/jobs.json | tail -1
    13	echo 'import os;os.makedirs("/content/work/meta",exist_ok=True)' | C exec -s "$SESS" >/dev/null
    14	C upload -s "$SESS" data/meta/splits.json /content/work/meta/splits.json | tail -1
    15	echo "launching blocking jobs cell on $SESS at $(date +%T)"
    16	nohup "$HOME/.local/bin/colab" ${COLAB_CONFIG:+--config "$COLAB_CONFIG"} exec -s "$SESS" --timeout 200000 -f scripts/vm_blocking_jobs.py \
    17	  > "logs/${SESS}_jobs_cell.log" 2>&1 &
    18	echo "cell client pid $!"

scripts/vm_eval.sh
     1	#!/bin/bash
     2	# Runs ON the GPU VM under nohup. Offline AndroidControl test generation + scoring.
     3	# Usage: MODEL=... NAME=... THINK=0|1 bash vm_eval.sh
     4	set -euo pipefail
     5	export HF_TOKEN=$(cat /content/.hf_token)
     6	cd /content/work
     7	DATA=${DATA:-experimentalmachines/AndroidControl-screen-agent-sft@test}
     8	mkdir -p /content/eval
     9	python generate.py --model "$MODEL" --data "$DATA" --out /content/eval/${NAME}.jsonl \
    10	  --enable_thinking ${THINK:-1} --bs ${BS:-64} --max_new_tokens ${MAXNEW:-256} ${EXTRA:-}
    11	python score.py /content/eval/${NAME}.jsonl --out /content/eval/${NAME}.metrics.json > /dev/null
    12	echo "EVAL DONE ${NAME}"

scripts/vm_prepare_data.sh
     1	#!/bin/bash
     2	# Runs ON the Colab VM (nohup). Downloads AndroidControl screenshots (smolagents mirror),
     3	# rebuilds official splits, and pushes the processed dataset to a private HF repo.
     4	set -euo pipefail
     5	export HF_TOKEN=$(cat /content/.hf_token)
     6	cd /content/work
     7	mkdir -p /content/raw /content/data logs
     8	echo "[$(date +%T)] download start"
     9	python - <<'EOF'
    10	from huggingface_hub import snapshot_download
    11	import time
    12	t=time.time()
    13	p=snapshot_download("smolagents/android-control", repo_type="dataset", local_dir="/content/raw",
    14	                    allow_patterns=["data/*.parquet"], max_workers=16)
    15	print("downloaded in", time.time()-t, "s", flush=True)
    16	EOF
    17	du -sh /content/raw
    18	echo "[$(date +%T)] build start"
    19	python build_androidcontrol.py --raw /content/raw --meta /content/work/meta --out /content/data --workers ${WORKERS:-10} --delete_raw
    20	echo "[$(date +%T)] build done"
    21	rm -rf /content/raw   # free disk once processed
    22	du -sh /content/data/*
    23	echo "[$(date +%T)] PREP DONE"

scripts/vm_prepare_list.sh
     1	#!/bin/bash
     2	# Runs ON the GPU VM: process the smolagents files listed in remaining_files.json, push parquet (tag g4).
     3	set -euo pipefail
     4	export HF_TOKEN=$(cat /content/.hf_token)
     5	cd /content/work
     6	echo "[$(date +%T)] download"
     7	python - <<'PY'
     8	import json
