   146	def process_file(path):
   147	    import zlib
   148	    rng = random.Random(zlib.crc32(os.path.basename(path).encode()) ^ args.seed)
   149	    out = {"train": [], "validation": [], "test": []}
   150	    st = Counter()
   151	    scroll_checks = []
   152	    pf = pq.ParquetFile(path)
   153	    for rg in range(pf.num_row_groups):
   154	        tbl = pf.read_row_group(rg).to_pylist()
   155	        for row in tbl:
   156	            eid = int(row["episode_id"])
   157	            split = id2split.get(eid)
   158	            if split is None:
   159	                st["no_official_split"] += 1
   160	                continue
   161	            goal = (row["goal"] or "").strip()
   162	            acts = row["actions"]
   163	            instrs = row["step_instructions"] or [""] * len(acts)
   164	            screens = row["screenshots_b64"]
   165	            if not acts or len(screens) < len(acts):
   166	                st["malformed"] += 1
   167	                continue
   168	            if split == "train" and (AW_RE.search(goal) or any(
   169	                    a.get("action_type") == "open_app" and (AW_RE.search(a.get("app_name") or "") or (a.get("app_name") or "").strip().lower() == "tasks")
   170	                    for a in acts)):
   171	                st["train_dropped_aw_app"] += 1
   172	                continue
   173	            imgs = [Image.open(io.BytesIO(base64.b64decode(s))) for s in screens]
   174	            sizes = [im.size for im in imgs]
   175	            jpgs = [to_jpeg(af.resize_screenshot(im, args.max_pixels)) for im in imgs]
   176	            history = []
   177	            ok = True
   178	            recs = []
   179	            for i, a in enumerate(acts):
   180	                W, H = sizes[i]
   181	                ga = convert_action(a, W, H)
   182	                if ga is None:
   183	                    st["unknown_action_" + str(a.get("action_type"))] += 1
   184	                    ok = False
   185	                    break
   186	                if ga["action_type"] == "scroll" and len(scroll_checks) < 40 and ga["direction"] in ("up", "down") and i + 1 < len(imgs):
   187	                    scroll_checks.append((ga["direction"], vshift(imgs[i], imgs[i + 1])))
   188	                instr = (instrs[i] or "").strip()
   189	                bb = bbox.get((eid, i)) if split == "test" else None
   190	                gt_bbox = None
   191	                if bb:
   192	                    x1, y1, x2, y2 = bb[0]
   193	                    gt_bbox = af.px_to_norm(x1, y1, W, H) + af.px_to_norm(x2, y2, W, H)
   194	                base = {"episode_id": eid, "step_idx": i, "goal": goal, "history": list(history),
   195	                        "instruction": instr, "jpg": jpgs[i], "gt_action": ga, "gt_bbox": gt_bbox,
   196	                        "subsplits": id2subs.get(eid, []), "is_terminal": False, "app": None,
   197	                        "orig_size": [W, H]}
   198	                if split == "train":
   199	                    recs.append({**base, "mode": "high"})
   200	                    if rng.random() < LOWLEVEL_FRAC and instr:
   201	                        recs.append({**base, "mode": "low"})
   202	                elif split == "validation":
   203	                    recs.append({**base, "mode": "high"})
   204	                else:
   205	                    recs.append({**base, "mode": "high"})
   206	                    if instr:
   207	                        recs.append({**base, "mode": "low"})
   208	                history.append((instr, af.action_to_str(ga)))
   209	            if not ok:
   210	                continue
   211	            if len(screens) >= len(acts) + 1:
   212	                W, H = sizes[len(acts)]
   213	                recs.append({"episode_id": eid, "step_idx": len(acts), "goal": goal, "history": list(history),
   214	                             "instruction": TERMINAL_INTENT, "jpg": jpgs[len(acts)],
   215	                             "gt_action": {"action_type": "status", "goal_status": "complete"}, "gt_bbox": None,
   216	                             "subsplits": id2subs.get(eid, []), "is_terminal": True, "mode": "high", "app": None,
   217	                             "orig_size": [W, H]})
   218	            else:
   219	                st["no_final_screen"] += 1
   220	            out[split].extend(recs)
   221	            st["episodes_" + split] += 1
   222	        flush_parts(out, f"{os.path.basename(path)}.rg{rg}", st)
   223	        del tbl
   224	    if args.delete_raw:
   225	        os.remove(path)
   226	    return st, scroll_checks
