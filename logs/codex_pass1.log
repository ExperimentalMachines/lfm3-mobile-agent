    14	du -sh /content/raw
    15	echo "[$(date +%T)] build"
    16	python build_androidcontrol.py --raw /content/raw --meta /content/work/meta --out /content/data --workers ${WORKERS:-40} --delete_raw --push_parquet experimentalmachines/AndroidControl-screen-agent-sft --tag ${TAG:-g4}
    17	echo "[$(date +%T)] LIST DONE"

scripts/vm_prepare_slice.sh
     1	#!/bin/bash
     2	# Runs ON a CPU Colab VM: process files [START:END) of smolagents/android-control and push parquet.
     3	set -euo pipefail
     4	export HF_TOKEN=$(cat /content/.hf_token)
     5	cd /content/work
     6	echo "[$(date +%T)] slice $START:$END tag=$TAG"
     7	python - <<PY
     8	from huggingface_hub import HfApi, snapshot_download
     9	files = sorted(f for f in HfApi().list_repo_files("smolagents/android-control", repo_type="dataset") if f.startswith("data/") and f.endswith(".parquet"))
    10	sl = files[$START:$END]
    11	print(len(files), "total;", len(sl), "in slice", sl[0], sl[-1], flush=True)
    12	snapshot_download("smolagents/android-control", repo_type="dataset", local_dir="/content/raw", allow_patterns=sl, max_workers=16)
    13	PY
    14	echo "[$(date +%T)] downloaded"; du -sh /content/raw
    15	python build_androidcontrol.py --raw /content/raw --meta /content/work/meta --out /content/data --workers ${WORKERS:-2} --delete_raw --push_parquet experimentalmachines/AndroidControl-screen-agent-sft --tag $TAG
    16	echo "[$(date +%T)] SLICE DONE"

scripts/vm_push_data.sh
     1	#!/bin/bash
     2	set -euo pipefail
     3	export HF_TOKEN=$(cat /content/.hf_token)
     4	cd /content/work
     5	echo "[$(date +%T)] push start"
     6	python - <<'EOF'
     7	import os, json
     8	from datasets import load_from_disk, DatasetDict
     9	from huggingface_hub import HfApi
    10	repo = "experimentalmachines/AndroidControl-screen-agent-sft"
    11	dd = DatasetDict({k: load_from_disk(f"/content/data/{k}") for k in ("train", "val", "test")})
    12	dd.push_to_hub(repo, private=True, max_shard_size="1GB")
    13	HfApi().upload_file(path_or_fileobj="/content/data/stats.json", path_in_repo="stats.json", repo_id=repo, repo_type="dataset")
    14	print("pushed", repo, flush=True)
    15	EOF
    16	echo "[$(date +%T)] ALL DONE"

scripts/vm_train.sh
     1	#!/bin/bash
     2	# Runs ON the Colab VM under nohup. Usage: MAX_STEPS=... RUN=... bash vm_train.sh
     3	set -euo pipefail
     4	export HF_TOKEN=$(cat /content/.hf_token)
     5	export TOKENIZERS_PARALLELISM=false
     6	cd /content/work
     7	RUN=${RUN:-lfm3vl2b-ac-lora}
     8	MODEL=${MODEL:-LiquidAI/LFM3-VL-2B}
     9	mkdir -p /content/runs/$RUN/logs
    10	python sft_vlm.py \
    11	  --model_id "$MODEL" \
    12	  --train ${TRAIN:-/content/data/train} \
    13	  ${VAL:+--val $VAL} \
    14	  --out /content/runs/$RUN \
    15	  --max_steps ${MAX_STEPS:--1} --epochs ${EPOCHS:-1} \
    16	  --bs ${BS:-16} --grad_accum ${GA:-2} --lr ${LR:-2e-4} \
    17	  --lora_r ${LORA_R:-64} --lora_alpha ${LORA_ALPHA:-128} \
    18	  --modules_to_save \
    19	  --save_steps ${SAVE_STEPS:-400} --eval_steps ${EVAL_STEPS:-400} \
    20	  --workers ${WORKERS:-8} \
    21	  ${HUB_REPO:+--hub_repo $HUB_REPO} \
    22	  ${EXTRA:-}
    23	echo "TRAIN EXIT $?"

scripts/vm_blocking_jobs.py
     1	"""Run ON the Colab VM via `colab exec -f` (with a large --timeout).
     2	
     3	Colab only keeps a VM alive while its Jupyter kernel is busy, so long jobs must run
     4	INSIDE a kernel cell: this script launches the job scripts listed in
     5	/content/work/jobs.json as subprocesses (logs to files) and blocks until all exit,
     6	printing a heartbeat every 60 s. Monitor from outside with `colab download` of the logs.
     7	
     8	jobs.json: [{"name": "train", "script": "/content/work/vm_train.sh", "env": {...}, "log": "/content/runs/x.log"}, ...]
     9	"""
    10	import json
    11	import os
    12	import subprocess
    13	import time
    14	
    15	jobs = json.load(open("/content/work/jobs.json"))
    16	procs = []
    17	for j in jobs:
    18	    env = dict(os.environ, **{k: str(v) for k, v in j.get("env", {}).items()})
    19	    os.makedirs(os.path.dirname(j["log"]), exist_ok=True)
    20	    p = subprocess.Popen(["bash", j["script"]], cwd="/content/work", env=env,
    21	                         stdout=open(j["log"], "a"), stderr=subprocess.STDOUT)
