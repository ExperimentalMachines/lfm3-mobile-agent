    52	
    53	def _gzip_pickle(data: Any) -> bytes:
    54	  """Pickle and gzip compress an object in memory.
    55	
    56	  Args:
    57	      data: The data to be pickled and gzipped.
    58	
    59	  Returns:
    60	      A bytes object containing the gzipped pickled data.
    61	  """
    62	  pickled_data = io.BytesIO()
    63	  pickle.dump(data, pickled_data)
    64	
    65	  pickled_data.seek(0)  # Reset the stream position to the beginning
    66	  compressed_data = io.BytesIO()
    67	  with gzip.GzipFile(
    68	      fileobj=compressed_data, mode='wb', compresslevel=5
    69	  ) as f_out:
    70	    f_out.write(pickled_data.getvalue())
    71	
    72	  return compressed_data.getvalue()
    73	
    74	
    75	def _unzip_and_read_pickle(file_path: str) -> Any:
    76	  """Reads a gzipped pickle file using 'with open', unzips, and unpickles it.
    77	
    78	  Args:
    79	      file_path: The path to the gzipped pickle file.
    80	
    81	  Returns:
    82	      The original Python object that was pickled and gzipped.
    83	  """
    84	  with open(file_path, 'rb') as f:
    85	    compressed = f.read()
    86	
    87	  with gzip.open(io.BytesIO(compressed), 'rb') as f_in:
    88	    return pickle.load(f_in)
