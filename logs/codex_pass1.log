   129	def flush_parts(out, tag, st):
   130	    """Write accumulated records of one row group to per-split part datasets on disk."""
   131	    for split, recs in out.items():
   132	        if not recs:
   133	            continue
   134	        name = SPLIT_NAME[split]
   135	        st[f"rows_{name}"] += len(recs)
   136	        st[f"rows_{name}_terminal"] += sum(r["is_terminal"] for r in recs)
   137	        st[f"rows_{name}_low"] += sum(r["mode"] == "low" for r in recs)
   138	        st[f"rows_{name}_bbox"] += sum(r["gt_bbox"] is not None for r in recs)
   139	        for r in recs:
   140	            st[f"{name}_act_{r['gt_action']['action_type']}"] += 1
   141	        d = os.path.join(args.out, "_parts", name, tag)
   142	        Dataset.from_list([to_row(r) for r in recs], features=FEATS).save_to_disk(d)
   143	        recs.clear()
