   108	              and gate_answer(x["text"], json.loads(r["gt_action"])["text"])) / max(1, len(rows))
   109	typed = sum(1 for r, x in zip(rows, acts) if x and x["action_type"] == "answer"
   110	            and same_answer(x["text"], json.loads(r["gt_action"])["text"])) / max(1, len(rows))
   111	rows_c, acts_c = preds(a.dev_complete, "dev_complete")
   112	false_ans = sum(1 for x in acts_c if x and x["action_type"] == "answer") / max(1, len(acts_c))
   113	complete = sum(1 for x in acts_c if x and x["action_type"] == "status" and x.get("goal_status") == "complete") / max(1, len(acts_c))
   114	g = {"aw_episodes_v4": len(v4), "aw_answer_task_successes_v4": ans4, "aw_action_task_successes_v4": act4,
   115	     "aw_action_task_successes_v3": act3, "dev_answer_emitted": round(emitted, 3), "dev_answer_exact": round(correct, 3), "dev_answer_typed_same_answer": round(typed, 3),
