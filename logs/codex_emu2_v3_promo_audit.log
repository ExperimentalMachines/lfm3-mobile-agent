   105	    bad = [("1.5", "15"), ("-2", "2"), ("1:30", "130"), ("York", "New York"), ("no alerts", "alerts")]
   106	    good = [("382 Followers", "382"), ("C$43.00", "C$43.00"), ("6:16 AM", "6:16 am"), ("4.2", "4.2."), ("Sun", "sun"),
   107	            ("410,000+ results", "410,000+"), ("₹614", "₹614")]
   108	    for x, y in bad:
   109	        assert not same_answer(x, y), (x, y)
   110	    for x, y in good:
   111	        assert same_answer(x, y), (x, y)
   112	    assert preferred("382 Followers", "382") == "382" and preferred("York", "New York") == "York"
   113	    assert safe_short("The temperature today is 51°.", "51°") and not safe_short("There are no alerts", "alerts")
   114	    assert not safe_short("3 of 5 stars", "3") and safe_short("Wednesday, Feb 1st, 2017", "Feb 1st, 2017")
   115	    for x, y in [("$10", "€10"), ("-5", "5"), ("100", "1000"), ("available", "unavailable")]:
   116	        assert not same_answer(x, y), (x, y)
   117	    assert not safe_short("It is unavailable.", "available") and not safe_short("10:49 PM on Jan 31, 2017", "10:49 PM on Jan 31 2017")
   118	    assert not safe_short("1.50", "150")
   119	    for x, y in [("12M", "12"), ("22K", "22"), ("Oct 4", "4"), ("9:30 PM", "9:30"), ("45%", "45"), ("4 GB", "4")]:
   120	        assert not same_answer(x, y), (x, y)
   121	    assert same_answer("12M", "12m") and same_answer("Oct 4", "oct 4") and same_answer("382 Followers", "382")
   122	    assert not same_answer("INR8,109.08", "€8,109.08") and not same_answer("5:00p", "5:00") and same_answer("5:00 PM", "5:00pm")
   123	    assert exact_answer("12M", "12m") and not exact_answer("12M is incorrect", "12M") and exact_answer("8,109.08", "8109.08")
   124	    assert exact_answer("$ 10", "$10") and not exact_answer("$10", "€10") and not exact_answer("", "")
   125	    print("answer-check tests pass")
     1	"""Shared prompt + action format for the LFM3-VL Android agent.
     2	
     3	Used identically by: training-data builder, offline AndroidControl eval, and the
     4	AndroidWorld agent, so train/test prompts can never drift apart.
     5	
     6	Design (on-device first):
     7	  * one screenshot per step (current screen only) -> bounded prefill cost on phones
     8	  * text history of previous step intents + actions (last HISTORY_STEPS)
     9	  * coordinates are integers normalized to [0, 1000] (LFM3-VL's native point_2d grid)
    10	  * assistant output = short intent in the <think> block + one compact JSON action
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import hashlib
    16	import json
    17	import random
    18	import re
    19	from typing import Any
    20	
    21	HISTORY_STEPS = 8
    22	
    23	SYSTEM_PROMPT = """You are a phone-use agent operating an Android phone to complete the user's goal.
    24	Each turn you see the goal, your previous steps, and the current screenshot. Reply with ONE next action as JSON.
    25	Coordinates are integers normalized to 0-1000 (x from left, y from top) of the screenshot.
    26	Actions:
    27	{"action_type":"click","point_2d":[x,y]}
    28	{"action_type":"long_press","point_2d":[x,y]}
    29	{"action_type":"input_text","text":"..."}  (types into the focused field)
    30	{"action_type":"scroll","direction":"up|down|left|right"}  (down = reveal content below)
    31	{"action_type":"open_app","app_name":"..."}
    32	{"action_type":"navigate_back"}
    33	{"action_type":"navigate_home"}
    34	{"action_type":"keyboard_enter"}
    35	{"action_type":"wait"}
    36	{"action_type":"answer","text":"..."}  (reply to a question about the screen)
    37	{"action_type":"status","goal_status":"complete|infeasible"}  (finish the task)"""
    38	
    39	# v4 (2026-11-18): AndroidWorld analysis showed the agent never answers questions - it navigated to the right screen and
    40	# then declared `complete`, partly because v1-v3 described `answer` as a "reply to a question about the screen".
    41	# v4 states when to answer vs complete and lists the installed apps (fixes invented names such as "Marker" for Markor).
    42	# Models v1-v3 keep SYSTEM_PROMPT; v4 data and the v4 AndroidWorld agent use SYSTEM_PROMPT_V4 + an "Installed apps" line.
    43	SYSTEM_PROMPT_V4 = """You are a phone-use agent operating an Android phone to complete the user's goal.
    44	Each turn you see the goal, the installed apps, your previous steps, and the current screenshot. Reply with ONE next action as JSON.
    45	Coordinates are integers normalized to 0-1000 (x from left, y from top) of the screenshot.
    46	Actions:
    47	{"action_type":"click","point_2d":[x,y]}
    48	{"action_type":"long_press","point_2d":[x,y]}
    49	{"action_type":"input_text","text":"..."}  (types into the focused field)
    50	{"action_type":"scroll","direction":"up|down|left|right"}  (down = reveal content below)
    51	{"action_type":"open_app","app_name":"..."}  (app_name must be one of the installed apps)
    52	{"action_type":"navigate_back"}
    53	{"action_type":"navigate_home"}
    54	{"action_type":"keyboard_enter"}
    55	{"action_type":"wait"}
    56	{"action_type":"answer","text":"..."}  (if the goal asks a question: the final reply, as short as possible and in the requested format; ends the task)
    57	{"action_type":"status","goal_status":"complete|infeasible"}  (finish a goal that asks for no information; never use it instead of answering a question)"""
    58	
    59	PROMPTS = {"v1": SYSTEM_PROMPT, "v4": SYSTEM_PROMPT_V4}
    60	
    61	VALID_TYPES = {
    62	    "click", "long_press", "input_text", "scroll", "open_app", "navigate_back",
    63	    "navigate_home", "keyboard_enter", "wait", "answer", "status",
    64	}
    65	POINT_TYPES = {"click", "long_press"}
    66	_DIRECTIONS = {"up", "down", "left", "right"}
    67	
    68	
    69	def action_to_str(a: dict[str, Any]) -> str:
    70	    """Canonical compact JSON for an action (stable key order, no spaces)."""
    71	    t = a["action_type"]
    72	    out: dict[str, Any] = {"action_type": t}
    73	    if t in POINT_TYPES:
    74	        out["point_2d"] = [int(a["point_2d"][0]), int(a["point_2d"][1])]
    75	    elif t in ("input_text", "answer"):
    76	        out["text"] = a["text"]
    77	    elif t == "scroll":
    78	        out["direction"] = a["direction"]
    79	    elif t == "open_app":
    80	        out["app_name"] = a["app_name"]
    81	    elif t == "status":
    82	        out["goal_status"] = a.get("goal_status", "complete")
    83	    return json.dumps(out, ensure_ascii=False, separators=(",", ":"))
    84	
    85	
    86	def history_text(history: list[tuple[str, str]]) -> str:
    87	    """history: list of (intent, action_json_str), oldest first."""
    88	    if not history:
    89	        return "None"
    90	    start = max(0, len(history) - HISTORY_STEPS)
    91	    lines = []
    92	    for i, (intent, act) in enumerate(history[start:], start=start + 1):
    93	        lines.append(f"{i}. {intent} -> {act}" if intent else f"{i}. {act}")
    94	    return "\n".join(lines)
    95	
    96	
    97	def apps_line(apps: list[str]) -> str:
    98	    return "Installed apps: " + ", ".join(apps)
    99	
   100	
   101	def user_text(goal: str, history: list[tuple[str, str]], step_instruction: str | None = None,
   102	              apps: list[str] | None = None) -> str:
   103	    """apps=None -> v1-v3 format (no app line); apps=[...] -> v4 format (app line right after the goal)."""
   104	    s = f"Goal: {goal}\n" + (apps_line(apps) + "\n" if apps is not None else "") + f"Previous steps:\n{history_text(history)}"
   105	    if step_instruction:
   106	        s += f"\nCurrent step hint: {step_instruction}"
   107	    return s + "\nWhat is the next action?"
   108	
   109	
   110	def v4_app_list(key: str, required: list[str], pool: list[str]) -> list[str]:
   111	    """Training/offline-eval stand-in for a device's installed apps: the episode's own apps plus distractors from the
   112	    training app pool, 12-30 names, deterministic per episode key, sorted case-insensitively like the device list."""
   113	    rnd = random.Random(hashlib.sha256(key.encode()).hexdigest())
   114	    k = rnd.randint(12, 30)
   115	    apps = list(dict.fromkeys(a for a in required if a))
   116	    cand = sorted({p for p in pool if p and p not in apps})
   117	    rnd.shuffle(cand)
   118	    apps += cand[: max(0, k - len(apps))]
   119	    return sorted(apps, key=str.lower)
   120	
   121	
   122	def to_v4_messages(messages: list[dict], apps: list[str]) -> list[dict]:
   123	    """Rewrite stored v1-format [system, user, (assistant)] messages to the v4 prompt: SYSTEM_PROMPT_V4 and an
   124	    "Installed apps" line right after the goal line. Text-only contents (dataset rows)."""
   125	    sys_m, user_m = dict(messages[0]), dict(messages[1])
   126	    if sys_m["content"] != SYSTEM_PROMPT or not user_m["content"].startswith("Goal: ") or "\nInstalled apps: " in user_m["content"]:
   127	        raise ValueError("not a v1-format row")
   128	    goal_line, rest = user_m["content"].split("\n", 1)
   129	    if not rest.startswith("Previous steps:\n"):
   130	        raise ValueError("unexpected user text layout")
   131	    sys_m["content"] = SYSTEM_PROMPT_V4
   132	    user_m["content"] = goal_line + "\n" + apps_line(apps) + "\n" + rest
   133	    return [sys_m, user_m] + [dict(m) for m in messages[2:]]
   134	
   135	
   136	_APP_RE = re.compile(r'"app_name":"((?:[^"\\]|\\.)*)"')
   137	
   138	
   139	def apps_in_text(text: str) -> list[str]:
   140	    """open_app names mentioned in a history text (compact action JSON)."""
   141	    return [json.loads('"' + m + '"') for m in _APP_RE.findall(text or "")]
   142	
   143	
   144	def build_messages(goal, history, image=None, step_instruction=None, for_trl=False, prompt_version="v1", apps=None):
   145	    """Messages for apply_chat_template. With for_trl=True the image is NOT inlined
   146	    (TRL prepends the dataset's `images` column to the first user message)."""
   147	    if (prompt_version == "v4") != (apps is not None):
   148	        raise ValueError("prompt v4 requires an installed-app list and v1 must not have one")
   149	    sp = PROMPTS[prompt_version]
   150	    text = user_text(goal, history, step_instruction, apps=apps)
   151	    if for_trl:
   152	        return [
   153	            {"role": "system", "content": sp},
   154	            {"role": "user", "content": text},
   155	        ]
   156	    content = ([{"type": "image", "image": image}] if image is not None else []) + [{"type": "text", "text": text}]
   157	    return [
   158	        {"role": "system", "content": [{"type": "text", "text": sp}]},
   159	        {"role": "user", "content": content},
   160	    ]
   161	
   162	
   163	_JSON_RE = re.compile(r"\{.*\}", re.S)
   164	
   165	
   166	def parse_action(text: str, strict: bool = False) -> dict[str, Any] | None:
   167	    """Parse the model output (content after </think>, or the whole text) into an action dict.
   168	    Returns None when unparseable/invalid.
   169	
   170	    strict=True : the answer must be exactly one JSON object with the documented keys
   171	                  (no aliases, no trailing junk, no coordinate clamping, explicit goal_status).
   172	    strict=False: lenient harness parsing used by the agent (first JSON object with an action,
   173	                  key aliases, clamping). Both are reported so leniency is visible."""
   174	    if text is None:
   175	        return None
   176	    if "</think>" in text:
   177	        text = text.split("</think>", 1)[1]
   178	    elif "<think>" in text:
   179	        return None  # unfinished reasoning: an action inside it is not a final answer
   180	    if strict:
   181	        def _no_dup(pairs):
   182	            keys = [k for k, _ in pairs]
   183	            if len(keys) != len(set(keys)):
   184	                raise ValueError("duplicate key")
   185	            return dict(pairs)
   186	
   187	        def _no_const(c):
   188	            raise ValueError("non-finite number")
   189	        try:
   190	            a = json.loads(text.strip(), object_pairs_hook=_no_dup, parse_constant=_no_const)
   191	        except Exception:
   192	            return None
   193	        if not isinstance(a, dict) or not isinstance(a.get("action_type"), str):
   194	            return None
   195	        return _validate_strict(a)
   196	    # first valid JSON object; tolerates trailing junk such as an extra "}" (common base-model quirk)
   197	    a = None
   198	    dec = json.JSONDecoder()
   199	    i = text.find("{")
   200	    while i != -1 and a is None:
   201	        try:
   202	            obj, _ = dec.raw_decode(text[i:])
   203	            if isinstance(obj, dict) and ("action_type" in obj or "action" in obj):
   204	                a = obj
   205	        except json.JSONDecodeError:
   206	            pass
   207	        i = text.find("{", i + 1)
   208	    if not isinstance(a, dict):
   209	        return None
   210	    t = a.get("action_type") or a.get("action")
   211	    if not isinstance(t, str):
   212	        return None
   213	    if t == "type":
   214	        t = "input_text"
   215	    if t not in VALID_TYPES:
   216	        return None
   217	    a["action_type"] = t
   218	    if t in POINT_TYPES:
   219	        p = a.get("point_2d") or a.get("point") or a.get("coordinate")
   220	        if p is None and "x" in a and "y" in a:
   221	            p = [a["x"], a["y"]]
   222	        try:
   223	            p = [float(p[0]), float(p[1])]
   224	        except Exception:
   225	            return None
   226	        import math as _m
   227	        if not all(_m.isfinite(v) for v in p):
   228	            return None
   229	        a["point_2d"] = [min(max(p[0], 0), 1000), min(max(p[1], 0), 1000)]
   230	    elif t == "scroll":
   231	        if not isinstance(a.get("direction"), str) or a.get("direction") not in _DIRECTIONS:
   232	            return None
   233	    elif t in ("input_text", "answer"):
   234	        if not isinstance(a.get("text"), str):
   235	            return None
   236	    elif t == "open_app":
   237	        if not isinstance(a.get("app_name"), str):
   238	            alt = next((a[k] for k in ("label", "name", "text", "app") if isinstance(a.get(k), str)), None)
   239	            if alt is None:
   240	                return None
   241	            a["app_name"] = alt  # lenient: base model sometimes puts the app in "label"
   242	    elif t == "status":
   243	        gs = a.get("goal_status")
   244	        if gs is not None and not isinstance(gs, str):
   245	            return None
   246	        if gs is None:
   247	            a["goal_status"] = "complete"  # lenient: omitted status means done
   248	        elif gs not in ("complete", "infeasible"):
   249	            return None
   250	    return a
   251	
   252	
   253	MAX_PIXELS = 880 * 880  # ~756 image tokens for a 1080x2400 phone screen (32px per token)
   254	MIN_PIXELS = 256 * 256
   255	RESIZE_FACTOR = 32  # 16px patch * 2x2 merge (LFM3-VL and Qwen3.5 alike)
   256	
   257	
   258	def smart_resize(height: int, width: int, factor: int = RESIZE_FACTOR,
   259	                 min_pixels: int = MIN_PIXELS, max_pixels: int = MAX_PIXELS) -> tuple[int, int]:
   260	    """Same algorithm as LFM3-VL's image processor (Qwen2-VL style). Returns (h, w)."""
   261	    import math
   262	    h_bar = round(height / factor) * factor
   263	    w_bar = round(width / factor) * factor
   264	    if h_bar * w_bar > max_pixels:
   265	        beta = math.sqrt((height * width) / max_pixels)
   266	        h_bar = max(factor, math.floor(height / beta / factor) * factor)
   267	        w_bar = max(factor, math.floor(width / beta / factor) * factor)
   268	    elif h_bar * w_bar < min_pixels:
   269	        beta = math.sqrt(min_pixels / (height * width))
   270	        h_bar = math.ceil(height * beta / factor) * factor
   271	        w_bar = math.ceil(width * beta / factor) * factor
   272	    return h_bar, w_bar
   273	
   274	
   275	def resize_screenshot(img, max_pixels: int = MAX_PIXELS):
   276	    """PIL image -> RGB PIL image resized exactly as the model will see it."""
   277	    from PIL import Image
   278	    img = img.convert("RGB")
   279	    h, w = smart_resize(img.height, img.width, max_pixels=max_pixels)
   280	    if (w, h) != img.size:
   281	        img = img.resize((w, h), Image.BICUBIC)
   282	    return img
   283	
   284	
   285	def _validate_strict(a):
   286	    t = a["action_type"]
   287	    allowed = {"click": {"point_2d"}, "long_press": {"point_2d"}, "input_text": {"text"}, "answer": {"text"},
   288	               "scroll": {"direction"}, "open_app": {"app_name"}, "status": {"goal_status"},
   289	               "navigate_back": set(), "navigate_home": set(), "keyboard_enter": set(), "wait": set()}
   290	    if t not in allowed or set(a) - {"action_type"} != allowed[t]:
   291	        return None
   292	    if t in POINT_TYPES:
   293	        p = a["point_2d"]
   294	        if not (isinstance(p, list) and len(p) == 2 and all(isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 1000 for v in p)):
   295	            return None
   296	    elif t in ("input_text", "answer", "open_app"):
   297	        if not isinstance(a[next(iter(allowed[t]))], str):
   298	            return None
   299	    elif t == "scroll" and (not isinstance(a["direction"], str) or a["direction"] not in _DIRECTIONS):
   300	        return None
   301	    elif t == "status" and (not isinstance(a["goal_status"], str) or a["goal_status"] not in ("complete", "infeasible")):
   302	        return None
   303	    return a
   304	
   305	
   306	def norm_to_px(point_2d, width: int, height: int) -> tuple[int, int]:
   307	    x = round(point_2d[0] / 1000 * (width - 1))
   308	    y = round(point_2d[1] / 1000 * (height - 1))
   309	    return x, y
   310	
   311	
   312	def px_to_norm(x: float, y: float, width: int, height: int) -> list[int]:
   313	    return [min(1000, max(0, round(x / width * 1000))), min(1000, max(0, round(y / height * 1000)))]

