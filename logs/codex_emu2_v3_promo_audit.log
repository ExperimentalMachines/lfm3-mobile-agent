   105	def _fingerprint(model):
   106	    """Distinguish different weights behind the same local path (e.g. after retraining)."""
   107	    if not os.path.isdir(model):
   108	        return "hub:" + model
   109	    h = hashlib.sha256()
   110	    rec = os.path.join(os.path.dirname(model.rstrip("/")), "train_receipt.json")
   111	    if os.path.exists(rec):
   112	        h.update(open(rec, "rb").read())
   113	    for f in sorted(_glob.glob(os.path.join(model, "*.safetensors"))):
   114	        h.update(f"{os.path.basename(f)}:{os.path.getsize(f)}".encode())
   115	        with open(f, "rb") as fh:
   116	            h.update(fh.read(4 << 20))
   117	    return h.hexdigest()[:16]
