    26	}     1	"""Strict, type-aware answer comparison for v4 teacher labels (replaces the permissive agree() used at generation time).
     2	
     3	Codex research (results/codex/codex_overnight_research.md) found false agreements in the generation-time check:
     4	1.5/15, -2/2, 1:30/130, York/New York, "no alerts"/alerts. Rules here:
     5	  * normalise: lower-case, collapse whitespace, strip surrounding quotes and a trailing period;
     6	  * numeric answers: the ordered list of number tokens (sign, decimals, thousands separators, times like 1:30 kept
     7	    intact) must be identical; remaining words of the shorter answer must be a whole-word subset of the longer one
     8	    ("382 followers" ~ "382", but "1.5" != "15", "-2" != "2", "1:30" != "130");
     9	  * non-numeric answers: exact equality after normalisation (no substring matches: "york" != "new york");
    10	  * negation guard: if either side contains a negation word the other lacks, reject.
    11	"""
    12	import re
    13	
    14	NUM = re.compile(r"[-+]?\d[\d,]*(?:\.\d+)?(?::\d+)*")
    15	NEG = {"no", "not", "none", "never", "nothing", "without", "zero", "isn't", "aren't", "doesn't", "don't", "can't", "cannot"}
    16	
    17	
    18	def norm(s):
    19	    s = re.sub(r"\s+", " ", str(s or "").strip().lower())
    20	    s = s.strip("\"'`“”‘’ ")
    21	    return s[:-1] if s.endswith(".") and not re.search(r"\d\.$", s) else s
    22	
    23	
    24	def nums(s):
    25	    return [n.replace(",", "") for n in NUM.findall(s)]
    26	
    27	
    28	def words(s):
    29	    return set(re.findall(r"[a-z]+(?:'[a-z]+)?", NUM.sub(" ", s)))
    30	
    31	
    32	CUR = re.compile(r"[$€£¥₹₩₽¢]|(?<![a-z])(?:usd|eur|gbp|inr|aed|rs|c\$|a\$)(?![a-z])")  # "inr8,109" counts as INR
    33	
    34	
    35	# tokens that change an answer's meaning when dropped (Codex data audit #4: "12M"->"12", "Oct 4"->"4", "9:30 PM"->"9:30")
    36	ESSENTIAL = {"k", "m", "b", "bn", "mn", "thousand", "million", "billion", "trillion", "lakh", "lakhs", "crore", "crores",
    37	             "am", "pm", "jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "sept", "oct", "nov", "dec",
    38	             "january", "february", "march", "april", "june", "july", "august", "september", "october", "november",
    39	             "december", "mon", "tue", "wed", "thu", "fri", "sat", "sun", "monday", "tuesday", "wednesday", "thursday",
    40	             "friday", "saturday", "sunday", "today", "tomorrow", "yesterday", "hr", "hrs", "hour", "hours", "min",
    41	             "mins", "minute", "minutes", "sec", "secs", "second", "seconds", "day", "days", "week", "weeks", "month",
    42	             "months", "year", "years", "km", "mi", "kg", "lb", "lbs", "gb", "mb", "tb", "kb"}
    43	
    44	
    45	def essential(s):
    46	    s = re.sub(r"(\d)\s*([ap])\.?(?:m\.?)?(?![a-z])", lambda m: m.group(1) + " " + m.group(2) + "m", s)  # 5:00p -> 5:00 pm
    47	    t = set(re.findall(r"[a-z]+", re.sub(r"(\d)([a-z])", r"\1 \2", s)))  # "12m" -> "12 m"
    48	    return (t & ESSENTIAL) | ({"%"} if "%" in s else set())
    49	
    50	
    51	def same_answer(a, b):
    52	    a, b = norm(a), norm(b)
    53	    if a and b and essential(a) != essential(b):
    54	        return False
    55	    if not a or not b or "none" in (a, b):
    56	        return False
    57	    if sorted(CUR.findall(a)) != sorted(CUR.findall(b)) and CUR.findall(a) and CUR.findall(b):
    58	        return False  # "$10" vs "€10"
    59	    if (words(a) & NEG) != (words(b) & NEG):
    60	        return False
    61	    na, nb = nums(a), nums(b)
    62	    if na or nb:
    63	        if na != nb:
    64	            return False
    65	        short, long_ = sorted((a, b), key=len)
    66	        return words(short) <= words(long_)
    67	    return a == b
    68	
    69	
    70	FILLER = {"the", "a", "an", "is", "are", "it", "its", "of", "about", "approximately", "approx", "around", "total"}
    71	
    72	
    73	def gate_answer(pred, gold):
    74	    """Development-gate scoring (Codex recovery audit P2): same_answer, and the prediction may not ADD content words to the
    75	    reference ('12M is incorrect' vs '12M' fails; '12M downloads' vs '12M' fails too -- conservative)."""
    76	    return same_answer(pred, gold) and (words(norm(pred)) - words(norm(gold))) <= FILLER
    77	
    78	
    79	def exact_answer(pred, gold):
    80	    """RL reward / strict scoring: equal after normalisation only (case, whitespace, quotes, trailing period, thousands
    81	    separators, spacing around currency). No added or dropped words: '12M is incorrect' != '12M'."""
    82	    f = lambda x: re.sub(r"(?<=\d),(?=\d{3}\b)", "", re.sub(r"([$€£¥₹₩₽¢])\s+", r"\1", norm(x)))
    83	    return bool(norm(pred)) and f(pred) == f(gold)
    84	
    85	
    86	def preferred(answer, verify):
    87	    """The shorter of two agreeing answers when it only drops unit/filler words (e.g. '382 Followers' -> '382')."""
    88	    a, v = str(answer or "").strip(), str(verify or "").strip()
    89	    if v and len(v) < len(a) and same_answer(a, v) and nums(norm(a)) == nums(norm(v)) and nums(norm(a)):
    90	        return v
    91	    return a
    92	
    93	
    94	def safe_short(long_answer, short):
    95	    """ScreenQA shortening is accepted only if it keeps every number and negation of the original and is a substring."""
    96	    L, S = norm(long_answer), norm(short)
    97	    if not S or len(S) >= len(L) or not re.search(r"(?<![a-z0-9])" + re.escape(S) + r"(?![a-z0-9])", L):
    98	        return False  # whole-token span only: "available" is not a span of "unavailable"
    99	    if (words(L) & NEG) - (words(S) & NEG):
   100	        return False
   101	    return all(n in nums(S) for n in nums(L))
   102	
