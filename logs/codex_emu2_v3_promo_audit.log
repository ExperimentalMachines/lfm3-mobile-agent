from pathlib import Path
import sys, json, hashlib
sys.path.insert(0,str(Path.cwd()))
from data.v4_answer_check import gate_answer, same_answer
from train.agent_format import parse_action
ref=json.loads(Path('results/v4_dev_reference.json').read_text())
res={}
for name,folder,prefix,model in [('v4','results/v4_dev/hub/eval','lfm3_v4','/content/runs/lfm3vl2b-v4bmix-lora/merged'),('v4rl','results/v4rl_dev','lfm3_v4rl','/content/runs/v4rl/merged')]:
    res[name]={}
    for split in ['dev_answer','dev_complete']:
        p=Path(folder)/f'{prefix}_{split}.jsonl'
        rows=[json.loads(x) for x in p.read_text().splitlines()]
        man=json.loads(Path(str(p)+'.manifest.json').read_text())
        acts=[parse_action(x['output'],strict=True) for x in rows]
        identity=sorted((str(x['episode_id']),int(x['step_idx']),x['gt_action']) for x in rows)
        want=sorted((str(e),int(i),g) for e,i,g in ref['splits'][split])
        n=len(rows)
        n_ans=sum(bool(a and a['action_type']=='answer') for a in acts)
        score={'n':n,'strict_parse_valid':sum(a is not None for a in acts),'answer_emitted':n_ans,'answer_rate':n_ans/n,
               'pinned_rows_match':identity==want and len(set(identity))==n,
               'row_model_split_match':all(r.get('model')==model and r.get('split',split)==split for r in rows),
               'manifest_identity_match':(man.get('model'),man.get('data'),man.get('n_rows'),man.get('do_sample'),man.get('enable_thinking'))==(model,f\"{ref['repo']}@{split}#{ref['revision']}\",n,False,1),
               'manifest_settings':{k:man.get(k) for k in ['prompt','max_pixels','max_new_tokens']},
               'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
        if split=='dev_answer':
            for label,fn in [('gate_answer',gate_answer),('same_answer',same_answer)]:
                good=sum(bool(a and a['action_type']=='answer' and fn(a['text'],json.loads(r['gt_action'])['text'])) for r,a in zip(rows,acts))
                score[label]={'correct':good,'rate':good/n}
        res[name][split]=score
res['answer_delta']=res['v4rl']['dev_answer']['gate_answer']['rate']-res['v4']['dev_answer']['gate_answer']['rate']
res['criterion_a_pass']=res['answer_delta']>=0.05-1e-12
res['criterion_b_pass']=res['v4rl']['dev_complete']['answer_rate']<=0.03+1e-12
out=Path('results/codex/emu2_v3_promo_audit/offline_recompute.json')
out.write_text(json.dumps(res,indent=2)+'\\n')
print(out.read_text())
