    32	p.add_argument("--dev_answer", required=True, help="predictions jsonl of the v4 model on dev_answer")
    33	p.add_argument("--dev_complete", required=True, help="predictions jsonl of the v4 model on dev_complete")
    34	p.add_argument("--v4_agent", required=True, help="agent_name every v4 episode must carry (e.g. lfm3vl2b_v4_q4km)")
