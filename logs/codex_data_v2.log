   163	def sample_rows(rows, n, rng, per_episode=2, quotas=None):
   164	    """Pick n rows: quota rows first (by predicate, capped at k), then fill with <= per_episode rows per episode
   165	    from rows matching NO quota predicate (so a quota is also a ceiling)."""
   166	    rng.shuffle(rows)
   167	    chosen, used = [], set()
   168	    for pred, k in (quotas or []):
   169	        picks = [r for r in rows if pred(r)][:k]
   170	        chosen += picks
   171	        used |= {id(r) for r in picks}
   172	    per = Counter(r["episode_id"] for r in chosen)
   173	    for r in rows:
   174	        if len(chosen) >= n:
