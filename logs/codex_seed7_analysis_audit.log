   213	class AsyncAndroidEnv(AsyncEnv):
   214	  """Async environment interface using AndroidEnv to communicate with device."""
   215	
   216	  interaction_cache = ''
   217	
   218	  def __init__(
   219	      self, controller: android_world_controller.AndroidWorldController
   220	  ):
   221	    self._controller = controller
   222	    self._prior_state = None
   223	    # Variable used to temporarily save interactions between agent and user.
   224	    # Like when agent use answer action to answer user questions, we
   225	    # use this to save the agent response. Or later on when agent has the
   226	    # ability to ask user question, user's answer will be saved here as well.
   227	    self.interaction_cache = ''
   228	
   229	  @property
   230	  def controller(self) -> android_world_controller.AndroidWorldController:
   231	    return self._controller
   232	
   233	  def reset(self, go_home: bool = False) -> State:
   234	    if go_home:
   235	      adb_utils.press_home_button(self.controller)
   236	    self.interaction_cache = ''
   237	
   238	    return _process_timestep(self.controller.reset())
   239	
   240	  def _get_state(self):
   241	    return _process_timestep(self.controller.step(_get_no_op_action()))
   242	
   243	  def _get_stable_state(
   244	      self,
   245	      stability_threshold: int = 3,
   246	      sleep_duration: float = 0.5,
   247	      timeout: float = 6.0,
   248	  ) -> State:
   249	    """Checks if the UI elements remain stable over a number of checks and returns the state.
   250	
   251	    Args:
   252	        stability_threshold: Number of consecutive checks where UI elements must
   253	          remain the same to consider UI stable.
   254	        sleep_duration: Minimum time in seconds between each check.
   255	        timeout: Maximum time in seconds to wait for UI to become stable before
   256	          giving up.
   257	
   258	    Returns:
   259	        The current state of the UI if stability is achieved within the timeout.
   260	    """
   261	    if not self._prior_state:
   262	      self._prior_state = self._get_state()
   263	    if stability_threshold <= 0:
   264	      raise ValueError('Stability threshold must be a positive integer.')
   265	
   266	    stable_checks = 1
   267	    start_time = time.time()
   268	    deadline = start_time + timeout
   269	
   270	    while stable_checks < stability_threshold and time.time() < deadline:
   271	      iteration_start_time = time.time()
   272	      current_state = self._get_state()
   273	
   274	      if self._prior_state.ui_elements == current_state.ui_elements:
   275	        stable_checks += 1
   276	        if stable_checks == stability_threshold:
   277	          break  # Exit early if stability is achieved.
   278	      else:
   279	        stable_checks = 1  # Reset if any change is detected
   280	        self._prior_state = current_state
   281	
   282	      elapsed_time = time.time() - iteration_start_time
   283	      remaining_sleep = sleep_duration - elapsed_time
   284	      if remaining_sleep > 0:
   285	        sleep_time = min(remaining_sleep, deadline - time.time())
   286	        if sleep_time > 0:
   287	          time.sleep(sleep_time)
   288	      # If remaining_sleep <= 0, proceed immediately to the next iteration
   289	
   290	    return current_state  # pylint: disable=undefined-variable
   291	
   292	  def get_state(self, wait_to_stabilize: bool = False) -> State:
   293	    if wait_to_stabilize:
   294	      return self._get_stable_state()
   295	    return self._get_state()
   296	
   297	  def execute_action(self, action: json_action.JSONAction) -> None:
   298	    if action.action_type == json_action.ANSWER:
   299	      self.interaction_cache = action.text  # pyrefly: ignore[bad-assignment]
   300	      if action.text:
   301	        self.display_message(action.text, header='Agent answered:')
   302	      return
   303	    if action.action_type == json_action.STATUS:
   304	      # Do nothing if it is a termination action.
   305	      return
   306	    state = self.get_state(wait_to_stabilize=False)
   307	    actuation.execute_adb_action(
   308	        action,
   309	        state.ui_elements,
   310	        self.logical_screen_size,
   311	        self.controller,
   312	    )
   313	
   314	  def hide_automation_ui(self) -> None:
   315	    """Hides the coordinates on screen."""
   316	    adb_utils.issue_generic_request(
   317	        'shell settings put system pointer_location 0', self.controller
   318	    )
   319	
   320	  def display_message(self, message: str, header: str = '') -> None:
   321	    adb_utils.send_android_intent(
   322	        command='broadcast',
   323	        action='com.example.ACTION_UPDATE_OVERLAY',
   324	        env=self.controller,
   325	        extras={'task_type_string': header, 'goal_string': message},

