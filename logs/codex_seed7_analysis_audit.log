   380	class DeleteDuplicateRows(DeleteMultipleRows):
   381	  """Abstract class for tasks that involve deleting duplicate rows from a SQLite database."""
   382	
   383	  def _validate_candidates(
   384	      self, candidates: list[sqlite_schema_utils.RowType]
   385	  ) -> None:
   386	    """Validates the initial state before the deletion process starts."""
   387	    if len(candidates) % 2 != 0:
   388	      raise ValueError(
   389	          "Initial state validation failed. Must contain exactly two rows."
   390	      )
   391	    val1, val2 = candidates
   392	    for field in dataclasses.fields(val1):
   393	      if field.name == self.db_key:
   394	        continue
   395	      if getattr(val1, field.name) != getattr(val2, field.name):
   396	        raise ValueError(
   397	            "Initial state validation failed. Doesn't contain duplicate rows."
   398	        )
