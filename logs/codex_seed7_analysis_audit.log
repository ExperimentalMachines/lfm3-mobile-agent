    25	def _is_stopwatch_running(
    26	    ui_elements: list[representation_utils.UIElement],
    27	    current_activity: str,
    28	) -> bool:
    29	  """Checks if current screen is stopwatch running."""
    30	  if "DeskClock" not in current_activity:
    31	    return False
    32	  pause_present = False
    33	  lap_present = False
    34	
    35	  for element in ui_elements:
    36	    if element.content_description == "Pause":
    37	      pause_present = True
    38	    elif element.content_description == "Lap":
    39	      lap_present = True
    40	  return pause_present and lap_present
    41	
