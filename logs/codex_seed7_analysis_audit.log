   101	  def get_post_transition_state(self) -> interface.State:
   102	    """Convenience function to get the agent state after the transition."""
   103	    if self._transition_pause is None:
   104	      logging.info('Waiting for screen to stabilize before grabbing state...')
   105	      start = time.time()
   106	      state = self.env.get_state(wait_to_stabilize=True)
   107	      logging.info('Fetched after %.1f seconds.', time.time() - start)
   108	      return state
   109	    else:
   110	      time.sleep(self._transition_pause)
   111	      logging.info(
   112	          'Pausing {:2.1f} seconds before grabbing state.'.format(
   113	              self._transition_pause
   114	          )
   115	      )
   116	      return self.env.get_state(wait_to_stabilize=False)
