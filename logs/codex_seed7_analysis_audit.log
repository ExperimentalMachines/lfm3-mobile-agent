   326	class DeleteMultipleRows(SQLiteApp, abc.ABC):
   327	  """Abstract class for tasks that involve deleting multiple rows from a SQLite database."""
   328	
   329	  n_rows: int  # Number of rows to be deleted, to be defined in subclasses.
   330	  n_rows_noise: int  # Number of additional rows to add not relevant to goal.
   331	
   332	  def __init__(self, params: dict[str, Any]):
   333	    super().__init__(params)
   334	    self.rows_to_delete = []
   335	    self.before = []
   336	
   337	  def _validate_initial_state(
   338	      self, before: list[sqlite_schema_utils.RowType]
   339	  ) -> None:
   340	    """Validates the initial state before the deletion process starts."""
   341	    if len(before) != (self.n_rows + self.n_rows_noise):
   342	      raise RuntimeError(
   343	          "Initial state validation failed. The number of rows before deletion"
   344	          f" does not match the expected count. Found {len(before)} in DB, but"
   345	          f" expected {self.n_rows + self.n_rows_noise}."
   346	      )
   347	
   348	  def initialize_task(self, env: interface.AsyncEnv) -> None:
   349	    """Initial setup for the task, if necessary."""
   350	    super().initialize_task(env)
   351	    n_rows = 0
   352	    if ROW_OBJECTS in self.params:
   353	      self.add_rows(self.params[ROW_OBJECTS], env)
   354	      n_rows = len(self.params[ROW_OBJECTS])
   355	    self.before = self.list_rows(env)
   356	    # Newly added rows are at the end.
   357	    self.rows_to_delete = self.before[len(self.before) - n_rows :]
   358	    self._validate_initial_state(self.before)
   359	
   360	  def is_successful(self, env: interface.AsyncEnv) -> float:
   361	    """Determine if the row deletion task was successful."""
   362	    super().is_successful(env)
   363	
   364	    # Get the state of the database after the deletion attempt
   365	    after = self.list_rows(env)
   366	
   367	    # Validate the integrity of the deletion
   368	    deletion_successful = self.validate_deletion_integrity(self.before, after)
   369	    return 1.0 if deletion_successful else 0.0
