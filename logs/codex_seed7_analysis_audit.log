     1	#!/bin/bash
     2	# Queue AndroidWorld jobs on one emulator after <wait_pid> exits. Items (fields separated by "|"):
     3	#   arm|<arm>|<seed>|<server_port>                         -> full SEALED arm via scripts/local_sealed_aw_v3.sh (skipped if 116 done)
     4	#   rerun|<arm>|<seed>|<server_port>|<out_dir>|<tasks>|[label] -> preregistered single re-run via scripts/local_aw_rerun.sh
     5	# This log holds only start/end lines and episode-file counts (no outcomes).
     6	# Usage: nohup bash scripts/local_aw_queue_v2.sh <wait_pid> <console_port> <grpc_port> '<item>' ... > logs/x.log 2>&1 &
     7	set -u
     8	cd /Users/alpha/lfm3-android
     9	W=$1; CP=$2; GP=$3; shift 3
    10	log() { echo "[$(date +%T)] $*"; }
    11	count() { local d; d=$(ls -d "$1"/run_*/ 2>/dev/null | tail -1); [ -n "$d" ] && ls "$d"*.pkl.gz 2>/dev/null | wc -l | tr -d ' ' || echo 0; }
    12	log "queue on emulator $CP ($# items), waiting for PID $W"
    13	while kill -0 "$W" 2>/dev/null; do sleep 30; done
    14	for item in "$@"; do
    15	  IFS='|' read -r KIND ARM SEED PORT ODIR TASKS LABEL <<< "$item"
    16	  if [ "$KIND" = arm ]; then
    17	    D=results/androidworld_sealed/${ARM}_seed${SEED}
    18	    [ "$(count $D)" -ge 116 ] && { log "${ARM}_seed${SEED} already complete; skipping"; continue; }
    19	    log "start sealed ${ARM}_seed${SEED} (server :$PORT)"
    20	    bash scripts/local_sealed_aw_v3.sh "$ARM" "$SEED" "$CP" "$GP" "$PORT" >> logs/local_sealed_${ARM}_seed${SEED}.log 2>&1 < /dev/null
    21	    log "${ARM}_seed${SEED} ended: $(tail -1 logs/local_sealed_${ARM}_seed${SEED}.log | cut -c1-100) ($(count $D) episodes)"
    22	  else
    23	    log "start re-run ${ARM} seed ${SEED}: $TASKS -> $ODIR"
    24	    bash scripts/local_aw_rerun.sh "$ARM" "$SEED" "$CP" "$GP" "$PORT" "$ODIR" "$TASKS" "$LABEL" >> logs/local_aw_rerun_${ARM}_seed${SEED}.log 2>&1 < /dev/null
    25	    log "re-run ${ARM} seed ${SEED} ended: $(tail -1 logs/local_aw_rerun_${ARM}_seed${SEED}.log | cut -c1-100)"
    26	  fi
    27	done
    28	log "QUEUE DONE"

