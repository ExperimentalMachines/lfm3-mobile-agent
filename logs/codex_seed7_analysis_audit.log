    74	  """Determines if a timer is set.
    75	
    76	  Args:
    77	    ui_elements: A list of UI elements representing the interface components
    78	      within the "DeskClock" activity.
    79	    current_activity: The name of the current activity within the UI.
    80	    hours: The number of hours to check for in the timer.
    81	    minutes: The number of minutes to check for in the timer.
    82	    seconds: The number of seconds to check for in the timer.
    83	
    84	  Returns:
    85	    True if the timer is set with the specified hours, minutes, and seconds
    86	      within the "DeskClock" activity; False otherwise.
    87	  """
    88	  if "DeskClock" not in current_activity:
    89	    return False
    90	  text_format = f"{hours:02d}h {minutes:02d}m {seconds:02d}s"
    91	  content_desc_format = f"{hours} hours, {minutes} minutes, {seconds} seconds"
    92	
    93	  for element in ui_elements:
    94	    if (
    95	        element.text == text_format
    96	        or element.content_description == content_desc_format
    97	    ):
    98	      return True
    99	
   100	  return False
