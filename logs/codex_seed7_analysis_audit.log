   120	
   121	res = {"seeds": SEEDS, "arms": {}, "comparisons": {}, "notes": [], "seed_varying_counts": {s: len(v) for s, v in varying.items()},
   122	       "reruns_applied": SUBST}
   123	pending = [f"{arm} seed {s}: {sorted(t for t in data[(arm, s)][1] if data[(arm, s)][1][t])}" for s in SEEDS for arm in ARMS
   124	           if any(data[(arm, s)][1].values()) and not os.path.isdir(f"results/androidworld_sealed/{arm}_seed{s}_rerun")]
   125	if pending:
   126	    res["notes"].append("Exceptions without a re-run directory yet (check eligibility; preregistered single re-run pending): " + "; ".join(pending))
   127	if len(SEEDS) == 1:
