   159	  def _check_is_initialized(self) -> None:
   160	    if not self.initialized:
   161	      raise RuntimeError(
   162	          f"{self.name}.initialize_task() must be called before"
   163	          f" {self.name}.is_successful()."
   164	      )
   165	
   166	  def is_successful(self, env: interface.AsyncEnv) -> float:  # pylint: disable=unused-argument
   167	    """Determines if the task is successful.
   168	
   169	    Args:
   170	      env:
   171	
   172	    Returns:
   173	      0: Not successful.
   174	      1.0: Task is successful.
   175	
   176	      For composite tasks, that combine together multiple tasks, the output is
   177	      defined as sum(successful_tasks)/total_tasks.
   178	    """
   179	    self._check_is_initialized()
   180	    return 1.0
   181	
   182	  def tear_down(self, env: interface.AsyncEnv) -> None:  # pylint: disable=unused-argument
   183	    """Tears down the task."""
   184	    self._initialize_apps(env)
   185	    try:
   186	      adb_utils.close_recents(env.controller)
   187	    except:  # pylint: disable=bare-except
   188	      logging.exception("Failed to close recent apps. Continuing.")
   189	    self.initialized = False
   190	    logging.info("Tearing down %s", self.name)
    70	    if transition_pause is not None and transition_pause < 0:
    71	      raise ValueError(
    72	          f'transition_pause must be non-negative, got {transition_pause}'
    73	      )
    74	    self._transition_pause = transition_pause
    75	
    76	    self._max_steps = None
