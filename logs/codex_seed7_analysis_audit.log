    43	def _is_stopwatch_paused(
    44	    ui_elements: list[representation_utils.UIElement],
    45	    current_activity: str,
    46	) -> bool:
    47	  """Checks if current screen is stopwatch paused."""
    48	  if "DeskClock" not in current_activity:
    49	    return False
    50	  start_present = False
    51	  n_stopwatch = 0
    52	
    53	  for element in ui_elements:
    54	    if element.content_description == "Start":
    55	      start_present = True
    56	    elif (
    57	        element.content_description == "Stopwatch"
    58	        or element.text == "Stopwatch"
    59	    ):
    60	      n_stopwatch += 1
    61	  logging.info("Start present: %s", start_present)
    62	  logging.info("Stopwatch: %d", n_stopwatch)
    63	  return start_present and n_stopwatch >= 2
