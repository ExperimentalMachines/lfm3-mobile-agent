def collect_apps(rows, ep_apps):
    """Per-episode installed-app requirement: every open_app name the episode uses (gold actions + text histories).
    One frozen list per episode (same for every step and for its #qa copy), so the list cannot hint at the next action."""
    for r in rows:
        k = (r["source"], r["episode_id"])
        g = json.loads(r["gt_action"])
        names = af.apps_in_text(r["messages"][1]["content"]) + ([g["app_name"]] if g.get("action_type") == "open_app" else [])
        ep_apps.setdefault(k, [])
        for n in names:
            if n not in ep_apps[k]:
                ep_apps[k].append(n)
        hits = _CAP_APPS.findall(r["messages"][1]["content"].split("\n", 1)[-1])  # history/intent text (not the goal)
        if hits:
            HIST_AW.setdefault(k, set()).update(hits)


def v4(msgs, key, ep_apps):
    return af.to_v4_messages(msgs, af.v4_app_list(f"{key[0]}/{key[1]}", ep_apps[key], pool))


def final_answer(key):
    """Keep the shorter of the two strictly-agreeing teacher answers only when it just drops unit words."""
    return preferred(qa[key]["answer"], qa[key].get("verify_answer"))


def answer_json(text):
    return af.action_to_str({"action_type": "answer", "text": text})


# guard v3 (Codex data audit #3): capitalised AndroidWorld-device app names in goals AND in history/intent text
# (clicked share targets such as "Click on Gmail"), case-sensitive to avoid prose like "phone number".
_CAP_APPS = re.compile(r"\b(Gmail|Google Drive|Drive|Google Maps|Maps|YouTube|Google Photos|Photos|Chrome|Google Play|"
                       r"Play Store|Google Calendar|Calendar|Clock|Contacts|Files|Messages|Settings|Camera|Markor|Joplin|"
                       r"Broccoli|OpenTracks|OsmAnd|VLC|Retro Music|Simple [A-Z][a-z]+|Pro Expense|Audio Recorder|Tasks)\b")
HIST_AW = {}
EP = {}  # (source, episode_id) -> required app names, from ALL train shards (episodes can span shards)
for f in use:
    collect_apps(pq.ParquetFile(os.path.join(local, f)).read(columns=["source", "episode_id", "messages", "gt_action"]).to_pylist(), EP)
_POOL_RE = re.compile(r"(?<![\w&.'+-])(" + "|".join(re.escape(n) for n in sorted({x for x in pool if len(x) >= 3}, key=len, reverse=True))
                      + r")(?![\w&'+-])")
_goal_of = {}
for f in use:
    for r in pq.ParquetFile(os.path.join(local, f)).read(columns=["source", "episode_id", "messages"]).to_pylist():
        _goal_of.setdefault((r["source"], r["episode_id"]), r["messages"][1]["content"].split("\n", 1)[0].removeprefix("Goal: "))
n_goal_apps = 0
for k, g in _goal_of.items():
    for n in _POOL_RE.findall(g):
        if n not in EP[k]:
            EP[k].append(n)
            n_goal_apps += 1
print(f"app requirements for {len(EP)} episodes; {n_goal_apps} goal-named apps added ({time.time() - t0:.0f}s)", flush=True)
# AndroidWorld-app guard v2 (Codex pipeline audit #6): episode-wide app names (all histories + gold actions) checked
# against android_world's own launcher patterns (re.match, as AW resolves names) and AW display names; goal prose
# checked with whole-word app-type terms. Flagged episodes get no question copy and leave the dev splits.
_awp = json.load(open(a.aw_patterns))
_AW_PATS = [re.compile(x.lower()) for x in _awp["patterns"]] + [re.compile(re.escape(x)) for x in _awp["default_uris"]]
_AW_NAMES = {x.lower() for x in ["Audio Recorder", "Broccoli", "Camera", "Chrome", "Clock", "Contacts", "Drive", "Files",
             "Gmail", "Google", "Google Calendar", "Google Play", "Joplin", "Maps", "Markor", "Messages", "OpenTracks",
             "OsmAnd", "Phone", "Photos", "Pro Expense", "Retro Music", "Settings", "Simple Calendar Pro",
             "Simple Draw Pro", "Simple Gallery Pro", "Simple SMS Messenger", "Tasks", "VLC", "YouTube"]}
_TERMS = re.compile(r"\b(?:android world|markor|joplin|broccoli|recipes?|expenses?|opentracks|open tracks|osmand|vlc|"
                    r"retro music|music player|audio recorder|voice recorder|recorder|calendar|clock|alarms?|timers?|"
                    r"stopwatch|contacts?|dialer|sms|messages?|messenger|files|file manager|gallery|photos|camera|"
                    r"draw|tasks|to-do|todo|notes?|chrome|browser|settings|wi-?fi|bluetooth|brightness)\b", re.I)


def aw_flag(key):
    src, eid = key.split("/", 1)
    names = EP.get((src, eid), [])
    if any(n.lower() in _AW_NAMES or any(pt.match(n.lower()) for pt in _AW_PATS) or _TERMS.search(n) for n in names):
        return True
    if HIST_AW.get((src, eid)) or _CAP_APPS.search(cands[key]["goal"]):
        return True
    return bool(_TERMS.search(cands[key]["goal"]))


AW_FLAGGED = {k for k in qa if aw_flag(k)}
qa = {k: v for k, v in qa.items() if k not in AW_FLAGGED}
train_qa = {k for k in qa if cands[k]["split"] == "train"}
dev_qa = {k for k in qa if cands[k]["split"] == "dev"}
dev_comp = {k for k in dev_qa if cands[k]["kind"] == "compound"}  # "complete" controls only for action-only original goals
# answer leakage (Codex data audit #1): drop episodes whose final goal or question already contains the answer
_leak = set()
for k in list(qa):
    span = re.escape(norm(final_answer(k)))
    if span and (re.search(r"(?<![a-z0-9])" + span + r"(?![a-z0-9])", norm(new_goal(k, cands[k]["goal"])))
                 or re.search(r"(?<![a-z0-9])" + span + r"(?![a-z0-9])", norm(qa[k]["question"]))):
        _leak.add(k)
qa = {k: v for k, v in qa.items() if k not in _leak}
REJECT["answer_leak_dropped"] = len(_leak)
train_qa = {k for k in qa if cands[k]["split"] == "train"}
dev_qa = {k for k in qa if cands[k]["split"] == "dev"}
_INFO_CUE = re.compile(r"\b(?:need to know|want to know|tell me|how (?:much|many|long)|what|which|when|where|who|"
                       r"check|find out|look up|see|view|show|read|compare|know)\b", re.I)
dev_comp = {k for k in dev_qa if cands[k]["kind"] == "compound" and not _INFO_CUE.search(cands[k]["goal"])}
"""Static-screenshot GRPO for the LFM3-VL Android agent (runs ON a Colab GPU). Adapted from Liquid's official
LFM3-VL GRPO notebook (Liquid4All/cookbook finetuning/notebooks/lfm3_vl_grpo_with_trl.ipynb; same TRL 1.16 / Transformers
5.20 pins), following results/codex/codex_overnight_research.md: start from the merged v4 model, fresh language-only LoRA
r16/a32 (adapter disabled == v4, so the KL reference is v4), beta (KL) 0.001, 4 samples per state, short completions.

Data: a parquet RL pool (data/v4_rl_pool.py) with columns image, prompt (system+user messages exactly as in v4 SFT),
gt_action, kind. Reward: train/rl_reward.py (strict).
usage: python grpo_vlm.py --model <merged v4 dir|hub id> --data <repo>@<rev> --out <dir> [--max_steps N --smoke]
"""
import argparse
import json
import os
import time

import torch
from datasets import load_dataset
from huggingface_hub import HfApi
from peft import LoraConfig
from transformers import AutoModelForImageTextToText, AutoProcessor, TrainerCallback
from trl import GRPOConfig, GRPOTrainer

import rl_reward

p = argparse.ArgumentParser()
p.add_argument("--model", required=True)
p.add_argument("--data", required=True, help="repo@revision of the RL pool dataset")
p.add_argument("--out", required=True)
p.add_argument("--max_steps", type=int, default=200)
p.add_argument("--lr", type=float, default=1e-5)
p.add_argument("--beta", type=float, default=0.001)
p.add_argument("--bs", type=int, default=4)
p.add_argument("--ga", type=int, default=8)
p.add_argument("--gens", type=int, default=4)
p.add_argument("--max_completion", type=int, default=192)
p.add_argument("--max_pixels", type=int, default=774400)
p.add_argument("--save_steps", type=int, default=25)
p.add_argument("--hub_repo", default="", help="push checkpoints/adapter here (durable copy)")
p.add_argument("--smoke", action="store_true", help="tiny run: 4 steps, then reload check")
a = p.parse_args()
t0 = time.time()
repo, rev = a.data.split("@")
ds = load_dataset(repo, split="train", revision=rev)
if a.smoke:
    a.max_steps = 4
print(ds, flush=True)

processor = AutoProcessor.from_pretrained(a.model, trust_remote_code=True,
                                          size={"shortest_edge": 65536, "longest_edge": a.max_pixels})
processor.tokenizer.padding_side = "left"
model = AutoModelForImageTextToText.from_pretrained(a.model, dtype=torch.bfloat16, trust_remote_code=True,
                                                    attn_implementation="sdpa").to("cuda")
peft_config = LoraConfig(r=16, lora_alpha=32, lora_dropout=0.0, task_type="CAUSAL_LM",
                         target_modules=r".*language_model.*\.(q_proj|k_proj|v_proj|o_proj|in_proj|out_proj|w1|w2|w3)")
kw = dict(
    output_dir=a.out, max_steps=a.max_steps, per_device_train_batch_size=a.bs, gradient_accumulation_steps=a.ga,
    num_generations=a.gens, max_completion_length=a.max_completion, temperature=0.8, top_p=0.95,
    learning_rate=a.lr, lr_scheduler_type="constant_with_warmup", warmup_steps=10 if not a.smoke else 0,
    beta=a.beta, epsilon=0.2, loss_type="dapo", scale_rewards="group", num_iterations=1, max_grad_norm=1.0,
    weight_decay=0.0, bf16=True, gradient_checkpointing=True, gradient_checkpointing_kwargs={"use_reentrant": False},
    use_vllm=False, mask_truncated_completions=True, remove_unused_columns=False, logging_steps=1,
    save_steps=a.save_steps, save_total_limit=3, report_to="none", seed=4,
)
fields = set(GRPOConfig.__dataclass_fields__)
if "use_transformers_continuous_batching" in fields:
    kw["use_transformers_continuous_batching"] = False
if "chat_template_kwargs" in fields:
    kw["chat_template_kwargs"] = {"enable_thinking": True}  # same template mode as v4 SFT/eval (FT_THINK=1)
else:
    print("WARNING: GRPOConfig has no chat_template_kwargs; template default thinking mode used", flush=True)
cfg = GRPOConfig(**{k: v for k, v in kw.items() if k in fields})
print("ignored config keys:", sorted(set(kw) - fields), flush=True)


class Log(TrainerCallback):
    def on_log(self, args, state, control, logs=None, **k):
        if logs:
            keep = {k2: round(v, 4) if isinstance(v, float) else v for k2, v in logs.items()
                    if any(s in k2 for s in ("reward", "kl", "loss", "completion", "entropy", "clip", "learning_rate"))}
            print(f"[{time.time() - t0:.0f}s] step {state.global_step} {json.dumps(keep)}", flush=True)
            os.makedirs(a.out, exist_ok=True)
            with open(os.path.join(a.out, "rl_log.jsonl"), "a") as f:
                f.write(json.dumps({"step": state.global_step, "elapsed_s": round(time.time() - t0), **logs}) + "\n")

    def on_save(self, args, state, control, **k):
        if a.hub_repo:
            try:
                HfApi().upload_folder(folder_path=args.output_dir, repo_id=a.hub_repo, path_in_repo="checkpoints",
                                      allow_patterns=[f"checkpoint-{state.global_step}/*", "rl_log.jsonl"])
            except Exception as e:  # a failed durable copy must be visible but not kill training
                print("checkpoint upload failed:", e, flush=True)


trainer = GRPOTrainer(model=model, reward_funcs=[rl_reward.reward_fn], args=cfg, train_dataset=ds,
                      processing_class=processor, peft_config=peft_config, callbacks=[Log()])
names = [n for n, p_ in trainer.model.named_parameters() if p_.requires_grad]
assert names and all("language_model" in n and "lora_" in n for n in names), names[:5]
print(f"trainable tensors: {len(names)} (all language-model LoRA)", flush=True)
if a.hub_repo:
    HfApi().create_repo(a.hub_repo, private=True, exist_ok=True)
trainer.train()
print(f"trained {a.max_steps} steps in {time.time() - t0:.0f}s; peak GPU {torch.cuda.max_memory_allocated() / 1e9:.1f} GB",
      flush=True)
trainer.save_model(os.path.join(a.out, "lora"))
merged = trainer.model.merge_and_unload()
merged.save_pretrained(os.path.join(a.out, "merged"))
processor.save_pretrained(os.path.join(a.out, "merged"))
for f in os.listdir(a.model) if os.path.isdir(a.model) else []:  # remote code files of the base model
    if f.endswith(".py") or f.endswith(".jinja"):
        import shutil
        shutil.copy(os.path.join(a.model, f), os.path.join(a.out, "merged", f))
# reload check in the same process: the merged model must load and generate a parseable action
m2 = AutoModelForImageTextToText.from_pretrained(os.path.join(a.out, "merged"), dtype=torch.bfloat16,
                                                 trust_remote_code=True).to("cuda").eval()
ex = ds[0]
conv = [{"role": "system", "content": [{"type": "text", "text": ex["prompt"][0]["content"]}]},
        {"role": "user", "content": [{"type": "image", "image": ex["image"]}, {"type": "text", "text": ex["prompt"][1]["content"]}]}]
inp = processor.apply_chat_template([conv], add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors="pt",
                                    processor_kwargs={"padding": True}, enable_thinking=True).to("cuda")
o = m2.generate(**inp, max_new_tokens=a.max_completion, do_sample=False)
txt = processor.batch_decode(o[:, inp["input_ids"].shape[1]:], skip_special_tokens=False)[0]
print("reload check output:", txt[:200].replace("\n", " "), flush=True)
print("RL DONE", flush=True)
#!/bin/bash
# v4 hand-off: wait for merged v4 weights on the hub -> phone GGUF -> pause the sealed v1 seed-7 arm on emulator 2
# -> AndroidWorld seed-30 DEVELOPMENT pass with the v4 prompt (not sealed; gate in docs/PREREG_v4.md).
# Usage: bash scripts/local_v4_to_aw.sh <final_repo>
set -u
cd /Users/alpha/lfm3-android
REPO=$1; OUT=models/lfm3vl2b_v4-GGUF; NAME=lfm3vl2b_v4; PORT=8114; CP=5558; GP=8558
GG=$OUT/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf; MM=models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf
echo "[$(date +%T)] waiting for merged weights in $REPO"
until .venv-convert/bin/python - "$REPO" <<'PY'
import sys
from huggingface_hub import HfApi
try:
    fs = {s.rfilename for s in HfApi().model_info(sys.argv[1]).siblings}
except Exception:
    sys.exit(1)
sys.exit(0 if "config.json" in fs and any(f.endswith(".safetensors") for f in fs) and any(f.startswith("lora_adapter/") for f in fs) else 1)
PY
do sleep 120; done
echo "[$(date +%T)] merged weights on hub; exporting"
bash scripts/local_export_gguf.sh "$REPO" "$OUT" || { echo "EXPORT FAILED"; exit 1; }
[ -s "$GG" ] && [ -s "$MM" ] || { echo "EXPORT FAILED (missing $GG)"; exit 1; }
echo "[$(date +%T)] exported; pausing the sealed v1 seed-7 arm on emulator $CP (resumed afterwards from its checkpoint)"
RESUME_V1=""
if ! grep -q "SEALED v1_seed7 AndroidWorld finished$" logs/local_sealed_v1_seed7.log 2>/dev/null; then
  bash scripts/pause_sealed_arm.sh v1 7 8111
  RESUME_V1=$(ls -d results/androidworld_sealed/v1_seed7/run_* | tail -1)
fi
until ! pgrep -f "[r]un_aw.py.*console_port=$CP" >/dev/null; do sleep 10; done
nohup llama-server -m $GG --mmproj $MM -c 8192 -np 1 -ngl 99 --image-max-tokens 1024 \
  --reasoning-format deepseek --port $PORT --host 127.0.0.1 > logs/llama_server_$NAME.log 2>&1 < /dev/null &
until curl -s 127.0.0.1:$PORT/health | grep -q ok; do sleep 3; done
echo "[$(date +%T)] server :$PORT up; starting v4 seed-30 development pass on emulator $CP"
.venv-aw/bin/python eval/androidworld/run_aw.py --console_port=$CP --grpc_port=$GP --server_url=http://127.0.0.1:$PORT \
  --agent_label=lfm3vl2b_v4_q4km --enable_thinking=true --prompt_version=v4 --output_path=results/androidworld/$NAME 2>&1 \
  | grep --line-buffered -v "_os_env_vars\|FD from fork\|fork_posix" > logs/aw_run_$NAME.log
pkill -f "[l]lama-server.*--port $PORT "
echo "[$(date +%T)] v4 AndroidWorld seed-30 finished"
if [ -n "$RESUME_V1" ]; then
  echo "[$(date +%T)] resuming sealed v1 seed-7 from $RESUME_V1"
  bash scripts/local_sealed_aw_v2.sh v1 7 $CP $GP 8111 "$RESUME_V1" >> logs/local_sealed_v1_seed7.log 2>&1
fi

