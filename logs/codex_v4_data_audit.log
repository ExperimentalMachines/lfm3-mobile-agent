+
+rows=[]
+checks=C.Counter(); bad=C.defaultdict(list); counts={}; app_lists=C.defaultdict(set); allshas=C.defaultdict(set)
+for f in files:
+    part=f.name.split('-')[0]
+    rr=pq.read_table(f,columns=[n for n in pq.ParquetFile(f).schema_arrow.names if n!='images']).to_pylist()
