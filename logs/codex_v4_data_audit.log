+                im=Image.open(io.BytesIO(rr['images'][0]['bytes']));im.save(ROOT/r['png']);r['messages']=rr['messages'];break
+            offset+=nrg
+        extra.append(r)
+    batch=extra[-n:];sheet=Image.new('RGB',(540*n,1260),'#ddd');d=ImageDraw.Draw(sheet)
