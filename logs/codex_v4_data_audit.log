"""Strict reward for static-screenshot GRPO on the v4 agent format (one sampled reply -> one score in [0, 1]).

Only the final action (content after </think>) is scored, with the project's strict parser; malformed output, extra
objects, unfinished reasoning or a wrong action type score 0. No bonus for format, length, or picking `answer`.
  answer        -> 1 iff action is `answer` and the text matches the reference (data/v4_answer_check.same_answer:
                   numbers/signs/decimals/times exact, no partial entities, negation-aware)
  status        -> 1 iff action is `status` with the same goal_status
  open_app      -> 1 iff same app name (case/space-insensitive)
  input_text    -> 1 iff same text after whitespace/case normalisation
  scroll        -> 1 iff same direction
  back/home/enter/wait -> 1 iff same type
  click/long_press -> exp(-(d / 0.05)^2), d = distance between points on the unit square (0-1000 grid / 1000);
                   d = 0.05 -> 0.37, 0.10 -> 0.02 (only same-type actions; no radius is claimed to be an element box)
"""
import json
import math
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "data"))
import agent_format as af  # noqa: E402
from v4_answer_check import same_answer  # noqa: E402

SIGMA = 0.05


def _txt(s):
    return re.sub(r"\s+", " ", str(s or "").strip().lower())


def action_reward(output_text, gt):
    gt = json.loads(gt) if isinstance(gt, str) else gt
    a = af.parse_action(output_text, strict=True)
    if a is None or a["action_type"] != gt["action_type"]:
        return 0.0
    t = gt["action_type"]
    if t == "answer":
        return float(same_answer(a["text"], gt["text"]))
    if t == "status":
        return float(a.get("goal_status") == gt.get("goal_status", "complete"))
    if t == "open_app":
        return float(_txt(a["app_name"]) == _txt(gt["app_name"]))
    if t == "input_text":
        return float(_txt(a["text"]) == _txt(gt["text"]))
    if t == "scroll":
        return float(a["direction"] == gt["direction"])
    if t in ("click", "long_press"):
        (x, y), (gx, gy) = a["point_2d"], gt["point_2d"]
        d = math.hypot((x - gx) / 1000, (y - gy) / 1000)
        return math.exp(-((d / SIGMA) ** 2))
    return 1.0  # navigate_back / navigate_home / keyboard_enter / wait: type already matched


def completion_text(completion):
    """TRL conversational completion -> raw text with the reasoning re-attached (so an unclosed <think> stays invalid)."""
    if isinstance(completion, str):
        return completion
    m = completion[0] if isinstance(completion, list) else completion
    content = m.get("content") or ""
    if isinstance(content, list):
        content = "".join(c.get("text", "") for c in content if isinstance(c, dict))
    reasoning = m.get("reasoning_content") or m.get("reasoning") or ""
    if reasoning and "</think>" not in content:
        return f"<think>{reasoning}</think>{content}"
    return content


def reward_fn(completions, gt_action, **kwargs):
    return [action_reward(completion_text(c), g) for c, g in zip(completions, gt_action)]


if __name__ == "__main__":
    A = lambda t: json.dumps({"action_type": "answer", "text": t})
    S = json.dumps({"action_type": "status", "goal_status": "complete"})
    C = json.dumps({"action_type": "click", "point_2d": [500, 500]})
    out = lambda act, think="x": f"<think>{think}</think>" + json.dumps(act, separators=(",", ":"))
    cases = [
        (out({"action_type": "answer", "text": "1.5"}), A("15"), 0.0),
        (out({"action_type": "answer", "text": "-2"}), A("2"), 0.0),
        (out({"action_type": "answer", "text": "1:30"}), A("130"), 0.0),
        (out({"action_type": "answer", "text": "York"}), A("New York"), 0.0),
        (out({"action_type": "answer", "text": "alerts"}), A("no alerts"), 0.0),
        (out({"action_type": "answer", "text": "New York"}), A("new york"), 1.0),
        (out({"action_type": "answer", "text": "382"}), A("382"), 1.0),
        (out({"action_type": "status", "goal_status": "complete"}), A("382"), 0.0),   # complete on a question
        (out({"action_type": "answer", "text": "done"}), S, 0.0),                     # answer on an action goal
        (out({"action_type": "status", "goal_status": "complete"}), S, 1.0),
        ('<think>x</think>{"action_type":"answer","text":"382"}{"action_type":"answer","text":"382"}', A("382"), 0.0),
        ('<think>I will answer {"action_type":"answer","text":"382"}', A("382"), 0.0),  # answer only inside reasoning
        (out({"action_type": "click", "point_2d": [500, 500]}), C, 1.0),
        (out({"action_type": "click", "point_2d": [550, 500]}), C, math.exp(-1)),
        (out({"action_type": "click", "point_2d": [1200, 500]}), C, 0.0),           # off-screen -> strict parse fails
        (out({"action_type": "long_press", "point_2d": [500, 500]}), C, 0.0),
    ]
    for o, g, want in cases:
        got = action_reward(o, g)
        assert abs(got - want) < 1e-6, (o, g, got, want)
    msg = [{"role": "assistant", "content": '{"action_type":"answer","text":"382"}', "reasoning_content": "It shows 382."}]
    assert reward_fn([msg], [A("382")]) == [1.0]
    assert reward_fn(['<think>x</think>{"action_type":"answer","text":"382"}'], [A("382")]) == [1.0]
    print(f"reward fixtures pass ({len(cases) + 2})")
"""Static-screenshot GRPO for the LFM3-VL Android agent (runs ON a Colab GPU). Adapted from Liquid's official
LFM3-VL GRPO notebook (Liquid4All/cookbook finetuning/notebooks/lfm3_vl_grpo_with_trl.ipynb; same TRL 1.16 / Transformers
5.20 pins), following results/codex/codex_overnight_research.md: start from the merged v4 model, fresh language-only LoRA
r16/a32 (adapter disabled == v4, so the KL reference is v4), beta (KL) 0.001, 4 samples per state, short completions.

Data: a parquet RL pool (data/v4_rl_pool.py) with columns image, prompt (system+user messages exactly as in v4 SFT),
gt_action, kind. Reward: train/rl_reward.py (strict).
usage: python grpo_vlm.py --model <merged v4 dir|hub id> --data <repo>@<rev> --out <dir> [--max_steps N --smoke]
"""
import argparse
import json
import os
import time

import torch
from datasets import load_dataset
from huggingface_hub import HfApi
from peft import LoraConfig
from transformers import AutoModelForImageTextToText, AutoProcessor, TrainerCallback
from trl import GRPOConfig, GRPOTrainer

import rl_reward

p = argparse.ArgumentParser()
p.add_argument("--model", required=True)
p.add_argument("--data", required=True, help="repo@revision of the RL pool dataset")
p.add_argument("--out", required=True)
p.add_argument("--max_steps", type=int, default=200)
p.add_argument("--lr", type=float, default=1e-5)
p.add_argument("--beta", type=float, default=0.001)
p.add_argument("--bs", type=int, default=4)
p.add_argument("--ga", type=int, default=8)
p.add_argument("--gens", type=int, default=4)
p.add_argument("--max_completion", type=int, default=192)
p.add_argument("--max_pixels", type=int, default=774400)
p.add_argument("--save_steps", type=int, default=25)
p.add_argument("--hub_repo", default="", help="push checkpoints/adapter here (durable copy)")
p.add_argument("--smoke", action="store_true", help="tiny run: 4 steps, then reload check")
a = p.parse_args()
t0 = time.time()
repo, rev = a.data.split("@")
ds = load_dataset(repo, split="train", revision=rev)
if a.smoke:
    a.max_steps = 4
print(ds, flush=True)

processor = AutoProcessor.from_pretrained(a.model, trust_remote_code=True,
                                          size={"shortest_edge": 65536, "longest_edge": a.max_pixels})
processor.tokenizer.padding_side = "left"
model = AutoModelForImageTextToText.from_pretrained(a.model, dtype=torch.bfloat16, trust_remote_code=True,
                                                    attn_implementation="sdpa").to("cuda")
peft_config = LoraConfig(r=16, lora_alpha=32, lora_dropout=0.0, task_type="CAUSAL_LM",
                         target_modules=r".*language_model.*\.(q_proj|k_proj|v_proj|o_proj|in_proj|out_proj|w1|w2|w3)")
kw = dict(
    output_dir=a.out, max_steps=a.max_steps, per_device_train_batch_size=a.bs, gradient_accumulation_steps=a.ga,
    num_generations=a.gens, max_completion_length=a.max_completion, temperature=0.8, top_p=0.95,
    learning_rate=a.lr, lr_scheduler_type="constant_with_warmup", warmup_steps=10 if not a.smoke else 0,
    beta=a.beta, epsilon=0.2, loss_type="dapo", scale_rewards="group", num_iterations=1, max_grad_norm=1.0,
    weight_decay=0.0, bf16=True, gradient_checkpointing=True, gradient_checkpointing_kwargs={"use_reentrant": False},
    use_vllm=False, mask_truncated_completions=True, remove_unused_columns=False, logging_steps=1,
    save_steps=a.save_steps, save_total_limit=3, report_to="none", seed=4,
)
fields = set(GRPOConfig.__dataclass_fields__)
if "use_transformers_continuous_batching" in fields:
    kw["use_transformers_continuous_batching"] = False
if "chat_template_kwargs" in fields:
    kw["chat_template_kwargs"] = {"enable_thinking": True}  # same template mode as v4 SFT/eval (FT_THINK=1)
else:
    print("WARNING: GRPOConfig has no chat_template_kwargs; template default thinking mode used", flush=True)
cfg = GRPOConfig(**{k: v for k, v in kw.items() if k in fields})
print("ignored config keys:", sorted(set(kw) - fields), flush=True)


class Log(TrainerCallback):
    def on_log(self, args, state, control, logs=None, **k):
        if logs:
            keep = {k2: round(v, 4) if isinstance(v, float) else v for k2, v in logs.items()
                    if any(s in k2 for s in ("reward", "kl", "loss", "completion", "entropy", "clip", "learning_rate"))}
            print(f"[{time.time() - t0:.0f}s] step {state.global_step} {json.dumps(keep)}", flush=True)
            os.makedirs(a.out, exist_ok=True)
            with open(os.path.join(a.out, "rl_log.jsonl"), "a") as f:
                f.write(json.dumps({"step": state.global_step, "elapsed_s": round(time.time() - t0), **logs}) + "\n")

    def on_save(self, args, state, control, **k):
        if a.hub_repo:
            try:
                HfApi().upload_folder(folder_path=args.output_dir, repo_id=a.hub_repo, path_in_repo="checkpoints",
                                      allow_patterns=[f"checkpoint-{state.global_step}/*", "rl_log.jsonl"])
            except Exception as e:  # a failed durable copy must be visible but not kill training
                print("checkpoint upload failed:", e, flush=True)


trainer = GRPOTrainer(model=model, reward_funcs=[rl_reward.reward_fn], args=cfg, train_dataset=ds,
                      processing_class=processor, peft_config=peft_config, callbacks=[Log()])
names = [n for n, p_ in trainer.model.named_parameters() if p_.requires_grad]
assert names and all("language_model" in n and "lora_" in n for n in names), names[:5]
print(f"trainable tensors: {len(names)} (all language-model LoRA)", flush=True)
if a.hub_repo:
    HfApi().create_repo(a.hub_repo, private=True, exist_ok=True)
trainer.train()
print(f"trained {a.max_steps} steps in {time.time() - t0:.0f}s; peak GPU {torch.cuda.max_memory_allocated() / 1e9:.1f} GB",
      flush=True)
trainer.save_model(os.path.join(a.out, "lora"))
merged = trainer.model.merge_and_unload()
merged.save_pretrained(os.path.join(a.out, "merged"))
processor.save_pretrained(os.path.join(a.out, "merged"))
for f in os.listdir(a.model) if os.path.isdir(a.model) else []:  # remote code files of the base model
    if f.endswith(".py") or f.endswith(".jinja"):
        import shutil
        shutil.copy(os.path.join(a.model, f), os.path.join(a.out, "merged", f))
# reload check in the same process: the merged model must load and generate a parseable action
m2 = AutoModelForImageTextToText.from_pretrained(os.path.join(a.out, "merged"), dtype=torch.bfloat16,
                                                 trust_remote_code=True).to("cuda").eval()
ex = ds[0]
conv = [{"role": "system", "content": [{"type": "text", "text": ex["prompt"][0]["content"]}]},
        {"role": "user", "content": [{"type": "image", "image": ex["image"]}, {"type": "text", "text": ex["prompt"][1]["content"]}]}]
inp = processor.apply_chat_template([conv], add_generation_prompt=True, tokenize=True, return_dict=True, return_tensors="pt",
                                    processor_kwargs={"padding": True}, enable_thinking=True).to("cuda")
o = m2.generate(**inp, max_new_tokens=a.max_completion, do_sample=False)
txt = processor.batch_decode(o[:, inp["input_ids"].shape[1]:], skip_special_tokens=False)[0]
print("reload check output:", txt[:200].replace("\n", " "), flush=True)
print("RL DONE", flush=True)
#!/bin/bash
# RL pilot job (uploaded as /content/work/rl_go.sh; started by vm_rl_hook.sh next to the v4 pipeline, no kernel restart).
#   1. smoke: 4 GRPO steps on the BASE model with the real pool -> code path, memory, s/step (no v4 needed yet)
#   2. wait for the v4 pipeline to finish (merged weights + evals; avoids GPU contention / OOM)
#   3. main GRPO from merged v4: steps = min(MAX_STEPS, budget / measured s/step)
#   4. push merged + adapter, then offline evals on the v4 dev splits + AndroidControl test (v4 prompt)
# Env set below by the launcher (sed): RL_DATA DEV_REPO DEV_REV
set -uo pipefail
export HF_TOKEN=$(cat /content/.hf_token) TOKENIZERS_PARALLELISM=false
cd /content/work
RL_DATA=__RL_DATA__; DEV_REPO=__DEV_REPO__; DEV_REV=__DEV_REV__
MAX_STEPS=${MAX_STEPS:-200}; BUDGET_S=${BUDGET_S:-16200}   # 4.5 h for the main optimisation
V4=/content/runs/lfm3vl2b-v4mix-lora/merged
OUT=/content/runs/v4rl; FINAL=alpharomercoma/LFM3-VL-2B-AndroidAgent-v4-RL
log() { echo "[$(date +%T)] rl: $*"; }
log "smoke on base model"
python grpo_vlm.py --model LiquidAI/LFM3-VL-2B --data $RL_DATA --out /content/runs/rl_smoke --smoke > /content/runs/rl_smoke.log 2>&1
grep -q "RL DONE" /content/runs/rl_smoke.log || { log "SMOKE FAILED"; tail -40 /content/runs/rl_smoke.log; exit 1; }
SPS=$(python - <<'PY'
import json
L = [json.loads(l) for l in open("/content/runs/rl_smoke/rl_log.jsonl")]
L = [x for x in L if x.get("step", 0) >= 1]
print(round((L[-1]["elapsed_s"] - L[0]["elapsed_s"]) / max(1, L[-1]["step"] - L[0]["step"]), 1) if len(L) > 1 else 120)
PY
)
log "smoke ok; ${SPS} s/step"
log "waiting for the v4 pipeline to finish"
until grep -q "PIPELINE DONE\|PIPELINE FINISHED WITH FAILURES" /content/runs/lfm3_v4_pipeline.log 2>/dev/null; do
  grep -q "TRAINING FAILED" /content/runs/lfm3_v4_pipeline.log 2>/dev/null && { log "v4 training failed; no RL"; exit 1; }
  sleep 60
done
[ -f $V4/config.json ] || { log "no merged v4 at $V4"; exit 1; }
STEPS=$(python -c "print(max(10, min($MAX_STEPS, int($BUDGET_S / max(1.0, 1.15 * $SPS)))))")
log "main GRPO from v4: $STEPS steps"
python grpo_vlm.py --model $V4 --data $RL_DATA --out $OUT --max_steps $STEPS --hub_repo ${FINAL}-ckpt > /content/runs/v4rl_train.log 2>&1
grep -q "RL DONE" /content/runs/v4rl_train.log || { log "RL TRAINING FAILED"; tail -40 /content/runs/v4rl_train.log; exit 1; }
python - <<PY || log "upload merged failed"
from huggingface_hub import HfApi
api = HfApi(); api.create_repo("$FINAL", private=True, exist_ok=True)
api.upload_folder(folder_path="$OUT/merged", repo_id="$FINAL", commit_message="v4 + static GRPO (merged)")
api.upload_folder(folder_path="$OUT/lora", path_in_repo="lora_adapter", repo_id="$FINAL")
api.upload_file(path_or_fileobj="$OUT/rl_log.jsonl", path_in_repo="training_logs/rl_log.jsonl", repo_id="$FINAL")
PY
log "offline evals"
for sp in dev_answer dev_complete dev_screenqa dev_odyssey dev_amex; do
  N=$(python -c "from datasets import load_dataset; from huggingface_hub import HfApi; fs=HfApi().list_repo_files('$DEV_REPO', repo_type='dataset', revision='$DEV_REV'); print(len(load_dataset('$DEV_REPO', data_files={'$sp': [f for f in fs if f.startswith('data/$sp-')]}, split='$sp', revision='$DEV_REV')))")
  python generate.py --model $OUT/merged --data "$DEV_REPO@$sp#$DEV_REV" --out /content/eval/lfm3_v4rl_$sp.jsonl --enable_thinking 1 \
    --bs 32 --max_pixels 774400 --prompt_v4_pool /content/work/meta/app_pool.json \
    && python score_dev.py /content/eval/lfm3_v4rl_$sp.jsonl --expect_n $N --out /content/eval/lfm3_v4rl_$sp.metrics.json || log "dev $sp failed"
done
python generate.py --model $OUT/merged --data experimentalmachines/AndroidControl-screen-agent-sft@test --out /content/eval/lfm3vl2b-v4rl_ft.jsonl \
  --enable_thinking 1 --bs 32 --max_pixels 774400 --prompt_v4_pool /content/work/meta/app_pool.json \
  && python score.py /content/eval/lfm3vl2b-v4rl_ft.jsonl --gt /content/work/meta/androidcontrol_test_gt.jsonl \
     --expect model=$OUT/merged,max_pixels=774400,enable_thinking=1 --out /content/eval/lfm3vl2b-v4rl_ft.metrics.json || log "AC test failed"
python - <<PY
import glob, os
from huggingface_hub import HfApi
api = HfApi()
for f in glob.glob("/content/eval/lfm3*v4rl*"):
    api.upload_file(path_or_fileobj=f, path_in_repo=f"eval/{os.path.basename(f)}", repo_id="$FINAL")
PY
log "RL PIPELINE DONE"
"""RL state pool for the static-screenshot GRPO pilot (Codex research rank 1), drawn ONLY from the built v4 train split.

2,000 single-screenshot states, prompts exactly as in v4 SFT (system + user messages), gold action as reward metadata:
  700 qa_final    : final rows of navigate-then-answer copies (answer; strict typed match)   [one per episode]
  500 complete    : final rows of original AndroidControl action episodes (status complete)
  300 other       : open_app / input_text / scroll / navigate_* / keyboard_enter / wait
  500 click       : click / long_press (dense distance reward)
No dev episodes (they are not in v4 train), no ScreenQA. Deterministic (seed 4). Pushed as a private dataset.
usage: python data/v4_rl_pool.py --v4_out data/v4work/build/out --repo alpharomercoma/AndroidAgent-RL-v4 [--dry_run]
"""
import argparse
import glob
import json
import os
import random

import pyarrow.parquet as pq
from datasets import Dataset, Features, Image, Sequence, Value

p = argparse.ArgumentParser()
p.add_argument("--v4_out", required=True)
p.add_argument("--repo", default="alpharomercoma/AndroidAgent-RL-v4")
p.add_argument("--dry_run", action="store_true")
a = p.parse_args()
QUOTA = {"qa_final": 700, "complete": 500, "other": 300, "click": 500}
rnd = random.Random(4)
buckets = {k: [] for k in QUOTA}
seen_final = set()
for f in sorted(glob.glob(os.path.join(a.v4_out, "data/train-*.parquet"))):
    t = pq.read_table(f, columns=["source", "episode_id", "gt_action", "is_terminal", "img_sha"]).to_pylist()
    for i, r in enumerate(t):
        if r["source"] == "screenqa":
            continue
        g = json.loads(r["gt_action"])
        typ = g["action_type"]
        if r["episode_id"].endswith("#qa") and typ == "answer":
            if r["episode_id"] in seen_final:  # final answer rows are duplicated for SFT weighting; one per episode here
                continue
            seen_final.add(r["episode_id"])
            buckets["qa_final"].append((f, i))
        elif r["episode_id"].endswith("#qa"):
            continue  # prefix rows of question copies duplicate original states
        elif typ == "status":
            buckets["complete"].append((f, i))
        elif typ in ("click", "long_press"):
            buckets["click"].append((f, i))
        elif typ != "answer":
            buckets["other"].append((f, i))
pick = {}
for k, n in QUOTA.items():
    rnd.shuffle(buckets[k])
    for f, i in buckets[k][:n]:
        pick.setdefault(f, []).append((i, k))
    print(k, "available", len(buckets[k]), "picked", min(n, len(buckets[k])), flush=True)
rows = {"image": [], "prompt": [], "gt_action": [], "kind": [], "episode_id": []}
for f, items in pick.items():
    t = pq.read_table(f, columns=["images", "messages", "gt_action", "episode_id"])
    msgs, imgs, gts, eps = (t.column(c).to_pylist() for c in ("messages", "images", "gt_action", "episode_id"))
    for i, k in items:
        m = msgs[i]
        assert m[0]["role"] == "system" and m[1]["role"] == "user" and "\nInstalled apps: " in m[1]["content"]
        rows["image"].append({"bytes": imgs[i][0]["bytes"], "path": None})
        rows["prompt"].append([{"role": "system", "content": m[0]["content"]}, {"role": "user", "content": m[1]["content"]}])
        rows["gt_action"].append(gts[i])
        rows["kind"].append(k)
        rows["episode_id"].append(eps[i])
feat = Features({"image": Image(), "prompt": [{"role": Value("string"), "content": Value("string")}],
                 "gt_action": Value("string"), "kind": Value("string"), "episode_id": Value("string")})
ds = Dataset.from_dict(rows, features=feat).shuffle(seed=4)
print(ds, {k: rows["kind"].count(k) for k in QUOTA}, flush=True)
if a.dry_run:
    raise SystemExit(0)
ds.push_to_hub(a.repo, private=True)
from huggingface_hub import HfApi  # noqa: E402

print("pushed", a.repo, HfApi().dataset_info(a.repo).sha, flush=True)

hook: PostToolUse
hook: PostToolUse
