import hashlib,json,re
from pathlib import Path
root=Path.cwd();out=root/'results/codex/v4_data_audit';report=root/'results/codex/codex_v4_data_audit.md'
missing=[]
for f in [report,out/'technical_notes.md']:
 for target in re.findall(r'\\]\\((["'^)]+)'"\\)',f.read_text()):
  if target.startswith(('http:','https:')):continue
  if not (f.parent/target).exists():missing.append([str(f.relative_to(root)),target])
v=json.load(open(out/'visual_review.json'));sample_ids=[r['id'] for r in v['primary']]
assert report.read_text().splitlines()[0]=='STOP'
assert len(sample_ids)==len(set(sample_ids))==110
assert len(v['supplemental'])==9
assert all((root/r['png']).is_file() for r in v['primary']+v['supplemental'])
assert not missing,missing
old=json.load(open(out/'source_identity.json'));changed=[f for f,h in old['sha256'].items() if hashlib.sha256((root/f).read_bytes()).hexdigest()"'!=h]
assert not changed,changed
result={'"'report_first_line':'STOP','primary_visual_reviews':110,'supplemental_reviews':9,'missing_local_links':missing,'scoped_source_changes':changed,'report_words':len(report.read_text().split()),'report_sha256':hashlib.sha256(report.read_bytes()).hexdigest()}
