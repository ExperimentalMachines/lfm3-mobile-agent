+    for r in samples:f.write('\t'.join(str(r[k]).replace('\t',' ').replace('\n',' ') for k in ['sample_id','stratum','episode_id','answer','goal','png'])+'\n')
+
+# Contact sheets keep every image visible; original PNGs retained for close inspection.
+font=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial.ttf',22)
+for group in ['qa','screenqa','dev']:
