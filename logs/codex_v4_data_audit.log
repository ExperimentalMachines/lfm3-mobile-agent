     6	  * numeric answers: the ordered list of number tokens (sign, decimals, thousands separators, times like 1:30 kept
     7	    intact) must be identical; remaining words of the shorter answer must be a whole-word subset of the longer one
     8	    ("382 followers" ~ "382", but "1.5" != "15", "-2" != "2", "1:30" != "130");
     9	  * non-numeric answers: exact equality after normalisation (no substring matches: "york" != "new york");
    10	  * negation guard: if either side contains a negation word the other lacks, reject.
    11	"""
    12	import re
    13	
    14	NUM = re.compile(r"[-+]?\d[\d,]*(?:\.\d+)?(?::\d+)*")
    15	NEG = {"no", "not", "none", "never", "nothing", "without", "zero", "isn't", "aren't", "doesn't", "don't", "can't", "cannot"}
    16	
    17	
    18	def norm(s):
    19	    s = re.sub(r"\s+", " ", str(s or "").strip().lower())
    20	    s = s.strip("\"'`“”‘’ ")
    21	    return s[:-1] if s.endswith(".") and not re.search(r"\d\.$", s) else s
    22	
    23	
    24	def nums(s):
    25	    return [n.replace(",", "") for n in NUM.findall(s)]
    26	
    27	
    28	def words(s):
    29	    return set(re.findall(r"[a-z]+(?:'[a-z]+)?", NUM.sub(" ", s)))
    30	
    31	
    32	CUR = re.compile(r"[$€£¥₹₩₽¢]|\b(?:usd|eur|gbp|inr|aed|rs|c\$|a\$)\b")
    33	
    34	
    35	def same_answer(a, b):
    36	    a, b = norm(a), norm(b)
    37	    if not a or not b or "none" in (a, b):
    38	        return False
    39	    if sorted(CUR.findall(a)) != sorted(CUR.findall(b)) and CUR.findall(a) and CUR.findall(b):
    40	        return False  # "$10" vs "€10"
    41	    if (words(a) & NEG) != (words(b) & NEG):
    42	        return False
    43	    na, nb = nums(a), nums(b)
    44	    if na or nb:
    45	        if na != nb:
    46	            return False
    47	        short, long_ = sorted((a, b), key=len)
    48	        return words(short) <= words(long_)
    49	    return a == b
    50	
    51	
    52	def preferred(answer, verify):
    53	    """The shorter of two agreeing answers when it only drops unit/filler words (e.g. '382 Followers' -> '382')."""
    54	    a, v = str(answer or "").strip(), str(verify or "").strip()
    55	    if v and len(v) < len(a) and same_answer(a, v) and nums(norm(a)) == nums(norm(v)) and nums(norm(a)):
    56	        return v
    57	    return a
    58	
    59	
    60	def safe_short(long_answer, short):
    61	    """ScreenQA shortening is accepted only if it keeps every number and negation of the original and is a substring."""
    62	    L, S = norm(long_answer), norm(short)
    63	    if not S or len(S) >= len(L) or not re.search(r"(?<![a-z0-9])" + re.escape(S) + r"(?![a-z0-9])", L):
    64	        return False  # whole-token span only: "available" is not a span of "unavailable"
    65	    if (words(L) & NEG) - (words(S) & NEG):
    66	        return False
    67	    return all(n in nums(S) for n in nums(L))
    68	
    69	
    70	if __name__ == "__main__":
    71	    bad = [("1.5", "15"), ("-2", "2"), ("1:30", "130"), ("York", "New York"), ("no alerts", "alerts")]
    72	    good = [("382 Followers", "382"), ("C$43.00", "C$43.00"), ("6:16 AM", "6:16 am"), ("4.2", "4.2."), ("Sun", "sun"),
    73	            ("410,000+ results", "410,000+"), ("₹614", "₹614")]
    74	    for x, y in bad:
    75	        assert not same_answer(x, y), (x, y)
    76	    for x, y in good:
    77	        assert same_answer(x, y), (x, y)
    78	    assert preferred("382 Followers", "382") == "382" and preferred("York", "New York") == "York"
    79	    assert safe_short("The temperature today is 51°.", "51°") and not safe_short("There are no alerts", "alerts")
    80	    assert not safe_short("3 of 5 stars", "3") and safe_short("Wednesday, Feb 1st, 2017", "Feb 1st, 2017")
    81	    for x, y in [("$10", "€10"), ("-5", "5"), ("100", "1000"), ("available", "unavailable")]:
    82	        assert not same_answer(x, y), (x, y)
    83	    assert not safe_short("It is unavailable.", "available") and not safe_short("10:49 PM on Jan 31, 2017", "10:49 PM on Jan 31 2017")
    84	    assert not safe_short("1.50", "150")
    85	    print("answer-check tests pass")
     1	"""Strict reward for static-screenshot GRPO on the v4 agent format (one sampled reply -> one score in [0, 1]).
     2	
     3	Only the final action (content after </think>) is scored, with the project's strict parser; malformed output, extra
     4	objects, unfinished reasoning or a wrong action type score 0. No bonus for format, length, or picking `answer`.
     5	  answer        -> 1 iff action is `answer` and the text matches the reference (data/v4_answer_check.same_answer:
     6	                   numbers/signs/decimals/times exact, no partial entities, negation-aware)
     7	  status        -> 1 iff action is `status` with the same goal_status
     8	  open_app      -> 1 iff same app name (case/space-insensitive)
     9	  input_text    -> 1 iff same text after whitespace/case normalisation
    10	  scroll        -> 1 iff same direction
    11	  back/home/enter/wait -> 1 iff same type
    12	  click/long_press -> exp(-(d / 0.05)^2), d = distance between points on the unit square (0-1000 grid / 1000);
    13	                   d = 0.05 -> 0.37, 0.10 -> 0.02 (only same-type actions; no radius is claimed to be an element box)
    14	"""
    15	import json
    16	import math
    17	import os
    18	import re
    19	import sys
    20	
    21	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    22	sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "data"))
    23	import agent_format as af  # noqa: E402
    24	from v4_answer_check import same_answer  # noqa: E402
    25	
    26	SIGMA = 0.05
    27	
    28	
    29	def _txt(s):
    30	    return re.sub(r"\s+", " ", str(s or "").strip().lower())
    31	
    32	
    33	def action_reward(output_text, gt):
    34	    gt = json.loads(gt) if isinstance(gt, str) else gt
    35	    a = af.parse_action(output_text, strict=True)
    36	    if a is None or a["action_type"] != gt["action_type"]:
    37	        return 0.0
    38	    t = gt["action_type"]
    39	    if t == "answer":
    40	        return float(same_answer(a["text"], gt["text"]))
    41	    if t == "status":
    42	        return float(a.get("goal_status") == gt.get("goal_status", "complete"))
    43	    if t == "open_app":
    44	        return float(_txt(a["app_name"]) == _txt(gt["app_name"]))
    45	    if t == "input_text":
    46	        return float(_txt(a["text"]) == _txt(gt["text"]))
    47	    if t == "scroll":
    48	        return float(a["direction"] == gt["direction"])
    49	    if t in ("click", "long_press"):
    50	        (x, y), (gx, gy) = a["point_2d"], gt["point_2d"]
    51	        d = math.hypot((x - gx) / 1000, (y - gy) / 1000)
    52	        return math.exp(-((d / SIGMA) ** 2))
    53	    return 1.0  # navigate_back / navigate_home / keyboard_enter / wait: type already matched
    54	
    55	
    56	def completion_text(completion):
    57	    """TRL conversational completion -> raw text with the reasoning re-attached (so an unclosed <think> stays invalid)."""
    58	    if isinstance(completion, str):
    59	        return completion
    60	    m = completion[0] if isinstance(completion, list) else completion
    61	    content = m.get("content") or ""
    62	    if isinstance(content, list):
    63	        content = "".join(c.get("text", "") for c in content if isinstance(c, dict))
    64	    reasoning = m.get("reasoning_content") or m.get("reasoning") or ""
    65	    if reasoning and "</think>" not in content:
    66	        return f"<think>{reasoning}</think>{content}"
    67	    return content
    68	
    69	
    70	def reward_fn(completions, gt_action, **kwargs):
    71	    return [action_reward(completion_text(c), g) for c, g in zip(completions, gt_action)]
    72	
    73	
    74	if __name__ == "__main__":
    75	    A = lambda t: json.dumps({"action_type": "answer", "text": t})
    76	    S = json.dumps({"action_type": "status", "goal_status": "complete"})
    77	    C = json.dumps({"action_type": "click", "point_2d": [500, 500]})
    78	    out = lambda act, think="x": f"<think>{think}</think>" + json.dumps(act, separators=(",", ":"))
    79	    cases = [
    80	        (out({"action_type": "answer", "text": "1.5"}), A("15"), 0.0),
    81	        (out({"action_type": "answer", "text": "-2"}), A("2"), 0.0),
    82	        (out({"action_type": "answer", "text": "1:30"}), A("130"), 0.0),
    83	        (out({"action_type": "answer", "text": "York"}), A("New York"), 0.0),
    84	        (out({"action_type": "answer", "text": "alerts"}), A("no alerts"), 0.0),
    85	        (out({"action_type": "answer", "text": "New York"}), A("new york"), 1.0),
    86	        (out({"action_type": "answer", "text": "382"}), A("382"), 1.0),
    87	        (out({"action_type": "status", "goal_status": "complete"}), A("382"), 0.0),   # complete on a question
    88	        (out({"action_type": "answer", "text": "done"}), S, 0.0),                     # answer on an action goal
    89	        (out({"action_type": "status", "goal_status": "complete"}), S, 1.0),
    90	        ('<think>x</think>{"action_type":"answer","text":"382"}{"action_type":"answer","text":"382"}', A("382"), 0.0),
    91	        ('<think>I will answer {"action_type":"answer","text":"382"}', A("382"), 0.0),  # answer only inside reasoning
    92	        (out({"action_type": "click", "point_2d": [500, 500]}), C, 1.0),
    93	        (out({"action_type": "click", "point_2d": [550, 500]}), C, math.exp(-1)),
    94	        (out({"action_type": "click", "point_2d": [1200, 500]}), C, 0.0),           # off-screen -> strict parse fails
    95	        (out({"action_type": "long_press", "point_2d": [500, 500]}), C, 0.0),
    96	    ]
    97	    for o, g, want in cases:
    98	        got = action_reward(o, g)
    99	        assert abs(got - want) < 1e-6, (o, g, got, want)
   100	    msg = [{"role": "assistant", "content": '{"action_type":"answer","text":"382"}', "reasoning_content": "It shows 382."}]
   101	    assert reward_fn([msg], [A("382")]) == [1.0]
   102	    assert reward_fn(['<think>x</think>{"action_type":"answer","text":"382"}'], [A("382")]) == [1.0]
   103	    print(f"reward fixtures pass ({len(cases) + 2})")

