     1	"""v4 development gate (docs/PREREG_v4.md), computed from raw AndroidWorld episodes + offline dev metrics.
     2	
     3	Gate (all must hold to freeze v4 and run it on sealed held-out seeds):
     4	  (1) dev_answer: "clearly above 0" := strict typed answer match (v4_answer_check.same_answer) >= 0.20, and `answer`
     5	      emitted on >= 50% of rows;
     6	  (2) dev_complete: `answer` on <= 3% of action-goal final rows;
     7	  (3) AndroidWorld seed 30: >= 3 answer-task successes AND action-task successes >= v3's - 3.
     8	usage: python scripts/v4_gate.py --v4 results/androidworld/lfm3vl2b_v4 --v3 results/androidworld/lfm3vl2b_v3 \
     9	         --dev_answer <metrics.json+jsonl prefix> --dev_complete <...>
    10	"""
    11	import argparse
    12	import glob
    13	import gzip
    14	import json
    15	import math
    16	import os
    17	import pickle
    18	import sys
    19	
    20	sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "train"))
    21	import agent_format as af  # noqa: E402
    22	sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "data"))
    23	from v4_answer_check import same_answer  # noqa: E402
    24	
    25	p = argparse.ArgumentParser()
    26	p.add_argument("--v4", required=True)
    27	p.add_argument("--v3", default="results/androidworld/lfm3vl2b_v3")
    28	p.add_argument("--dev_answer", required=True, help="predictions jsonl of the v4 model on dev_answer")
    29	p.add_argument("--dev_complete", required=True, help="predictions jsonl of the v4 model on dev_complete")
    30	p.add_argument("--n_answer", type=int, required=True, help="rows in the v4 dataset's dev_answer split")
    31	p.add_argument("--n_complete", type=int, required=True, help="rows in the v4 dataset's dev_complete split")
    32	a = p.parse_args()
    33	ANSWER_TASKS = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"])
    34	
    35	
    36	def aw(run_root):
    37	    runs = glob.glob(os.path.join(run_root, "run_*"))
    38	    if len(runs) != 1:
    39	        raise SystemExit(f"GATE INPUT ERROR: {run_root} must contain exactly one run dir, found {len(runs)}")
    40	    out = {}
    41	    for f in glob.glob(os.path.join(runs[0], "*.pkl.gz")):
    42	        ep = pickle.load(gzip.open(f))  # trusted: written by our own local AndroidWorld runs
    43	        ep = ep[0] if isinstance(ep, list) else ep
    44	        r = ep.get("is_successful")
    45	        ok = isinstance(r, (int, float)) and not math.isnan(r) and r >= 1 and not ep.get("exception_info")
    46	        out[os.path.basename(f).rsplit("_", 1)[0]] = ok
    47	    return out
    48	
    49	
    50	def preds(path, expect_n):
    51	    rows = [json.loads(l) for l in open(path)]
    52	    if len(rows) != expect_n or len({(r["episode_id"], r["step_idx"]) for r in rows}) != expect_n:
    53	        raise SystemExit(f"GATE INPUT ERROR: {path} has {len(rows)} rows, expected {expect_n} unique")
    54	    acts = [af.parse_action(r["output"]) for r in rows]
    55	    return rows, acts
    56	
    57	
    58	v4, v3 = aw(a.v4), aw(a.v3)
    59	ALL_TASKS = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"]) | set(v3)
    60	if len(v4) != 116 or len(v3) != 116 or set(v4) != set(v3):
    61	    raise SystemExit(f"GATE INPUT ERROR: need the same 116 tasks in both runs (v4 {len(v4)}, v3 {len(v3)})")
    62	ans4 = sum(v for t, v in v4.items() if t in ANSWER_TASKS)
    63	act4 = sum(v for t, v in v4.items() if t not in ANSWER_TASKS)
    64	act3 = sum(v for t, v in v3.items() if t not in ANSWER_TASKS)
    65	rows, acts = preds(a.dev_answer, a.n_answer)
    66	emitted = sum(1 for x in acts if x and x["action_type"] == "answer") / max(1, len(acts))
    67	correct = sum(1 for r, x in zip(rows, acts) if x and x["action_type"] == "answer"
    68	              and same_answer(x["text"], json.loads(r["gt_action"])["text"])) / max(1, len(rows))
    69	rows_c, acts_c = preds(a.dev_complete, a.n_complete)
    70	false_ans = sum(1 for x in acts_c if x and x["action_type"] == "answer") / max(1, len(acts_c))
    71	complete = sum(1 for x in acts_c if x and x["action_type"] == "status") / max(1, len(acts_c))
    72	g = {"aw_episodes_v4": len(v4), "aw_answer_task_successes_v4": ans4, "aw_action_task_successes_v4": act4,
    73	     "aw_action_task_successes_v3": act3, "dev_answer_emitted": round(emitted, 3), "dev_answer_exact": round(correct, 3),
    74	     "dev_complete_false_answer": round(false_ans, 3), "dev_complete_status": round(complete, 3)}
    75	g["gate"] = {"1_answers": emitted >= 0.5 and correct >= 0.20, "2_no_false_answers": false_ans <= 0.03,
    76	             "3_aw": len(v4) == 116 and ans4 >= 3 and act4 >= act3 - 3}
    77	g["PASS"] = all(g["gate"].values())
    78	print(json.dumps(g, indent=1))
    79	sys.exit(0 if g["PASS"] else 3)
     1	#!/bin/bash
     2	# Run one SEALED AndroidWorld arm on a held-out seed (docs/PREREG_v4.md): results go to results/androidworld_sealed/,
     3	# the runner's full output is written only inside the sealed dir; progress = episode-file counts; nobody reads results
     4	# before every arm on the seed has finished. Exit status and the 116-episode inventory decide "finished" vs "FAILED".
     5	# Usage: bash scripts/local_sealed_aw_v2.sh <arm> <seed> <console_port> <grpc_port> <server_port> [resume_run_dir]
     6	#   arm = v1 | v3 | v4 | guiowl
     7	set -u
     8	cd /Users/alpha/lfm3-android
