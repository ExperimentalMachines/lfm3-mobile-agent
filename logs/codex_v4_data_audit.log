+                     teacher_answer=j['answer'],verify_answer=j.get('verify_answer'),format=j['format'],
+                     effective_kind='question' if c['kind']=='question' and direct.get(r['base_key'],{}).get('ok') else 'compound')
+        if r['answer'] is not None:
