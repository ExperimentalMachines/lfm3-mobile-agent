index 0000000000000000000000000000000000000000..3582e5f91f2479f4d07b52b8b83827733c73b38b
--- /dev/null
+++ b/results/codex/restructure_docs_reaudit/probes.py
@@ -0,0 +1,87 @@
+"""Side-effect-free launcher and seed-30 validator probes; never run operational scripts."""
+import ast
+import collections
+import copy
+import gzip
+import io
+import json
+import os
+from pathlib import Path
+import pickle
+import re
+import subprocess
+from unittest.mock import patch
+
+ROOT = Path.cwd()
+OUT = Path(__file__).resolve().parent
+source = Path('analysis/aw_dev_seed30.py').read_text()
+tree = ast.parse(source)
+ns = {}
+exec(compile(ast.Module(body=[n for n in tree.body if getattr(n,'lineno',1000)<80],type_ignores=[]),'analysis/aw_dev_seed30.py','exec'),ns)
+templates = sorted(ns['TEMPLATES'])
+eps = [{'task_template':t, 'agent_name':'lfm3vl2b_v4_q4km', 'instance_id':0, 'seed':ns['instance_seed'](t),
+        'exception_info':None,'is_successful':0,'episode_length':0,'episode_data':{}} for t in templates]
+
+def probe(label, change, multiple=False):
+    records=copy.deepcopy(eps)
+    change(records)
+    payloads={f'episode_{i}':gzip.compress(pickle.dumps([r, r] if multiple else [r])) for i,r in enumerate(records)}
+    def fake_glob(pattern):
+        return ['synthetic_run/'] if pattern.endswith('/run_*/') else list(payloads)
+    with patch.object(ns['glob'],'glob',fake_glob), patch('builtins.open',lambda p,*a,**k:io.BytesIO(payloads[p])):
+        try:
+            result=ns['run']('lfm3vl2b_v4')
+            return {'case':label,'accepted':True,'successes':result['successes'],'agent':result['agent']}
+        except (AssertionError,ValueError,TypeError) as e:
+            return {'case':label,'accepted':False,'error':str(e)}
+checks=[probe('valid_identity',lambda r:None),
+        probe('all_records_wrong_agent',lambda r:[x.update(agent_name='wrong_agent') for x in r]),
+        probe('all_records_missing_agent',lambda r:[x.pop('agent_name') for x in r]),
+        probe('one_wrong_agent',lambda r:r[0].update(agent_name='wrong_agent')),
+        probe('duplicate_template',lambda r:r[0].update(task_template=r[1]['task_template'])),
+        probe('wrong_seed',lambda r:r[0].update(seed=123)),
+        probe('success_and_exception',lambda r:r[0].update(is_successful=1,exception_info='synthetic error')),
+        probe('missing_instance_id',lambda r:r[0].pop('instance_id')),
+        probe('missing_seed_without_exception',lambda r:r[0].pop('seed')),
+        probe('after_step_exception_without_seed',lambda r:(r[0].pop('seed'),r[0].update(exception_info='synthetic after-step error',episode_length=3))),
+        probe('two_episodes_per_file',lambda r:None,multiple=True)]
+
+launchers=json.loads((OUT/'launchers.json').read_text())
+root_checks=[]
+for entry in launchers:
+    p=entry['path'];text=Path(p).read_text()
+    line=entry['root_lines'][0]
+    if p.endswith('/android_cli.sh'):
+        snippet='cd "$(dirname "$0")/../.." && pwd'
+    else:
+        snippet=line+'\npwd'
+    for cwd,arg,label in [(ROOT,p,'root-relative'),(OUT,str(ROOT/p),'absolute-from-other-cwd'),(OUT,os.path.relpath(ROOT/p,OUT),'relative-from-other-cwd')]:
+        result=subprocess.run(['bash','-c',snippet,arg],cwd=cwd,text=True,capture_output=True)
+        root_checks.append({'path':p,'case':label,'rc':result.returncode,'resolved_root':result.stdout.strip(),'pass':result.returncode==0 and result.stdout.strip()==str(ROOT)})
+
+lane=Path('scripts/androidworld/local_v4_to_aw_v2.sh').read_text()
+lane_pattern=re.search(r'pgrep -f "(\^bash [^"]+)"',lane)[1].replace('$CP','5558')
+filler=Path('scripts/androidworld/local_emu2_fill_v2.sh').read_text()
+filler_pattern=re.search(r'pgrep -f "(\^bash [^"]+)"',filler)[1].replace('$ARM','guiowl').replace('$SEED','1234')
+cmds=['bash scripts/androidworld/local_sealed_aw_v2.sh guiowl 1234 5558 8558 8115',
+      'bash scripts/androidworld/local_sealed_aw_v3.sh guiowl 1234 5558 8558 8115',
+      'bash scripts/androidworld/local_sealed_aw_v3.sh guiowl 1234 5556 8556 8115',
+      f'bash {ROOT}/scripts/androidworld/local_sealed_aw_v3.sh guiowl 1234 5558 8558 8115',
+      'bash ./scripts/androidworld/local_sealed_aw_v3.sh guiowl 1234 5558 8558 8115']
+process_checks=[{'command':c,'lane_matches':bool(re.search(lane_pattern,c)),'restored_filler_matches':bool(re.search(filler_pattern,c))} for c in cmds]
+after_step_missing=[];agents={}; missing_instance=[]
+for d,_,_ in ns['RUNS']:
+    dirs=sorted(Path('results/androidworld',d).glob('run_*'))
+    run=next(p for p in reversed(dirs) if p.is_dir())
+    ee=[pickle.loads(gzip.decompress(p.read_bytes()))[0] for p in run.glob('*.pkl.gz')]
+    agents[d]=sorted({e.get('agent_name') for e in ee})
+    for e in ee:
+        if e.get('instance_id')!=0:missing_instance.append([d,e['task_template']])
+        if e.get('exception_info') is not None and 'seed' not in e:
+            frames=re.findall(r'File "[^"]+", line \d+, in (\w+)',str(e['exception_info']).split('Traceback (most recent call last):')[-1])
+            if frames[:2]!=['_run_task','initialize_task']:after_step_missing.append([d,e['task_template']])
+out={'seed30_cases':checks,'root_checks':root_checks,'process_patterns':process_checks,'actual_agents':agents,
+     'actual_nonzero_or_missing_instance':missing_instance,'actual_missing_seed_nonsetup_exception':after_step_missing}
+(OUT/'probes.json').write_text(json.dumps(out,indent=2)+'\n')
+print(json.dumps({k:v for k,v in out.items() if k not in ('root_checks','actual_agents')},indent=2))
+print('Root checks passed:',sum(x['pass'] for x in root_checks),'/',len(root_checks))
diff --git a/results/codex/restructure_docs_reaudit/read_safe.py b/results/codex/restructure_docs_reaudit/read_safe.py
new file mode 100644
index 0000000000000000000000000000000000000000..c4bf0757c9359f6ed00b294100cae1c7f2bd88d0
--- /dev/null
+++ b/results/codex/restructure_docs_reaudit/read_safe.py
@@ -0,0 +1,25 @@
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+def mask(text):
+    text = re.sub(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}", "[EMAIL REDACTED]", text)
+    text = re.sub(r"\b(?:hf_[A-Za-z0-9]{12,}|gh[pousr]_[A-Za-z0-9]{12,}|github_pat_[A-Za-z0-9_]{12,}|AKIA[A-Z0-9]{16}|sk-[A-Za-z0-9_-]{16,})\b", "[TOKEN REDACTED]", text)
+    text = re.sub(r"\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+", "[JWT REDACTED]", text)
+    return text
+
+
+if __name__ == '__main__':
+    for arg in sys.argv[1:]:
+        name, _, span = arg.partition('::')
+        if name.startswith('git:'):
+            raw = subprocess.check_output(['git', 'show', name[4:]]).decode(errors='replace')
+        else:
+            raw = Path(name).read_text(errors='replace')
+        lines = mask(raw).splitlines()
+        low, high = (map(int, span.split('-')) if span else (1, len(lines)))
+        print(f'FILE {name} ({len(lines)} lines)')
+        for n in range(low, min(high, len(lines)) + 1):
+            print(f'{n}: {lines[n - 1]}')
diff --git a/results/codex/restructure_docs_reaudit/run_reproduce.py b/results/codex/restructure_docs_reaudit/run_reproduce.py
new file mode 100644
index 0000000000000000000000000000000000000000..293e495b862f390fee4512a1eaf99a5b7e08dd5b
--- /dev/null
+++ b/results/codex/restructure_docs_reaudit/run_reproduce.py
@@ -0,0 +1,39 @@
+"""Run the exact reproduction script in a tracked-files-only snapshot; all writes stay in this audit directory."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import time
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = ROOT / 'results/codex/restructure_docs_reaudit'
+SNAP = OUT / 'tracked_snapshot'
+SNAP.mkdir(exist_ok=True)
+paths = subprocess.check_output(['git', 'ls-files', '-z'], cwd=ROOT).decode().split('\0')[:-1]
+for name in paths:
+    source, dest = ROOT / name, SNAP / name
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    if source.is_symlink():
+        if not dest.is_symlink():
+            dest.symlink_to(os.readlink(source))
+    else:
+        shutil.copy2(source, dest)
+tmp = OUT / 'tmp'
+tmp.mkdir(exist_ok=True)
+index = OUT / 'reproduce_index'
+shutil.copy2(ROOT / '.git/index', index)
+env = dict(os.environ, GIT_DIR=str(ROOT / '.git'), GIT_WORK_TREE=str(SNAP), GIT_INDEX_FILE=str(index),
+           GIT_OPTIONAL_LOCKS='0', PYTHONDONTWRITEBYTECODE='1', TMPDIR=str(tmp))
+print(f'Snapshot ready: {len(paths)} tracked paths; no android_world checkout or MobileWorld trajectories', flush=True)
+initial = subprocess.check_output(['git', 'status', '--short', '--untracked-files=all'], cwd=SNAP, env=env).decode()
+t0 = time.monotonic()
+with (OUT / 'reproduce.log').open('w') as log:
+    proc = subprocess.run(['bash', 'analysis/reproduce.sh'], cwd=SNAP, env=env, stdout=log, stderr=subprocess.STDOUT)
+final = subprocess.check_output(['git', 'status', '--short', '--untracked-files=all'], cwd=SNAP, env=env).decode()
+result = {'command': 'bash analysis/reproduce.sh', 'cwd': str(SNAP), 'head': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT).decode().strip(),
+          'initial_status': initial, 'final_status': final, 'returncode': proc.returncode, 'elapsed_s': time.monotonic()-t0,
+          'android_world_present': (SNAP/'android_world').exists(), 'mobileworld_raw_present': (SNAP/'results/mobileworld/traj_r2').exists()}
+(OUT / 'reproduce_state.json').write_text(json.dumps(result, indent=2)+'\n')
+print(json.dumps(result, indent=2), flush=True)
diff --git a/results/codex/restructure_docs_reaudit/scan_added.py b/results/codex/restructure_docs_reaudit/scan_added.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1945741e9647d56953a9fb181f33b521407d623
--- /dev/null
+++ b/results/codex/restructure_docs_reaudit/scan_added.py
@@ -0,0 +1,65 @@
+"""Read postimage blobs added/modified since ecdebc5, including decoded gzip. Never persist raw matches."""
+import collections
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+OUT = Path(__file__).resolve().parent
+def git(*args):
+    return subprocess.check_output(['git', *args])
+owners = {x for x in git('log', '--all', '--format=%ae%n%ce').splitlines()
+          if x.lower().startswith(b'alpha') and b'@' in x}
+paths = git('diff', '--name-only', '--diff-filter=ACMRT', '-z', 'ecdebc5', 'HEAD').decode().split('\0')[:-1]
+patterns = {
+    'HF_token': rb'\bhf_[A-Za-z0-9]{20,}\b',
+    'GitHub_token': rb'\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\b',
+    'API_token': rb'\bsk-(?:ant-)?[A-Za-z0-9_-]{20,}\b',
+    'AWS_access_key': rb'\b(?:AKIA|ASIA)[A-Z0-9]{16}\b',
+    'Google_key': rb'\bAIza[A-Za-z0-9_-]{30,}\b',
+    'JWT': rb'\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}',
+    'private_key': rb'-----BEGIN (?:RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----',
+    'credential_URL': rb'[a-zA-Z][a-zA-Z0-9+.-]*://[^\s:/]+:[^\s/@]{4,}@',
+    'credential_assignment': rb'''(?i)(?:["']?)(?:[a-z0-9_]*(?:api[_-]?key|access[_-]?key|secret|password|passwd|token)[a-z0-9_]*)(?:["']?)\s*[:=]\s*["']([^"'\r\n]{8,})["']''',
+    'bearer': rb'(?i)\bBearer\s+([A-Za-z0-9_.-]{16,})',
+    'unquoted_credential_assignment': rb'\b(?:HF_TOKEN|HUGGING_FACE_HUB_TOKEN|OPENAI_API_KEY|ANTHROPIC_API_KEY|AWS_SECRET_ACCESS_KEY|AWS_SESSION_TOKEN|GOOGLE_API_KEY|GITHUB_TOKEN|GH_TOKEN|MODAL_TOKEN_SECRET)\s*=\s*([^\s\x22\x27;,]{8,})',
+    'credential_query': rb'(?i)[?&](?:key|token|api_key|access_token|secret|password)=([^&\s\x22\x27<>]{8,})',
+}
+hits = []
+inventory = []
+for path in paths:
+    oid = git('rev-parse', f'HEAD:{path}').decode().strip()
+    typ = git('cat-file', '-t', oid).decode().strip()
+    if typ != 'blob':
+        continue
+    raw = git('cat-file', 'blob', oid)
+    compressed = raw.startswith(b'\x1f\x8b')
+    payload = gzip.decompress(raw) if compressed else raw
+    inventory.append({'path': path, 'blob': oid, 'bytes': len(raw), 'decoded_bytes': len(payload), 'gzip': compressed})
+    # Inspect escaped quoted assignments in captured JSON/tool text, while retaining physical line numbers.
+    payload = payload.replace(b'\\"', b'"').replace(b"\\'", b"'")
+    checks = dict(patterns)
+    for n, owner in enumerate(sorted(owners)):
+        checks[f'owner_email_{n+1}'] = re.escape(owner)
+    for label, pattern in checks.items():
+        for match in re.finditer(pattern, payload):
+            value = match.group(1) if match.lastindex else match.group(0)
+            # Prefixes are bounded to six characters, even for candidates later classified as false positives.
+            classification = ('redaction_placeholder' if value.startswith(b'<redacted') else
+                              'synthetic_test_value' if value.startswith(b'synthetic') else
+                              'numeric_metric' if re.fullmatch(rb'[0-9.+eE-]+', value) else 'review_required')
+            hits.append({'path': path, 'blob': oid, 'line': payload.count(b'\n', 0, match.start())+1,
+                         'pattern': label, 'masked_prefix': value[:6].decode(errors='replace')+'...',
+                         'value_sha256': hashlib.sha256(value).hexdigest(), 'match_bytes': len(value), 'gzip': compressed,
+                         'classification': classification})
+summary = {'base': git('rev-parse', 'ecdebc5').decode().strip(), 'head': git('rev-parse', 'HEAD').decode().strip(),
+           'postimage_paths': len(paths), 'blobs': len(inventory), 'unique_blobs': len({x['blob'] for x in inventory}),
+           'gzip_blobs': sum(x['gzip'] for x in inventory), 'scanned_bytes': sum(x['decoded_bytes'] for x in inventory),
+           'owner_email_patterns': len(owners),
+           'candidate_counts': dict(collections.Counter(x['pattern'] for x in hits)),
+           'classifications': dict(collections.Counter(x['classification'] for x in hits)),
+           'owner_hits_by_path': dict(collections.Counter(x['path'] for x in hits if x['pattern'].startswith('owner_email')))}
+(OUT/'added_blob_scan.json').write_text(json.dumps({'summary': summary, 'inventory': inventory, 'candidates': hits}, indent=2)+'\n')
+print(json.dumps(summary, indent=2))
diff --git a/results/codex/restructure_docs_reaudit/static_checks.py b/results/codex/restructure_docs_reaudit/static_checks.py
