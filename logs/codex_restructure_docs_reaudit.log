92: L += ["", "Full successes only (is_successful >= 1, no exception); exceptions count as failures. Latency = model time per step on an "
93:       "Apple M5 (llama.cpp Metal), measured inside the run. Generated by analysis/aw_dev_seed30.py."]
94: open("results/androidworld/dev_seed30_summary.md", "w").write("\n".join(L) + "\n")
