1: #!/bin/bash
2: # Regenerate every summary file in results/ from the committed inputs (episode files, request logs, predictions and
3: # per-run metric files), then check each output against the committed version (expected: no change, nothing new).
4: # Not covered: re-scoring raw AndroidControl / general-knowledge predictions into their metric files (eval/ scorers),
5: # training logs, dataset statistics, and the hand-written docs. MobileWorld is skipped unless its raw trajectories
6: # (not in git) are present. Needs Python 3.10+ with numpy.
7: # Usage: bash analysis/reproduce.sh            (PY=/path/to/python to choose the interpreter)
8: set -euo pipefail
9: cd "$(dirname "$0")/.."
10: PY=${PY:-python3}
11: E=results/v4_dev/hub/eval
12: D=results/devstream/run_20261118_1519
13: run() { echo "· $*"; "$@" > /dev/null; }
14: 
15: echo "AndroidWorld, held-out (primary) + sensitivity"
16: run "$PY" analysis/sealed_analysis.py --seeds 7,1234,2026 --out results/sealed_analysis_final
17: run "$PY" analysis/sealed_sensitivity.py
18: echo "AndroidWorld, development seed 30 + v4 gate"
19: run "$PY" analysis/aw_dev_seed30.py
20: echo "· analysis/v4_gate.py > results/v4_gate_seed30.txt"
21: "$PY" analysis/v4_gate.py --v4 results/androidworld/lfm3vl2b_v4 --v4_agent lfm3vl2b_v4_q4km \
22:   --dev_answer $E/lfm3_v4_dev_answer.jsonl --dev_complete $E/lfm3_v4_dev_complete.jsonl > results/v4_gate_seed30.txt
23: echo "Offline evaluations"
24: run "$PY" analysis/strict_dev_metrics.py --answer $E/lfm3_v4_dev_answer.jsonl --complete $E/lfm3_v4_dev_complete.jsonl \
25:   --out results/v4_dev/lfm3_v4_strict.json
26: run "$PY" analysis/v4rl_promotion.py --v4_dir $E --rl_dir results/v4rl_dev --out results/v4rl_promotion_offline.json
27: run "$PY" eval/general/paired_retention.py results/general/lfm3vl2b-ac-lora_base_general_logprob.jsonl \
28:   $E/lfm3vl2b-v4bmix-lora_ft_general_logprob.jsonl results/general/lfm3vl2b_v4_retention_logprob.json
29: run "$PY" analysis/build_report.py
30: echo "· analysis/v2_compare.py > results/V2_COMPARISON.md"
31: "$PY" analysis/v2_compare.py > results/V2_COMPARISON.md
32: echo "Speed"
33: echo "· analysis/bench_speed_report.py > results/speed/speed_t8.json (+ .md)"
34: "$PY" analysis/bench_speed_report.py results/speed/results_t8 --md results/speed/speed_t8.md > results/speed/speed_t8.json
35: run "$PY" analysis/qdc_report_v6.py
36: run "$PY" analysis/devstream_report.py $D --md $D/speed_phone_partial.md --json $D/speed_phone_partial.json
37: echo "MobileWorld"
38: if [ -d results/mobileworld/traj_r2 ]; then
39:   run "$PY" analysis/mw_summarize_r2.py
40: else
41:   echo "· skipped: raw trajectories (results/mobileworld/traj_r2, 8.6 GB) are not in git"
42: fi
43: find analysis -name __pycache__ -type d -prune -exec rm -rf {} +
44: echo
45: changes=$(git status --porcelain --untracked-files=all -- results)
46: if [ -z "$changes" ] && git diff --quiet HEAD -- results; then
47:   echo "OK: every regenerated file is identical to the committed one (HEAD), and no new file appeared."
48: else
49:   echo "Differs from HEAD:"; echo "$changes"; exit 1
50: fi
FILE analysis/aw_dev_seed30.py (95 lines)
1: """AndroidWorld development seed 30: score and in-run speed of every model, from the saved episode files.
2: 
3: Seed 30 was used to choose between versions (docs/PREREG_v4.md), so these are development numbers, not the held-out
4: result (results/sealed_analysis_final.md). Per run: full successes (is_successful >= 1; exceptions count as failures),
5: answer-task vs action-task successes (answer tasks: results/codex/v3_audit/answer_tasks.json), exceptions, median steps,
6: and per-step model latency on the Apple M5 (llama.cpp Metal, measured inside the run while emulators and other servers
7: were running) with median prompt/output tokens. Latest run directory of each model, as in the gate.
8: (Moved here from the removed run-log generator, scripts/build_runs_registry.py, 2026-11-20; same computation.)
9: Usage: .venv-aw/bin/python analysis/aw_dev_seed30.py  ->  results/androidworld/dev_seed30_summary.{json,md}
10: """
11: import glob
12: import gzip
13: import hashlib
14: import json
15: import pickle  # episode files are written by this repo's own AndroidWorld harness (trusted, not downloaded)
16: import statistics as st
17: 
18: ANS = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"])
19: TEMPLATES = {m["task_name"] for m in json.load(open("data/meta/androidworld_task_metadata.json"))}
20: SUITE_SEED = 30
21: 
22: 
23: def instance_seed(t, i=0):  # android_world suite_utils._get_instance_seed
24:     return int(hashlib.sha256(f"{SUITE_SEED}_{t}_{i}".encode()).hexdigest(), 16) % (2 ** 32)
25: RUNS = [  # (results/androidworld/<dir>, label, quantisation)
26:     ("lfm3vl2b_v4", "LFM3-VL-2B v4 (final)", "Q4_K_M"),
27:     ("maiui_2b_matched_q8_0", "MAI-UI-2B (1 screenshot)", "Q8_0"),
28:     ("guiowl15_2b_matched", "GUI-Owl-1.5-2B (1 screenshot)", "Q4_K_M"),
29:     ("qwen35_2b_ft", "Qwen3.5-2B v1", "Q4_K_M"),
30:     ("lfm3vl2b_ft", "LFM3-VL-2B v1", "Q4_K_M"),
31:     ("lfm3vl2b_v3", "LFM3-VL-2B v3", "Q4_K_M"),
32:     ("qwen35_08b_ft", "Qwen3.5-0.8B v1", "Q4_K_M"),
33:     ("lfm3vl2b_ft_runtimefb", "LFM3-VL-2B v1 + runtime feedback (ablation)", "Q4_K_M"),
34:     ("lfm3vl2b_v2_forcethink", "LFM3-VL-2B v2 + forced intent (ablation)", "Q4_K_M"),
35:     ("lfm3vl2b_v2", "LFM3-VL-2B v2", "Q4_K_M"),
36:     ("lfm25vl450m_ft", "LFM2.5-VL-450M v1", "Q4_K_M"),
37:     ("lfm3vl2b_base_nothink", "LFM3-VL-2B base (no thinking)", "Q4_K_M"),
38:     ("lfm25vl450m_base", "LFM2.5-VL-450M base", "Q4_K_M"),
39: ]
40: 
41: 
42: def run(d):
43:     r = sorted(glob.glob(f"results/androidworld/{d}/run_*/"))[-1]
44:     eps = [pickle.loads(gzip.decompress(open(f, "rb").read()))[0] for f in sorted(glob.glob(r + "*.pkl.gz"))]
45:     # input checks: the 116 AndroidWorld templates once each, one agent, instance 0 of suite seed 30
46:     names = [e["task_template"] for e in eps]
47:     assert len(names) == len(set(names)) and set(names) == TEMPLATES, f"{d}: templates differ from task metadata"
48:     assert len({e.get("agent_name") for e in eps}) == 1, f"{d}: more than one agent"
49:     for e in eps:
50:         assert e.get("instance_id", 0) == 0, f"{d}: {e['task_template']} is not instance 0"
51:         if e.get("exception_info") is None or "seed" in e:
52:             assert e.get("seed") == instance_seed(e["task_template"]), f"{d}: {e['task_template']} not seed {SUITE_SEED}"
53:     # success = checker score >= 1 and no exception (exceptions count as failures)
54:     ok = lambda e: e.get("exception_info") is None and (lambda v: v is not None and v == v and v >= 1)(e.get("is_successful"))
55:     lat, steps, P, G = [], [], [], []
56:     for e in eps:
57:         dd = e.get("episode_data")
58:         if isinstance(dd, dict):
59:             lat += [x for x in (dd.get("latency_s") or []) if isinstance(x, (int, float)) and x == x]
60:             for u in dd.get("usage") or []:
61:                 if isinstance(u, dict) and u.get("prompt_tokens"):
62:                     P.append(u["prompt_tokens"]); G.append(u.get("completion_tokens", 0))
63:         L = e.get("episode_length")
64:         if isinstance(L, (int, float)) and L == L:
65:             steps.append(L)
66:     q = sorted(lat)
67:     return {"run_dir": r, "agent": eps[0].get("agent_name"), "seed": eps[0].get("seed"), "episodes": len(eps),
68:             "successes": sum(map(ok, eps)),
69:             "answer_task_successes": sum(1 for e in eps if ok(e) and e["task_template"] in ANS),
70:             "action_task_successes": sum(1 for e in eps if ok(e) and e["task_template"] not in ANS),
71:             "exceptions": sum(1 for e in eps if e.get("exception_info") is not None),
72:             "median_steps": int(st.median(steps)) if steps else None,
73:             "steps_timed": len(lat), "step_latency_median_s": round(st.median(lat), 2) if lat else None,
74:             "step_latency_p10_s": round(q[len(q) // 10], 2) if q else None,
75:             "step_latency_p90_s": round(q[9 * len(q) // 10], 2) if q else None,
76:             "prompt_tokens_median": int(st.median(P)) if P else None,
77:             "output_tokens_median": int(st.median(G)) if G else None}
78: 
79: 
80: rows = [{"id": d, "label": lab, "quant": qt, **run(d)} for d, lab, qt in RUNS]
81: assert all(r["episodes"] == 116 for r in rows), [(r["id"], r["episodes"]) for r in rows if r["episodes"] != 116]
82: json.dump(rows, open("results/androidworld/dev_seed30_summary.json", "w"), indent=1)
