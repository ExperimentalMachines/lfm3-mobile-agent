FILE scripts/androidworld/local_emu2_fill_v2.sh (33 lines)
1: #!/bin/bash
2: # Emulator 2 fill, part 2 (replaces scripts/local_emu2_fill.sh (archived) after it started the sealed GUI-Owl seed-1234 arm).
3: # Bug fixed: v1 picked the resume dir with `ls -d <arm>/run_* | tail -1`, which matches the runner's
4: # run_output.SEALED.log file (sorts after run_2026...), so the resume would have pointed at a log file. Here only
5: # directories (run_*/) are considered.
6: #   1. wait for the v4 lane (logs/local_v4_to_aw.log) to log "exported; pausing" (or EXPORT FAILED -> leave the arm)
7: #   2. pause the arm (allowlisted pause script), remember its run dir
8: #   3. after "v4 AndroidWorld seed-30 finished" and no run_aw.py on emulator 2, resume the arm from that dir
9: # Usage: nohup bash scripts/androidworld/local_emu2_fill_v2.sh >> logs/local_emu2_fill.log 2>&1 &
10: set -u
11: cd "$(dirname "$0")/../.." || exit 1
12: CP=5558; GP=8558; PORT=8115; ARM=guiowl; SEED=1234; LANE=logs/local_v4_to_aw.log
13: ALOG=logs/local_sealed_${ARM}_seed${SEED}.log; OUT=results/androidworld_sealed/${ARM}_seed${SEED}
14: log() { echo "[$(date +%T)] $*"; }
15: rundir() { local d; d=$(ls -d "$OUT"/run_*/ 2>/dev/null | tail -1); echo "${d%/}"; }
16: count() { local d; d=$(rundir); [ -n "$d" ] && ls "$d"/*.pkl.gz 2>/dev/null | wc -l | tr -d ' ' || echo 0; }
17: log "emu2 fill v2 (pid $$): watching ${ARM}_seed${SEED} ($(count) episodes) and the v4 lane"
18: until grep -q "exported; pausing\|EXPORT FAILED" "$LANE"; do
19:   pgrep -f "^bash scripts/(androidworld/)?local_sealed_aw_v2.sh $ARM $SEED " > /dev/null || { log "arm ended before the v4 hand-off: $(tail -1 "$ALOG")"; exit 0; }
20:   sleep 20
21: done
22: grep -q "EXPORT FAILED" "$LANE" && { log "v4 export failed; leaving the arm running"; exit 1; }
23: log "v4 lane ready: pausing ${ARM}_seed${SEED}"
24: bash scripts/androidworld/pause_sealed_arm.sh $ARM $SEED $PORT --dry-run
25: bash scripts/androidworld/pause_sealed_arm.sh $ARM $SEED $PORT
26: RESUME=$(rundir)
27: [ -d "$RESUME" ] || { log "no run dir to resume in $OUT; not resuming"; exit 1; }
28: log "paused at $(count) episodes (run dir $RESUME); waiting for the v4 seed-30 pass"
29: until grep -q "v4 AndroidWorld seed-30 finished" "$LANE"; do sleep 60; done
30: until ! pgrep -f "[r]un_aw.py.*console_port=$CP" > /dev/null; do sleep 10; done
31: log "resuming ${ARM}_seed${SEED} from $RESUME"
32: bash scripts/androidworld/local_sealed_aw_v2.sh $ARM $SEED $CP $GP $PORT "$RESUME" >> "$ALOG" 2>&1 < /dev/null
33: log "arm ended: $(tail -1 "$ALOG")"
FILE scripts/androidworld/local_sealed_aw_v2.sh (44 lines)
1: #!/bin/bash
2: # Run one SEALED AndroidWorld arm on a held-out seed (docs/PREREG_v4.md): results go to results/androidworld_sealed/,
3: # the runner's full output is written only inside the sealed dir; progress = episode-file counts; nobody reads results
4: # before every arm on the seed has finished. Exit status and the 116-episode inventory decide "finished" vs "FAILED".
5: # Usage: bash scripts/androidworld/local_sealed_aw_v2.sh <arm> <seed> <console_port> <grpc_port> <server_port> [resume_run_dir]
6: #   arm = v1 | v3 | v4 | guiowl
7: set -u
8: cd "$(dirname "$0")/../.." || exit 1
9: ARM=$1; SEED=$2; CP=$3; GP=$4; PORT=$5; RESUME=${6:-}
10: NAME=${ARM}_seed${SEED}
11: OUT=results/androidworld_sealed/$NAME
12: LOG=$OUT/run_output.SEALED.log   # full runner output stays inside the sealed dir (AW prints per-episode result tables)
13: mkdir -p "$OUT"
14: # outcome lines (suite_utils prints "Task Successful/Failed") and android_env fork noise are not written to the log
15: FILTER="Task Successful\|Task Failed\|_os_env_vars\|FD from fork\|fork_posix"
16: case "$ARM" in
17:   v1) SRV=(-m models/LFM3-VL-2B-AndroidControl-GGUF/LFM3-VL-2B-AndroidControl-Q4_K_M.gguf
18:            --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
19:       RUN=(--agent=lfm --enable_thinking=true --agent_label=lfm3vl2b_v1_q4km) ;;
20:   v3) SRV=(-m models/lfm3vl2b_v3-GGUF/LFM3-VL-2B-AndroidAgent-v3-Q4_K_M.gguf
21:            --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
22:       RUN=(--agent=lfm --enable_thinking=true --agent_label=lfm3vl2b_v3_q4km) ;;
23:   v4) SRV=(-m models/lfm3vl2b_v4-GGUF/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf
24:            --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
25:       RUN=(--agent=lfm --enable_thinking=true --prompt_version=v4 --agent_label=lfm3vl2b_v4_q4km) ;;
26:   guiowl) SRV=(-m models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf
27:                --mmproj models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf -c 20480 --image-max-tokens 2600 --jinja)
28:       RUN=(--agent=guiowl --guiowl_images=1 --guiowl_max_pixels=1048576 --installed_apps=true
29:            --agent_label=guiowl15_2b_matched1img_apps_q4km) ;;
30:   *) echo "unknown arm $ARM"; exit 2 ;;
31: esac
32: for f in "${SRV[1]}" "${SRV[3]}"; do [ -s "$f" ] || { echo "missing $f"; exit 1; }; done
33: curl -s 127.0.0.1:$PORT/health | grep -q ok && { echo "port $PORT already serving; refusing"; exit 1; }
34: nohup llama-server "${SRV[@]}" -np 1 -ngl 99 --port $PORT --host 127.0.0.1 > logs/llama_server_$NAME.log 2>&1 < /dev/null &
35: until curl -s 127.0.0.1:$PORT/health | grep -q ok; do sleep 3; done
36: echo "[$(date +%T)] server :$PORT up; starting SEALED $NAME (seed $SEED) on emulator $CP"
37: .venv-aw/bin/python eval/androidworld/run_aw.py --console_port=$CP --grpc_port=$GP --server_url=http://127.0.0.1:$PORT \
38:   --task_random_seed=$SEED --n_task_combinations=1 --output_path=$OUT ${RESUME:+--checkpoint_dir=$RESUME} "${RUN[@]}" \
39:   >> "$LOG" 2>&1
40: RC=$?
41: pkill -f "[l]lama-server.*--port $PORT "
42: N=$(ls -d $OUT/run_*/ 2>/dev/null | tail -1 | xargs -I{} sh -c 'ls {}*.pkl.gz 2>/dev/null | wc -l' | tr -d ' ')
43: if [ "$RC" = 0 ] && [ "${N:-0}" = 116 ]; then echo "[$(date +%T)] SEALED $NAME AndroidWorld finished"
44: else echo "[$(date +%T)] SEALED $NAME AndroidWorld FAILED (exit $RC, ${N:-0}/116 episodes)"; exit 1; fi
