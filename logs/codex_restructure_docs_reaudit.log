1: #!/bin/bash
2: # v4 hand-off v2 (2026-11-18). The merged-v4 upload to the hub failed ("Private storage limit reached"), so the
3: # merged weights were copied off the Colab VM. This replaces the hub wait of scripts/local_v4_to_aw.sh (archived: tag archive/pre-restructure-2026-11-20) with:
4: #   1. the source dir must match results/v4_local_export_manifest.json exactly (file set + sha256; written after
5: #      check_local_merge.py passed and the 14 non-weight files were found byte-identical to the v3 merged release),
6: #      and check_local_merge.py is re-run against the pinned base and pinned adapter revision;
7: #   2. phone GGUF export from that dir (same converter/quant/mmproj as v1-v3);
8: #   3. same hand-off markers in logs/local_v4_to_aw.log for scripts/androidworld/local_emu2_fill_v2.sh ("exported; pausing" -> it
9: #      pauses the sealed GUI-Owl seed-1234 arm; "v4 AndroidWorld seed-30 finished" -> it resumes that arm). After
10: #      "exported; pausing" every exit path prints the finished marker, so the sealed arm is never left paused;
11: #   4. emulator 2 is used only after the sealed arm's launcher, runner and server (:8115) are all gone;
12: #   5. our own llama-server on :8114 (port must be free first; bounded start; PID-bound health check);
13: #   6. the seed-30 DEVELOPMENT pass, unchanged (agent label, prompt v4, thinking on, llama-server flags);
14: #   7. the episode count is reported, INCOMPLETE when it is not 116 (v1 printed "finished" regardless).
15: # Codex audit: results/codex/v4_local_lane_audit/codex_v4_local_lane_audit.md
16: # Usage: nohup bash scripts/androidworld/local_v4_to_aw_v2.sh models/hf_local/LFM3-VL-2B-AndroidAgent-v4 >> logs/local_v4_to_aw.log 2>&1 &
17: set -u
18: cd "$(dirname "$0")/../.." || exit 1
19: SP=""; SRC=$1; OUT=models/lfm3vl2b_v4-GGUF; NAME=lfm3vl2b_v4; PORT=8114; CP=5558; GP=8558
20: GG=$OUT/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf; MM=models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf
21: BASE=$HOME/.cache/huggingface/hub/models--LiquidAI--LFM3-VL-2B/snapshots/23387beda43c60310348e83e25f78f33c3140d3a/model.safetensors
22: MAN=results/v4_local_export_manifest.json
23: log() { echo "[$(date +%T)] $*"; }
24: release() { [ -n "${SP:-}" ] && kill "$SP" 2>/dev/null; log "$*"; log "v4 AndroidWorld seed-30 finished"; exit 1; }   # only our own server
25: [ "$(basename "$SRC")" = LFM3-VL-2B-AndroidAgent-v4 ] || { log "EXPORT FAILED (source dir must be named LFM3-VL-2B-AndroidAgent-v4)"; exit 1; }
26: [ -e results/androidworld/$NAME ] && { log "EXPORT FAILED (results/androidworld/$NAME already exists; refusing to mix runs)"; exit 1; }
27: [ -e "$GG" ] && { log "EXPORT FAILED ($GG already exists; refusing to reuse an unverified GGUF)"; exit 1; }
28: .venv-convert/bin/python - "$SRC" "$MAN" <<'PY' || { log "EXPORT FAILED (source dir does not match $MAN)"; exit 1; }
29: import hashlib, json, os, sys
30: src, man = sys.argv[1:3]
31: want = json.load(open(man))["files"]
32: have = sorted(os.listdir(src))
33: assert have == sorted(want), f"file set differs: extra {set(have) - set(want)}, missing {set(want) - set(have)}"
34: for f, h in want.items():
35:     d = hashlib.sha256()
36:     with open(os.path.join(src, f), "rb") as fh:
37:         for b in iter(lambda: fh.read(1 << 24), b""): d.update(b)
38:     assert d.hexdigest() == h, f"sha256 mismatch: {f}"
39: print("source dir matches the manifest:", len(want), "files")
40: PY
41: AD=$(.venv-convert/bin/python -c "
42: import json
43: from huggingface_hub import snapshot_download
44: m = json.load(open('$MAN'))
45: print(snapshot_download(m['adapter_repo'], revision=m['adapter_rev'], allow_patterns=['adapter_model.safetensors','adapter_config.json']))") \
46:   || { log "EXPORT FAILED (adapter download)"; exit 1; }
47: log "checking $SRC against base + $AD"
48: .venv-convert/bin/python scripts/publish/check_local_merge.py "$SRC" "$BASE" "$AD" || { log "EXPORT FAILED (merge check)"; exit 1; }
49: bash scripts/publish/local_export_gguf.sh "$SRC" "$OUT" || { log "EXPORT FAILED"; exit 1; }
50: [ -s "$GG" ] && [ -s "$MM" ] || { log "EXPORT FAILED (missing $GG)"; exit 1; }
51: shasum -a 256 "$GG" "$MM"
52: log "exported; pausing the sealed GUI-Owl seed-1234 arm on emulator $CP (scripts/androidworld/local_emu2_fill_v2.sh resumes it afterwards)"
53: t0=$(date +%s)
54: while pgrep -f "[r]un_aw.py.*console_port=$CP" >/dev/null || pgrep -f "^bash scripts/(androidworld/)?local_sealed_aw(_v[23])?.sh guiowl 1234 $CP " >/dev/null \
55:       || pgrep -f "[l]lama-server.*--port 8115 " >/dev/null; do
56:   [ $(( $(date +%s) - t0 )) -gt 1800 ] && release "emulator $CP still busy after 30 min; v4 seed-30 run NOT STARTED"
57:   sleep 10
58: done
59: log "emulator $CP free (sealed arm launcher, runner and server gone)"
60: curl -s 127.0.0.1:$PORT/health | grep -q ok && release "port $PORT already serving another process; v4 seed-30 run NOT STARTED"
61: nohup llama-server -m $GG --mmproj $MM -c 8192 -np 1 -ngl 99 --image-max-tokens 1024 \
62:   --reasoning-format deepseek --port $PORT --host 127.0.0.1 > logs/llama_server_$NAME.log 2>&1 < /dev/null &
63: SP=$!
64: t0=$(date +%s)
65: until curl -s 127.0.0.1:$PORT/health | grep -q ok; do
66:   kill -0 $SP 2>/dev/null || release "llama-server exited during startup (see logs/llama_server_$NAME.log); v4 seed-30 run NOT STARTED"
67:   [ $(( $(date +%s) - t0 )) -gt 600 ] && release "llama-server not healthy after 600 s; v4 seed-30 run NOT STARTED"
68:   sleep 3
69: done
70: kill -0 $SP 2>/dev/null && pgrep -f "[l]lama-server.*--port $PORT " | grep -qx "$SP" || release "the server on :$PORT is not the one just started; NOT STARTED"
71: log "server :$PORT up (pid $SP, $GG); starting v4 seed-30 development pass on emulator $CP"
72: .venv-aw/bin/python eval/androidworld/run_aw.py --console_port=$CP --grpc_port=$GP --server_url=http://127.0.0.1:$PORT \
73:   --agent_label=lfm3vl2b_v4_q4km --enable_thinking=true --prompt_version=v4 --output_path=results/androidworld/$NAME 2>&1 \
74:   | grep --line-buffered -v "_os_env_vars\|FD from fork\|fork_posix" > logs/aw_run_$NAME.log
75: kill $SP 2>/dev/null
76: D=$(ls -d results/androidworld/$NAME/run_*/ 2>/dev/null | tail -1); D=${D%/}
77: N=$([ -n "$D" ] && ls "$D"/*.pkl.gz 2>/dev/null | wc -l | tr -d ' ' || echo 0)
78: [ "$N" = 116 ] && log "v4 seed-30 run complete: 116 episodes in $D" || log "v4 seed-30 run INCOMPLETE: $N/116 episodes in ${D:-none}"
79: log "v4 AndroidWorld seed-30 finished"
FILE scripts/androidworld/local_emu2_fill_v4.sh (51 lines)
1: #!/bin/bash
2: # v4 of the filler: identical to local_emu2_fill_v3.sh except that arms run through scripts/androidworld/local_sealed_aw_v3.sh (bounded,
3: # PID-bound server start that fails instead of hanging, so GUI-Owl seed 1234 is always resumed; Codex P2-1).
4: # Emulator 2, after the v4 seed-30 development pass (replaces scripts/androidworld/local_emu2_fill_v2.sh while it waits; the sealed
5: # GUI-Owl seed-1234 arm is already paused with 33 saved episodes):
6: #   1. wait for "v4 AndroidWorld seed-30 finished" in logs/local_v4_to_aw.log and for emulator 2 to be free;
7: #   2. apply the preregistered development gate mechanically (analysis/v4_gate.py; docs/PREREG_v4.md):
8: #        PASS -> "LFM3 final" = v4: run the SEALED v4 seed-7 arm (prereg: the final model runs seed 7 once frozen);
9: #        FAIL -> "LFM3 final" = v3 and v1: run the SEALED v3 seed-7 arm (v1 seed 7 already has 116 episodes);
10: #        gate input error / incomplete seed-30 run -> run no final arm (needs a human decision);
11: #      v4-RL failed its offline promotion rule (results/v4rl_promotion_offline.json), so it is not a candidate;
12: #   3. resume the sealed GUI-Owl seed-1234 arm from its run directory.
13: # Outcomes of sealed arms are never printed here (the sealed runner keeps its output inside the sealed dir).
14: # Usage: nohup bash scripts/androidworld/local_emu2_fill_v4.sh >> logs/local_emu2_fill.log 2>&1 &
15: set -u
16: cd "$(dirname "$0")/../.." || exit 1
17: CP=5558; GP=8558; LANE=logs/local_v4_to_aw.log
18: GO=results/androidworld_sealed/guiowl_seed1234; GOLOG=logs/local_sealed_guiowl_seed1234.log
19: log() { echo "[$(date +%T)] $*"; }
20: rundir() { local d; d=$(ls -d "$1"/run_*/ 2>/dev/null | tail -1); echo "${d%/}"; }
21: count() { local d; d=$(rundir "$1"); [ -n "$d" ] && ls "$d"/*.pkl.gz 2>/dev/null | wc -l | tr -d ' ' || echo 0; }
22: busy() { pgrep -f "[r]un_aw.py.*console_port=$CP" >/dev/null || pgrep -f "^bash scripts/(androidworld/)?local_sealed_aw(_v[23])?.sh [a-z0-9]+ [0-9]+ $CP " >/dev/null; }
23: RESUME=$(rundir $GO)
24: [ -d "$RESUME" ] || { log "no GUI-Owl seed-1234 run dir; exiting"; exit 1; }
25: log "emu2 fill v3 (pid $$): GUI-Owl seed 1234 paused at $(count $GO) episodes ($RESUME); waiting for the v4 seed-30 pass"
26: until grep -q "v4 AndroidWorld seed-30 finished" "$LANE"; do sleep 60; done
27: while busy; do sleep 10; done
28: ARM=""
29: if grep -q "v4 seed-30 run complete: 116 episodes" "$LANE"; then
30:   .venv-aw/bin/python analysis/v4_gate.py --v4 results/androidworld/lfm3vl2b_v4 --v4_agent lfm3vl2b_v4_q4km \
31:     --dev_answer results/v4_dev/hub/eval/lfm3_v4_dev_answer.jsonl --dev_complete results/v4_dev/hub/eval/lfm3_v4_dev_complete.jsonl \
32:     > results/v4_gate_seed30.txt 2>&1
33:   RC=$?
34:   log "v4 gate exit $RC: $(grep -h "\"PASS\"\|GATE INPUT ERROR" results/v4_gate_seed30.txt | tr -d "\n")"
35:   case $RC in 0) ARM=v4; PORT=8117 ;; 3) ARM=v3; PORT=8118 ;; *) log "gate input error; no final arm started (human decision needed)" ;; esac
36: else
37:   log "v4 seed-30 run not complete ($(grep "seed-30 run" "$LANE" | tail -1)); no final arm started (human decision needed)"
38: fi
39: if [ -n "$ARM" ]; then
40:   if [ "$(count results/androidworld_sealed/${ARM}_seed7)" != 0 ]; then
41:     log "results/androidworld_sealed/${ARM}_seed7 already has episodes; not starting it again"
42:   else
43:     log "LFM3 final per the gate = $ARM; starting the SEALED ${ARM}_seed7 arm on emulator $CP"
44:     bash scripts/androidworld/local_sealed_aw_v3.sh $ARM 7 $CP $GP $PORT >> logs/local_sealed_${ARM}_seed7.log 2>&1 < /dev/null
45:     log "${ARM}_seed7 ended: $(tail -1 logs/local_sealed_${ARM}_seed7.log) ($(count results/androidworld_sealed/${ARM}_seed7) episodes)"
46:   fi
47: fi
48: while busy; do sleep 10; done
49: log "resuming guiowl_seed1234 from $RESUME"
50: bash scripts/androidworld/local_sealed_aw_v3.sh guiowl 1234 $CP $GP 8115 "$RESUME" >> "$GOLOG" 2>&1 < /dev/null
51: log "guiowl_seed1234 ended: $(tail -1 "$GOLOG") ($(count $GO) episodes)"
FILE scripts/androidworld/pause_sealed_arm.sh (16 lines)
1: #!/bin/bash
2: # Pause one sealed AndroidWorld arm so its emulator can be used, keeping its results resumable (AW checkpoint dir).
3: # Kills ONLY (allowlist): the arm's launcher `bash scripts/(androidworld/)local_sealed_aw[_v2|_v3].sh <arm> <seed> ...`, its run_aw.py
4: # (identified by --output_path=results/androidworld_sealed/<arm>_seed<seed>), and the llama-server on <server_port>.
5: # Usage: bash scripts/androidworld/pause_sealed_arm.sh <arm> <seed> <server_port> [--dry-run]
6: set -u
7: ARM=$1; SEED=$2; PORT=$3; DRY=${4:-}
8: L=$(pgrep -f "^bash scripts/(androidworld/)?local_sealed_aw(_v[23])?.sh $ARM $SEED ")
9: R=$(pgrep -f "[r]un_aw.py.*--output_path=results/androidworld_sealed/${ARM}_seed${SEED} ")
10: S=$(pgrep -f "[l]lama-server.*--port $PORT ")
11: echo "launcher: ${L:-none} run_aw: ${R:-none} server: ${S:-none}"
12: [ "$DRY" = "--dry-run" ] && exit 0
13: for p in $L $R $S; do kill "$p"; done
14: sleep 5
15: D=$(ls -d results/androidworld_sealed/${ARM}_seed${SEED}/run_* 2>/dev/null | tail -1)
16: echo "paused; resume dir: $D ($(ls $D/*.pkl.gz 2>/dev/null | wc -l | tr -d ' ') episodes saved)"
