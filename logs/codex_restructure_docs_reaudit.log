1: """Sensitivity analyses for the final held-out AndroidWorld result (docs/PREREG_v4.md, 2026-11-19 13:40 and 16:20).
2: 
3: Not preregistered. Reuses analysis/sealed_analysis.py unchanged (loaded with runpy, so its input checks, its re-run
4: substitution and its template-clustered sign-flip test + test-inversion CI are exactly the primary ones) and varies only
5: which paired instances enter, or how one set of episodes is scored:
6:   A. primary (reproduced);
7:   B. drop every (seed, template) pair in which v4 or GUI-Owl still ends in an exception (scoring-phase / after-step-1
8:      exceptions counted as failures in the primary, and re-runs that crashed again);
9:   B3. drop the three templates named in the 13:40 entry (BrowserDraw, SimpleSmsReplyMostRecent,
10:      SimpleSmsSendReceivedAddress) on every seed, as that entry literally promised;
11:   C. v4 seed 1234's 113 re-run episodes counted as failures (as if the re-run rule had not been applied);
12:   D. seed 1234 excluded entirely (seeds 7 and 2026, clusters = templates across those two seeds);
13:   E/F. preregistered secondary breakdown: the 78 templates whose goal text can vary with the seed
14:      (results/aw_template_manifest.json) and the other 38 (20 of which still vary hidden setup with the seed).
15: Usage: .venv-aw/bin/python analysis/sealed_sensitivity.py  ->  results/sealed_sensitivity_final.{json,md}
16: """
17: import json
18: import math
19: import os
20: import runpy
21: import sys
22: import tempfile
23: 
24: tmp = tempfile.mkdtemp()
25: sys.argv = ["sealed_analysis.py", "--seeds", "7,1234,2026", "--out", os.path.join(tmp, "a")]
26: G = runpy.run_path("analysis/sealed_analysis.py")
27: data, META, signflip, signflip_ci, SUBST = G["data"], G["META"], G["signflip"], G["signflip_ci"], G["SUBST"]
28: VARY = G["VARY"]
29: NI = G["NI_MARGIN"]
30: 
31: 
32: def paired(x, y, seeds, keep=lambda s, t: True, ok=lambda arm, s, t: data[(arm, s)][0][t]):
33:     clusters, diffs, n_x, n_y = [], [], 0, 0
34:     for t in sorted(META):
35:         ds = [int(ok(x, s, t)) - int(ok(y, s, t)) for s in seeds if keep(s, t)]
36:         n_x += sum(int(ok(x, s, t)) for s in seeds if keep(s, t))
37:         n_y += sum(int(ok(y, s, t)) for s in seeds if keep(s, t))
38:         if ds:
39:             clusters.append((sum(ds), len(ds)))
40:             diffs += ds
41:     n = len(diffs)
42:     ex = signflip_ci(clusters, n)
43:     ci = [math.floor(1000 * ex[0] + 1e-9) / 10, math.ceil(1000 * ex[1] - 1e-9) / 10] if ex else None
44:     return {"n_instances": n, "n_clusters": len(clusters), f"{x}_successes": n_x, f"{y}_successes": n_y,
45:             "mean_diff_pp": round(100 * sum(diffs) / n, 1), "signflip_p_two_sided": round(signflip(clusters, n), 4),
46:             "ci95_pp_test_inversion": ci, "non_inferior_vs_margin": bool(ex and 100 * ex[0] > NI)}
47: 
48: 
49: S = [7, 1234, 2026]
50: exc = lambda arm, s, t: data[(arm, s)][1][t]
51: dropped = sorted((s, t) for s in S for t in META if exc("v4", s, t) or exc("guiowl", s, t))
52: rerun113 = {r["task"] for r in SUBST if r["arm"] == "v4" and r["seed"] == 1234}
53: out = {
54:     "A_primary": paired("v4", "guiowl", S),
55:     "B_drop_pairs_with_remaining_exceptions": dict(paired("v4", "guiowl", S, keep=lambda s, t: (s, t) not in dropped),
56:                                                    dropped=[f"seed {s} {t}" for s, t in dropped]),
57:     "B3_drop_three_templates_named_1340": paired("v4", "guiowl", S, keep=lambda s, t: t not in {
58:         "BrowserDraw", "SimpleSmsReplyMostRecent", "SimpleSmsSendReceivedAddress"}),
59:     "C_v4_seed1234_reruns_counted_as_failures": dict(paired("v4", "guiowl", S, ok=lambda arm, s, t: False if (
60:         arm == "v4" and s == 1234 and t in rerun113) else data[(arm, s)][0][t]), n_reruns=len(rerun113)),
61:     "D_seed1234_excluded": paired("v4", "guiowl", [7, 2026]),
62:     "E_goal_text_can_vary_78_templates": paired("v4", "guiowl", S, keep=lambda s, t: t in VARY),
63:     "F_goal_text_fixed_38_templates": paired("v4", "guiowl", S, keep=lambda s, t: t not in VARY),
64:     "notes": ["A-D not preregistered; E/F are the preregistered seed-varying breakdown (secondary). "
65:                "The primary analysis is results/sealed_analysis_final.md.",
66:               f"Non-inferiority margin {NI} pp on the lower bound of the 95% sign-flip test-inversion interval."],
67: }
68: json.dump(out, open("results/sealed_sensitivity_final.json", "w"), indent=1)
69: L = ["# Held-out AndroidWorld: sensitivity analyses and subgroups (v4 - GUI-Owl)", "",
70:      "| Variant | Paired instances (templates) | v4 | GUI-Owl | Difference (pp) | 95% CI | p | Non-inferior (-6.9 pp) |",
71:      "|---|---|---|---|---|---|---|---|"]
72: for k, v in out.items():
73:     if k == "notes":
74:         continue
75:     L.append(f"| {k} | {v['n_instances']} ({v['n_clusters']}) | {v['v4_successes']} | {v['guiowl_successes']} | "
76:              f"{v['mean_diff_pp']} | {v['ci95_pp_test_inversion']} | {v['signflip_p_two_sided']} | "
77:              f"{'yes' if v['non_inferior_vs_margin'] else 'no'} |")
78: L += ["", "Dropped in B: " + ", ".join(out["B_drop_pairs_with_remaining_exceptions"]["dropped"])] + [""] + out["notes"]
79: open("results/sealed_sensitivity_final.md", "w").write("\n".join(L) + "\n")
80: print("\n".join(L))
FILE analysis/sealed_analysis.py (307 lines)
1: """Pre-registered held-out analysis (docs/PREREG_v4.md, "Analysis") for the sealed AndroidWorld arms.
2: 
3: Arms: v4 (LFM3 final), guiowl (GUI-Owl matched), v1 (reference). Only the seeds given with --seeds are opened; run it
4: only for seeds whose arms have ALL finished (it refuses otherwise). Score = full success (is_successful >= 1, exception =
5: failure) per task template (n_task_combinations = 1, so one instance per template per seed).
6: Primary: paired difference v4 - GUI-Owl over all held-out instances; template-clustered sign-flip permutation test
7: (10,000 permutations, clusters = templates, seed 0); 95% CI by inverting that test; non-inferiority if the lower
8: bound > -6.9 pp. Also: exact McNemar per seed, Wilson CIs, answer/action split, per difficulty, templates whose goal text
9: can vary with the seed (source-checked manifest results/aw_template_manifest.json, 78 templates).
10: CI endpoints are the exact endpoints of the accepted set of the inverted test for the fixed 10,000 sign draws (found at
11: the test's breakpoints), reported rounded outward to 0.1 pp; the non-inferiority decision uses the unrounded bound.
12: Sensitivity: successes disputed by the per-success trajectory review (results/aw_checker_disputes.json) counted as
13: failures; the primary score is never rewritten.
14: Usage: python analysis/sealed_analysis.py --seeds 7 --out results/sealed_analysis_seed7
15: """
16: import argparse
17: import glob
18: import gzip
19: import hashlib
20: import json
21: import math
22: import os
23: import pickle
24: import re
25: from math import comb
26: 
27: import numpy as np
28: 
29: p = argparse.ArgumentParser()
30: p.add_argument("--seeds", required=True, help="comma-separated held-out seeds (all arms must be complete)")
31: p.add_argument("--out", required=True, help="output prefix (.json and .md are written)")
32: p.add_argument("--perms", type=int, default=10000)
33: a = p.parse_args()
34: SEEDS = [int(s) for s in a.seeds.split(",")]
35: ARMS = {"v4": "lfm3vl2b_v4_q4km", "guiowl": "guiowl15_2b_matched1img_apps_q4km", "v1": "lfm3vl2b_v1_q4km"}
36: LABEL = {"v4": "LFM3 v4 (final)", "guiowl": "GUI-Owl-1.5-2B matched", "v1": "LFM3 v1 (reference)"}
37: NI_MARGIN = -6.9
38: ANSWER = set(json.load(open("results/codex/v3_audit/answer_tasks.json"))["answer_tasks"])
39: META = {m["task_name"]: m for m in json.load(open("data/meta/androidworld_task_metadata.json"))}
40: VARY = set(json.load(open("results/aw_template_manifest.json"))["goal_text_can_vary"])
41: assert len(VARY) == 78 and VARY <= set(META)
42: DISPUTES = json.load(open("results/aw_checker_disputes.json"))["disputes"]
43: SETUP = {}  # (run_root, template) -> True if the exception's last traceback is task setup (_run_task -> initialize_task)
44: 
45: 
46: def instance_seed(suite_seed, t, i=0):  # android_world suite_utils.create_suite._get_instance_seed
47:     return int(hashlib.sha256(f"{suite_seed}_{t}_{i}".encode()).hexdigest(), 16) % (2 ** 32)
48: 
49: 
50: def load(run_root, agent, expect=116, full=True):
51:     runs = [d for d in glob.glob(os.path.join(run_root, "run_*")) if os.path.isdir(d)]  # not run_output.SEALED.log
52:     if len(runs) != 1:
53:         raise SystemExit(f"INPUT ERROR: {run_root} must contain exactly one run dir, found {len(runs)}")
54:     files = glob.glob(os.path.join(runs[0], "*.pkl.gz"))
55:     if expect is not None and len(files) != expect:
56:         raise SystemExit(f"INPUT ERROR: {run_root} has {len(files)} episodes, expected {expect} (arm not finished?)")
57:     ok, exc, goal, steps = {}, {}, {}, {}
58:     for f in files:
59:         ep = pickle.load(gzip.open(f))  # trusted: written by our own local AndroidWorld runs
60:         if isinstance(ep, list):
61:             if len(ep) != 1:
62:                 raise SystemExit(f"INPUT ERROR: {f} holds {len(ep)} episodes")
63:             ep = ep[0]
64:         t = os.path.basename(f).rsplit("_", 1)[0]
65:         if t in ok or ep.get("task_template") != t:
66:             raise SystemExit(f"INPUT ERROR: duplicate or mislabelled episode {f}")
67:         if ep.get("agent_name") != agent:
68:             raise SystemExit(f"INPUT ERROR: {f} agent_name {ep.get('agent_name')!r} != {agent!r}")
69:         r = ep.get("is_successful")
70:         e = bool(ep.get("exception_info"))
71:         # instance identity (Codex final audit P3-1): instance 0 of this template under this run's suite seed. Episodes
72:         # that crashed in setup do not store the seed; every other episode must.
73:         if ep.get("instance_id") != 0:
74:             raise SystemExit(f"INPUT ERROR: {f} instance_id {ep.get('instance_id')!r} != 0")
75:         if "seed" in ep or not e:
76:             if ep.get("seed") != instance_seed(int(re.search(r"_seed(\d+)", run_root).group(1)), t):
77:                 raise SystemExit(f"INPUT ERROR: {f} stored seed {ep.get('seed')!r} is not this suite seed's instance seed")
78:         if e:
79:             frames = re.findall(r'File "[^"]+", line \d+, in (\w+)', str(ep["exception_info"]).split(
80:                 "Traceback (most recent call last):")[-1])
81:             SETUP[(run_root, t)] = frames[:2] == ["_run_task", "initialize_task"]
82:         ok[t] = isinstance(r, (int, float)) and not math.isnan(r) and r >= 1 and not e
83:         exc[t] = e
84:         goal[t] = re.sub(r"\d{8}_\d{6}", "<ts>", ep.get("goal") or "")
85:         steps[t] = ep.get("episode_length")
86:     if full and set(ok) != set(META):
87:         raise SystemExit(f"INPUT ERROR: {run_root} templates differ from task_metadata.json")
88:     return ok, exc, goal, steps
89: 
90: 
91: def wilson(k, n, z=1.959964):
92:     ph = k / n
93:     c = (ph + z * z / (2 * n)) / (1 + z * z / n)
94:     h = z * math.sqrt(ph * (1 - ph) / n + z * z / (4 * n * n)) / (1 + z * z / n)
95:     return [round(100 * (c - h), 1), round(100 * (c + h), 1)]
96: 
97: 
98: def mcnemar(b, c):
99:     n = b + c
100:     if n == 0:
101:         return 1.0
102:     k = min(b, c)
103:     return min(1.0, 2 * sum(comb(n, i) for i in range(k + 1)) / 2 ** n)
104: 
105: 
106: def signflip(cluster_sums, n_inst, delta=0.0, perms=10000, seed=0):
107:     """Two-sided p for H0: mean paired difference = delta, flipping signs of template-cluster sums of (d - delta)."""
108:     x = np.array([s - delta * m for s, m in cluster_sums])
109:     obs = abs(x.sum()) / n_inst
110:     rng = np.random.default_rng(seed)
111:     signs = rng.choice([-1.0, 1.0], size=(perms, len(x)))
112:     stats = np.abs(signs @ x) / n_inst
113:     return float((1 + np.sum(stats >= obs - 1e-12)) / (perms + 1))
114: 
115: 
116: def signflip_ci(cluster_sums, n_inst, perms=10000, seed=0, alpha=0.05):
117:     """Exact endpoints of {delta: signflip(delta) >= alpha} for the same sign draws as signflip(). For draw j the
118:     extremeness indicator |A_j - delta*B_j| >= |A0 - delta*B0| changes only where A_j - delta*B_j = +-(A0 - delta*B0), and
119:     it holds with equality there, so the accepted set's endpoints are among these breakpoints (plus the point estimate)."""
120:     x = np.array([s for s, m in cluster_sums], float)
121:     w = np.array([m for s, m in cluster_sums], float)
122:     rng = np.random.default_rng(seed)
123:     signs = rng.choice([-1.0, 1.0], size=(perms, len(x)))
124:     A, B, A0, B0 = signs @ x, signs @ w, x.sum(), w.sum()
125:     with np.errstate(divide="ignore", invalid="ignore"):
126:         cand = np.concatenate([(A - A0) / (B - B0), (A + A0) / (B + B0), [A0 / B0]])
127:     cand = np.unique(cand[np.isfinite(cand) & (cand >= -1) & (cand <= 1)])
128:     acc = []
129:     for i in range(0, len(cand), 400):
130:         d = cand[i:i + 400][:, None]
131:         cnt = np.sum(np.abs(A[None, :] - d * B[None, :]) >= np.abs(A0 - d * B0) - 1e-9, axis=1)
132:         acc += list(cand[i:i + 400][(1 + cnt) / (perms + 1) >= alpha])
133:     return (float(min(acc)), float(max(acc))) if acc else None
134: 
135: 
136: # ---- load (only the requested, complete seeds)
137: data = {}
138: for s in SEEDS:
139:     for arm, agent in ARMS.items():
140:         data[(arm, s)] = load(f"results/androidworld_sealed/{arm}_seed{s}", agent)
FILE eval/general/paired_retention.py (22 lines)
1: """Paired before/after general-knowledge comparison: accuracy delta, 95% bootstrap CI, exact McNemar p-value."""
2: import json, math, random, sys
3: base = {(r["kind"], str(r["id"])): r["correct"] for r in map(json.loads, open(sys.argv[1]))}
4: ft = {(r["kind"], str(r["id"])): r["correct"] for r in map(json.loads, open(sys.argv[2]))}
5: out = {}
6: for kind in ("mmstar", "mmlu"):
7:     keys = sorted(k for k in base if k[0] == kind and k in ft)
8:     pairs = [(base[k], ft[k]) for k in keys]
9:     n = len(pairs); b = sum(1 for x, y in pairs if x and not y); c = sum(1 for x, y in pairs if y and not x)
10:     delta = (sum(y for _, y in pairs) - sum(x for x, _ in pairs)) / n
11:     rng = random.Random(0); boots = []
12:     for _ in range(2000):
13:         s = [pairs[rng.randrange(n)] for _ in range(n)]
14:         boots.append((sum(y for _, y in s) - sum(x for x, _ in s)) / n)
15:     boots.sort()
16:     k, m = min(b, c), b + c
17:     p = min(1.0, 2 * sum(math.comb(m, i) for i in range(k + 1)) / 2 ** m) if m else 1.0
18:     out[kind] = {"n": n, "base_acc": sum(x for x, _ in pairs) / n, "ft_acc": sum(y for _, y in pairs) / n, "delta": delta,
19:                  "ci95": [boots[50], boots[1949]], "lost(base right, ft wrong)": b, "gained": c, "mcnemar_p": p}
20: print(json.dumps(out, indent=1))
21: if len(sys.argv) > 3:
22:     json.dump(out, open(sys.argv[3], "w"), indent=1)
