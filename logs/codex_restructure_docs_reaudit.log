FILE analysis/strict_dev_metrics.py (23 lines)
1: """Strict metrics on v4 dev predictions (generate.py jsonl): dev_answer -> answer emitted / strict typed match
2: (data/v4_answer_check.same_answer); dev_complete -> false `answer` rate / `status complete` rate.
3: usage: python strict_dev_metrics.py --answer <dev_answer.jsonl> --complete <dev_complete.jsonl> --out <json>"""
4: import argparse, json, os, sys
5: here = os.path.dirname(os.path.abspath(__file__))
6: for d in (here, os.path.join(here, "..", "train"), os.path.join(here, "..", "data")):
7:     sys.path.insert(0, d)
8: import agent_format as af  # noqa: E402
9: from v4_answer_check import exact_answer, same_answer  # noqa: E402
10: p = argparse.ArgumentParser(); p.add_argument("--answer", required=True); p.add_argument("--complete", required=True)
11: p.add_argument("--out", required=True); a = p.parse_args()
12: A = [json.loads(l) for l in open(a.answer)]; C = [json.loads(l) for l in open(a.complete)]
13: assert A and C, "empty prediction file"
14: pa = [af.parse_action(r["output"], strict=True) for r in A]; pc = [af.parse_action(r["output"], strict=True) for r in C]
15: m = {"n_answer": len(A), "n_complete": len(C),
16:      "answer_emitted": sum(1 for x in pa if x and x["action_type"] == "answer") / max(1, len(A)),
17:      "answer_exact_strict": sum(1 for r, x in zip(A, pa) if x and x["action_type"] == "answer"
18:                                 and same_answer(x["text"], json.loads(r["gt_action"])["text"])) / max(1, len(A)),
19:      "complete_false_answer": sum(1 for x in pc if x and x["action_type"] == "answer") / max(1, len(C)),
20:      "complete_status": sum(1 for x in pc if x and x["action_type"] == "status" and x.get("goal_status") == "complete") / max(1, len(C)),
21:      "answer_exact_normalised": sum(1 for r, x in zip(A, pa) if x and x["action_type"] == "answer"
22:                                     and exact_answer(x["text"], json.loads(r["gt_action"])["text"])) / max(1, len(A))}
23: json.dump(m, open(a.out, "w"), indent=1); print(json.dumps(m))
FILE analysis/v4rl_promotion.py (90 lines)
1: """Offline part of the v4-RL promotion rule (docs/PREREG_v4.md, 2026-11-18 04:05 item 10 and 06:25):
2: v4-RL replaces v4 as "LFM3 final" only if, versus v4,
3:   (a) strict dev_answer match (gate_answer: same_answer and no added content words) >= +0.05 absolute,
4:   (b) dev_complete false-answer rate <= 0.03,
5:   (c) AndroidControl test high-level step SR >= -0.02,
6:   (d) and on AndroidWorld seed 30 it passes the v4 gate with total full successes >= v4's (checked separately with
7:       analysis/v4_gate.py --dev_model /content/runs/v4rl/merged + the two seed-30 totals).
8: Inputs are bound like the gate's: every prediction file must cover exactly the pinned dev split rows
9: (results/v4_dev_reference.json) and carry a generate.py manifest for greedy thinking-mode predictions of the stated model;
10: AndroidControl metrics must be complete and come from the stated model.
11: Usage: python analysis/v4rl_promotion.py --v4_dir results/v4_dev/hub/eval --rl_dir results/v4rl_dev --out results/v4rl_promotion_offline.json
12: """
13: import argparse, json, os, sys
14: 
15: here = os.path.dirname(os.path.abspath(__file__))
16: sys.path.insert(0, os.path.join(here, "..", "train")); sys.path.insert(0, os.path.join(here, "..", "data"))
17: import agent_format as af  # noqa: E402
18: from v4_answer_check import gate_answer, same_answer  # noqa: E402
19: 
20: p = argparse.ArgumentParser()
21: p.add_argument("--v4_dir", required=True); p.add_argument("--rl_dir", required=True); p.add_argument("--out", required=True)
22: p.add_argument("--v4_model", default="/content/runs/lfm3vl2b-v4bmix-lora/merged")
23: p.add_argument("--rl_model", default="/content/runs/v4rl/merged")
24: p.add_argument("--dev_ref", default="results/v4_dev_reference.json")
25: a = p.parse_args()
26: REF = json.load(open(a.dev_ref))
27: SETTINGS = set()  # (prompt hash, max_pixels, max_new_tokens) of every input: must be one setting for both models
28: 
29: 
30: def preds(path, split, model):
31:     rows = [json.loads(l) for l in open(path)]
32:     want = sorted((str(e), int(i), g) for e, i, g in REF["splits"][split])
33:     got = sorted((str(r["episode_id"]), int(r["step_idx"]), r["gt_action"]) for r in rows)
34:     if got != want or len(set(got)) != len(got):
35:         raise SystemExit(f"INPUT ERROR: {path}: rows != {split} of {REF['repo']}@{REF['revision']}")
36:     man = json.load(open(path + ".manifest.json"))
37:     want_data = f"{REF['repo']}@{split}#{REF['revision']}"
38:     if (man.get("model"), man.get("data"), man.get("n_rows"), man.get("do_sample"), man.get("enable_thinking")) != \
39:             (model, want_data, len(want), False, 1):
40:         raise SystemExit(f"INPUT ERROR: {path}.manifest.json is not greedy thinking-mode {model} on {want_data}: {man}")
41:     SETTINGS.add((man.get("prompt"), man.get("max_pixels"), man.get("max_new_tokens")))
42:     if any(r.get("config_hash", man.get("config_hash")) != man.get("config_hash") for r in rows):
43:         raise SystemExit(f"INPUT ERROR: {path}: rows' config_hash differs from the manifest's")
44:     if any(r.get("model") != model or r.get("split", split) != split for r in rows):
45:         raise SystemExit(f"INPUT ERROR: {path}: rows from another model/split")
46:     return rows, [af.parse_action(r["output"], strict=True) for r in rows]
47: 
48: 
