53:                        and f(x["text"], json.loads(r["gt_action"])["text"])) / len(rows)
54:     return {"dev_answer_emitted": sum(1 for x in acts if x and x["action_type"] == "answer") / len(acts),
55:             "dev_answer_gate": ok(gate_answer), "dev_answer_same_answer": ok(same_answer),
56:             "dev_complete_false_answer": sum(1 for x in acts_c if x and x["action_type"] == "answer") / len(acts_c)}
