1: #!/bin/bash
2: # Run one SEALED AndroidWorld arm on a held-out seed (docs/PREREG_v4.md): results go to results/androidworld_sealed/,
3: # the runner's full output is written only inside the sealed dir; progress = episode-file counts; nobody reads results
4: # before every arm on the seed has finished. Exit status and the 116-episode inventory decide "finished" vs "FAILED".
5: # v3 (2026-11-18, Codex audit results/codex/emu2_v3_promo_audit/report.md P2-1): server startup is bounded (600 s,
6: # 5 s per health request), tied to the launched PID, and fails with a non-zero exit instead of hanging, so a filler can
7: # go on (e.g. resume a paused arm). Otherwise identical to local_sealed_aw_v2.sh.
8: # Usage: bash scripts/androidworld/local_sealed_aw_v3.sh <arm> <seed> <console_port> <grpc_port> <server_port> [resume_run_dir]
9: #   arm = v1 | v3 | v4 | guiowl
10: set -u
11: cd "$(dirname "$0")/../.." || exit 1
12: ARM=$1; SEED=$2; CP=$3; GP=$4; PORT=$5; RESUME=${6:-}
13: NAME=${ARM}_seed${SEED}
14: OUT=results/androidworld_sealed/$NAME
15: LOG=$OUT/run_output.SEALED.log   # full runner output stays inside the sealed dir (AW prints per-episode result tables)
16: mkdir -p "$OUT"
17: # outcome lines (suite_utils prints "Task Successful/Failed") and android_env fork noise are not written to the log
18: FILTER="Task Successful\|Task Failed\|_os_env_vars\|FD from fork\|fork_posix"
19: case "$ARM" in
20:   v1) SRV=(-m models/LFM3-VL-2B-AndroidControl-GGUF/LFM3-VL-2B-AndroidControl-Q4_K_M.gguf
21:            --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
22:       RUN=(--agent=lfm --enable_thinking=true --agent_label=lfm3vl2b_v1_q4km) ;;
23:   v3) SRV=(-m models/lfm3vl2b_v3-GGUF/LFM3-VL-2B-AndroidAgent-v3-Q4_K_M.gguf
24:            --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
25:       RUN=(--agent=lfm --enable_thinking=true --agent_label=lfm3vl2b_v3_q4km) ;;
26:   v4) SRV=(-m models/lfm3vl2b_v4-GGUF/LFM3-VL-2B-AndroidAgent-v4-Q4_K_M.gguf
27:            --mmproj models/LFM3-VL-2B-GGUF/mmproj-LFM3-VL-2B-Q8_0.gguf -c 8192 --image-max-tokens 1024 --reasoning-format deepseek)
28:       RUN=(--agent=lfm --enable_thinking=true --prompt_version=v4 --agent_label=lfm3vl2b_v4_q4km) ;;
29:   guiowl) SRV=(-m models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.Q4_K_M.gguf
30:                --mmproj models/GUI-Owl-1.5-2B-GGUF/GUI-Owl-1.5-2B-Instruct.mmproj-Q8_0.gguf -c 20480 --image-max-tokens 2600 --jinja)
31:       RUN=(--agent=guiowl --guiowl_images=1 --guiowl_max_pixels=1048576 --installed_apps=true
32:            --agent_label=guiowl15_2b_matched1img_apps_q4km) ;;
33:   *) echo "unknown arm $ARM"; exit 2 ;;
34: esac
35: for f in "${SRV[1]}" "${SRV[3]}"; do [ -s "$f" ] || { echo "missing $f"; exit 1; }; done
36: lsof -nP -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1 && { echo "port $PORT already in use; refusing"; exit 1; }
37: nohup llama-server "${SRV[@]}" -np 1 -ngl 99 --port $PORT --host 127.0.0.1 > logs/llama_server_$NAME.log 2>&1 < /dev/null &
38: SP=$!; t0=$(date +%s)
39: until curl -s --max-time 5 127.0.0.1:$PORT/health | grep -q ok; do
40:   kill -0 $SP 2>/dev/null || { echo "[$(date +%T)] llama-server exited during startup (logs/llama_server_$NAME.log)"; exit 1; }
41:   [ $(( $(date +%s) - t0 )) -gt 600 ] && { kill $SP; echo "[$(date +%T)] llama-server not healthy after 600 s"; exit 1; }
42:   sleep 3
43: done
44: OWNER=$(lsof -nP -t -iTCP:$PORT -sTCP:LISTEN 2>/dev/null | head -1)
45: [ "$OWNER" = "$SP" ] || { kill $SP; echo "[$(date +%T)] port $PORT is served by pid ${OWNER:-none}, not the launched $SP; refusing"; exit 1; }
46: echo "[$(date +%T)] server :$PORT up; starting SEALED $NAME (seed $SEED) on emulator $CP"
47: .venv-aw/bin/python eval/androidworld/run_aw.py --console_port=$CP --grpc_port=$GP --server_url=http://127.0.0.1:$PORT \
48:   --task_random_seed=$SEED --n_task_combinations=1 --output_path=$OUT ${RESUME:+--checkpoint_dir=$RESUME} "${RUN[@]}" \
49:   >> "$LOG" 2>&1
50: RC=$?
51: kill $SP 2>/dev/null
52: N=$(ls -d $OUT/run_*/ 2>/dev/null | tail -1 | xargs -I{} sh -c 'ls {}*.pkl.gz 2>/dev/null | wc -l' | tr -d ' ')
53: if [ "$RC" = 0 ] && [ "${N:-0}" = 116 ]; then echo "[$(date +%T)] SEALED $NAME AndroidWorld finished"
54: else echo "[$(date +%T)] SEALED $NAME AndroidWorld FAILED (exit $RC, ${N:-0}/116 episodes)"; exit 1; fi

