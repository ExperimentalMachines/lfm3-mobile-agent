+"""Verify the card's v1/v2 control columns from raw predictions, frozen labels, and logs."""
+import importlib.util
+import json
+import sys
+from pathlib import Path
+from audit_offline import ROOT,OUT,SCRATCH,save,read,sha,exact,action
+import pyarrow.parquet as pq
+
+spec=importlib.util.spec_from_file_location('repo_score',ROOT/'eval/androidcontrol/score.py')
+score=importlib.util.module_from_spec(spec);spec.loader.exec_module(score)
+
+def keyed(rows,key):
+    idx={key(r):r for r in rows}
+    assert len(idx)==len(rows),'duplicate keys'
+    return idx
+
+def main():
+    ac_gt=read(ROOT/'data/meta/androidcontrol_test_gt.jsonl')
+    key=lambda r:(str(r['episode_id']),r['step_idx'],r.get('mode','high'))
+    gt=keyed(ac_gt,key)
+    v1=Path('/Users/alpha/.cache/huggingface/hub/models--experimentalmachines--LFM3-VL-2B-AndroidControl/snapshots/0d06ed80146821ee4371e1c9b28c69a6df0fc39e/eval/lfm3vl2b-ac-lora_ft.jsonl')
+    out={'ac':{},'dev':{},'general':{},'recipe':{}}
+    for ver,p in [('v1',v1),('v2',ROOT/'results/androidcontrol/lfm3vl2b-v2mix-lora_ft.jsonl')]:
+        pred=keyed(read(p),key);assert set(pred)==set(gt)
+        rows=[{**g,'output':pred[k]['output']} for k,g in gt.items()]
+        derived={mode:score.score_rows([r for r in rows if r['mode']==mode and not r['is_terminal']])['step_sr'] for mode in ('high','low')}
+        derived['terminal_complete']=score.score_rows([r for r in rows if r['is_terminal']])['step_sr']
+        name='lfm3vl2b-ac-lora_ft' if ver=='v1' else 'lfm3vl2b-v2mix-lora_ft'
+        saved=json.loads((ROOT/f'results/androidcontrol/{name}.metrics.json').read_text())
+        match=all(abs(derived[m]-saved[m]['overall']['step_sr'])<1e-12 for m in ('high','low')) and abs(derived['terminal_complete']-saved['terminal_complete']['step_sr'])<1e-12
+        out['ac'][ver]={'raw_path':str(p),'raw_sha256':sha(p),'n':len(rows),'step_sr':derived,'saved_matches':match}
+        for split in ('odyssey','amex','screenqa'):
+            dp=ROOT/f'results/v2_dev/lfm3_{ver}_dev_{split}.jsonl'
+            dk=lambda r:(str(r['episode_id']),r['step_idx'])
+            dr=keyed(read(dp),dk)
+            gpath=SCRATCH/f'src/data/dev_{split}-00000-of-00001.parquet'
+            gg=keyed(pq.read_table(gpath,columns=['episode_id','step_idx','gt_action']).to_pylist(),dk)
+            assert set(dr)==set(gg)
+            bad=[k for k in gg if action(dr[k]['gt_action'])!=action(gg[k]['gt_action'])]
+            rr=[{**dr[k],**g,'output':dr[k]['output']} for k,g in gg.items()]
+            m=score.score_rows(rr)
+            sm=json.loads(dp.with_suffix('.metrics.json').read_text())
+            out['dev'][f'{ver}_{split}']={'n':len(rr),'step_sr':m['step_sr'],'episode_sr':m['episode_sr'],'frozen_label_mismatches':bad,'saved_matches':all(m[k]==sm[k] for k in m),'raw_sha256':sha(dp)}
+    base=keyed(read(ROOT/'results/general/lfm3vl2b-ac-lora_base_general_logprob.jsonl'),lambda r:(r['kind'],str(r['id'])))
+    for ver,name,ret in [('v1','lfm3vl2b-ac-lora_ft','lfm3vl2b'),('v2','lfm3vl2b-v2mix-lora_ft','lfm3vl2b_v2')]:
+        pp=ROOT/f'results/general/{name}_general_logprob.jsonl'
+        pred=keyed(read(pp),lambda r:(r['kind'],str(r['id'])))
+        assert set(pred)==set(base)
+        saved=json.loads((ROOT/f'results/general/{ret}_retention_logprob.json').read_text())
+        cr=lambda r:'ABCD'[max(range(4),key=lambda i:json.loads(r['raw'])[i])]==r['gold']
+        for kind in ('mmstar','mmlu'):
+            keys=[k for k in base if k[0]==kind];assert all(base[k]['gold']==pred[k]['gold'] for k in keys)
+            lost=sum(cr(base[k]) and not cr(pred[k]) for k in keys);gained=sum(cr(pred[k]) and not cr(base[k]) for k in keys)
+            b=sum(cr(base[k]) for k in keys)/len(keys); f=sum(cr(pred[k]) for k in keys)/len(keys)
+            m={'n':len(keys),'base_acc':b,'ft_acc':f,'delta':f-b,'lost(base right, ft wrong)':lost,'gained':gained,'mcnemar_p':exact(lost,gained)}
+            out['general'][f'{ver}_{kind}']={**m,'saved_matches':all(abs(v-saved[kind][k])<1e-12 for k,v in m.items())}
+    v1config=Path('/Users/alpha/.cache/huggingface/hub/models--experimentalmachines--LFM3-VL-2B-AndroidControl/snapshots/9df77c802f6a1b690b4738ca4a4288f6f166661b/training_logs/run_config.json')
+    for ver,p in [('v1',v1config),('v2',ROOT/'results/training/lfm3vl2b_v2/run_config.json'),('v3',ROOT/'results/training/lfm3vl2b_v3/run_config.json')]:
+        d=json.loads(p.read_text());out['recipe'][ver]={'path':str(p),**{k:d.get(k) for k in ('max_steps','bs','grad_accum','lr','lora_r','lora_alpha','max_pixels','target_regex','replay')}}
+    save('card_controls.json',out)
+    print(json.dumps(out,indent=2))
+
+if __name__=='__main__':main()
diff --git a/results/codex/v3_audit/audit_checkers.py b/results/codex/v3_audit/audit_checkers.py
new file mode 100644
index 0000000000000000000000000000000000000000..6dc28d93fdad2e639b7dbe8c9f32b29132e4b522
--- /dev/null
+++ b/results/codex/v3_audit/audit_checkers.py
@@ -0,0 +1,76 @@
+"""Derive answer tasks from executable registry + protobuf and compare summarizer versions."""
+import ast
+import json
+import math
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+sys.path.insert(0,str(ROOT/'android_world'))
+from android_world.task_evals.information_retrieval.proto import task_pb2
+from google.protobuf import text_format
+
+def save(name, x):
+    with (OUT/name).open('x') as f:
+        json.dump(x, f, indent=2)
+
+def clean(x):
+    if isinstance(x,float) and math.isnan(x): return 'NaN'
+    if isinstance(x,list): return [clean(v) for v in x]
+    if isinstance(x,dict): return {k:clean(v) for k,v in x.items()}
+    return x
+
+def main():
+    proto_path = ROOT/'android_world/android_world/task_evals/information_retrieval/proto/tasks.textproto'
+    proto = text_format.Parse(proto_path.read_text(),task_pb2.Tasks())
+    answer = {x.name for x in proto.tasks}
+    registry = ast.parse((ROOT/'android_world/android_world/registry.py').read_text())
+    action = {x.attr for n in ast.walk(registry) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='_TASKS' for t in n.targets) for x in n.value.elts}
+    eps = json.loads((OUT/'verified_aw_episodes.json').read_text())
+    runs = sorted({e['run'] for e in eps})
+    rows = []
+    for e in eps:
+        if e['task'] in answer:
+            rows.append({k:e[k] for k in ('run','task','full_success','last_action','answer_actions','file')})
+    splits = {}
+    for run in runs:
+        ee = [e for e in eps if e['run']==run]
+        splits[run] = {'answer_n':sum(e['task'] in answer for e in ee),
+            'answer_successes':sum(e['task'] in answer and e['full_success'] for e in ee),
+            'action_n':sum(e['task'] in action for e in ee),
+            'action_successes':sum(e['task'] in action and e['full_success'] for e in ee),
+            'missing_registry_tasks':sorted((answer|action)-{e['task'] for e in ee}),
+            'extra_tasks':sorted({e['task'] for e in ee}-(answer|action))}
+    save('answer_tasks.json', {'method':'Parse tasks.textproto via protobuf; registry creates InformationRetrieval subclasses whose is_successful reads interaction_cache; static _TASKS via AST.', 'answer_tasks':sorted(answer), 'action_task_count':len(action), 'splits':splits,'answer_episodes':rows})
+
+    # Run historical and current source in memory, preserving the real __file__ for metadata lookup.
+    path = 'eval/androidworld/summarize_aw.py'
+    old = subprocess.check_output(['git','show',f'bebf929^:{path}'],cwd=ROOT,text=True)
+    current = (ROOT/path).read_text()
+    differences = {}
+    for run in runs:
+        run_dir = sorted((ROOT/'results/androidworld'/run).glob('run_*'))
+        assert len(run_dir)==1
+        vals = []
+        for label, code in [('before',old),('after',current)]:
+            target = OUT/f'summary_{label}_{run}.json'
+            assert not target.exists() and not target.with_suffix('.csv').exists()
+            saved_argv = sys.argv
+            sys.argv = [path,str(run_dir[0]),'--out',str(target)]
+            import contextlib,io
+            with contextlib.redirect_stdout(io.StringIO()):
+                exec(compile(code,str(ROOT/path),'exec'),{'__file__':str(ROOT/path),'__name__':'__main__'})
+            sys.argv = saved_argv
+            vals.append(clean(json.loads(target.read_text())))
+        a,b = vals
+        differences[run] = {'summary_changes':{k:{'before':a['summary'].get(k),'after':v} for k,v in b['summary'].items() if v != a['summary'].get(k)},
+            'episode_changes':[{'task':y['task'],'changes':{k:{'before':x.get(k),'after':v} for k,v in y.items() if v!=x.get(k)}} for x,y in zip(a['episodes'],b['episodes']) if x!=y]}
+    # Inspect actual ended_by/error traces independently of the summarizer's action schema guess.
+    v2_answers = [e for e in eps if e['run']=='lfm3vl2b_v2' and e['answer_actions']]
+    save('summary_fix.json', {'differences':differences, 'lfm_v2_answer_episodes':v2_answers})
+    print(json.dumps({'splits':splits,'summary_changes':{r:x['summary_changes'] for r,x in differences.items()},'v2_answers':[{k:e[k] for k in ('task','last_action','ended_by','step_errors','episode_length')} for e in v2_answers]},indent=2))
+
+if __name__=='__main__': main()
diff --git a/results/codex/v3_audit/audit_offline.py b/results/codex/v3_audit/audit_offline.py
new file mode 100644
index 0000000000000000000000000000000000000000..f8eb5a887f81ff52369c729578ae3544490ab3ba
--- /dev/null
+++ b/results/codex/v3_audit/audit_offline.py
@@ -0,0 +1,130 @@
+"""Re-score predictions with repo scorers; verify independent frozen labels.
+Run with .venv/bin/python -B. Existing pyarrow is loaded read-only from uv's cache.
+"""
+import collections
+import hashlib
+import importlib.util
+import json
+import math
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[3]
+OUT=Path(__file__).resolve().parent
+ARROW='/Users/alpha/.cache/uv/archive-v0/HANFDqJNck88aXuT'
+sys.path.insert(0,ARROW)
+import pyarrow.parquet as pq
+SCRATCH=Path('/private/tmp/claude-501/-Users-alpha-lfm3-android/4efa3977-532d-411f-ad28-f4737438aa00/scratchpad/v3build')
+
+def save(name,obj):
+    with (OUT/name).open('x') as f: json.dump(obj,f,indent=2)
+
+def read(p): return [json.loads(x) for x in Path(p).read_text().splitlines() if x.strip()]
+def sha(p):
+    h=hashlib.sha256()
+    with Path(p).open('rb') as f:
+        for b in iter(lambda:f.read(8*1024*1024),b''): h.update(b)
+    return h.hexdigest()
+def action(x): return json.loads(x) if isinstance(x,str) else x
+def exact(b,c): return min(1.,2*sum(math.comb(b+c,k) for k in range(min(b,c)+1))/2**(b+c))
+def run_scorer(script,args,outname):
+    target=OUT/outname
+    assert not target.exists()
+    pr=subprocess.run([sys.executable,'-B',str(ROOT/script),*map(str,args),'--out',str(target)],cwd=ROOT,capture_output=True,text=True)
+    save(outname+'.execution.json', {'argv':pr.args,'returncode':pr.returncode,'stdout':pr.stdout,'stderr':pr.stderr})
+    assert pr.returncode==0,pr.stderr
+    return json.loads(target.read_text())
+
+def main():
+    files=[]
+    pred=ROOT/'results/androidcontrol/lfm3vl2b-v3mix-lora_ft.jsonl'
+    gt=ROOT/'data/meta/androidcontrol_test_gt.jsonl'
+    ac=run_scorer('eval/androidcontrol/score.py',[pred,'--gt',gt],'ac_rescored.metrics.json')
+    old=json.loads(pred.with_suffix('.metrics.json').read_text())
+    ac_same={k:ac[k]==old[k] for k in ac if k!='integrity'}
+    prows,grows=read(pred),read(gt)
+    gi={(r['episode_id'],r['step_idx'],r['mode']):r for r in grows}
+    mismatches=[]
+    for r in prows:
+        g=gi[(r['episode_id'],r['step_idx'],r['mode'])]
+        for field in ('gt_action','gt_bbox','is_terminal','subsplits'):
+            a,b=r.get(field),g.get(field)
+            if field in ('gt_action','gt_bbox'):
+                a=action(a) if a else None; b=action(b) if b else None
+            if a!=b: mismatches.append({'key':[r['episode_id'],r['step_idx'],r['mode']],'field':field,'pred':a,'frozen':b})
+    files.extend([{'file':str(p),'sha256':sha(p)} for p in (pred,gt,gt.with_suffix('.manifest.json'))])
+    dev={}
+    for split in ('odyssey','amex','screenqa'):
+        pp=ROOT/f'results/v3_dev/lfm3_v3_dev_{split}.jsonl'
+        frozen=SCRATCH/f'src/data/dev_{split}-00000-of-00001.parquet'
+        metadata=SCRATCH/f'src/.cache/huggingface/download/data/dev_{split}-00000-of-00001.parquet.metadata'
+        rev,etag,*_=metadata.read_text().splitlines()
+        digest=sha(frozen)
+        assert rev=='42f7f763649d4d2c73eeb99ff5f0bc33bd15a16a' and digest==etag
+        cols=[c for c in pq.ParquetFile(frozen).schema_arrow.names if c not in ('images','messages')]
+        gg=pq.read_table(frozen,columns=cols).to_pylist()
+        rr=read(pp)
+        key=lambda r:(str(r['episode_id']),r['step_idx'])
+        gidx={key(r):r for r in gg}; pidx={key(r):r for r in rr}
+        assert len(gidx)==len(gg) and len(pidx)==len(rr)
+        assert set(gidx)==set(pidx)
+        bad=[]
+        for k,g in gidx.items():
+            for field,v in g.items():
+                pv=pidx[k].get(field)
+                if field=='gt_action': pv,v=action(pv),action(v)
+                if pv!=v: bad.append({'key':k,'field':field,'pred':pv,'frozen':v})
+        fused=OUT/f'{split}_frozen_inputs.jsonl'
+        with fused.open('x') as f:
+            for r in rr: f.write(json.dumps({**r,**gidx[key(r)]})+'\n')
+        m=run_scorer('eval/androidcontrol/score_dev.py',[fused,'--expect_n',len(gg)],f'{split}_rescored.metrics.json')
+        original=json.loads(pp.with_suffix('.metrics.json').read_text())
+        manifest=json.loads(Path(str(pp)+'.manifest.json').read_text())
+        dev[split]={'n':len(rr),'unique_keys':len(pidx),'gt_revision':rev,'gt_file':str(frozen),'gt_sha256':digest,
+            'hash_matches_download_metadata':digest==etag,'frozen_label_mismatches':bad,
+            'rows_match_config_hash':{r['config_hash'] for r in rr}=={manifest['config_hash']},
+            'rows_match_model':{r['model'] for r in rr}=={manifest['model']},
+            'all_metrics_match':m==original,'step_sr':m['step_sr'],'episode_sr':m['episode_sr'],
+            'answer_mean_f1':m['answer_mean_f1']}
+        files.extend([{'file':str(p),'sha256':sha(p)} for p in (pp,metadata)])
+    # Reconstruct general predictions from stored four-option scores, not 'correct'.
+    general_paths=[ROOT/'results/general/lfm3vl2b-ac-lora_base_general_logprob.jsonl',ROOT/'results/general/lfm3vl2b-v3mix-lora_ft_general_logprob.jsonl']
+    base,ft=map(read,general_paths)
+    bidx={(r['kind'],str(r['id'])):r for r in base}; fidx={(r['kind'],str(r['id'])):r for r in ft}
+    assert len(bidx)==len(base) and len(fidx)==len(ft) and set(bidx)==set(fidx)
+    inconsistencies=[]; gold_mismatches=[]; correct=[]
+    for rows in (base,ft):
+        cr={}
+        for r in rows:
+            k=(r['kind'],str(r['id'])); scores=json.loads(r['raw'])
+            assert len(scores)==4 and all(math.isfinite(x) for x in scores)
+            pred='ABCD'[max(range(4),key=lambda i:scores[i])]
+            ok=pred==r['gold']; cr[k]=ok
+            if pred!=r['pred'] or ok!=r['correct']: inconsistencies.append({'key':k,'pred':pred,'row':r})
+        correct.append(cr)
+    for k in bidx:
+        if bidx[k]['gold']!=fidx[k]['gold']: gold_mismatches.append(k)
+    general={}
+    for kind in ('mmstar','mmlu'):
+        keys=[k for k in bidx if k[0]==kind]
+        n=len(keys); bc,fc=correct
+        lost=sum(bc[k] and not fc[k] for k in keys); gained=sum(fc[k] and not bc[k] for k in keys)
+        general[kind]={'n':n,'base_correct':sum(bc[k] for k in keys),'v3_correct':sum(fc[k] for k in keys),
+            'base_acc':sum(bc[k] for k in keys)/n,'ft_acc':sum(fc[k] for k in keys)/n,
+            'delta':(sum(fc[k] for k in keys)-sum(bc[k] for k in keys))/n,
+            'lost':lost,'gained':gained,'mcnemar_p':exact(lost,gained)}
+    mmlu_path=Path('/Users/alpha/.cache/huggingface/hub/datasets--cais--mmlu/snapshots/c30699e8356da336a370243923dbaf21066bb9fe/all/test-00000-of-00001.parquet')
+    mmlu=pq.read_table(mmlu_path,columns=['answer','subject']).to_pylist()
+    mmlu_mismatches=[k for k,r in bidx.items() if k[0]=='mmlu' and ('ABCD'[mmlu[int(k[1])]['answer']]!=r['gold'] or mmlu[int(k[1])]['subject']!=r['category'])]
+    saved=json.loads((ROOT/'results/general/lfm3vl2b_v3_retention_logprob.json').read_text())
+    general_saved_match={k:all(abs(v[field]-saved[k][field])<1e-12 for field in ('n','base_acc','ft_acc','delta','gained','mcnemar_p')) and v['lost']==saved[k]['lost(base right, ft wrong)'] for k,v in general.items()}
+    files.extend([{'file':str(p),'sha256':sha(p)} for p in general_paths+[mmlu_path]])
+    result={'androidcontrol':{'metrics_match':ac_same,'prediction_label_mismatches':mismatches,'integrity':ac['integrity'],
+        'counts_and_scores':{k:{'n':v['overall']['n_steps'],'step_sr':v['overall']['step_sr']} if 'overall' in v else {'n':v['n_steps'],'step_sr':v['step_sr']} for k,v in ac.items() if k!='integrity'}},
+        'dev':dev,'general':general,'general_integrity':{'duplicate_or_missing_keys':0,'stored_pred_or_correct_inconsistencies':inconsistencies,'base_v3_gold_mismatches':gold_mismatches,
+        'mmlu_frozen_gold_mismatches':mmlu_mismatches,'mmlu_frozen_file':str(mmlu_path),'mmstar_independent_frozen_gold':'not yet available locally','saved_metrics_match':general_saved_match},'input_hashes':files}
+    save('offline.json',result)
+    print(json.dumps({k:v for k,v in result.items() if k!='input_hashes'},indent=2))
+
+if __name__=='__main__':main()
diff --git a/results/codex/v3_audit/audit_statistics.py b/results/codex/v3_audit/audit_statistics.py
