"""Summarize an AndroidWorld run directory (episode .pkl.gz files) into JSON + CSV.

Differences vs upstream's printed table: episodes that raised an exception are counted as
FAILURES (upstream drops them as NaN, inflating success), and we add on-device-relevant
stats (per-step model latency, prompt tokens, parse failures).

Usage: python summarize_aw.py <run_dir> --out results/androidworld/<name>.summary.json
"""
import argparse
import csv
import gzip
import json
import math
import pickle
import statistics as stats
import sys
from collections import defaultdict
from pathlib import Path

ap = argparse.ArgumentParser()
ap.add_argument("run_dir")
ap.add_argument("--out", required=True)
ap.add_argument("--expected", type=int, default=116, help="scheduled task instances; missing ones count as failures")
a = ap.parse_args()

# difficulty labels from AndroidWorld's own task_metadata.json (task_name -> easy/medium/hard)
_md = Path(__file__).resolve().parents[2] / "android_world" / "android_world" / "task_metadata.json"
DIFF = {r["task_name"]: r["difficulty"] for r in json.loads(_md.read_text())} if _md.exists() else {}


def difficulty(task):
    return DIFF.get(task, "unknown")


rows = []
lat, ptok, parse_fail, nsteps_total = [], [], 0, 0
first_strict = first_lenient = n_attempts = 0
for f in sorted(Path(a.run_dir).glob("*.pkl.gz")):
    # pickles are written locally by our own AndroidWorld runs (trusted input)
    ep = pickle.load(gzip.open(f))
    ep = ep[0] if isinstance(ep, list) else ep
    succ = ep.get("is_successful")
    exc = ep.get("exception_info")
    if succ is None or (isinstance(succ, float) and math.isnan(succ)):
        succ = 0.0
    ed = ep.get("episode_data")
    if not isinstance(ed, dict):  # upstream failed-result records store NaN here
        ed = {}
    l = [x for x in (ed.get("latency_s") or []) if isinstance(x, (int, float))]
    u = [x.get("prompt_tokens") for x in (ed.get("usage") or []) if isinstance(x, dict) and x.get("prompt_tokens")]
    pa = ed.get("parsed_action") or []
    first_strict += sum(1 for x in (ed.get("first_attempt_strict_ok") or []) if x is True)
    first_lenient += sum(1 for x in (ed.get("first_attempt_lenient_ok") or []) if x is True)
    n_attempts += sum(len(x) for x in (ed.get("attempts") or []) if isinstance(x, list))
    lat += l
    ptok += u
    parse_fail += sum(1 for x in pa if x is None)
    nsteps_total += len(pa)
    # our schema uses action_type (terminal = "status"); GUI-Owl uses action (terminal = "terminate")
    acts = [x.get("action_type") or {"terminate": "status"}.get(x.get("action"), x.get("action"))
            for x in pa if isinstance(x, dict)]
    task = ep.get("task_template") or f.name.rsplit("_", 1)[0]
    rows.append({
        "task": task, "file": f.name, "success": float(succ), "exception": bool(exc),
        "steps": ep.get("episode_length"), "runtime_s": round(ep.get("run_time") or 0, 1),
        "difficulty": difficulty(task),
        "exception_info": (str(exc)[:300] if exc else None),
        "teardown_exception": bool(isinstance(ep.get("aux_data"), dict) and ep["aux_data"].get("teardown_exception")),
        # GUI-Owl's agent also ends the episode on `answer` (guiowl_agent.py); ours needs a status action
        "ended_with_status": bool(acts) and (acts[-1] == "status" or (acts[-1] == "answer" and isinstance(pa[-1], dict)
                                                                       and "action" in pa[-1])),
        "n_answer_actions": acts.count("answer"),
    })

by_diff = defaultdict(list)
for r in rows:
    by_diff[r["difficulty"]].append(r["success"])
summary = {
    "run_dir": a.run_dir,
    "n_episodes": len(rows),
    "expected_episodes": a.expected,
    "missing_episodes_counted_as_fail": max(0, a.expected - len(rows)),
    "success_rate": sum(r["success"] for r in rows) / max(1, max(a.expected, len(rows))),
    "success_rate_over_completed": sum(r["success"] for r in rows) / max(1, len(rows)),
    "n_teardown_exceptions": sum(1 for r in rows if r.get("teardown_exception")),
    "success_rate_by_difficulty": {k: {"n": len(v), "sr": sum(v) / len(v)} for k, v in sorted(by_diff.items())},
    "n_exceptions_counted_as_fail": sum(r["exception"] for r in rows),
    "frac_episodes_self_terminated": sum(r["ended_with_status"] for r in rows) / max(1, len(rows)),
    "mean_steps": stats.mean([r["steps"] or 0 for r in rows]) if rows else None,
    "model_latency_s": {"mean": stats.mean(lat), "p50": stats.median(lat), "p90": sorted(lat)[int(.9 * len(lat)) - 1]} if lat else None,
    "prompt_tokens_mean": stats.mean(ptok) if ptok else None,
    "parse_failure_rate": parse_fail / max(1, nsteps_total),
    "n_steps_total": nsteps_total,
    "first_attempt_strict_valid_rate": first_strict / max(1, nsteps_total),
    "first_attempt_lenient_valid_rate": first_lenient / max(1, nsteps_total),
    "n_model_calls_incl_retries": n_attempts,
}
Path(a.out).parent.mkdir(parents=True, exist_ok=True)
Path(a.out).write_text(json.dumps({"summary": summary, "episodes": rows}, indent=1))
with open(str(a.out).replace(".json", ".csv"), "w", newline="") as fh:
    w = csv.DictWriter(fh, fieldnames=list(rows[0].keys()) if rows else ["task"])
    w.writeheader()
    w.writerows(rows)
print(json.dumps(summary, indent=1))
"""Describe AndroidWorld episodes from the raw episode pickles (written locally by our own android_world runs).

usage: python eval/androidworld/failure_modes.py <run_dir> [--out file.json]

Outcome label per episode (descriptive, NOT a causal diagnosis):
  success | exception | complete_but_failed (agent signalled completion, judge says failed) | infeasible_declared |
  answer_but_failed | step_budget_exhausted (no terminal action: android_world only ends a non-terminated episode at the
  task's step budget, so a non-terminated, non-exception episode necessarily exhausted it).
Flags (overlapping, observational): unmapped_open_app (android_world's own launch_app would not resolve the name: not a
_DEFAULT_URIS key, no _PATTERN_TO_ACTIVITY match, not package-like), wait_run3 (>=3 consecutive waits),
same_action_run3 (>=3 consecutive identical non-wait actions, coordinates on a 25-unit grid; any other action breaks
the run), unparseable_step. Handles both our JSON schema (action_type/point_2d) and GUI-Owl's (action/coordinate).
"""
import argparse
import collections
import glob
import gzip
import json
import os
import pickle

from android_world.env import adb_utils

_GUIOWL = {"click": "click", "long_press": "long_press", "swipe": "scroll", "type": "input_text", "wait": "wait",
           "terminate": "status", "answer": "answer", "open": "open_app"}
_BUTTON = {"back": "navigate_back", "home": "navigate_home", "enter": "keyboard_enter"}


def norm(a):
    """-> dict(type, point, arg, status) or None."""
    if not isinstance(a, dict):
        return None
    if "action_type" in a:
        t = a.get("action_type")
        return {"type": t, "point": a.get("point_2d"), "status": a.get("goal_status"),
                "arg": a.get("text") or a.get("app_name") or a.get("direction")}
    if "action" in a:
        t = a.get("action")
        t = _BUTTON.get(str(a.get("button", "")).lower(), "system_button") if t == "system_button" else _GUIOWL.get(t, t)
        st = {"success": "complete", "failure": "infeasible"}.get(a.get("status"), a.get("status"))
        return {"type": t, "point": a.get("coordinate"), "status": st,
                "arg": a.get("text") or (tuple(a["coordinate2"]) if a.get("coordinate2") else None)}
    return None


def key(n):
    if n is None:
        return None
    p = n["point"]
    if isinstance(p, (list, tuple)) and len(p) == 2:
        p = (round(p[0] / 25), round(p[1] / 25))
    return (n["type"], p, n["arg"])


def max_run(xs):
    best, cur, prev = 0, 0, object()
    for x in xs:
        cur = cur + 1 if (x is not None and x == prev) else 1
        best, prev = max(best, cur), x
    return best


def app_resolves(name):
    name = str(name or "")
    return name in adb_utils._DEFAULT_URIS or adb_utils.get_adb_activity(name) is not None or "." in name


def classify(ep):
    ed = ep["episode_data"] if isinstance(ep.get("episode_data"), dict) else {}  # NaN when the episode raised
    raw = ed.get("parsed_action") or []
    acts = [norm(a) for a in raw]
    types = [n["type"] if n else None for n in acts]
    flags = set()
    unmapped = [n["arg"] for n in acts if n and n["type"] == "open_app" and not app_resolves(n["arg"])]
    if unmapped:
        flags.add("unmapped_open_app")
    if max_run(["w" if t == "wait" else None for t in types]) >= 3:
        flags.add("wait_run3")
    if max_run([key(n) if n and n["type"] != "wait" else None for n in acts]) >= 3:
        flags.add("same_action_run3")
    if any(n is None for n in acts):
        flags.add("unparseable_step")
    last = acts[-1] if acts else None
    if ep.get("exception_info") or not ed:
        label = "exception"
    elif (ep["is_successful"] or 0) >= 1:
        label = "success"
    elif (ep["is_successful"] or 0) > 0:
        label = "partial_credit"  # composite tasks (e.g. TurnOnWifiAndOpenApp) can return 0.5
    elif last and last["type"] == "status":
        label = "infeasible_declared" if last["status"] == "infeasible" else "complete_but_failed"
    elif last and last["type"] == "answer":
        label = "answer_but_failed"
    else:
        label = "step_budget_exhausted"
    return label, sorted(flags), unmapped, sum(t == "answer" for t in types)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("run_dir")
    ap.add_argument("--out")
    a = ap.parse_args()
    rows = []
    for f in sorted(glob.glob(os.path.join(a.run_dir, "*.pkl.gz"))):
        ep = pickle.load(gzip.open(f))  # trusted: written by our own local android_world run, never downloaded
        ep = ep[0] if isinstance(ep, list) else ep
        label, flags, unmapped, n_answer = classify(ep)
        rows.append({"task": ep["task_template"], "instance_id": ep.get("instance_id"), "label": label, "flags": flags,
                     "unmapped_apps": unmapped, "answer_actions": n_answer, "steps": ep["episode_length"]})
    fails = [r for r in rows if r["label"] != "success"]
    out = {"n": len(rows), "labels": dict(collections.Counter(r["label"] for r in rows).most_common()),
           "flags_among_failures": dict(collections.Counter(f for r in fails for f in r["flags"]).most_common()),
           "episodes_with_answer_action": sum(r["answer_actions"] > 0 for r in rows),
           "unmapped_app_names": dict(collections.Counter(x for r in rows for x in r["unmapped_apps"]).most_common(25)),
           "note": "labels are outcome descriptions, not causes; flags overlap", "episodes": rows}
    if a.out:
        json.dump(out, open(a.out, "w"), indent=1)
    print(json.dumps({k: v for k, v in out.items() if k != "episodes"}, indent=1))


if __name__ == "__main__":
    main()
"""Paired AndroidWorld comparison of two runs on identical task instances (task, instance_id, seed, goal must all match).

usage: python eval/androidworld/paired_aw.py <run_dir_A> <run_dir_B> [--out file.json]
Exceptions / NaN rewards count as failures. Exact two-sided McNemar on discordant pairs; Wilson 95% CI per run (n=116).
"""
import argparse
import glob
import gzip
import json
import math
import os
import pickle


def load(run_dir):
    out = {}
    for f in sorted(glob.glob(os.path.join(run_dir, "*.pkl.gz"))):
        ep = pickle.load(gzip.open(f))  # trusted: written by our own local android_world run, never downloaded
        ep = ep[0] if isinstance(ep, list) else ep
        r = ep.get("is_successful")
        ok = isinstance(r, (int, float)) and not math.isnan(r) and r >= 1 and not ep.get("exception_info")  # full success only (composite tasks can give 0.5)
        out[(ep["task_template"], ep.get("instance_id"))] = {"seed": ep.get("seed"), "goal": ep.get("goal"), "ok": bool(ok)}
    return out


def wilson(k, n, z=1.96):
    if n == 0:
        return (0.0, 0.0)
    p = k / n
    d = 1 + z * z / n
    c = (p + z * z / (2 * n)) / d
    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
    return (max(0.0, c - h), min(1.0, c + h))


def mcnemar_exact(b, c):
    n = b + c
    if n == 0:
        return 1.0
    k = min(b, c)
    p = sum(math.comb(n, i) for i in range(k + 1)) / 2 ** n
    return min(1.0, 2 * p)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("a")
    ap.add_argument("b")
    ap.add_argument("--expected", type=int, default=116)
    ap.add_argument("--out")
    a = ap.parse_args()
    A, B = load(a.a), load(a.b)
    pairs, excluded = [], []
    for k in sorted(set(A) & set(B)):
        if A[k]["seed"] == B[k]["seed"] and A[k]["goal"] == B[k]["goal"]:
            pairs.append((k, A[k]["ok"], B[k]["ok"]))
        else:
            excluded.append(k[0])
    both = sum(x and y for _, x, y in pairs)
    a_only = sum(x and not y for _, x, y in pairs)
    b_only = sum(y and not x for _, x, y in pairs)
    ka, kb = sum(v["ok"] for v in A.values()), sum(v["ok"] for v in B.values())
    res = {
        "A": {"run": a.a, "successes": ka, "n_recorded": len(A), "rate_over_expected": ka / a.expected,
              "wilson95": wilson(ka, a.expected)},
        "B": {"run": a.b, "successes": kb, "n_recorded": len(B), "rate_over_expected": kb / a.expected,
              "wilson95": wilson(kb, a.expected)},
        "paired": {"n_pairs": len(pairs), "both": both, "A_only": a_only, "B_only": b_only,
                   "neither": len(pairs) - both - a_only - b_only, "mcnemar_exact_p": mcnemar_exact(a_only, b_only),
                   "excluded_goal_or_seed_mismatch": excluded,
                   "B_only_tasks": [k[0] for k, x, y in pairs if y and not x],
                   "A_only_tasks": [k[0] for k, x, y in pairs if x and not y]},
    }
    if a.out:
        json.dump(res, open(a.out, "w"), indent=1)
    print(json.dumps(res, indent=1))


if __name__ == "__main__":
    main()

