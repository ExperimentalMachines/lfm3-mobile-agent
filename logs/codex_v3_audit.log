def ring(img, pt, lp):
    img = img.convert("RGB").copy()
    W, H = img.size
    x, y = pt[0] / 1000 * (W - 1), pt[1] / 1000 * (H - 1)
    r = max(10, int(0.035 * W))
    d = ImageDraw.Draw(img)
    for k in range(3):
        d.ellipse([x - r - k, y - r - k, x + r + k, y + r + k], outline=(255, 0, 0))
    return img

