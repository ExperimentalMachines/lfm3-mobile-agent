from pathlib import Path
import concurrent.futures, subprocess, sys, json, time
BASE=Path(__file__).resolve().parent

def suite(name):
    started=time.monotonic()
    with (BASE/(name.removesuffix('.py')+'.log')).open('x') as log:
        p=subprocess.run([sys.executable,'-B',str(BASE/name)],stdout=log,stderr=subprocess.STDOUT,cwd=BASE)
    result={'script':name,'exit':p.returncode,'duration_s':round(time.monotonic()-started,2),'log':str(log.name)}
    print(json.dumps(result),flush=True)
    return result

def group(names):
    results=[]
    for name in names:
        result=suite(name);results.append(result)
        if result['exit']:
            break
    return results

groups=[['verify_status_lifecycle.py'],['verify_chain.py'],['verify_generation_score.py','verify_aw.py'],['verify_shell.py','verify_recovery.py','verify_general_recovery.py','verify_replacement_pipeline.py','verify_identity_edges.py']]
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
    results=[result for task in pool.map(group,groups) for result in task]
(BASE/'suite_results.json').write_text(json.dumps(results,indent=2))
assert len(results)==9 and all(r['exit']==0 for r in results),results
