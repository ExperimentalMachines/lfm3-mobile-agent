    for seed in ('cached_done','metrics_incomplete','metrics_complete_only','metrics_wrong_model','metrics_real_integrity_problem','metrics_missing_predictions','metrics_good','metrics_truncated_predictions','metrics_modified_predictions','metrics_missing_manifest','metrics_wrong_policy','metrics_changed_gt','metrics_no_gt_manifest','metrics_string_false'):
        r=run_pipeline(tag+'_'+seed,job,override={'TEST_SEED':seed})
        regenerate=seed in ('cached_done','metrics_real_integrity_problem','metrics_missing_predictions','metrics_truncated_predictions','metrics_modified_predictions','metrics_missing_manifest','metrics_wrong_policy','metrics_changed_gt','metrics_no_gt_manifest')
        assert r['exit']==(1 if seed in ('metrics_changed_gt','metrics_no_gt_manifest') else 0) and r['scorer_calls']==(6 if regenerate else 3) and r['generation_calls']==(3 if regenerate else 0),r
    r=run_pipeline(tag+'_train_nonzero_with_receipt',job,fail='train_nonzero_with_receipt');assert r['exit']==0,r
