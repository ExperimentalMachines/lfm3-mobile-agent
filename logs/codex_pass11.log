RESULT={}
for tag,job in [('qwen2b','qwen35_2b_l4'),('qwen08','qwen35_08b_l4')]:
    for mode in ('success','failed_predecessor','stale_predecessor','gt_upload_failure','manifest_upload_failure','jobs_upload_failure','jobs_nonzero_success_text','gt_nonzero_success_text','background_start_failure','no_heartbeat','heartbeat_then_exit','gone_success'):
